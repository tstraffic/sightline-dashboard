.env.*
data/uploads
data/database.sqlite
data/database.sqlite-*
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.DS_Store
*.log
playwright-report
test-results
.vscode
.idea
README.md
CLAUDE.md
