PORT=3000
SESSION_SECRET=change-this-to-a-random-string-for-production
NODE_ENV=production

# ── SMTP Email Configuration ──────────────────────────────
# SMTP_FROM_NAME is the display name recipients see. Atomis is the product
# brand; T&S Traffic Control is the legal entity that actually sends mail,
# so the sender name stays as the company (recipients recognise the name).
#
# Option 1: Resend (recommended — free tier: 3,000 emails/month)
#   1. Sign up at https://resend.com
#   2. Add & verify your domain (tstc.com.au)
#   3. Create an API key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_YOUR_API_KEY_HERE
SMTP_FROM_NAME=T&S Traffic Control
SMTP_FROM_EMAIL=noreply@tstc.com.au

# Option 2: Microsoft 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@tstc.com.au
# SMTP_PASS=your-app-password-here
# SMTP_FROM_NAME=T&S Traffic Control
# SMTP_FROM_EMAIL=noreply@tstc.com.au

# Base URL for email links (set to your Railway URL)
APP_BASE_URL=https://your-app.up.railway.app

# ── Whitelabel-prep seed gates ────────────────────────────
# Several historical migrations seeded T&S customer-operational data
# (Villawood depot crew, Abergeldie client list, 2026 TGS Register,
# T&S fleet) and a test fixture (EMP-TEST/PIN-1234 worker). New
# deployments default to skip those seeds.
#
# T&S production: leave both UNSET. The migrations are already recorded
# in schema_migrations so they don't re-run; the gates have no effect.
#
# T&S staging / DB rebuild from scratch: set SEED_T_AND_S_DATA=true to
# repopulate Villawood crew, Abergeldie clients, 2026 TGS, T&S fleet.
#
# Dev / staging that wants the EMP-TEST worker portal preview account:
# set SEED_TEST_USERS=true.
#
# White-label buyer deployments: leave BOTH unset.
# SEED_T_AND_S_DATA=
# SEED_TEST_USERS=
