PORT=3000
SESSION_SECRET=change-this-to-a-random-string-for-production
NODE_ENV=production

# Local dev: keep the SQLite file OUT of OneDrive-synced folders
# (better-sqlite3 + OneDrive sync can lock/corrupt the DB).
# DB_PATH=C:\dev\sightline-data\sightline.db

# ── SMTP Email Configuration ──────────────────────────────
# SMTP_FROM_NAME is the display name recipients see. Atomis is the product
# brand; Sightline Traffic Engineers is the entity that actually sends
# mail, so the sender name stays as the company.
#
# Option 1: Resend (recommended — free tier: 3,000 emails/month)
#   1. Sign up at https://resend.com
#   2. Add & verify the sending domain
#   3. Create an API key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_YOUR_API_KEY_HERE
SMTP_FROM_NAME=Sightline Traffic Engineers
SMTP_FROM_EMAIL=noreply@example.com

# Option 2: Microsoft 365
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-app-password-here
# SMTP_FROM_NAME=Sightline Traffic Engineers
# SMTP_FROM_EMAIL=noreply@example.com

# Base URL for email links (set to your Railway URL)
APP_BASE_URL=https://your-app.up.railway.app

# ── Whitelabel seed gates ─────────────────────────────────
# Several historical migrations seeded T&S Traffic Control operational
# data (this codebase's origin fork) and a test fixture worker.
# Sightline deployments: leave BOTH unset — the DB starts clean.
# Dev/e2e only: SEED_TEST_USERS=true creates test role accounts.
# SEED_T_AND_S_DATA=
# SEED_TEST_USERS=
