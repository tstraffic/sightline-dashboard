<% locals.currentPage = 'abergeldie-payments' %>

<div class="space-y-5 max-w-2xl">
  <div>
    <a href="/finance/abergeldie" class="text-sm text-brand-600 hover:underline">← <%= clientName %> Payment Sheet</a>
    <h1 class="text-2xl font-bold text-gray-900 mt-1">New payment sheet</h1>
    <p class="text-sm text-gray-500 mt-1">Upload a Traffio Person Dockets CSV. Only shifts where the client name contains "<%= clientName %>" will be kept.</p>
  </div>

  <form method="POST" action="/finance/abergeldie" enctype="multipart/form-data" class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 space-y-5">
    <%- include('../partials/csrf') %>

    <div>
      <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Traffio Person Dockets CSV <span class="text-rose-500">*</span></label>
      <input type="file" name="csv" accept=".csv" required class="block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
      <p class="text-[11px] text-gray-500 mt-1.5">Same export you use for Pay Runs — full file is fine, we filter.</p>
    </div>

    <div>
      <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Label <span class="text-gray-400 font-normal lowercase tracking-normal">(optional)</span></label>
      <input type="text" name="label" maxlength="200" placeholder="e.g. May 2026 — auto-generated from period if blank" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm">
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Period start <span class="text-gray-400 font-normal lowercase tracking-normal">(optional)</span></label>
        <input type="date" name="period_start" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm tabular-nums">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Period end <span class="text-gray-400 font-normal lowercase tracking-normal">(optional)</span></label>
        <input type="date" name="period_end" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm tabular-nums">
      </div>
    </div>
    <p class="text-[11px] text-gray-500 -mt-2">Leave blank to auto-detect from the CSV. Set these when your export has no per-shift dates (e.g. a "Person Hours by Client" file), otherwise the period defaults to today.</p>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Fee per hour ($) <span class="text-rose-500">*</span></label>
        <input type="number" step="0.01" min="0" name="fee_per_hour" value="<%= defaultFee.toFixed(2) %>" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm tabular-nums">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Ute rate ($/shift)</label>
        <input type="number" step="0.01" min="0" name="default_ute_rate_per_shift" value="0.00" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm tabular-nums">
      </div>
    </div>
    <p class="text-[11px] text-gray-500 -mt-2">Each kept shift's fee = hours × fee per hour. Ute lines are added later from a Vehicle Job Report.</p>

    <div>
      <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Ute rate basis</label>
      <select name="ute_rate_basis" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm">
        <option value="shift">Per shift / day (× shifts)</option>
        <option value="hourly">Hourly (× booking hours)</option>
      </select>
    </div>

    <div>
      <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1.5">Notes <span class="text-gray-400 font-normal lowercase tracking-normal">(optional)</span></label>
      <textarea name="notes" rows="2" maxlength="1000" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm"></textarea>
    </div>

    <div class="flex items-center justify-between gap-3 pt-2 border-t border-gray-200">
      <a href="/finance/abergeldie" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-lg">Cancel</a>
      <button type="submit" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Import CSV</button>
    </div>
  </form>
</div>

<% if (flash_error && flash_error.length) { %>
  <div class="fixed top-20 right-4 px-4 py-2 rounded-lg bg-red-500 text-white text-sm font-semibold shadow-lg z-50" id="flasherr"><%= flash_error[0] %></div>
  <script>setTimeout(()=>document.getElementById('flasherr')?.remove(), 4000);</script>
<% } %>
