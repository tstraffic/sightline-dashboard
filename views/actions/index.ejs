<% function riskBadge(r){ const m={Critical:'bg-red-100 text-red-700',High:'bg-orange-100 text-orange-700',Medium:'bg-amber-100 text-amber-700',Low:'bg-emerald-100 text-emerald-700'}; return m[r]||'bg-gray-100 text-gray-600'; } %>
<div class="px-3 sm:px-4 lg:px-8 py-4 lg:py-6">
  <div class="flex items-start justify-between gap-3 mb-4">
    <div>
      <h1 class="text-xl lg:text-2xl font-bold text-gray-900">Open Actions</h1>
      <p class="text-sm text-gray-500">Every corrective action across audits and incidents — close them out from one place.</p>
    </div>
  </div>

  <!-- Stat tiles -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
    <% const tiles=[['Open',stats.open,'text-gray-900'],['Overdue',stats.overdue,'text-red-600'],['Critical',stats.critical,'text-orange-600'],['From audits',stats.fromAudits,'text-brand-700']]; %>
    <% tiles.forEach(function(t){ %>
      <div class="bg-white border border-gray-200 rounded-xl p-3">
        <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-400"><%= t[0] %></p>
        <p class="text-2xl font-bold mt-0.5 <%= t[2] %>"><%= t[1] %></p>
      </div>
    <% }) %>
  </div>

  <!-- Filters -->
  <form method="GET" class="flex flex-wrap items-end gap-2 mb-4 bg-white border border-gray-200 rounded-xl p-3">
    <div>
      <label class="block text-[11px] font-semibold text-gray-500 uppercase mb-1">Status</label>
      <select name="status" class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white">
        <% [['','Open'],['all','All'],['completed','Closed']].forEach(function(o){ %><option value="<%= o[0] %>" <%= (filters.status||'')===o[0]?'selected':'' %>><%= o[1] %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="block text-[11px] font-semibold text-gray-500 uppercase mb-1">Source</label>
      <select name="source" class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white">
        <% [['','Any'],['audit','Audit'],['incident','Incident'],['manual','Manual']].forEach(function(o){ %><option value="<%= o[0] %>" <%= (filters.source||'')===o[0]?'selected':'' %>><%= o[1] %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="block text-[11px] font-semibold text-gray-500 uppercase mb-1">Risk</label>
      <select name="risk" class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white">
        <% [['','Any'],['Critical','Critical'],['High','High'],['Medium','Medium'],['Low','Low']].forEach(function(o){ %><option value="<%= o[0] %>" <%= (filters.risk||'')===o[0]?'selected':'' %>><%= o[1] %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="block text-[11px] font-semibold text-gray-500 uppercase mb-1">Job</label>
      <select name="job_id" class="px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white">
        <option value="">Any</option>
        <% jobs.forEach(function(j){ %><option value="<%= j.id %>" <%= String(filters.job_id||'')===String(j.id)?'selected':'' %>><%= j.job_number %></option><% }) %>
      </select>
    </div>
    <label class="flex items-center gap-1.5 text-sm text-gray-700 px-2 py-2"><input type="checkbox" name="overdue" value="1" <%= filters.overdue==='1'?'checked':'' %> class="w-4 h-4 rounded border-gray-300">Overdue only</label>
    <button class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg">Filter</button>
    <a href="/actions" class="px-3 py-2 text-sm text-gray-500 hover:text-gray-800">Clear</a>
  </form>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs uppercase font-semibold text-gray-500">
          <tr>
            <th class="px-3 py-2 text-left">Source</th>
            <th class="px-3 py-2 text-left">Issue / Action</th>
            <th class="px-3 py-2 text-left">Involved</th>
            <th class="px-3 py-2 text-left">Risk</th>
            <th class="px-3 py-2 text-left">Due</th>
            <th class="px-3 py-2 text-right">Close out</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% if (!actions.length) { %>
            <tr><td colspan="6" class="px-3 py-8 text-center text-gray-500">No actions match these filters. 🎉</td></tr>
          <% } %>
          <% actions.forEach(function(ca){
               const closed = ['completed','cancelled'].includes(ca.status);
               const overdue = ca.due_date && ca.due_date < today && !closed;
               const involved = ca.involved_emp_name || ca.involved_crew_name || ca.involved_person_name || '—';
               let srcLabel, srcHref, srcClass;
               if (ca.source_type==='audit' && ca.audit_id){ srcLabel='Audit #'+ca.audit_id; srcHref='/audits/'+ca.audit_id; srcClass='bg-brand-50 text-brand-700'; }
               else if (ca.incident_number){ srcLabel=ca.incident_number; srcHref='/incidents/'+ca.incident_id; srcClass='bg-purple-50 text-purple-700'; }
               else { srcLabel='Manual'; srcHref=null; srcClass='bg-gray-100 text-gray-600'; }
          %>
            <tr class="<%= closed ? 'opacity-60' : '' %>">
              <td class="px-3 py-2 align-top whitespace-nowrap">
                <% if (srcHref){ %><a href="<%= srcHref %>" class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold <%= srcClass %> hover:underline"><%= srcLabel %></a><% } else { %><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold <%= srcClass %>"><%= srcLabel %></span><% } %>
                <% if (ca.source_question_key){ %><div class="text-[10px] text-gray-400 mt-1 font-mono"><%= ca.source_question_key %></div><% } %>
                <% if (ca.job_number){ %><div class="text-[10px] text-gray-400 mt-0.5"><%= ca.job_number %></div><% } %>
              </td>
              <td class="px-3 py-2 align-top"><p class="text-gray-800"><%= ca.description || '—' %></p><% if (ca.observation && ca.observation!==ca.description){ %><p class="text-[11px] text-gray-500 mt-0.5"><%= ca.observation %></p><% } %></td>
              <td class="px-3 py-2 align-top text-gray-700"><%= involved %></td>
              <td class="px-3 py-2 align-top"><span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold <%= riskBadge(ca.risk_level) %>"><%= ca.risk_level || '—' %></span></td>
              <td class="px-3 py-2 align-top whitespace-nowrap <%= overdue ? 'text-red-600 font-semibold' : 'text-gray-600' %>"><%= ca.due_date || '—' %><% if (overdue){ %> <span class="text-[10px]">overdue</span><% } %></td>
              <td class="px-3 py-2 align-top text-right">
                <% if (closed){ %>
                  <span class="text-xs text-emerald-700">✓ <%= ca.completed_date || 'closed' %></span>
                  <form method="POST" action="/actions/<%= ca.id %>/reopen" class="inline"><input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>"><button class="text-[11px] text-gray-400 hover:text-gray-700 ml-1 underline">reopen</button></form>
                <% } else { %>
                  <form method="POST" action="/actions/<%= ca.id %>/close" class="flex items-center justify-end gap-1.5">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>">
                    <input name="verification" placeholder="Verification note" class="px-2 py-1.5 text-xs border border-gray-200 rounded w-36">
                    <button class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg whitespace-nowrap">Close</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
