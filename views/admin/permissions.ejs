<% locals.currentPage = 'admin-permissions' %>
<%
  // Tooltip-style label for the role columns (since pure abbreviations
  // would be confusing). Keep these short so the header row fits.
  const ROLE_LABEL = {
    admin: 'Admin', operations: 'Operations', planning: 'Planning',
    safety: 'Safety', hr: 'HR', finance: 'Finance',
    management: 'Mgmt', marketing: 'Marketing', accounts: 'Accounts',
  };
  // Friendly module-label dictionary — short, sentence case. Anything
  // missing here falls back to a snake_case → Title Case transform.
  const MODULE_LABEL = {
    hr_dashboard: 'HR Dashboard', hr_employees: 'HR Employees',
    hr_documents: 'HR Documents', hr_competencies: 'Licences & Expiries',
    hr_reports: 'HR Reports', hr_settings: 'HR Settings',
    hr_compliance_view: 'HR Compliance View',
    leave_approvals: 'Leave Approvals',
    abergeldie_payments: 'Abergeldie Payments',
    safety_updates: 'Safety Updates', toolbox_talks: 'Toolbox Talks',
    safety_comments: 'Safety Comments', safety_quizzes: 'Safety Quizzes',
    safety_workshops: 'Safety Workshops', safety_reports: 'Safety Reports',
    risk_assessments: 'Risk Assessments', sop_register: 'SOP Register',
    voc_admin: 'VOC Admin',
    traffio_imports: 'Traffio Imports',
    // "Job page tabs" group — one toggle per tab on the job detail page.
    // Keys keep their historical planning_/ops_ names; labels say what
    // they actually gate today.
    planning_diary: 'Job · Site Diary', ops_tasks: 'Job · Tasks',
    planning_plans: 'Job · Traffic Plans', job_final_plans: 'Job · Final Plans',
    job_safety: 'Job · Safety', ops_timesheets: 'Job · Timesheets',
    ops_incidents: 'Job · Incidents', job_equipment: 'Job · Equipment',
    job_contacts: 'Job · Contacts', planning_chat: 'Job · Chat',
    job_budget: 'Job · Budget', job_accounts: 'Job · Accounts + docs',
    ops_flag: 'Ops · Flag for Review',
    ops_final_plans: 'Ops · Tasks Board + Job Pack (sidebar)',
  };
  function moduleLabel(k) {
    if (MODULE_LABEL[k]) return MODULE_LABEL[k];
    return k.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  }
%>

<div class="space-y-5">
  <%- include('../partials/page-header', { rail: true, wrapperClass: '',
    eyebrow: 'Admin',
    title: 'Role Permissions',
    subtitle: 'Toggle which modules each role can see. Changes apply immediately. Admin is always allowed and can\'t be locked out.',
    actions: [{ label: '← Back to Admin', href: '/admin/users', style: 'secondary' }],
  }) %>

  <!-- Helper banner -->
  <div class="bg-blue-50 border border-blue-200 rounded-xl p-3 text-sm text-blue-900 flex items-start gap-3">
    <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <div>
      <p class="font-semibold">How this works</p>
      <p class="text-blue-900/85">Checked = role can see the module. Cells highlighted in <span class="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 text-xs font-bold">amber</span> are overrides — they differ from the default. Click <strong>Reset</strong> to clear all overrides and fall back to the built-in defaults.</p>
    </div>
  </div>

  <form method="POST" action="/admin/permissions">
    <%- include('../partials/csrf') %>

    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="perm-table w-full text-sm">
          <thead>
            <tr>
              <th class="perm-corner sticky left-0 top-0 z-30 bg-gray-50 text-left px-3 py-2 text-[10px] font-bold text-gray-500 uppercase tracking-widest border-b border-gray-200">Module</th>
              <% roles.forEach(function (r) { %>
                <th class="perm-role-head sticky top-0 z-20 bg-gray-50 px-2 py-2 text-[10px] font-bold uppercase tracking-widest border-b border-gray-200 <%= r === 'admin' ? 'text-gray-400' : 'text-gray-700' %>" title="<%= r %>">
                  <%= ROLE_LABEL[r] || r %>
                </th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% groups.forEach(function (g) { %>
              <tr class="perm-section-row">
                <td colspan="<%= roles.length + 1 %>" class="px-3 py-1.5 bg-gray-50 text-[10px] font-bold uppercase tracking-widest text-gray-600 border-t border-b border-gray-200"><%= g.label %></td>
              </tr>
              <% g.items.forEach(function (m) { %>
                <tr class="perm-row hover:bg-blue-50/30">
                  <td class="perm-mod-cell sticky left-0 z-10 bg-white border-b border-gray-100 px-3 py-1.5 text-sm text-gray-800 font-medium"><%= moduleLabel(m) %><div class="text-[10px] text-gray-400 font-mono"><%= m %></div></td>
                  <% roles.forEach(function (r) { %>
                    <%
                      var on = effective(r, m);
                      var override = isOverridden(r, m);
                      var locked = (r === 'admin');
                    %>
                    <td class="perm-cell border-b border-gray-100 px-2 py-1.5 text-center <%= override ? 'bg-amber-50' : '' %>">
                      <label class="inline-flex items-center justify-center cursor-pointer">
                        <input type="checkbox"
                               name="cells[<%= r %>][<%= m %>]"
                               value="1"
                               <%= on ? 'checked' : '' %>
                               <%= locked ? 'disabled' : '' %>
                               class="perm-check"
                               data-default="<%= permissionsMap[m] && permissionsMap[m].indexOf(r) !== -1 ? '1' : '0' %>">
                      </label>
                    </td>
                  <% }) %>
                </tr>
              <% }) %>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mt-4">
      <div class="flex items-center gap-2 flex-wrap">
        <button type="button" id="permTickAll" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-medium rounded-lg">Tick all visible</button>
        <button type="button" id="permClearAll" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-medium rounded-lg">Clear all visible</button>
        <button type="button" id="permRevertDefaults" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-medium rounded-lg">Revert visible to defaults</button>
      </div>
      <div class="flex items-center gap-2">
        <button type="submit" formaction="/admin/permissions/reset" formmethod="POST" onclick="return confirm('Clear every override and restore the built-in defaults?')" class="px-4 py-2 bg-red-50 hover:bg-red-100 text-red-700 text-sm font-medium rounded-lg border border-red-200">Reset all overrides</button>
        <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg shadow-sm">Save changes</button>
      </div>
    </div>
  </form>
</div>

<style>
  .perm-table { border-collapse: separate; border-spacing: 0; min-width: 720px; }
  .perm-role-head { min-width: 70px; }
  .perm-mod-cell { min-width: 220px; max-width: 280px; box-shadow: 1px 0 0 #E5E7EB; }
  .perm-corner { box-shadow: 1px 0 0 #E5E7EB, 0 1px 0 #E5E7EB; }
  .perm-cell { min-width: 70px; }
  .perm-check { width: 16px; height: 16px; accent-color: #2B7FFF; }
  .perm-check:disabled { opacity: 0.45; cursor: not-allowed; accent-color: #94A3B8; }
  :root[data-theme="dark"] .perm-corner,
  :root[data-theme="dark"] .perm-role-head { background: rgba(255,255,255,0.04); color: #CBD5E1; box-shadow: 1px 0 0 rgba(255,255,255,0.08), 0 1px 0 rgba(255,255,255,0.08); }
  :root[data-theme="dark"] .perm-section-row td { background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.78); border-color: rgba(255,255,255,0.08); }
  :root[data-theme="dark"] .perm-mod-cell { background: rgba(15,17,21,0.6); color: rgba(255,255,255,0.92); box-shadow: 1px 0 0 rgba(255,255,255,0.08); }
  :root[data-theme="dark"] .perm-row:hover { background: rgba(43,127,255,0.06); }
  :root[data-theme="dark"] .perm-cell { border-color: rgba(255,255,255,0.06); }
</style>

<script>
(function () {
  // Tick / Clear / Revert helpers operate on every enabled checkbox in the
  // table (i.e. all roles except admin, which is disabled).
  var allBoxes = function () { return Array.prototype.slice.call(document.querySelectorAll('.perm-check:not(:disabled)')); };
  var btnTick = document.getElementById('permTickAll');
  var btnClear = document.getElementById('permClearAll');
  var btnRevert = document.getElementById('permRevertDefaults');
  if (btnTick) btnTick.addEventListener('click', function () { allBoxes().forEach(function (b) { b.checked = true; }); });
  if (btnClear) btnClear.addEventListener('click', function () { allBoxes().forEach(function (b) { b.checked = false; }); });
  if (btnRevert) btnRevert.addEventListener('click', function () {
    allBoxes().forEach(function (b) { b.checked = b.getAttribute('data-default') === '1'; });
  });
})();
</script>
