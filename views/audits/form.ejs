<% const a = audit || {}; %>
<% function val(k, fallback) { return (a && a[k] != null) ? a[k] : (fallback || ''); } %>
<% function stateOf(r) { if (!r) return ''; if (r.state) return r.state; if (r.na) return 'na'; if (r.checked) return 'yes'; return ''; } %>
<% const ctxMap = (typeof attachmentsByContext !== 'undefined') ? (attachmentsByContext || {}) : {}; %>
<% const _onSite = (typeof onSiteCrew !== 'undefined' ? onSiteCrew : []) || []; %>
<% const _auditCrew = (typeof auditCrew !== 'undefined' ? auditCrew : []) || []; %>
<% const selectedCrewIds = _auditCrew.map(function(c){ return c.crew_member_id; }); %>
<% const _anySaved = selectedCrewIds.length > 0; %>
<% function _isPresent(cmId){ return _anySaved ? (selectedCrewIds.indexOf(cmId) !== -1) : true; } %>
<%
  // Effective site roster = auto-pulled on-site crew ∪ any workers already
  // saved on this audit (so manually-added workers survive edits). Rendered
  // everywhere crew appears (roster + per-person tagging).
  const _crewMap = {};
  _onSite.forEach(function(c){ _crewMap[c.crew_member_id] = c; });
  _auditCrew.forEach(function(ac){
    if (!_crewMap[ac.crew_member_id]) _crewMap[ac.crew_member_id] = {
      crew_member_id: ac.crew_member_id, full_name: ac.full_name,
      role_on_site: ac.role_on_site || '', employee_id: ac.employee_id || null,
      linked: !!ac.employee_id, source: ac.source || 'manual',
    };
  });
  const crew = Object.keys(_crewMap).map(function(k){ return _crewMap[k]; })
    .sort(function(a,b){ return (a.full_name||'').localeCompare(b.full_name||''); });
  // Crew available to add = all active crew not already on the roster.
  const _onIds = {}; crew.forEach(function(c){ _onIds[c.crew_member_id] = true; });
  const addableCrew = ((typeof allCrew !== 'undefined' ? allCrew : []) || [])
    .filter(function(c){ return !_onIds[c.crew_member_id]; });
%>
<% const tagMap = (typeof tagsByKey !== 'undefined' ? tagsByKey : {}) || {}; %>
<% const WORK_TYPES = [['static','Static lane closure'],['mobile','Mobile works'],['shoulder','Shoulder works'],['intersection','Intersection']]; %>
<%
  const linkedJob = (a && a.job_id) ? (jobs || []).find(function(j){ return String(j.id) === String(a.job_id); }) : null;
  const statusLabel = a && a.status ? a.status.replace('_',' ') : '';
  const initialOnSite = selectedCrewIds.length || crew.length || 0;
%>

<div class="px-3 sm:px-4 lg:px-8 py-4 lg:py-6 pb-24">
  <!-- Sticky header with live score + inline Save / Submit -->
  <div class="sticky top-[56px] lg:top-0 bg-white border-b border-gray-200 shadow-sm z-20 -mx-3 sm:-mx-4 lg:-mx-8 px-3 sm:px-4 lg:px-8 py-2.5 lg:py-3 mb-4">
    <div class="flex items-center justify-between gap-2 sm:gap-3">
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-base sm:text-lg lg:text-xl font-bold text-gray-900 truncate"><%= isEdit ? 'Edit Audit #' + a.id : 'New Site Audit' %></h1>
          <% if (isEdit && statusLabel) { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide whitespace-nowrap
              <%= a.status === 'signed_off' ? 'bg-emerald-100 text-emerald-700' : a.status === 'submitted' ? 'bg-blue-100 text-blue-700' : 'bg-amber-100 text-amber-700' %>"><%= statusLabel %></span>
          <% } %>
        </div>
        <div class="flex items-center gap-2 mt-0.5 text-[11px] sm:text-xs text-gray-500 min-w-0">
          <span class="flex items-baseline gap-1 flex-shrink-0">
            <span class="uppercase tracking-wide font-semibold text-gray-400">Score</span>
            <span id="live-percent" class="text-sm sm:text-base font-bold text-gray-900"><%= score.percent || 0 %>%</span>
          </span>
          <span id="live-critical-badge" class="<%= score.criticalFail ? '' : 'hidden' %> inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-600 text-white">CRITICAL FAIL</span>
          <% if (linkedJob) { %>
            <span class="text-gray-300">·</span>
            <span class="truncate"><%= linkedJob.job_number %><%= linkedJob.client ? ' — ' + linkedJob.client : '' %></span>
          <% } %>
        </div>
      </div>
      <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
        <button type="submit" form="auditForm" name="submit" value="0" class="px-2.5 sm:px-3.5 py-2 text-xs sm:text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition whitespace-nowrap">Save</button>
        <button type="submit" form="auditForm" name="submit" value="1" class="px-2.5 sm:px-3.5 py-2 text-xs sm:text-sm font-bold text-white bg-brand-600 hover:bg-brand-700 rounded-lg transition whitespace-nowrap">Submit</button>
      </div>
    </div>
    <% if (!isEdit) { %>
      <div id="draft-status" class="hidden mt-2 text-[11px] text-gray-500 italic"><span class="inline-block w-2 h-2 rounded-full bg-emerald-500 mr-1 align-middle"></span>Draft saved — uploads enabled</div>
    <% } %>
  </div>

  <% if (typeof templateDraft !== 'undefined' && templateDraft) { %>
    <div class="mb-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 flex items-start gap-2">
      <svg class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
      <p class="text-xs text-amber-800"><span class="font-bold">DRAFT question set.</span> This NSW-aligned template is pending STMS/RTO confirmation against the current TfNSW TCAWS manual. Wording is not yet final.</p>
    </div>
  <% } %>

  <form method="POST" action="<%= isEdit ? '/audits/' + a.id : '/audits' %>" id="auditForm" class="space-y-5 lg:space-y-6">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <!-- Audit details -->
    <section class="bg-white border border-gray-200 rounded-xl p-4 sm:p-5">
      <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-3">Audit Details</h2>
      <div class="mb-4">
        <label class="block text-xs font-semibold text-gray-700 mb-1">Linked Project (Job) <span class="text-gray-400 font-normal hidden sm:inline">— auto-fills client, site &amp; location</span></label>
        <select name="job_id" id="job-select" class="w-full px-3 py-3 text-base border border-gray-300 rounded-lg bg-white">
          <option value="">— Not linked —</option>
          <% jobs.forEach(function(j) { %>
            <option value="<%= j.id %>" data-job-number="<%= j.job_number || '' %>" data-client="<%= j.client || '' %>" data-site="<%= j.site_address || '' %>" data-suburb="<%= j.suburb || '' %>" <%= String(val('job_id')) === String(j.id) ? 'selected' : '' %>>
              <%= j.job_number %><%= j.job_name ? ' — ' + j.job_name : '' %> — <%= j.client %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        <div><label class="block text-xs font-semibold text-gray-700 mb-1">Project / Site</label><input id="f-project_site" name="project_site" value="<%= val('project_site') %>" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg" placeholder="e.g. 38 York St"></div>
        <div><label class="block text-xs font-semibold text-gray-700 mb-1">Client</label><input id="f-client" name="client" value="<%= val('client') %>" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg"></div>
        <div><label class="block text-xs font-semibold text-gray-700 mb-1">Location</label><input id="f-location" name="location" value="<%= val('location') %>" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg"></div>
        <div><label class="block text-xs font-semibold text-gray-700 mb-1">Date / Time</label><input type="datetime-local" name="audit_datetime" value="<%= val('audit_datetime') %>" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg"></div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Work Type <span class="text-gray-400 font-normal">— filters questions</span></label>
          <select name="work_type" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg bg-white">
            <% WORK_TYPES.forEach(function(w){ %><option value="<%= w[0] %>" <%= (typeof workType!=='undefined'?workType:'static') === w[0] ? 'selected' : '' %>><%= w[1] %></option><% }) %>
          </select>
          <% if (isEdit) { %><p class="text-[10px] text-gray-400 mt-0.5">Save to refresh which questions apply.</p><% } %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Time of Day</label>
          <select name="time_of_day" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg bg-white">
            <% ['day','night'].forEach(function(s){ %><option value="<%= s %>" <%= (typeof timeOfDay!=='undefined'?timeOfDay:'day') === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option><% }) %>
          </select>
        </div>
        <div><label class="block text-xs font-semibold text-gray-700 mb-1">TGS / TCP / TTM Ref</label><input name="tgs_ref" value="<%= val('tgs_ref') %>" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg"></div>
        <div><label class="block text-xs font-semibold text-gray-700 mb-1">Auditor</label><input name="auditor_name" value="<%= val('auditor_name') || (user && user.full_name) || '' %>" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg"></div>
        <div><label class="block text-xs font-semibold text-gray-700 mb-1">Supervisor / STMS</label><input name="supervisor_name" value="<%= val('supervisor_name') %>" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg"></div>
        <div class="sm:col-span-2"><label class="block text-xs font-semibold text-gray-700 mb-1">Weather / Visibility</label><input name="weather" value="<%= val('weather') %>" class="w-full px-3 py-2.5 text-base border border-gray-300 rounded-lg"></div>
      </div>

      <!-- Workers on site -->
      <div class="mt-5 pt-4 border-t border-gray-100">
        <div class="flex items-center justify-between mb-2">
          <label class="block text-sm font-bold text-gray-900">Workers on site <span class="text-gray-400 font-normal text-xs">— everyone being audited</span></label>
          <span class="text-[11px] text-gray-500"><span id="crew-count"><%= initialOnSite %></span> listed</span>
        </div>
        <p class="text-[11px] text-gray-500 mb-2">Rostered crew for this job &amp; date are pre-filled — untick anyone not present, or add others below. These are the workers you can flag on the PPE section.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="crew-list">
          <% crew.forEach(function(c){ const checked = _isPresent(c.crew_member_id); %>
            <label class="flex items-center gap-2 px-3 py-2 rounded-lg border <%= c.ticketExpired ? 'border-red-300 bg-red-50' : (c.linked ? 'border-gray-200' : 'border-amber-300 bg-amber-50') %>" data-crew-label="<%= c.crew_member_id %>">
              <input type="checkbox" class="crew-check w-4 h-4 rounded border-gray-300" name="crew_member_ids" value="<%= c.crew_member_id %>" data-linked="<%= c.linked ? '1':'0' %>" data-name="<%= c.full_name %>" <%= checked ? 'checked' : '' %>>
              <span class="text-sm text-gray-800 flex-1 min-w-0 truncate"><%= c.full_name %><% if (c.role_on_site) { %> <span class="text-gray-400">· <%= c.role_on_site %></span><% } %></span>
              <% if (c.ticketExpired) { %><span class="text-[10px] font-semibold text-red-700 whitespace-nowrap" title="<%= c.ticketWarning %>">⚠ ticket</span><% } %>
              <% if (!c.linked) { %><span class="text-[10px] font-semibold text-amber-700 whitespace-nowrap" title="No HR profile linked — can't push a note to this worker's review">no HR link</span><% } %>
            </label>
          <% }) %>
        </div>
        <% if (!crew.length) { %>
          <p id="crew-empty" class="text-xs text-gray-500 italic bg-gray-50 rounded-lg px-3 py-2 mt-1">No rostered crew found for this job/date — add the workers on site below.</p>
        <% } %>
        <!-- Add a worker not on the roster -->
        <div class="mt-3 flex items-center gap-2">
          <select id="add-worker-select" class="flex-1 px-3 py-2.5 text-sm border border-gray-300 rounded-lg bg-white">
            <option value="">＋ Add a worker on site…</option>
            <% addableCrew.forEach(function(c){ %>
              <option value="<%= c.crew_member_id %>" data-name="<%= c.full_name %>" data-linked="<%= c.linked ? '1':'0' %>"><%= c.full_name %><%= c.linked ? '' : ' (no HR link)' %></option>
            <% }) %>
          </select>
          <button type="button" id="add-worker-btn" class="px-3.5 py-2.5 text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-lg whitespace-nowrap">Add</button>
        </div>
        <p class="text-[11px] text-gray-400 mt-1">Workers without an HR profile link can be listed, but a flag won't push to their review.</p>
      </div>
    </section>

    <%# Rendered in NEW mode too (auditId late-binds after the silent
        background draft) so answering questions never forces a page
        reload just to unlock uploads. %>
    <section class="bg-white border border-gray-200 rounded-xl p-4 sm:p-5">
      <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-1">Site Overview Evidence</h2>
      <p class="text-xs text-gray-500 mb-3">Upload the TGS/TCP PDF, a site map or aerial, and the daily pre-start or briefing sheet.</p>
      <%- include('_upload_block', { auditId: isEdit ? a.id : '', contextKey: 'overview', label: 'Add overview files', hint: 'TGS PDF · site map · pre-start', accept: 'image/*,application/pdf,.doc,.docx', returnTo: isEdit ? '/audits/' + a.id + '/edit' : '/audits/new', items: ctxMap['overview'] || [], csrfToken: (typeof csrfToken !== 'undefined' ? csrfToken : '') }) %>
    </section>

    <!-- Checklist sections (template-driven) -->
    <% sections.forEach(function(section) { %>
      <% const isPPESection = section.key === 'S3'; %>
      <section class="bg-white border border-gray-200 rounded-xl overflow-hidden" data-section="<%= section.key %>">
        <header class="bg-brand-600 text-white px-4 sm:px-5 py-3 flex items-center justify-between">
          <h2 class="text-sm lg:text-base font-bold"><%= section.key %>. <%= section.title %></h2>
          <span class="text-xs font-semibold bg-white/20 px-2 py-0.5 rounded-full" data-section-score="<%= section.key %>">—</span>
        </header>
        <div class="divide-y divide-gray-100">
          <% section.questions.forEach(function(q) {
            const key = q.key;
            const r = responses[key] || {};
            const currentState = stateOf(r);
            const perPerson = q.scoring_mode === 'per_person';
            const exIds = (r.exceptions || []).map(function(e){ return String(e.crew_member_id); });
            const qtags = tagMap[key] || [];
            const tagByCrew = {}; qtags.forEach(function(t){ tagByCrew[String(t.crew_member_id)] = t; });
          %>
            <div class="px-4 py-3 lg:px-5 flex flex-col gap-2.5" data-item="<%= key %>" data-mode="<%= q.scoring_mode %>" data-critical="<%= q.is_critical ? '1':'0' %>" data-band="<%= q.risk_band %>" data-group="<%= section.score_group %>">
              <p class="text-sm text-gray-800 flex items-start gap-1.5 flex-wrap">
                <span class="font-semibold text-gray-400 mr-0.5"><%= key %></span>
                <span class="flex-1 min-w-[12rem]"><%= q.text %></span>
                <% if (q.is_critical) { %><span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wide bg-red-100 text-red-700">Critical</span><% } %>
                <% if (perPerson) { %><span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700">Per-person</span><% } %>
                <% if (q.competency_check_type) { %><span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-semibold bg-gray-100 text-gray-600" title="Cross-checked against the worker's ticket record">ticket-checked</span><% } %>
              </p>

              <!-- Yes / No / N/A pills -->
              <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <div class="inline-flex rounded-lg overflow-hidden border border-gray-200 bg-gray-50 w-full sm:w-auto" role="radiogroup" data-pillgroup="<%= key %>">
                  <% [['yes','Yes'],['no','No'],['na','N/A']].forEach(function(opt) { %>
                    <label class="relative cursor-pointer flex-1 sm:flex-none">
                      <input type="radio" name="q_<%= key %>_state" value="<%= opt[0] %>" <%= currentState === opt[0] ? 'checked' : '' %> class="sr-only peer q-state">
                      <span class="block text-center px-4 py-2.5 sm:py-1.5 text-sm sm:text-xs font-semibold transition select-none
                        <%= currentState === opt[0] ? (opt[0]==='yes' ? 'bg-emerald-600 text-white' : opt[0]==='no' ? 'bg-red-600 text-white' : 'bg-gray-500 text-white') : 'text-gray-600 hover:bg-gray-100' %>"><%= opt[1] %></span>
                    </label>
                  <% }) %>
                </div>
                <input name="q_<%= key %>_notes" value="<%= r.notes || '' %>" placeholder="Notes…" class="text-sm px-3 py-2 border border-gray-200 rounded-md flex-1 min-w-0 <%= currentState === 'no' ? 'hidden' : '' %>" data-notes-for="<%= key %>">
              </div>

              <!-- N/A justification (mandatory on critical items) -->
              <div class="na-reason <%= currentState === 'na' ? '' : 'hidden' %>" data-na-reason-for="<%= key %>">
                <label class="block text-[11px] font-semibold text-gray-600 uppercase tracking-wide mb-1 mt-1">Why is this not applicable?<% if (q.is_critical) { %> <span class="text-red-500">*</span><% } %></label>
                <input name="q_<%= key %>_na_reason" value="<%= r.na_reason || '' %>" placeholder="e.g. No pedestrian interface on this site" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-md na-reason-input">
              </div>

              <% if (perPerson) { %>
                <!-- Per-person tagging. In Section 3 (PPE) this box is hidden
                     until "No" is pressed, so the auditor picks WHO was
                     non-compliant. Elsewhere it stays visible (compliant-by-
                     default single-out). -->
                <input type="hidden" name="q_<%= key %>_on_site_count" value="<%= initialOnSite %>" class="pp-onsite">
                <div class="pp-block bg-blue-50/40 border border-blue-100 rounded-lg p-3 <%= (isPPESection && currentState !== 'no') ? 'hidden' : '' %>" data-pp="<%= key %>" data-ppreveal="<%= isPPESection ? '1' : '' %>">
                  <% if (!crew.length) { %>
                    <p class="text-xs text-gray-500 italic" data-pp-empty>Add the workers on site above to tag individuals here.</p>
                  <% } %>
                  <p class="text-[11px] font-semibold text-blue-900 mb-2 <%= crew.length ? '' : 'hidden' %>" data-pp-intro><%= isPPESection ? 'Who was missing this? Tap each worker it applied to:' : 'Crew compliant by default — tap to single out anyone who wasn\'t:' %></p>
                  <div class="space-y-2 pp-rows" data-rows-key="<%= key %>">
                      <% crew.forEach(function(c){
                           const cid = String(c.crew_member_id);
                           const tg = tagByCrew[cid];
                           const tagged = exIds.indexOf(cid) !== -1 || !!tg;
                           const selected = _isPresent(c.crew_member_id);
                      %>
                        <div class="pp-crew-row <%= selected ? '' : 'hidden' %>" data-crew-row="<%= cid %>">
                          <label class="flex items-center gap-2">
                            <input type="checkbox" class="pp-tag-check w-4 h-4 rounded border-gray-300" name="q_<%= key %>_tag_members" value="<%= cid %>" <%= tagged ? 'checked' : '' %> <%= c.linked ? '' : 'disabled' %>>
                            <span class="text-sm text-gray-800"><%= c.full_name %></span>
                            <% if (!c.linked) { %><span class="text-[10px] text-amber-700">(link HR profile to tag)</span><% } %>
                          </label>
                          <div class="pp-tag-detail mt-1.5 ml-6 grid grid-cols-1 sm:grid-cols-3 gap-2 <%= tagged ? '' : 'hidden' %>">
                            <input name="q_<%= key %>_tag_<%= cid %>_issue" value="<%= tg ? (tg.issue||'') : '' %>" placeholder="What was wrong" class="text-sm px-2 py-1.5 border border-blue-200 rounded sm:col-span-2">
                            <select name="q_<%= key %>_tag_<%= cid %>_risk" class="text-sm px-2 py-1.5 border border-blue-200 rounded bg-white">
                              <% ['Low','Medium','High','Critical'].forEach(function(rl){ %><option value="<%= rl %>" <%= (tg && tg.risk_level===rl) || (!tg && rl==='Medium') ? 'selected' : '' %>><%= rl %></option><% }) %>
                            </select>
                            <label class="flex items-center gap-1.5 text-[11px] text-gray-600 sm:col-span-3">
                              <input type="checkbox" name="q_<%= key %>_tag_<%= cid %>_visibility" value="worker" <%= tg && tg.visibility==='worker' ? 'checked' : '' %> class="w-3.5 h-3.5 rounded border-gray-300">
                              Share this with the worker (else internal-only)
                            </label>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                </div>
              <% } else { %>
                <!-- Site-level NO block -->
                <div class="no-fields mt-1 bg-red-50 border border-red-200 rounded-lg p-3 space-y-3 <%= currentState === 'no' ? '' : 'hidden' %>" data-no-fields="<%= key %>">
                  <div>
                    <label class="block text-[11px] font-semibold text-red-900 uppercase tracking-wide mb-1">Observation <span class="text-red-500">*</span> <span class="text-[10px] font-normal text-gray-400 normal-case ml-1" data-charcount="q_<%= key %>_observation"></span></label>
                    <textarea name="q_<%= key %>_observation" rows="2" placeholder="Describe what you found, where..." class="w-full px-3 py-2 text-sm border border-red-200 rounded-md bg-white no-obs" data-minlen="20"><%= r.observation || '' %></textarea>
                  </div>
                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="block text-[11px] font-semibold text-red-900 uppercase tracking-wide mb-1">Risk Level <span class="text-red-500">*</span></label>
                      <select name="q_<%= key %>_risk_level" class="w-full px-3 py-2 text-sm border border-red-200 rounded-md bg-white no-risk">
                        <option value="">— Select —</option>
                        <% ['Low','Medium','High','Critical'].forEach(function(rl) { %><option value="<%= rl %>" <%= (r.risk_level || '') === rl ? 'selected' : '' %>><%= rl %></option><% }) %>
                      </select>
                    </div>
                    <div>
                      <label class="block text-[11px] font-semibold text-red-900 uppercase tracking-wide mb-1">Rectified on Site <span class="text-red-500">*</span></label>
                      <select name="q_<%= key %>_rectified" class="w-full px-3 py-2 text-sm border border-red-200 rounded-md bg-white no-rect">
                        <option value="">— Select —</option>
                        <option value="yes" <%= r.rectified_on_site === true ? 'selected' : '' %>>Yes</option>
                        <option value="no" <%= r.rectified_on_site === false ? 'selected' : '' %>>No — escalate</option>
                      </select>
                    </div>
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold text-red-900 uppercase tracking-wide mb-1">Corrective Action <span class="text-red-500">*</span> <span class="text-[10px] font-normal text-gray-400 normal-case ml-1" data-charcount="q_<%= key %>_corrective_action"></span></label>
                    <textarea name="q_<%= key %>_corrective_action" rows="2" placeholder="What action is required..." class="w-full px-3 py-2 text-sm border border-red-200 rounded-md bg-white no-action" data-minlen="20"><%= r.corrective_action || '' %></textarea>
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold text-red-900 uppercase tracking-wide mb-1">Responsible Person <span class="text-red-500">*</span></label>
                    <input name="q_<%= key %>_responsible" value="<%= r.responsible || '' %>" placeholder="Name and role" class="w-full px-3 py-2 text-sm border border-red-200 rounded-md bg-white no-resp">
                  </div>
                  <% if (isPPESection) { %>
                    <!-- Optional: attribute this to specific workers → adds a
                         note to their HR review. Does not change the score. -->
                    <div class="pp-affected pt-3 border-t border-red-200" data-affected="<%= key %>">
                      <p class="text-[11px] font-semibold text-red-900 mb-2">Which worker(s) did this affect? <span class="font-normal text-red-700/70">(optional — adds a note to their review)</span></p>
                      <p class="text-xs text-gray-500 italic <%= crew.length ? 'hidden' : '' %>" data-pp-empty>Add the workers on site above to attribute individuals here.</p>
                      <div class="space-y-2 pp-rows" data-rows-key="<%= key %>">
                        <% crew.forEach(function(c){
                             const cid = String(c.crew_member_id);
                             const tg = tagByCrew[cid];
                             const tagged = !!tg;
                             const selected = _isPresent(c.crew_member_id);
                        %>
                          <div class="pp-crew-row <%= selected ? '' : 'hidden' %>" data-crew-row="<%= cid %>">
                            <label class="flex items-center gap-2">
                              <input type="checkbox" class="pp-tag-check w-4 h-4 rounded border-gray-300" name="q_<%= key %>_tag_members" value="<%= cid %>" <%= tagged ? 'checked' : '' %> <%= c.linked ? '' : 'disabled' %>>
                              <span class="text-sm text-gray-800"><%= c.full_name %></span>
                              <% if (!c.linked) { %><span class="text-[10px] text-amber-700">(link HR profile to tag)</span><% } %>
                            </label>
                            <div class="pp-tag-detail mt-1.5 ml-6 grid grid-cols-1 sm:grid-cols-3 gap-2 <%= tagged ? '' : 'hidden' %>">
                              <input name="q_<%= key %>_tag_<%= cid %>_issue" value="<%= tg ? (tg.issue||'') : '' %>" placeholder="What was wrong" class="text-sm px-2 py-1.5 border border-red-200 rounded sm:col-span-2">
                              <select name="q_<%= key %>_tag_<%= cid %>_risk" class="text-sm px-2 py-1.5 border border-red-200 rounded bg-white">
                                <% ['Low','Medium','High','Critical'].forEach(function(rl){ %><option value="<%= rl %>" <%= (tg && tg.risk_level===rl) || (!tg && rl==='Medium') ? 'selected' : '' %>><%= rl %></option><% }) %>
                              </select>
                              <label class="flex items-center gap-1.5 text-[11px] text-gray-600 sm:col-span-3">
                                <input type="checkbox" name="q_<%= key %>_tag_<%= cid %>_visibility" value="worker" <%= tg && tg.visibility==='worker' ? 'checked' : '' %> class="w-3.5 h-3.5 rounded border-gray-300">
                                Share this with the worker (else internal-only)
                              </label>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% } %>
                </div>
              <% } %>

              <!-- Critical auto-fail override (with justification) -->
              <% if (q.is_critical) { %>
                <div class="crit-override hidden bg-amber-50 border border-amber-200 rounded-lg p-3" data-crit-override="<%= key %>">
                  <label class="flex items-center gap-2 text-xs font-semibold text-amber-900">
                    <input type="checkbox" name="q_<%= key %>_critical_override" value="1" <%= r.critical_override ? 'checked' : '' %> class="crit-override-check w-4 h-4 rounded border-amber-400">
                    Override the automatic Fail for this critical item
                  </label>
                  <div class="crit-override-reason mt-2 <%= r.critical_override ? '' : 'hidden' %>">
                    <input name="q_<%= key %>_override_reason" value="<%= r.override_reason || '' %>" placeholder="Justify why this scenario doesn't warrant a Fail (required)" class="w-full px-3 py-2 text-sm border border-amber-300 rounded-md bg-white override-reason-input">
                  </div>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>

        <div class="px-4 sm:px-5 py-3 border-t border-gray-100 bg-blue-50/30">
            <details class="group">
              <summary class="cursor-pointer text-xs font-semibold text-brand-700 hover:text-brand-800 flex items-center gap-1 select-none">
                <svg class="w-3.5 h-3.5 transition group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                Section <%= section.key %> evidence
                <% const cnt = (ctxMap['section_' + section.key] || []).length; %><% if (cnt) { %><span class="ml-1 bg-brand-600 text-white px-1.5 rounded-full text-[10px]"><%= cnt %></span><% } %>
              </summary>
              <div class="mt-3"><%- include('_upload_block', { auditId: isEdit ? a.id : '', contextKey: 'section_' + section.key, label: 'Add photos for section ' + section.key, hint: 'Tap to take a photo or choose file', accept: 'image/*,application/pdf', returnTo: isEdit ? '/audits/' + a.id + '/edit#section-' + section.key : '/audits/new', items: ctxMap['section_' + section.key] || [], csrfToken: (typeof csrfToken !== 'undefined' ? csrfToken : '') }) %></div>
            </details>
          </div>

        <div class="px-4 sm:px-5 py-3 border-t border-gray-100 bg-gray-50">
          <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wide mb-1">Section Comments</label>
          <textarea name="section_<%= section.key %>_comments" rows="2" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-md bg-white"><%= sectionComments[section.key] || '' %></textarea>
        </div>
      </section>
    <% }) %>

    <!-- Non-Conformance Register (legacy register retained alongside per-person tags) -->
    <section class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <header class="bg-red-600 text-white px-4 sm:px-5 py-3"><h2 class="text-sm lg:text-base font-bold">Non-Conformance Register</h2></header>
      <div class="md:hidden divide-y divide-gray-100">
        <% for (let i = 1; i <= 10; i++) { const nc = (nonconformances || [])[i-1] || {}; %>
          <details class="group" <%= nc.issue ? 'open' : '' %>>
            <summary class="px-4 py-3 cursor-pointer select-none flex items-center justify-between hover:bg-gray-50"><span class="text-sm font-medium text-gray-900">NC #<%= i %><% if (nc.issue) { %> <span class="text-xs text-gray-500 font-normal">— <%= nc.issue.slice(0,40) %></span><% } %></span></summary>
            <div class="px-4 pb-4 space-y-3">
              <div><label class="block text-[11px] font-semibold text-gray-500 uppercase mb-1">Issue</label><input name="nc_<%= i %>_issue" value="<%= nc.issue || '' %>" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg"></div>
              <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-[11px] font-semibold text-gray-500 uppercase mb-1">Risk</label><select name="nc_<%= i %>_risk" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg bg-white"><option value="">—</option><% ['Low','Medium','High','Critical'].forEach(function(r){ %><option value="<%= r %>" <%= nc.risk === r ? 'selected' : '' %>><%= r %></option><% }) %></select></div>
                <div class="flex items-end pb-1"><label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="nc_<%= i %>_closed" value="1" <%= nc.closed ? 'checked' : '' %> class="w-5 h-5 rounded border-gray-300">Closed</label></div>
              </div>
              <div><label class="block text-[11px] font-semibold text-gray-500 uppercase mb-1">Action</label><input name="nc_<%= i %>_action" value="<%= nc.action || '' %>" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg"></div>
              <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-[11px] font-semibold text-gray-500 uppercase mb-1">Responsible</label><input name="nc_<%= i %>_responsible" value="<%= nc.responsible || '' %>" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg"></div>
                <div><label class="block text-[11px] font-semibold text-gray-500 uppercase mb-1">Due</label><input type="date" name="nc_<%= i %>_due" value="<%= nc.due_date || '' %>" class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg"></div>
              </div>
            </div>
          </details>
        <% } %>
      </div>
      <div class="p-3 sm:p-4 overflow-x-auto hidden md:block">
        <table class="w-full text-sm"><thead><tr class="text-left text-xs font-semibold text-gray-500 uppercase"><th class="py-2 pr-2 w-8">#</th><th class="py-2 pr-2">Issue Found</th><th class="py-2 pr-2 w-28">Risk</th><th class="py-2 pr-2">Action Required</th><th class="py-2 pr-2 w-36">Responsible</th><th class="py-2 pr-2 w-36">Due</th><th class="py-2 pr-2 w-16 text-center">Closed</th></tr></thead>
          <tbody>
            <% for (let i = 1; i <= 10; i++) { const nc = (nonconformances || [])[i-1] || {}; %>
              <tr class="border-t border-gray-100 align-top">
                <td class="py-2 pr-2 text-xs text-gray-500 pt-3.5"><%= i %></td>
                <td class="py-2 pr-2"><input name="nc_<%= i %>_issue" value="<%= nc.issue || '' %>" class="w-full px-2 py-2 text-sm border border-gray-200 rounded"></td>
                <td class="py-2 pr-2"><select name="nc_<%= i %>_risk" class="w-full px-2 py-2 text-sm border border-gray-200 rounded bg-white"><option value="">—</option><% ['Low','Medium','High','Critical'].forEach(function(r){ %><option value="<%= r %>" <%= nc.risk === r ? 'selected' : '' %>><%= r %></option><% }) %></select></td>
                <td class="py-2 pr-2"><input name="nc_<%= i %>_action" value="<%= nc.action || '' %>" class="w-full px-2 py-2 text-sm border border-gray-200 rounded"></td>
                <td class="py-2 pr-2"><input name="nc_<%= i %>_responsible" value="<%= nc.responsible || '' %>" class="w-full px-2 py-2 text-sm border border-gray-200 rounded"></td>
                <td class="py-2 pr-2"><input type="date" name="nc_<%= i %>_due" value="<%= nc.due_date || '' %>" class="w-full px-2 py-2 text-sm border border-gray-200 rounded"></td>
                <td class="py-2 pr-2 text-center pt-3.5"><input type="checkbox" name="nc_<%= i %>_closed" value="1" <%= nc.closed ? 'checked' : '' %> class="w-5 h-5 rounded border-gray-300"></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Score summary + overall finding -->
    <section class="bg-white border border-gray-200 rounded-xl p-4 sm:p-5">
      <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-3">Audit Scoring Summary <span class="text-[11px] font-normal text-gray-400 normal-case">— risk-weighted</span></h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 mb-4" id="score-summary">
        <% (scoreGroups||[]).forEach(function(g) { const gr = (score.groups||[]).find(function(x){return x.label===g.label;}) || {}; %>
          <div class="flex items-center justify-between px-3 py-2.5 bg-gray-50 rounded-lg" data-group-label="<%= g.label %>">
            <span class="text-sm font-medium text-gray-700"><%= g.label %></span>
            <span class="text-sm font-bold text-gray-900"><span data-g-percent><%= gr.percent || 0 %></span>%</span>
          </div>
        <% }) %>
      </div>
      <div class="pt-3 border-t border-gray-200 flex items-center justify-between">
        <span class="text-sm font-bold text-gray-900 uppercase tracking-wide">Overall (weighted)</span>
        <span class="text-xl font-bold text-brand-700"><span id="live-percent-2"><%= score.percent || 0 %></span>%</span>
      </div>
      <div id="crit-fail-banner" class="<%= score.criticalFail ? '' : 'hidden' %> mt-3 rounded-lg bg-red-50 border border-red-300 px-3 py-2 text-xs font-semibold text-red-800">⚠ Critical item failed — this audit auto-fails unless the critical item is overridden with a justification.</div>

      <div class="mt-5">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide">Finding</span>
          <span class="text-[11px] text-gray-500">Suggested: <span id="suggested-finding" class="font-bold"><%= (score.suggestedFinding||'').replace('_',' ') || '—' %></span></span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-3">
          <% ['pass','pass_with_actions','fail'].forEach(function(opt) { const labels = { pass: 'Pass', pass_with_actions: 'Pass with actions', fail: 'Fail' }; const colors = { pass: 'emerald', pass_with_actions: 'amber', fail: 'red' }; const c = colors[opt]; %>
            <label class="flex items-center gap-2 px-4 py-3 border-2 rounded-lg cursor-pointer transition <%= val('overall_finding') === opt ? `border-${c}-500 bg-${c}-50` : 'border-gray-200 hover:border-gray-300' %>">
              <input type="radio" name="overall_finding" value="<%= opt %>" <%= val('overall_finding') === opt ? 'checked' : '' %> class="finding-radio w-4 h-4 text-<%= c %>-600"><span class="text-sm font-semibold text-gray-800"><%= labels[opt] %></span>
            </label>
          <% }) %>
        </div>
        <div id="finding-override-wrap" class="mt-3 <%= val('finding_overridden') ? '' : 'hidden' %>">
          <label class="block text-[11px] font-semibold text-gray-600 uppercase tracking-wide mb-1">Reason for overriding the suggested finding <span class="text-red-500">*</span></label>
          <input name="finding_override_reason" id="finding-override-reason" value="<%= val('finding_override_reason') %>" placeholder="Why the chosen finding differs from the suggestion" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-md">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mt-5">
        <label class="flex items-center gap-2 px-3 py-2.5 bg-gray-50 rounded-lg"><input type="checkbox" name="follow_up_required" value="1" <%= val('follow_up_required') ? 'checked' : '' %> class="w-5 h-5 rounded border-gray-300"><span class="text-sm font-medium text-gray-700">Follow-up required</span></label>
        <div><label class="block text-xs font-semibold text-gray-700 mb-1">Follow-up date</label><input type="date" name="follow_up_date" value="<%= val('follow_up_date') %>" class="w-full px-3 py-2.5 text-sm border border-gray-300 rounded-lg"></div>
      </div>
    </section>

    <!-- Sign-off -->
    <section id="signoff" class="bg-white border border-gray-200 rounded-xl p-4 sm:p-5">
      <h2 class="text-sm font-bold text-gray-900 uppercase tracking-wide mb-1">Sign-off</h2>
      <%# Pads render in NEW mode too — the audit id late-binds after the
          silent background draft, so no reload is ever needed to sign. %>
      <p class="text-xs text-gray-500 mb-4">Draw to sign (finger or stylus) and tap <span class="font-semibold">Save signature</span>, or type a full name as a fallback. Timestamp recorded server-side.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <%- include('partials/signature-pad', { slot: 'auditor', label: 'Auditor', auditId: isEdit ? a.id : '', currentPath: val('auditor_signature_path'), signedAt: val('auditor_signed_at'), fallbackName: val('auditor_signature_text') }) %>
        <%- include('partials/signature-pad', { slot: 'supervisor', label: 'Supervisor / STMS', auditId: isEdit ? a.id : '', currentPath: val('supervisor_signature_path'), signedAt: val('supervisor_signed_at'), fallbackName: val('supervisor_signature_text') }) %>
      </div>
    </section>

    <div class="flex flex-col sm:flex-row gap-3 pb-2">
      <button type="submit" name="submit" value="0" class="flex-1 px-4 py-3.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold rounded-xl transition">Save as Draft</button>
      <button type="submit" name="submit" value="1" class="flex-1 px-4 py-3.5 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl transition"><%= isEdit ? 'Update & Submit' : 'Submit Audit' %></button>
      <a href="/audits<%= isEdit ? '/' + a.id : '' %>" class="sm:w-auto px-4 py-3 text-center text-gray-600 hover:text-gray-900 font-medium">Cancel</a>
    </div>
  </form>
</div>

<script>
  window.AUDIT_QUESTIONS = <%- JSON.stringify((sections||[]).flatMap(function(s){ return s.questions.map(function(q){ return { key:q.key, group:s.score_group, mode:q.scoring_mode, critical:!!q.is_critical, band:q.risk_band }; }); })) %>;
  window.SCORE_WEIGHTS = { Low:1, Medium:3, High:7, Critical:15 };
  window.FINDING_THRESHOLDS = { failBelow:75, passAtOrAbove:95 };
  window.AUDIT_IS_EDIT = <%= isEdit ? 'true' : 'false' %>;
  window.AUDIT_CSRF = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
</script>
<script>
(function() {
  var W = window.SCORE_WEIGHTS, QS = window.AUDIT_QUESTIONS, FT = window.FINDING_THRESHOLDS;
  function wf(band){ return W[band] != null ? W[band] : W.Medium; }
  function getState(key){ var el = document.querySelector('input[name="q_'+key+'_state"]:checked'); return el ? el.value : ''; }
  function onSiteCount(){ return document.querySelectorAll('.crew-check:checked').length; }
  function exceptionsFor(key){ return document.querySelectorAll('input[name="q_'+key+'_tag_members"]:checked'); }
  function overridden(key){ var el = document.querySelector('input[name="q_'+key+'_critical_override"]'); return !!(el && el.checked); }

  function recalc() {
    var onSite = onSiteCount();
    var groups = {}; var openActions = 0, criticalFail = false;
    QS.forEach(function(q){
      var g = groups[q.group] || (groups[q.group] = { ws:0, wm:0 });
      var st = getState(q.key);
      if (q.mode === 'per_person') {
        if (st === 'na' || onSite <= 0) return;
        var exs = exceptionsFor(q.key);
        var compliant = Math.max(0, onSite - exs.length);
        var frac = onSite > 0 ? compliant/onSite : 1;
        var wq = wf(q.band); g.wm += wq; g.ws += wq*frac; openActions += exs.length;
        if (q.critical && !overridden(q.key)) { exs.forEach(function(ex){ var sel = document.querySelector('select[name="q_'+q.key+'_tag_'+ex.value+'_risk"]'); if (sel && sel.value === 'Critical') criticalFail = true; }); }
      } else {
        if (st === '' || st === 'na') return;
        var band = q.band;
        if (st === 'no') { var rsel = document.querySelector('select[name="q_'+q.key+'_risk_level"]'); if (rsel && rsel.value) band = rsel.value; }
        var w = wf(band); g.wm += w;
        if (st === 'yes') g.ws += w;
        else { openActions += 1; if (q.critical && !overridden(q.key)) criticalFail = true; }
      }
    });
    var totWs = 0, totWm = 0;
    Object.keys(groups).forEach(function(label){ var g = groups[label]; totWs += g.ws; totWm += g.wm; var pct = g.wm ? Math.round(g.ws/g.wm*100) : 0; var el = document.querySelector('[data-group-label="'+label+'"] [data-g-percent]'); if (el) el.textContent = pct; });
    var pct = totWm ? Math.round(totWs/totWm*100) : 0;
    var p1 = document.getElementById('live-percent'); if (p1) p1.textContent = pct + '%';
    var p2 = document.getElementById('live-percent-2'); if (p2) p2.textContent = pct;
    document.getElementById('live-critical-badge').classList.toggle('hidden', !criticalFail);
    document.getElementById('crit-fail-banner').classList.toggle('hidden', !criticalFail);
    // suggested finding
    var finding = criticalFail ? 'fail' : (pct < FT.failBelow ? 'fail' : ((openActions > 0 || pct < FT.passAtOrAbove) ? 'pass_with_actions' : 'pass'));
    var sf = document.getElementById('suggested-finding'); if (sf) sf.textContent = finding.replace('_',' ');
    // section pills
    document.querySelectorAll('[data-section] [data-section-score]').forEach(function(pill){
      var sec = pill.closest('[data-section]'); var items = sec.querySelectorAll('[data-item]'); var done = 0, tot = 0;
      items.forEach(function(it){ var k = it.getAttribute('data-item'); var s = getState(k); if (it.getAttribute('data-mode')==='per_person') { if (s!=='na') { tot++; if (exceptionsFor(k).length===0) done++; } } else if (s && s!=='na') { tot++; if (s==='yes') done++; } });
      pill.textContent = done + '/' + tot;
    });
  }

  function paintPill(key) {
    var group = document.querySelector('[data-pillgroup="'+key+'"]'); if (!group) return;
    group.querySelectorAll('input[type="radio"]').forEach(function(input){ var span = input.nextElementSibling; if (!span) return; span.className = 'block text-center px-4 py-2.5 sm:py-1.5 text-sm sm:text-xs font-semibold transition select-none'; if (input.checked) { if (input.value==='yes') span.classList.add('bg-emerald-600','text-white'); else if (input.value==='no') span.classList.add('bg-red-600','text-white'); else span.classList.add('bg-gray-500','text-white'); } else span.classList.add('text-gray-600'); });
  }
  function toggleNoFields(key, state) {
    var noBlock = document.querySelector('[data-no-fields="'+key+'"]'); var notes = document.querySelector('[data-notes-for="'+key+'"]'); var na = document.querySelector('[data-na-reason-for="'+key+'"]');
    if (noBlock) { if (state==='no') { noBlock.classList.remove('hidden'); if (notes) notes.classList.add('hidden'); } else { noBlock.classList.add('hidden'); if (notes) notes.classList.remove('hidden'); } }
    if (na) na.classList.toggle('hidden', state !== 'na');
    // Section 3 PPE: the per-person "who?" box only appears on No. Leaving No
    // clears any flagged workers so the score reflects "all compliant".
    var ppReveal = document.querySelector('[data-pp="'+key+'"][data-ppreveal="1"]');
    if (ppReveal) {
      if (state === 'no') { ppReveal.classList.remove('hidden'); if (notes) notes.classList.add('hidden'); }
      else {
        ppReveal.classList.add('hidden');
        ppReveal.querySelectorAll('.pp-tag-check:checked').forEach(function(chk){ chk.checked = false; var d = chk.closest('[data-crew-row]'); var det = d && d.querySelector('.pp-tag-detail'); if (det) det.classList.add('hidden'); });
      }
    }
    updateCritOverride(key);
  }
  function updateCritOverride(key) {
    var wrap = document.querySelector('[data-crit-override="'+key+'"]'); if (!wrap) return;
    var st = getState(key);
    var hasCriticalExc = false; exceptionsFor(key).forEach(function(ex){ var sel = document.querySelector('select[name="q_'+key+'_tag_'+ex.value+'_risk"]'); if (sel && sel.value === 'Critical') hasCriticalExc = true; });
    wrap.classList.toggle('hidden', !(st === 'no' || hasCriticalExc));
  }
  function updateCharCount(el) {
    var minLen = parseInt(el.getAttribute('data-minlen')||'0',10); if (!minLen) return;
    var counter = document.querySelector('[data-charcount="'+el.name+'"]'); if (!counter) return;
    var len = (el.value||'').length;
    if (len < minLen) { counter.textContent = (minLen-len)+' more chars needed'; counter.className='text-[10px] font-normal text-red-500 normal-case ml-1'; }
    else { counter.textContent = len+' chars'; counter.className='text-[10px] font-normal text-gray-400 normal-case ml-1'; }
  }

  // crew selection drives per-person taggable rows + on-site count
  function syncCrewRows() {
    var checkedIds = Array.prototype.map.call(document.querySelectorAll('.crew-check:checked'), function(c){ return c.value; });
    document.querySelectorAll('[data-crew-row]').forEach(function(row){ var id = row.getAttribute('data-crew-row'); row.classList.toggle('hidden', checkedIds.indexOf(id) === -1); });
    document.querySelectorAll('.pp-onsite').forEach(function(h){ h.value = checkedIds.length; });
    var cc = document.getElementById('crew-count'); if (cc) cc.textContent = checkedIds.length;
  }

  // ---- Add a worker to the on-site roster (not on the auto-pulled roster) ----
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function ppRowHtml(key, cid, name, linked, red) {
    var bd = red ? 'border-red-200' : 'border-blue-200';
    var risk = ['Low','Medium','High','Critical'].map(function(rl){ return '<option value="'+rl+'"'+(rl==='Medium'?' selected':'')+'>'+rl+'</option>'; }).join('');
    return '<div class="pp-crew-row" data-crew-row="'+cid+'">'
      + '<label class="flex items-center gap-2">'
      + '<input type="checkbox" class="pp-tag-check w-4 h-4 rounded border-gray-300" name="q_'+key+'_tag_members" value="'+cid+'"'+(linked?'':' disabled')+'>'
      + '<span class="text-sm text-gray-800">'+esc(name)+'</span>'
      + (linked?'':'<span class="text-[10px] text-amber-700">(link HR profile to tag)</span>')
      + '</label>'
      + '<div class="pp-tag-detail mt-1.5 ml-6 grid grid-cols-1 sm:grid-cols-3 gap-2 hidden">'
      + '<input name="q_'+key+'_tag_'+cid+'_issue" placeholder="What was wrong" class="text-sm px-2 py-1.5 border '+bd+' rounded sm:col-span-2">'
      + '<select name="q_'+key+'_tag_'+cid+'_risk" class="text-sm px-2 py-1.5 border '+bd+' rounded bg-white">'+risk+'</select>'
      + '<label class="flex items-center gap-1.5 text-[11px] text-gray-600 sm:col-span-3"><input type="checkbox" name="q_'+key+'_tag_'+cid+'_visibility" value="worker" class="w-3.5 h-3.5 rounded border-gray-300">Share this with the worker (else internal-only)</label>'
      + '</div></div>';
  }
  function addWorker(cid, name, linked) {
    cid = String(cid);
    var list = document.getElementById('crew-list'); if (!list) return;
    if (list.querySelector('.crew-check[value="'+cid+'"]')) return; // already listed
    var lbl = document.createElement('label');
    lbl.className = 'flex items-center gap-2 px-3 py-2 rounded-lg border ' + (linked ? 'border-gray-200' : 'border-amber-300 bg-amber-50');
    lbl.setAttribute('data-crew-label', cid);
    lbl.innerHTML = '<input type="checkbox" class="crew-check w-4 h-4 rounded border-gray-300" name="crew_member_ids" value="'+cid+'" data-linked="'+(linked?'1':'0')+'" data-name="'+esc(name)+'" checked>'
      + '<span class="text-sm text-gray-800 flex-1 min-w-0 truncate">'+esc(name)+'</span>'
      + (linked?'':'<span class="text-[10px] font-semibold text-amber-700 whitespace-nowrap" title="No HR profile linked — a flag won\'t push to their review">no HR link</span>');
    list.appendChild(lbl);
    var emptyNote = document.getElementById('crew-empty'); if (emptyNote) emptyNote.remove();
    // Inject a taggable row into every per-person + affected checklist.
    document.querySelectorAll('.pp-rows').forEach(function(container){
      if (container.querySelector('[data-crew-row="'+cid+'"]')) return;
      var key = container.getAttribute('data-rows-key');
      var red = !!container.closest('.pp-affected');
      container.insertAdjacentHTML('beforeend', ppRowHtml(key, cid, name, linked, red));
      var wrap = container.closest('.pp-block, .pp-affected');
      if (wrap) { var emp = wrap.querySelector('[data-pp-empty]'); if (emp) emp.classList.add('hidden'); var intro = wrap.querySelector('[data-pp-intro]'); if (intro) intro.classList.remove('hidden'); }
    });
    syncCrewRows(); recalc();
  }
  (function(){
    var addBtn = document.getElementById('add-worker-btn'); var addSel = document.getElementById('add-worker-select');
    if (!addBtn || !addSel) return;
    addBtn.addEventListener('click', function(){
      var opt = addSel.options[addSel.selectedIndex]; if (!opt || !opt.value) return;
      addWorker(opt.value, opt.getAttribute('data-name') || opt.textContent, opt.getAttribute('data-linked') === '1');
      opt.remove(); addSel.value = '';
    });
  })();

  document.addEventListener('change', function(e) {
    if (e.target.matches('.q-state')) { var m = e.target.name.match(/^q_(.+)_state$/); if (m) { paintPill(m[1]); toggleNoFields(m[1], e.target.value); } recalc(); maybeAutoDraft(); }
    if (e.target.matches('.crew-check')) { syncCrewRows(); recalc(); maybeAutoDraft(); }
    if (e.target.matches('.pp-tag-check')) { var d = e.target.closest('[data-crew-row]'); var det = d && d.querySelector('.pp-tag-detail'); if (det) det.classList.toggle('hidden', !e.target.checked); var mm = e.target.name.match(/^q_(.+)_tag_members$/); if (mm) updateCritOverride(mm[1]); recalc(); }
    if (e.target.matches('select[name$="_risk"]') || e.target.matches('select[name$="_risk_level"]')) { var rk = e.target.name.match(/^q_(.+)_(tag_.+_risk|risk_level)$/); if (rk) updateCritOverride(rk[1]); recalc(); }
    if (e.target.matches('.crit-override-check')) { var w = e.target.closest('.crit-override'); var rr = w && w.querySelector('.crit-override-reason'); if (rr) rr.classList.toggle('hidden', !e.target.checked); recalc(); }
    if (e.target.matches('.finding-radio')) { var sf = document.getElementById('suggested-finding'); var wrap = document.getElementById('finding-override-wrap'); if (sf && wrap) wrap.classList.toggle('hidden', e.target.value === sf.textContent.replace(' ','_')); }
  });
  document.addEventListener('input', function(e) {
    if (e.target.closest && e.target.closest('#auditForm')) maybeAutoDraft();
    if (e.target.matches('[data-minlen]')) updateCharCount(e.target);
  });
  document.querySelectorAll('[data-minlen]').forEach(updateCharCount);

  var auditForm = document.getElementById('auditForm');
  if (auditForm) auditForm.addEventListener('submit', function(e) {
    if (e.submitter && e.submitter.value === '0') return; // draft skips validation
    var errors = [];
    document.querySelectorAll('[data-no-fields]').forEach(function(block){ if (block.classList.contains('hidden')) return; var key = block.getAttribute('data-no-fields'); var obs=block.querySelector('.no-obs'),risk=block.querySelector('.no-risk'),action=block.querySelector('.no-action'),resp=block.querySelector('.no-resp'),rect=block.querySelector('.no-rect'); if (obs&&obs.value.trim().length<20) errors.push(key+': observation needs 20+ chars'); if (risk&&!risk.value) errors.push(key+': risk level required'); if (action&&action.value.trim().length<20) errors.push(key+': corrective action needs 20+ chars'); if (resp&&!resp.value.trim()) errors.push(key+': responsible person required'); if (rect&&!rect.value) errors.push(key+': rectified on site required'); });
    // N/A reason required on critical items
    document.querySelectorAll('[data-na-reason-for]').forEach(function(wrap){ if (wrap.classList.contains('hidden')) return; var key = wrap.getAttribute('data-na-reason-for'); var item = document.querySelector('[data-item="'+key+'"]'); if (item && item.getAttribute('data-critical')==='1') { var inp = wrap.querySelector('.na-reason-input'); if (inp && !inp.value.trim()) errors.push(key+': justification required to mark a critical item N/A'); } });
    // critical override needs a reason
    document.querySelectorAll('.crit-override-check:checked').forEach(function(chk){ var w = chk.closest('.crit-override'); var inp = w && w.querySelector('.override-reason-input'); if (inp && !inp.value.trim()) errors.push('A critical override needs a justification'); });
    // finding override reason
    var fw = document.getElementById('finding-override-wrap'); if (fw && !fw.classList.contains('hidden')) { var fr = document.getElementById('finding-override-reason'); if (fr && !fr.value.trim()) errors.push('Reason required for overriding the suggested finding'); }
    if (errors.length) { e.preventDefault(); alert('Please resolve:\n\n• ' + errors.join('\n• ')); }
  });

  var jobSelect = document.getElementById('job-select');
  if (jobSelect) jobSelect.addEventListener('change', function() { var opt = this.options[this.selectedIndex]; if (!opt||!opt.value) return; var num=opt.getAttribute('data-job-number')||'',client=opt.getAttribute('data-client')||'',site=opt.getAttribute('data-site')||'',suburb=opt.getAttribute('data-suburb')||''; var fields={'f-project_site':num+(client?' — '+client:''),'f-client':client,'f-location':[site,suburb].filter(Boolean).join(', ')}; Object.keys(fields).forEach(function(id){ var el=document.getElementById(id); if (el&&!el.value&&fields[id]) el.value=fields[id]; }); });

  // Silent background draft. Previously this navigated to /audits/:id/edit
  // on the FIRST answer — a full page reload that jumped the auditor back
  // to the top mid-form. Now the draft is created in place: the returned id
  // late-binds onto the form action, every upload block and signature pad,
  // and the URL (replaceState), so nothing on screen moves.
  var draftPromise = null;
  function maybeAutoDraft() {
    if (window.AUDIT_IS_EDIT) return Promise.resolve(null);
    if (draftPromise) return draftPromise;
    var form = document.getElementById('auditForm');
    var fd = new FormData(form); var body = new URLSearchParams();
    for (var pair of fd.entries()) body.append(pair[0], pair[1]);
    body.set('_csrf', window.AUDIT_CSRF);
    draftPromise = fetch('/audits/draft', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':window.AUDIT_CSRF,'Accept':'application/json'}, body: body.toString(), credentials:'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (!data || !data.ok || !data.id) { draftPromise = null; return null; }
        window.AUDIT_IS_EDIT = true;
        window.AUDIT_ID = data.id;
        form.setAttribute('action', '/audits/' + data.id);
        document.querySelectorAll('[data-upload-block], .audit-sig').forEach(function (el) {
          el.setAttribute('data-audit-id', data.id);
        });
        var status = document.getElementById('draft-status');
        if (status) status.classList.remove('hidden');
        try { history.replaceState(null, '', '/audits/' + data.id + '/edit'); } catch (e) {}
        return data.id;
      })
      .catch(function(){ draftPromise = null; return null; });
    return draftPromise;
  }
  window.auditEnsureDraft = maybeAutoDraft;

  syncCrewRows();
  // Reveal any Section-3 "who?" box that already has flagged workers (older
  // audits saved per-person flags with state 'yes', so the No-gated block
  // would otherwise hide them).
  document.querySelectorAll('[data-pp][data-ppreveal="1"]').forEach(function(pp){
    if (pp.querySelector('.pp-tag-check:checked')) pp.classList.remove('hidden');
  });
  document.querySelectorAll('[data-crit-override]').forEach(function(w){ updateCritOverride(w.getAttribute('data-crit-override')); });
  recalc();

  // ---- Upload blocks (fetch-based, sit inside the main form) ----
  function uplSetBusy(block, busy, err){ var prog=block.querySelector('.upl-progress'),errEl=block.querySelector('.upl-error'); if(prog)prog.classList.toggle('hidden',!busy); if(errEl){ if(err){errEl.textContent=err;errEl.classList.remove('hidden');}else{errEl.classList.add('hidden');errEl.textContent='';}} }
  function uplRenderAttachment(att){ var isImg=(att.mime_type||'').startsWith('image/'); var div=document.createElement('div'); div.className='group relative bg-gray-50 border border-gray-200 rounded-lg overflow-hidden'; div.setAttribute('data-att-id',att.id); var thumb=isImg?'<a href="'+att.file_path+'"><img src="'+att.file_path+'" class="w-full h-20 sm:h-24 object-cover"></a>':'<a href="'+att.file_path+'" class="flex items-center justify-center h-20 sm:h-24 bg-gray-100 text-xs text-gray-500 px-2 text-center break-words">'+(att.original_name||'file')+'</a>'; div.innerHTML=thumb+'<button type="button" class="upl-delete absolute top-1 right-1 w-6 h-6 bg-red-600 text-white rounded-full text-xs font-bold opacity-80 group-hover:opacity-100 transition" data-att-id="'+att.id+'">×</button>'; return div; }
  async function uplDoUpload(block, files){ if(!files||!files.length)return; var auditId=block.getAttribute('data-audit-id'),ctx=block.getAttribute('data-context-key'),captionEl=block.querySelector('.upl-caption'),caption=captionEl?captionEl.value:''; uplSetBusy(block,true,''); try {
      // New-mode form: no audit row yet — create the silent draft first,
      // which late-binds data-audit-id onto every block (no reload).
      if(!auditId && window.auditEnsureDraft){ await window.auditEnsureDraft(); auditId=block.getAttribute('data-audit-id'); }
      if(!auditId) throw new Error('Could not start the draft — try Save as Draft'); var fd=new FormData(); fd.append('context_key',ctx); if(caption)fd.append('caption',caption); for(var i=0;i<files.length;i++)fd.append('files',files[i]); var r=await fetch('/audits/'+auditId+'/attachments?json=1',{method:'POST',body:fd,credentials:'same-origin',headers:{'Accept':'application/json','X-CSRF-Token':window.AUDIT_CSRF}}); if(!r.ok)throw new Error('Upload failed'); var data=await r.json(); if(!data.ok)throw new Error(data.error||'Upload failed'); var grid=block.querySelector('.upl-grid'); (data.attachments||[]).forEach(function(att){ grid.appendChild(uplRenderAttachment(att)); }); grid.classList.remove('hidden'); if(captionEl)captionEl.value=''; } catch(e){ uplSetBusy(block,false,e.message||'Upload failed'); return; } uplSetBusy(block,false,''); }
  document.addEventListener('change', function(e){ if(e.target.matches('.upl-file')||e.target.matches('.upl-camera')){ var block=e.target.closest('[data-upload-block]'); if(!block)return; uplDoUpload(block,e.target.files); e.target.value=''; } });
  document.addEventListener('click', function(e){ var btn=e.target.closest('.upl-delete'); if(!btn)return; var block=btn.closest('[data-upload-block]'); if(!block)return; if(!confirm('Delete this file?'))return; var auditId=block.getAttribute('data-audit-id'),attId=btn.getAttribute('data-att-id'); fetch('/audits/'+auditId+'/attachments/'+attId+'/delete?json=1',{method:'POST',credentials:'same-origin',headers:{'Accept':'application/json','X-CSRF-Token':window.AUDIT_CSRF}}).then(function(r){return r.json();}).then(function(data){ if(data&&data.ok){ var wrap=btn.closest('[data-att-id]'); if(wrap)wrap.remove(); } }); });
})();
</script>
<script src="/js/worker-sig-pad.js"></script>
<script>
(function(){
  if (!window.WorkerSigPad) return;
  function setStatus(w, m, c){ var s = w.querySelector('.audit-sig-status'); if (s) { s.textContent = m; s.className = 'audit-sig-status text-[11px] ' + (c || ''); } }
  document.querySelectorAll('.audit-sig').forEach(function(wrap){
    var canvas = wrap.querySelector('.audit-sig-pad'); if (!canvas) return;
    var pad; try { pad = WorkerSigPad.setup(canvas, wrap, {}); } catch (e) { return; }
    var clr = wrap.querySelector('.audit-sig-clear'); if (clr) clr.addEventListener('click', function(){ pad.clear(); setStatus(wrap, '', ''); });
    var sv = wrap.querySelector('.audit-sig-save'); if (sv) sv.addEventListener('click', function(){
      if (!pad.hasDrawn()) { setStatus(wrap, 'Draw a signature first', 'text-red-500'); return; }
      var slot = wrap.getAttribute('data-slot'), data = pad.getData();
      setStatus(wrap, 'Saving…', 'text-gray-500');
      // New-mode form: no audit row yet — silent draft first (late-binds
      // data-audit-id, no reload), then save the signature against it.
      var ready = wrap.getAttribute('data-audit-id')
        ? Promise.resolve()
        : (window.auditEnsureDraft ? window.auditEnsureDraft() : Promise.resolve());
      ready.then(function(){
      var id = wrap.getAttribute('data-audit-id');
      if (!id) { setStatus(wrap, 'Could not start the draft — try Save as Draft', 'text-red-500'); return; }
      fetch('/audits/' + id + '/signature/' + slot + '?json=1', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded','X-CSRF-Token':window.AUDIT_CSRF,'Accept':'application/json'}, credentials:'same-origin', body:new URLSearchParams({ _csrf: window.AUDIT_CSRF, signature_data: data }).toString() })
        .then(function(r){ return r.json(); })
        .then(function(d){ if (d && d.ok) { setStatus(wrap, '✓ Saved', 'text-emerald-600'); var box = wrap.querySelector('.audit-sig-saved'), im = wrap.querySelector('.audit-sig-img'); if (im) im.src = '/data/uploads/audits/' + id + '/signatures/' + d.path + '?v=' + (new Date()).getTime(); if (box) box.classList.remove('hidden'); pad.clear(); } else setStatus(wrap, (d && d.error) || 'Save failed', 'text-red-500'); })
        .catch(function(){ setStatus(wrap, 'Save failed', 'text-red-500'); });
      });
    });
  });
})();
</script>
