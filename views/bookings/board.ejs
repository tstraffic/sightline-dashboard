      }
      // Shared eye / eye-off pill states for the crew-visibility toggle.
      var EYE_ON  = '<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>';
      var EYE_OFF = '<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>';
      function visPill(on) {
        return {
          cls: 'bk2-vis-toggle ' + (on ? 'is-on' : 'is-off'),
          html: (on ? EYE_ON : EYE_OFF) + '<span>' + (on ? 'Crew visible' : 'Hidden') + '</span>',
          title: on ? 'Crew can see this in the worker app — click to hide' : 'Hidden from crew — click to show',
        };
      }
      matching.forEach(function (d) {
        var visible = (d.visible_to_crew == null) ? 1 : (d.visible_to_crew ? 1 : 0);
        var p = visPill(visible === 1);
        var row = document.createElement('div');
        row.className = 'bk2-docrow';
        row.innerHTML =
          '<div class="bk2-docrow-main">'
          + '<span class="bk2-docrow-name">' + (d.title || d.original_name || 'Document') + '</span>'
          + '<span class="bk2-docrow-meta">' + (d.document_type || '') + ' · ' + fmtSize(d.file_size) + '</span>'
          + '</div>'
          + '<button type="button" class="' + p.cls + '" data-doc-vis="' + d.id + '" data-vis-now="' + visible + '" title="' + p.title + '">' + p.html + '</button>'
          + '<a class="bk2-docrow-dl" href="/bookings/' + id + '/documents/' + d.id + '/download">Download</a>';
        list.appendChild(row);
      });
      // Crew-visibility toggles — flip on the server, then update in place.
      list.querySelectorAll('[data-doc-vis]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var docId = btn.getAttribute('data-doc-vis');
          var next = btn.getAttribute('data-vis-now') === '1' ? '0' : '1';
          var body = new URLSearchParams({ visible: next, _csrf: csrf() });
          fetch('/bookings/' + id + '/documents/' + docId + '/visibility', {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body, credentials: 'same-origin',
          }).then(function (r) { return r.json(); })
            .then(function (j) {
              if (!j || j.ok === false) throw new Error((j && j.error) || 'failed');
              if (docsCache && docsCache.docs) {
                var row = docsCache.docs.find(function (x) { return String(x.id) === String(docId); });
                if (row) row.visible_to_crew = parseInt(next, 10);
              }
              var p2 = visPill(next === '1');
              btn.setAttribute('data-vis-now', next);
              btn.className = p2.cls;
              btn.innerHTML = p2.html;
              btn.title = p2.title;
              if (typeof window.bk2Toast === 'function') window.bk2Toast(next === '1' ? 'Visible to crew.' : 'Hidden from crew.', 'success');
            })
            .catch(function () { if (typeof window.bk2Toast === 'function') window.bk2Toast('Could not change visibility.', 'error'); });
        });
      });
    }

    function loadDocs(force) {
      var id = editorBookingId();
      if (!id) return;
      var panes = document.querySelectorAll('[data-bk-docpane]');
      if (docsCache && docsCache.id === id && !force) {
        panes.forEach(function (p) { renderPane(p, docsCache.docs, docsCache.requiredPlans); });
        return;
      }
      fetch('/bookings/' + id + '/documents.json', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
        .then(function (data) {
          docsCache = { id: id, docs: data.documents || [], requiredPlans: data.requiredPlans || [] };
          panes.forEach(function (p) { renderPane(p, docsCache.docs, docsCache.requiredPlans); });
        })
        .catch(function () {
          panes.forEach(function (p) { var l = p.querySelector('[data-bk-docpane-list]'); if (l) l.innerHTML = '<p class="bk2-create-hint">Couldn’t load documents.</p>'; });
        });
    }

    // Inline upload — posts multipart to the existing /:id/documents route
    // with the tab's document_type, then refreshes both doc panes.
    document.querySelectorAll('[data-bk-docpane-upload]').forEach(function (frm) {
      frm.addEventListener('submit', function (e) {
        e.preventDefault();
        var id = editorBookingId(); if (!id) return;
        var fileEl = frm.querySelector('[data-bk-docpane-file]');
        var msg = frm.querySelector('[data-bk-docpane-msg]');
        if (!fileEl || !fileEl.files.length) return;
        var fd = new FormData();
        fd.append('file', fileEl.files[0]);
        fd.append('document_type', frm.querySelector('[data-bk-docpane-type]').value);
        fd.append('_csrf', csrf());
        if (msg) { msg.hidden = false; msg.textContent = 'Uploading…'; }
        fetch('/bookings/' + id + '/documents', { method: 'POST', body: fd, credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
          .then(function () { if (msg) { msg.textContent = 'Uploaded.'; setTimeout(function () { msg.hidden = true; }, 1500); } fileEl.value = ''; loadDocs(true); })
          .catch(function () { if (msg) msg.textContent = 'Upload failed.'; });
      });
    });

    // Expose so the tab switcher can trigger a load when a doc tab opens.
    window.bk2LoadDocPanes = loadDocs;
    window.bk2ResetDocPanes = function () { docsCache = null; };
  })();

  // ============================================================
  //  MAP (Leaflet)
  // ============================================================
  var mapInited = false;
  function initMap() {
    if (mapInited) return;
    if (typeof L === 'undefined') { setTimeout(initMap, 300); return; }
    var el = $('#bk2-map'); if (!el) return;
    var pins = (window.BK2_DATA.bookings || []).filter(function (b) { return b.lat && b.lng; });
    var center = pins.length ? [pins[0].lat, pins[0].lng] : [-33.8688, 151.2093];
    var map = L.map('bk2-map').setView(center, pins.length ? 11 : 10);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap', maxZoom: 19 }).addTo(map);
    pins.forEach(function (p) {
      var m = L.marker([p.lat, p.lng]).addTo(map);
      m.bindPopup('<strong>#' + p.num + '</strong><br>' + (p.title || p.addr || '') + '<br><a href="/bookings/' + p.id + '" style="color:#2B7FFF">Open booking →</a>');
    });
    if (pins.length > 1) map.fitBounds(pins.map(function (p) { return [p.lat, p.lng]; }), { padding: [40, 40] });
    mapInited = true;
  }

  // ============================================================
  //  CALENDAR (week timeline)
  // ============================================================
  var calLoaded = false;
  function loadCalendar() {
    if (calLoaded) return;
    var date = window.BK2_DATA.dateStr;
    fetch('/bookings/api/week?date=' + encodeURIComponent(date), { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(renderCalendar)
      .catch(function () { $('#bk2-cal-grid').innerHTML = '<p style="color:#DC2626;text-align:center;padding:24px 0">Failed to load week.</p>'; });
    calLoaded = true;
  }
  function renderCalendar(week) {
    var grid = $('#bk2-cal-grid');
    var range = $('#bk2-cal-range');
    var monday = new Date(week.monday + 'T00:00:00');
    var sunday = new Date(week.sunday + 'T00:00:00');
    range.textContent = monday.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' }) + ' – ' + sunday.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });

    var hours = []; for (var h = 6; h <= 20; h++) hours.push(h);
    var dayLabels = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
    var html = '<div class="bk2-cal"><div class="bk2-cal-head"></div>';
    for (var i = 0; i < 7; i++) {
      var dd = new Date(monday); dd.setDate(monday.getDate() + i);
      html += '<div class="bk2-cal-head">' + dayLabels[i] + '<br><span style="font-weight:500;color:#374151">' + dd.getDate() + '/' + (dd.getMonth() + 1) + '</span></div>';
    }
    for (var hi = 0; hi < hours.length; hi++) {
      var hr = hours[hi];
      html += '<div class="bk2-cal-hour">' + (hr <= 12 ? hr : hr - 12) + (hr < 12 ? 'a' : 'p') + '</div>';
      for (var di = 0; di < 7; di++) {
        html += '<div class="bk2-cal-cell" data-day="' + di + '" data-hour="' + hr + '"></div>';
      }
    }
    html += '</div>';
    grid.innerHTML = html;

    var pxPerMin = 32 / 60;
    var startMin = 6 * 60;
    (week.items || []).forEach(function (it) {
      var firstCell = grid.querySelector('.bk2-cal-cell[data-day="' + it.day_index + '"][data-hour="6"]');
      if (!firstCell) return;
      var topPx = Math.max(0, (it.start_min - startMin)) * pxPerMin;
      var heightPx = Math.max(20, (it.end_min - it.start_min) * pxPerMin - 2);
      var block = document.createElement('a');
      block.href = '/bookings/' + it.id;
      block.className = 'bk2-cal-block bk2-status-tone-' + it.status;
      block.style.cssText = 'top:' + topPx + 'px;height:' + heightPx + 'px;border-left-color:var(--bk2-tone);text-decoration:none;color:inherit';
      block.innerHTML = '<strong>' + (it.title || ('#' + it.booking_number)) + '</strong><span style="opacity:0.85">' + new Date(it.start_datetime).toLocaleTimeString('en-AU', { hour: 'numeric', minute: '2-digit', hour12: true }).toLowerCase() + '</span>';
      firstCell.appendChild(block);
    });
  }
  $('#bk2-cal-prev') && $('#bk2-cal-prev').addEventListener('click', function () { shiftWeek(-7); });
  $('#bk2-cal-next') && $('#bk2-cal-next').addEventListener('click', function () { shiftWeek(7); });
  function shiftWeek(d) {
    var dt = new Date(window.BK2_DATA.dateStr + 'T00:00:00'); dt.setDate(dt.getDate() + d);
    var u = new URL(location.href); u.searchParams.set('date', dt.toISOString().substring(0,10)); u.searchParams.set('view', 'calendar');
    location.href = u.toString();
  }

  if (v0 === 'map')      initMap();
  if (v0 === 'calendar') loadCalendar();

  // ============================================================
  // ============================================================
  //  Filter strip — search popovers, cycle buttons, sort, toggles.
  //
  //  State is held client-side in window.bk2Filters and applied by
  //  hiding/showing cards (the server query already narrowed to the
  //  selected date + URL params, so this just narrows the visible
  //  set further without a reload). Persisted in localStorage so
  //  toggles survive a refresh.
  // ============================================================
  var FS_KEY = 'bk2.filters.v1';
  window.bk2Filters = {
    multi:  { depots: [], states: [], client: [], project: [], location: [], booking_status: [] },
    cycle:  { billable: 0, invoiced: 0, payment: 0, callouts: 0, supplier_scope: 0, client_changes: 0, hire: 0, deleted: 0 },
    sort:   'time',
  };
  try {
    var saved = JSON.parse(localStorage.getItem(FS_KEY) || 'null');
    if (saved && typeof saved === 'object') {
      if (saved.multi) Object.assign(window.bk2Filters.multi, saved.multi);
      if (saved.cycle) Object.assign(window.bk2Filters.cycle, saved.cycle);
      if (saved.sort)  window.bk2Filters.sort = saved.sort;
    }
  } catch (e) {}
  function fsPersist() {
    try { localStorage.setItem(FS_KEY, JSON.stringify(window.bk2Filters)); } catch (e) {}
  }

  // Pull unique values from the rendered booking cards for the
  // "source: bookings" search chips (Client, Project, Location).
  function fsValuesFromBookings(key) {
    var attr = 'data-' + key;
    var out = {};
    $$('.bk2-card[' + attr + ']').forEach(function (card) {
      var v = card.getAttribute(attr); if (v) out[v] = true;
    });
    return Object.keys(out).sort();
  }

  function fsSetChipDisplay(chip, list) {
    var el = chip.querySelector('[data-fs-display]'); if (!el) return;
    chip.classList.toggle('is-active', list.length > 0);
    if (!list.length) { el.textContent = ''; return; }
    var first = list[0];
    var rest = list.length - 1;
    el.innerHTML = '<span class="bk2-fs-pill">× ' + first.replace(/[<>&]/g, '') + '</span>' +
      (rest > 0 ? ' <span class="bk2-fs-pill-more">+' + rest + '</span>' : '');
  }

  // ── Search popover ────────────────────────────────────────────
  var pop = $('#bk2-fs-popover');
  var popInput = pop && pop.querySelector('.bk2-fs-popover-search');
  var popList  = pop && pop.querySelector('.bk2-fs-popover-list');
  var popClear = pop && pop.querySelector('.bk2-fs-popover-clear');
  var popClose = pop && pop.querySelector('.bk2-fs-popover-close');
  var popActiveChip = null;
  var popOptions = [];
  var popKey = '';
  var popQuery = '';

  function fsPopRender() {
    if (!popList) return;
    var sel = (window.bk2Filters.multi[popKey] || []);
    var q = popQuery.toLowerCase();
    var items = popOptions.filter(function (o) { return !q || o.toLowerCase().indexOf(q) !== -1; });
    if (!items.length) { popList.innerHTML = '<li class="bk2-fs-popover-empty">No matches</li>'; return; }
    popList.innerHTML = items.map(function (o) {
      var on = sel.indexOf(o) !== -1;
      return '<li><label class="bk2-fs-popover-opt' + (on ? ' is-on' : '') + '">' +
        '<input type="checkbox" ' + (on ? 'checked' : '') + ' data-fs-opt="' + (o.replace(/"/g, '&quot;')) + '">' +
        '<span>' + (o.replace(/[<>&]/g, '')) + '</span>' +
      '</label></li>';
    }).join('');
  }

  function fsPopOpen(chip) {
    if (!pop) return;
    popActiveChip = chip;
    popKey = chip.getAttribute('data-fs-search');
    if (chip.getAttribute('data-fs-placeholder')) {
      popOptions = [];
    } else if (chip.getAttribute('data-fs-options')) {
      try { popOptions = JSON.parse(chip.getAttribute('data-fs-options')); } catch (e) { popOptions = []; }
    } else if (chip.getAttribute('data-fs-source') === 'bookings') {
      popOptions = fsValuesFromBookings(chip.getAttribute('data-fs-source-key'));
    } else {
      popOptions = [];
    }
    // Position the popover below the chip
    var r = chip.getBoundingClientRect();
    pop.style.top  = (window.scrollY + r.bottom + 6) + 'px';
    pop.style.left = (window.scrollX + r.left) + 'px';
    pop.hidden = false;
    popQuery = '';
    if (popInput) {
      popInput.value = '';
      popInput.placeholder = chip.getAttribute('data-fs-placeholder')
        ? 'Coming soon — no data yet'
        : ('Search ' + (popKey || 'options') + '…');
      popInput.disabled = !!chip.getAttribute('data-fs-placeholder');
      setTimeout(function () { popInput.focus(); }, 30);
    }
    fsPopRender();
  }

  function fsPopHide() {
    if (!pop) return;
    pop.hidden = true; popActiveChip = null;
  }

  if (popInput) popInput.addEventListener('input', function () { popQuery = this.value.trim(); fsPopRender(); });
  if (popList) popList.addEventListener('change', function (e) {
    var cb = e.target.closest('input[data-fs-opt]'); if (!cb) return;
    var val = cb.getAttribute('data-fs-opt');
    var arr = window.bk2Filters.multi[popKey] || (window.bk2Filters.multi[popKey] = []);
    var idx = arr.indexOf(val);
    if (cb.checked && idx === -1) arr.push(val);
    if (!cb.checked && idx !== -1) arr.splice(idx, 1);
    if (popActiveChip) fsSetChipDisplay(popActiveChip, arr);
    fsApply(); fsPersist();
    fsPopRender();
  });
  if (popClear) popClear.addEventListener('click', function () {
    window.bk2Filters.multi[popKey] = [];
    if (popActiveChip) fsSetChipDisplay(popActiveChip, []);
    fsApply(); fsPersist(); fsPopRender();
  });
  if (popClose) popClose.addEventListener('click', fsPopHide);
  document.addEventListener('click', function (e) {
    if (!pop || pop.hidden) return;
    if (pop.contains(e.target)) return;
    if (e.target.closest('[data-fs-search]')) return;
    fsPopHide();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && pop && !pop.hidden) fsPopHide();
  });

  // ── Cycle buttons ────────────────────────────────────────────
  function fsApplyCycleLabel(btn) {
    var key = btn.getAttribute('data-fs-cycle');
    var labels = (btn.getAttribute('data-fs-cycle-labels') || '').split('|');
    var n = window.bk2Filters.cycle[key] || 0;
    if (n >= labels.length) n = 0;
    // Special-case the Deleted-items chip which has a label/value pair.
    var valEl = btn.querySelector('.bk2-fs-value');
    if (valEl) valEl.textContent = labels[n];
    else btn.textContent = labels[n];
    btn.classList.toggle('is-active', n !== 0);
    btn.setAttribute('data-fs-cycle-state', String(n));
  }

  // ── Filter predicates ────────────────────────────────────────
  // Each booking card is hidden when ANY predicate fails. The cycle
  // states are 0 = default (no filter), 1 = first option, 2 = second.
  function fsCardOk(card) {
    var f = window.bk2Filters;
    // Multi-select: each non-empty set narrows the cards to its members.
    function multiOk(key, attr) {
      var arr = f.multi[key]; if (!arr || !arr.length) return true;
      var v = (card.getAttribute(attr) || '').toLowerCase();
      return arr.some(function (s) { return s.toLowerCase() === v || v.indexOf(s.toLowerCase()) !== -1; });
    }
    if (!multiOk('depots',          'data-depot'))    return false;
    if (!multiOk('states',          'data-state'))    return false;
    if (!multiOk('client',          'data-client'))   return false;
    if (!multiOk('project',         'data-job'))      return false;
    if (!multiOk('location',        'data-location')) return false;
    if (!multiOk('booking_status',  'data-status'))   return false;

    // Cycle: callouts — 1 = only callouts, 2 = no callouts.
    var co = f.cycle.callouts || 0;
    if (co === 1 && card.getAttribute('data-callout') !== '1') return false;
    if (co === 2 && card.getAttribute('data-callout') === '1') return false;
    return true;
  }

  function fsApply() {
    var visible = 0;
    var cards = $$('.bk2-card');
    cards.forEach(function (card) {
      var ok = fsCardOk(card);
      card.style.display = ok ? '' : 'none';
      if (ok) visible++;
    });
    var counter = $('#bk2-daycount'); if (counter) counter.textContent = String(visible);
  }

  // ── Sort ─────────────────────────────────────────────────────
  function fsSortKey(card, by) {
    if (by === 'depot')  return (card.getAttribute('data-depot')  || '').toLowerCase();
    if (by === 'client') return (card.getAttribute('data-client') || '').toLowerCase();
    return card.getAttribute('data-start') || '';
  }
  function fsApplySort() {
    var by = window.bk2Filters.sort || 'time';
    var container = document.querySelector('.bk2-board'); if (!container) return;
    var cards = Array.from(container.querySelectorAll('.bk2-card'));
    cards.sort(function (a, b) {
      // Day shifts group before night shifts when sorting by time, so the
      // two halves of the day read separately on the board.
      if (by === 'time') {
        var na = a.classList.contains('bk2-card--night') ? 1 : 0;
        var nb = b.classList.contains('bk2-card--night') ? 1 : 0;
        if (na !== nb) return na - nb;
      }
      var ka = fsSortKey(a, by), kb = fsSortKey(b, by);
      return ka < kb ? -1 : ka > kb ? 1 : 0;
    });
    cards.forEach(function (c) { container.appendChild(c); });
    // Divider between the day and night groups (time sort only).
    var oldDiv = container.querySelector('.bk2-shift-divider'); if (oldDiv) oldDiv.remove();
    if (by === 'time') {
      var firstNight = cards.find(function (c) { return c.classList.contains('bk2-card--night') && c.style.display !== 'none'; });
      var hasDay = cards.some(function (c) { return c.classList.contains('bk2-card--day') && c.style.display !== 'none'; });
      if (firstNight && hasDay) {
        var div = document.createElement('div');
        div.className = 'bk2-shift-divider';
        div.innerHTML = '<span>☾ Night shifts</span>';
        container.insertBefore(div, firstNight);
      }
    }
    $$('[data-fs-sort]').forEach(function (b) {
      b.classList.toggle('is-active', b.getAttribute('data-fs-sort') === by);
    });
  }

  // ── Wire up ──────────────────────────────────────────────────
  $$('[data-fs-search]').forEach(function (chip) {
    var key = chip.getAttribute('data-fs-search');
    fsSetChipDisplay(chip, window.bk2Filters.multi[key] || []);
    chip.addEventListener('click', function (e) {
      e.stopPropagation();
      if (popActiveChip === chip) { fsPopHide(); return; }
      fsPopOpen(chip);
    });
  });
  $$('[data-fs-cycle]').forEach(function (btn) {
    fsApplyCycleLabel(btn);
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-fs-cycle');
      var labels = (btn.getAttribute('data-fs-cycle-labels') || '').split('|');
      var n = (window.bk2Filters.cycle[key] || 0) + 1;
      if (n >= labels.length) n = 0;
      window.bk2Filters.cycle[key] = n;
      fsApplyCycleLabel(btn);
      fsApply(); fsPersist();
    });
  });
  $$('[data-fs-sort]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      window.bk2Filters.sort = btn.getAttribute('data-fs-sort');
      fsApplySort(); fsPersist();
    });
  });

  // Sidebar hide button — toggles the main app sidebar from the
  // bookings header so the planner can claim the full width on demand.
  // Scoped to this page only via the .bk2-page wrapper in CSS.
  var SIDEBAR_KEY = 'bk2.sidebar.hidden';
  var hideSidebarBtn = $('#bk2-hide-sidebar');
  function applySidebarHidden(on) {
    document.body.classList.toggle('bk2-sidebar-hidden', !!on);
    if (hideSidebarBtn) hideSidebarBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
    try { localStorage.setItem(SIDEBAR_KEY, on ? '1' : '0'); } catch (e) {}
  }
  if (hideSidebarBtn) {
    hideSidebarBtn.addEventListener('click', function () {
      applySidebarHidden(!document.body.classList.contains('bk2-sidebar-hidden'));
    });
    var savedSb = '0'; try { savedSb = localStorage.getItem(SIDEBAR_KEY) || '0'; } catch (e) {}
    if (savedSb === '1') applySidebarHidden(true);
  }

  var togMenus = $('#bk2-fs-togmenus');
  if (togMenus) togMenus.addEventListener('click', function () {
    var strip = $('#bk2-filterstrip'); if (!strip) return;
    strip.classList.toggle('is-menus-collapsed');
  });
  var togPanel = $('#bk2-fs-togpanel');
  if (togPanel) togPanel.addEventListener('click', function () {
    var pane = document.querySelector('.bk2-pane--with-panel');
    if (!pane) return;
    var on = !pane.classList.contains('is-collapsed');
    if (typeof rpSetCollapsed === 'function') rpSetCollapsed(on);
    else { pane.classList.toggle('is-collapsed'); }
  });

  // Density toggle — comfortable (full crew slots) ↔ compact (fits ~20-30).
  // Persisted per-browser; defaults to compact so busy days fit at a glance.
  (function () {
    function isCompact() {
      var saved; try { saved = localStorage.getItem('bk2-density'); } catch (e) {}
      return saved ? saved === 'compact' : true; // default compact
    }
    // Re-queries .bk2-board every call — the board element is replaced on AJAX
    // date-nav / back navigation, so a captured reference would go stale and
    // the swapped-in board would render in the wrong (comfortable) density.
    function apply(compact) {
      var board = document.querySelector('.bk2-board');
      if (board) board.classList.toggle('bk2-density-compact', compact);
      var btn = $('#bk2-fs-density');
      if (btn) {
        btn.classList.toggle('is-active', compact);
        var lbl = btn.querySelector('[data-density-label]');
        if (lbl) lbl.textContent = compact ? 'Comfortable view' : 'Compact view';
      }
    }
    window.bk2ApplyDensity = function () { apply(isCompact()); };
    window.bk2ApplyDensity();
    var btn = $('#bk2-fs-density');
    if (btn) btn.addEventListener('click', function () {
      var board = document.querySelector('.bk2-board');
      var compact = !(board && board.classList.contains('bk2-density-compact'));
      try { localStorage.setItem('bk2-density', compact ? 'compact' : 'comfortable'); } catch (e) {}
      apply(compact);
    });
    // bfcache restore (browser Back) doesn't re-run this IIFE — re-apply.
    window.addEventListener('pageshow', function (e) { if (e.persisted) window.bk2ApplyDensity(); });
  })();

  // Initial paint
  fsApplySort();
  fsApply();

  // ============================================================
  //  Resource panel — People / Vehicles / Towed Equipment.
  //
  //  - One /api/resources fetch hydrates all three tabs.
  //  - Per-tab filter chips toggle independent boolean flags.
  //  - Search filters within the active tab.
  //  - Each row carries data-resource-* attrs for future drag-drop.
  //  - The whole panel can be collapsed with the chevron; state is
  //    persisted in localStorage so it stays the way the user left it.
  // ============================================================
  var rpDate = '<%= dateStr %>';
  var rpData = null;
  var rpQuery = '';
  var rpActive = 'people';
  // Per-tab boolean filter map. Keys mirror data-rp-filter values.
  var rpFilters = { people: {}, vehicles: {}, equipment: {} };

  function rpEsc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', '\'':'&#39;' }[c];
    });
  }
  function rpInitials(name) {
    if (!name) return '?';
    return name.split(/\s+/).map(function (n) { return n[0]; }).join('').substring(0, 2).toUpperCase();
  }
  function rpIsTl(role) {
    var r = (role || '').toLowerCase();
    return /(team[_ ]?lead|leading[_ ]?hand|super|supervisor)/.test(r);
  }
  function rpCatHas(cat, needles) {
    var c = (cat || '').toLowerCase();
    return needles.some(function (n) { return c.indexOf(n) !== -1; });
  }

  // ── Filter predicates per tab ─────────────────────────────────
  function rpPersonOk(p) {
    var f = rpFilters.people;
    // Default view = active crew only. Reserved + on-leave crew are hidden
    // until the allocator opts in via the "Show Reserves" / "Show On-Leave"
    // toggles. These are ADDITIVE: turning Show Reserves on layers reserves
    // in alongside the active list (active + reserves), it doesn't replace
    // it. (Previously the chip was exclusive — it hid every active person
    // and showed only reserves, which is why pressing it looked broken.)
    if (!f.reserved && p.employment_status === 'reserved') return false;
    if (!f.on_leave && p.employment_status === 'on_leave') return false;
    if (f.tls           && !rpIsTl(p.role)) return false;
    if (f.assigned      && !p.assigned_today) return false;
    if (f.conflicts     && !(p.warnings && p.warnings.length)) return false;
    if (f.blocked       && !p.blocked_from_allocation) return false;
    if (f.can_drive     && !p.licence_type) return false;
    if (f.first_aid     && !p.first_aid) return false;
    if (f.subcontractor && (p.employment_type || '').toLowerCase() !== 'subcontractor') return false;
    if (f.available     && rpPersonReason(p)) return false;                 // only those free to allocate
    if (f.unapproved    && p.supervisor_approved) return false;             // not yet supervisor-approved
    return true;
  }
  function rpVehicleOk(v) {
    var f = rpFilters.vehicles;
    // Filters key off the server-side classification (vehicle_class).
    var c = v.vehicle_class || 'ute';
    if (f.utes   && c !== 'ute') return false;
    if (f.pods   && c !== 'pod') return false;
    if (f.vms    && c !== 'vms') return false;
    if (f.trucks && c !== 'truck' && c !== 'tma') return false;
    if (f.fleet  && v.source !== 'fleet') return false;
    return true;
  }
  function rpEquipmentOk(e) {
    var f = rpFilters.equipment;
    var cat = (e.category || '').toLowerCase();
    var name = (e.name || '').toLowerCase();
    if (f.arrow   && !(rpCatHas(cat, ['arrow']) || name.indexOf('arrow') !== -1)) return false;
    if (f.trailer && !(rpCatHas(cat, ['trailer']) || name.indexOf('trailer') !== -1)) return false;
    if (f.vms_eq  && !(rpCatHas(cat, ['vms']) || name.indexOf('vms') !== -1)) return false;
    if (f.signs   && !(rpCatHas(cat, ['sign','barrier','cone','delineator']))) return false;
    return true;
  }

  function rpSearchHit(it) {
    if (!rpQuery) return true;
    var q = rpQuery.toLowerCase();
    var hay = [
      it.full_name, it.name, it.role, it.licence_type, it.category,
      it.licence_plate, it.rego, it.asset_number, it.phone, it.employee_id,
    ].filter(Boolean).join(' ').toLowerCase();
    return hay.indexOf(q) !== -1;
  }

  // Decide why someone isn't available — feeds the tooltip on the ✗.
  function rpPersonReason(p) {
    if (p.assigned_today)           return 'Already booked today';
    if (p.blocked_from_allocation)  return 'Blocked from allocation';
    if (p.employment_status === 'on_leave') return 'On leave';
    if (p.warnings && p.warnings.length) {
      if (p.warnings.indexOf('licence_expired')   !== -1) return 'Licence expired';
      if (p.warnings.indexOf('tc_expired')        !== -1) return 'TC ticket expired';
      if (p.warnings.indexOf('whitecard_expired') !== -1) return 'White card expired';
      return 'Has warnings';
    }
    return '';
  }
  function rpPersonOkFlag(p) { return !rpPersonReason(p); }
  function rpVehicleOkFlag(v) {
    var s = (v.status || '').toLowerCase();
    // Active = ready; everything else (Spare, Maintenance, Out of Service) = not currently available.
    return s === '' || s === 'active';
  }
  function rpEquipmentOkFlag(e) {
    var c = (e.current_condition || '').toLowerCase();
    return c === '' || c === 'good' || c === 'serviceable' || c === 'available';
  }

  // Reusable row: hours slot · type icon · name · indicators · ✓/✗.
  // Two of these sit side-by-side in the 2-column grid.
  function rpRow(opts) {
    var hoursHtml = '<span class="bk2-rp-hrs" title="Hours this week — not yet tracked">' + (opts.hours == null ? '?' : opts.hours) + '</span>';
    var iconHtml  = '<svg class="bk2-rp-icon" width="14" height="14" fill="currentColor" viewBox="0 0 24 24">' + opts.icon + '</svg>';
    // Name column carries an optional detail subtitle (role · ticket · licence),
    // revealed by the "Details" toggle (CSS: body.bk2-rp-detail).
    var subHtml   = opts.sub ? '<span class="bk2-rp-sub">' + rpEsc(opts.sub) + '</span>' : '';
    var nameHtml  = '<span class="bk2-rp-namewrap"><span class="bk2-rp-name">' + rpEsc(opts.name) + '</span>' + subHtml + '</span>';
    var badgeHtml = (opts.badges || []).join('');
    var warnHtml  = (opts.warnChips && opts.warnChips.length) ? '<span class="bk2-rp-warns">' + opts.warnChips.join('') + '</span>' : '';
    var markHtml  = opts.ok
      ? '<span class="bk2-rp-mark bk2-rp-mark--yes" title="' + rpEsc(opts.okTitle || 'Available') + '">✓</span>'
      : '<span class="bk2-rp-mark bk2-rp-mark--no"  title="' + rpEsc(opts.notOkTitle || 'Not available') + '">✗</span>';
    var extraAttrs = '';
    if (opts.source)   extraAttrs += ' data-resource-source="'   + rpEsc(opts.source)   + '"';
    if (opts.rego)     extraAttrs += ' data-resource-rego="'     + rpEsc(opts.rego)     + '"';
    if (opts.role)     extraAttrs += ' data-resource-role="'     + rpEsc(opts.role)     + '"';
    if (opts.category) extraAttrs += ' data-resource-category="' + rpEsc(opts.category) + '"';
    if (opts.hireUnit) extraAttrs += ' data-resource-hire-unit="' + rpEsc(opts.hireUnit) + '"'
                                   + ' data-resource-supplier="'  + rpEsc(opts.supplier || '') + '"';
    return (
      '<li class="bk2-rp-item ' + (opts.ok ? '' : 'is-unavailable') + '"' +
          ' draggable="true"' +
          ' data-resource-type="' + opts.type + '"' +
          ' data-resource-id="'   + opts.id   + '"' +
          ' data-resource-name="' + rpEsc(opts.name) + '"' +
          extraAttrs +
          ' title="' + rpEsc(opts.tooltip || opts.name) + '">' +
        hoursHtml + iconHtml + nameHtml + badgeHtml + warnHtml + markHtml +
      '</li>'
    );
  }
  // Short red credential chips shown in Details mode — surfaced from the
  // server-computed warnings so expiries are visible at a glance.
  var RP_WARN_CHIP = {
    licence_expired:   ['LIC',   'Driver licence expired'],
    tc_expired:        ['TICKET','TC ticket expired'],
    whitecard_expired: ['CARD',  'White card expired'],
    firstaid_expired:  ['FA',    'First-aid expired'],
    medical_expired:   ['MED',   'Medical expired'],
  };
  function rpWarnChips(warnings) {
    return (warnings || []).map(function (w) {
      var m = RP_WARN_CHIP[w]; if (!m) return '';
      return '<span class="bk2-rp-wchip" title="' + m[1] + '">' + m[0] + '</span>';
    }).filter(Boolean);
  }

  // SVG path data — defined once and reused. `<svg>` wrapper added in rpRow.
  var ICON_PERSON    = '<path d="M12 12c2.7 0 4.9-2.2 4.9-4.9S14.7 2.2 12 2.2 7.1 4.4 7.1 7.1 9.3 12 12 12zm0 2.4c-3.3 0-9.8 1.6-9.8 4.9v2.4h19.6v-2.4c0-3.3-6.5-4.9-9.8-4.9z"/>';
  var ICON_TRUCK     = '<path d="M3 6h11v9H3V6zm12 3h4l3 3v3h-7V9zM7 19a2 2 0 100-4 2 2 0 000 4zm11 0a2 2 0 100-4 2 2 0 000 4z"/>';
  var ICON_TRIANGLE  = '<path d="M12 3l10 18H2L12 3z"/>';
  var ICON_LICENCE   = '<path d="M3 5h18v14H3V5zm2 2v10h7V7H5zm9 1h5v2h-5V8zm0 3h5v2h-5v-2zm0 3h5v2h-5v-2z"/>';
  var ICON_MEGAPHONE = '<path d="M3 11v2a2 2 0 002 2h1l5 3V6L6 9H5a2 2 0 00-2 2zm15-4v10c1.7 0 3-2.2 3-5s-1.3-5-3-5z"/>';

  function rpRenderPeople(list) {
    if (!list.length) return '<li class="bk2-rp-empty">No matching workers.</li>';
    return list.map(function (p) {
      var sub = [p.role, p.licence_type, p.tcp_level ? ('TCP ' + p.tcp_level) : null].filter(Boolean).join(' · ');
      var badges = [];
      // Megaphone marker for TLs / supervisors — quick read on who can run a crew.
      if (rpIsTl(p.role))     badges.push('<svg class="bk2-rp-badge bk2-rp-badge--tl"     viewBox="0 0 24 24" fill="currentColor" width="12" height="12" title="Team lead / supervisor">' + ICON_MEGAPHONE + '</svg>');
      // Truck marker if they hold a driver's licence — quick read on who can drive.
      if (p.licence_type)     badges.push('<svg class="bk2-rp-badge bk2-rp-badge--drive"  viewBox="0 0 24 24" fill="currentColor" width="12" height="12" title="Has driver licence: ' + rpEsc(p.licence_type) + '">' + ICON_TRUCK + '</svg>');
      // First-aid marker (green cross) — quick read on who's a first-aider.
      if (p.first_aid)        badges.push('<span class="bk2-rp-fa" title="First-aid certified">✚</span>');
      // Subcontractor marker.
      if ((p.employment_type || '').toLowerCase() === 'subcontractor') badges.push('<span class="bk2-rp-sc" title="Subcontractor">SUB</span>');
      var reason = rpPersonReason(p);
      // Detail subtitle: role · TCP · licence · company (whatever's present).
      var detail = [
        (p.role || '').replace(/_/g, ' '),
        p.tcp_level ? ('TCP ' + p.tcp_level) : null,
        p.licence_type ? ('Lic ' + p.licence_type) : null,
        (p.company && (p.employment_type || '').toLowerCase() === 'subcontractor') ? p.company : null,
      ].filter(Boolean).join(' · ');
      return rpRow({
        type: 'person',
        id: p.id,
        name: p.full_name,
        icon: ICON_PERSON,
        badges: badges,
        sub: detail,
        warnChips: rpWarnChips(p.warnings),
        ok: !reason,
        okTitle: 'Available',
        notOkTitle: reason,
        tooltip: p.full_name + (sub ? ' — ' + sub : '') + (reason ? ' (' + reason + ')' : ''),
      });
    }).join('');
  }

  // Vehicle class (from /api/resources) → display tag + drag role. The role
  // rides in the drag payload so drop-to-add bumps the matching requirement
  // (Traffic Ute / Pod Truck / VMS Ute / …) on the server.
  var VEH_CLASS_TAG = {
    ute:   { label: 'TRAFFIC UTE', cls: 'ute' },
    pod:   { label: 'POD TRUCK',   cls: 'pod' },
    vms:   { label: 'VMS UTE',     cls: 'vms' },
    tma:   { label: 'TMA',         cls: 'tma' },
    truck: { label: 'TRUCK',       cls: 'truck' },
  };
  function rpRenderVehicles(list) {
    if (!list.length) return '<li class="bk2-rp-empty">No vehicles match.</li>';
    return list.map(function (v) {
      var rego = v.licence_plate || v.rego || '';
      // Lead with the ASSET NAME (asset_id via v.name for fleet); show the
      // make/model + rego as secondary detail rather than as the label.
      var assetName = v.name || v.asset_number || rego || 'Vehicle';
      var sub = [v.model_label, rego, v.category].filter(Boolean).join(' · ');
      var tag = VEH_CLASS_TAG[v.vehicle_class] || VEH_CLASS_TAG.ute;
      var badges = ['<span class="bk2-rp-vtag bk2-rp-vtag--' + tag.cls + '">' + tag.label + '</span>'];
      if (v.source === 'fleet') badges.push('<svg class="bk2-rp-badge bk2-rp-badge--fleet" viewBox="0 0 24 24" fill="currentColor" width="12" height="12" title="Fleet register">' + ICON_LICENCE + '</svg>');
      var ok = rpVehicleOkFlag(v);
      return rpRow({
        type: 'vehicle',
        id: v.id,
        name: assetName,
        icon: ICON_TRUCK,
        badges: badges,
        ok: ok,
        okTitle: 'Active in fleet',
        notOkTitle: v.status || 'Not active',
        tooltip: assetName + (v.model_label ? ' · ' + v.model_label : '') + (rego ? ' · ' + rego : '') + ' — ' + tag.label,
        source: v.source || 'equipment',
        rego: rego,
        role: v.vehicle_class || 'ute',
      });
    }).join('');
  }

  function rpRenderEquipment(list) {
    if (!list.length) return '<li class="bk2-rp-empty">No equipment matches.</li>';
    return list.map(function (e) {
      var sub = [e.category, e.asset_number].filter(Boolean).join(' · ');
      var ok = e.hired ? true : rpEquipmentOkFlag(e);
      return rpRow({
        type: 'equipment',
        id: e.id,
        name: e.name || 'Equipment',
        icon: ICON_TRIANGLE,
        badges: e.hired ? ['<span class="bk2-hired-pill" title="Hired' + (e.supplier ? ' from ' + rpEsc(e.supplier) : '') + '">HIRED</span>'] : [],
        ok: ok,
        okTitle: e.hired ? 'On hire — available' : 'Available',
        notOkTitle: e.current_condition || 'Check condition',
        tooltip: (e.name || '') + (sub ? ' — ' + sub : '') + (e.hired && e.supplier ? ' — hired from ' + e.supplier : ''),
        category: e.category || '',
        hireUnit: e.hire_unit_id || '',
        supplier: e.supplier || '',
      });
    }).join('');
  }

  function rpRepaint() {
    if (!rpData) return;
    var meta = $('#bk2-rp-meta');
    // Anyone/anything already allocated on the viewed day leaves the pool —
    // a worker or ute can't be picked twice for the same day.
    var ppl = (rpData.people    || []).filter(function (p) { return !p.assigned_today; }).filter(rpSearchHit).filter(rpPersonOk);
    var veh = (rpData.vehicles  || []).filter(function (v) { return !v.assigned_today; }).filter(rpSearchHit).filter(rpVehicleOk);
    var eqp = (rpData.equipment || []).filter(rpSearchHit).filter(rpEquipmentOk);
    var pList = $('#bk2-rp-list-people');     if (pList) pList.innerHTML = rpRenderPeople(ppl);
    var vList = $('#bk2-rp-list-vehicles');   if (vList) vList.innerHTML = rpRenderVehicles(veh);
    var eList = $('#bk2-rp-list-equipment');  if (eList) eList.innerHTML = rpRenderEquipment(eqp);
    if (meta) {
      var label = rpActive === 'vehicles' ? (veh.length + ' of ' + (rpData.vehicles  || []).length + ' vehicles')
                : rpActive === 'equipment' ? (eqp.length + ' of ' + (rpData.equipment || []).length + ' equipment')
                : (ppl.length + ' of ' + (rpData.people || []).length + ' workers');
      meta.textContent = label;
    }
    // Per-section counts for the Resources-tab layout (section headers are
    // display:none in the board panel, so this is harmless there).
    var counts = { people: [ppl, rpData.people], vehicles: [veh, rpData.vehicles], equipment: [eqp, rpData.equipment] };
    Object.keys(counts).forEach(function (k) {
      var el = document.querySelector('[data-rp-count="' + k + '"]');
      if (el) el.textContent = counts[k][0].length + ' of ' + (counts[k][1] || []).length;
    });
  }

  function rpSetTab(name) {
    rpActive = name;
    $$('.bk2-rp-tab').forEach(function (t) {
      t.setAttribute('aria-selected', t.dataset.rpTab === name ? 'true' : 'false');
    });
    $$('[data-rp-list]').forEach(function (w) { w.hidden = w.dataset.rpList !== name; });
    $$('[data-rp-chipset]').forEach(function (w) { w.hidden = w.dataset.rpChipset !== name; });
    rpRepaint();
  }

  function rpToggleChip(btn) {
    var on = btn.getAttribute('aria-pressed') === 'true';
    // "Details" is a display toggle (reveal per-row role/ticket detail), not a
    // list filter — flip a body class and stop; the markup is already there.
    if (btn.dataset.rpDetail) {
      btn.setAttribute('aria-pressed', on ? 'false' : 'true');
      document.body.classList.toggle('bk2-rp-detail', !on);
      try { localStorage.setItem('bk2.rp.detail', !on ? '1' : '0'); } catch (e) {}
      return;
    }
    var key = btn.dataset.rpFilter;
    var tab = btn.closest('[data-rp-chipset]').dataset.rpChipset;
    btn.setAttribute('aria-pressed', on ? 'false' : 'true');
    rpFilters[tab][key] = !on;
    rpRepaint();
  }

  // Resource-panel hydration. Made resilient because the panel was getting
  // stuck on "Loading resources…" forever:
  //   - the original fetch had no timeout, so a request that stalled (e.g.
  //     a back/forward bfcache restore that aborted the in-flight fetch, or
  //     a transient network hiccup) left the spinner up until a hard refresh;
  //   - it only ran once at init, so AJAX date-nav never re-hydrated it.
  // Now: re-entrant, aborts a stuck request after 12s, resets the meta line
  // to "Loading…" on each attempt, and offers a Retry link on failure.
  var rpLoadInFlight = false;
  function rpLoad(force) {
    if (rpLoadInFlight && !force) return;
    rpLoadInFlight = true;
    var meta = $('#bk2-rp-meta');
    if (meta) meta.textContent = 'Loading resources…';

    var controller = (typeof AbortController !== 'undefined') ? new AbortController() : null;
    var timedOut = false;
    var timer = setTimeout(function () { timedOut = true; if (controller) controller.abort(); }, 12000);

    fetch('/bookings/api/resources?date=' + encodeURIComponent(rpDate), {
      credentials: 'same-origin',
      signal: controller ? controller.signal : undefined,
    })
      .then(function (r) { return r.ok ? r.json() : Promise.reject('HTTP ' + r.status); })
      .then(function (data) {
        clearTimeout(timer);
        rpLoadInFlight = false;
        rpData = data;
        rpRepaint();
      })
      .catch(function (err) {
        clearTimeout(timer);
        rpLoadInFlight = false;
        var why = timedOut ? 'timed out' : (err && err.message ? err.message : err);
        if (meta) {
          meta.innerHTML = '';
          var span = document.createElement('span');
          span.textContent = 'Couldn’t load resources (' + why + '). ';
          var retry = document.createElement('button');
          retry.type = 'button';
          retry.textContent = 'Retry';
          retry.style.cssText = 'background:none;border:0;color:#6EE7B7;font-weight:700;cursor:pointer;text-decoration:underline;padding:0;font:inherit;';
          retry.addEventListener('click', function () { rpLoad(true); });
          meta.appendChild(span);
          meta.appendChild(retry);
        }
      });
  }
  // Expose so AJAX date navigation can re-hydrate the panel for the new day.
  window.bk2ReloadResources = function (date) {
    if (date) rpDate = date;
    rpLoad(true);
  };

  // ── Hide / show panel — persisted in localStorage ──
  var RP_STATE_KEY = 'bk2.rp.collapsed';
  function rpSetCollapsed(on) {
    var pane = document.querySelector('.bk2-pane--with-panel');
    if (!pane) return;
    pane.classList.toggle('is-collapsed', !!on);
    // Mirror on <body> so the Big fixed-rail layout can drop the reserved
    // right gutter on <main> when the panel is hidden (CSS can't reach a
    // parent from the pane's class).
    document.body.classList.toggle('bk2-rp-hidden', !!on);
    var showBtn = $('#bk2-rp-show'); if (showBtn) showBtn.hidden = !on;
    try { localStorage.setItem(RP_STATE_KEY, on ? '1' : '0'); } catch (e) {}
  }

  if (document.querySelector('.bk2-resourcepanel')) {
    $$('.bk2-rp-tab').forEach(function (t) {
      t.addEventListener('click', function () { rpSetTab(t.dataset.rpTab); });
    });
    $$('.bk2-rp-chip').forEach(function (c) {
      c.setAttribute('aria-pressed', 'false');
      c.addEventListener('click', function () { rpToggleChip(c); });
    });
    // Restore the "Details" reveal preference (persisted display toggle).
    try {
      if (localStorage.getItem('bk2.rp.detail') === '1') {
        document.body.classList.add('bk2-rp-detail');
        var dBtn = document.querySelector('.bk2-rp-chip[data-rp-detail]');
        if (dBtn) dBtn.setAttribute('aria-pressed', 'true');
      }
    } catch (e) {}
    var rpSearchEl = $('#bk2-rp-search');
    if (rpSearchEl) {
      rpSearchEl.addEventListener('input', function () { rpQuery = this.value.trim(); rpRepaint(); });
    }
    var rpToggleBtn = $('#bk2-rp-toggle'); if (rpToggleBtn) rpToggleBtn.addEventListener('click', function () { rpSetCollapsed(true); });
    var rpShowBtn   = $('#bk2-rp-show');   if (rpShowBtn)   rpShowBtn.addEventListener('click',   function () { rpSetCollapsed(false); });
    // Restore last collapsed state
    var saved = '0'; try { saved = localStorage.getItem(RP_STATE_KEY) || '0'; } catch (e) {}
    if (saved === '1') rpSetCollapsed(true);

    // ── Panel size — Small ⇄ Big, toggled from the header, persisted. Small
    // is the compact right column; Big widens it to ~40vw so it covers the
    // right of the screen and the board reflows left for easy drag-drop.
    // (Hiding it entirely is the separate chevron / re-show control.) The
    // class lives on <body> so it survives AJAX date-nav board swaps. ──
    var RP_SIZES = ['s', 'l'];
    var RP_SIZE_LABEL = { s: 'Small', l: 'Big' };
    function rpApplySize(sz) {
      if (RP_SIZES.indexOf(sz) === -1) sz = 's'; // migrate legacy 'm'/unknown → small
      RP_SIZES.forEach(function (s) { document.body.classList.toggle('bk2-rp-size-' + s, s === sz); });
      var lbl = document.querySelector('[data-rp-size-label]');
      // Label shows what a click will DO next (the other size), like a toggle.
      if (lbl) lbl.textContent = sz === 's' ? 'Big' : 'Small';
      var btn = $('#bk2-rp-size');
      if (btn) btn.title = 'Panel is ' + RP_SIZE_LABEL[sz] + ' — click for ' + (sz === 's' ? 'Big' : 'Small');
      try { localStorage.setItem('bk2.rp.size', sz); } catch (e) {}
    }
    var rpSizeBtn = $('#bk2-rp-size');
    if (rpSizeBtn && !rpSizeBtn.dataset.bkBound) {
      rpSizeBtn.dataset.bkBound = '1';
      rpSizeBtn.addEventListener('click', function () {
        // Read current from the body class (not localStorage) so a stacked
        // listener can never double-advance the cycle.
        var cur = RP_SIZES.find(function (s) { return document.body.classList.contains('bk2-rp-size-' + s); }) || 's';
        rpApplySize(RP_SIZES[(RP_SIZES.indexOf(cur) + 1) % RP_SIZES.length]);
      });
    }
    var savedSize = 's'; try { savedSize = localStorage.getItem('bk2.rp.size') || 's'; } catch (e) {}
    rpApplySize(savedSize);

    rpLoad();

    // bfcache / back-forward safety net: if the page is restored from the
    // back/forward cache (or somehow rendered with the panel never
    // hydrated), kick a reload so it can't sit on "Loading resources…"
    // until a manual refresh.
    window.addEventListener('pageshow', function (e) {
      if (e.persisted || rpData === null) rpLoad(true);
    });
  }

  // ==========================================================
  //  DRAG & DROP — drag a worker row from the resource panel
  //  onto an empty crew slot on a booking card to assign them.
  //  POSTs to /bookings/:id/crew (existing endpoint) and reloads
  //  the board on success.
  // ==========================================================
  var csrfMeta = document.querySelector('meta[name="csrf-token"]');
  var CSRF_TOKEN = csrfMeta ? csrfMeta.getAttribute('content') : '';

  // Remove a spare vehicle straight from the card/floated summary — AJAX so
  // we never leave the board, then refresh the floated card + board.
  document.addEventListener('click', function (e) {
    var rm = e.target.closest && e.target.closest('[data-action="remove-vehicle"]');
    if (!rm) return;
    e.preventDefault(); e.stopPropagation();
    var card = rm.closest('.bk2-card, [data-booking-id]');
    var bid = card && card.getAttribute('data-booking-id');
    var vid = rm.getAttribute('data-vehicle-id');
    if (!bid || !vid) return;
    var body = new URLSearchParams(); body.append('_csrf', CSRF_TOKEN);
    fetch('/bookings/' + bid + '/vehicles/' + vid + '/remove', {
      method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body, credentials: 'same-origin',
    }).then(function () {
      var chip = rm.closest('.bk2-veh-slot'); if (chip) chip.remove();
      boardDirty = true;
      // Server truth changed (requirements shrink + placeholders resync):
      // re-render the card + refresh the requirement steppers.
      try { if (typeof bk2RefreshCard === 'function') bk2RefreshCard(bid); } catch (er) {}
      try { document.dispatchEvent(new CustomEvent('bk2:alloc-changed')); } catch (er) {}
    }).catch(function () { if (typeof bk2Toast === 'function') bk2Toast('Could not remove vehicle.', 'error'); });
  });

  // Detach & remove a piece of gear (trailer / portaboom) from its vehicle.
  document.addEventListener('click', function (e) {
    var rm = e.target.closest && e.target.closest('[data-action="remove-equipment"]');
    if (!rm) return;
    e.preventDefault(); e.stopPropagation();
    var host = rm.closest('[data-booking-id]');
    var bid = host && host.getAttribute('data-booking-id');
    var eqId = rm.getAttribute('data-eq-id');
    if (!bid || !eqId) return;
    var body = new URLSearchParams(); body.append('_csrf', CSRF_TOKEN);
    fetch('/bookings/' + bid + '/equipment/' + eqId + '/remove', {
      method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body, credentials: 'same-origin',
    }).then(function () {
      var chip = rm.closest('.bk2-veh-gear'); if (chip) chip.remove();
      boardDirty = true;
      try { document.dispatchEvent(new CustomEvent('bk2:alloc-changed')); } catch (er) {}
    }).catch(function () { if (typeof bk2Toast === 'function') bk2Toast('Could not remove the gear.', 'error'); });
  });

  // Lightweight toast — used to surface server-side warnings (e.g. crew or
  // vehicle double-booked) that a flash message can't deliver to AJAX flows.
  var bk2ToastActive = {}; // message → { el, count, hide() } for de-duping
  function bk2Toast(msg, kind) {
    // De-dupe: an identical message already on screen just bumps a ×N
    // counter and resets its timer instead of stacking another toast.
    // (Re-fired POSTs / rapid clicks used to throw up ~5 identical toasts.)
    var existing = bk2ToastActive[msg];
    if (existing) {
      existing.count++;
      existing.el.querySelector('[data-bk2-count]').textContent = ' ×' + existing.count;
      existing.reset();
      return;
    }
    var el = document.createElement('div');
    // Compose a tick / cross / warning glyph in front of the text so the
    // toast reads at a glance.
    var glyph = kind === 'success' ? '✓ ' : kind === 'error' ? '✕ ' : '';
    var txt = document.createElement('span'); txt.textContent = glyph + msg;
    var cnt = document.createElement('span'); cnt.setAttribute('data-bk2-count', '1'); cnt.style.opacity = '0.8';
    el.appendChild(txt); el.appendChild(cnt);
    var palette = kind === 'success' ? { bg: '#065F46', fg: '#D1FAE5' }
                : kind === 'error'   ? { bg: '#7F1D1D', fg: '#FEE2E2' }
                                     : { bg: '#92400E', fg: '#FEF3C7' };
    // Stack distinct toasts upward (cap 3 visible), so they don't overlap.
    var depth = Object.keys(bk2ToastActive).length;
    var bottom = 24 + Math.min(depth, 3) * 52;
    el.style.cssText = 'position:fixed;bottom:' + bottom + 'px;left:50%;transform:translateX(-50%) translateY(8px);z-index:10100;' +
      'background:' + palette.bg + ';color:' + palette.fg + ';font-size:13.5px;font-weight:600;padding:11px 18px;border-radius:10px;' +
      'box-shadow:0 8px 28px rgba(0,0,0,0.45);max-width:92vw;opacity:0;transition:opacity .18s ease, transform .18s ease;';
    document.body.appendChild(el);
    requestAnimationFrame(function () { el.style.opacity = '1'; el.style.transform = 'translateX(-50%) translateY(0)'; });
    var ttl = kind === 'success' ? 2500 : 5000;
    var entry = { el: el, count: 1 };
    function dismiss() {
      el.style.opacity = '0'; el.style.transform = 'translateX(-50%) translateY(8px)';
      setTimeout(function () { el.remove(); }, 250);
      delete bk2ToastActive[msg];
    }
    entry.reset = function () { clearTimeout(entry.timer); entry.timer = setTimeout(dismiss, ttl); };
    entry.timer = setTimeout(dismiss, ttl);
    bk2ToastActive[msg] = entry;
  }
  window.bk2Toast = bk2Toast;

  // dragstart on resource-panel rows. Captures the worker id +
  // name into dataTransfer (multiple types so any drop target
  // can read it, and so we have a text/plain fallback).
  document.addEventListener('dragstart', function (e) {
    // Gear chip already ON a card — dragging it re-hitches it (drop on a
    // ute chip) or detaches it (drop on the card body).
    var gearChip = e.target && e.target.closest && e.target.closest('[data-bk-gear-drag]');
    if (gearChip) {
      try {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('application/x-bk2-gear-move', JSON.stringify({
          eqId: gearChip.getAttribute('data-eq-id'),
          bookingId: gearChip.getAttribute('data-booking-id'),
          fromVehicleId: gearChip.getAttribute('data-from-vehicle-id') || '',
          name: gearChip.getAttribute('data-eq-name') || 'Gear',
        }));
        e.dataTransfer.setData('text/plain', gearChip.getAttribute('data-eq-name') || 'Gear');
      } catch (err) {}
      gearChip.classList.add('is-dragging');
      return;
    }
    var row = e.target && e.target.closest && e.target.closest('.bk2-rp-item');
    if (!row) return;
    var type = row.getAttribute('data-resource-type');
    if (type !== 'person' && type !== 'vehicle' && type !== 'equipment') return;
    var id = row.getAttribute('data-resource-id');
    var name = row.getAttribute('data-resource-name') || '';
    if (!id) return;
    try {
      e.dataTransfer.effectAllowed = 'copy';
      if (type === 'person') {
        e.dataTransfer.setData('application/x-bk2-person', id);
      } else if (type === 'equipment') {
        // Gear (trailer / portaboom / arrow board …). Dropping it on a
        // vehicle chip hitches it to that ute; anywhere else on the card
        // adds it to the booking unattached. Hired units carry their hire
        // unit id + supplier so the server records the provenance.
        e.dataTransfer.setData('application/x-bk2-equip', JSON.stringify({
          id: id, name: name, category: row.getAttribute('data-resource-category') || '',
          hire_unit_id: row.getAttribute('data-resource-hire-unit') || '',
          supplier: row.getAttribute('data-resource-supplier') || '',
        }));
      } else {
        // Vehicle payload bundles id + source (fleet|equipment) + rego
        // so the drop handler can POST the right field name and the
        // optimistic-update can render the rego beneath the name.
        var source = row.getAttribute('data-resource-source') || 'fleet';
        var rego = row.getAttribute('data-resource-rego') || '';
        var role = row.getAttribute('data-resource-role') || 'ute';
        e.dataTransfer.setData('application/x-bk2-vehicle', JSON.stringify({
          id: id, source: source, name: name, rego: rego, role: role,
        }));
      }
      e.dataTransfer.setData('text/plain', name);
    } catch (err) { /* old browsers */ }
    row.classList.add('is-dragging');
  });
  document.addEventListener('dragend', function (e) {
    var row = e.target && e.target.closest && e.target.closest('.bk2-rp-item');
    if (row) row.classList.remove('is-dragging');
    var gearChip = e.target && e.target.closest && e.target.closest('[data-bk-gear-drag]');
    if (gearChip) gearChip.classList.remove('is-dragging');
    // Remove any leftover drag-over highlights
    document.querySelectorAll('.bk2-slot--drop.is-drag-over, .bk2-vehunit.is-drag-over, .bk2-card-teambox.is-drag-over, .bk2-restab-dropstrip.is-drag-over, .bk2-card--floating.is-drag-over').forEach(function (el) {
      el.classList.remove('is-drag-over');
    });
  });

  // dragover/dragenter on ANY drop target — must preventDefault to mark
  // the slot as a valid drop target (browser default is to refuse).
  // Type filtering happens in the drop handler (it has access to the
  // actual payload via getData; dragover only sees the list of types).
  document.addEventListener('dragover', function (e) {
    var t = e.dataTransfer && e.dataTransfer.types;
    var has = function (name) { return t && Array.prototype.indexOf.call(t, name) !== -1; };
    var isCrewMove = has('application/x-bk2-crew-move');

    // Crew-move drag: accept ANYWHERE inside a .bk2-crew block that
    // has a vehicle, OR inside the unassigned pool. Highlights either
    // the precise vehicle chip (.bk2-slot--drop-veh-assign) or the
    // crew block (.bk2-crew) so the planner can see exactly what the
    // drop is targeting.
    if (isCrewMove) {
      var unassignZone = e.target.closest && e.target.closest('.bk2-slot--drop-unassign');
      var crewBlock    = e.target.closest && e.target.closest('.bk2-crew');
      var crewBlockHasVehicle = crewBlock && crewBlock.querySelector('.bk2-veh-slot.bk2-slot--drop-veh-assign[data-vehicle-id]');
      // A vehicle-less people group ("Traffic Controller ×N") accepts crew
      // drops too — landing there means "take this worker off their vehicle".
      var noVehBlock = crewBlock && crewBlock.hasAttribute('data-bk-novehicle');
      // A standalone/spare vehicle chip is a valid assign target on its own
      // (not inside a .bk2-crew) — lets any worker go onto any shift vehicle.
      var spareVehChip = e.target.closest && e.target.closest('.bk2-veh-slot--spare.bk2-slot--drop-veh-assign[data-vehicle-id]');
      if (unassignZone || crewBlockHasVehicle || noVehBlock || spareVehChip) {
        e.preventDefault();
        e.stopPropagation();
        try { e.dataTransfer.dropEffect = 'move'; } catch (err) {}
        // Highlight: vehicle chip if cursor is on it, else the whole
        // block, else the unassigned pool.
        var vehChip = e.target.closest && e.target.closest('.bk2-slot--drop-veh-assign');
        if (vehChip) {
          vehChip.classList.add('is-drag-over');
        } else if (unassignZone) {
          unassignZone.classList.add('is-drag-over');
        } else if (crewBlock) {
          crewBlock.classList.add('is-drag-over');
        }
        return;
      }
      // Crew-move drag over something irrelevant — let the cursor
      // show "no drop" by NOT calling preventDefault.
      return;
    }

    // Equipment / gear drags: a vehicle + its gear is one hitch target, so
    // hovering anywhere in the assembly highlights + accepts onto that unit
    // (a real vehicle id only — bare requirement placeholders fall through so
    // a vehicle can still be dropped to fill them).
    var vehUnit = e.target.closest && e.target.closest('.bk2-vehunit[data-vehicle-id]');
    if (vehUnit && vehUnit.getAttribute('data-vehicle-id')) {
      e.preventDefault();
      e.stopPropagation();
      try { e.dataTransfer.dropEffect = 'copy'; } catch (err) {}
      vehUnit.classList.add('is-drag-over');
      return;
    }

    // Non-crew-move drags use the simple drop-class match (resource
    // panel → empty crew/UTE slot), else the card's team box (drop-to-add),
    // else ANYWHERE on the floating (glowing) card, else the Resources tab's
    // narrow-screen drop strip.
    var slot = e.target && e.target.closest && e.target.closest('.bk2-slot--drop');
    if (!slot) {
      var box = e.target && e.target.closest &&
        (e.target.closest('.bk2-card-teambox') ||
         e.target.closest('.bk2-card--floating[data-booking-id]') ||
         e.target.closest('.bk2-restab-dropstrip[data-booking-id]'));
      if (box) { e.preventDefault(); try { e.dataTransfer.dropEffect = 'copy'; } catch (err) {} box.classList.add('is-drag-over'); }
      return;
    }
    e.preventDefault();
    e.stopPropagation();
    try { e.dataTransfer.dropEffect = 'copy'; } catch (err) {}
    slot.classList.add('is-drag-over');
  });
  document.addEventListener('dragleave', function (e) {
    // Clear any of the three possible highlight roots if we've left
    // them entirely (relatedTarget is outside the element).
    var rootSelectors = ['.bk2-slot--drop.is-drag-over', '.bk2-vehunit.is-drag-over', '.bk2-crew.is-drag-over'];
    rootSelectors.forEach(function (sel) {
      var el = e.target.closest && e.target.closest(sel);
      if (!el) return;
      if (!el.contains(e.relatedTarget)) el.classList.remove('is-drag-over');
    });
  });

  // Which ute should dropped/moved gear hitch to? A ute that already
  // carries gear renders its vehicle chip and its gear chips as SIBLINGS,
  // so a second item (e.g. a portaboom dropped on/beside the trailer)
  // misses the vehicle chip and used to fall loose into the Gear strip.
  // Resolve up the DOM: the vehicle chip itself → a gear chip's own ute →
  // the enclosing crew block's ute. Empty string ⇒ loose / detach.
  function bk2ResolveHitchVehicle(e) {
    if (!e.target || !e.target.closest) return '';
    // A vehicle + its hitched gear are wrapped in one .bk2-vehunit, so a drop
    // ANYWHERE in the assembly — the ute chip, a gear chip already on it, or
    // the gaps between them — hitches to that vehicle. This is what lets a
    // second item (a portaboom onto a ute that already carries a trailer) land
    // on the unit rather than falling loose, in crew blocks AND the spare
    // Vehicles list. Empty data-vehicle-id (a pure requirement with no vehicle
    // row yet) can't be hitched → falls through to loose.
    var unit = e.target.closest('.bk2-vehunit[data-vehicle-id]');
    if (unit && unit.getAttribute('data-vehicle-id')) return unit.getAttribute('data-vehicle-id');
    var vehChip = e.target.closest('.bk2-veh-slot[data-vehicle-id]');
    if (vehChip && vehChip.getAttribute('data-vehicle-id')) return vehChip.getAttribute('data-vehicle-id');
    var gearChip = e.target.closest('.bk2-veh-gear[data-from-vehicle-id]');
    if (gearChip && gearChip.getAttribute('data-from-vehicle-id')) return gearChip.getAttribute('data-from-vehicle-id');
    var crewBlock = e.target.closest('.bk2-crew');
    if (crewBlock) {
      var v = crewBlock.querySelector('.bk2-veh-slot[data-vehicle-id]');
      if (v && v.getAttribute('data-vehicle-id')) return v.getAttribute('data-vehicle-id');
    }
    return '';
  }

  document.addEventListener('drop', function (e) {
    // Read every payload we might receive. Whichever the source set
    // determines the action — crew-move ALWAYS wins because it can
    // only come from a worker slot drag (most specific intent).
    var crewMovePayload = '';
    var personId        = '';
    var vehiclePayload  = '';
    var equipPayload    = '';
    var gearMovePayload = '';
    try { crewMovePayload = e.dataTransfer.getData('application/x-bk2-crew-move') || ''; } catch (err) {}
    try { personId        = e.dataTransfer.getData('application/x-bk2-person')   || ''; } catch (err) {}
    try { vehiclePayload  = e.dataTransfer.getData('application/x-bk2-vehicle')  || ''; } catch (err) {}
    try { equipPayload    = e.dataTransfer.getData('application/x-bk2-equip')    || ''; } catch (err) {}
    try { gearMovePayload = e.dataTransfer.getData('application/x-bk2-gear-move') || ''; } catch (err) {}

    // ── GEAR MOVE (chip already on a card) ──
    // Onto a vehicle chip of the SAME booking → hitch to that ute; onto the
    // card body → detach (back to the loose Gear strip). Cross-booking
    // drops are ignored — remove + re-add is the explicit way to move gear
    // between shifts.
    if (gearMovePayload) {
      var gmv; try { gmv = JSON.parse(gearMovePayload); } catch (err) { return; }
      if (!gmv || !gmv.eqId || !gmv.bookingId) return;
      var gmTargetVehicle = bk2ResolveHitchVehicle(e);
      var gmHost = e.target.closest && (e.target.closest('.bk2-card-teambox') ||
                              e.target.closest('.bk2-card[data-booking-id]') ||
                              e.target.closest('.bk2-card--floating[data-booking-id]'));
      if (!gmHost) return;
      var gmBookingEl = gmHost.closest('[data-booking-id]') || gmHost;
      if (String(gmBookingEl.getAttribute('data-booking-id')) !== String(gmv.bookingId)) return;
      e.preventDefault(); e.stopPropagation();
      document.querySelectorAll('.is-drag-over').forEach(function (el) { el.classList.remove('is-drag-over'); });
      if (String(gmTargetVehicle) === String(gmv.fromVehicleId || '')) return; // no-op drop
      var gmBody = new URLSearchParams();
      gmBody.append('vehicle_id', gmTargetVehicle);
      if (CSRF_TOKEN) gmBody.append('_csrf', CSRF_TOKEN);
      fetch('/bookings/' + encodeURIComponent(gmv.bookingId) + '/equipment/' + encodeURIComponent(gmv.eqId) + '/attach', {
        method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': CSRF_TOKEN || '' },
        body: gmBody, credentials: 'same-origin',
      }).then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (j) {
          if (!j || j.ok === false) throw new Error((j && j.error) || 'failed');
          if (typeof bk2Toast === 'function') bk2Toast((gmv.name || 'Gear') + (gmTargetVehicle ? ' hitched to the vehicle.' : ' detached.'), 'success');
          bk2RefreshCard(gmv.bookingId);
        }).catch(function () { if (typeof bk2Toast === 'function') bk2Toast('Could not move the gear.', 'error'); });
      return;
    }

    // ── EQUIPMENT DROP (gear from the panel) ──
    // On a vehicle chip → hitch it to that ute (trailer / portaboom).
    // Anywhere else on a card → add to the booking unattached.
    if (equipPayload) {
      var eqp; try { eqp = JSON.parse(equipPayload); } catch (err) { return; }
      if (!eqp || !eqp.id) return;
      var hitchVehicleId = bk2ResolveHitchVehicle(e);
      var eqHost = e.target.closest && (e.target.closest('.bk2-card-teambox') ||
                              e.target.closest('.bk2-card[data-booking-id]') ||
                              e.target.closest('.bk2-card--floating[data-booking-id]') ||
                              e.target.closest('.bk2-restab-dropstrip[data-booking-id]'));
      if (!eqHost) return;
      e.preventDefault(); e.stopPropagation();
      document.querySelectorAll('.is-drag-over').forEach(function (el) { el.classList.remove('is-drag-over'); });
      var eqBookingEl = eqHost.closest('[data-booking-id]') || eqHost;
      var eqBookingId = eqBookingEl.getAttribute('data-booking-id');
      if (!eqBookingId) return;
      bk2AddEquipmentToBooking(eqBookingId, eqp, hitchVehicleId);
      return;
    }

    // ── CREW MOVE (existing worker → vehicle, or → unassigned pool) ──
    // Resolved against the crew BLOCK rather than just the precise
    // element under the cursor — drop anywhere inside a .bk2-crew
    // that has a vehicle = "in that ute". This matches what planners
    // expect when they aim for the worker rows under the ute and
    // miss the ute chip itself.
    if (crewMovePayload) {
      var unassignZone = e.target.closest && e.target.closest('.bk2-slot--drop-unassign');
      var crewBlock    = e.target.closest && e.target.closest('.bk2-crew');
      var vehSlotInBlock = crewBlock ? crewBlock.querySelector('.bk2-veh-slot.bk2-slot--drop-veh-assign[data-vehicle-id]') : null;
      // Dropping on a vehicle-less people group = take the worker off their
      // vehicle; they land in that standalone group (server-side placement).
      var noVehBlock = (crewBlock && crewBlock.hasAttribute('data-bk-novehicle')) ? crewBlock : null;
      // Standalone/spare vehicle chip is its own assign target.
      var spareVehChip = e.target.closest && e.target.closest('.bk2-veh-slot--spare.bk2-slot--drop-veh-assign[data-vehicle-id]');
      // If we landed inside the unassigned pool, prefer that intent.
      // Otherwise, if there's a crew block with a vehicle anywhere on
      // our drop path, use it; else a no-vehicle group; else a spare chip.
      var target = unassignZone || vehSlotInBlock || noVehBlock || spareVehChip;
      if (!target) {
        console.debug('[bk2 drop] crew-move dropped outside any crew-move target — ignoring');
        return;
      }
      e.preventDefault();
      e.stopPropagation();
      // Clear any drag-over highlights left around.
      document.querySelectorAll('.bk2-slot--drop.is-drag-over, .bk2-crew.is-drag-over').forEach(function (el) {
        el.classList.remove('is-drag-over');
      });
      var payload;
      try { payload = JSON.parse(crewMovePayload); } catch (err) { console.warn('[bk2 drop] crew payload parse failed', err); return; }
      if (!payload || !payload.booking_crew_id || !payload.booking_id) {
        console.warn('[bk2 drop] crew payload missing fields', payload);
        return;
      }
      // Same-booking check — pick the booking id from whichever
      // target we matched.
      var targetBookingId = target.getAttribute('data-booking-id') ||
                            (crewBlock && crewBlock.closest('[data-booking-id]') &&
                             crewBlock.closest('[data-booking-id]').getAttribute('data-booking-id'));
      if (targetBookingId && String(payload.booking_id) !== String(targetBookingId)) {
        alert('Workers can only be reassigned within the same booking.');
        return;
      }
      // Unassigned pool AND vehicle-less people groups both mean "clear the
      // worker's vehicle" — only real vehicle targets carry an id.
      var isAssign = !unassignZone && !noVehBlock;
      var vehicleId = isAssign ? ((vehSlotInBlock || spareVehChip).getAttribute('data-vehicle-id') || '') : '';
      console.debug('[bk2 drop] crew-move →', { isAssign: isAssign, vehicleId: vehicleId, booking_crew_id: payload.booking_crew_id });
      assignCrewToVehicle(payload, vehicleId);
      return;
    }

    // Non-crew-move drag — land on a .bk2-slot--drop target, OR anywhere on a
    // card's team box (drop-to-add). The box path only fires when NOT over a
    // specific slot, so slot-level drops keep their precise behaviour.
    var slot = e.target && e.target.closest && e.target.closest('.bk2-slot--drop');
    if (!slot) {
      var box = e.target && e.target.closest &&
        (e.target.closest('.bk2-card-teambox') ||
         e.target.closest('.bk2-card--floating[data-booking-id]') ||
         e.target.closest('.bk2-restab-dropstrip[data-booking-id]'));
      // The teambox lives inside a card; the floating card and the Resources
      // tab drop strip carry their own data-booking-id.
      var cardEl = box && (box.closest('.bk2-card[data-booking-id]') || box);
      if (box && cardEl && cardEl.getAttribute('data-booking-id')) {
        e.preventDefault(); e.stopPropagation();
        box.classList.remove('is-drag-over');
        var bId = cardEl.getAttribute('data-booking-id');
        if (personId) bk2AddPersonToBooking(bId, personId);
        else if (vehiclePayload) bk2AddVehicleToBooking(bId, vehiclePayload);
      }
      return;
    }
    e.preventDefault();
    e.stopPropagation();
    slot.classList.remove('is-drag-over');

    var bookingId = slot.getAttribute('data-booking-id');
    if (!bookingId) return;

    // ── VEHICLE DROP (resource panel → empty UTE slot) ──
    if (vehiclePayload && slot.classList.contains('bk2-slot--drop-vehicle')) {
      var v;
      try { v = JSON.parse(vehiclePayload); } catch (err) { return; }
      if (!v || !v.id) return;

      slot.classList.add('is-saving');
      var vBody = new URLSearchParams();
      if (v.source === 'fleet') vBody.append('fleet_vehicle_id', v.id);
      else                      vBody.append('equipment_id',     v.id);
      vBody.append('vehicle_role', slot.getAttribute('data-vehicle-role') || v.role || 'ute');
      // Target the exact empty placeholder this slot represents so the drop
      // upgrades it (fills the required slot) instead of appending + bumping.
      var upId = slot.getAttribute('data-vehicle-id');
      if (upId) vBody.append('upgrade_vehicle_id', upId);
      if (CSRF_TOKEN) vBody.append('_csrf', CSRF_TOKEN);

      fetch('/bookings/' + encodeURIComponent(bookingId) + '/vehicles', {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-CSRF-Token': CSRF_TOKEN || '',
        },
        body: vBody,
        credentials: 'same-origin',
      }).then(function (r) {
        return r.json().catch(function () { return { ok: r.ok }; }).then(function (j) {
          return { ok: r.ok, status: r.status, json: j };
        });
      }).then(function (result) {
        slot.classList.remove('is-saving');
        if (result.ok && (!result.json || result.json.ok !== false)) {
          replaceVehicleSlot(slot, v);
          rpMarkVehicleAssigned(v.id);
        } else {
          alert((result.json && result.json.error) || ('Could not assign vehicle (HTTP ' + result.status + ')'));
        }
      }).catch(function () {
        slot.classList.remove('is-saving');
        alert('Could not assign vehicle — network error.');
      });
      return;
    }

    // ── VEHICLE DROP on any OTHER slot (filled worker slot, vehicle chip,
    // empty TC slot…) — the planner aimed at the card, not a precise gap.
    // Treat it as "add this vehicle to the shift" (card-level add). Without
    // this, a vehicle only landed when dropped exactly on an empty UTE gap.
    if (vehiclePayload) {
      bk2AddVehicleToBooking(bookingId, vehiclePayload);
      return;
    }

    // ── PERSON DROP (resource panel → empty crew slot) ──
    if (!personId) {
      // Some browsers (Safari) only expose text/plain for unknown types
      try {
        var fallback = e.dataTransfer.getData('text/plain') || '';
        if (/^\d+$/.test(fallback)) personId = fallback;
      } catch (err) {}
    }
    if (!personId) return;
    // A pool worker dropped straight onto a vehicle chip → add them to the
    // booking AND seat them in that ute in one go (no add-then-drag).
    if (slot.classList.contains('bk2-slot--drop-veh-assign') && slot.getAttribute('data-vehicle-id')) {
      slot.classList.add('is-saving');
      bk2AddPersonToBooking(bookingId, personId, slot.getAttribute('data-vehicle-id'));
      return;
    }
    // The unassigned pool + empty vehicle-placeholder aren't person-add
    // slots (the placeholder wants a vehicle, not a worker).
    if (slot.classList.contains('bk2-slot--drop-unassign') ||
        slot.classList.contains('bk2-slot--drop-vehicle')) {
      return;
    }

    var role = slot.getAttribute('data-role-on-site') || '';
    slot.classList.add('is-saving');
    var body = new URLSearchParams();
    body.append('crew_member_id', personId);
    body.append('role_on_site', role);
    if (CSRF_TOKEN) body.append('_csrf', CSRF_TOKEN);

    fetch('/bookings/' + encodeURIComponent(bookingId) + '/crew', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-CSRF-Token': CSRF_TOKEN || '',
      },
      body: body,
      credentials: 'same-origin',
    }).then(function (r) {
      return r.json().catch(function () { return { ok: r.ok }; }).then(function (j) {
        return { ok: r.ok, status: r.status, json: j };
      });
    }).then(function (result) {
      slot.classList.remove('is-saving');
      if (result.ok && (!result.json || result.json.ok !== false)) {
        var crew = (result.json && result.json.crew) || { id: personId, full_name: '', role: role };
        insertFilledSlot(slot, crew);
        flashAssigned(personId);
        // Double-booking warning from the server — surface it, don't bury it.
        if (result.json && result.json.warning) window.bk2Toast('⚠ ' + (crew.full_name || 'Worker') + ': ' + result.json.warning);
      } else {
        alert((result.json && result.json.error) || ('Could not assign worker (HTTP ' + result.status + ')'));
      }
    }).catch(function () {
      slot.classList.remove('is-saving');
      alert('Could not assign worker — network error.');
    });
  });

  // Replace the empty UTE slot with a filled vehicle slot in place.
  // Each crew block carries exactly one vehicle slot, so we mutate
  // the existing div rather than insert+remove.
  function replaceVehicleSlot(emptySlot, v) {
    var role = (slot => slot.getAttribute('data-vehicle-role') || v.role || 'ute')(emptySlot);
    var tag = (role || 'ute').toUpperCase().slice(0, 3);
    var name = v.name || v.rego || '(unnamed)';
    emptySlot.className = 'bk2-veh-slot bk2-slot--just-added';
    emptySlot.removeAttribute('data-booking-id');
    emptySlot.removeAttribute('data-vehicle-role');
    var html = '<span class="bk2-veh-tag">' + tag + '</span>' +
               '<span class="bk2-veh-slot-name">' + escapeHtml(name) + '</span>';
    if (v.name && v.rego) {
      html += '<span style="font-family:ui-monospace,monospace;font-size:11px;opacity:0.8">' + escapeHtml(v.rego) + '</span>';
    }
    emptySlot.innerHTML = html;
    setTimeout(function () { emptySlot.classList.remove('bk2-slot--just-added'); }, 1200);
  }
  function escapeHtml(s) {
    return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  // Smart prefill for the slide-over create form — start date / time
  // render blank until the planner taps the field. What we pre-fill
  // depends on which day the bookings board is showing:
  //   · viewing TODAY → Sydney today + the next whole hour (e.g. 3:24pm
  //     → 4:00pm). Useful when the planner is creating a same-day
  //     booking and just wants the soonest sensible slot.
  //   · viewing ANY OTHER DAY → that day + 06:00. Most field shifts
  //     start at 6am, so this skips the typing for the common case.
  // End time gets the +8h treatment via the change handler below.
  //
  // Exposed as rearmCreatePrefill() on the module scope so openEditor()
  // can re-attach the `once: true` focus listeners every time the
  // slide-over opens (otherwise the listeners detach after the first
  // tap and subsequent opens lose the prefill behaviour).
  var rearmCreatePrefill;
  (function () {
    var dateEl = document.querySelector('[data-bk-autofill="start_date"]');
    var timeEl = document.querySelector('[data-bk-autofill="start_time"]');
    var endEl  = document.querySelector('[data-bk-autofill="end_time"]');
    if (!timeEl) return;
    var endTouched = false;
    if (endEl) endEl.addEventListener('input', function () { endTouched = true; });

    function sydneyParts() {
      return new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Australia/Sydney',
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false,
      }).formatToParts(new Date()).reduce(function (a, p) { a[p.type] = p.value; return a; }, {});
    }
    function sydneyToday() {
      var p = sydneyParts();
      return p.year + '-' + p.month + '-' + p.day;
    }
    function nextHourToday() {
      var p = sydneyParts();
      var d = new Date(p.year + '-' + p.month + '-' + p.day + 'T' + p.hour + ':00:00');
      d.setHours(d.getHours() + 1);
      var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
      return {
        date: d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()),
        time: pad(d.getHours()) + ':00',
      };
    }
    function prefillFor() {
      var viewedDate = (window.BK2_DATA && window.BK2_DATA.dateStr) || sydneyToday();
      if (viewedDate === sydneyToday()) {
        return nextHourToday();
      }
      return { date: viewedDate, time: '06:00' };
    }
    function prefill() {
      var n = prefillFor();
      if (dateEl && !dateEl.value) dateEl.value = n.date;
      if (timeEl && !timeEl.value) timeEl.value = n.time;
      applyEnd();
    }
    function applyEnd() {
      if (endTouched || !endEl) return;
      if (!timeEl.value) return;
      var parts = timeEl.value.split(':');
      var d = new Date((dateEl && dateEl.value ? dateEl.value : '1970-01-01') + 'T00:00:00');
      d.setHours(parseInt(parts[0], 10) + 8, parseInt(parts[1] || '0', 10), 0, 0);
      var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
      endEl.value = pad(d.getHours()) + ':' + pad(d.getMinutes());
    }
    rearmCreatePrefill = function () {
      endTouched = false;
      timeEl.addEventListener('focus', prefill, { once: true });
      if (dateEl) dateEl.addEventListener('focus', prefill, { once: true });
    };
    rearmCreatePrefill();
    timeEl.addEventListener('change', applyEnd);
    if (dateEl) dateEl.addEventListener('change', applyEnd);
  })();

  // Build a `.bk2-slot--filled` row from a crew object and insert it
  // before the empty-slot div. Decrements the empty count; removes
  // the empty slot when it hits zero.
  function insertFilledSlot(emptySlot, crew) {
    function initials(name) {
      if (!name) return '?';
      return name.split(/\s+/).map(function (n) { return n[0] || ''; }).join('').substring(0, 2).toUpperCase();
    }
    function roleAbbr(r) {
      if (!r) return 'TC';
      if (/team[_ ]?lead/i.test(r)) return 'TL';
      if (/super/i.test(r))         return 'SUP';
      if (/spotter/i.test(r))       return 'SP';
      if (/hoist/i.test(r))         return 'HO';
      return 'TC';
    }
    var slotRole = emptySlot.getAttribute('data-role-on-site') || crew.role || 'TC';
    var filled = document.createElement('div');
    filled.className = 'bk2-slot bk2-slot--filled bk2-slot--just-added';
    filled.innerHTML =
      '<span class="bk2-slot-avatar">' + initials(crew.full_name || '') + '</span>' +
      '<span class="bk2-slot-role-tag">' + roleAbbr(slotRole) + '</span>' +
      '<span class="bk2-slot-name">' + (crew.full_name || ('#' + crew.id)) + '</span>' +
      ((crew.employment_status === 'reserved')
        ? '<span class="bk2-warn bk2-warn--info">RES</span>'
        : '');
    emptySlot.parentNode.insertBefore(filled, emptySlot);
    // Drop the just-added pulse after the animation finishes.
    setTimeout(function () { filled.classList.remove('bk2-slot--just-added'); }, 1200);

    var remaining = (parseInt(emptySlot.getAttribute('data-empty-count'), 10) || 1) - 1;
    if (remaining <= 0) {
      emptySlot.parentNode.removeChild(emptySlot);
    } else {
      emptySlot.setAttribute('data-empty-count', remaining);
      var label = emptySlot.querySelector('.bk2-slot-empty-label');
      if (label) {
        label.textContent = remaining === 1
          ? (slotRole + ' slot · drop a worker here')
          : (remaining + ' more ' + slotRole + ' slots · drop workers here');
      }
    }
  }

  // Briefly mark the resource-panel row as "just assigned", then drop it
  // from the pool — an allocated worker can't be picked twice for the day.
  function flashAssigned(personId) {
    var row = document.querySelector('.bk2-rp-item[data-resource-type="person"][data-resource-id="' + personId + '"]');
    if (row) {
      row.classList.add('is-just-assigned');
      setTimeout(function () { row.remove(); }, 900);
    }
    try {
      if (rpData && rpData.people) {
        var p = rpData.people.find(function (x) { return String(x.id) === String(personId); });
        if (p) p.assigned_today = true;
      }
    } catch (e) {}
    try { document.dispatchEvent(new CustomEvent('bk2:alloc-changed')); } catch (e) {}
  }
  // Same for vehicles — once on a booking, out of the pool.
  function rpMarkVehicleAssigned(vehicleId) {
    var row = document.querySelector('.bk2-rp-item[data-resource-type="vehicle"][data-resource-id="' + vehicleId + '"]');
    if (row) {
      row.classList.add('is-just-assigned');
      setTimeout(function () { row.remove(); }, 900);
    }
    try {
      if (rpData && rpData.vehicles) {
        var v = rpData.vehicles.find(function (x) { return String(x.id) === String(vehicleId); });
        if (v) v.assigned_today = true;
      }
    } catch (e) {}
    try { document.dispatchEvent(new CustomEvent('bk2:alloc-changed')); } catch (e) {}
  }

  // ── Drop-to-add on a board card's team box (booking not opened) ──
  // Dropping a pool worker/vehicle anywhere on a card's team area adds them to
  // that booking, then refreshes the card in place.
  // Canonical live refresh. Re-fetch the board once and patch BOTH the
  // static board card AND the floating (glowing) editor card for this
  // booking, then re-sync the Overview requirement steppers — so every
  // allocation change (add, remove, move, driver, gear…) shows up instantly
  // without reopening the editor. An in-flight guard coalesces burst calls
  // and re-runs once more if a change landed while a fetch was in flight.
  var _bk2Refreshing = {};
  function bk2RefreshCard(bookingId) {
    bookingId = String(bookingId || '');
    if (!bookingId) return;
    try { refreshRequirementSteppers(); } catch (e) {}
    if (_bk2Refreshing[bookingId]) { _bk2Refreshing[bookingId] = 'again'; return; }
    _bk2Refreshing[bookingId] = true;
    var done = function () {
      var again = _bk2Refreshing[bookingId] === 'again';
      delete _bk2Refreshing[bookingId];
      if (again) bk2RefreshCard(bookingId);
    };
    fetch(location.pathname + location.search, { credentials: 'same-origin', headers: { 'Accept': 'text/html', 'X-Requested-With': 'fetch' } })
      .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('.bk2-card[data-booking-id="' + bookingId + '"]');
        if (!fresh) return;
        document.querySelectorAll('.bk2-card[data-booking-id="' + bookingId + '"]:not(.bk2-card--floating)')
          .forEach(function (cur) { cur.innerHTML = fresh.innerHTML; });
        var flo = document.querySelector('.bk2-card--floating[data-booking-id="' + bookingId + '"]');
        if (flo) flo.innerHTML = fresh.innerHTML;
      }).then(done, done);
  }
  // Add a pool worker to a booking. When vehicleId is given (dropped
  // straight onto a vehicle chip) they're seated in that ute in the same
  // request — no add-then-drag needed.
  function bk2AddPersonToBooking(bookingId, personId, vehicleId) {
    var body = new URLSearchParams(); body.append('crew_member_id', personId);
    if (vehicleId) body.append('assigned_vehicle_id', vehicleId);
    if (CSRF_TOKEN) body.append('_csrf', CSRF_TOKEN);
    fetch('/bookings/' + encodeURIComponent(bookingId) + '/crew', {
      method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': CSRF_TOKEN || '' },
      body: body, credentials: 'same-origin',
    }).then(function (r) { return r.json().catch(function () { return {}; }); })
      .then(function (j) {
        if (j && j.warning && typeof bk2Toast === 'function') bk2Toast('⚠ ' + j.warning);
        flashAssigned(personId); bk2RefreshCard(bookingId);
      }).catch(function () { if (typeof bk2Toast === 'function') bk2Toast('Could not add worker.', 'error'); });
  }
  function bk2AddVehicleToBooking(bookingId, vehiclePayload) {
    var v; try { v = JSON.parse(vehiclePayload); } catch (e) { return; }
    if (!v || !v.id) return;
    var body = new URLSearchParams();
    if (v.source === 'fleet') body.append('fleet_vehicle_id', v.id); else body.append('equipment_id', v.id);
    body.append('vehicle_role', v.role || 'ute');
    if (CSRF_TOKEN) body.append('_csrf', CSRF_TOKEN);
    fetch('/bookings/' + encodeURIComponent(bookingId) + '/vehicles', {
      method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': CSRF_TOKEN || '' },
      body: body, credentials: 'same-origin',
    }).then(function (r) { return r.json().catch(function () { return {}; }); })
      .then(function (j) {
        if (j && j.warning && typeof bk2Toast === 'function') bk2Toast('⚠ ' + j.warning);
        rpMarkVehicleAssigned(v.id); bk2RefreshCard(bookingId);
      }).catch(function () { if (typeof bk2Toast === 'function') bk2Toast('Could not add vehicle.', 'error'); });
  }

  // Add a piece of gear from the panel — hitched to a specific vehicle when
  // vehicleId is given (drop landed on a ute chip), else booking-level.
  function bk2AddEquipmentToBooking(bookingId, eqp, vehicleId) {
    var body = new URLSearchParams();
    if (eqp.hire_unit_id) body.append('hire_unit_id', eqp.hire_unit_id);
    else body.append('equipment_id', eqp.id);
    if (vehicleId) body.append('attached_vehicle_id', vehicleId);
    if (CSRF_TOKEN) body.append('_csrf', CSRF_TOKEN);
    fetch('/bookings/' + encodeURIComponent(bookingId) + '/equipment', {
      method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': CSRF_TOKEN || '' },
      body: body, credentials: 'same-origin',
    }).then(function (r) { return r.json().catch(function () { return {}; }); })
      .then(function (j) {
        if (!j || j.ok === false) throw new Error((j && j.error) || 'failed');
        if (typeof bk2Toast === 'function') bk2Toast((eqp.name || 'Gear') + (vehicleId ? ' hitched to the vehicle.' : ' added to the shift.'), 'success');
        bk2RefreshCard(bookingId);
        try { document.dispatchEvent(new CustomEvent('bk2:alloc-changed')); } catch (err) {}
        // Offer the automatic return-to-depot task — drag-adds only, never
        // requirement steppers.
        if (j.id) bk2ReturnTaskPrompt(bookingId, j.id, eqp.name || 'this equipment');
      }).catch(function () { if (typeof bk2Toast === 'function') bk2Toast('Could not add the gear.', 'error'); });
  }

  // Yes/No modal after gear lands on a shift: create the automatic
  // "return to depot" task? Yes → the server assigns it to the ute's
  // driver (hitched) or the whole crew (loose) and keeps it in sync.
  function bk2ReturnTaskPrompt(bookingId, eqId, eqName) {
    var backdrop = document.createElement('div');
    backdrop.className = 'bk2-pop-backdrop';
    var pop = document.createElement('div');
    pop.className = 'bk2-pop bk2-pop--center';
    pop.setAttribute('role', 'dialog');
    pop.innerHTML =
      '<div class="bk2-pop-head"><span class="bk2-pop-title">Return to depot</span></div>' +
      '<p class="bk2-pop-text">Create an automatic task for the crew to return <strong></strong> to the depot after the shift?</p>' +
      '<div class="bk2-pop-confirm-row">' +
        '<button type="button" class="bk2-pop-btn bk2-pop-btn--yes" data-rt="yes">Yes, create task</button>' +
        '<button type="button" class="bk2-pop-btn" data-rt="no">No thanks</button>' +
      '</div>';
    pop.querySelector('strong').textContent = eqName;
    document.body.appendChild(backdrop);
    document.body.appendChild(pop);
    requestAnimationFrame(function () { backdrop.classList.add('is-open'); pop.classList.add('is-open'); });
    function close() {
      backdrop.classList.remove('is-open'); pop.classList.remove('is-open');
      document.removeEventListener('keydown', onKey, true);
      setTimeout(function () {
        if (backdrop.parentNode) backdrop.parentNode.removeChild(backdrop);
        if (pop.parentNode) pop.parentNode.removeChild(pop);
      }, 220);
    }
    function onKey(ev) { if (ev.key === 'Escape') { ev.stopPropagation(); close(); } }
    document.addEventListener('keydown', onKey, true);
    backdrop.addEventListener('click', close);
    pop.addEventListener('click', function (ev) {
      var btn = ev.target.closest && ev.target.closest('[data-rt]');
      if (!btn) return;
      if (btn.getAttribute('data-rt') === 'no') { close(); return; }
      btn.disabled = true;
      var body = new URLSearchParams();
      if (CSRF_TOKEN) body.append('_csrf', CSRF_TOKEN);
      fetch('/bookings/' + encodeURIComponent(bookingId) + '/equipment/' + encodeURIComponent(eqId) + '/return-task', {
        method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': CSRF_TOKEN || '' },
        body: body, credentials: 'same-origin',
      }).then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (j) {
          if (!j || j.ok === false) throw new Error((j && j.error) || 'failed');
          if (typeof bk2Toast === 'function') {
            bk2Toast(j.mode === 'driver'
              ? 'Return task assigned to the driver.'
              : 'Return task assigned to the whole crew — first to finish ticks it off for everyone.', 'success');
          }
          close();
        }).catch(function () {
          if (typeof bk2Toast === 'function') bk2Toast('Could not create the return task.', 'error');
          btn.disabled = false;
        });
    });
  }

  // ==========================================================
  //  CREW SLOT POPOVER — click a filled worker slot to open a
  //  mini action sheet with Profile, TL, FA, Driver, STS, NB,
  //  Remove. Toggles fire against the existing booking_crew
  //  flag endpoints; the open popover updates state in place
  //  + reflects the change back on the slot pills.
  // ==========================================================
  var openPop = null;
  var openBackdrop = null;
  var activeSlot = null;
  function closePopover() {
    if (activeSlot) { activeSlot.classList.remove('is-active-pick'); activeSlot = null; }
    if (openPop) {
      openPop.classList.remove('is-open');
      var popRef = openPop;
      setTimeout(function () { if (popRef && popRef.parentNode) popRef.parentNode.removeChild(popRef); }, 220);
    }
    if (openBackdrop) {
      openBackdrop.classList.remove('is-open');
      var bdRef = openBackdrop;
      setTimeout(function () { if (bdRef && bdRef.parentNode) bdRef.parentNode.removeChild(bdRef); }, 220);
    }
    openPop = null;
    openBackdrop = null;
    document.removeEventListener('keydown', onPopKeyDown, true);
  }
  function onPopKeyDown(e) {
    if (e.key === 'Escape') { e.preventDefault(); closePopover(); }
  }

  function initialsFor(name) {
    if (!name) return '?';
    return name.split(/\s+/).map(function (n) { return n[0] || ''; }).join('').substring(0, 2).toUpperCase();
  }

  // Click handler — open the side panel (delegated so it works on
  // slots that are dropped in after the initial render).
  document.addEventListener('click', function (e) {
    var slot = e.target && e.target.closest && e.target.closest('.bk2-slot--click');
    if (!slot) return;
    // The slot lives inside the booking card <a> — stop the link
    // from navigating to the booking detail.
    e.preventDefault();
    e.stopPropagation();
    openSlotPopover(slot);
  });

  function openSlotPopover(slot) {
    var wasSameSlot = (activeSlot === slot);
    closePopover();
    if (wasSameSlot) return; // clicking the same person again toggles the panel closed
    var bookingId    = slot.getAttribute('data-booking-id');
    var bookingCrewId = slot.getAttribute('data-booking-crew-id');
    var crewMemberId = slot.getAttribute('data-crew-member-id');
    var crewName     = slot.getAttribute('data-crew-name') || '';
    if (!bookingCrewId || !bookingId) return;

    var on = {
      tl:  slot.getAttribute('data-flag-tl')     === '1',
      fa:  slot.getAttribute('data-flag-fa')     === '1',
      drv: slot.getAttribute('data-flag-driver') === '1',
      sts: slot.getAttribute('data-flag-sts')    === '1',
      nb:  slot.getAttribute('data-flag-nb')     === '1',
    };

    // Is this worker currently riding a vehicle? True when the slot sits in a
    // crew block that has a vehicle, or under a spare/standalone vehicle — but
    // NOT when it's already in the "Not in any vehicle" pool. Drives the
    // "Take off ute" action: a reliable click alternative to the fiddly
    // drag-onto-the-unassign-strip gesture (some planners can't land it).
    var inPool = !!(slot.closest && slot.closest('.bk2-unassigned'));
    var crewBlk = slot.closest && slot.closest('.bk2-crew');
    var blkHasVehicle = crewBlk && crewBlk.querySelector('.bk2-veh-slot.bk2-slot--drop-veh-assign[data-vehicle-id]');
    var inSpareVeh = !!(slot.closest && slot.closest('.bk2-spareveh'));
    var onVehicle = !inPool && (blkHasVehicle || inSpareVeh);

    // Pick up which booking card we're on so we can show context.
    var cardEl = slot.closest('.bk2-card');
    var bookingNumber = cardEl ? (cardEl.querySelector('.bk2-banner-meta') || {}).textContent || '' : '';
    var subLabel = bookingNumber ? bookingNumber.trim() : 'On this shift';

    var backdrop = document.createElement('div');
    backdrop.className = 'bk2-pop-backdrop';

    var pop = document.createElement('aside');
    pop.className = 'bk2-pop';
    pop.setAttribute('role', 'dialog');
    pop.setAttribute('aria-label', 'Crew actions for ' + crewName);
    pop.innerHTML =
      '<button type="button" class="bk2-pop-close" aria-label="Close" data-pop-action="close">' +
        '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>' +
      '</button>' +
      '<div class="bk2-pop-head">' +
        '<span class="bk2-pop-avatar">' + initialsFor(crewName) + '</span>' +
        '<div style="min-width:0;flex:1">' +
          '<div class="bk2-pop-name" title="' + escapeHtml(crewName) + '">' + escapeHtml(crewName) + '</div>' +
          '<div class="bk2-pop-sub">' + escapeHtml(subLabel) + '</div>' +
        '</div>' +
      '</div>' +
      '<div class="bk2-pop-section-label">Role on shift</div>' +
      '<div class="bk2-pop-grid">' +
        popBtn('tl',  'TL',       '<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 11v2a2 2 0 002 2h1l5 3V6L6 9H5a2 2 0 00-2 2zm15-4v10c1.7 0 3-2.2 3-5s-1.3-5-3-5z"/></svg>', on.tl,  'tl') +
        popBtn('fa',  'FA',       '<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5a2 2 0 012-2h2a2 2 0 012 2v2h4a1 1 0 011 1v11a2 2 0 01-2 2H5a2 2 0 01-2-2V8a1 1 0 011-1h4V5zm3 6v6m-3-3h6"/></svg>', on.fa,  'fa') +
        popBtn('drv', 'Driver',   '<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h2m10 0h2M12 5v2m0 10v2"/></svg>', on.drv, 'drv') +
        popBtn('sts', 'STS',      '<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><circle cx="12" cy="11" r="3"/></svg>', on.sts, 'sts') +
        popBtn('nb',  'Non Bill', '<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 4l16 16M12 8c-1.7 0-3 .9-3 2s1.3 2 3 2 3 .9 3 2-1.3 2-3 2"/></svg>', on.nb,  'nb') +
        popBtn('profile', 'Profile', '<svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>', false) +
      '</div>' +
      '<div class="bk2-pop-foot">' +
        (onVehicle ?
          '<button type="button" class="bk2-pop-takeoff" data-pop-action="takeoff">' +
            '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 17h8m-8 0a2 2 0 11-4 0 2 2 0 014 0zm8 0a2 2 0 104 0 2 2 0 00-4 0zm-9-5h10l-1-4H4v4zm10 0h3l3 3v2h-2M3 3l18 18"/></svg>' +
            'Take off ute' +
          '</button>' : '') +
        '<button type="button" class="bk2-pop-remove" data-pop-action="remove">' +
          '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/></svg>' +
          'Remove from shift' +
        '</button>' +
      '</div>';

    document.body.appendChild(backdrop);
    document.body.appendChild(pop);
    // Force a reflow so the slide-in transform takes effect on the next frame.
    void pop.offsetWidth;
    backdrop.classList.add('is-open');
    pop.classList.add('is-open');
    openPop = pop;
    openBackdrop = backdrop;
    activeSlot = slot;
    slot.classList.add('is-active-pick');

    backdrop.addEventListener('click', closePopover);
    document.addEventListener('keydown', onPopKeyDown, true);

    // Wire button clicks
    pop.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('[data-pop-action]');
      if (!btn) return;
      var action = btn.getAttribute('data-pop-action');
      if (action === 'close') { closePopover(); return; }
      if (action === 'profile') {
        // Open the worker's profile in a NEW tab so the planner keeps their
        // place on the board (the editor + glowing panel stay put). Navigating
        // the board's own tab to the profile meant that going back landed on
        // the Workforce roster instead of the shift. `from` also points the
        // profile's own Back link at the board rather than Workforce.
        if (crewMemberId) {
          var profUrl = '/crew/' + encodeURIComponent(crewMemberId) +
            '?from=' + encodeURIComponent(location.pathname + location.search);
          window.open(profUrl, '_blank', 'noopener');
        }
        closePopover();
        return;
      }
      if (action === 'takeoff') {
        // Same effect as dragging the worker onto the "take off the ute" zone —
        // clear their vehicle (assign-vehicle with no vehicle_id), which parks
        // them in the "Not in any vehicle" pool and keeps them there.
        closePopover();
        assignCrewToVehicle({ booking_id: bookingId, booking_crew_id: bookingCrewId, crew_name: crewName }, '');
        return;
      }
      if (action === 'remove') {
        // Inline confirm instead of the browser's native dialog: the button
        // swaps for a red confirm strip (Yes, remove / Keep) inside the panel.
        if (btn.getAttribute('data-confirming') === '1') return;
        btn.setAttribute('data-confirming', '1');
        var strip = document.createElement('div');
        strip.className = 'bk2-pop-confirm';
        strip.innerHTML =
          '<span class="bk2-pop-confirm-msg">Remove ' + escapeHtml(crewName) + ' from this shift?</span>' +
          '<div class="bk2-pop-confirm-row">' +
            '<button type="button" class="bk2-pop-confirm-yes">Yes, remove</button>' +
            '<button type="button" class="bk2-pop-confirm-no">Keep</button>' +
          '</div>';
        btn.hidden = true;
        btn.insertAdjacentElement('afterend', strip);
        strip.querySelector('.bk2-pop-confirm-no').addEventListener('click', function () {
          strip.remove();
          btn.hidden = false;
          btn.removeAttribute('data-confirming');
        });
        strip.querySelector('.bk2-pop-confirm-yes').addEventListener('click', function () {
          var yes = strip.querySelector('.bk2-pop-confirm-yes');
          yes.disabled = true;
          yes.textContent = 'Removing…';
          removeFromBooking(slot, bookingId, crewMemberId);
        });
        return;
      }
      // Flag toggles — tl/fa/sts/nb fire /flag, drv fires /driver
      toggleFlag(action, btn, slot, bookingId, bookingCrewId);
    });
  }

  function popBtn(action, label, iconSvg, isOn, flagKey) {
    var onCls = isOn ? (' is-on' + (flagKey ? ' is-on--' + flagKey : '')) : '';
    return '<button type="button" class="bk2-pop-btn' + onCls + '" data-pop-action="' + action + '"' +
           (flagKey ? ' data-flag="' + flagKey + '"' : '') + '>' +
             iconSvg + '<span>' + escapeHtml(label) + '</span>' +
           '</button>';
  }

  function toggleFlag(action, btn, slot, bookingId, bookingCrewId) {
    var isDriver = action === 'drv';
    var url = '/bookings/' + encodeURIComponent(bookingId) + '/crew/' + encodeURIComponent(bookingCrewId) + (isDriver ? '/driver' : '/flag');
    var body = new URLSearchParams();
    if (!isDriver) body.append('flag', action);
    if (CSRF_TOKEN) body.append('_csrf', CSRF_TOKEN);
    btn.disabled = true;
    fetch(url, {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-CSRF-Token': CSRF_TOKEN || '',
      },
      body: body,
      credentials: 'same-origin',
    }).then(function (r) { return r.json().catch(function () { return { ok: r.ok }; }).then(function (j) { return { ok: r.ok, json: j }; }); })
      .then(function (result) {
        btn.disabled = false;
        if (!result.ok || !result.json || result.json.ok === false) {
          alert((result.json && result.json.error) || 'Could not update.');
          return;
        }
        var isOn = !!result.json.value;
        btn.classList.toggle('is-on', isOn);
        btn.classList.toggle('is-on--' + action, isOn);
        // Reflect on the slot itself: update data attribute + add/remove pill.
        var attrMap = { tl: 'data-flag-tl', fa: 'data-flag-fa', sts: 'data-flag-sts', nb: 'data-flag-nb', drv: 'data-flag-driver' };
        slot.setAttribute(attrMap[action], isOn ? '1' : '0');
        syncSlotPills(slot);
        // Driver visual highlight on the slot
        if (action === 'drv') slot.classList.toggle('is-driver', isOn);
        // A driver change ripples server-side — only ONE driver per vehicle
        // (so the previous driver's DRV pill must clear) and any gear
        // return-to-depot task switches from the whole crew to the driver.
        // Re-sync from server truth and close the sheet so the live card
        // reflects it. Plain flags have no ripple, so they stay optimistic.
        if (action === 'drv') {
          var bkEl = slot.closest('[data-booking-id]');
          closePopover();
          if (bkEl) bk2RefreshCard(bkEl.getAttribute('data-booking-id'));
        }
      }).catch(function () {
        btn.disabled = false;
        alert('Could not update — network error.');
      });
  }

  // Re-render the row of flag pills in the slot from its data-flag-*
  // attributes. Cheaper than re-rendering the whole slot.
  function syncSlotPills(slot) {
    // Remove existing flag pills
    slot.querySelectorAll('.bk2-flag').forEach(function (el) { el.parentNode.removeChild(el); });
    // Re-insert in the same order as the server template
    var nameEl = slot.querySelector('.bk2-slot-name');
    if (!nameEl) return;
    var order = [
      ['data-flag-tl',     'bk2-flag--tl',  'TL',  'Team Leader'],
      ['data-flag-fa',     'bk2-flag--fa',  'FA',  'First Aid'],
      ['data-flag-driver', 'bk2-flag--drv', 'DRV', 'Driver'],
      ['data-flag-sts',    'bk2-flag--sts', 'STS', 'Straight to Site'],
      ['data-flag-nb',     'bk2-flag--nb',  'NB',  'Non-Billable'],
    ];
    var anchor = nameEl.nextSibling;
    order.forEach(function (cfg) {
      if (slot.getAttribute(cfg[0]) !== '1') return;
      var pill = document.createElement('span');
      pill.className = 'bk2-flag ' + cfg[1];
      pill.setAttribute('title', cfg[3]);
      pill.textContent = cfg[2];
      slot.insertBefore(pill, anchor);
    });
  }

  function removeFromBooking(slot, bookingId, crewMemberId) {
    var body = new URLSearchParams();
    if (CSRF_TOKEN) body.append('_csrf', CSRF_TOKEN);
    fetch('/bookings/' + encodeURIComponent(bookingId) + '/crew/' + encodeURIComponent(crewMemberId) + '/remove', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-CSRF-Token': CSRF_TOKEN || '',
      },
      body: body,
      credentials: 'same-origin',
    }).then(function (r) { return r.json().catch(function () { return { ok: r.ok }; }); })
      .then(function (j) {
        closePopover();
        if (j && j.ok !== false) {
          // Drop the slot from the DOM and bump the empty placeholder back up.
          var parent = slot.parentNode;
          slot.parentNode.removeChild(slot);
          var empty = parent && parent.querySelector('.bk2-slot--empty.bk2-slot--drop');
          if (empty) {
            var remaining = (parseInt(empty.getAttribute('data-empty-count'), 10) || 0) + 1;
            empty.setAttribute('data-empty-count', remaining);
            var label = empty.querySelector('.bk2-slot-empty-label');
            var role = empty.getAttribute('data-role-on-site') || 'TC';
            if (label) {
              label.textContent = remaining === 1
                ? (role + ' slot · drop a worker here')
                : (remaining + ' more ' + role + ' slots · drop workers here');
            }
          }
          // Requirements may have shrunk server-side — refresh the glowing
          // card + Overview steppers so the counts track the removal.
          try { document.dispatchEvent(new CustomEvent('bk2:alloc-changed')); } catch (er) {}
        } else {
          alert((j && j.error) || 'Could not remove.');
        }
      }).catch(function () { alert('Could not remove — network error.'); });
  }

  // ==========================================================
  //  CREW SLOT DRAG — pick up a filled worker slot and drop it
  //  onto a vehicle (assign to that ute) or onto the
  //  "Unassigned" zone (clear assignment). Different MIME type
  //  from the resource-panel drag so the two drop handlers
  //  don't get confused.
  // ==========================================================
  document.addEventListener('dragstart', function (e) {
    var src = e.target && e.target.closest && e.target.closest('[data-bk-crew-drag="1"]');
    if (!src) return;
    var bookingCrewId = src.getAttribute('data-booking-crew-id');
    var bookingId     = src.getAttribute('data-booking-id');
    var crewName      = src.getAttribute('data-crew-name') || '';
    console.debug('[bk2 dragstart] crew', { bookingId: bookingId, bookingCrewId: bookingCrewId, name: crewName, src: src });
    if (!bookingCrewId || !bookingId) {
      console.warn('[bk2 dragstart] missing data-booking-crew-id or data-booking-id — aborting drag');
      return;
    }
    try {
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('application/x-bk2-crew-move', JSON.stringify({
        booking_id: bookingId,
        booking_crew_id: bookingCrewId,
        crew_name: crewName,
      }));
      e.dataTransfer.setData('text/plain', crewName);
    } catch (err) { console.warn('[bk2 dragstart] setData failed', err); }
    src.classList.add('is-dragging');
  });
  document.addEventListener('dragend', function (e) {
    var src = e.target && e.target.closest && e.target.closest('[data-bk-crew-drag="1"]');
    if (src) src.classList.remove('is-dragging');
  });

  // Dragover/drop for crew-move drags are handled by the consolidated
  // dispatcher above — every drop target shares the .bk2-slot--drop
  // class and the dispatcher branches on what data the dataTransfer
  // carries (crew-move vs vehicle vs person).

  function assignCrewToVehicle(payload, vehicleId) {
    var body = new URLSearchParams();
    if (vehicleId) body.append('vehicle_id', vehicleId);
    if (CSRF_TOKEN) body.append('_csrf', CSRF_TOKEN);
    var url = '/bookings/' + encodeURIComponent(payload.booking_id) + '/crew/' + encodeURIComponent(payload.booking_crew_id) + '/assign-vehicle';
    console.debug('[bk2 assignCrewToVehicle] POST', url, 'vehicle_id=' + vehicleId);
    fetch(url, {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded',
        'X-CSRF-Token': CSRF_TOKEN || '',
      },
      body: body,
      credentials: 'same-origin',
    }).then(function (r) {
      return r.text().then(function (text) {
        var json = null;
        try { json = JSON.parse(text); } catch (e) {}
        return { ok: r.ok, status: r.status, json: json, text: text };
      });
    })
      .then(function (result) {
        console.debug('[bk2 assignCrewToVehicle] response', result);
        if (!result.ok || !result.json || result.json.ok === false) {
          alert((result.json && result.json.error) || ('Could not move that worker (HTTP ' + result.status + ').'));
          return;
        }
        // Assigns relocate the slot in place (keeps scroll + editor state).
        // Unassigns re-render from server truth: the worker may land in a
        // standalone group (e.g. "Traffic Controller") OR the pool, and only
        // the server-side placement knows which.
        if (vehicleId) relocateCrewSlot(payload, vehicleId);
        else bk2RefreshCard(String(payload.booking_id));
        try { document.dispatchEvent(new CustomEvent('bk2:alloc-changed')); } catch (e) {}
      }).catch(function (err) {
        console.warn('[bk2 assignCrewToVehicle] fetch failed', err);
        alert('Could not move that worker — network error.');
      });
  }

  // Move a filled crew slot DOM node between containers (crew block ↔
  // unassigned pool) without reloading the page. Reconciles the empty
  // placeholder count on both sides + updates the worker's data attrs
  // + clears stale driver/flag state when leaving a vehicle.
  function relocateCrewSlot(payload, newVehicleId) {
    var bookingCrewId = String(payload.booking_crew_id);
    // Any case this in-place mover can't cleanly handle (worker moved onto a
    // standalone/spare vehicle chip, which lives outside a .bk2-crew block, or
    // a stale DOM) must NOT do a full page reload — that closes the quick-edit
    // editor and dumps the planner back on the board (the "glitched me back"
    // bug). Re-render just this card from server truth instead; the caller's
    // bk2:alloc-changed refreshes the glowing card + Resources tab.
    var bookingId = String(payload.booking_id);
    var slot = document.querySelector('.bk2-slot--filled[data-booking-crew-id="' + bookingCrewId + '"]');
    if (!slot) { console.warn('[bk2 relocate] slot not found, refreshing card in place'); bk2RefreshCard(bookingId); return; }

    var card = slot.closest('.bk2-card');
    if (!card) { bk2RefreshCard(bookingId); return; }

    var sourceBlock      = slot.closest('.bk2-crew');
    var sourceUnassigned = slot.closest('.bk2-unassigned');

    var destBlock = null;
    var destUnassigned = null;
    if (newVehicleId) {
      var destVehSlot = card.querySelector('.bk2-veh-slot.bk2-slot--drop-veh-assign[data-vehicle-id="' + String(newVehicleId) + '"]');
      destBlock = destVehSlot ? destVehSlot.closest('.bk2-crew') : null;
    } else {
      destUnassigned = card.querySelector('.bk2-unassigned');
    }
    // Destination is a standalone/spare vehicle chip (not inside a crew block)
    // or otherwise not a place we can splice into — re-render the card from
    // server truth (which already has the new assigned_vehicle_id) rather than
    // reloading the whole page and closing the editor.
    if (!destBlock && !destUnassigned) { bk2RefreshCard(bookingId); return; }

    // ── Detach the slot from its current parent ─────────────────
    var parentBefore = slot.parentNode;
    slot.remove();

    // ── Update slot data + classes ──────────────────────────────
    if (newVehicleId) {
      slot.setAttribute('data-assigned-vehicle-id', String(newVehicleId));
      slot.classList.remove('bk2-slot--unassigned');
    } else {
      slot.setAttribute('data-assigned-vehicle-id', '');
      slot.classList.add('bk2-slot--unassigned');
    }
    // Always clear driver state — the server cleared the dangling
    // booking_vehicles.crew_member_id pointer, so the DRV pill no
    // longer applies after a move. The planner can re-tag via the
    // popover if needed.
    slot.classList.remove('is-driver');
    slot.setAttribute('data-flag-driver', '0');
    var drvPill = slot.querySelector('.bk2-flag--drv');
    if (drvPill) drvPill.remove();

    // ── Insert into destination ─────────────────────────────────
    if (destBlock) {
      var emptyPh = destBlock.querySelector('.bk2-slot--empty.bk2-slot--drop');
      var addons  = destBlock.querySelector('.bk2-addons');
      var anchor  = emptyPh || addons || null;
      if (anchor) destBlock.insertBefore(slot, anchor);
      else        destBlock.appendChild(slot);
      // Decrement empty placeholder in destination (if any)
      if (emptyPh) {
        var c = (parseInt(emptyPh.getAttribute('data-empty-count'), 10) || 0) - 1;
        if (c <= 0) {
          emptyPh.remove();
        } else {
          emptyPh.setAttribute('data-empty-count', c);
          relabelEmptyPlaceholder(emptyPh, c);
        }
      }
    } else if (destUnassigned) {
      destUnassigned.appendChild(slot);
      var destHead = destUnassigned.querySelector('.bk2-unassigned-head span');
      if (destHead) destHead.textContent = 'Not in any vehicle';
    }

    // ── Reconcile source ────────────────────────────────────────
    // If the source was a crew block, add or bump an empty placeholder
    // to reflect the now-vacant slot. (If the source was the unassigned
    // pool, just update its header if it's now empty.)
    if (sourceBlock && sourceBlock !== destBlock) {
      var srcEmpty = sourceBlock.querySelector('.bk2-slot--empty.bk2-slot--drop');
      if (srcEmpty) {
        var nc = (parseInt(srcEmpty.getAttribute('data-empty-count'), 10) || 0) + 1;
        srcEmpty.setAttribute('data-empty-count', nc);
        relabelEmptyPlaceholder(srcEmpty, nc);
      } else {
        // Build a fresh placeholder. Recover role + booking_id +
        // ordinal from the surrounding DOM.
        var bookingId = card.getAttribute('data-booking-id') || '';
        var role = 'TC';
        var sizeChip = sourceBlock.querySelector('.bk2-crew-size');
        if (sizeChip) {
          var m = sizeChip.textContent.match(/·\s*(\S+)/);
          if (m) role = m[1].trim();
        }
        var ordinal = '';
        var lbl = sourceBlock.querySelector('.bk2-crew-label');
        if (lbl) { var n = lbl.textContent.match(/(\d+)/); if (n) ordinal = n[1]; }
        var newPh = document.createElement('div');
        newPh.className = 'bk2-slot bk2-slot--empty bk2-slot--drop';
        newPh.setAttribute('data-booking-id', bookingId);
        newPh.setAttribute('data-role-on-site', role);
        newPh.setAttribute('data-crew-ordinal', ordinal);
        newPh.setAttribute('data-empty-count', '1');
        newPh.innerHTML =
          '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="opacity:0.6">' +
            '<path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3M6 11a4 4 0 11-4 4 4 4 0 014-4zM14 16a6 6 0 00-12 0v2h12v-2z"/>' +
          '</svg>' +
          '<span class="bk2-slot-empty-label">' + role + ' slot · drop a worker here</span>';
        var srcAddons = sourceBlock.querySelector('.bk2-addons');
        if (srcAddons) sourceBlock.insertBefore(newPh, srcAddons);
        else           sourceBlock.appendChild(newPh);
      }
    }
    if (sourceUnassigned && sourceUnassigned !== destUnassigned) {
      var stillThere = sourceUnassigned.querySelectorAll('[data-bk-crew-drag="1"]').length;
      var srcHead = sourceUnassigned.querySelector('.bk2-unassigned-head span');
      if (srcHead && stillThere === 0) srcHead.textContent = 'Drop here to take off the ute';
    }

    // ── Flourish ────────────────────────────────────────────────
    slot.classList.add('bk2-slot--just-added');
    setTimeout(function () { slot.classList.remove('bk2-slot--just-added'); }, 600);
    flashAssigned(slot.getAttribute('data-crew-member-id'));
  }

  // Update the "N more TC slots · drop workers here" / "TC slot · drop
  // a worker here" label on an empty placeholder based on its remaining
  // count.
  function relabelEmptyPlaceholder(ph, count) {
    var label = ph.querySelector('.bk2-slot-empty-label');
    if (!label) return;
    var role = ph.getAttribute('data-role-on-site') || 'TC';
    label.textContent = count === 1
      ? (role + ' slot · drop a worker here')
      : (count + ' more ' + role + ' slots · drop workers here');
  }

  // ==========================================================
  //  AJAX DATE NAVIGATION — flip between days without doing a
  //  full page reload. Intercepts:
  //    · prev / next anchors in .bk2-daynav and .bk2-fs-chip--date
  //    · the .bk2-daynav-today shortcut
  //    · the date <input> in .bk2-daynav (change event)
  //  Fetches the same /bookings URL, parses the response and
  //  swaps the date-affected sections in place (day label, the
  //  board pane, list pane, date chip + nav). pushState keeps
  //  the URL in sync so back/forward still work.
  // ==========================================================
  (function () {
    var navInFlight = false;

    function isDateLink(a) {
      if (!a || a.tagName !== 'A') return false;
      var href = a.getAttribute('href') || '';
      if (!/^\/bookings(\?|$)/.test(href)) return false;
      // Only intercept links that change the date — date= param, or
      // the bare /bookings (Today shortcut).
      return /[?&]date=/.test(href) || href === '/bookings' || href === '/bookings?';
    }

    function buildTargetUrl(href) {
      var url = new URL(href, window.location.origin);
      // Preserve other query params already on the page (status,
      // depot, search, etc.) so navigating dates doesn't reset
      // filters. New `date` from the link wins.
      var current = new URL(window.location.href);
      current.searchParams.forEach(function (val, key) {
        if (key === 'date') return; // overridden by the link
        if (!url.searchParams.has(key)) url.searchParams.set(key, val);
      });
      return url;
    }

    function swapBlock(currentRoot, freshRoot, selector) {
      var oldEl = currentRoot.querySelector(selector);
      var newEl = freshRoot.querySelector(selector);
      if (!oldEl || !newEl) return;
      oldEl.replaceWith(newEl);
    }

    function applyResponseDoc(doc) {
      // Day label + count (the <p class="bk2-daylabel">).
      swapBlock(document, doc, '.bk2-daylabel');
      // Filter strip date chip — also carries prev/next hrefs.
      swapBlock(document, doc, '.bk2-fs-chip--date');
      // Header day-nav block (prev arrow + input + next + Today).
      swapBlock(document, doc, '.bk2-daynav');
      // The four view panes (board / list / calendar / map) — the
      // calendar and map don't strictly need the swap, but keeping
      // them in sync means alt views match the day too.
      swapBlock(document, doc, '[data-view-pane="board"]');
      swapBlock(document, doc, '[data-view-pane="list"]');
      swapBlock(document, doc, '[data-view-pane="map"]');
      // After replacement, re-fire view-pane visibility for the
      // currently selected view tab (the swap might have reset
      // aria-current). The existing view-tab JS toggles
      // aria-current="true" on the active pane; mirror that here.
      var activeTab = document.querySelector('.bk2-view-tab[aria-selected="true"]');
      if (activeTab) {
        var which = activeTab.getAttribute('data-view-tab');
        document.querySelectorAll('.bk2-pane').forEach(function (p) {
          p.setAttribute('aria-current', p.getAttribute('data-view-pane') === which ? 'true' : 'false');
        });
      }
      // Re-wire the "+ New" button on the empty state (gets replaced
      // along with the board pane and loses its listener).
      var emptyNew = document.getElementById('bk2-empty-new');
      if (emptyNew && !emptyNew.dataset.bound) {
        emptyNew.dataset.bound = '1';
        emptyNew.addEventListener('click', function (e) {
          // Defer to the existing global handler — easiest is firing
          // a click on the main "New booking" button which IS still
          // bound from the initial page load.
          e.preventDefault();
          var newBtn = document.getElementById('bk2-new-btn');
          if (newBtn) newBtn.click();
        });
      }
      // The swapped-in board is a fresh element with no density class — the
      // toggle is applied by JS, so re-apply it or old dates flash the big
      // (comfortable) layout until a hard refresh.
      try { if (window.bk2ApplyDensity) window.bk2ApplyDensity(); } catch (e) {}
    }

    // Expose a soft board refresh (re-fetch current URL, swap panes) so the
    // editor can show a freshly-created booking on close without a full reload.
    window.bk2RefreshBoard = function () {
      // Returns the fetch promise so callers can sequence work off a completed
      // board re-render (e.g. floating a freshly-created booking's card).
      return fetch(location.href, { credentials: 'same-origin', headers: { 'Accept': 'text/html', 'X-Requested-With': 'fetch' } })
        .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
        .then(function (html) { applyResponseDoc(new DOMParser().parseFromString(html, 'text/html')); })
        .catch(function () { location.reload(); });
    };

    function navigateToDate(href) {
      if (navInFlight) return;
      navInFlight = true;
      var url = buildTargetUrl(href);
      document.body.classList.add('bk2-date-loading');
      fetch(url.toString(), {
        credentials: 'same-origin',
        headers: { 'Accept': 'text/html', 'X-Requested-With': 'fetch' },
      }).then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.text();
      }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        applyResponseDoc(doc);
        // Keep BK2_DATA.dateStr in sync so the slide-over prefill,
        // resource panel date filter, etc. read the day the planner
        // is currently looking at instead of the initial page load.
        var newDate = url.searchParams.get('date');
        if (!newDate) {
          // /bookings with no ?date= = "Today" shortcut. Mirror the
          // server default (Sydney today).
          newDate = new Intl.DateTimeFormat('en-CA', { timeZone: 'Australia/Sydney' }).format(new Date());
        }
        if (window.BK2_DATA) window.BK2_DATA.dateStr = newDate;
        // Re-hydrate the resource panel for the day we just moved to — it
        // shows availability + "assigned today" against the viewed date.
        if (typeof window.bk2ReloadResources === 'function') window.bk2ReloadResources(newDate);
        try { history.pushState({ bkDate: true }, '', url.toString()); } catch (e) {}
      }).catch(function (err) {
        // On failure, fall back to a full navigation so the planner
        // still gets to the new date.
        window.location.href = url.toString();
      }).finally(function () {
        document.body.classList.remove('bk2-date-loading');
        navInFlight = false;
      });
    }

    // Delegated click: catch all date-changing anchors anywhere on
    // the page, including ones that were swapped in by a previous
    // AJAX navigation.
    document.addEventListener('click', function (e) {
      // Modifier clicks open a new tab — let the browser handle it.
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      var a = e.target.closest && e.target.closest('a');
      if (!a || !isDateLink(a)) return;
      // Skip anchors that explicitly opt out (none today, but defensive).
      if (a.target && a.target !== '' && a.target !== '_self') return;
      e.preventDefault();
      navigateToDate(a.getAttribute('href') || '/bookings');
    });

    // Date <input> in the day-nav — fires `change` when user picks a
    // new date. Intercept before the surrounding <form> submits.
    document.addEventListener('change', function (e) {
      var input = e.target;
      if (!input || input.tagName !== 'INPUT' || input.type !== 'date') return;
      if (!input.closest || !input.closest('.bk2-daynav')) return;
      e.preventDefault();
      if (input.form) {
        // Stop the implicit form submit baked into the inline onchange.
        input.form.setAttribute('onsubmit', 'return false');
      }
      navigateToDate('/bookings?date=' + encodeURIComponent(input.value));
    }, true);

    // Browser back / forward — re-fetch the URL the same way so the
    // planner can step through dates with the back button.
    window.addEventListener('popstate', function () {
      navigateToDate(window.location.pathname + window.location.search);
    });
  })();
})();
</script>

<style>
  /* Drag-drop visual states — slot lights up brand-blue when a
     worker row is over it, dims while the assign request is in
     flight, and the source row gets a subtle ghost effect. */
  .bk2-rp-item.is-dragging { opacity: 0.5; }
  .bk2-slot--drop { transition: border-color 120ms ease, background 120ms ease, color 120ms ease; }
  .bk2-slot--drop.is-drag-over {
    border-color: #2B7FFF !important;
    background: rgba(43,127,255,0.10) !important;
    color: #2B7FFF !important;
  }
  .bk2-slot--drop.is-saving {
    opacity: 0.55;
    cursor: progress;
  }
  :root[data-theme="light"] body.dark-glass .bk2-slot--drop.is-drag-over {
    background: #EFF6FF !important;
    border-color: #2B7FFF !important;
    color: #1D4ED8 !important;
  }
  /* Just-added slot — short fade-up + soft ring so the planner can
     see the new allocation land on the card without a page reload. */
  .bk2-slot--just-added { animation: bk2SlotIn 320ms cubic-bezier(0.16,1,0.3,1); }
  @keyframes bk2SlotIn {
    0%   { transform: translateY(-4px); opacity: 0; box-shadow: 0 0 0 0 rgba(43,127,255,0.0); }
    60%  { transform: translateY(0);    opacity: 1; box-shadow: 0 0 0 4px rgba(43,127,255,0.18); }
    100% { transform: translateY(0);    opacity: 1; box-shadow: 0 0 0 0 rgba(43,127,255,0.0); }
  }
  /* Resource-panel row pulse confirming the assign request landed. */
  .bk2-rp-item.is-just-assigned { animation: bk2RpFlash 1400ms ease-out; }
  @keyframes bk2RpFlash {
    0%, 30% { background: rgba(34,197,94,0.18); }
    100%    { background: transparent; }
  }

  /* "Back to board" landing: scroll to + flash the card the planner was on. */
  @keyframes bk2FocusPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(29,106,229,0); }
    30%      { box-shadow: 0 0 0 3px rgba(29,106,229,0.7); }
  }
  .bk2-card.bk2-focus-flash { animation: bk2FocusPulse 1.5s ease-in-out 2; }
</style>

<script>
(function () {
  // Arriving from a booking's edit/overview page via "Back to board": the URL
  // carries ?date=<that day> (already handled server-side) plus #booking-<id>.
  // Scroll that card into view and flash it so the planner lands exactly where
  // they left off instead of at the top of today's board.
  function focusBookingFromHash() {
    var m = (location.hash || '').match(/^#booking-(\d+)$/);
    if (!m) return;
    var card = document.querySelector('.bk2-card[data-booking-id="' + m[1] + '"]');
    if (!card) return;
    try { card.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' }); }
    catch (e) { card.scrollIntoView(); }
    card.classList.add('bk2-focus-flash');
    setTimeout(function () { card.classList.remove('bk2-focus-flash'); }, 3400);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', focusBookingFromHash);
  else focusBookingFromHash();
})();
</script>
