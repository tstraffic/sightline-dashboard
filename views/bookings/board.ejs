        row.className = 'bk-addr-row';
        row.style.cssText = 'padding:9px 12px;font-size:13px;cursor:pointer;border-bottom:1px solid #F3F4F6';
        row.innerHTML =
            '<div style="font-weight:600;color:#111827;pointer-events:none">' + esc(head) + '</div>'
          + '<div style="color:#6B7280;font-size:11.5px;margin-top:2px;pointer-events:none">' + esc(sub || formatted) + '</div>';
