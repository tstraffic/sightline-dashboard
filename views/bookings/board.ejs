  function row(lbl, val) {
    return '<div class="bk2-row"><span class="lbl">' + lbl + '</span><span class="val">' + val + '</span></div>';
  }
  function editableRow(lbl, field, val, multiline) {
    var input = multiline
      ? '<textarea data-edit-field="' + field + '" rows="2" style="width:100%;background:transparent;border:1px dashed transparent;border-radius:4px;padding:3px 6px;font-size:13px;color:#111827;resize:vertical">' + esc(val) + '</textarea>'
      : '<input data-edit-field="' + field + '" value="' + esc(val) + '" style="width:100%;background:transparent;border:1px dashed transparent;border-radius:4px;padding:3px 6px;font-size:13px;color:#111827">';
    return '<div class="bk2-row"><span class="lbl">' + lbl + '</span><span class="val">' + input + '</span></div>';
  }
  function wireCrewsTab(d) {
    function post(url) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf },
        credentials: 'same-origin',
      }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, json: j }; }); });
    }
    soBody.querySelectorAll('[data-crew-confirm]').forEach(function (b) {
      b.addEventListener('click', function () {
        post('/bookings/' + d.id + '/crew/' + b.dataset.crewConfirm + '/confirm').then(function (res) {
          if (!res.ok) return toast('Confirm failed', false);
          toast('Confirmed');
          refreshAfter(d);
        });
      });
    });
    soBody.querySelectorAll('[data-crew-remove]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!confirm('Remove this crew member from the booking?')) return;
        post('/bookings/' + d.id + '/crew/' + b.dataset.crewRemove + '/remove').then(function (res) {
          if (!res.ok) return toast('Remove failed', false);
          toast('Removed');
          refreshAfter(d);
        });
      });
    });
    soBody.querySelectorAll('[data-vehicle-remove]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!confirm('Remove this vehicle?')) return;
        post('/bookings/' + d.id + '/vehicles/' + b.dataset.vehicleRemove + '/remove').then(function (res) {
          if (!res.ok) return toast('Remove failed', false);
          toast('Removed');
          refreshAfter(d);
        });
      });
    });
    soBody.querySelectorAll('[data-eq-remove]').forEach(function (b) {
      b.addEventListener('click', function () {
        if (!confirm('Remove this equipment?')) return;
        post('/bookings/' + d.id + '/equipment/' + b.dataset.eqRemove + '/remove').then(function (res) {
          if (!res.ok) return toast('Remove failed', false);
          toast('Removed');
          refreshAfter(d);
        });
      });
    });
  }
  function refreshAfter(d) {
    fetch('/bookings/' + d.id, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (fresh) { soState.data = fresh; try { renderTab(soState.activeTab); } catch (e) { console.error('[bookings] renderTab in refreshAfter:', e); } })
      .catch(function (e) { console.error('[bookings] refreshAfter fetch failed:', e); });
    var card = document.querySelector('.bk2-card[data-booking-id="' + d.id + '"]');
    if (card) refreshCard(card, d.id);
  }

  function wireDetailEdits(d) {
    // Hover hint that inputs are editable
    soBody.querySelectorAll('[data-edit-field]').forEach(function (el) {
      el.addEventListener('focus', function () { el.style.borderColor = '#93c5fd'; });
      el.addEventListener('blur',  function () {
        el.style.borderColor = 'transparent';
        var field = el.dataset.editField;
        var newVal = el.value;
        if (newVal === (d[field] || '')) return;
        // Patch via the existing POST /:id which accepts the full booking body.
        // We send just the changed field — server merges into the row.
        var body = new URLSearchParams();
        body.append(field, newVal);
        // Send start_date / start_time / end_date / end_time / title to satisfy
        // the POST /:id validators
        if (d.start_datetime) {
          body.append('start_date', d.start_datetime.substring(0,10));
          body.append('start_time', d.start_datetime.substring(11,16));
        }
        if (d.end_datetime) {
          body.append('end_date', d.end_datetime.substring(0,10));
          body.append('end_time', d.end_datetime.substring(11,16));
        }
        if (field !== 'title') body.append('title', d.title || '');
        fetch('/bookings/' + d.id, {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf },
          credentials: 'same-origin',
          body: body.toString(),
        }).then(function (r) {
          if (r.ok) {
            d[field] = newVal;
            var saved = $('#bk2-edit-saved'); if (saved) { saved.style.display = 'block'; setTimeout(function () { saved.style.display = 'none'; }, 1600); }
            // Refresh the matching card
            var card = document.querySelector('.bk2-card[data-booking-id="' + d.id + '"]');
            if (card) refreshCard(card, d.id);
          } else { toast('Save failed', false); }
        }).catch(function () { toast('Save failed', false); });
      });
    });
    // Status select inline change
    var statusSel = $('#bk2-edit-status');
    if (statusSel) {
      statusSel.addEventListener('change', function () {
        var next = statusSel.value;
        var body = new URLSearchParams({ status: next }).toString();
        fetch('/bookings/' + d.id + '/status', {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf },
          credentials: 'same-origin',
          body: body,
        }).then(function (r) { return r.json(); }).then(function (j) {
          if (j && j.ok) {
            d.status = next;
            statusSel.className = 'bk2-status-pill bk2-status--' + next;
            soStatusPill.textContent = statusLabel(next);
            soStatusPill.className = 'bk2-status-pill bk2-status--' + next;
            var card = document.querySelector('.bk2-card[data-booking-id="' + d.id + '"]');
            if (card) refreshCard(card, d.id);
            toast('Status: ' + statusLabel(next));
          } else { toast('Status change failed', false); }
        }).catch(function () { toast('Status change failed', false); });
      });
    }
  }

  // ---------- Toast ----------
  function toast(msg, ok) {
    var t = document.createElement('div');
    t.className = 'bk2-toast';
    t.textContent = msg;
    if (ok === false) t.style.background = '#DC2626';
    document.body.appendChild(t);
    requestAnimationFrame(function () { t.classList.add('bk2-show'); });
    setTimeout(function () { t.classList.remove('bk2-show'); setTimeout(function () { t.remove(); }, 250); }, 2200);
  }

  // ---------- Card clicks — full-page navigate, not slide-over ----------
  // The view-mode slide-over caused stuck "Loading…" states. Cards now
  // go straight to /bookings/:id which is bulletproof. The slide-over
  // stays only for Quick Book (create) since that doesn't fetch and
  // can't get stuck.
  document.addEventListener('click', function (e) {
    var card = e.target.closest('.bk2-card');
    if (card) {
      var id = card.dataset.bookingId;
      var tabBtn = e.target.closest('[data-open-tab]');
      var hash = tabBtn ? '#' + tabBtn.dataset.openTab : '';
      location.href = '/bookings/' + id + hash;
      return;
    }
    var row = e.target.closest('.bk2-list tbody tr[data-booking-id]');
    if (row) { location.href = '/bookings/' + row.dataset.bookingId; }
  });

  // ---------- + New booking ----------
  $('#bk2-new-btn').addEventListener('click', openCreate);
  var emptyNew = $('#bk2-empty-new');
  if (emptyNew) emptyNew.addEventListener('click', openCreate);

  // ---------- Card selection + keyboard nav ----------
  var selectedIdx = -1;
  function cards() { return $$('#bk2-board-list .bk2-card'); }
  function selectCard(i) {
    var arr = cards();
    if (!arr.length) return;
    if (i < 0) i = 0;
    if (i >= arr.length) i = arr.length - 1;
    arr.forEach(function (c, k) { c.dataset.selected = (k === i ? 'true' : 'false'); });
    arr[i].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    selectedIdx = i;
  }

  // ---------- Keyboard shortcuts ----------
  document.addEventListener('keydown', function (e) {
    var inField = e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName);
    // Save inside slide-over
    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
      if (so.classList.contains('bk2-open') && soState.mode === 'create') {
        e.preventDefault();
        var f = $('#bk2-quickbook-form'); f && f.requestSubmit();
      }
      return;
    }
    // Esc closes slide-over
    if (e.key === 'Escape' && so.classList.contains('bk2-open')) {
      e.preventDefault(); closeSlideover(); return;
    }
    if (inField) return;
    if (e.key === 'n' || e.key === 'N') { e.preventDefault(); openCreate(); return; }
    if (e.key === '/') {
      e.preventDefault();
      // Open the filter dropdown's search field
      var filterPanel = document.querySelector('.bk2-chip-add');
      if (filterPanel) {
        filterPanel.open = true;
        var s = filterPanel.querySelector('input[name="q"]');
        s && s.focus();
      }
      return;
    }
    if (e.key === 'j' || e.key === 'ArrowDown') { e.preventDefault(); selectCard(selectedIdx + 1); return; }
    if (e.key === 'k' || e.key === 'ArrowUp') { e.preventDefault(); selectCard(selectedIdx - 1); return; }
    if (e.key === 'Enter' && selectedIdx >= 0) {
      var arr = cards();
      if (arr[selectedIdx]) { e.preventDefault(); location.href = '/bookings/' + arr[selectedIdx].dataset.bookingId; }
      return;
    }
    if ((e.key === 'e' || e.key === 'E') && selectedIdx >= 0) {
      var arr2 = cards();
      if (arr2[selectedIdx]) { e.preventDefault(); location.href = '/bookings/' + arr2[selectedIdx].dataset.bookingId + '/edit'; }
      return;
    }
  });

  // ============================================================
  //  RESOURCE PANEL (Phase 3)
  //  Loads people / vehicles / equipment, draggable onto card slots.
  // ============================================================
  var rPanel = $('#bk2-resource-panel');
  var rToggle = $('#bk2-resource-toggle');
  var rClose = $('#bk2-resource-close');
  var rBody = $('#bk2-resource-body');
  var rSearch = $('#bk2-resource-search');
  var rFilters = $('#bk2-resource-filters');
  var resourceState = { open: false, tab: 'people', data: null, q: '', activeFilters: new Set() };

  function openResources() {
    resourceState.open = true;
    rPanel.classList.add('bk2-open');
    if (!resourceState.data) fetchResources();
  }
  function closeResources() {
    resourceState.open = false;
    rPanel.classList.remove('bk2-open');
  }
  rToggle && rToggle.addEventListener('click', function () { resourceState.open ? closeResources() : openResources(); });
  rClose && rClose.addEventListener('click', closeResources);

  function fetchResources() {
    rBody.innerHTML = '<p style="color:#9CA3AF;font-size:12px;text-align:center;padding:24px 0">Loading…</p>';
    fetch('/bookings/api/resources?date=' + encodeURIComponent(window.BK2_DATA.dateStr), { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (data) { resourceState.data = data; renderResources(); })
      .catch(function () { rBody.innerHTML = '<p style="color:#DC2626;font-size:12px;text-align:center;padding:24px 0">Failed to load resources.</p>'; });
  }

  $$('.bk2-resource-tab').forEach(function (t) {
    t.addEventListener('click', function () {
      resourceState.tab = t.dataset.rtab;
      resourceState.activeFilters.clear();
      $$('.bk2-resource-tab').forEach(function (x) { x.setAttribute('aria-selected', x === t ? 'true' : 'false'); });
      renderResources();
    });
  });
  rSearch && rSearch.addEventListener('input', function () { resourceState.q = rSearch.value.toLowerCase().trim(); renderResources(); });

  var PEOPLE_FILTERS = [
    { key: 'unassigned',  label: 'Unassigned' },
    { key: 'reserved',    label: 'Reserved' },
    { key: 'tls',         label: 'TLs only' },
    { key: 'first_aid',   label: 'First aid' },
    { key: 'tow',         label: 'Can tow' },
  ];
  var VEHICLE_FILTERS = [
    { key: 'ute',         label: 'Utes' },
    { key: 'truck',       label: 'Trucks' },
    { key: 'vms',         label: 'VMS' },
  ];
  var EQUIPMENT_FILTERS = [
    { key: 'sign',        label: 'Signs' },
    { key: 'lighting',    label: 'Lighting' },
    { key: 'arrow_board', label: 'Arrow boards' },
    { key: 'vms',         label: 'VMS' },
  ];

  function renderResources() {
    if (!resourceState.data) return;
    // Build filter chips for the current tab
    var filters = resourceState.tab === 'people' ? PEOPLE_FILTERS : resourceState.tab === 'vehicles' ? VEHICLE_FILTERS : EQUIPMENT_FILTERS;
    rFilters.innerHTML = filters.map(function (f) {
      return '<button type="button" class="bk2-resource-filter" data-fk="' + f.key + '" aria-pressed="' + (resourceState.activeFilters.has(f.key) ? 'true' : 'false') + '">' + esc(f.label) + '</button>';
    }).join('');
    rFilters.querySelectorAll('.bk2-resource-filter').forEach(function (b) {
      b.addEventListener('click', function () {
        if (resourceState.activeFilters.has(b.dataset.fk)) resourceState.activeFilters.delete(b.dataset.fk);
        else resourceState.activeFilters.add(b.dataset.fk);
        renderResources();
      });
    });

    var items = [];
    if (resourceState.tab === 'people') {
      items = (resourceState.data.people || []).filter(filterPerson).map(function (p) {
        var warns = (p.warnings || []).filter(function (w) { return w !== 'on_leave'; });
        return resourceItem(p.id, 'person', p.full_name, (p.tcp_level ? 'L' + p.tcp_level + ' · ' : '') + (p.role || '').replace(/_/g, ' ') + (warns.length ? ' · ⚠' : ''));
      });
    } else if (resourceState.tab === 'vehicles') {
      items = (resourceState.data.vehicles || []).filter(filterVehicle).map(function (v) {
        return resourceItem(v.id, 'vehicle', v.name, (v.licence_plate || v.asset_number || v.category || '').toUpperCase());
      });
    } else {
      items = (resourceState.data.equipment || []).filter(filterEquipment).map(function (e) {
        return resourceItem(e.id, 'equipment', e.name, (e.category || '').replace(/_/g, ' '));
      });
    }
    rBody.innerHTML = items.length ? items.join('') : '<p style="color:#9CA3AF;font-size:12px;text-align:center;padding:24px 0">No matches.</p>';
    rBody.querySelectorAll('.bk2-resource-item').forEach(wireResourceDrag);
  }
  function resourceItem(id, type, name, meta) {
    return '<div class="bk2-resource-item" draggable="true" data-rtype="' + type + '" data-rid="' + id + '" data-rname="' + esc(name) + '">' +
      '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:#9CA3AF;flex-shrink:0">' +
      (type === 'person' ? '<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>'
        : type === 'vehicle' ? '<path stroke-linecap="round" stroke-linejoin="round" d="M3 13l2-4h14l2 4M5 17h14M5 17a2 2 0 11-4 0 2 2 0 014 0zm14 0a2 2 0 11-4 0 2 2 0 014 0z"/>'
        : '<path stroke-linecap="round" stroke-linejoin="round" d="M5 8a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H7a2 2 0 01-2-2V8z"/>') +
      '</svg>' +
      '<div style="flex:1;min-width:0"><div style="font-weight:600;color:#111827;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + esc(name) + '</div>' +
      '<div class="bk2-resource-item-meta">' + esc(meta) + '</div></div></div>';
  }
  function filterPerson(p) {
    var q = resourceState.q;
    if (q && !(p.full_name + ' ' + (p.role || '') + ' ' + (p.employee_id || '')).toLowerCase().includes(q)) return false;
    if (resourceState.activeFilters.has('unassigned') && p.assigned_today) return false;
    if (resourceState.activeFilters.has('reserved') && p.employment_status !== 'reserved') return false;
    if (resourceState.activeFilters.has('tls') && !((p.portal_role || p.role || '').includes('team') || (p.portal_role || p.role || '').includes('lead'))) return false;
    if (resourceState.activeFilters.has('first_aid') && !p.first_aid) return false;
    return true;
  }
  function filterVehicle(v) {
    var q = resourceState.q;
    if (q && !((v.name + ' ' + (v.licence_plate || '') + ' ' + (v.asset_number || '')).toLowerCase().includes(q))) return false;
    var n = (v.name || '').toLowerCase();
    if (resourceState.activeFilters.has('ute') && !n.includes('ute')) return false;
    if (resourceState.activeFilters.has('truck') && !n.includes('truck') && !n.includes('pod')) return false;
    if (resourceState.activeFilters.has('vms') && !n.includes('vms') && v.category !== 'vms') return false;
    return true;
  }
  function filterEquipment(e) {
    var q = resourceState.q;
    if (q && !((e.name + ' ' + (e.category || '')).toLowerCase().includes(q))) return false;
    var any = resourceState.activeFilters.size > 0;
    if (any && !resourceState.activeFilters.has(e.category)) return false;
    return true;
  }

  // ---------- Drag from panel onto card slots ----------
  var currentDrag = null;
  function wireResourceDrag(el) {
    el.addEventListener('dragstart', function (e) {
      currentDrag = { type: el.dataset.rtype, id: el.dataset.rid, name: el.dataset.rname };
      el.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'copy';
      e.dataTransfer.setData('text/plain', JSON.stringify(currentDrag));
    });
    el.addEventListener('dragend', function () { el.classList.remove('dragging'); currentDrag = null; clearAllDropHints(); });
  }
  function clearAllDropHints() {
    $$('.bk2-drop-ok').forEach(function (el) { el.classList.remove('bk2-drop-ok'); });
    $$('.bk2-drop-bad').forEach(function (el) { el.classList.remove('bk2-drop-bad'); });
  }
  // Mark every card's slots as drop targets.
  function isCompatible(slot) {
    if (!currentDrag) return false;
    if (slot.classList.contains('bk2-slot--empty')) return currentDrag.type === 'person';
    if (slot.classList.contains('bk2-veh-slot--empty')) return currentDrag.type === 'vehicle';
    if (slot.classList.contains('bk2-crew')) return currentDrag.type === 'equipment';
    return false;
  }
  document.addEventListener('dragover', function (e) {
    var slot = e.target.closest('.bk2-slot--empty, .bk2-veh-slot--empty, .bk2-crew');
    if (!slot || !currentDrag) return;
    e.preventDefault();
    if (isCompatible(slot)) { slot.classList.add('bk2-drop-ok'); slot.classList.remove('bk2-drop-bad'); }
    else { slot.classList.add('bk2-drop-bad'); }
  });
  document.addEventListener('dragleave', function (e) {
    var slot = e.target.closest('.bk2-slot--empty, .bk2-veh-slot--empty, .bk2-crew');
    if (slot) { slot.classList.remove('bk2-drop-ok'); slot.classList.remove('bk2-drop-bad'); }
  });
  document.addEventListener('drop', function (e) {
    var slot = e.target.closest('.bk2-slot--empty, .bk2-veh-slot--empty, .bk2-crew');
    if (!slot || !currentDrag || !isCompatible(slot)) { clearAllDropHints(); return; }
    e.preventDefault();
    var card = slot.closest('.bk2-card');
    if (!card) return;
    var bookingId = card.dataset.bookingId;
    var drag = currentDrag;
    clearAllDropHints();
    handleResourceDrop(bookingId, slot, drag).then(function () { refreshCard(card, bookingId); });
  });

  function handleResourceDrop(bookingId, slot, drag) {
    var body, url;
    if (drag.type === 'person') {
      body = new URLSearchParams({ crew_member_id: drag.id, role_on_site: '' }).toString();
      url = '/bookings/' + bookingId + '/crew';
    } else if (drag.type === 'vehicle') {
      body = new URLSearchParams({ equipment_id: drag.id, vehicle_role: 'ute', upgrade_placeholder: '1' }).toString();
      url = '/bookings/' + bookingId + '/vehicles';
    } else if (drag.type === 'equipment') {
      body = new URLSearchParams({ equipment_id: drag.id }).toString();
      url = '/bookings/' + bookingId + '/equipment';
    }
    return fetch(url, {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf },
      credentials: 'same-origin',
      body: body,
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, json: j }; }); })
      .then(function (res) {
        if (!res.ok) { toast(res.json.error || 'Drop failed', false); return; }
        toast('Added ' + drag.name);
      })
      .catch(function (err) { toast(err.message, false); });
  }

  // Re-render one card after a drop without reloading the page.
  function refreshCard(card, bookingId) {
    // Pull a fresh copy of just this booking from the board endpoint.
    var u = new URL(location.href);
    u.searchParams.set('partial', '1');
    fetch(u.toString(), { headers: { 'Accept': 'text/html' } })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var fresh = doc.querySelector('.bk2-card[data-booking-id="' + bookingId + '"]');
        if (fresh) {
          card.replaceWith(fresh);
        } else {
          // Fall back to refetching just the JSON detail and patching slots.
          // (Card might have moved status — re-render the whole board.)
          location.reload();
        }
      })
      .catch(function () { location.reload(); });
  }

  // 'R' opens the resource panel
  document.addEventListener('keydown', function (e) {
    var inField = e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName);
    if (inField || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'r' || e.key === 'R') { e.preventDefault(); resourceState.open ? closeResources() : openResources(); }
  });

  // ---------- popstate (back/forward) ----------
  // Slide-over only handles Quick Book create now. View pages live at
  // /bookings/:id (full page), so Back/Forward there is the browser's
  // normal navigation — nothing for us to wire here beyond toggling
  // create mode on/off.
  window.addEventListener('popstate', function () {
    var u = new URL(location.href);
    var b = u.searchParams.get('b');
    var v = u.searchParams.get('view') || 'board';
    if (v !== getCurrentView()) setView(v);
    if (b === 'new') {
      if (soState.mode !== 'create') openCreate();
    } else if (so.classList.contains('bk2-open')) {
      closeSlideover();
    }
  });
  function getCurrentView() {
    var sel = document.querySelector('.bk2-view-tab[aria-selected="true"]');
    return sel ? sel.dataset.viewTab : 'board';
  }

  // ---------- Map init (lazy, when map tab is shown) ----------
  var mapInited = false;
  function initMap() {
    if (mapInited || typeof L === 'undefined') {
      if (mapInited) return;
      // Wait for Leaflet to load
      setTimeout(initMap, 300);
      return;
    }
    var el = $('#bk2-map');
    if (!el) return;
    var pins = (window.BK2_DATA.bookings || []).filter(function (b) { return b.lat && b.lng; });
    var center = pins.length ? [pins[0].lat, pins[0].lng] : [-33.8688, 151.2093];
    var map = L.map('bk2-map').setView(center, pins.length ? 11 : 10);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap', maxZoom: 19 }).addTo(map);
    pins.forEach(function (p) {
      var m = L.marker([p.lat, p.lng]).addTo(map);
      m.bindPopup('<strong>#' + p.num + '</strong><br>' + (p.title || p.addr || ''));
      m.on('click', function () { location.href = '/bookings/' + p.id; });
    });
    if (pins.length > 1) map.fitBounds(pins.map(function (p) { return [p.lat, p.lng]; }), { padding: [40, 40] });
    mapInited = true;
  }

  // ---------- Initial state from URL ----------
  var initialUrl = new URL(location.href);
  var initialView = initialUrl.searchParams.get('view') || 'board';
  if (initialView !== 'board') setView(initialView);
  // Only ?b=new auto-opens the slide-over (Quick Book). View deep-links
  // navigate to the full booking page so the slide-over can never strand
  // the user. Any stale ?b=<id> gets silently stripped on load.
  var initialBooking = window.BK2_DATA.openBookingId || initialUrl.searchParams.get('b');
  if (initialBooking === 'new') {
    openCreate();
  } else if (initialBooking) {
    pushUrl({ b: null });
  }
  // Defensive: if anything left a stuck slide-over class around (bfcache,
  // historical state, whatever), close it on every page load.
  if (so.classList.contains('bk2-open')) closeSlideover();
  window.addEventListener('pageshow', function () {
    if (so.classList.contains('bk2-open') && soState.mode !== 'create') closeSlideover();
  });

  // ============================================================
  //  CALENDAR (Phase 5) — week timeline 6am–8pm.
  // ============================================================
  var calLoadedFor = null;
  function loadCalendar() {
    var date = window.BK2_DATA.dateStr;
    if (calLoadedFor === date) return;
    calLoadedFor = date;
    fetch('/bookings/api/week?date=' + encodeURIComponent(date), { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(renderCalendar)
      .catch(function () { $('#bk2-cal-grid').innerHTML = '<p style="color:#DC2626;text-align:center;padding:24px 0">Failed to load week.</p>'; });
  }
  function renderCalendar(week) {
    var grid = $('#bk2-cal-grid');
    var range = $('#bk2-cal-range');
    var monday = new Date(week.monday + 'T00:00:00');
    var sunday = new Date(week.sunday + 'T00:00:00');
    range.textContent = monday.toLocaleDateString('en-AU', { day: 'numeric', month: 'short' }) + ' – ' + sunday.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });

    var hours = []; for (var h = 6; h <= 20; h++) hours.push(h);
    var dayLabels = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    var html = '<div class="bk2-cal">';
    html += '<div class="bk2-cal-head"></div>';
    for (var i = 0; i < 7; i++) {
      var dayDate = new Date(monday); dayDate.setDate(monday.getDate() + i);
      html += '<div class="bk2-cal-head">' + dayLabels[i] + '<br><span style="font-weight:500;color:#374151">' + dayDate.getDate() + '/' + (dayDate.getMonth() + 1) + '</span></div>';
    }
    for (var hi = 0; hi < hours.length; hi++) {
      var hr = hours[hi];
      html += '<div class="bk2-cal-hour">' + (hr <= 12 ? hr : hr - 12) + (hr < 12 ? 'a' : 'p') + '</div>';
      for (var di = 0; di < 7; di++) {
        html += '<div class="bk2-cal-cell" data-day="' + di + '" data-hour="' + hr + '"></div>';
      }
    }
    html += '</div>';
    grid.innerHTML = html;

    // Place blocks
    var pxPerMin = 32 / 60;
    var startMin = 6 * 60;
    (week.items || []).forEach(function (it) {
      var firstCell = grid.querySelector('.bk2-cal-cell[data-day="' + it.day_index + '"][data-hour="6"]');
      if (!firstCell) return;
      var topPx = Math.max(0, (it.start_min - startMin)) * pxPerMin;
      var heightPx = Math.max(20, (it.end_min - it.start_min) * pxPerMin - 2);
      // Position within the column: find the column wrapper. Each
      // bk2-cal-cell is a grid cell; we'll absolute-position the block
      // relative to the first cell of that day-column.
      var block = document.createElement('div');
      block.className = 'bk2-cal-block bk2-status-tone-' + it.status;
      block.style.cssText = 'top:' + topPx + 'px;height:' + heightPx + 'px;border-left-color:var(--bk2-tone);';
      block.style.background = 'color-mix(in srgb, var(--bk2-tone) 18%, white)';
      block.style.color = 'color-mix(in srgb, var(--bk2-tone) 70%, black)';
      block.innerHTML = '<strong>' + esc(it.title || ('#' + it.booking_number)) + '</strong>' +
        '<span style="opacity:0.85">' + new Date(it.start_datetime).toLocaleTimeString('en-AU', { hour: 'numeric', minute: '2-digit', hour12: true }).toLowerCase() + '</span>';
      block.dataset.bookingId = it.id;
      block.addEventListener('click', function () { location.href = '/bookings/' + it.id; });
      firstCell.appendChild(block);
    });
  }
  $('#bk2-cal-prev') && $('#bk2-cal-prev').addEventListener('click', function () { shiftWeek(-7); });
  $('#bk2-cal-next') && $('#bk2-cal-next').addEventListener('click', function () { shiftWeek(7); });
  function shiftWeek(deltaDays) {
    var d = new Date(window.BK2_DATA.dateStr + 'T00:00:00'); d.setDate(d.getDate() + deltaDays);
    var u = new URL(location.href); u.searchParams.set('date', d.toISOString().substring(0, 10)); u.searchParams.set('view', 'calendar');
    location.href = u.toString();
  }

  // If we landed on ?view=calendar, load it now (the setView call in
  // the initial-state block already ran but at that point loadCalendar
  // wasn't defined; the typeof guard inside setView handles future
  // clicks, this triggers the first load).
  if (getCurrentView() === 'calendar') loadCalendar();

  // ============================================================
  //  COMMAND PALETTE (Cmd+K)
  // ============================================================
  var palette     = $('#bk2-palette');
  var palBackdrop = $('#bk2-palette-backdrop');
  var palInput    = $('#bk2-palette-input');
  var palList     = $('#bk2-palette-list');
  var palItems    = [];
  var palActive   = 0;
  function paletteOpen() {
    palBackdrop.classList.add('bk2-open');
    palette.classList.add('bk2-open');
    palInput.value = '';
    refreshPalette('');
    setTimeout(function () { palInput.focus(); }, 30);
  }
  function paletteClose() {
    palBackdrop.classList.remove('bk2-open');
    palette.classList.remove('bk2-open');
  }
  palBackdrop.addEventListener('click', paletteClose);
  function refreshPalette(q) {
    q = (q || '').toLowerCase();
    // Static commands
    var commands = [
      { id: 'cmd:new',      label: 'New booking',        meta: 'Quick Book',  ic: '+', do: function () { paletteClose(); openCreate(); } },
      { id: 'cmd:resource', label: 'Toggle Resource Panel', meta: 'R',         ic: '👥', do: function () { paletteClose(); resourceState.open ? closeResources() : openResources(); } },
      { id: 'cmd:board',    label: 'Switch to Board',    meta: 'View',         ic: '☰', do: function () { paletteClose(); setView('board'); } },
      { id: 'cmd:list',     label: 'Switch to List',     meta: 'View',         ic: '☰', do: function () { paletteClose(); setView('list'); } },
      { id: 'cmd:cal',      label: 'Switch to Calendar', meta: 'View',         ic: '🗓', do: function () { paletteClose(); setView('calendar'); } },
      { id: 'cmd:map',      label: 'Switch to Map',      meta: 'View',         ic: '📍', do: function () { paletteClose(); setView('map'); } },
      { id: 'cmd:today',    label: 'Jump to today',      meta: 'Today',        ic: '⏰', do: function () { paletteClose(); location.href = '/bookings'; } },
    ];
    var bookings = (window.BK2_DATA.bookings || []).map(function (b) {
      return { id: 'bk:' + b.id, label: '#' + b.num + ' · ' + (b.title || b.addr || 'Untitled'), meta: 'Booking', ic: '🧾', do: function () { paletteClose(); location.href = '/bookings/' + b.id; } };
    });
    var all = commands.concat(bookings);
    palItems = q ? all.filter(function (it) { return it.label.toLowerCase().includes(q); }) : all;
    palActive = 0;
    palList.innerHTML = palItems.slice(0, 20).map(function (it, i) {
      return '<div class="bk2-palette-row" data-i="' + i + '" data-active="' + (i === 0 ? 'true' : 'false') + '">' +
        '<span class="ic">' + it.ic + '</span><span>' + esc(it.label) + '</span><span class="meta">' + esc(it.meta) + '</span>' +
        '</div>';
    }).join('');
    palList.querySelectorAll('.bk2-palette-row').forEach(function (row) {
      row.addEventListener('click', function () { var it = palItems[parseInt(row.dataset.i, 10)]; if (it) it.do(); });
    });
  }
  palInput.addEventListener('input', function () { refreshPalette(palInput.value); });
  palInput.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowDown') { e.preventDefault(); palActive = Math.min(palItems.length - 1, palActive + 1); updateActive(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); palActive = Math.max(0, palActive - 1); updateActive(); }
    else if (e.key === 'Enter') { e.preventDefault(); var it = palItems[palActive]; if (it) it.do(); }
    else if (e.key === 'Escape') { e.preventDefault(); paletteClose(); }
  });
  function updateActive() {
    palList.querySelectorAll('.bk2-palette-row').forEach(function (r, i) { r.dataset.active = (i === palActive ? 'true' : 'false'); if (i === palActive) r.scrollIntoView({ block: 'nearest' }); });
  }
  document.addEventListener('keydown', function (e) {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); paletteOpen(); }
  });

  // ============================================================
  //  LIST: bulk select + bulk status
  // ============================================================
  var listAll = $('#bk2-list-all');
  var bulkBar = $('#bk2-bulk-bar');
  var bulkCount = $('#bk2-bulk-count');
  var bulkStatus = $('#bk2-bulk-status');
  var bulkApply = $('#bk2-bulk-apply');
  var bulkClear = $('#bk2-bulk-clear');
  function listCheckboxes() { return $$('.bk2-list-chk'); }
  function checkedListIds() { return listCheckboxes().filter(function (c) { return c.checked; }).map(function (c) { return c.dataset.id; }); }
  function refreshBulkBar() {
    var ids = checkedListIds();
    if (!ids.length) { bulkBar.style.display = 'none'; return; }
    bulkBar.style.display = 'flex';
    bulkCount.textContent = ids.length + ' selected';
    if (listAll) {
      var all = listCheckboxes();
      listAll.indeterminate = ids.length > 0 && ids.length < all.length;
      listAll.checked = ids.length === all.length;
    }
    bulkApply.disabled = !bulkStatus.value;
  }
  if (listAll) listAll.addEventListener('change', function () {
    listCheckboxes().forEach(function (c) { c.checked = listAll.checked; });
    refreshBulkBar();
  });
  document.addEventListener('change', function (e) {
    if (e.target && e.target.classList && e.target.classList.contains('bk2-list-chk')) refreshBulkBar();
    if (e.target === bulkStatus) refreshBulkBar();
  });
  if (bulkClear) bulkClear.addEventListener('click', function () {
    listCheckboxes().forEach(function (c) { c.checked = false; });
    refreshBulkBar();
  });
  if (bulkApply) bulkApply.addEventListener('click', function () {
    var ids = checkedListIds();
    var status = bulkStatus.value;
    if (!ids.length || !status) return;
    if (!confirm('Set status of ' + ids.length + ' booking' + (ids.length === 1 ? '' : 's') + ' to ' + status.replace(/_/g, ' ') + '?')) return;
    var promises = ids.map(function (id) {
      return fetch('/bookings/' + id + '/status', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'x-csrf-token': csrf },
        credentials: 'same-origin',
        body: new URLSearchParams({ status: status }).toString(),
      });
    });
    Promise.all(promises).then(function () { toast('Updated ' + ids.length); setTimeout(function () { location.reload(); }, 600); });
  });

  // Select first card by default
  selectCard(0);
})();
</script>
