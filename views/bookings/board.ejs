    if (!wrap || !form) return;
    var SYDNEY = [-33.8688, 151.2093];
    var pickMap = null, pickMarker = null;

    function latEl() { return form.querySelector('[name="latitude"]'); }
    function lngEl() { return form.querySelector('[name="longitude"]'); }
    function writeLatLng(lat, lng) {
      if (latEl()) latEl().value = (lat == null) ? '' : String(lat);
      if (lngEl()) lngEl().value = (lng == null) ? '' : String(lng);
      // Auto-tick accurate once the planner has actually placed a pin.
      toggle.checked = true;
    }
    function currentLatLng() {
      var lat = parseFloat(latEl() && latEl().value);
      var lng = parseFloat(lngEl() && lngEl().value);
      if (isFinite(lat) && isFinite(lng) && (lat || lng)) return [lat, lng];
      return null;
    }
