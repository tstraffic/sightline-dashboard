  window.BK2_DATA = {
    bookings: <%- JSON.stringify(bookings.map(function (b) { return { id: b.id, lat: b.latitude, lng: b.longitude, title: b.title, status: b.status, num: b.booking_number, addr: b.site_address }; })) %>,
