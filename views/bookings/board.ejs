<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>

<script>
(function () {
  'use strict';
  var $  = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.from((r || document).querySelectorAll(s)); };
  var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';

  // ============================================================
  //  Quick Book slide-over open/close.
  //
  //  Bug we keep tripping over: the panel renders open on page load
  //  even though no JS adds `bk2-open` to it. Cause: the aside is
  //  position:fixed with transform:translateX(100%) in CSS, but if
  //  bookings-v2.css fails to load (CDN hiccup, stale SW cache) the
  //  declaration is missing and the element falls into its default
  //  `transform: none` position — fully visible.
  //
  //  Defence in depth:
  //  - The aside ships with an inline transform:translateX(100%) so
  //    the closed state is encoded in markup, not just a stylesheet.
  //  - openQB clears the inline style so the CSS transition can take
  //    over for the open animation.
  //  - The X / backdrop / Esc all close through a document-level
  //    delegated handler so even if a later script error interrupts
  //    the wireup, the close path still fires.
  // ============================================================
  var so = $('#bk2-slideover');
  var backdrop = $('#bk2-backdrop');
  var qbForm = $('#bk2-qb-form');

  // Nuclear close: the panel is display:none in markup, so it CAN'T
  // render unless openQB() explicitly flips it. No reliance on CSS
  // transforms surviving load order, stale stylesheets, or specificity
  // games.
  var soCloseTimer = null;
  function closeQB() {
    if (!so) return;
    so.classList.remove('bk2-open');
    if (backdrop) backdrop.classList.remove('bk2-open');
    so.setAttribute('aria-hidden', 'true');
    // Let the slide-out transition play, then truly hide.
    if (soCloseTimer) clearTimeout(soCloseTimer);
    soCloseTimer = setTimeout(function () {
      so.style.display = 'none';
      so.hidden = true;
      if (backdrop) { backdrop.style.display = 'none'; backdrop.hidden = true; }
      soCloseTimer = null;
    }, 240);
  }
  function openQB() {
    if (!so) return;
    if (soCloseTimer) { clearTimeout(soCloseTimer); soCloseTimer = null; }
    if (qbForm) qbForm.reset();
    so.hidden = false;
    so.style.display = 'flex';
    so.setAttribute('aria-hidden', 'false');
    if (backdrop) { backdrop.hidden = false; backdrop.style.display = 'block'; }
    // Force a reflow so the bk2-open class change triggers a transition
    // from the just-flipped display state.
    void so.offsetWidth;
    so.classList.add('bk2-open');
    if (backdrop) backdrop.classList.add('bk2-open');
    setTimeout(function () { var first = so.querySelector('input[name="client_name"]'); if (first) first.focus(); }, 80);
  }

  // Force-closed at every lifecycle moment we can hook into so a
  // stuck-open render from any path (bfcache, SW restore, dev hot
  // reload) is overridden.
  function hardClose() {
    if (!so) return;
    so.classList.remove('bk2-open');
    so.style.display = 'none';
    so.hidden = true;
    so.setAttribute('aria-hidden', 'true');
    if (backdrop) {
      backdrop.classList.remove('bk2-open');
      backdrop.style.display = 'none';
      backdrop.hidden = true;
    }
  }
  hardClose();
  window.addEventListener('pageshow', hardClose);
  window.addEventListener('load', hardClose);

  // Document-level delegation for the close affordances. Survives any
  // later script error that might break the direct-listener wireup,
  // and means dynamic [data-bk2-close] elements work without extra
  // bookkeeping.
  document.addEventListener('click', function (e) {
    if (!e.target || !e.target.closest) return;
    if (e.target.closest('#bk2-so-close') ||
        e.target.closest('[data-bk2-close]') ||
        e.target === backdrop) {
      e.preventDefault();
      closeQB();
    }
  });
  // Keep the backdrop's own listener too (older browsers without
  // closest support fall back here gracefully).
  if (backdrop) backdrop.addEventListener('click', closeQB);

  // Hide the panel immediately on submit so users don't see it lingering
  // through the round-trip + redirect. Native form submit still proceeds.
  if (qbForm) qbForm.addEventListener('submit', function () { closeQB(); });

  // ============================================================
  //  VIEW SWITCHER — client-side tab toggle
  // ============================================================
  function setView(v) {
    if (!['board','list','calendar','map'].includes(v)) v = 'board';
    $$('.bk2-view-tab').forEach(function (t) { t.setAttribute('aria-selected', t.dataset.viewTab === v ? 'true' : 'false'); });
    $$('.bk2-pane').forEach(function (p) { p.setAttribute('aria-current', p.dataset.viewPane === v ? 'true' : 'false'); });
    var u = new URL(location.href);
    if (v === 'board') u.searchParams.delete('view'); else u.searchParams.set('view', v);
    history.replaceState({}, '', u.toString());
    if (v === 'map')      initMap();
    if (v === 'calendar') loadCalendar();
  }
  $$('.bk2-view-tab').forEach(function (t) { t.addEventListener('click', function () { setView(t.dataset.viewTab); }); });

  // Initial view from URL
  var u0 = new URL(location.href);
  var v0 = u0.searchParams.get('view') || 'board';
  if (v0 !== 'board') setView(v0);

  // ============================================================
  //  + NEW BOOKING — opens Quick Book
  // ============================================================
  // ============================================================
  //  Booking editor slide-over — two modes:
  //    "create" → single comprehensive form, no tab strip, big Create button
  //    "edit"   → tabbed shell, Save + Clone in the status row
  //  "New booking" opens in create mode; on save the slide-over
  //  switches to edit mode for the new booking.
  // ============================================================
  function setEditorMode(mode) {
    var ed = $('#bk2-editor'); if (!ed) return;
    ed.dataset.mode = mode;
    if (mode === 'edit') setEditorTab('overview');
  }
  function openEditor() {
    var ed = $('#bk2-editor'); var bd = $('#bk2-edit-backdrop');
    if (!ed || !bd) return;
    ed.removeAttribute('data-existing');
    ed.dataset.bookingId = '';
    var created = $('#bk2-edit-created'); if (created) created.hidden = true;
    var qv = $('#bk2-edit-quickview'); if (qv) qv.hidden = true;
    var form0 = $('#bk2-edit-form');
    if (form0) {
      form0.style.display = '';
      form0.setAttribute('action', '/bookings/quick'); // reset from any edit reuse
      form0.removeAttribute('novalidate');             // create mode keeps HTML5 required checks
    }
    // Restore the Create button (prefillEditForm may have relabelled it Save).
    var cBtn = $('#bk2-edit-create');
    if (cBtn) {
      cBtn.setAttribute('data-mode-only', 'create');
      cBtn.style.display = '';
      cBtn.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg> Create';
    }
    setEditorMode('create');
    var _delBtnC = $('#bk2-edit-delete'); if (_delBtnC) _delBtnC.hidden = true; // no delete for an unsaved shift
    // Reset the status pills — a new booking always starts Unconfirmed
    // (/quick hardcodes it server-side). Without this the pill row kept the
    // previously-edited booking's active status, which read as if the new
    // shift inherited it.
    $$('.bk2-edit-statuspill').forEach(function (p) { p.classList.remove('is-active'); });
    var _unconf = document.querySelector('.bk2-edit-statuspill[data-status-set="unconfirmed"]');
    if (_unconf) _unconf.classList.add('is-active');
    var title = $('#bk2-edit-title'); if (title) title.textContent = 'New Booking';
    // Reset the create form so reopening doesn't carry over stale
    // values from a previous session (e.g. dates pre-filled when
    // viewing an older day, then the planner navigated to Today and
    // opened New Booking again — the date should reset, not stick).
    var form = $('#bk2-edit-form');
    if (form) {
      try { form.reset(); } catch (e) {}
      // Also blow out any hidden inputs the autocomplete picker
      // populates (lat/lng/suburb/state/postcode) — form.reset() only
      // restores to the value attribute, but those start blank and
      // get filled in via JS, so reset doesn't clear them.
      ['latitude','longitude','suburb','state','postcode'].forEach(function (n) {
        var el = form.querySelector('[name="' + n + '"]');
        if (el) el.value = '';
      });
    }
    // Re-arm the focus-prefill listeners so the next tap picks the
    // correct day-aware default (handlers were `once: true` so they
    // detached after the first prefill).
    if (typeof rearmCreatePrefill === 'function') rearmCreatePrefill();
    bd.hidden = false; ed.hidden = false;
    requestAnimationFrame(function () {
      bd.classList.add('is-open'); ed.classList.add('is-open');
    });
    document.body.style.overflow = 'hidden';
  }
  function closeEditor() {
    var ed = $('#bk2-editor'); var bd = $('#bk2-edit-backdrop');
    if (!ed || !bd) return;
    ed.classList.remove('is-open'); bd.classList.remove('is-open');
    setTimeout(function () { ed.hidden = true; bd.hidden = true; }, 220);
    document.body.style.overflow = '';
    // Return the floated card to the board + drop its highlight.
    try { unfloatCard(); } catch (e) {}
    // A booking was created while the editor was open — the board behind
    // doesn't show the new card yet. Refresh it now (on close) instead of
    // yanking the planner out mid-edit with a reload right after Create.
    if (boardDirty) { boardDirty = false; refreshBoard(); }
  }

  // Board refresh after a create — runs only once the editor is CLOSED, so
  // the new card appears without ever yanking the planner out mid-edit
  // (the old behaviour reloaded 600ms after Create and closed the editor).
  var boardDirty = false;
  function refreshBoard() {
    if (typeof window.bk2RefreshBoard === 'function') { window.bk2RefreshBoard(); return; }
    location.reload();
  }

  // Point both "Open full edit page" controls at a booking id.
  function setFullEditTarget(id) {
    var href = '/bookings/' + encodeURIComponent(id);
    var a1 = $('#bk2-edit-fulledit');    if (a1) a1.setAttribute('href', href);
    var a2 = $('#bk2-edit-qv-fulledit'); if (a2) a2.setAttribute('href', href);
  }

  // ── Float the edited card beside the editor (FLIP glide) ──
  // Lifts the selected card out of the (now blurred) board and glides it to a
  // vertically-centred spot just left of the slide-over, keeping its glow.
  var floatingCard = null;
  // Compute the side-by-side layout: the editor narrows so the booking card
  // sits cleanly to its LEFT with no overlap (so nothing is squished), on any
  // screen wide enough. Returns null on small screens (then the editor takes
  // its normal width and no card is floated).
  function bkFloatLayout() {
    var vw = window.innerWidth, vh = window.innerHeight;
    if (vw < 1100) return null;                 // too narrow — don't float
    var outer = 20, gap = 20;
    var cardW = Math.min(360, Math.round(vw * 0.30));
    var editorW = Math.min(1200, vw - cardW - gap - outer * 2);
    var cardLeft = Math.max(outer, vw - editorW - gap - cardW);
    return { vw: vw, vh: vh, cardW: cardW, editorW: editorW, cardLeft: cardLeft };
  }
  // Move the resource pool panel INTO the Resources tab (its pool column) and
  // back to the board. The pool now lives in the self-contained Resources tab
  // rather than docking beside the card.
  function bkPoolToTab() {
    var panel = document.getElementById('bk2-resourcepanel');
    var slot = document.querySelector('[data-restab-pool]');
    if (!panel || !slot || panel.parentNode === slot) return;
    if (!panel.__poolHome) { panel.__poolHome = panel.parentNode; panel.__poolNext = panel.nextSibling; }
    panel.classList.add('bk2-resourcepanel--intab');
    // Never collapsed while it's the tab's pool.
    try { var pane = document.querySelector('.bk2-pane--with-panel'); if (pane) pane.classList.remove('is-collapsed'); } catch (e) {}
    slot.appendChild(panel);
    try { if (window.bk2ReloadResources) window.bk2ReloadResources((window.BK2_DATA && window.BK2_DATA.dateStr) || undefined); } catch (e) {}
  }
  function bkPoolToBoard() {
    var panel = document.getElementById('bk2-resourcepanel');
    if (!panel || !panel.__poolHome) return;
    panel.classList.remove('bk2-resourcepanel--intab');
    try { panel.__poolHome.insertBefore(panel, panel.__poolNext || null); } catch (e) {}
    panel.__poolHome = null; panel.__poolNext = null;
  }
  function floatCardBesideEditor(card) {
    if (!card) return;
    var L = bkFloatLayout();
    var ed = $('#bk2-editor');
    if (ed) {
      if (L) { ed.style.width = L.editorW + 'px'; ed.dataset.bkNarrowed = '1'; }
      else if (ed.dataset.bkNarrowed) { ed.style.width = ''; delete ed.dataset.bkNarrowed; }
    }
    if (!L) return; // small screen: editor full width, no floating card
    var r = card.getBoundingClientRect();
    // Reparent to <body> so position:fixed is viewport-relative — the board
    // sits inside transformed/contained panes that would otherwise become the
    // containing block for a fixed element. Remember where it came from.
    card.__bkOrigStyle = card.getAttribute('style') || '';
    card.__bkParent = card.parentNode;
    card.__bkNext = card.nextSibling;
    document.body.appendChild(card);
    card.classList.add('is-editing', 'bk2-card--floating');
    // Place the panel at its target spot IMMEDIATELY (no freeze→glide) so it
    // just appears beside the editor with the glow — no visible jump. The CSS
    // transition on top/left/width has been removed for the same reason.
    var maxH = Math.round(L.vh * 0.86);
    card.style.position = 'fixed';
    card.style.margin = '0';
    card.style.maxHeight = maxH + 'px';
    card.style.overflowY = 'auto';
    card.style.left = L.cardLeft + 'px';
    card.style.width = L.cardW + 'px';
    // Provisional centre from the frozen compact height, then re-centre on the
    // real expanded height once it has reflowed at the target width.
    card.style.top = Math.max(20, Math.round((L.vh - Math.min(maxH, Math.max(r.height, 420))) / 2)) + 'px';
    function recentre() {
      var actualH = Math.min(maxH, card.offsetHeight);
      card.style.top = Math.max(20, Math.round((L.vh - actualH) / 2)) + 'px';
    }
    requestAnimationFrame(recentre);
    setTimeout(recentre, 80);   // fallback: rAF is paused on backgrounded tabs
    floatingCard = card;
  }
  function unfloatCard() {
    var ed = $('#bk2-editor');
    if (ed && ed.dataset.bkNarrowed) { ed.style.width = ''; delete ed.dataset.bkNarrowed; }
    try { bkPoolToBoard(); } catch (e) {}
    document.querySelectorAll('.bk2-card--floating, .bk2-card.is-editing').forEach(function (c) {
      c.classList.remove('bk2-card--floating', 'is-editing');
      // Put it back where it was on the board.
      if (c.__bkParent) {
        try { c.__bkParent.insertBefore(c, c.__bkNext || null); } catch (e) {}
        delete c.__bkParent; delete c.__bkNext;
      }
      if (c.__bkOrigStyle != null) { c.setAttribute('style', c.__bkOrigStyle); delete c.__bkOrigStyle; }
      else c.removeAttribute('style');
    });
    floatingCard = null;
  }

  // Open the editor in edit mode for an EXISTING booking (board "Open").
  // The Overview tab opens prefilled with the booking's data (same form as
  // New Booking, just populated); Resources + Tasks lazy-load fragments from
  // /bookings/:id when first activated. "Open full edit page" still routes
  // out to the whole-screen editor for everything else.
  function openEditorForBooking(id, number, title) {
    var ed = $('#bk2-editor'); var bd = $('#bk2-edit-backdrop');
    if (!ed || !bd || !id) return;
    var created = $('#bk2-edit-created'); if (created) created.hidden = true;
    ed.dataset.existing = '1';
    ed.dataset.bookingId = id;
    // Hide "Delete shift" until prefill loads this booking's real status
    // (prevents it lingering from a previously-open cancelled booking).
    var _delBtn = $('#bk2-edit-delete'); if (_delBtn) _delBtn.hidden = true;
    // Float the edited card beside the editor; blur the rest of the board.
    try {
      unfloatCard();
      floatCardBesideEditor(document.querySelector('.bk2-card[data-booking-id="' + id + '"]'));
    } catch (e) {}
    setEditorMode('edit');
    var t = $('#bk2-edit-title');
    if (t) t.textContent = (number ? ('#' + number) : ('Booking ' + id)) + (title ? ' · ' + title : '');
    // Quick-view is an error fallback only — keep it hidden; the Overview
    // form (prefilled below) is the surface. Title/sub are still set so the
    // fallback reads correctly if the prefill fetch fails.
    var qv = $('#bk2-edit-quickview'); if (qv) qv.hidden = true;
    var qvT = $('#bk2-edit-qv-title'); if (qvT) qvT.textContent = number ? ('#' + number) : ('Booking ' + id);
    var qvS = $('#bk2-edit-qv-sub'); if (qvS) qvS.textContent = title || '';
    setFullEditTarget(id);
    bd.hidden = false; ed.hidden = false;
    requestAnimationFrame(function () { bd.classList.add('is-open'); ed.classList.add('is-open'); });
    document.body.style.overflow = 'hidden';
    setEditorTab('overview');

    // Prefill the Quick Book form with the booking's data + flip it into
    // edit-save mode so submitting writes back to the same booking.
    prefillEditForm(id);

    // Reset lazy fragment caches — they belong to the previously-loaded
    // booking and would otherwise leak across opens.
    fragmentLoaded = {};
    fragmentDocCache = null;
    try { if (window.bk2ResetDocPanes) window.bk2ResetDocPanes(); } catch (e) {}
  }

  // ── Prefill the Overview form from a booking's edit-data JSON ──
  // Wires the existing Quick Book form to act as an edit form for an existing
  // booking. Changes its action to /bookings/:id/quick-update, repoints the
  // Create button to "Save", populates fields by name from the API response,
  // and shows the form (hiding the quick-view placeholder).
  function prefillEditForm(bookingId) {
    var form = $('#bk2-edit-form'); if (!form) return;
    form.style.display = ''; // clear any error-state hide from a prior open
    fetch('/bookings/api/' + bookingId + '/edit-data', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
      .then(function (data) {
        if (!data || !data.ok || !data.booking) return;
        var b = data.booking;
        form.setAttribute('action', '/bookings/' + bookingId + '/quick-update');
        // Disable HTML5 validation in edit mode. The required fields live in
        // the Overview pane — when the planner is on Resources / Tasks /
        // etc. that pane is hidden, and clicking Save silently no-ops because
        // browsers refuse to submit (and refuse to fire the JS submit event)
        // when a hidden required field is empty. Server-side quick-update
        // re-validates the same fields and returns proper errors, so we
        // don't lose any safety net by relying on it.
        form.setAttribute('novalidate', 'novalidate');
        try { form.reset(); } catch (e) {}
        // Populate fields by name. Skips fields that don't exist on the form
        // (the slide-over carries a subset of what the booking row has).
        Object.keys(b).forEach(function (key) {
          var els = form.querySelectorAll('[name="' + key + '"]');
          els.forEach(function (el) {
            var v = b[key];
            if (el.type === 'checkbox') { el.checked = !!v; return; }
            if (el.type === 'radio')    { el.checked = String(el.value) === String(v); return; }
            if (Array.isArray(v) && el.multiple) {
              Array.from(el.options).forEach(function (o) { o.selected = v.indexOf(o.value) !== -1; });
              return;
            }
            el.value = (v == null) ? '' : String(v);
          });
        });
        // Booking Requirements steppers — set each from the saved quantities
        // the server returned (data.requirements maps field → qty). Fields
        // not present default to 0 so the grid reflects exactly what's saved
        // rather than the create-form template defaults. Fire input so the
        // People/Vehicles/Equipment summary recalculates.
        var reqs = data.requirements || {};
        console.log('[bk2 prefill] requirements for booking', bookingId, reqs);
        applyReqSteppers(reqs);

        // Client-scoped Project dropdown: load this client's projects then
        // select the saved one.
        try { if (window.bk2LoadProjects) window.bk2LoadProjects(b.client_id, b.job_id); } catch (e) {}

        // Mobile-works legs + meeting point (added with the doc/legs feature).
        try { if (window.bk2ApplyMobileLegs) window.bk2ApplyMobileLegs(data.mobileLegs || [], data.hasMobileWorks); } catch (e) {}
        try { if (window.bk2ApplyMeetingPoint) window.bk2ApplyMeetingPoint(data.meetingPoint || {}); } catch (e) {}
        // Site contacts — load this client's contacts then re-select the saved ids.
        try { if (window.bk2ApplySiteContacts) window.bk2ApplySiteContacts(b.client_id, b.site_contacts || []); } catch (e) {}
        try { document.dispatchEvent(new CustomEvent('bk2:prefilled')); } catch (e) {}

        // Booking type / callout / status side-effects.
        var statusPill = document.querySelector('.bk2-edit-statuspill[data-status-set="' + (b.status || '') + '"]');
        if (statusPill) {
          $$('.bk2-edit-statuspill').forEach(function (p) { p.classList.remove('is-active'); });
          statusPill.classList.add('is-active');
        }
        if (typeof syncDeleteBtn === 'function') syncDeleteBtn();
        // Form is the editor's primary surface now — hide the quickview.
        var qv = $('#bk2-edit-quickview'); if (qv) qv.hidden = true;
        // Relabel the Create button as Save (mode-only CSS still keeps it
        // hidden in pure-edit mode; we force it visible because the form is
        // the surface we want planners using).
        var createBtn = $('#bk2-edit-create');
        if (createBtn) {
          createBtn.setAttribute('data-mode-only', 'edit-form');
          createBtn.querySelector('svg + *') ? null : null;
          createBtn.innerHTML = '<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Save';
          createBtn.style.display = '';
        }
      })
      .catch(function () {
        // Prefill failed — fall back to the quick-view panel so the planner
        // still gets the "Open full edit page" route instead of a blank pane.
        var qv = $('#bk2-edit-quickview'); if (qv) qv.hidden = false;
        var form = $('#bk2-edit-form'); if (form) form.style.display = 'none';
      });
  }

  // ── Lazy-load Resources + Tasks tab content from /bookings/:id ──
  // Fetches the full booking page once and lifts the matching [data-bk-tab]
  // node into the overlay pane. Forms + buttons inside the lifted fragment
  // keep their server-side action URLs, so saves/uploads work as on the
  // full edit page (submitting reloads the page, which is fine).
  // Map overlay tab keys → the [data-bk-tab] values used on /bookings/:id.
  // Most are 1:1; "resources" picks up the crew/vehicles section under
  // data-bk-tab="crews". Tabs not in this map can't be lifted (the user
  // gets a "Open full edit page" CTA).
  var TAB_TO_BK_TAB = {
    resources: 'crews',
    tasks:     'tasks',
    dockets:   'dockets',
    history:   'history',
    notes:     'notes',
    documents: 'documents',
    forms:     'forms',
  };
  var fragmentLoaded = {};
  var fragmentDocCache = null;
  function loadBookingFragment(tab) {
    var bkTab = TAB_TO_BK_TAB[tab];
    if (!bkTab) return; // not liftable — leave the placeholder pane as-is
    if (fragmentLoaded[tab]) return;
    var ed = $('#bk2-editor');
    var id = ed && ed.dataset.bookingId;
    if (!id) return;
    var pane = document.querySelector('[data-edit-pane="' + tab + '"]');
    if (!pane) return;
    pane.innerHTML = '<div class="bk2-edit-placeholder"><h3>Loading…</h3></div>';
    var p = fragmentDocCache && fragmentDocCache.id === id
      ? Promise.resolve(fragmentDocCache.doc)
      : fetch('/bookings/' + id, { credentials: 'same-origin', headers: { 'Accept': 'text/html' } })
          .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            fragmentDocCache = { id: id, doc: doc };
            return doc;
          });
    p.then(function (doc) {
      // Lift EVERY element matching the tab — Dockets in particular has
      // multiple (the new shift-docket panel + the legacy dockets list).
      var nodes = doc.querySelectorAll('[data-bk-tab="' + bkTab + '"]');
      if (!nodes.length) { pane.innerHTML = '<div class="bk2-edit-placeholder"><h3>Not available here</h3><p>Open the full edit page to use this tab.</p></div>'; return; }
      pane.innerHTML = '';
      nodes.forEach(function (node) {
        node.classList.remove('bk-hidden');
        pane.appendChild(document.importNode(node, true));
      });
      fragmentLoaded[tab] = true;
      // Inline `onchange="this.form.submit()"` (the driver <select>) bypasses
      // submit listeners and navigates to the full page. Rewire those to
      // requestSubmit() so the pane's AJAX submit interception catches them.
      pane.querySelectorAll('select[onchange]').forEach(function (sel) {
        var oc = sel.getAttribute('onchange') || '';
        if (oc.indexOf('form.submit') === -1) return;
        sel.removeAttribute('onchange');
        sel.addEventListener('change', function () {
          var f = sel.closest('form'); if (!f) return;
          if (typeof f.requestSubmit === 'function') f.requestSubmit();
          else f.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
        });
      });
      // The full /bookings/:id page wires the crew chips on DOMContentLoaded
      // via a script that doesn't run when we lift the node by innerHTML.
      // Bind the same interactions in the overlay so the chips are live.
      if (tab === 'resources') wireOverlayCrewChips(pane, id);
      // Tasks + Documents fragments have the same lifted-HTML problem: their
      // forms would full-page POST (ejecting the planner from the board) and
      // the dropzone never gets its handlers. Wire them per-tab.
      if (tab === 'tasks') wireOverlayTasks(pane);
      if (tab === 'documents') {
        if (window.initDropzones) window.initDropzones(pane);
        wireOverlayDocs(pane);
      }
    }).catch(function () {
      pane.innerHTML = '<div class="bk2-edit-placeholder"><h3>Couldn’t load</h3><p>Try the full edit page.</p></div>';
    });
  }

  // ── Tasks tab: AJAX the lifted forms so add / toggle / delete stay in the
  // board. Server answers JSON when asked; on success we drop the cached
  // full-page doc and re-lift the tasks fragment so the list is fresh.
  function wireOverlayTasks(pane) {
    if (pane.dataset.btBound) return;
    pane.dataset.btBound = '1';
    pane.addEventListener('submit', function (e) {
      var form = e.target && e.target.closest && e.target.closest('form');
      if (!form) return;
      var action = form.getAttribute('action') || '';
      if (!/\/bookings\/\d+\/tasks/.test(action)) return;
      e.preventDefault();
      e.stopPropagation();
      var body = new URLSearchParams(new FormData(form));
      fetch(action, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body,
        credentials: 'same-origin',
      }).then(function (r) { return r.json().catch(function () { return { ok: r.ok }; }); })
        .then(function (j) {
          if (!j || j.ok === false) {
            if (typeof bk2Toast === 'function') bk2Toast((j && j.error) || 'Could not save task.', 'error');
            return;
          }
          if (typeof bk2Toast === 'function') bk2Toast('Tasks updated.');
          fragmentDocCache = null;          // the cached page HTML is stale now
          fragmentLoaded.tasks = false;
          loadBookingFragment('tasks');     // re-lift the fresh list
        })
        .catch(function () { if (typeof bk2Toast === 'function') bk2Toast('Could not save task — network error.', 'error'); });
    });
  }

  // ── Documents tab: dropzone re-init happens above; here we AJAX the
  // multipart upload + delete forms so uploads never navigate away.
  // Build a loading overlay over the documents pane while a file uploads.
  // Returns { setProgress(fraction), processing(), remove() }. Shows a real
  // determinate bar off XHR upload progress, then flips to an indeterminate
  // "Processing…" state once the bytes are sent but the server is still saving.
  function makeDocUploadOverlay(pane) {
    var ov = document.createElement('div');
    ov.className = 'bk2-upload-overlay';
    ov.innerHTML =
      '<div class="bk2-upload-card">' +
        '<div class="bk2-spin bk2-spin-lg"></div>' +
        '<div class="bk2-upload-title">Uploading…</div>' +
        '<div class="bk2-upload-track"><div class="bk2-upload-fill"></div></div>' +
        '<div class="bk2-upload-pct">0%</div>' +
      '</div>';
    pane.style.position = pane.style.position || 'relative';
    pane.appendChild(ov);
    var fill = ov.querySelector('.bk2-upload-fill');
    var pct = ov.querySelector('.bk2-upload-pct');
    var title = ov.querySelector('.bk2-upload-title');
    return {
      setProgress: function (f) {
        var p = Math.max(0, Math.min(1, f));
        fill.style.width = (p * 100).toFixed(0) + '%';
        pct.textContent = (p * 100).toFixed(0) + '%';
        if (p >= 1) this.processing();
      },
      processing: function () {
        ov.classList.add('is-processing');
        title.textContent = 'Processing…';
        pct.textContent = '';
      },
      remove: function () { if (ov.parentNode) ov.parentNode.removeChild(ov); }
    };
  }

  function wireOverlayDocs(pane) {
    if (pane.dataset.bdBound) return;
    pane.dataset.bdBound = '1';
    pane.addEventListener('submit', function (e) {
      var form = e.target && e.target.closest && e.target.closest('form');
      if (!form) return;
      var action = form.getAttribute('action') || '';
      if (!/\/bookings\/\d+\/documents/.test(action)) return;
      e.preventDefault();
      e.stopPropagation();
      // In-flight guard: while a request for THIS form is running, ignore
      // repeat submits (spamming Upload no longer queues a copy per click).
      if (form.dataset.busy === '1') return;
      form.dataset.busy = '1';

      var isUpload = /\/documents$/.test(action);   // the add-file form, not delete/type
      var btn = form.querySelector('button[type="submit"], button:not([type])');
      var btnHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        if (isUpload) btn.innerHTML = '<span class="bk2-spin"></span>Uploading…';
      }
      var overlay = isUpload ? makeDocUploadOverlay(pane) : null;

      var finish = function () {
        form.dataset.busy = '';
        if (btn) { btn.disabled = false; btn.innerHTML = btnHtml; }
        if (overlay) overlay.remove();
      };

      // XHR (not fetch) so we can render real upload progress. Body is
      // multipart — the CSRF middleware skips multipart, same as before.
      var xhr = new XMLHttpRequest();
      xhr.open('POST', action, true);
      xhr.setRequestHeader('Accept', 'application/json');
      xhr.withCredentials = true;
      if (overlay && xhr.upload) {
        xhr.upload.onprogress = function (ev) {
          if (ev.lengthComputable) overlay.setProgress(ev.loaded / ev.total);
        };
        xhr.upload.onload = function () { overlay.processing(); };
      }
      xhr.onload = function () {
        var j = null; try { j = JSON.parse(xhr.responseText); } catch (err) {}
        var ok = xhr.status >= 200 && xhr.status < 300 && (!j || j.ok !== false);
        finish();
        if (!ok) {
          if (typeof bk2Toast === 'function') bk2Toast((j && j.error) || 'Upload failed.', 'error');
          return;
        }
        if (typeof bk2Toast === 'function') bk2Toast(isUpload ? 'Document uploaded.' : 'Documents updated.');
        fragmentDocCache = null;
        fragmentLoaded.documents = false;
        loadBookingFragment('documents');
      };
      xhr.onerror = function () {
        finish();
        if (typeof bk2Toast === 'function') bk2Toast('Upload failed — network error.', 'error');
      };
      xhr.send(new FormData(form));
    });
  }

  // ── Refresh the floating (glowing) card's content in place ──
  // Re-fetches the board HTML for the current date and swaps the floated
  // card's innerHTML with the fresh render, so crew/vehicle changes made in
  // the Resources tab show up immediately in the summary panel.
  function refreshFloatCard() {
    var ed = $('#bk2-editor');
    var id = ed && ed.dataset.bookingId;
    if (!id || !floatingCard) return;
    fetch(location.pathname + location.search, { credentials: 'same-origin', headers: { 'Accept': 'text/html', 'X-Requested-With': 'fetch' } })
      .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var fresh = doc.querySelector('.bk2-card[data-booking-id="' + id + '"]');
        if (fresh && floatingCard) floatingCard.innerHTML = fresh.innerHTML;
      })
      .catch(function () {});
  }

  // ── Self-contained Resources tab ──
  // The tab is a full-width pool browser (Workers / Vehicles / Towed sections,
  // filters + search); the GLOWING CARD is the allocation surface — it renders
  // the same slots/targets a shift column would, so we don't duplicate one
  // here. On narrow screens (no floating card) a compact drop strip stands in
  // as the add target.
  function loadResourcesTab() {
    var ed = $('#bk2-editor'); var id = ed && ed.dataset.bookingId;
    if (!id) return;
    bkPoolToTab();                    // move the pool into the tab
    var strip = document.querySelector('[data-restab-dropstrip]');
    if (strip) {
      strip.hidden = !!floatingCard;  // only needed when the card can't float
      strip.setAttribute('data-booking-id', id);
    }
  }
  // ── Requirement steppers ↔ server truth ──
  // Set every Overview requirement stepper from a {field → qty} map. Shared by
  // the prefill (editor open) and the live refresh below. Scoped to the editor
  // form ONLY — the old Quick Book form shares input names. Fires `input` so
  // the People/Vehicles/Equipment summary recalculates.
  function applyReqSteppers(reqs) {
    var form = $('#bk2-edit-form');
    if (!form) return;
    form.querySelectorAll('.bk2-create-stepper input[type="number"]').forEach(function (inp) {
      if (!inp.name) return;
      var saved = reqs[inp.name];
      inp.value = (saved != null) ? String(saved) : '0';
      inp.dispatchEvent(new Event('input', { bubbles: true }));
    });
  }
  // Re-pull the booking's requirements and re-apply them to the steppers.
  // Adding crew/vehicles/equipment bumps booking_requirements server-side
  // (e.g. a 4th TC on a full 3-man crew adds "Traffic Controller: 1"); without
  // this the steppers kept their editor-open values, so the Overview looked
  // stale AND pressing Save rebuilt the requirements from those stale numbers,
  // silently reverting the bump.
  function refreshRequirementSteppers() {
    var ed = $('#bk2-editor');
    if (!ed || ed.hidden || ed.dataset.existing !== '1' || !ed.dataset.bookingId) return;
    var id = ed.dataset.bookingId;
    fetch('/bookings/api/' + id + '/edit-data', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data) return;
        var ed2 = $('#bk2-editor');
        if (!ed2 || ed2.hidden || ed2.dataset.bookingId !== id) return; // editor moved on
        applyReqSteppers(data.requirements || {});
      })
      .catch(function () {});
  }
  // After any allocation change (drop / remove / assign), keep the glowing
  // card (the shift surface) AND the Overview requirement steppers in sync.
  document.addEventListener('bk2:alloc-changed', function () {
    // Route through the canonical refresh so the floating card, the static
    // board card, and the requirement steppers all track the change live.
    var ed = $('#bk2-editor');
    var id = ed && ed.dataset && ed.dataset.bookingId;
    if (id && typeof bk2RefreshCard === 'function') { bk2RefreshCard(id); return; }
    try { refreshFloatCard(); } catch (e) {}
    try { refreshRequirementSteppers(); } catch (e) {}
  });

  // ── Wire interactivity on the lifted Resources fragment ──
  // The crew chips in /bookings/:id get their click/drag handlers from a
  // script on that page. Since we lifted the HTML via innerHTML those
  // listeners never attach, so chips look interactive but do nothing.
  // This binds delegated handlers that mirror the same backend endpoints:
  //   pool chip click  → POST /bookings/:id/crew              (add)
  //   assigned chip ×  → POST /bookings/:id/crew/:cid/remove  (remove)
  //   driver chip ×    → POST /bookings/:id/vehicles/:vid/driver (clear)
  // After each successful action we re-fetch the fragment so the chips
  // accurately reflect the current state (assigned counts, driver slots,
  // etc.) instead of trying to hand-update the DOM.
  function wireOverlayCrewChips(pane, bookingId) {
    function csrf() {
      var m = document.querySelector('meta[name="csrf-token"]');
      return m ? m.getAttribute('content') : '';
    }
    // Read the booking id LIVE rather than capturing it — the slide-over is
    // reused across bookings, and the once-bound listener below must always
    // act on whichever booking is currently open.
    function currentBookingId() {
      var ed = $('#bk2-editor');
      return (ed && ed.dataset.bookingId) || bookingId;
    }
    function refreshPane() {
      // Drop the cached doc so we re-pull fresh server state, then re-load
      // the fragment into the current pane. (Was keyed 'crews' — a no-op,
      // because TAB_TO_BK_TAB has no such key — so the pane never refreshed.)
      fragmentDocCache = null;
      fragmentLoaded.resources = false;
      loadBookingFragment('resources');
      // Keep the floating summary card + requirement steppers in step with
      // crew/vehicle changes (alloc-changed drives both).
      try { document.dispatchEvent(new CustomEvent('bk2:alloc-changed')); } catch (e) {}
    }
    function postForm(url, payload) {
      var body = new URLSearchParams();
      Object.keys(payload || {}).forEach(function (k) { body.append(k, payload[k]); });
      body.append('_csrf', csrf());
      return fetch(url, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body,
        credentials: 'same-origin',
      }).then(function (r) {
        return r.text().then(function (t) {
          var data = {}; try { data = JSON.parse(t); } catch (e) {}
          return { ok: r.ok, status: r.status, data: data };
        });
      });
    }
    function toast(msg, kind) { if (typeof window.bk2Toast === 'function') window.bk2Toast(msg, kind); }

    // Bind the delegated click handler to the PANE exactly once. The pane
    // element survives every innerHTML refresh, so re-binding on each
    // fragment load stacked listeners — one click then fired N POSTs and
    // threw up N "Already assigned" toasts. The dataset guard fixes that;
    // the handler reads the live booking id so it stays correct across
    // bookings. (Server-side INSERT OR IGNORE is the belt-and-braces.)
    if (!pane.dataset.brBound) {
      pane.dataset.brBound = '1';
      // ── Never leave the quick-edit panel. The lifted fragment's vehicle
      // forms POST + redirect to the full page; intercept every submit and
      // AJAX it instead, then refresh the pane + the floating card. ──
      function ajaxPaneForm(form) {
        var body = new URLSearchParams();
        try { new FormData(form).forEach(function (v, k) { body.append(k, typeof v === 'string' ? v : ''); }); } catch (e) {}
        if (!body.has('_csrf')) body.append('_csrf', csrf());
        return fetch(form.getAttribute('action') || location.pathname, {
          method: (form.getAttribute('method') || 'POST').toUpperCase(),
          headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body, credentials: 'same-origin',
        }).then(function () {
          boardDirty = true;
          refreshPane();
          try { if (typeof refreshFloatCard === 'function') refreshFloatCard(); } catch (e) {}
        }).catch(function () { toast('Could not save — try again.', 'error'); });
      }
      pane.addEventListener('submit', function (e) {
        var form = e.target.closest && e.target.closest('form');
        if (!form) return;
        e.preventDefault(); e.stopPropagation();
        ajaxPaneForm(form);
      }, true);
      pane.addEventListener('click', function (e) {
        var bid = currentBookingId();
        // Block page-navigating links inside the pane — the quick editor must
        // never bounce to the full edit page (only the explicit button does).
        var nav = e.target.closest && e.target.closest('a[href]');
        if (nav) {
          var href = nav.getAttribute('href') || '';
          if (/^\/bookings\/\d+/.test(href)) { e.preventDefault(); e.stopPropagation(); return; }
          if (/^\//.test(href) && !nav.target) { e.preventDefault(); e.stopPropagation(); window.open(href, '_blank'); return; }
        }
        // Vehicle edit toggle / cancel — reveal the inline editor for a row.
        var et = e.target.closest('.bv-edit-toggle, .bv-edit-cancel');
        if (et) {
          e.preventDefault(); e.stopPropagation();
          var vid = et.getAttribute('data-vehicle-id');
          var panel = pane.querySelector('.bv-edit-panel[data-vehicle-id="' + vid + '"]');
          if (panel) panel.classList.toggle('hidden');
          return;
        }
        // Remove × on the assigned chip — strips the worker off the booking.
        var rm = e.target.closest('[data-action="remove"]');
        if (rm) {
          e.preventDefault(); e.stopPropagation();
          var chip = rm.closest('.crew-chip');
          var cid = chip && chip.getAttribute('data-crew-id');
          if (!cid) return;
          postForm('/bookings/' + bid + '/crew/' + cid + '/remove', {}).then(function (res) {
            if (!res.ok) return toast(res.data.error || 'Could not remove crew.', 'error');
            boardDirty = true; refreshPane();
          });
          return;
        }
        // Driver × — clears the vehicle's driver slot.
        var cd = e.target.closest('[data-action="clear-driver"]');
        if (cd) {
          e.preventDefault(); e.stopPropagation();
          var vid = cd.getAttribute('data-vehicle-id');
          if (!vid) return;
          postForm('/bookings/' + bid + '/vehicles/' + vid + '/driver', { crew_member_id: '' }).then(function (res) {
            if (!res.ok) return toast(res.data.error || 'Could not clear driver.', 'error');
            boardDirty = true; refreshPane();
          });
          return;
        }
        // Pool chip — clicking adds the worker to the booking.
        var poolChip = e.target.closest('.crew-chip.pool');
        if (poolChip && !poolChip.classList.contains('is-assigned')) {
          e.preventDefault(); e.stopPropagation();
          if (poolChip.dataset.brBusy) return; // guard against a double-click
          var pid = poolChip.getAttribute('data-crew-id');
          if (!pid) return;
          poolChip.dataset.brBusy = '1';
          var role = poolChip.getAttribute('data-role') || '';
          postForm('/bookings/' + bid + '/crew', { crew_member_id: pid, role_on_site: role }).then(function (res) {
            if (!res.ok) { toast(res.data.error || 'Could not add crew.', 'error'); delete poolChip.dataset.brBusy; return; }
            // alreadyAssigned → silent no-op (no toast); just refresh.
            if (res.data && res.data.warning) toast('⚠ ' + res.data.warning);
            boardDirty = true; refreshPane();
          });
          return;
        }
      });

      // Search filter — also delegated off the pane so it survives refreshes.
      pane.addEventListener('input', function (e) {
        if (!e.target.matches('#crewPoolSearch')) return;
        var q = e.target.value.trim().toLowerCase();
        pane.querySelectorAll('.crew-chip.pool').forEach(function (c) {
          var hay = c.getAttribute('data-search') || (c.getAttribute('data-name') || '').toLowerCase();
          c.style.display = (!q || hay.indexOf(q) !== -1) ? '' : 'none';
        });
        pane.querySelectorAll('[data-pool-section]').forEach(function (s) {
          var hasVisible = Array.from(s.querySelectorAll('.crew-chip.pool')).some(function (c) { return c.style.display !== 'none'; });
          s.style.display = hasVisible ? '' : 'none';
        });
      });
    }

    // The Vehicles side has standard <form>s and a driver <select> that
    // already POST and navigate — they work as-is. Their redirect goes to
    // /bookings/:id which is fine: the user lands on the full edit page,
    // which they can always get back from via the board.
  }
  function setEditorTab(name) {
    $$('.bk2-edit-tab').forEach(function (t) {
      t.setAttribute('aria-selected', t.dataset.editTab === name ? 'true' : 'false');
    });
    $$('[data-edit-pane]').forEach(function (p) {
      p.hidden = p.dataset.editPane !== name;
      if (p.dataset.editPane === name) p.setAttribute('aria-current', 'true');
      else p.removeAttribute('aria-current');
    });
    // Lazy-load tab content from the full edit page the first time each
    // tab is opened in edit mode. Overview owns its own form (no fetch).
    // Tabs in TAB_TO_BK_TAB lift their section; others stay placeholder.
    var ed = $('#bk2-editor');
    if (ed && ed.dataset.existing === '1' && name !== 'overview') {
      if (name === 'reqplans' || name === 'reqperm') { try { if (window.bk2LoadDocPanes) window.bk2LoadDocPanes(true); } catch (e) {} }
      else if (name === 'resources') { try { loadResourcesTab(); } catch (e) {} }
      else loadBookingFragment(name);
    }
    // Leaving the Resources tab returns the reparented pool panel to the board.
    if (name !== 'resources') { try { bkPoolToBoard(); } catch (e) {} }
  }
  $$('.bk2-edit-tab').forEach(function (t) {
    t.addEventListener('click', function () { setEditorTab(t.dataset.editTab); });
  });
  var edClose = $('#bk2-edit-close'); if (edClose) edClose.addEventListener('click', closeEditor);
  var edBd = $('#bk2-edit-backdrop'); if (edBd) edBd.addEventListener('click', closeEditor);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      var ed = $('#bk2-editor'); if (ed && !ed.hidden) closeEditor();
    }
  });

  // Stepper buttons inside the Booking Requirements grid.
  $$('.bk2-create-stepper').forEach(function (st) {
    var input = st.querySelector('input[type="number"]');
    st.querySelectorAll('button[data-step]').forEach(function (b) {
      b.addEventListener('click', function () {
        var step = parseInt(b.dataset.step, 10) || 0;
        var v = Math.max(0, Math.min(20, (parseInt(input.value, 10) || 0) + step));
        input.value = v; input.dispatchEvent(new Event('input', { bubbles: true }));
      });
    });
  });

  // Live People/Vehicles/Equipment count under Booking Requirements.
  var REQ_PEOPLE_FIELDS = ['crew_size_1','crew_size_2','crew_size_3','crew_size_4','crew_size_5','addon_tc','addon_hoist','addon_labour','addon_spotter','addon_trainee','addon_security'];
  var REQ_VEHICLE_FIELDS = ['addon_pod_truck','addon_vms_ute','addon_vehicle'];
  function reqSum(fields, mul) {
    var s = 0;
    fields.forEach(function (f) {
      var el = document.querySelector('input[name="' + f + '"]'); if (!el) return;
      var v = parseInt(el.value, 10) || 0;
      s += v * (mul && mul[f] || 1);
    });
    return s;
  }
  function reqRepaint() {
    var crewMul = { crew_size_1: 1, crew_size_2: 2, crew_size_3: 3, crew_size_4: 4, crew_size_5: 5 };
    var pp = reqSum(REQ_PEOPLE_FIELDS, crewMul);
    var vv = reqSum(['crew_size_1','crew_size_2','crew_size_3','crew_size_4','crew_size_5'], { crew_size_1:1, crew_size_2:1, crew_size_3:1, crew_size_4:1, crew_size_5:1 }) + reqSum(REQ_VEHICLE_FIELDS);
    var allReqs = $$('.bk2-create-req input[type="number"]');
    var total = 0; allReqs.forEach(function (i) { total += (parseInt(i.value, 10) || 0); });
    var ee = Math.max(0, total - reqSum(REQ_PEOPLE_FIELDS.concat(['crew_size_1','crew_size_2','crew_size_3','crew_size_4','crew_size_5']).concat(REQ_VEHICLE_FIELDS)));
    var ppEl = $('#bk2-create-pp'); if (ppEl) ppEl.textContent = pp;
    var vvEl = $('#bk2-create-vv'); if (vvEl) vvEl.textContent = vv;
    var eeEl = $('#bk2-create-ee'); if (eeEl) eeEl.textContent = ee;
  }
  $$('.bk2-create-req input[type="number"]').forEach(function (i) { i.addEventListener('input', reqRepaint); });
  reqRepaint();

  // ── Client-scoped projects · location-context add — scoped to the
  //    quick-edit slide-over form (#bk2-edit-form). (The hire-picker card
  //    is gone; hired-ness comes from dragging hired units on.) ──
  (function () {
    var form = document.getElementById('bk2-edit-form'); if (!form) return;

    // ── Client-scoped Project dropdown ──
    var projSel = form.querySelector('[data-bk-project-select]');
    var projNewBtn = form.querySelector('[data-bk-project-new]');
    var projNewInput = form.querySelector('[data-bk-project-newinput]');
    function setProjects(list, selectId) {
      if (!projSel) return;
      projSel.innerHTML = '<option value="">— none —</option>';
      (list || []).forEach(function (p) {
        var o = document.createElement('option');
        o.value = p.id;
        o.textContent = (p.job_number ? p.job_number + ' — ' : '') + (p.job_name || ('Project ' + p.id));
        projSel.appendChild(o);
      });
      // Stay parked while the new-project input is open (mutual exclusion).
      projSel.disabled = !!(projNewInput && !projNewInput.hidden);
      if (projNewBtn) projNewBtn.hidden = false;
      if (selectId) projSel.value = String(selectId);
    }
    function clearProjects() {
      if (!projSel) return;
      projSel.innerHTML = '<option value="">Select a client first</option>';
      projSel.disabled = true;
      if (projNewBtn) { projNewBtn.hidden = true; projNewBtn.textContent = '+ New project'; }
      if (projNewInput) { projNewInput.hidden = true; projNewInput.value = ''; }
    }
    window.bk2LoadProjects = function (clientId, selectId) {
      if (!clientId) { clearProjects(); return; }
      fetch('/bookings/api/projects?client_id=' + encodeURIComponent(clientId), { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (j) { setProjects((j && j.projects) || [], selectId); })
        .catch(function () { setProjects([], selectId); });
    };
    document.addEventListener('bk2-client-changed', function (e) {
      var cid = e.detail && e.detail.clientId;
      if (cid) window.bk2LoadProjects(cid); else clearProjects();
    });
    // "+ New project" and the existing-project select are MUTUALLY EXCLUSIVE.
    // Before this, the select stayed live while the new-project input was
    // open, so the form could submit BOTH job_id and a stale typed name —
    // the typed name then leaked into the booking title / site address.
    if (projNewBtn) projNewBtn.addEventListener('click', function () {
      if (!projNewInput) return;
      var showing = !projNewInput.hidden;
      projNewInput.hidden = showing;
      if (!showing) {
        // opening: new-project mode — clear + park the select
        if (projSel) { projSel.value = ''; projSel.disabled = true; }
        projNewInput.focus();
        projNewBtn.textContent = '× Cancel';
      } else {
        // closing: back to pick-existing mode
        projNewInput.value = '';
        if (projSel) projSel.disabled = false;
        projNewBtn.textContent = '+ New project';
      }
    });
    if (projSel) projSel.addEventListener('change', function () {
      // Picking an existing project closes + empties the new-project input
      // so a leftover typed name can never ride along with job_id.
      if (projSel.value && projNewInput && !projNewInput.hidden) {
        projNewInput.hidden = true;
        projNewInput.value = '';
        if (projNewBtn) projNewBtn.textContent = '+ New project';
      }
    });

    // ── Location context: inline add row (no window.prompt) ──
    var locBtn = form.querySelector('[data-bk-loc-add]');
    var locSel = form.querySelector('[data-bk-loc-select]');
    var locRow = form.querySelector('[data-bk-loc-addrow]');
    var locInput = form.querySelector('[data-bk-loc-input]');
    var locSave = form.querySelector('[data-bk-loc-save]');
    var locCancel = form.querySelector('[data-bk-loc-cancel]');
    if (locBtn && locSel && locRow && locInput) {
      function openLocRow() { locRow.hidden = false; locInput.value = ''; setTimeout(function () { locInput.focus(); }, 20); }
      function closeLocRow() { locRow.hidden = true; locInput.value = ''; }
      function saveLoc() {
        var label = (locInput.value || '').trim();
        if (!label) { closeLocRow(); return; }
        var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
        locSave.disabled = true;
        fetch('/bookings/api/location-contexts', {
          method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'x-csrf-token': csrf }, credentials: 'same-origin',
          body: JSON.stringify({ label: label })
        }).then(function (r) { return r.json(); }).then(function (j) {
          if (j && j.ok) {
            locSel.innerHTML = '<option value="">Select Location Context</option>';
            (j.items || []).forEach(function (lc) { var o = document.createElement('option'); o.value = lc; o.textContent = lc; locSel.appendChild(o); });
            locSel.value = j.added || '';
          }
          closeLocRow();
        }).catch(function () { closeLocRow(); }).finally(function () { locSave.disabled = false; });
      }
      locBtn.addEventListener('click', function () { locRow.hidden ? openLocRow() : closeLocRow(); });
      if (locSave) locSave.addEventListener('click', saveLoc);
      if (locCancel) locCancel.addEventListener('click', closeLocRow);
      locInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); saveLoc(); }
        else if (e.key === 'Escape') { e.preventDefault(); closeLocRow(); }
      });
    }
  })();

  // Search filter for the requirements list.
  var reqSearch = $('.bk2-create-search');
  if (reqSearch) {
    reqSearch.addEventListener('input', function () {
      var q = this.value.toLowerCase();
      $$('.bk2-create-req').forEach(function (r) {
        r.style.display = (!q || (r.dataset.reqName || '').indexOf(q) !== -1) ? '' : 'none';
      });
    });
  }

  // Status pill clicks. In EDIT mode the pill actually saves the status via
  // POST /bookings/:id/status (previously it only toggled the CSS class, so
  // "Confirmed"/"Locked" etc. silently never saved). In create mode it stays
  // visual-only (no booking exists yet; /quick creates as unconfirmed).
  $$('.bk2-edit-statuspill').forEach(function (p) {
    p.addEventListener('click', function () {
      var prev = document.querySelector('.bk2-edit-statuspill.is-active');
      $$('.bk2-edit-statuspill').forEach(function (x) { x.classList.remove('is-active'); });
      p.classList.add('is-active');
      var ed = $('#bk2-editor');
      var id = ed && ed.dataset.existing === '1' && ed.dataset.bookingId;
      if (!id) return; // create mode — nothing to persist yet
      var status = p.getAttribute('data-status-set');
      var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      var body = new URLSearchParams(); body.append('_csrf', csrf); body.append('status', status);
      fetch('/bookings/' + id + '/status', {
        method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body, credentials: 'same-origin',
      }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
        .then(function (res) {
          if (!res.ok || !res.body.ok) throw new Error((res.body && res.body.error) || 'Could not update status');
          if (typeof window.bk2Toast === 'function') window.bk2Toast('Status → ' + (p.querySelector('.bk2-edit-statuspill-lbl') || p).textContent.trim(), 'success');
          boardDirty = true;
          syncDeleteBtn();   // reveal/hide "Delete shift" as the status changes
        })
        .catch(function (e) {
          // Revert the visual state so the pills never lie about what saved.
          p.classList.remove('is-active');
          if (prev) prev.classList.add('is-active');
          if (typeof window.bk2Toast === 'function') window.bk2Toast(e.message, 'error'); else alert(e.message);
        });
    });
  });

  // ── "Delete shift" — only for cancelled bookings ──
  // A booking can only be deleted once it's Cancel / Late Cancl. (a soft delete
  // via POST /:id/delete, which also cancels crew allocations + notifies). The
  // button lives in the status row and is shown only when the active status is
  // one of those AND we're editing an existing booking.
  function syncDeleteBtn() {
    var btn = document.getElementById('bk2-edit-delete');
    if (!btn) return;
    var ed = $('#bk2-editor');
    var isEdit = !!(ed && ed.dataset.existing === '1' && ed.dataset.bookingId);
    var active = document.querySelector('.bk2-edit-statuspill.is-active');
    var st = active ? active.getAttribute('data-status-set') : '';
    btn.hidden = !(isEdit && (st === 'cancelled' || st === 'late_cancellation'));
  }
  (function () {
    var delBtn = document.getElementById('bk2-edit-delete');
    if (!delBtn) return;
    delBtn.addEventListener('click', function () {
      var ed = $('#bk2-editor');
      var id = ed && ed.dataset.bookingId;
      if (!id) return;
      if (!confirm('Delete this cancelled shift? It will be removed from the board and the crew notified.')) return;
      var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      delBtn.disabled = true;
      fetch('/bookings/' + id + '/delete', {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ _csrf: csrf }),
        credentials: 'same-origin',
      }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
        .then(function (res) {
          if (!res.ok || !res.body.ok) throw new Error((res.body && res.body.error) || 'Could not delete the shift');
          if (typeof window.bk2Toast === 'function') window.bk2Toast('Shift deleted.', 'success');
          boardDirty = true;
          if (typeof closeEditor === 'function') closeEditor();
        })
        .catch(function (e) {
          delBtn.disabled = false;
          if (typeof window.bk2Toast === 'function') window.bk2Toast(e.message, 'error'); else alert(e.message);
        });
    });
  })();

  // Toggle the callout-time field's visibility based on the callout toggle.
  var calloutBox = document.querySelector('input[name="is_callout"]');
  var calloutWrap = document.querySelector('[data-show-when="is_callout"]');
  if (calloutBox && calloutWrap) {
    function syncCallout() { calloutWrap.style.display = calloutBox.checked ? '' : 'none'; }
    calloutBox.addEventListener('change', syncCallout); syncCallout();
  }

  // Booking type radio — highlight active card.
  $$('input[name="booking_type"]').forEach(function (r) {
    r.addEventListener('change', function () {
      $$('.bk2-create-typecard').forEach(function (c) { c.classList.remove('is-active'); });
      var card = r.closest('.bk2-create-typecard'); if (card) card.classList.add('is-active');
    });
  });

  // ── Create / Save submit — POST as JSON so we stay on the board ──
  // Same handler for both create (POST /bookings/quick → new booking) and
  // edit (POST /bookings/:id/quick-update → save). Distinguishes by the
  // editor's data-existing flag; uses the form's current action attribute,
  // which prefillEditForm sets to the right URL in edit mode.
  var createForm = $('#bk2-edit-form');

  // Belt-and-braces: explicit click handler on the green Save button
  // (the Create button relabelled by prefillEditForm) AND the legacy
  // gray #bk2-edit-save. The submit-via-form="…" attribute had been
  // failing for some planners — the button visibly depressed but the
  // form's submit event never fired. requestSubmit() forces it to
  // dispatch reliably; novalidate (set by prefillEditForm) keeps the
  // hidden-pane required fields from blocking it.
  function forceSubmit(e) {
    if (!createForm) return;
    if (e) e.preventDefault();
    if (typeof createForm.requestSubmit === 'function') {
      try { createForm.requestSubmit(); return; } catch (_) {}
    }
    createForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
  }
  var saveBtn1 = $('#bk2-edit-create');
  if (saveBtn1) saveBtn1.addEventListener('click', forceSubmit);
  var saveBtn2 = $('#bk2-edit-save');
  if (saveBtn2) {
    saveBtn2.removeAttribute('disabled');
    saveBtn2.addEventListener('click', forceSubmit);
  }

  // ── Clone (edit mode) — offers a with-crew / setup-only choice, then
  // POSTs to /bookings/:id/clone and opens the new booking. ──
  var cloneBtn = $('#bk2-edit-clone');
  if (cloneBtn) {
    function doClone(includeCrew) {
      var ed = $('#bk2-editor'); var id = ed && ed.dataset.bookingId;
      if (!id) return;
      var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      var body = new URLSearchParams(); body.append('_csrf', csrf); body.append('include_crew', includeCrew ? '1' : '0');
      cloneBtn.disabled = true;
      fetch('/bookings/' + id + '/clone', {
        method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body, credentials: 'same-origin',
      }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
        .then(function (res) {
          if (!res.ok || !res.body.ok) throw new Error((res.body && res.body.error) || 'Clone failed');
          if (typeof window.bk2Toast === 'function') window.bk2Toast('Cloned as ' + res.body.booking_number, 'success');
          // Open the board for the cloned shift's day (not the full edit page).
          window.location.href = '/bookings' + (res.body.date ? '?date=' + encodeURIComponent(res.body.date) : '');
        })
        .catch(function (e) { if (typeof window.bk2Toast === 'function') window.bk2Toast(e.message, 'error'); else alert(e.message); })
        .finally(function () { cloneBtn.disabled = false; });
    }
    // Small choice popover anchored under the Clone button.
    var cloneMenu = null;
    function closeCloneMenu() { if (cloneMenu) { cloneMenu.remove(); cloneMenu = null; document.removeEventListener('click', onDocClickClone, true); } }
    function onDocClickClone(e) { if (cloneMenu && !cloneMenu.contains(e.target) && e.target !== cloneBtn) closeCloneMenu(); }
    cloneBtn.addEventListener('click', function () {
      if (cloneMenu) { closeCloneMenu(); return; }
      cloneMenu = document.createElement('div');
      cloneMenu.className = 'bk2-clone-menu';
      cloneMenu.innerHTML = '<button type="button" data-clone-crew="1">Clone with crew</button>'
        + '<button type="button" data-clone-crew="0">Clone setup only</button>';
      var r = cloneBtn.getBoundingClientRect();
      cloneMenu.style.position = 'fixed';
      cloneMenu.style.top = (r.bottom + 6) + 'px';
      cloneMenu.style.left = Math.max(12, r.right - 200) + 'px';
      document.body.appendChild(cloneMenu);
      cloneMenu.addEventListener('click', function (e) {
        var b = e.target.closest('[data-clone-crew]'); if (!b) return;
        var inc = b.getAttribute('data-clone-crew') === '1';
        closeCloneMenu(); doClone(inc);
      });
      setTimeout(function () { document.addEventListener('click', onDocClickClone, true); }, 0);
    });
  }

  if (createForm) {
    createForm.addEventListener('submit', function (e) {
      var ed = document.querySelector('#bk2-editor');
      // No JS hijack on the full /:id/edit page form; only inside the overlay.
      if (!ed) return;
      var isEdit = ed.dataset.existing === '1';
      // Create mode: only the create slot — leave non-create modes alone.
      if (!isEdit && ed.dataset.mode !== 'create') return;
      e.preventDefault();
      var fd = new FormData(createForm);
      // Convert FormData → URLSearchParams so the request goes as
      // application/x-www-form-urlencoded. Sending FormData directly
      // makes fetch use multipart/form-data, which express.urlencoded()
      // can't parse — req.body ends up empty and every field looks
      // missing, which is exactly the "Missing: client, site address,
      // date, start time" error users were seeing on fully-filled forms.
      var body = new URLSearchParams();
      fd.forEach(function (v, k) { body.append(k, typeof v === 'string' ? v : (v && v.name ? v.name : '')); });
      // Sanity log so we can confirm the steppers are actually in the
      // payload when something looks wrong — useful when a requirement
      // appears to save but doesn't come back on reopen.
      try {
        var stepperSnapshot = {};
        ['crew_size_1','crew_size_2','crew_size_3','crew_size_4','crew_size_5'].forEach(function (k) { if (body.has(k)) stepperSnapshot[k] = body.get(k); });
        console.log('[bk2 save]', createForm.getAttribute('action'), 'steppers:', stepperSnapshot);
      } catch (e) {}
      var btn = $('#bk2-edit-create');
      // Save state: pill + label while in flight. Restored on success/error.
      var origLabel = btn ? btn.innerHTML : null;
      if (btn) {
        btn.disabled = true;
        btn.classList.add('is-saving');
        btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/><circle cx="12" cy="12" r="9"/></svg> Saving…';
      }
      var url = createForm.getAttribute('action') || '/bookings/quick';
      fetch(url, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: body,
        credentials: 'same-origin',
      }).then(function (r) {
        // Capture status + raw text so we can show useful diagnostics
        // when the server returns a non-JSON 500 page (e.g. unhandled
        // exception in the route).
        return r.text().then(function (text) {
          var data = {};
          try { data = JSON.parse(text); } catch (e) { /* not JSON */ }
          return { ok: r.ok, status: r.status, data: data, text: text };
        });
      }).then(function (result) {
        if (result.ok && result.data && result.data.ok) {
          var newId = result.data.id || (ed && ed.dataset.bookingId);
          // The save may have reconciled crew requirements → ute count
          // server-side (syncTCCrewVehicles). Drop the cached tab fragments so
          // Resources (and any other lifted tab) refetch fresh state next time
          // they're opened, instead of showing a stale vehicle count until the
          // whole editor is closed and reopened.
          fragmentDocCache = null;
          fragmentLoaded = {};
          if (isEdit) {
            // Existing booking saved — restore Save label + success toast.
            if (btn) { btn.disabled = false; btn.classList.remove('is-saving'); if (origLabel) btn.innerHTML = origLabel; }
            if (typeof window.bk2Toast === 'function') window.bk2Toast('Booking saved.', 'success');
            var savedTitle = $('#bk2-edit-created-title');
            if (savedTitle) savedTitle.textContent = 'Booking saved.';
            var savedRibbon = $('#bk2-edit-created');
            if (savedRibbon) {
              savedRibbon.hidden = false;
              setTimeout(function () { savedRibbon.hidden = true; }, 3500);
            }
            boardDirty = true;
          } else {
            // Brand-new booking — switch overlay into editing it.
            var newNum = result.data.booking_number || newId;
            if (ed) { ed.dataset.bookingId = newId; ed.dataset.existing = '1'; }
            var title = $('#bk2-edit-title');
            if (title) title.textContent = '#' + newNum + ' · ' +
              ((fd.get('client_name') || '') + (fd.get('site_label') ? ' · ' + fd.get('site_label') : '')).trim();
            setEditorMode('edit');
            setFullEditTarget(newId);
            var created = $('#bk2-edit-created');
            var createdTitle = $('#bk2-edit-created-title');
            if (createdTitle) createdTitle.textContent = 'Booking #' + newNum + ' created.';
            if (created) created.hidden = false;
            // Re-prefill the form against the now-saved booking so Save (not
            // Create-again) becomes the action.
            prefillEditForm(newId);
            setEditorTab('overview');
            // Float the new booking's card on the left, mirroring the edit
            // flow. The card doesn't exist in the DOM yet (the board refresh is
            // normally deferred to editor close), so refresh the board pane
            // first, then lift the new card out to float beside the editor.
            // boardDirty stays false — we've just refreshed.
            boardDirty = false;
            (function (floatId) {
              var p = (typeof window.bk2RefreshBoard === 'function') ? window.bk2RefreshBoard() : null;
              Promise.resolve(p).then(function () {
                try {
                  unfloatCard();
                  floatCardBesideEditor(document.querySelector('.bk2-card[data-booking-id="' + floatId + '"]'));
                } catch (e) {}
              });
            })(newId);
            if (btn) { btn.disabled = false; btn.classList.remove('is-saving'); if (origLabel) btn.innerHTML = origLabel; }
            if (typeof window.bk2Toast === 'function') window.bk2Toast('Booking #' + newNum + ' created.', 'success');
          }
        } else {
          // Show the most informative message we can extract.
          var msg = (result.data && result.data.error) ||
                    (result.status >= 500 ? ('Server error (HTTP ' + result.status + '). Try again or refresh the page.') : null) ||
                    (result.status === 0 ? 'Network error — check your connection.' : null) ||
                    ('Could not create the booking (HTTP ' + result.status + ').');
          // Log the raw body to the console for debugging.
          if (result.text && (!result.data || !result.data.error)) {
            console.warn('[bk2 quick] non-JSON response (HTTP ' + result.status + '):', result.text.slice(0, 600));
          }
          if (typeof window.bk2Toast === 'function') window.bk2Toast(msg, 'error'); else alert(msg);
          if (btn) { btn.disabled = false; btn.classList.remove('is-saving'); if (origLabel) btn.innerHTML = origLabel; }
        }
      }).catch(function (err) {
        console.warn('[bk2 quick] fetch failed:', err && err.message);
        if (typeof window.bk2Toast === 'function') window.bk2Toast('Network error — could not save.', 'error'); else alert('Could not create the booking — network error.');
        if (btn) { btn.disabled = false; btn.classList.remove('is-saving'); if (origLabel) btn.innerHTML = origLabel; }
      });
    });
  }

  $('#bk2-new-btn').addEventListener('click', openEditor);
  var emptyNew = $('#bk2-empty-new');
  if (emptyNew) emptyNew.addEventListener('click', openEditor);

  // Wire both "Open full edit page" controls — they're <a> with the href set
  // dynamically, so a plain click navigates. Nothing extra needed, but close
  // the editor first so the back button returns to the board cleanly.
  ['#bk2-edit-fulledit', '#bk2-edit-qv-fulledit'].forEach(function (sel) {
    var a = $(sel);
    if (a) a.addEventListener('click', function () { boardDirty = false; });
  });

  // ── Board "Open" → editor overlay ──
  // Clicking a booking card opens the tabbed editor overlay (edit mode) for
  // that booking instead of hard-navigating to the full page. The overlay's
  // "Open full edit page" button is the route to the whole-screen editor.
  // We only hijack plain left-clicks on the card's non-interactive chrome —
  // crew/vehicle slots, drag handles, buttons and nested links keep working,
  // and modified clicks (cmd/ctrl/middle) still open the full page in a new
  // tab via the anchor's href.
  var CARD_INTERACTIVE = 'button, a[href]:not(.bk2-card), input, select, textarea, label,' +
    '[data-bk-crew-drag], .bk2-slot, .bk2-slot--drop, .bk2-veh-slot, .bk2-unassigned,' +
    '.bk2-addon, [role="button"], [draggable="true"]';
  document.addEventListener('click', function (e) {
    if (e.defaultPrevented) return;
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    var card = e.target.closest && e.target.closest('.bk2-card');
    if (!card || !card.getAttribute('data-booking-id')) return;
    // The floated summary beside the editor is interactable (slots, drag
    // targets) but must never navigate or re-open the editor.
    if (card.classList.contains('bk2-card--floating')) {
      var hitF = e.target.closest(CARD_INTERACTIVE);
      if (!hitF || hitF === card) e.preventDefault();
      return;
    }
    var hit = e.target.closest(CARD_INTERACTIVE);
    if (hit && hit !== card && card.contains(hit)) return; // real control — leave it
    e.preventDefault();
    openEditorForBooking(
      card.getAttribute('data-booking-id'),
      card.getAttribute('data-booking-number'),
      card.getAttribute('data-booking-title')
    );
  });

  // Keyboard: N opens Quick Book, Esc closes it
  document.addEventListener('keydown', function (e) {
    var inField = e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName);
    if (e.key === 'Escape' && so.classList.contains('bk2-open')) { e.preventDefault(); closeQB(); return; }
    if (inField || e.metaKey || e.ctrlKey || e.altKey) {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter' && so.classList.contains('bk2-open')) {
        e.preventDefault(); var f = $('#bk2-qb-form'); if (f) f.requestSubmit();
      }
      return;
    }
    if (e.key === 'n' || e.key === 'N') { e.preventDefault(); openEditor(); }
  });

  // ============================================================
  //  QUICK BOOK form — steppers, summary, address autocomplete
  // ============================================================
  // Steppers — bumps + toggles the row's highlighted state when > 0
  $$('.bk2-stepper').forEach(function (s) {
    var input = s.querySelector('input');
    var row = s.closest('[data-comp-row]');
    function syncRow() {
      if (!row) return;
      var n = parseInt(input.value, 10) || 0;
      row.classList.toggle('bk2-comp-on', n > 0);
    }
    syncRow();
    s.querySelectorAll('button').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var delta = parseInt(btn.dataset.step, 10);
        var v = Math.max(0, Math.min(20, parseInt(input.value, 10) + delta));
        input.value = v;
        syncRow();
        refreshSummary();
      });
    });
  });
  function refreshSummary() {
    var crews = [];
    var totalCrews = 0;
    [1,2,3,4,5].forEach(function (n) {
      var inp = $('input[name="crew_size_' + n + '"]');
      var q = inp ? parseInt(inp.value, 10) || 0 : 0;
      if (q > 0) { crews.push(q + '× ' + n + '-man'); totalCrews += q; }
    });
    var addons = [];
    $$('input[name^="addon_"]').forEach(function (inp) {
      var q = parseInt(inp.value, 10) || 0;
      if (q > 0) {
        var row = inp.closest('[data-comp-row]');
        var label = row ? row.querySelector('span').textContent.trim() : inp.name.replace('addon_', '');
        addons.push(q + '× ' + label);
      }
    });
    var summary = $('#bk2-qb-summary');
    if (!summary) return;
    var crewLine = crews.length ? crews.join(' + ') : '1× 2-man (default)';
    var uteLine  = (totalCrews || 1) + ' ute' + ((totalCrews || 1) > 1 ? 's' : '');
    var line = 'Saving as: <strong>' + crewLine + ' · ' + uteLine;
    if (addons.length) line += ', with ' + addons.join(', ');
    summary.innerHTML = line + '.</strong>';
  }
  refreshSummary();

  // Address autocomplete via /bookings/api/places (Geoapify).
  //
  // The popover is portaled to <body> with position:fixed so the editor's
  // overflow-y:auto scroller can't clip it — that was the "glitch" (the box
  // appeared briefly then got cut off / hidden under the next card). Country
  // is detected once from the browser's timezone + language and sent as
  // ?cc= so suggestions skew local without HARD-restricting (handy for the
  // odd interstate site).
  function bkDetectCountry() {
    try {
      var tz = (Intl && Intl.DateTimeFormat && Intl.DateTimeFormat().resolvedOptions().timeZone) || '';
      // Map the broad continent prefix → country code. T&S is AU; this covers
      // common cases without lugging around a full IANA→ISO table.
      var map = { Australia: 'au', Pacific: 'nz', Europe: 'gb' };
      var head = (tz.split('/')[0] || '').trim();
      if (map[head]) return map[head];
      // Special-case a few specific zones we'd rather pin tighter.
      if (tz === 'Pacific/Auckland') return 'nz';
      if (tz === 'Pacific/Fiji') return 'fj';
      if (tz.indexOf('America/') === 0) return 'us';
      var lang = (navigator.language || '').toLowerCase();
      var m = lang.match(/-([a-z]{2})$/i);
      return m ? m[1].toLowerCase() : 'au'; // T&S default
    } catch (e) { return 'au'; }
  }
  var BK_ADDR_CC = bkDetectCountry();

  // Single shared portal popover — cheaper than one per input and means we
  // don't have to clone listeners on every newly-rendered form (e.g. the
  // overlay reopening). Anchored to whichever input most recently fired.
  var bkAddrBox = null;
  function bkAddrBoxEl() {
    if (bkAddrBox) return bkAddrBox;
    bkAddrBox = document.createElement('div');
    bkAddrBox.id = 'bk-addr-suggest';
    bkAddrBox.setAttribute('role', 'listbox');
    bkAddrBox.style.cssText = [
      'position:fixed', 'z-index:10050',
      'background:#fff', 'border:1px solid #D1D5DB',
      'border-radius:8px',
      'box-shadow:0 12px 32px rgba(15,23,42,0.16)',
      'max-height:280px', 'overflow:auto',
      'display:none', 'min-width:240px',
    ].join(';');
    document.body.appendChild(bkAddrBox);
    return bkAddrBox;
  }

  function bkAddrAttach(input) {
    if (!input || input.dataset.bkAddrBound === '1') return;
    input.dataset.bkAddrBound = '1';
    var form = input.closest('form');
    function setSibling(name, value) {
      // Same-form first (handles both forms living on the same page);
      // fall back to the legacy by-id targets the old Quick Book used.
      if (form) {
        var el = form.querySelector('[name="' + name + '"]');
        if (el) { el.value = (value == null) ? '' : String(value); return; }
      }
      var idMap = { suburb: 'bk2-addr-suburb', state: 'bk2-addr-state', postcode: 'bk2-addr-postcode', latitude: 'bk2-addr-lat', longitude: 'bk2-addr-lng' };
      var byId = document.getElementById(idMap[name]);
      if (byId) byId.value = (value == null) ? '' : String(value);
    }
    function esc(s) { return String(s == null ? '' : s).replace(/[<>&]/g, function (c) { return c === '<' ? '&lt;' : c === '>' ? '&gt;' : '&amp;'; }); }

    var timer = null;
    var lastResults = [];

    function position() {
      var box = bkAddrBoxEl();
      var r = input.getBoundingClientRect();
      box.style.left  = r.left + 'px';
      box.style.top   = (r.bottom + 4) + 'px';
      box.style.width = r.width + 'px';
    }
    function hide() {
      if (!bkAddrBox) return;
      bkAddrBox.style.display = 'none';
      bkAddrBox.innerHTML = '';
      bkAddrBox._owner = null;
    }
    function commit(r) {
      // Always look the owner up live — if the form was re-rendered (edit
      // mode prefill, openEditor reset) the closure-captured `input` could
      // be detached; the popover's _owner pointer is the most recent live
      // input that opened the popover.
      var target = (bkAddrBox && bkAddrBox._owner && document.body.contains(bkAddrBox._owner))
        ? bkAddrBox._owner
        : input;
      // Fill the Main address bar with the FULL address (street, suburb,
      // state, postcode) — the bare street alone was too thin to read at a
      // glance. Falls back to a manually-stitched line if formatted is
      // empty for some reason.
      var stitched = [r.site_address, r.suburb, [r.state, r.postcode].filter(Boolean).join(' ')]
        .filter(Boolean).join(', ');
