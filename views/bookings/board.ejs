      var types = (pane.getAttribute('data-doc-types') || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
      var list = pane.querySelector('[data-bk-docpane-list]');
      var id = editorBookingId();
      var matching = (docs || []).filter(function (d) { return types.indexOf(d.document_type) !== -1; });
      list.innerHTML = '';
      // Required-plans checklist — a TGS / TMP requirement on the booking
      // automatically shows here as a needed plan, ✓ once attached. Only on
      // the Plans pane (its type filter includes 'tgs').
      if (types.indexOf('tgs') !== -1 && requiredPlans && requiredPlans.length) {
        var strip = document.createElement('div');
        strip.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;';
        requiredPlans.forEach(function (rp) {
          var ok = rp.attached >= rp.required;
          var chip = document.createElement('span');
          chip.style.cssText = 'display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:600;'
            + (ok ? 'background:rgba(16,185,129,0.12);color:#059669;border:1px solid rgba(16,185,129,0.35);'
                  : 'background:rgba(245,158,11,0.12);color:#B45309;border:1px solid rgba(245,158,11,0.4);');
          // Plans inherited from the linked job count toward the requirement
          // (and show even with no requirement row, as "from job").
