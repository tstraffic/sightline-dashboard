    var DESC_TEMPLATE = [
      'SCOPE OF WORKS:',
      '',
      'MINIMUM REQUIREMENTS',
      '• PPE: hi-vis (Class D/N), hard hat, steel-capped boots',
      '• Plant / equipment:',
      '• Site access / parking:',
      '• Key hazards:',
      '• Plans / permits on site:'
    ].join('\n');
    var tmplBtn = document.getElementById('bk2-desc-template');
    var descBox = document.getElementById('bk2-desc-textarea');
    if (tmplBtn && descBox) {
      tmplBtn.addEventListener('click', function () {
        if (descBox.value.trim()) {
          if (typeof window.bk2Toast === 'function') window.bk2Toast('Description already has content — cleared it out first to use the template.', 'info');
          else if (!confirm('Replace the current description with the template?')) return;
        }
        descBox.value = DESC_TEMPLATE;
        descBox.focus();
        descBox.dispatchEvent(new Event('input', { bubbles: true }));
      });
    }

    // ── Date/time helpers: day-of-week label, ±1 day, presets, overnight ──
    var startDateEl = form.querySelector('[name="start_date"]');
    var startTimeEl = form.querySelector('[name="start_time"]');
    var endTimeEl = form.querySelector('[name="end_time"]');
    var dowEl = document.getElementById('bk2-start-dow');
    var overnightEl = document.getElementById('bk2-overnight-flag');
    var DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    function refreshDow() {
      if (!dowEl) return;
      var v = startDateEl && startDateEl.value;
      if (!v) { dowEl.textContent = ''; return; }
      var d = new Date(v + 'T00:00:00');
      dowEl.textContent = isNaN(d) ? '' : '· ' + DOW[d.getDay()];
    }
    function refreshOvernight() {
      if (!overnightEl) return;
      var s = startTimeEl && startTimeEl.value, e = endTimeEl && endTimeEl.value;
      overnightEl.textContent = (s && e && e <= s) ? '· next day' : '';
    }
    if (startDateEl) startDateEl.addEventListener('change', function () { refreshDow(); });
    if (startTimeEl) startTimeEl.addEventListener('change', refreshOvernight);
    if (endTimeEl) endTimeEl.addEventListener('change', refreshOvernight);
