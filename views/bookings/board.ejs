  })();

  // ============================================================
  //  DESCRIPTION TEMPLATE + DATE/TIME HELPERS + MOBILE LEGS
  // ============================================================
  (function () {
    var form = document.getElementById('bk2-edit-form');
    if (!form) return;

    // ── "Use template" — fills the description ONLY when it's empty, so we
