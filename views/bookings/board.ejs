        fetch('/bookings/api/places?q=' + encodeURIComponent(q) + (BK_ADDR_CC ? '&cc=' + encodeURIComponent(BK_ADDR_CC) : ''),
          { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (data) {
