                  <input type="text" name="mobile_leg_address[]" value="<%= lg.address || '' %>" placeholder="Location address" class="w-full px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-sm">
                </div>
                <button type="button" class="ff-leg-del w-9 h-9 flex items-center justify-center rounded-lg border border-red-300 bg-red-50 text-red-600 text-lg leading-none">×</button>
              </div>
              <div class="mt-2">
                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Notes</label>
                <input type="text" name="mobile_leg_notes[]" value="<%= lg.notes || '' %>" placeholder="Access, hazards, contact…" class="w-full px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-sm">
              </div>
            </div>
          <% }); %>
        </div>
        <template id="ff-leg-template">
          <div class="ff-leg border border-gray-200 rounded-lg p-3 bg-gray-50">
            <div class="flex gap-2 items-end">
              <div class="w-28">
                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Start</label>
                <input type="time" name="mobile_leg_start_time[]" class="w-full px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-sm">
              </div>
              <div class="flex-1">
                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Address</label>
                <input type="text" name="mobile_leg_address[]" placeholder="Location address" class="w-full px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-sm">
              </div>
              <button type="button" class="ff-leg-del w-9 h-9 flex items-center justify-center rounded-lg border border-red-300 bg-red-50 text-red-600 text-lg leading-none">×</button>
            </div>
            <div class="mt-2">
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Notes</label>
              <input type="text" name="mobile_leg_notes[]" placeholder="Access, hazards, contact…" class="w-full px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-sm">
            </div>
          </div>
        </template>
      </div>
    </div>
  </div>

  <!-- Section 5: SITE DOCUMENTS — placeholder. The actual upload UI lives
       OUTSIDE the main form (below) because nested <form> tags aren't
       valid HTML. The anchor + summary card here is the in-flow marker;
       the upload card sits at the bottom of the page so the file inputs
       can post multipart without hijacking the main edit submission. -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5" data-section="docs">
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <div>
        <h2 class="booking-form-section-header" style="margin-bottom:0;">SITE DOCUMENTS</h2>
        <p class="text-xs text-gray-500 mt-0.5">TGS / TMP / ROL / Stage Plans · visible to crew on the worker portal under DOCS.</p>
      </div>
      <% if (isEdit) { %>
        <a href="#sec-docs" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-brand-50 text-brand-700 text-xs font-semibold hover:bg-brand-100">
          <%= (typeof bookingDocuments !== 'undefined' ? bookingDocuments.length : 0) %> attached · Manage below ↓
        </a>
      <% } else { %>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800">
          Save booking first
        </span>
      <% } %>
    </div>
  </div>

  <!-- Section 6: BOOKING TYPE -->
  <div id="sec-type"></div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5" data-section="type">
    <h2 class="booking-form-section-header">BOOKING TYPE</h2>
    <div class="flex gap-6">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="radio" name="booking_type" value="regular" <%= !isEdit || val('booking_type') === 'regular' || !val('booking_type') ? 'checked' : '' %>
          class="text-brand-600 focus:ring-brand-500">
        <span class="text-sm text-gray-700 font-medium">Regular</span>
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="radio" name="booking_type" value="hire" <%= isEdit && val('booking_type') === 'hire' ? 'checked' : '' %>
          class="text-brand-600 focus:ring-brand-500">
        <span class="text-sm text-gray-700 font-medium">Hire</span>
      </label>
    </div>
  </div>

  <!-- Section 7: BOOKING REQUIREMENTS -->
  <div id="sec-req"></div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5" data-section="req">
    <h2 class="booking-form-section-header">BOOKING REQUIREMENTS</h2>
    <div id="requirements-grid">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">
            <th class="text-left pb-2 pr-2">Item Classification</th>
            <th class="text-left pb-2 pr-2 w-24">Qty</th>
            <th class="w-10 pb-2"></th>
          </tr>
        </thead>
        <tbody id="req-rows">
          <% if (existingReqs.length > 0) { existingReqs.forEach(r => { %>
          <tr class="req-row">
            <td class="pr-2 pb-2">
              <select name="req_resource_type" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
                <option value="">-- Select --</option>
                <% requirementTypes.forEach(rt => { %>
                  <option value="<%= rt %>" <%= r.resource_type === rt ? 'selected' : '' %>><%= rt %></option>
                <% }); %>
              </select>
            </td>
            <td class="pr-2 pb-2">
              <input type="number" name="req_quantity" value="<%= r.quantity_required %>" min="1"
                class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            </td>
            <td class="pb-2 text-center">
              <button type="button" onclick="this.closest('tr').remove(); updateReqTotals();"
                class="text-red-400 hover:text-red-600 transition p-1" title="Remove">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </td>
          </tr>
          <% }); } %>
        </tbody>
      </table>
      <button type="button" id="add-req-row"
        class="mt-2 inline-flex items-center gap-1.5 px-3 py-1.5 text-sm text-orange-600 hover:text-orange-800 border border-orange-300 rounded-lg hover:bg-orange-50 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Requirement
      </button>
    </div>
    <!-- Totals summary -->
    <div id="req-totals" class="mt-4 flex gap-6 text-sm font-medium text-gray-500 border-t border-gray-100 pt-3">
      <span>People: <strong id="total-people" class="text-gray-900">0</strong></span>
      <span>Vehicles: <strong id="total-vehicles" class="text-gray-900">0</strong></span>
      <span>Equipment: <strong id="total-equipment" class="text-gray-900">0</strong></span>
    </div>

    <!-- Hired equipment & suppliers — tick any gear hired in from another
         company and pick its supplier. Only ticked items record a supplier. -->
    <div class="mt-5 border-t border-gray-100 pt-4">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Hired equipment &amp; suppliers</label>
      <p class="text-xs text-gray-500 mb-2">Tick anything hired in from another company and choose the supplier.</p>
      <!-- Marker so the server knows this POST carried the hire picker even
           when every checkbox is unticked (unchecked boxes don't post). -->
      <input type="hidden" name="hire_grid_present" value="1">
      <div class="space-y-1.5">
        <% var _hi = (typeof hireItems !== 'undefined' ? hireItems : {}); %>
        <% (typeof hireableItems !== 'undefined' ? hireableItems : []).forEach(function (h) { var hk = h[0], hl = h[1]; var saved = _hi[hk]; %>
          <div class="bk-hire-row flex flex-wrap items-center gap-2" data-hire-key="<%= hk %>">
            <label class="inline-flex items-center gap-2 text-sm text-gray-800 min-w-[190px]">
              <input type="checkbox" name="hired_<%= hk %>" value="1" class="bk-hire-check w-4 h-4 rounded border-gray-300" <%= saved ? 'checked' : '' %>>
              <span><%= hl %></span>
            </label>
            <span class="bk-hire-supplier flex items-center gap-2 flex-1 min-w-[200px]" <%= saved ? '' : 'hidden' %>>
              <select name="supplier_id_<%= hk %>" class="bk-hire-supsel flex-1 px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm">
                <option value="">— supplier —</option>
                <% (typeof hireCompanies !== 'undefined' ? hireCompanies : []).forEach(function (hc) { %><option value="<%= hc.id %>" <%= saved && String(saved.hire_company_id) === String(hc.id) ? 'selected' : '' %>><%= hc.name %></option><% }); %>
                <option value="__new">+ Add new…</option>
              </select>
              <input type="text" name="supplier_name_<%= hk %>" class="bk-hire-supnew flex-1 px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm" placeholder="New supplier name" autocomplete="off" hidden>
            </span>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Existing requirements_text field for free-text instructions -->
    <div class="mt-4">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Requirements / Special Instructions</label>
      <textarea name="requirements_text" rows="2"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        placeholder="PPE requirements, site-specific rules, equipment needed..."><%= val('requirements_text') %></textarea>
    </div>
  </div>

  <!-- Section 8: BOOKING POOL + NOTES -->
  <div id="sec-pool"></div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5" data-section="pool">
    <h2 class="booking-form-section-header">BOOKING POOL & NOTES</h2>
    <div class="flex items-center gap-2 mb-4">
      <input type="checkbox" name="is_booking_pool" id="is_booking_pool" value="1" <%= checked('is_booking_pool') %>
        class="rounded border-gray-300 text-brand-600 focus:ring-brand-500">
      <label for="is_booking_pool" class="text-sm text-gray-700 font-medium">Add to booking pool</label>
      <span class="text-xs text-gray-400 ml-1">(Available for other planners to claim)</span>
    </div>
    <div>
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Internal Notes</label>
      <textarea name="notes" rows="3"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        placeholder="Internal notes about this booking..."><%= val('notes') %></textarea>
    </div>
  </div>

  <!-- Sticky save bar — visible on every tab so the user can save
       from any section without scrolling. Prev/Next walk between the
       form's sections in display order; "Save" submits the whole
       form (every tab's inputs are still in the DOM, just hidden). -->
  <div class="bk-savebar">
    <div class="bk-savebar-inner">
      <div class="flex items-center gap-1.5">
        <button type="button" id="bk-prev" class="bk-step-btn">← Prev</button>
        <button type="button" id="bk-next" class="bk-step-btn">Next →</button>
      </div>
      <div class="flex items-center gap-2">
        <a href="<%= isEdit ? '/bookings/' + booking.id : '/bookings' %>" class="px-4 py-2 text-sm text-gray-500 hover:text-gray-700">Cancel</a>
        <button type="submit" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition">
          <%= isEdit ? 'Update Booking' : 'Create Booking' %>
        </button>
      </div>
    </div>
  </div>

</form>

<!-- Site Documents — rendered OUTSIDE the main edit form so the upload +
     delete forms post multipart without hijacking the main save action. -->
<% if (isEdit) { %>
  <%
    var DOC_LABEL = { tgs:'TGS', tmp:'TMP', ctmp:'CTMP', rol:'ROL', rol_day:'ROL — Day', rol_night:'ROL — Night', stage_plan:'Stage Plan', swms:'SWMS', permit:'Permit', invoice:'Invoice', photo:'Photo', other:'Other' };
    function fmtSize(n) { if (!n) return ''; if (n < 1024) return n + ' B'; if (n < 1024*1024) return (n/1024).toFixed(1) + ' KB'; return (n/1048576).toFixed(1) + ' MB'; }
  %>
  <div id="sec-docs" class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5 mt-5" data-section="docs">
    <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
      <div>
        <h2 class="booking-form-section-header" style="margin-bottom:0;">SITE DOCUMENTS</h2>
        <p class="text-xs text-gray-500 mt-0.5">TGS / TMP / ROL / Stage Plans · visible to crew under each shift's DOCS tab.</p>
      </div>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-600">
        <%= (typeof bookingDocuments !== 'undefined' ? bookingDocuments.length : 0) %> attached
      </span>
    </div>

    <% if (bookingDocuments && bookingDocuments.length) { %>
      <ul class="divide-y divide-gray-100 mb-4 border border-gray-200 rounded-lg overflow-hidden">
        <% bookingDocuments.forEach(function (d) { %>
          <li class="flex items-center gap-3 px-3 py-2.5 hover:bg-gray-50">
            <div class="w-9 h-9 rounded-lg bg-red-50 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z"/><path d="M14 2v6h6M9 14h6M9 18h6M9 10h2"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <a href="/bookings/<%= booking.id %>/documents/<%= d.id %>/download" target="_blank" class="text-sm font-semibold text-brand-700 hover:underline truncate block">
                <%= d.title || d.original_name %>
              </a>
              <p class="text-[11px] text-gray-500">
                <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-bold bg-brand-50 text-brand-700"><%= DOC_LABEL[d.document_type] || d.document_type %></span>
                <% if (d.file_size) { %>· <%= fmtSize(d.file_size) %><% } %>
                <% if (d.uploader_name) { %>· <%= d.uploader_name %><% } %>
                · <%= new Date(d.created_at).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day:'numeric', month:'short' }) %>
              </p>
            </div>
            <form method="POST" action="/bookings/<%= booking.id %>/documents/<%= d.id %>/delete" onsubmit="return confirm('Delete this document? Workers will stop seeing it immediately.');">
              <%- include('../partials/csrf') %>
              <button type="submit" class="text-gray-400 hover:text-red-600 p-1" title="Delete">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V3a1 1 0 011-1h4a1 1 0 011 1v4"/></svg>
              </button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="rounded-lg border border-dashed border-gray-300 px-3 py-5 mb-4 text-center text-xs text-gray-500">
        No documents yet — upload the TGS / TMP / ROL / stage plans below.
      </div>
    <% } %>

    <form method="POST" action="/bookings/<%= booking.id %>/documents" enctype="multipart/form-data" class="space-y-2">
      <%- include('../partials/csrf') %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Type</label>
          <select name="document_type" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="tgs">TGS</option>
            <option value="tmp">TMP</option>
            <option value="ctmp">CTMP</option>
            <option value="rol">ROL</option>
            <option value="rol_day">ROL — Day</option>
            <option value="rol_night">ROL — Night</option>
            <option value="stage_plan">Stage Plan</option>
            <option value="swms">SWMS</option>
            <option value="permit">Permit</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Title (optional)</label>
          <input type="text" name="title" placeholder="e.g. TGS Stage 2.1 — Naremburn"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
      </div>
      <div class="flex items-end gap-2 flex-wrap">
        <input type="file" name="file" required accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.tiff"
          class="block flex-1 min-w-[180px] text-xs text-gray-700 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:bg-brand-50 file:text-brand-700 file:text-xs file:font-semibold">
        <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-brand-600 text-white text-sm font-semibold hover:bg-brand-700">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Upload
        </button>
      </div>
      <p class="text-[11px] text-gray-400">Up to 25 MB · PDF preferred · also accepts doc / docx / png / jpg / tiff.</p>
    </form>
  </div>
<% } %>

<script>
  // Auto-sync end date with start date if end date is empty
  const startDate = document.querySelector('input[name="start_date"]');
  const endDate = document.querySelector('input[name="end_date"]');
  if (startDate && endDate) {
    startDate.addEventListener('change', function() {
      if (!endDate.value) endDate.value = this.value;
    });
  }

  // Description "Use template" — fills only when empty (or after confirm).
  (function () {
    var DESC_TEMPLATE = [
      'SCOPE OF WORKS:', '', 'MINIMUM REQUIREMENTS',
      '• PPE: hi-vis (Class D/N), hard hat, steel-capped boots',
      '• Plant / equipment:', '• Site access / parking:',
      '• Key hazards:', '• Plans / permits on site:'
    ].join('\n');
    var btn = document.getElementById('ff-desc-template');
    var box = document.getElementById('ff-desc-textarea');
    if (btn && box) btn.addEventListener('click', function () {
      if (box.value.trim() && !confirm('Replace the current description with the template?')) return;
      box.value = DESC_TEMPLATE; box.focus();
    });
  })();

  // Mobile-works locations — reveal on toggle + add/remove rows.
  (function () {
    var toggle = document.getElementById('has_mobile_works');
    var wrap = document.getElementById('ff-legs-wrap');
    var list = document.getElementById('ff-legs-list');
    var tmpl = document.getElementById('ff-leg-template');
    function addLeg() {
      if (!tmpl || !list) return;
      list.appendChild(tmpl.content.firstElementChild.cloneNode(true));
    }
    if (toggle && wrap) toggle.addEventListener('change', function () {
      wrap.classList.toggle('hidden', !toggle.checked);
      if (toggle.checked && list && !list.children.length) addLeg();
    });
    var addBtn = document.getElementById('ff-leg-add');
    if (addBtn) addBtn.addEventListener('click', addLeg);
    if (list) list.addEventListener('click', function (e) {
      var del = e.target.closest('.ff-leg-del');
      if (del) { var leg = del.closest('.ff-leg'); if (leg) leg.remove(); }
    });
  })();

  // Requirements grid — add/remove rows
  const reqTypes = <%- JSON.stringify(requirementTypes) %>;

  // Categorize requirement types for totals.
  //   - "Nx TC Crew" packages = N traffic controllers + 1 ute (auto-vehicle)
  //   - Other people types: Hoist Operator / Labour / Security / Spotter
  //     / Traffic Controller (single) / Trainee — count as 1 person each
  //   - VMS Ute, Vehicle, Pod Truck, TMA (dry/wet hire) = vehicle counters
  const peopleTypes = ['1x TC Crew','2x TC Crew','3x TC Crew','4x TC Crew','5x TC Crew',
    'Hoist Operator','Labour','Security','Spotter','Traffic Controller','Trainee'];
  const vehicleTypes = ['Pod Truck','TMA (dry hire)','TMA (wet hire)','Traffic Ute','VMS Ute'];
  const equipmentTypes = ['Arrow Board','Light Tower','Portaboom','Speed Advisory Sign','VMS Board'];

  // Per-row people / auto-vehicle counts. "Nx TC Crew" ships N TCs + 1 ute.
  const peopleCounts  = { '1x TC Crew':1,'2x TC Crew':2,'3x TC Crew':3,'4x TC Crew':4,'5x TC Crew':5,
    'Hoist Operator':1,'Labour':1,'Security':1,'Spotter':1,'Traffic Controller':1,'Trainee':1 };
  // Items that AUTO-include a vehicle (one ute) when added. Displayed in
  // the totals as part of the vehicles count, so the office sees the
  // resulting head count + vehicle count without manually adding a Ute row.
  const autoVehicleCounts = { '1x TC Crew':1,'2x TC Crew':1,'3x TC Crew':1,'4x TC Crew':1,'5x TC Crew':1 };

  function createReqRow(type, qty) {
    const tr = document.createElement('tr');
    tr.className = 'req-row';
    let opts = '<option value="">-- Select --</option>';
    reqTypes.forEach(rt => { opts += '<option value="' + rt + '"' + (rt === type ? ' selected' : '') + '>' + rt + '</option>'; });
    tr.innerHTML = '<td class="pr-2 pb-2"><select name="req_resource_type" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" onchange="updateReqTotals()">' + opts + '</select></td>'
      + '<td class="pr-2 pb-2"><input type="number" name="req_quantity" value="' + (qty||1) + '" min="1" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" oninput="updateReqTotals()"></td>'
      + '<td class="pb-2 text-center"><button type="button" onclick="this.closest(\'tr\').remove(); updateReqTotals();" class="text-red-400 hover:text-red-600 transition p-1" title="Remove"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg></button></td>';
    return tr;
  }

  document.getElementById('add-req-row').addEventListener('click', function() {
    document.getElementById('req-rows').appendChild(createReqRow('', 1));
    updateReqTotals();
  });

  // Attach onchange/oninput to existing rows
  document.querySelectorAll('#req-rows select[name="req_resource_type"]').forEach(s => s.addEventListener('change', updateReqTotals));
  document.querySelectorAll('#req-rows input[name="req_quantity"]').forEach(s => s.addEventListener('input', updateReqTotals));

  function updateReqTotals() {
    let people = 0, vehicles = 0, equipment = 0;
    document.querySelectorAll('.req-row').forEach(row => {
      const type = row.querySelector('select[name="req_resource_type"]').value;
      const qty = parseInt(row.querySelector('input[name="req_quantity"]').value) || 0;
      if (peopleTypes.includes(type)) people += (peopleCounts[type] || 1) * qty;
      if (autoVehicleCounts[type]) vehicles += autoVehicleCounts[type] * qty;
      if (vehicleTypes.includes(type)) vehicles += qty;
      if (equipmentTypes.includes(type)) equipment += qty;
    });
    document.getElementById('total-people').textContent = people;
    document.getElementById('total-vehicles').textContent = vehicles;
    document.getElementById('total-equipment').textContent = equipment;
  }
  updateReqTotals();

  // ── Time Mask for HH:MM inputs ──
  // Users type digits; colon is auto-inserted after 2 digits.
  // Accepts paste of "14:30", "1430", or "1430:00" etc and normalises.
  function normaliseTime(raw) {
    if (!raw) return '';
    // Strip everything but digits
    var d = String(raw).replace(/\D/g, '');
    if (!d) return '';
    // Trim seconds if user pasted HH:MM:SS
    if (d.length >= 6) d = d.slice(0, 4);
    if (d.length === 1) return d;              // "1"
    if (d.length === 2) return d;              // "14" (colon added on blur)
    if (d.length === 3) return d.slice(0,2) + ':' + d.slice(2); // "14:3"
    return d.slice(0,2) + ':' + d.slice(2,4); // "14:30"
  }
  function validateTime(val) {
    if (!val) return '';
    var m = val.match(/^(\d{1,2}):?(\d{0,2})$/);
    if (!m) return val;
    var h = parseInt(m[1], 10);
    var mm = m[2] === '' ? 0 : parseInt(m[2], 10);
    if (isNaN(h) || h > 23) h = 23;
    if (isNaN(mm) || mm > 59) mm = 59;
    return String(h).padStart(2,'0') + ':' + String(mm).padStart(2,'0');
  }
  document.querySelectorAll('input[data-time-mask]').forEach(function(inp) {
    // Normalise prefilled value that might be HH:MM:SS from DB
    if (inp.value) inp.value = validateTime(inp.value.slice(0,5));

    inp.addEventListener('input', function(e) {
      var caret = inp.selectionStart;
      var before = inp.value;
      var next = normaliseTime(before);
      if (next !== before) {
        inp.value = next;
        // Keep caret at a sensible spot
        var delta = next.length - before.length;
        try { inp.setSelectionRange(caret + delta, caret + delta); } catch (err) {}
      }
    });
    inp.addEventListener('blur', function() {
      if (!inp.value) return;
      inp.value = validateTime(inp.value);
    });
    inp.addEventListener('paste', function(e) {
      e.preventDefault();
      var pasted = (e.clipboardData || window.clipboardData).getData('text');
      inp.value = validateTime(pasted);
    });
  });

  // ── Smart start defaults — empty until focused ──
  // Start date + start time render blank in create mode so the planner
  // sees clean inputs. The first time they tap into Start Time (or
  // Start Date), we pre-fill with today's date and the next whole hour
  // in Sydney — saves manual typing for the common case and still lets
  // them override.
  (function () {
    var startDateEl = document.querySelector('[data-bk-autofill="start_date"]');
    var startTimeEl = document.querySelector('[data-bk-autofill="start_time"]');
    if (!startDateEl && !startTimeEl) return;

    function sydneyNow() {
      // Build a wall-clock object for Australia/Sydney.
      var parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Australia/Sydney',
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', hour12: false,
      }).formatToParts(new Date()).reduce(function (acc, p) { acc[p.type] = p.value; return acc; }, {});
      return parts; // { year, month, day, hour, minute, ... }
    }
    function nextHourFromNow() {
      var p = sydneyNow();
      var h = parseInt(p.hour, 10);
      // Round UP to the next whole hour. If we're past minute 0, move to
      // h+1. Past 23 wraps to next day at 00 — handled by Date math.
      var d = new Date(p.year + '-' + p.month + '-' + p.day + 'T' + p.hour + ':00:00');
      d.setHours(d.getHours() + 1);
      var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
      return {
        date: d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()),
        time: pad(d.getHours()) + ':00',
      };
    }
    function prefill() {
      // Only pre-fill empty fields — never clobber what the planner typed.
      var next = nextHourFromNow();
      if (startDateEl && !startDateEl.value) startDateEl.value = next.date;
      if (startTimeEl && !startTimeEl.value) {
        startTimeEl.value = next.time;
        // Fire change so the +8h end-time logic below picks it up too.
        startTimeEl.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
    if (startTimeEl) startTimeEl.addEventListener('focus', prefill, { once: true });
    if (startDateEl) startDateEl.addEventListener('focus', prefill, { once: true });
  })();

  // ── Auto end-time = start + 8 hours ──
  // When the user picks a start time we default end_time to 8h later
  // (and roll end_date forward if it crosses midnight). The end fields
  // remain editable — once the user touches end_time/end_date manually
  // we stop auto-overwriting them.
  (function () {
    var sd = document.querySelector('[name="start_date"]');
    var st = document.querySelector('[name="start_time"]');
    var ed = document.querySelector('[name="end_date"]');
    var et = document.querySelector('[name="end_time"]');
    if (!st || !et) return;
    var endUserEdited = false;
    function markEdited() { endUserEdited = true; }
    et.addEventListener('input', markEdited);
    if (ed) ed.addEventListener('input', markEdited);

    function applyAutoEnd() {
      if (endUserEdited) return;
      if (!st.value) return;
      var parts = st.value.split(':');
      var h = parseInt(parts[0], 10), m = parseInt(parts[1] || '0', 10);
      if (isNaN(h) || isNaN(m)) return;
      var startDate = (sd && sd.value) ? sd.value : null;
      var d = startDate ? new Date(startDate + 'T00:00:00') : new Date();
      d.setHours(h, m, 0, 0);
      d.setHours(d.getHours() + 8);
      var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
      et.value = pad(d.getHours()) + ':' + pad(d.getMinutes());
      if (ed && startDate) {
        ed.value = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
      }
    }
    st.addEventListener('change', applyAutoEnd);
    if (sd) sd.addEventListener('change', applyAutoEnd);
  })();

  // ── Section tabs: show one section at a time ──
  // Each section's white card carries data-section="<name>"; this
  // hides all of them except the one the active tab points at. The
  // sequence drives Prev/Next so the planner can walk the form in
  // order without using the tab strip.
  (function () {
    var SEQUENCE = ['depot','client','schedule','location','docs','type','req','pool'];
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.bk-stab'));
    var panes = Array.prototype.slice.call(document.querySelectorAll('[data-section]'));
    if (!tabs.length) return;

    function show(name) {
      if (SEQUENCE.indexOf(name) === -1) name = 'depot';
      panes.forEach(function (el) { el.style.display = (el.getAttribute('data-section') === name) ? '' : 'none'; });
      tabs.forEach(function (t) { t.classList.toggle('is-active', t.getAttribute('data-tab') === name); });
      try { history.replaceState(null, '', '#sec-' + name); } catch (e) {}
      var prev = document.getElementById('bk-prev');
      var next = document.getElementById('bk-next');
      var i = SEQUENCE.indexOf(name);
      if (prev) prev.disabled = (i <= 0);
      if (next) next.disabled = (i >= SEQUENCE.length - 1);
    }

    tabs.forEach(function (t) {
      t.addEventListener('click', function () { show(t.getAttribute('data-tab')); });
    });
    var prev = document.getElementById('bk-prev');
    var next = document.getElementById('bk-next');
    if (prev) prev.addEventListener('click', function () {
      var cur = document.querySelector('.bk-stab.is-active');
      var i = cur ? SEQUENCE.indexOf(cur.getAttribute('data-tab')) : 0;
      show(SEQUENCE[Math.max(0, i - 1)]);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    if (next) next.addEventListener('click', function () {
      var cur = document.querySelector('.bk-stab.is-active');
      var i = cur ? SEQUENCE.indexOf(cur.getAttribute('data-tab')) : 0;
      show(SEQUENCE[Math.min(SEQUENCE.length - 1, i + 1)]);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Initial section from URL hash (so a #sec-X link still works).
    var hash = (location.hash || '').replace(/^#sec-/, '');
    show(hash || 'depot');

    // If the form fails validation on submit, switch to the first
    // tab that contains the invalid field — otherwise the browser's
    // "please fill in this field" tooltip points at a hidden input
    // and the user has no idea where the problem is.
    var form = document.querySelector('form[action^="/bookings"]');
    if (form) {
      form.addEventListener('invalid', function (ev) {
        var bad = ev.target;
        if (!bad) return;
        var pane = bad.closest('[data-section]');
        if (pane) show(pane.getAttribute('data-section'));
      }, true);
    }

    // Status pill row — clicking a pill writes to the hidden input
    // and visually marks it active. Used in place of the legacy
    // dropdown so the planner can see lifecycle colours at a glance.
    var statusInput = document.getElementById('bk-status-input');
    var statusRow = document.querySelector('.bk-statusrow');
    if (statusRow && statusInput) {
      statusRow.addEventListener('click', function (e) {
        var btn = e.target.closest('.bk-statuspill');
        if (!btn || !statusRow.contains(btn)) return;
        e.preventDefault();
        var val = btn.getAttribute('data-status');
        statusInput.value = val;
        statusRow.querySelectorAll('.bk-statuspill').forEach(function (p) {
          var on = p === btn;
          p.classList.toggle('is-active', on);
          p.setAttribute('aria-checked', on ? 'true' : 'false');
        });
      });
    }
  })();
</script>

<script>
  // Client-scoped Project dropdown + add-new · location-context inline add ·
  // hired-equipment supplier reveal. All on the full booking form.
  (function () {
    var clientSel = document.querySelector('select[name="client_id"]');
    var projSel = document.querySelector('[data-bk-project-select]');
    var projNewBtn = document.querySelector('[data-bk-project-new]');
    var projNewInput = document.querySelector('[data-bk-project-newinput]');
    var initialJob = <%- (isEdit && booking.job_id) ? JSON.stringify(String(booking.job_id)) : 'null' %>;

    function setProjects(list, selId) {
      if (!projSel) return;
      projSel.innerHTML = '<option value="">— none —</option>';
      (list || []).forEach(function (p) {
        var o = document.createElement('option');
        o.value = p.id;
        o.textContent = (p.job_number ? p.job_number + ' — ' : '') + (p.job_name || ('Project ' + p.id));
        projSel.appendChild(o);
      });
      projSel.disabled = false;
      if (projNewBtn) projNewBtn.hidden = false;
      if (selId) projSel.value = String(selId);
    }
    function clearProjects() {
      if (!projSel) return;
      projSel.innerHTML = '<option value="">-- Select a client first --</option>';
      projSel.disabled = true;
      if (projNewBtn) projNewBtn.hidden = true;
      if (projNewInput) { projNewInput.hidden = true; projNewInput.value = ''; }
    }
    function loadProjects(clientId, selId) {
      if (!clientId) { clearProjects(); return; }
      fetch('/bookings/api/projects?client_id=' + encodeURIComponent(clientId), { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (j) { setProjects((j && j.projects) || [], selId); })
        .catch(function () { setProjects([], selId); });
    }
    if (clientSel && projSel) {
      clientSel.addEventListener('change', function () { loadProjects(this.value, null); });
      if (clientSel.value) loadProjects(clientSel.value, initialJob); else clearProjects();
    }
    if (projNewBtn) projNewBtn.addEventListener('click', function () {
      if (!projNewInput) return;
      var showing = !projNewInput.hidden;
      projNewInput.hidden = showing;
      if (!showing) { if (projSel) projSel.value = ''; projNewInput.focus(); } else projNewInput.value = '';
    });

    // Location context inline add.
    var locBtn = document.querySelector('[data-bk-loc-add]');
    var locSel = document.querySelector('[data-bk-loc-select]');
    if (locBtn && locSel) locBtn.addEventListener('click', function () {
      var label = (window.prompt('New location context (e.g. Northern Compound):') || '').trim();
      if (!label) return;
      var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      fetch('/bookings/api/location-contexts', {
        method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'x-csrf-token': csrf }, credentials: 'same-origin',
        body: JSON.stringify({ label: label })
      }).then(function (r) { return r.json(); }).then(function (j) {
        if (!j || !j.ok) return;
        locSel.innerHTML = '<option value="">Select Location Context</option>';
        (j.items || []).forEach(function (lc) { var o = document.createElement('option'); o.value = lc; o.textContent = lc; locSel.appendChild(o); });
        locSel.value = j.added || '';
      }).catch(function () {});
    });

    // Hired equipment → supplier reveal.
    document.addEventListener('change', function (e) {
      if (e.target.classList && e.target.classList.contains('bk-hire-check')) {
        var row = e.target.closest('.bk-hire-row');
        var sup = row && row.querySelector('.bk-hire-supplier');
        if (sup) sup.hidden = !e.target.checked;
      }
      if (e.target.classList && e.target.classList.contains('bk-hire-supsel')) {
        var wrap = e.target.closest('.bk-hire-supplier');
        var isNew = e.target.value === '__new';
        var txt = wrap && wrap.querySelector('.bk-hire-supnew');
        if (txt) { txt.hidden = !isNew; if (!isNew) txt.value = ''; }
      }
    });
  })();
</script>

<style>
  /* Post-create nav — top-of-page link strip that lets the planner
     jump from Edit straight to the corresponding section on the
     view page. Visually echoes the Traffio "Overview / Resources /
     Tasks / Dockets / …" toolbar. */
  .bk-section-overnav { display: flex; gap: 4px; flex-wrap: wrap; padding-bottom: 8px; border-bottom: 1px solid #E5E7EB; }
  .bk-onav-tab {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 12px; border-radius: 8px;
    font-size: 12px; font-weight: 600; color: #4B5563;
    background: transparent; text-decoration: none; transition: background 0.12s;
  }
  .bk-onav-tab:hover { background: #F3F4F6; color: #111827; }
  .bk-onav-tab.is-active { background: #ECFDF5; color: #047857; }

  /* Section tabs — clearly distinguishable in both themes. Inactive
     pills are pale; the active one fills with the brand emerald so
     the planner can find their place at a glance even when paging
     through 8 sections. */
  .bk-section-tabs { gap: 4px !important; }
  .bk-stab {
    padding: 7px 14px; border-radius: 8px; border: 1px solid transparent;
    background: #fff; color: #475569; cursor: pointer;
    font-size: 12px; font-weight: 600; letter-spacing: 0.01em;
    transition: background 0.12s, color 0.12s, border-color 0.12s, box-shadow 0.12s;
    box-shadow: 0 1px 0 rgba(15,23,42,0.04);
  }
  .bk-stab:hover { background: #F8FAFC; color: #0F172A; border-color: #E2E8F0; }
  .bk-stab.is-active {
    background: #10B981; color: #fff; border-color: #059669;
    box-shadow: 0 1px 2px rgba(16,185,129,0.30), 0 0 0 3px rgba(16,185,129,0.12);
  }
  .bk-stab.is-active:hover { background: #059669; color: #fff; }

  /* Booking form field polish — inputs / selects pick up clearer
     borders and a tighter focus ring so the form feels like one
     cohesive component instead of separate Tailwind primitives. */
  .bk-input,
  [data-section] input[type="text"],
  [data-section] input[type="date"],
  [data-section] input[type="time"],
  [data-section] input[type="number"],
  [data-section] input[type="email"],
  [data-section] input[type="tel"],
  [data-section] textarea,
  [data-section] select {
    transition: border-color 0.12s, box-shadow 0.12s, background 0.12s;
  }

  /* === Status pill row (Depot section) =================================== */
  .bk-statusrow {
    display: flex; flex-wrap: wrap; gap: 6px;
    padding: 8px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
  }
  .bk-statuspill {
    appearance: none; border: 1px solid transparent; cursor: pointer;
    display: inline-flex; align-items: center; gap: 7px;
    padding: 7px 12px; border-radius: 9999px;
    background: #fff; color: #475569;
    font-size: 12px; font-weight: 600;
    box-shadow: 0 1px 0 rgba(15,23,42,0.04);
    transition: background 0.12s, color 0.12s, transform 0.05s, box-shadow 0.12s;
  }
  .bk-statuspill:hover { transform: translateY(-1px); box-shadow: 0 2px 6px rgba(15,23,42,0.08); }
  .bk-statuspill:active { transform: translateY(0); }
  .bk-statuspill-dot {
    width: 8px; height: 8px; border-radius: 9999px; flex-shrink: 0;
    background: var(--pill-c, #94A3B8);
    box-shadow: 0 0 0 2px rgba(255,255,255,0.6);
  }
  .bk-statuspill-label { line-height: 1; }

  /* Per-status colour palette — colours the dot in inactive state and
     fills the pill in active state. Picked so each lifecycle phase has
     its own identifiable hue. */
  .bk-status--client_booking    { --pill-c: #8B5CF6; }
  .bk-status--unconfirmed       { --pill-c: #64748B; }
  .bk-status--confirmed         { --pill-c: #3B82F6; }
  .bk-status--locked            { --pill-c: #1E40AF; }
  .bk-status--conflict          { --pill-c: #F59E0B; }
  .bk-status--green_to_go       { --pill-c: #10B981; }
  .bk-status--in_progress       { --pill-c: #14B8A6; }
  .bk-status--complete          { --pill-c: #0EA5E9; }
  .bk-status--finalised         { --pill-c: #6366F1; }
  .bk-status--cancelled         { --pill-c: #F43F5E; }
  .bk-status--late_cancellation { --pill-c: #DC2626; }
  .bk-status--on_hold           { --pill-c: #9CA3AF; }

  .bk-statuspill.is-active {
    background: var(--pill-c);
    color: #fff;
    border-color: rgba(0,0,0,0.10);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--pill-c) 45%, transparent),
                0 0 0 3px color-mix(in srgb, var(--pill-c) 18%, transparent);
  }
  .bk-statuspill.is-active .bk-statuspill-dot {
    background: #fff;
    box-shadow: 0 0 0 2px rgba(255,255,255,0.3);
  }
  .bk-statuspill.is-active:hover {
    background: color-mix(in srgb, var(--pill-c) 85%, #000 15%);
    transform: translateY(-1px);
  }

  /* Sticky bottom save bar — appears below the form, pinned to the
     bottom of the viewport so the planner can save from any section. */
  .bk-savebar {
    position: sticky; bottom: 0; z-index: 30; margin-top: 18px;
    background: rgba(249,250,251,0.96); backdrop-filter: blur(6px);
    border-top: 1px solid #E5E7EB;
    margin-left: -1rem; margin-right: -1rem;
    padding: 10px 1rem;
  }
  @media (min-width: 640px) { .bk-savebar { margin-left: -1.5rem; margin-right: -1.5rem; padding-left: 1.5rem; padding-right: 1.5rem; } }
  @media (min-width: 1024px) { .bk-savebar { margin-left: -2rem; margin-right: -2rem; padding-left: 2rem; padding-right: 2rem; } }
  .bk-savebar-inner { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .bk-step-btn {
    padding: 7px 12px; border-radius: 8px; border: 1px solid #E5E7EB;
    background: #fff; color: #374151; font-size: 12px; font-weight: 600;
    cursor: pointer; transition: background 0.12s;
  }
  .bk-step-btn:hover:not(:disabled) { background: #F9FAFB; }
  .bk-step-btn:disabled { opacity: 0.45; cursor: not-allowed; }

  /* Dark-mode polish so the form looks correct on both themes. */
  :root[data-theme="dark"] .bk-section-overnav { border-bottom-color: rgba(255,255,255,0.08); }
  :root[data-theme="dark"] .bk-onav-tab        { color: #94A3B8; }
  :root[data-theme="dark"] .bk-onav-tab:hover  { background: rgba(255,255,255,0.06); color: #F5F5F7; }
  :root[data-theme="dark"] .bk-onav-tab.is-active { background: rgba(16,185,129,0.16); color: #6EE7B7; }
  :root[data-theme="dark"] .bk-section-tabs    { background: rgba(15,17,21,0.92) !important; border-bottom-color: rgba(255,255,255,0.08) !important; }
  :root[data-theme="dark"] .bk-stab            { background: rgba(255,255,255,0.04); color: #CBD5E1; border-color: rgba(255,255,255,0.06); box-shadow: none; }
  :root[data-theme="dark"] .bk-stab:hover      { background: rgba(255,255,255,0.08); color: #F8FAFC; border-color: rgba(255,255,255,0.12); }
  :root[data-theme="dark"] .bk-stab.is-active  {
    background: #10B981; color: #fff; border-color: #059669;
    box-shadow: 0 1px 6px rgba(16,185,129,0.45), 0 0 0 3px rgba(16,185,129,0.18);
  }
  :root[data-theme="dark"] .bk-savebar         { background: rgba(15,17,21,0.92); border-top-color: rgba(255,255,255,0.08); }
  :root[data-theme="dark"] .bk-step-btn        { background: #1A1D24; color: #F5F5F7; border-color: rgba(255,255,255,0.08); }
  :root[data-theme="dark"] .bk-step-btn:hover:not(:disabled) { background: #20242C; }

  /* Status pill row — dark theme. Inactive pills sit on a dark slate
     background with their dot picking up the lifecycle colour; active
     pill fills with the colour and reads white. */
  :root[data-theme="dark"] .bk-statusrow      { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); }
  :root[data-theme="dark"] .bk-statuspill     { background: rgba(255,255,255,0.05); color: #CBD5E1; border-color: rgba(255,255,255,0.08); box-shadow: none; }
  :root[data-theme="dark"] .bk-statuspill:hover { background: rgba(255,255,255,0.10); color: #F8FAFC; box-shadow: 0 2px 8px rgba(0,0,0,0.30); }
  :root[data-theme="dark"] .bk-statuspill-dot { box-shadow: 0 0 0 2px rgba(15,23,42,0.6); }
