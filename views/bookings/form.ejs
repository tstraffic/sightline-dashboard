<% locals.currentPage = 'bookings' %>
<%
  const isEdit = typeof booking !== 'undefined' && booking;

  function val(field) {
    if (!isEdit || booking[field] == null) return '';
    return booking[field];
  }

  function selected(field, value) {
    if (!isEdit) return '';
    return String(booking[field]) === String(value) ? 'selected' : '';
  }

  function checked(field) {
    if (!isEdit) return '';
    return booking[field] ? 'checked' : '';
  }

  // Site contacts (JSON array of IDs)
  const siteContactIds = isEdit && booking.site_contacts_arr ? booking.site_contacts_arr : [];

  // Requirements grid prepopulation
  const existingReqs = isEdit && booking.requirements ? booking.requirements : [];

  const statusOptions = [
    { val: 'client_booking', label: 'Client Booking' },
    { val: 'unconfirmed', label: 'Unconfirmed' },
    { val: 'confirmed', label: 'Confirmed' },
    { val: 'locked', label: 'Locked' },
    { val: 'conflict', label: 'Conflict' },
    { val: 'green_to_go', label: 'Green to Go' },
    { val: 'in_progress', label: 'Ongoing' },
    { val: 'complete', label: 'Complete' },
    { val: 'finalised', label: 'Finalised' },
    { val: 'cancelled', label: 'Cancelled' },
    { val: 'late_cancellation', label: 'Late Cancellation' },
    { val: 'on_hold', label: 'On Hold' },
  ];

  // Resource picker options. "Nx TC Crew" ships N traffic controllers + 1
  // ute automatically (see peopleCounts and the auto-totals JS below).
  // Standalone "TMP" and "Traffic Guidance Scheme" entries dropped at the
  // office's request — TMP is captured via "TMP with Traffic Management"
  // and the TGS document lives on Site Documents now.
  const requirementTypes = [
    '1x TC Crew', '2x TC Crew', '3x TC Crew', '4x TC Crew', '5x TC Crew',
    'Arrow Board', 'Hoist Operator', 'Labour', 'Light Tower', 'Permit',
    'Pod Truck', 'Portaboom', 'Security', 'Speed Advisory Sign', 'Spotter',
    'TMA (dry hire)', 'TMA (wet hire)', 'TMP with Traffic Management',
    'Traffic Controller', 'Trainee', 'Traffic Ute', 'VMS Board', 'VMS Ute',
  ];
%>

<%- include('_backbar') %>

<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/bookings" class="hover:text-gray-900 transition">Bookings</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900"><%= isEdit ? 'Edit: ' + booking.booking_number : 'New Booking' %></span>
</div>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= isEdit ? 'Edit Booking' : 'New Booking' %></h1>
    <p class="text-gray-500 text-sm mt-0.5"><%= isEdit ? 'Update booking details and schedule' : 'Create a new booking for scheduling' %></p>
  </div>
  <% if (isEdit) { %>
    <a href="/bookings/<%= booking.id %>" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
      View booking
    </a>
  <% } %>
</div>

<% if (isEdit) { %>
  <!-- Single "Back to overview" link in edit mode. The previous
       version had a full Resources / Tasks / Dockets / Notes etc.
       strip here, but every tab navigated AWAY from edit to the
       view page, which made the strip feel like "section tabs that
       eject you". Cleaner to keep edit strictly about editing the
       form and surface section nav only on the view page. -->
  <div class="mb-3">
    <a href="/bookings/<%= booking.id %>" class="bk-onav-tab"><span>← Back to overview</span></a>
  </div>
<% } %>

<!-- SECTION TAB STRIP — toggles between the form's sections so only
     one is visible at a time. Replaces the prior anchor-link nav
     that scrolled within a single long page. -->
<nav class="bk-section-tabs sticky top-0 z-20 bg-gray-50/95 backdrop-blur-sm border-b border-gray-200 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 py-2 mb-5 overflow-x-auto" aria-label="Form sections">
  <div class="flex items-center gap-1.5 text-xs font-semibold whitespace-nowrap" id="bk-section-tablist">
    <button type="button" data-tab="depot"    class="bk-stab is-active">Depot</button>
    <button type="button" data-tab="client"   class="bk-stab">Client</button>
    <button type="button" data-tab="schedule" class="bk-stab">Schedule</button>
    <button type="button" data-tab="location" class="bk-stab">Location</button>
    <button type="button" data-tab="docs"     class="bk-stab">Site Docs</button>
    <button type="button" data-tab="type"     class="bk-stab">Type</button>
    <button type="button" data-tab="req"      class="bk-stab">Requirements</button>
    <button type="button" data-tab="pool"     class="bk-stab">Pool / Notes</button>
  </div>
</nav>

<form method="POST" action="<%= isEdit ? '/bookings/' + booking.id : '/bookings' %>" class="space-y-5">
  <%- include('../partials/csrf') %>

  <!-- Section 1: BOOKING DEPOT -->
  <div id="sec-depot"></div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5" data-section="depot">
    <h2 class="booking-form-section-header">BOOKING DEPOT</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Depot <span class="text-red-500">*</span></label>
        <select name="depot" required class="bk-input w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select Depot --</option>
          <% depots.forEach(d => { %>
            <option value="<%= d %>" <%= val('depot') === d ? 'selected' : '' %>><%= d %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Supervisor</label>
        <select name="supervisor_id" class="bk-input w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select Supervisor --</option>
          <% supervisors.forEach(s => { %>
            <option value="<%= s.id %>" <%= isEdit && booking.supervisor_id == s.id ? 'selected' : '' %>><%= s.full_name %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <!-- Visual status lifecycle picker. Replaces the legacy <select>
         so the planner can see at a glance which state the booking
         is in. Each pill carries its lifecycle colour; clicking sets
         the hidden status input and highlights the active pill. -->
    <div class="mt-5">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Status</label>
      <input type="hidden" name="status" id="bk-status-input" value="<%= val('status') || 'unconfirmed' %>">
      <div class="bk-statusrow" role="radiogroup" aria-label="Booking status">
        <% statusOptions.forEach(s => { %>
          <button type="button"
                  class="bk-statuspill bk-status--<%= s.val %> <%= (val('status') || 'unconfirmed') === s.val ? 'is-active' : '' %>"
                  data-status="<%= s.val %>"
                  role="radio"
                  aria-checked="<%= (val('status') || 'unconfirmed') === s.val ? 'true' : 'false' %>"
                  title="<%= s.label %>">
            <span class="bk-statuspill-dot"></span>
            <span class="bk-statuspill-label"><%= s.label %></span>
          </button>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Section 2: CLIENT INFORMATION -->
  <div id="sec-client"></div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5" data-section="client">
    <h2 class="booking-form-section-header">CLIENT INFORMATION</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest">Client <span class="text-red-500">*</span></label>
          <button type="button" id="addClientBtn"
            class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            New client
          </button>
        </div>
        <select name="client_id" required class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select Client --</option>
          <% if (typeof clients !== 'undefined' && clients.length) { clients.forEach(c => { %>
            <option value="<%= c.id %>" <%= isEdit && booking.client_id == c.id ? 'selected' : '' %>><%= c.company_name %></option>
          <% }); } %>
        </select>
      </div>
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest">Job / Project</label>
          <button type="button" data-bk-project-new hidden class="text-xs font-semibold text-brand-600 hover:text-brand-700">+ New project</button>
        </div>
        <select name="job_id" data-bk-project-select class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select a client first --</option>
        </select>
        <input type="text" name="site_label" data-bk-project-newinput placeholder="New project name" autocomplete="off" hidden
          class="w-full mt-1.5 px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest">Location Context</label>
          <button type="button" data-bk-loc-add class="text-xs font-semibold text-brand-600 hover:text-brand-700">+ Add</button>
        </div>
        <select name="location_context" data-bk-loc-select class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">Select Location Context</option>
          <% var _lcCur = val('location_context'); var _lcs = (typeof locationContexts !== 'undefined' ? locationContexts : []); var _lcHas = false; %>
          <% _lcs.forEach(function (lc) { _lcHas = _lcHas || (lc === _lcCur); %><option value="<%= lc %>" <%= lc === _lcCur ? 'selected' : '' %>><%= lc %></option><% }); %>
          <% if (_lcCur && !_lcHas) { %><option value="<%= _lcCur %>" selected><%= _lcCur %></option><% } %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Billing Code</label>
        <input type="text" name="billing_code" value="<%= val('billing_code') %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          placeholder="Cost centre or billing code">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Client Contact</label>
        <input type="text" name="client_contact" value="<%= val('client_contact') %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          placeholder="Contact name or phone">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Requester</label>
        <!-- Options are the selected client's contacts, rebuilt by JS from
             ALL_CONTACTS whenever the client changes (see syncReqPlan). -->
        <select name="requester_id" id="requesterSelect" data-selected="<%= isEdit && booking.requester_id ? booking.requester_id : '' %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select a client first --</option>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Planner</label>
        <select name="planner_id" id="plannerSelect" data-selected="<%= isEdit && booking.planner_id ? booking.planner_id : '' %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select a client first --</option>
        </select>
      </div>
    </div>
    <!-- Site Contacts — scoped to the selected client, with inline add -->
    <div class="mt-4" id="siteContactsBlock">
      <div class="flex items-center justify-between mb-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest">Site Contacts <span id="siteContactsCount" class="text-gray-400 normal-case tracking-normal font-medium"></span></label>
        <button type="button" id="addSiteContactBtn" disabled
          class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700 disabled:text-gray-300 disabled:cursor-not-allowed">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Add contact
        </button>
      </div>
      <!-- Selected contacts as removable chips (source of truth for submit) -->
      <div id="siteContactsChips" class="flex flex-wrap gap-2 mb-2 hidden"></div>
      <!-- Search + scrollable toggle list (scales to 50+ contacts) -->
      <input type="text" id="siteContactsSearch" placeholder="Search contacts…" autocomplete="off" disabled
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm mb-2 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent disabled:bg-gray-50 disabled:text-gray-400">
      <div id="siteContactsList" class="max-h-40 overflow-y-auto border border-gray-200 rounded-lg p-1 flex flex-col gap-0.5"></div>
      <p id="siteContactsHint" class="text-xs text-gray-400 mt-2">Select a client above to choose or add site contacts.</p>
    </div>
  </div>

  <!-- Quick-add CLIENT modal — creates a new client company inline, then
       selects it in the dropdown (posts via fetch, not the booking submit) -->
  <div id="clientModal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md">
      <div class="p-5 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">New client</h2>
        <p class="text-sm text-gray-500 mt-1">Creates a client company you can book against right away.</p>
      </div>
      <div class="p-5 space-y-3">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Company Name <span class="text-red-500">*</span></label>
          <input type="text" id="clm_company_name" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="e.g. Acme Roads Pty Ltd">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">ABN</label>
            <input type="text" id="clm_abn" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="optional">
          </div>
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Primary Contact</label>
            <input type="text" id="clm_contact_name" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="optional">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Contact Phone</label>
            <input type="tel" id="clm_contact_phone" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="optional">
          </div>
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Contact Email</label>
            <input type="email" id="clm_contact_email" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="optional">
          </div>
        </div>
        <p id="clm_error" class="hidden text-sm text-red-600"></p>
      </div>
      <div class="px-5 py-4 bg-gray-50 rounded-b-xl flex items-center justify-end gap-2">
        <button type="button" id="clm_cancel" class="px-4 py-2 bg-white border border-gray-300 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">Cancel</button>
        <button type="button" id="clm_save" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg">Save client</button>
      </div>
    </div>
  </div>

  <!-- Quick-add contact modal (lives inside the booking form; the inner
       fields post via fetch, not as part of the booking submit) -->
  <div id="contactModal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md">
      <div class="p-5 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">New site contact</h2>
        <p class="text-sm text-gray-500 mt-1">Saved as a contact for <span id="contactModalClient" class="font-medium text-gray-700">the selected client</span>.</p>
      </div>
      <div class="p-5 space-y-3">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Full Name <span class="text-red-500">*</span></label>
          <input type="text" id="cm_full_name" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="e.g. Jane Smith">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Position / Role</label>
          <input type="text" id="cm_position" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="e.g. Site Manager">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Phone</label>
            <input type="tel" id="cm_phone" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="04xx xxx xxx">
          </div>
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Email</label>
            <input type="email" id="cm_email" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="name@company.com">
          </div>
        </div>
        <p id="cm_error" class="hidden text-sm text-red-600"></p>
      </div>
      <div class="px-5 py-4 bg-gray-50 rounded-b-xl flex items-center justify-end gap-2">
        <button type="button" id="cm_cancel" class="px-4 py-2 bg-white border border-gray-300 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">Cancel</button>
        <button type="button" id="cm_save" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg">Save contact</button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var ALL_CONTACTS = <%- JSON.stringify((typeof contacts !== 'undefined' && contacts) ? contacts : []) %>;
      var selectedIds = <%- JSON.stringify(siteContactIds.map(String)) %>;

      var clientSelect = document.querySelector('select[name="client_id"]');
      var clientOption = function () { return clientSelect.options[clientSelect.selectedIndex]; };
      var listEl = document.getElementById('siteContactsList');
      var hintEl = document.getElementById('siteContactsHint');
      var addBtn = document.getElementById('addSiteContactBtn');
      var chipsEl = document.getElementById('siteContactsChips');
      var searchEl = document.getElementById('siteContactsSearch');
      var countEl = document.getElementById('siteContactsCount');

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function byId(id) {
        id = String(id);
        for (var i = 0; i < ALL_CONTACTS.length; i++) { if (String(ALL_CONTACTS[i].id) === id) return ALL_CONTACTS[i]; }
        return { id: id, full_name: 'Contact #' + id };
      }
      function clientRows() {
        // Contacts for this client, plus any already-selected ones (so an
        // existing selection is never silently dropped on edit).
        var clientId = clientSelect.value;
        return ALL_CONTACTS.filter(function (c) {
          return String(c.company_id) === String(clientId) || selectedIds.indexOf(String(c.id)) !== -1;
        });
      }
      function toggle(id) {
        id = String(id);
        if (selectedIds.indexOf(id) === -1) selectedIds.push(id);
        else selectedIds = selectedIds.filter(function (x) { return x !== id; });
        renderChips(); renderResults();
      }

      function renderChips() {
        // Hidden inputs named site_contacts carry the selection on submit.
        if (!selectedIds.length) { chipsEl.innerHTML = ''; chipsEl.classList.add('hidden'); return; }
        chipsEl.classList.remove('hidden');
        chipsEl.innerHTML = selectedIds.map(function (id) {
          var c = byId(id);
          return '<span class="inline-flex items-center gap-1.5 bg-brand-50 border border-brand-200 text-brand-700 rounded-full pl-3 pr-1.5 py-1 text-xs">' +
            '<span>' + esc(c.full_name) + (c.position ? ' <span class="text-brand-400">· ' + esc(c.position) + '</span>' : '') + '</span>' +
            '<button type="button" data-remove="' + esc(String(id)) + '" class="text-brand-400 hover:text-brand-700 text-sm leading-none px-0.5" aria-label="Remove">&times;</button>' +
            '<input type="hidden" name="site_contacts" value="' + esc(String(id)) + '">' +
            '</span>';
        }).join('');
      }

      function renderResults() {
        var clientId = clientSelect.value;
        addBtn.disabled = !clientId;
        if (!clientId) {
          listEl.innerHTML = ''; listEl.classList.add('hidden');
          searchEl.disabled = true; searchEl.classList.add('hidden');
          if (countEl) countEl.textContent = '';
          hintEl.textContent = 'Select a client above to choose or add site contacts.';
          hintEl.classList.remove('hidden');
          return;
        }
        searchEl.disabled = false; searchEl.classList.remove('hidden');
        var rows = clientRows();
        var filter = (searchEl.value || '').trim().toLowerCase();
        var shown = rows.filter(function (c) {
          if (!filter) return true;
          return (c.full_name + ' ' + (c.position || '') + ' ' + (c.phone || '')).toLowerCase().indexOf(filter) !== -1;
        });
        if (countEl) countEl.textContent = selectedIds.length
          ? '(' + selectedIds.length + ' selected · ' + shown.length + ' of ' + rows.length + ')'
          : (rows.length ? '(' + shown.length + ' of ' + rows.length + ')' : '');
        listEl.classList.remove('hidden');
        if (!rows.length) {
          listEl.innerHTML = '';
          hintEl.textContent = 'No contacts yet for this client. Use “Add contact” to create one.';
          hintEl.classList.remove('hidden');
          return;
        }
        if (!shown.length) {
          listEl.innerHTML = '';
          hintEl.textContent = 'No contacts match “' + filter + '”.';
          hintEl.classList.remove('hidden');
          return;
        }
        hintEl.classList.add('hidden');
        listEl.innerHTML = shown.map(function (c) {
          var idStr = String(c.id);
          var sel = selectedIds.indexOf(idStr) !== -1;
          var sub = c.position || c.phone || '';
          return '<button type="button" data-toggle="' + idStr + '" class="flex items-center gap-2 w-full text-left text-sm px-2 py-1.5 rounded ' + (sel ? 'bg-brand-50' : 'hover:bg-gray-50') + '">' +
            '<span class="w-4 text-brand-600 font-bold">' + (sel ? '✓' : '') + '</span>' +
            '<span class="text-gray-700">' + esc(c.full_name) + (sub ? ' <span class="text-gray-400 text-xs">· ' + esc(sub) + '</span>' : '') + '</span>' +
            '</button>';
        }).join('');
      }

      function renderList() { renderChips(); renderResults(); }

      // Requester + Planner are chosen from the SELECTED CLIENT's contacts.
      // Rebuild both selects from ALL_CONTACTS on every client change,
      // preserving a saved pick (data-selected) whenever it's still valid.
      var reqSel = document.getElementById('requesterSelect');
      var planSel = document.getElementById('plannerSelect');
      function syncReqPlan() {
        var clientId = clientSelect.value;
        [reqSel, planSel].forEach(function (sel) {
          if (!sel) return;
          var keep = sel.value || sel.getAttribute('data-selected') || '';
          var rows = ALL_CONTACTS.filter(function (c) { return String(c.company_id) === String(clientId); });
          sel.innerHTML = clientId
            ? '<option value="">-- None --</option>'
            : '<option value="">-- Select a client first --</option>';
          rows.forEach(function (c) {
            var o = document.createElement('option');
            o.value = String(c.id);
            o.textContent = c.full_name + (c.position ? ' · ' + c.position : '');
            if (String(c.id) === String(keep)) o.selected = true;
            sel.appendChild(o);
          });
          sel.setAttribute('data-selected', '');
        });
      }
      clientSelect.addEventListener('change', syncReqPlan);
      syncReqPlan();

      listEl.addEventListener('click', function (e) {
        var b = e.target.closest('[data-toggle]');
        if (b) { e.preventDefault(); toggle(b.getAttribute('data-toggle')); }
      });
      chipsEl.addEventListener('click', function (e) {
        var x = e.target.closest('[data-remove]');
        if (x) { e.preventDefault(); toggle(x.getAttribute('data-remove')); }
      });
      searchEl.addEventListener('input', renderResults);
      clientSelect.addEventListener('change', function () { searchEl.value = ''; renderList(); });
      renderList();

      // ---- Modal ----
      var modal = document.getElementById('contactModal');
      var clientLabel = document.getElementById('contactModalClient');
      var errEl = document.getElementById('cm_error');
      var fields = {
        full_name: document.getElementById('cm_full_name'),
        position: document.getElementById('cm_position'),
        phone: document.getElementById('cm_phone'),
        email: document.getElementById('cm_email')
      };

      function openModal() {
        if (!clientSelect.value) return;
        errEl.classList.add('hidden'); errEl.textContent = '';
        Object.keys(fields).forEach(function (k) { fields[k].value = ''; });
        clientLabel.textContent = clientOption() ? clientOption().textContent : 'the selected client';
        modal.classList.remove('hidden');
        setTimeout(function () { fields.full_name.focus(); }, 30);
      }
      function closeModal() { modal.classList.add('hidden'); }

      addBtn.addEventListener('click', openModal);
      document.getElementById('cm_cancel').addEventListener('click', closeModal);
      modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal(); });

      var saveBtn = document.getElementById('cm_save');
      saveBtn.addEventListener('click', function () {
        var name = fields.full_name.value.trim();
        if (!name) { errEl.textContent = 'Contact name is required.'; errEl.classList.remove('hidden'); fields.full_name.focus(); return; }

        var meta = document.querySelector('meta[name="csrf-token"]');
        saveBtn.disabled = true; saveBtn.textContent = 'Saving…';
        fetch('/contacts/api/quick-create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': meta ? meta.content : '' },
          credentials: 'same-origin',
          body: JSON.stringify({
            company_id: clientSelect.value,
            full_name: name,
            position: fields.position.value.trim(),
            phone: fields.phone.value.trim(),
            email: fields.email.value.trim()
          })
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
          .then(function (res) {
            if (!res.ok || !res.body.success) { throw new Error(res.body.error || 'Failed to save contact.'); }
            var c = res.body.contact;
            ALL_CONTACTS.push(c);
            selectedIds.push(String(c.id));
            closeModal();
            renderList();
          })
          .catch(function (err) { errEl.textContent = err.message; errEl.classList.remove('hidden'); })
          .finally(function () { saveBtn.disabled = false; saveBtn.textContent = 'Save contact'; });
      });
    })();
  </script>

  <script>
    // ---- New-client quick add ----
    (function () {
      var clientSelect = document.querySelector('select[name="client_id"]');
      var addBtn = document.getElementById('addClientBtn');
      var modal = document.getElementById('clientModal');
      if (!clientSelect || !addBtn || !modal) return;

      var errEl = document.getElementById('clm_error');
      var f = {
        company_name: document.getElementById('clm_company_name'),
        abn: document.getElementById('clm_abn'),
        primary_contact_name: document.getElementById('clm_contact_name'),
        primary_contact_phone: document.getElementById('clm_contact_phone'),
        primary_contact_email: document.getElementById('clm_contact_email')
      };

      function open() {
        errEl.classList.add('hidden'); errEl.textContent = '';
        Object.keys(f).forEach(function (k) { f[k].value = ''; });
        modal.classList.remove('hidden');
        setTimeout(function () { f.company_name.focus(); }, 30);
      }
      function close() { modal.classList.add('hidden'); }

      addBtn.addEventListener('click', open);
      document.getElementById('clm_cancel').addEventListener('click', close);
      modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.classList.contains('hidden')) close(); });

      var saveBtn = document.getElementById('clm_save');
      saveBtn.addEventListener('click', function () {
        var name = f.company_name.value.trim();
        if (!name) { errEl.textContent = 'Company name is required.'; errEl.classList.remove('hidden'); f.company_name.focus(); return; }

        var meta = document.querySelector('meta[name="csrf-token"]');
        saveBtn.disabled = true; saveBtn.textContent = 'Saving…';
        fetch('/clients', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'x-csrf-token': meta ? meta.content : '' },
          credentials: 'same-origin',
          body: JSON.stringify({
            company_name: name,
            company_type: 'client',
            abn: f.abn.value.trim(),
            primary_contact_name: f.primary_contact_name.value.trim(),
            primary_contact_phone: f.primary_contact_phone.value.trim(),
            primary_contact_email: f.primary_contact_email.value.trim()
          })
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
          .then(function (res) {
            if (!res.ok || !res.body.success || !res.body.client) { throw new Error((res.body && res.body.error) || 'Failed to create client.'); }
            var c = res.body.client;
            var opt = document.createElement('option');
            opt.value = c.id; opt.textContent = c.company_name;
            clientSelect.appendChild(opt);
            clientSelect.value = String(c.id);
            // Trigger the site-contacts picker to refresh for the new client.
            clientSelect.dispatchEvent(new Event('change', { bubbles: true }));
            close();
          })
          .catch(function (err) { errEl.textContent = err.message; errEl.classList.remove('hidden'); })
          .finally(function () { saveBtn.disabled = false; saveBtn.textContent = 'Save client'; });
      });
    })();
  </script>

