<%
  const isROL = sub.item_type === 'rol' || sub.item_type === 'road_occupancy';
  // ROL application lifecycle: valid 14 days from the applied-for date; chase
  // from day 10 if still unapproved. Computed for the card badge + banner.
  const rolApplied = sub.rol_applied_date || '';
  const rolApproved = sub.status === 'approved' || sub.rol_stage === 'approved';
  const rolExpiryStr = rolApplied ? new Date(Date.parse(rolApplied + 'T00:00:00Z') + 14 * 86400000).toISOString().slice(0, 10) : '';
  const rolChaseFrom = rolApplied ? new Date(Date.parse(rolApplied + 'T00:00:00Z') + 10 * 86400000).toISOString().slice(0, 10) : '';
  const rolTodayStr = new Date().toISOString().slice(0, 10);
  const rolExpired = rolApplied && !rolApproved && rolTodayStr > rolExpiryStr;
  const rolInChase = rolApplied && !rolApproved && !rolExpired && rolTodayStr >= rolChaseFrom;
  const rolLinkList = (typeof rolSubs !== 'undefined' && rolSubs) ? rolSubs : [];
  const rolLinkLabel = (r) => (r.rol_actual_number || r.reference_number || ('ROL #' + r.id));
  const linkedRol = (typeof rolSubs !== 'undefined' && rolSubs && sub.linked_rol_id)
    ? rolSubs.find(r => String(r.id) === String(sub.linked_rol_id)) : null;
  const isSubmitted = ['submitted', 'approved'].includes(sub.status);
  const isApproved = sub.status === 'approved';
  const isRejected = sub.status === 'rejected';
  const docCount = (docs || []).length;
  // Risk Assessment context (passed in from _parent_form.ejs when migration 199 has run).
  const linkedRa = (typeof ra !== 'undefined' && ra) ? ra : null;
  const isTgs = sub.item_type === 'traffic_guidance';
  const raActive = linkedRa && linkedRa.status === 'active';
  const raStatusColor = linkedRa
    ? (linkedRa.status === 'active' ? 'bg-emerald-50 text-emerald-700 ring-emerald-200'
       : linkedRa.status === 'archived' ? 'bg-gray-100 text-gray-600 ring-gray-200'
       : 'bg-amber-50 text-amber-700 ring-amber-200')
    : '';

  // Per-sub-plan cost/profit (admin + finance only). Only show the chip
  // line if there's some money or hours data — otherwise it'd just say $0
  // on every empty card.
  const subHourlyRate = parseFloat((systemConfig && systemConfig.internal_hourly_rate) || 40) || 40;
  const subHours = parseFloat(sub.hours_spent) || 0;
  const subCharge = sub.charge_client ? (parseFloat(sub.charge_amount) || 0) : 0;
  // Council cost now comes from the itemised Fees (compliance_fees); fall back
  // to the legacy single council_fee_amount for rows created before fees existed.
  const cFees = (typeof fees !== 'undefined' && fees) ? fees : [];
  const feesTotal = cFees.reduce((s, f) => s + (parseFloat(f.amount) || 0), 0);
  const subCouncil = feesTotal > 0 ? feesTotal : (sub.council_fee_paid ? (parseFloat(sub.council_fee_amount) || 0) : 0);
  const subLabour = subHours * subHourlyRate;
  const subCost = subLabour + subCouncil;
  const subProfit = subCharge - subCost;
  const showSubCost = canSeeCost && (subHours > 0 || subCharge > 0 || subCouncil > 0);
  const fmtMoneySub = n => '$' + (Math.round(n * 100) / 100).toFixed(2);
%>

<div id="sub-<%= sub.id %>" class="border border-gray-200 rounded-lg p-4 <%= isApproved ? 'bg-emerald-50/30' : isRejected ? 'bg-rose-50/30' : 'bg-white' %>">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <code class="text-sm font-semibold text-gray-900"><%= sub.reference_number %></code>
        <% if (sub.item_type === 'other' && sub.other_description) { %>
          <%/* The free-text label the user typed when generating this Other slot — shows what
               the row is actually for (e.g. "Methodologies", "Staging") so it isn't anonymous. */%>
          <span class="text-sm font-medium text-gray-700">— <%= sub.other_description %></span>
        <% } %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium ring-1 ring-inset <%= statusBadge[sub.status] || statusBadge.not_started %>">
          <%= (sub.status || 'not_started').replace(/_/g, ' ') %>
        </span>
        <% if (sub.expiry_date) { %>
          <span class="text-xs text-gray-500">expires <%= sub.expiry_date %></span>
        <% } %>
        <% if (isROL && sub.extension_required) { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium ring-1 ring-inset bg-amber-50 text-amber-700 ring-amber-200">extension required</span>
        <% } %>
      </div>
      <!-- Inline owner picker. Auto-saves on change via AJAX so it doesn't
           reload the page and wipe a half-typed comment or selected upload
           below. Description used to sit alongside this; it now lives
           inside the upload-submit form itself (PR #459), so having two
           separate inputs was redundant and the outer one's onblur save
           was the source of the "Description is required before submitting"
           false positives. -->
      <div class="mt-2 max-w-[220px]">
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/owner"
          onsubmit="return window.__subPlanAjaxSave(event, this);"
          data-ajax-save>
          <%- include('../partials/csrf') %>
          <select name="assigned_to_id" onchange="window.__subPlanAjaxSave(null, this.form);"
            class="w-full px-2.5 py-1.5 text-sm bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">— Owner —</option>
            <% (typeof users !== 'undefined' ? users : []).forEach(u => { %>
              <option value="<%= u.id %>" <%= sub.assigned_to_id == u.id ? 'selected' : '' %>><%= u.full_name %></option>
            <% }) %>
          </select>
        </form>
      </div>
      <!-- Charge client — always available, independent of submission/approval.
           Auto-saves via AJAX to /charge so the amount can be set or changed at
           any status (before it's put in, after, even once approved). The
           amount input is disabled-not-in-FormData when unchecked, so checking
           the box enables it first, then saves. -->
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/charge" class="mt-2 flex items-center gap-2 flex-wrap"
        id="charge-<%= sub.id %>"
        onsubmit="return window.__subPlanAjaxSave(event, this);" data-ajax-save>
        <%- include('../partials/csrf') %>
        <label class="inline-flex items-center text-xs font-medium text-gray-700 cursor-pointer">
          <input type="checkbox" name="charge_client" value="1" <%= sub.charge_client ? 'checked' : '' %>
            onchange="var a=document.getElementById('charge_amount_<%= sub.id %>'); a.disabled=!this.checked; if(this.checked)a.focus(); window.__subPlanAjaxSave(null, this.form);"
            class="w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500 mr-2">
          Charge client
        </label>
        <input type="number" name="charge_amount" id="charge_amount_<%= sub.id %>" min="0" step="0.01"
          value="<%= sub.charge_amount || '' %>" placeholder="Amount ($)"
          <%= sub.charge_client ? '' : 'disabled' %>
          onchange="window.__subPlanAjaxSave(null, this.form);"
          class="w-32 px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 disabled:bg-gray-50 disabled:text-gray-400">
        <% if (sub.item_type === 'council_permit') { %>
          <label class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-700 ml-1">
            Application ref
            <input type="text" name="application_ref_no" form="appref-<%= sub.id %>" id="appref-input-<%= sub.id %>"
              value="<%= sub.application_ref_no || '' %>" placeholder="council ref no."
              onchange="window.__subPlanAjaxSave(null, document.getElementById('appref-<%= sub.id %>'));"
              class="w-40 px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          </label>
        <% } %>
      </form>
      <% if (sub.item_type === 'council_permit') { %>
        <!-- Separate form so the ref auto-saves on its own to /app-ref without
             dragging the charge fields along (the input above is form-associated
             to this via form="appref-<id>"). -->
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/app-ref" id="appref-<%= sub.id %>"
          onsubmit="return window.__subPlanAjaxSave(event, this);" data-ajax-save class="hidden">
          <%- include('../partials/csrf') %>
        </form>
      <% } %>
      <% if (isROL) { %>
        <!-- ROL extension flag: always togglable, including post-approval -->
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/extension" class="mt-2" id="ext-<%= sub.id %>"
          onsubmit="return window.__subPlanAjaxSave(event, this);"
          data-ajax-save>
          <%- include('../partials/csrf') %>
          <input type="hidden" name="extension_required" value="<%= sub.extension_required ? '0' : '1' %>">
          <label class="inline-flex items-center text-xs text-gray-700 cursor-pointer">
            <input type="checkbox" <%= sub.extension_required ? 'checked' : '' %>
              onchange="window.__subPlanAjaxSave(null, document.getElementById('ext-<%= sub.id %>'));"
              class="w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500 mr-2">
            ROL extension required
          </label>
        </form>
      <% } %>
    </div>
    <div class="shrink-0 flex items-center gap-1">
      <% if (isSubmitted && !isApproved) { %>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/approve" class="inline">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-2.5 py-1 text-xs font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 ring-1 ring-emerald-200 rounded-md">Approve</button>
        </form>
      <% } %>
      <% if (!isApproved && !isRejected) { %>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/reject" class="inline">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-2.5 py-1 text-xs font-medium text-rose-700 bg-rose-50 hover:bg-rose-100 ring-1 ring-rose-200 rounded-md">Reject</button>
        </form>
      <% } %>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/delete" class="inline" onsubmit="return confirm('Remove this sub-plan and its files?')">
        <%- include('../partials/csrf') %>
        <button type="submit" title="Remove" class="p-1.5 text-gray-400 hover:text-rose-600 rounded-md">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 3h6a1 1 0 011 1v3H8V4a1 1 0 011-1z"/></svg>
        </button>
      </form>
    </div>
  </div>

  <% if (showSubCost) { %>
    <!-- T&S internal cost line — admin + finance only.
         Hidden from planning/operations even when they're on the page. -->
    <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs px-2.5 py-1.5 bg-slate-50 ring-1 ring-slate-200 rounded">
      <span class="text-[10px] uppercase tracking-wide text-slate-500 font-semibold mr-1">T&amp;S P&amp;L</span>
      <span class="text-slate-600">Labour <span class="font-medium text-slate-900"><%= fmtMoneySub(subLabour) %></span> <span class="text-slate-400">(<%= subHours %>h × $<%= subHourlyRate %>)</span></span>
      <% if (subCouncil > 0) { %><span class="text-slate-600">+ Council <span class="font-medium text-amber-700"><%= fmtMoneySub(subCouncil) %></span></span><% } %>
      <span class="text-slate-600">= Cost <span class="font-semibold text-slate-900"><%= fmtMoneySub(subCost) %></span></span>
      <span class="text-slate-400">·</span>
      <span class="text-slate-600">Charge <span class="font-medium text-emerald-700"><%= fmtMoneySub(subCharge) %></span></span>
      <span class="ml-auto font-semibold <%= subProfit >= 0 ? 'text-emerald-700' : 'text-rose-700' %>">
        <%= subProfit >= 0 ? 'Profit ' : 'Loss ' %><%= fmtMoneySub(Math.abs(subProfit)) %>
      </span>
    </div>
  <% } %>

  <!-- Risk Assessment link (TGS only, shown when an RA was auto-created on parent plan creation) -->
  <% if (isTgs && linkedRa) { %>
    <div class="mb-3 flex flex-wrap items-center gap-2 px-3 py-2 bg-blue-50/60 ring-1 ring-blue-100 rounded text-xs">
      <span class="text-[10px] font-bold uppercase tracking-wide text-blue-700">Risk Assessment</span>
      <a href="/risk-assessments/<%= linkedRa.id %>/fill" class="text-brand-600 hover:text-brand-700 font-medium truncate"><%= linkedRa.title %></a>
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium ring-1 ring-inset <%= raStatusColor %>"><%= (linkedRa.status || 'draft').toUpperCase() %></span>
      <% if (raActive && docCount > 0) { %>
        <form method="POST" action="/risk-assessments/<%= linkedRa.id %>/generate-combined" class="ml-auto" onsubmit="return confirm('Generate the combined PDF? This replaces the bare TGS attachment with the merged RA + TGS document.')">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded">Generate Combined PDF</button>
        </form>
      <% } else if (raActive && docCount === 0) { %>
        <span class="ml-auto text-[11px] text-gray-500 italic">Upload TGS PDF below to enable combined export</span>
      <% } else { %>
        <a href="/risk-assessments/<%= linkedRa.id %>/fill" class="ml-auto text-[11px] text-amber-700 hover:text-amber-800 font-medium">Fill out →</a>
      <% } %>
    </div>
  <% } %>

  <!-- TGS → linked ROL (pick the ROL on this plan that covers these works) -->
  <% if (isTgs) { %>
    <div class="mb-3 flex flex-wrap items-center gap-2 px-3 py-2 bg-teal-50/60 ring-1 ring-teal-100 rounded text-xs">
      <span class="text-[10px] font-bold uppercase tracking-wide text-teal-700">Linked ROL</span>
      <% if (rolLinkList.length) { %>
        <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/link-rol" class="flex items-center gap-1.5" onchange="this.requestSubmit ? this.requestSubmit() : this.submit()">
          <%- include('../partials/csrf') %>
          <select name="linked_rol_id" class="px-2 py-1 text-xs border border-gray-300 rounded bg-white">
            <option value="">— not linked —</option>
            <% rolLinkList.forEach(r => { %>
              <option value="<%= r.id %>" <%= String(sub.linked_rol_id) === String(r.id) ? 'selected' : '' %>><%= rolLinkLabel(r) %></option>
            <% }) %>
          </select>
          <noscript><button class="px-2 py-1 text-xs bg-teal-600 text-white rounded">Link</button></noscript>
        </form>
        <% if (linkedRol) { %><a href="#sub-<%= linkedRol.id %>" class="text-teal-700 hover:text-teal-800 font-medium">→ <%= rolLinkLabel(linkedRol) %></a><% } %>
      <% } else { %>
        <span class="text-gray-500 italic">Add a ROL sub-plan to this plan to link it.</span>
      <% } %>
    </div>
  <% } %>

  <!-- Documents -->
  <% if (docCount > 0) { %>
    <div class="mb-3 space-y-1">
      <% docs.forEach(d => { %>
        <div class="flex items-center justify-between gap-2 px-2 py-1.5 bg-gray-50 rounded text-xs">
          <a href="<%= d.file_path %>" target="_blank" class="flex-1 truncate text-brand-600 hover:text-brand-700">
            <%= d.original_name %>
          </a>
          <span class="text-gray-400 shrink-0"><%= Math.round((d.file_size || 0) / 1024) %> KB</span>
          <form method="POST" action="/compliance/<%= sub.id %>/documents/<%= d.id %>/delete" class="inline shrink-0" onsubmit="return confirm('Delete this file?')">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="return_to" value="/compliance/<%= parentId %>/edit">
            <button type="submit" class="text-gray-400 hover:text-rose-600 p-0.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- Council permit two-stage workflow: Applied → Approved.
       Stage 1 lodges the application (no file needed); stage 2 attaches the
       issued permit via drag-drop/select and marks it approved. The council
       application ref is captured beside the Charge client control above and
       synced into whichever action form the user submits (belt-and-suspenders
       against the beside-charge input's onchange racing a full-page POST). -->
  <% if (sub.item_type === 'council_permit') {
       const councilApplied = ['submitted', 'approved'].includes(sub.status);
       const councilApproved = sub.status === 'approved';
       const syncRef = "this.application_ref_no.value=(document.getElementById('appref-input-" + sub.id + "')||{}).value||''";
  %>
    <div class="mb-3 rounded-lg ring-1 ring-gray-200 overflow-hidden">
      <div class="flex items-stretch text-xs divide-x divide-gray-200">
        <div class="flex-1 px-3 py-2 <%= councilApplied ? 'bg-emerald-50' : 'bg-gray-50' %>">
          <div class="flex items-center gap-1.5">
            <span class="inline-flex items-center justify-center w-4 h-4 rounded-full text-[10px] font-bold <%= councilApplied ? 'bg-emerald-600 text-white' : 'bg-gray-300 text-white' %>"><%= councilApplied ? '✓' : '1' %></span>
            <span class="font-semibold <%= councilApplied ? 'text-emerald-800' : 'text-gray-600' %>">Applied</span>
          </div>
          <% if (sub.submitted_date) { %><p class="text-[11px] text-gray-500 mt-0.5 ml-5">Lodged <%= sub.submitted_date %></p><% } %>
          <% if (sub.application_ref_no) { %><p class="text-[11px] text-gray-500 mt-0.5 ml-5">Ref <span class="font-medium text-gray-700"><%= sub.application_ref_no %></span></p><% } %>
        </div>
        <div class="flex-1 px-3 py-2 <%= councilApproved ? 'bg-emerald-50' : 'bg-gray-50' %>">
          <div class="flex items-center gap-1.5">
            <span class="inline-flex items-center justify-center w-4 h-4 rounded-full text-[10px] font-bold <%= councilApproved ? 'bg-emerald-600 text-white' : 'bg-gray-300 text-white' %>"><%= councilApproved ? '✓' : '2' %></span>
            <span class="font-semibold <%= councilApproved ? 'text-emerald-800' : 'text-gray-600' %>">Approved</span>
          </div>
          <% if (sub.approved_date) { %><p class="text-[11px] text-gray-500 mt-0.5 ml-5">Approved <%= sub.approved_date %></p><% } %>
        </div>
      </div>

      <div class="p-3 bg-white border-t border-gray-200">
        <% if (!councilApplied) { %>
          <!-- Stage 1: lodge the application (no file required) -->
          <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/council" class="flex items-center justify-between gap-2 flex-wrap" onsubmit="<%= syncRef %>">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="action" value="apply">
            <input type="hidden" name="application_ref_no" value="<%= sub.application_ref_no || '' %>">
            <p class="text-[11px] text-gray-500">Enter the council <span class="font-medium">Application ref</span> above, then lodge — the permit file can be attached once approved.</p>
            <button type="submit" class="px-3 py-1.5 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-md whitespace-nowrap">Mark as applied</button>
          </form>
        <% } else if (!councilApproved) { %>
          <!-- Stage 2: attach the issued permit (drag-drop / select) + approve -->
          <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/council" enctype="multipart/form-data" class="space-y-2" onsubmit="<%= syncRef %>">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="action" value="approve">
            <input type="hidden" name="application_ref_no" value="<%= sub.application_ref_no || '' %>">
            <div data-dropzone>
              <input type="file" name="documents" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.gif,.webp,.dwg,.dxf">
              <div class="dropzone-label">
                <svg class="w-7 h-7 mx-auto mb-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                <p class="text-xs text-gray-500">Drag &amp; drop the approved permit here or <span class="text-brand-600 font-medium">click to browse</span></p>
                <p class="text-[11px] text-gray-400 mt-0.5">Optional — you can approve without a file and add it later.</p>
              </div>
            </div>
            <div class="flex items-center justify-end">
              <button type="submit" class="px-3 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-md whitespace-nowrap">Mark as approved</button>
            </div>
          </form>
        <% } else { %>
          <!-- Approved: allow attaching more documents after the fact -->
          <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/council" enctype="multipart/form-data" class="space-y-2" onsubmit="<%= syncRef %>">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="action" value="approve">
            <input type="hidden" name="application_ref_no" value="<%= sub.application_ref_no || '' %>">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-700">Permit approved.</span>
              <input type="file" name="documents" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.gif,.webp,.dwg,.dxf"
                class="flex-1 min-w-[180px] text-xs text-gray-700 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
              <button type="submit" class="px-3 py-1.5 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md whitespace-nowrap">Attach file</button>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Upload + submit (combined) -->
  <% if (!isApproved && !isRejected) { %>
    <details class="group">
      <summary class="cursor-pointer text-xs font-medium text-brand-600 hover:text-brand-700 inline-flex items-center list-none">
        <svg class="w-3.5 h-3.5 mr-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        <%= docCount > 0 ? 'Add more files / re-submit' : 'Upload & submit' %>
      </summary>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/upload-submit" enctype="multipart/form-data" class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3 p-3 bg-gray-50 rounded-md">
        <%- include('../partials/csrf') %>

        <!-- Description is required server-side. It used to ride along as a
             hidden input pre-rendered with sub.description, which made it
             impossible to set on first submission unless the user blurred
             the outer auto-save description input first. Surfacing it inside
             the form removes the foot-gun: whatever's typed here is what
             posts. -->
        <div class="sm:col-span-2">
          <label class="block text-xs font-medium text-gray-700 mb-1">Description <span class="text-rose-500">*</span></label>
          <input type="text" name="description" required
            value="<%= sub.description || '' %>"
            placeholder="e.g. Northbound 2 lanes"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>

        <div class="sm:col-span-2">
          <label class="block text-xs font-medium text-gray-700 mb-1">Files <% if (sub.item_type !== 'council_permit') { %><span class="text-rose-500">*</span><% } %></label>
          <input type="file" name="documents" multiple <%= sub.item_type === 'council_permit' ? '' : 'required' %>
            accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png,.gif,.webp,.dwg,.dxf"
            class="w-full text-xs text-gray-700 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-medium file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
          <p class="mt-1 text-[11px] text-gray-500">PDF, Word, Excel, images, DWG/DXF — max 25MB / 10 files<% if (sub.item_type === 'council_permit') { %> · optional for council<% } %></p>
        </div>

        <% const jobMandatory = (sub.item_type === 'council_permit' || sub.item_type === 'rol' || sub.item_type === 'road_occupancy'); %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Client request date</label>
          <input type="date" name="client_request_date" value="<%= sub.client_request_date || '' %>"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Submission date <span class="text-rose-500">*</span></label>
          <input type="date" name="submitted_date" required
            value="<%= sub.submitted_date || new Date().toISOString().slice(0, 10) %>"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <% if (jobMandatory) { %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Job start <span class="text-rose-500">*</span></label>
          <input type="date" name="job_date" value="<%= sub.job_date || '' %>" required
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <% } %>
        <% if (isROL) { %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Expiry date</label>
          <input type="date" name="expiry_date" value="<%= sub.expiry_date || '' %>"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <% } %>
        <% if (sub.item_type === 'council_permit') { %>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-1">Type of Council Plan</label>
          <input type="text" name="council_plan_type" value="<%= sub.council_plan_type || '' %>"
            placeholder="e.g. Road Opening Permit"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>
        <% } %>

        <div class="sm:col-span-2">
          <label class="block text-xs font-medium text-gray-700 mb-1">Comments</label>
          <textarea name="notes" rows="2"
            class="w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"><%= sub.notes || '' %></textarea>
        </div>

        <!-- Effort + cost capture, all part of the same submission action. -->
        <div class="sm:col-span-2 pt-3 border-t border-gray-200">
          <label class="block text-xs font-medium text-gray-700 mb-1">Hours spent <span class="text-rose-500">*</span></label>
          <input type="number" name="hours_spent" required min="0.25" step="0.25" value="<%= sub.hours_spent || '' %>"
            placeholder="0.5"
            class="w-32 px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>

        <p class="sm:col-span-2 text-[11px] text-gray-500">Charging the client is set in the <span class="font-medium">Charge client</span> control on this card (editable any time). Council costs / fees are recorded in the <span class="font-medium">Fees</span> section below (with receipts).</p>

        <%- include('../partials/notify-picker') %>

        <div class="sm:col-span-2 flex items-center justify-end">
          <button type="submit" class="px-3 py-1.5 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md">
            Upload & Submit
          </button>
        </div>
      </form>
    </details>
  <% } %>

  <%
    // ── Plans Module enhancements (council/ROL/CTMP) ──
    // cFees + feesTotal are defined at the top of this card (used by the P&L line).
    const cExt = (typeof extensions !== 'undefined' && extensions) ? extensions : [];
    const cShifts = (typeof rolShifts !== 'undefined' && rolShifts) ? rolShifts : [];
    const cConds = (typeof rolConditions !== 'undefined' && rolConditions) ? rolConditions : [];
    const isCouncilType = sub.item_type === 'council_permit';
    const isCtmpType = sub.item_type === 'tmp_approval';
    const isRolType = sub.item_type === 'rol' || sub.item_type === 'road_occupancy';
    const condAlerts = cConds.filter(c => c.is_alert);
    const qaCol = { pending: 'bg-gray-100 text-gray-600', in_qa: 'bg-amber-100 text-amber-700', approved: 'bg-emerald-100 text-emerald-700' };
  %>

  <!-- ROL condition alerts -->
  <% if (condAlerts.length) { %>
    <div class="mt-3 bg-rose-50 ring-1 ring-rose-200 rounded-md p-3">
      <p class="text-[10px] font-bold uppercase tracking-wide text-rose-700 mb-1.5">Conditions — read before site</p>
      <ul class="space-y-1">
        <% condAlerts.forEach(c => { %><li class="text-xs text-rose-800 flex gap-1.5"><span class="font-bold">!</span><span><%= c.text %></span></li><% }) %>
      </ul>
    </div>
  <% } %>

  <!-- CTMP QA status -->
  <% if (isCtmpType) { %>
    <div class="mt-3 flex items-center gap-2 text-xs">
      <span class="text-[10px] font-bold uppercase tracking-wide text-gray-500">CTMP QA</span>
      <% if (sub.qa_status) { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium <%= qaCol[sub.qa_status] || qaCol.pending %>"><%= (sub.qa_status || 'pending').replace('_',' ') %></span><% } %>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/qa" class="inline-flex items-center gap-1" onsubmit="return window.__subPlanAjaxSave ? window.__subPlanAjaxSave(event, this) : true;" data-ajax-save>
        <%- include('../partials/csrf') %>
        <select name="qa_status" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()" class="px-2 py-1 text-xs bg-white border border-gray-300 rounded-md">
          <% ['pending','in_qa','approved'].forEach(s => { %><option value="<%= s %>" <%= sub.qa_status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option><% }) %>
        </select>
      </form>
    </div>
  <% } %>

  <!-- Fees (itemised, with receipts) -->
  <details class="mt-3 group">
    <summary class="cursor-pointer text-xs font-medium text-brand-600 hover:text-brand-700 inline-flex items-center list-none">
      <svg class="w-3.5 h-3.5 mr-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      Fees<% if (cFees.length) { %> · <%= cFees.length %> ($<%= feesTotal.toFixed(2) %>)<% } %>
    </summary>
    <div class="mt-2 p-3 bg-gray-50 rounded-md space-y-2">
      <% cFees.forEach(f => { %>
        <div class="flex items-center justify-between gap-2 text-xs">
          <span class="text-gray-800"><%= f.description || '—' %> · <span class="font-medium">$<%= (parseFloat(f.amount)||0).toFixed(2) %></span><% if (f.receipt_file_path) { %> · <a href="<%= f.receipt_file_path %>" target="_blank" class="text-brand-600 hover:underline"><%= f.receipt_original_name || 'receipt' %></a><% } %></span>
          <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/fees/<%= f.id %>/delete" onsubmit="return confirm('Delete this fee?')"><%- include('../partials/csrf') %><button class="text-gray-400 hover:text-rose-600">✕</button></form>
        </div>
      <% }) %>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/fees" enctype="multipart/form-data" class="grid grid-cols-1 sm:grid-cols-4 gap-2 items-end pt-1">
        <%- include('../partials/csrf') %>
        <input type="text" name="description" placeholder="Description" class="sm:col-span-2 px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md">
        <input type="number" step="0.01" min="0" name="amount" placeholder="Amount ($)" class="px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md">
        <input type="file" name="receipt" accept=".pdf,.jpg,.jpeg,.png,.webp" class="text-[11px]">
        <div class="sm:col-span-4"><button class="px-3 py-1.5 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md">Add fee</button></div>
      </form>
    </div>
  </details>

  <!-- Extensions (ROL / Council) -->
  <% if (isRolType || isCouncilType) { %>
  <details class="mt-2 group">
    <summary class="cursor-pointer text-xs font-medium text-brand-600 hover:text-brand-700 inline-flex items-center list-none">
      <svg class="w-3.5 h-3.5 mr-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      Extensions<% if (cExt.length) { %> · <%= cExt.length %><% } %>
    </summary>
    <div class="mt-2 p-3 bg-gray-50 rounded-md space-y-2">
      <% cExt.forEach(e => { %>
        <div class="flex items-center justify-between gap-2 text-xs">
          <span class="text-gray-800"><%= e.label || 'Extension' %><%= e.extended_to ? ' → ' + e.extended_to : '' %><% if (e.reason) { %> <span class="text-gray-500">(<%= e.reason %>)</span><% } %><% if (e.file_path) { %> · <a href="<%= e.file_path %>" target="_blank" class="text-brand-600 hover:underline"><%= e.file_original_name || 'file' %></a><% } %></span>
          <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/extensions/<%= e.id %>/delete" onsubmit="return confirm('Delete this extension?')"><%- include('../partials/csrf') %><button class="text-gray-400 hover:text-rose-600">✕</button></form>
        </div>
      <% }) %>
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/extensions" enctype="multipart/form-data" class="grid grid-cols-1 sm:grid-cols-4 gap-2 items-end pt-1">
        <%- include('../partials/csrf') %>
        <input type="text" name="label" placeholder="Label (e.g. Extension 1)" class="px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md">
        <input type="date" name="extended_to" class="px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md">
        <input type="text" name="reason" placeholder="Reason" class="px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md">
        <input type="file" name="extension_file" accept=".pdf,.jpg,.jpeg,.png,.webp" class="text-[11px]">
        <div class="sm:col-span-4"><button class="px-3 py-1.5 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md">Add extension</button></div>
      </form>
    </div>
  </details>
  <% } %>

  <!-- ROL: expiry banner (14 days from applied-for date) -->
  <% if (isRolType && rolApplied && !rolApproved) { %>
    <div class="mb-2 flex flex-wrap items-center gap-2 px-3 py-2 rounded text-xs ring-1 <%= rolExpired ? 'bg-rose-50 ring-rose-200 text-rose-800' : (rolInChase ? 'bg-amber-50 ring-amber-200 text-amber-800' : 'bg-blue-50/60 ring-blue-100 text-blue-800') %>">
      <span class="text-[10px] font-bold uppercase tracking-wide">ROL application</span>
      <span>Applied <%= rolApplied %> · <strong><%= rolExpired ? 'EXPIRED ' + rolExpiryStr : 'expires ' + rolExpiryStr %></strong></span>
      <% if (rolInChase) { %><span class="ml-auto inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500 text-white">Chase now</span>
      <% } else if (rolExpired) { %><span class="ml-auto inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-rose-600 text-white">Re-apply</span><% } %>
    </div>
  <% } %>

  <!-- ROL two-stage + PDF auto-extraction + manual entry -->
  <% if (isRolType) { %>
  <details class="mt-2 group"<%= (rolApplied && !rolApproved) ? ' open' : '' %>>
    <summary class="cursor-pointer text-xs font-medium text-brand-600 hover:text-brand-700 inline-flex items-center list-none">
      <svg class="w-3.5 h-3.5 mr-1 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      ROL workflow<% if (sub.rol_stage && sub.rol_stage !== 'none') { %> · <%= sub.rol_stage %><% } %><% if (cShifts.length) { %> · <%= cShifts.length %> shifts<% } %>
    </summary>
    <div class="mt-2 p-3 bg-gray-50 rounded-md space-y-3">
      <!-- Manual entry: applied-for date, licence number, approved dates -->
      <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/rol-manual" class="bg-white ring-1 ring-gray-200 rounded p-2 space-y-2">
        <%- include('../partials/csrf') %>
        <p class="text-[10px] font-bold uppercase tracking-wide text-gray-500">Enter ROL details</p>
        <div class="grid grid-cols-2 gap-2">
          <label class="block">
            <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">Applied-for date</span>
            <input type="date" name="rol_applied_date" value="<%= sub.rol_applied_date || '' %>" class="w-full px-2 py-1 text-xs border border-gray-300 rounded" title="Application valid 14 days from here">
          </label>
          <label class="block">
            <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">ROL licence no.</span>
            <input type="text" name="rol_actual_number" value="<%= sub.rol_actual_number || '' %>" placeholder="e.g. ROL-2026-0421" class="w-full px-2 py-1 text-xs border border-gray-300 rounded">
          </label>
          <label class="block">
            <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">Approved from</span>
            <input type="date" name="rol_summary_from" value="<%= sub.rol_summary_from || '' %>" class="w-full px-2 py-1 text-xs border border-gray-300 rounded">
          </label>
          <label class="block">
            <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">Approved to</span>
            <input type="date" name="rol_summary_to" value="<%= sub.rol_summary_to || '' %>" class="w-full px-2 py-1 text-xs border border-gray-300 rounded">
          </label>
          <label class="block col-span-2">
            <span class="block text-[10px] font-semibold text-gray-500 mb-0.5">Daily time window</span>
            <input type="text" name="rol_time_window" value="<%= sub.rol_time_window || '' %>" placeholder="e.g. 07:00–17:00" class="w-full px-2 py-1 text-xs border border-gray-300 rounded">
          </label>
        </div>
        <div class="flex items-center justify-between gap-2">
          <label class="inline-flex items-center gap-1.5 text-xs text-gray-700">
            <input type="checkbox" name="mark_approved" value="1" <%= rolApproved ? 'checked' : '' %> class="rounded border-gray-300 text-emerald-600">
            Mark approved
          </label>
          <button class="px-2.5 py-1 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-md">Save ROL</button>
        </div>
      </form>
      <div class="bg-brand-50 ring-1 ring-brand-100 rounded p-2">
        <p class="text-[10px] font-bold uppercase tracking-wide text-brand-700 mb-1.5">Or auto-extract from PDF</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/rola/parse" enctype="multipart/form-data" class="flex items-center gap-1.5">
            <%- include('../partials/csrf') %>
            <input type="file" name="rola_file" accept=".pdf" required class="text-[11px]">
            <button class="px-2.5 py-1 text-xs font-medium text-white bg-brand-600 hover:bg-brand-700 rounded-md whitespace-nowrap">Read ROLA</button>
          </form>
          <form method="POST" action="/compliance/sub-plans/<%= sub.id %>/rol/parse" enctype="multipart/form-data" class="flex items-center gap-1.5">
            <%- include('../partials/csrf') %>
            <input type="file" name="rol_file" accept=".pdf" required class="text-[11px]">
            <button class="px-2.5 py-1 text-xs font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-md whitespace-nowrap">Read issued ROL</button>
          </form>
        </div>
      </div>
      <% if (sub.rola_application_number || sub.rol_actual_number || sub.rol_summary_from) { %>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
          <% if (sub.rola_application_number) { %><div><span class="text-gray-400">ROLA #</span> <%= sub.rola_application_number %></div><% } %>
          <% if (sub.rol_actual_number) { %><div><span class="text-gray-400">ROL #</span> <%= sub.rol_actual_number %></div><% } %>
          <% if (sub.rol_summary_from) { %><div><span class="text-gray-400">Range</span> <%= sub.rol_summary_from %> → <%= sub.rol_summary_to || '' %></div><% } %>
          <% if (sub.rol_time_window) { %><div><span class="text-gray-400">Times</span> <%= sub.rol_time_window %></div><% } %>
        </div>
      <% } %>
      <% if (cShifts.length) { %>
        <div class="max-h-40 overflow-y-auto border border-gray-200 rounded bg-white">
          <table class="w-full text-[11px]"><tbody>
            <% cShifts.forEach(s => { %><tr class="border-b border-gray-50"><td class="px-2 py-0.5"><%= s.start_date %> <%= s.start_time %></td><td class="px-2 py-0.5 text-gray-400">→</td><td class="px-2 py-0.5"><%= s.end_date %> <%= s.end_time %></td></tr><% }) %>
          </tbody></table>
        </div>
      <% } %>
    </div>
  </details>
  <% } %>
</div>
