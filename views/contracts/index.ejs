<% locals.currentPage = 'contracts' %>
<%
  const STATUS_PILL = {
    draft:  { label: 'Draft',  cls: 'bg-gray-100 text-gray-600 ring-gray-500/20' },
    sent:   { label: 'Sent',   cls: 'bg-blue-50 text-blue-700 ring-blue-600/20' },
    signed: { label: 'Signed', cls: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20' },
    void:   { label: 'Void',   cls: 'bg-red-50 text-red-600 ring-red-600/20' },
  };
  function buildUrl(overrides) {
    const q = Object.assign({}, filters, overrides);
    const parts = Object.keys(q).filter(k => q[k] !== '' && q[k] != null).map(k => k + '=' + encodeURIComponent(q[k]));
    return '/contracts' + (parts.length ? '?' + parts.join('&') : '');
  }
%>

<div class="space-y-5">
  <%- include('../partials/page-header', { rail: true, wrapperClass: '',
    eyebrow: 'People',
    title: 'Contracts',
    subtitle: 'Generate, send and archive employment agreements — signed and unsigned copies kept',
    actions: [{ label: 'Generate contract', href: '/contracts/new', style: 'primary', icon: 'M12 6v6m0 0v6m0-6h6m-6 0H6' }]
  }) %>

  <!-- Stat tiles double as filters -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <a href="<%= buildUrl({ status: '' }) %>" class="stat-card <%= !filters.status ? 'ring-2 ring-brand-500' : '' %>">
      <p class="stat-card-label">All</p>
      <p class="stat-card-value"><%= counts.all %></p>
    </a>
    <a href="<%= buildUrl({ status: 'sent' }) %>" class="stat-card <%= filters.status === 'sent' ? 'ring-2 ring-blue-500' : '' %>">
      <p class="stat-card-label">Awaiting signature</p>
      <p class="stat-card-value <%= counts.sent > 0 ? 'is-info' : 'is-muted' %>"><%= counts.sent %></p>
    </a>
    <a href="<%= buildUrl({ status: 'signed' }) %>" class="stat-card <%= filters.status === 'signed' ? 'ring-2 ring-emerald-500' : '' %>">
      <p class="stat-card-label">Signed</p>
      <p class="stat-card-value <%= counts.signed > 0 ? 'is-good' : 'is-muted' %>"><%= counts.signed %></p>
    </a>
    <a href="<%= buildUrl({ status: 'draft' }) %>" class="stat-card <%= filters.status === 'draft' ? 'ring-2 ring-gray-400' : '' %>">
      <p class="stat-card-label">Draft</p>
      <p class="stat-card-value is-muted"><%= counts.draft %></p>
    </a>
  </div>

  <!-- Search -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <form method="GET" action="/contracts" class="flex items-end gap-2 flex-wrap">
      <input type="hidden" name="status" value="<%= filters.status %>">
      <div class="flex-1 min-w-[200px]">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">Search</label>
        <input type="text" name="q" value="<%= filters.q %>" placeholder="Worker name or agreement number"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">Apply</button>
      <a href="/contracts" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium rounded-lg transition-colors">Clear</a>
      <% if (counts.void > 0) { %>
        <a href="<%= buildUrl({ status: 'void' }) %>" class="ml-auto text-xs text-gray-400 hover:text-gray-600 underline">Voided (<%= counts.void %>)</a>
      <% } %>
    </form>
  </div>

  <!-- Register -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <% if (rows.length === 0) { %>
      <div class="p-10 text-center">
        <div class="w-10 h-10 bg-brand-50 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <h3 class="text-gray-900 font-semibold text-base mb-1">No contracts<%= filters.status ? ' with this status' : ' yet' %></h3>
        <p class="text-gray-500 text-sm mb-4">Generate an employment agreement for a worker, review it, then send them the signing link.</p>
        <a href="/contracts/new" class="inline-flex items-center gap-1.5 px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          Generate contract
        </a>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Agreement</th>
              <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Worker</th>
              <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Status</th>
              <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden md:table-cell">Sent to</th>
              <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden sm:table-cell">Signed</th>
              <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden lg:table-cell">Created</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% rows.forEach(function (c) { const sp = STATUS_PILL[c.status] || STATUS_PILL.draft; %>
              <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location='/contracts/<%= c.id %>'">
                <td class="px-3 py-2.5">
                  <span class="font-mono font-semibold text-gray-900"><%= c.agreement_number %></span>
                  <span class="text-[11px] text-gray-400">· v<%= c.version %></span>
                </td>
                <td class="px-3 py-2.5">
                  <p class="font-medium text-gray-900"><%= c.employee_name %></p>
                  <p class="text-[11px] text-gray-400"><%= c.employee_code || '—' %></p>
                </td>
                <td class="px-3 py-2.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ring-1 <%= sp.cls %>"><%= sp.label %></span>
                  <% if (c.status === 'sent' && !c.viewed_at) { %><p class="text-[10px] text-gray-400 mt-0.5">not opened yet</p><% } %>
                  <% if (c.status === 'sent' && c.viewed_at) { %><p class="text-[10px] text-gray-400 mt-0.5">opened <%= formatDateShort(c.viewed_at) %></p><% } %>
                </td>
                <td class="px-3 py-2.5 text-gray-500 text-[12px] hidden md:table-cell"><%= c.sent_to_email || '—' %></td>
                <td class="px-3 py-2.5 text-gray-500 text-[12px] hidden sm:table-cell"><%= c.signed_at ? formatDateShort(c.signed_at) : '—' %></td>
                <td class="px-3 py-2.5 text-gray-500 text-[12px] hidden lg:table-cell">
                  <%= formatDateShort(c.created_at) %>
                  <% if (c.created_by_name) { %><span class="text-gray-400">· <%= c.created_by_name %></span><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
