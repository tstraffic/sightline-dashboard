<% locals.currentPage = 'contracts' %>
<%
  const isEdit = !!contract;
  // Current value for a field: saved snapshot → prefill from the employee →
  // the field definition's default.
  function val(def) {
    if (fields && fields[def.key] != null && fields[def.key] !== '') return fields[def.key];
    return def.default || '';
  }
  const GROUPS = [
    { key: 'worker',     title: 'Worker',            sub: 'Prefilled from the roster — check every line against their ID documents.' },
    { key: 'engagement', title: 'Engagement',        sub: 'Position, tier and where they report. The tier drives the classification and every rate in Schedule A.' },
    { key: 'policy',     title: 'Policy terms',      sub: 'The operational terms written into the agreement. Defaults are the T&S standard — change only if this engagement differs.' },
    { key: 'allowances', title: 'Allowances (optional)', sub: 'Rows left blank are omitted from Schedule A3. Fares & travel and first-aid (higher) are always included.' },
    { key: 'super',      title: 'Superannuation',    sub: 'From their latest super record. Leave the default if they haven\'t nominated a fund.' },
    { key: 'signatory',  title: 'Signing for T&S',   sub: 'Whose name executes the agreement on the company\'s behalf.' },
  ];
%>

<div class="max-w-3xl mx-auto space-y-5">
  <div>
    <a href="<%= isEdit ? '/contracts/' + contract.id : '/contracts' %>" class="text-sm text-gray-500 hover:text-gray-700 mb-1 inline-flex items-center gap-1">&larr; <%= isEdit ? contract.agreement_number : 'Contracts' %></a>
    <p class="page-eyebrow">People</p>
    <h1 class="page-title vt-page-title"><%= isEdit ? 'Edit ' + contract.agreement_number : 'Generate contract' %></h1>
    <p class="page-sub">Casual Employment Agreement — Traffic Controller · every value is snapshotted into the agreement</p>
    <div class="chevron-rail" aria-hidden="true"></div>
  </div>

  <% if (isEdit && contract.status === 'sent') { %>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5 text-sm text-amber-800">
      This contract has already been <strong>sent</strong>. Saving changes revokes the live signing link — you'll need to send a fresh one.
    </div>
  <% } %>

  <% if (!isEdit && !employee) { %>
    <!-- Step 0: pick the worker -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-1">Who is this contract for?</h2>
      <p class="text-xs text-gray-400 mb-4">Their details prefill from the roster. Workers must be on the roster first — add them via HR &rarr; Roster if they're missing.</p>
      <form method="GET" action="/contracts/new" class="flex gap-2 flex-wrap">
        <select name="employee_id" required class="flex-1 min-w-[240px] px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">Select a worker…</option>
          <% employees.forEach(function (e) { %>
            <option value="<%= e.id %>"><%= e.full_name %><%= e.employee_code ? ' (' + e.employee_code + ')' : '' %><%= e.employment_status !== 'active' ? ' · ' + e.employment_status : '' %></option>
          <% }) %>
        </select>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">Continue</button>
      </form>
    </div>
  <% } else { %>

    <form method="POST" action="<%= isEdit ? '/contracts/' + contract.id : '/contracts' %>" class="space-y-4">
      <%- include('../partials/csrf') %>
      <% if (!isEdit) { %><input type="hidden" name="employee_id" value="<%= employee.id %>"><% } %>

      <div class="bg-white border border-gray-200 rounded-xl shadow-sm px-4 py-3 flex items-center gap-3">
        <div class="w-9 h-9 rounded-full bg-brand-50 text-brand-700 flex items-center justify-center text-xs font-bold">
          <%= (employee.full_name || '?').split(' ').filter(Boolean).map(p => p[0]).join('').slice(0, 2).toUpperCase() %>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-900"><%= employee.full_name %></p>
          <p class="text-[11px] text-gray-400">Casual Employment Agreement · Building and Construction General On-site Award 2020 (MA000020)</p>
        </div>
        <% if (!isEdit) { %><a href="/contracts/new" class="ml-auto text-xs text-gray-400 hover:text-gray-600 underline">change</a><% } %>
      </div>

      <% GROUPS.forEach(function (g) { const defs = fieldDefs.filter(d => d.group === g.key); if (!defs.length) return; %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-100">
            <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest"><%= g.title %></h2>
            <p class="text-[11px] text-gray-400 mt-0.5"><%= g.sub %></p>
          </div>
          <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% defs.forEach(function (def) { const v = val(def); %>
              <div class="<%= ['WORKER_ADDRESS','WORK_AREA'].includes(def.key) ? 'sm:col-span-2' : '' %>">
                <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1"><%= def.label %><% if (def.required) { %> <span class="text-red-500">*</span><% } %></label>
                <% if (def.type === 'tier') { %>
                  <select name="TIER" id="tier-select" <%= def.required ? 'required' : '' %> class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                    <% Object.entries(tiers).forEach(function ([n, t]) { %>
                      <option value="<%= n %>" <%= String(v) === String(n) ? 'selected' : '' %>>Tier <%= n %> — <%= t.level %> · <%= t.role %> · $<%= t.base.toFixed(2) %>/hr</option>
                    <% }) %>
                  </select>
                  <p class="text-[10px] text-gray-400 mt-1" id="tier-preview"></p>
                <% } else if (def.options) { %>
                  <select name="<%= def.key %>" <%= def.required ? 'required' : '' %> class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                    <% def.options.forEach(function (opt) { %>
                      <option value="<%= opt %>" <%= v === opt ? 'selected' : '' %>><%= opt.charAt(0).toUpperCase() + opt.slice(1) %></option>
                    <% }) %>
                  </select>
                <% } else { %>
                  <input type="<%= def.type === 'date' ? 'date' : def.type === 'email' ? 'email' : 'text' %>" name="<%= def.key %>" value="<%= v %>" <%= def.required ? 'required' : '' %>
                    class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                <% } %>
                <% if (def.hint) { %><p class="text-[10px] text-gray-400 mt-1"><%= def.hint %></p><% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>

      <div class="sticky bottom-0 z-20 bg-white/90 backdrop-blur-sm border-t border-gray-200 rounded-b-xl px-5 pr-20 sm:pr-32 py-3 flex items-center justify-between gap-3">
        <a href="<%= isEdit ? '/contracts/' + contract.id : '/contracts' %>" class="px-4 py-2 text-sm text-gray-500 hover:text-gray-700">Cancel</a>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition inline-flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          <%= isEdit ? 'Save as new version' : 'Generate agreement' %>
        </button>
      </div>
    </form>

    <script>
    (function () {
      var TIERS = <%- JSON.stringify(tiers) %>;
      var sel = document.getElementById('tier-select');
      var prev = document.getElementById('tier-preview');
      var pos = document.querySelector('input[name="POSITION_TITLE"]');
      var posTouched = false;
      if (pos) pos.addEventListener('input', function () { posTouched = true; });
      function sync(updateTitle) {
        var t = TIERS[sel.value];
        if (!t) return;
        prev.textContent = 'Classification ' + t.level + ' · Sat >2h $' + t.satGt2.toFixed(2) + ' · Sun $' + t.sun.toFixed(2) + ' · Night <5 $' + t.nightLt5.toFixed(2);
        // Keep the position title tracking the tier until the admin types
        // their own — then leave it alone.
        if (updateTitle && pos && !posTouched) pos.value = t.role;
      }
      if (sel) {
        sel.addEventListener('change', function () { sync(true); });
        sync(false);
      }
    })();
    </script>
  <% } %>
</div>
