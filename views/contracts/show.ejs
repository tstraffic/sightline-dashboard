<% locals.currentPage = 'contracts' %>
<%
  const STATUS_PILL = {
    draft:  { label: 'Draft',  cls: 'bg-gray-100 text-gray-600 ring-gray-500/20' },
    sent:   { label: 'Sent — awaiting signature', cls: 'bg-blue-50 text-blue-700 ring-blue-600/20' },
    signed: { label: 'Signed', cls: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20' },
    void:   { label: 'Void',   cls: 'bg-red-50 text-red-600 ring-red-600/20' },
  };
  const sp = STATUS_PILL[contract.status] || STATUS_PILL.draft;
  const tier = tiers[Number(fields.TIER)] || {};
%>

<div class="max-w-4xl mx-auto space-y-5">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
    <div>
      <a href="/contracts" class="text-sm text-gray-500 hover:text-gray-700 mb-1 inline-flex items-center gap-1">&larr; Contracts</a>
      <p class="page-eyebrow">People · Casual Employment Agreement</p>
      <h1 class="page-title vt-page-title"><%= contract.agreement_number %></h1>
      <p class="page-sub"><%= contract.employee_name %> · <%= fields.POSITION_TITLE %> · Tier <%= fields.TIER %> (<%= tier.level || '' %>) · version <%= contract.version %></p>
      <div class="chevron-rail" aria-hidden="true"></div>
    </div>
    <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-bold ring-1 flex-shrink-0 <%= sp.cls %>"><%= sp.label %></span>
  </div>

  <!-- Timeline -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
    <div class="flex items-center gap-0 overflow-x-auto">
      <%
        const steps = [
          { label: 'Generated', at: contract.created_at, done: true },
          { label: 'Sent', at: contract.sent_at, done: !!contract.sent_at },
          { label: 'Opened', at: contract.viewed_at, done: !!contract.viewed_at },
          { label: 'Signed', at: contract.signed_at, done: !!contract.signed_at },
        ];
      %>
      <% steps.forEach(function (s, i) { %>
        <div class="flex items-center <%= i < steps.length - 1 ? 'flex-1' : '' %>">
          <div class="flex flex-col items-center min-w-[86px]">
            <div class="w-7 h-7 rounded-full flex items-center justify-center text-[11px] font-bold <%= s.done ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-400' %>">
              <%= s.done ? '✓' : i + 1 %>
            </div>
            <p class="text-[11px] font-semibold mt-1 <%= s.done ? 'text-gray-900' : 'text-gray-400' %>"><%= s.label %></p>
            <p class="text-[10px] text-gray-400"><%= s.at ? formatDateTime(s.at) : '—' %></p>
          </div>
          <% if (i < steps.length - 1) { %><div class="flex-1 h-px mx-1 <%= steps[i + 1].done ? 'bg-emerald-400' : 'bg-gray-200' %>"></div><% } %>
        </div>
      <% }) %>
    </div>
    <% if (contract.status === 'void') { %>
      <p class="text-xs text-red-600 mt-3">Voided <%= formatDateTime(contract.voided_at) %><%= contract.void_reason ? ' — ' + contract.void_reason : '' %></p>
    <% } %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <!-- Key terms -->
    <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Key terms</h2>
        <% if (['draft','sent'].includes(contract.status)) { %>
          <a href="/contracts/<%= contract.id %>/edit" class="text-xs font-semibold text-brand-600 hover:underline">Edit → new version</a>
        <% } %>
      </div>
      <div class="p-4 grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-3 text-sm">
        <% [
          ['Worker', fields.WORKER_FULL_NAME],
          ['Date of birth', fields.WORKER_DOB ? formatDateShort(fields.WORKER_DOB) : '—'],
          ['Mobile', fields.WORKER_MOBILE],
          ['Email', fields.WORKER_EMAIL],
          ['Commencement', fields.START_DATE ? formatDateShort(fields.START_DATE) : '—'],
          ['Classification', (tier.level || '—') + ' · Tier ' + fields.TIER],
          ['Base rate', tier.base ? ('$' + tier.base.toFixed(2) + '/hr (incl. 25% casual loading)') : '—'],
          ['Reports to', fields.REPORTS_TO],
          ['Pay frequency', fields.PAY_FREQUENCY],
          ['Min engagement', fields.MIN_ENGAGEMENT + ' hours'],
          ['Worker cancel notice', fields.CANCELLATION_NOTICE],
          ['T&S cancel notice', fields.TS_CANCELLATION_NOTICE],
          ['Super fund', fields.SUPER_FUND_NAME],
          ['Rates effective', fields.RATES_EFFECTIVE_DATE],
          ['T&S signatory', fields.TS_SIGNATORY_NAME + ' · ' + fields.TS_SIGNATORY_POSITION],
        ].forEach(function ([l, v]) { %>
          <div>
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"><%= l %></p>
            <p class="text-gray-900 text-[13px] font-medium break-words"><%= v || '—' %></p>
          </div>
        <% }) %>
        <div class="col-span-2 sm:col-span-3">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Work area</p>
          <p class="text-gray-900 text-[13px] font-medium"><%= fields.WORK_AREA %></p>
        </div>
      </div>
    </div>

    <!-- Documents + actions -->
    <div class="space-y-4">
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-100">
          <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">PDFs</h2>
        </div>
        <div class="p-4 space-y-2">
          <a href="/contracts/<%= contract.id %>/pdf?which=unsigned" target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2.5 rounded-lg border border-gray-200 hover:border-brand-400 hover:bg-brand-50 transition text-sm font-medium text-gray-700">
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Unsigned agreement
          </a>
          <% if (contract.status === 'signed') { %>
            <a href="/contracts/<%= contract.id %>/pdf?which=signed" target="_blank" rel="noopener" class="flex items-center gap-2 px-3 py-2.5 rounded-lg border border-emerald-200 bg-emerald-50/60 hover:bg-emerald-50 transition text-sm font-semibold text-emerald-800">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Signed agreement
            </a>
            <% if (contract.employee_document_id) { %>
              <p class="text-[11px] text-gray-400">Also archived under the worker's <a class="underline" href="/hr/employees/<%= contract.employee_id %>#documents">HR documents</a>.</p>
            <% } %>
          <% } %>
        </div>
      </div>

      <% if (['draft','sent'].includes(contract.status)) { %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-100">
            <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest"><%= contract.status === 'sent' ? 'Re-send' : 'Send for signing' %></h2>
          </div>
          <div class="p-4 space-y-3">
            <form method="POST" action="/contracts/<%= contract.id %>/send" class="space-y-2">
              <%- include('../partials/csrf') %>
              <input type="hidden" name="mode" value="email">
              <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest">Email the signing link to</label>
              <input type="email" name="email" value="<%= contract.sent_to_email || fields.WORKER_EMAIL %>" required
                class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <button type="submit" class="w-full px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition">
                <%= contract.status === 'sent' ? 'Send new link' : 'Email signing link' %>
              </button>
              <p class="text-[10px] text-gray-400">Attaches the unsigned PDF. A new link always replaces any older one.</p>
            </form>
            <form method="POST" action="/contracts/<%= contract.id %>/send">
              <%- include('../partials/csrf') %>
              <input type="hidden" name="mode" value="link">
              <button type="submit" class="w-full px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition">Create link only (send it yourself)</button>
            </form>
          </div>
        </div>
      <% } %>

      <% if (signUrl && contract.status === 'sent') { %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5">Live signing link<% if (contract.token_expires_at) { %> · expires <%= formatDateShort(contract.token_expires_at) %><% } %></p>
          <div class="flex gap-1.5">
            <input type="text" readonly value="<%= signUrl %>" id="sign-url"
              class="flex-1 min-w-0 px-2.5 py-2 bg-gray-50 border border-gray-200 rounded-lg text-gray-600 text-[11px] font-mono">
            <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('sign-url').value).then(()=>{this.textContent='Copied';setTimeout(()=>this.textContent='Copy',1200)})"
              class="px-3 py-2 bg-gray-900 hover:bg-gray-700 text-white text-xs font-semibold rounded-lg transition flex-shrink-0">Copy</button>
          </div>
        </div>
      <% } %>

      <% if (['draft','sent'].includes(contract.status)) { %>
        <form method="POST" action="/contracts/<%= contract.id %>/void"
          onsubmit="var r = prompt('Void <%= contract.agreement_number %>? The signing link stops working immediately.\n\nReason (optional):'); if (r === null) return false; this.reason.value = r; return true;">
          <%- include('../partials/csrf') %>
          <input type="hidden" name="reason" value="">
          <button type="submit" class="w-full px-4 py-2 text-red-600 bg-red-50 hover:bg-red-100 ring-1 ring-red-200 text-sm font-medium rounded-lg transition">Void this contract</button>
        </form>
      <% } %>
    </div>
  </div>

  <% if (contract.status === 'signed') { %>
    <!-- Signing record -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100">
        <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Signing record</h2>
        <p class="text-[11px] text-gray-400 mt-0.5">Every acknowledgement was ticked individually. Times below are as recorded on the signer's device; the server receipt time and IP are stored with each row.</p>
      </div>
      <div class="p-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm border-b border-gray-100">
        <% [
          ['Signed by (typed)', contract.signed_name_typed],
          ['Signed at', formatDateTime(contract.signed_at)],
          ['IP address', contract.signer_ip],
          ['Link sent to', contract.sent_to_email || '—'],
        ].forEach(function ([l, v]) { %>
          <div>
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"><%= l %></p>
            <p class="text-gray-900 text-[13px] font-medium break-words"><%= v || '—' %></p>
          </div>
        <% }) %>
        <div class="col-span-2 sm:col-span-4">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Device</p>
          <p class="text-gray-500 text-[12px] break-words"><%= contract.signer_user_agent || '—' %></p>
        </div>
      </div>
      <div class="divide-y divide-gray-50">
        <% const ackByKey = {}; acks.forEach(a => ackByKey[a.ack_key] = a); %>
        <% ackDefs.forEach(function (def) { const rec = ackByKey[def.key]; %>
          <div class="px-4 py-2 flex items-start gap-2.5">
            <span class="mt-0.5 w-4 h-4 rounded flex items-center justify-center flex-shrink-0 <%= rec ? 'bg-emerald-100 text-emerald-700' : 'bg-gray-100 text-gray-300' %> text-[10px] font-bold"><%= rec ? '✓' : '' %></span>
            <div class="min-w-0">
              <p class="text-[12.5px] text-gray-700"><%= def.label.replace(/\*\*/g, '').replace(/\*/g, '') %></p>
              <% if (rec) { %><p class="text-[10px] text-gray-400">ticked <%= rec.ticked_at_client || rec.recorded_at %></p><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>
