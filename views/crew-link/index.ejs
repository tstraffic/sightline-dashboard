<div class="px-3 sm:px-4 lg:px-8 py-4 lg:py-6">
  <div class="mb-4">
    <h1 class="text-xl lg:text-2xl font-bold text-gray-900">Crew ↔ HR Linking</h1>
    <p class="text-sm text-gray-500">Link field crew to their HR profiles so audits can tag them. Unlinked crew can't be tagged into HR Reviews.</p>
  </div>

  <div class="grid grid-cols-3 gap-3 mb-5 max-w-md">
    <div class="bg-white border border-gray-200 rounded-xl p-3"><p class="text-[11px] font-semibold uppercase text-gray-400">Active crew</p><p class="text-2xl font-bold text-gray-900 mt-0.5"><%= coverage.activeCrew %></p></div>
    <div class="bg-white border border-gray-200 rounded-xl p-3"><p class="text-[11px] font-semibold uppercase text-gray-400">Linked</p><p class="text-2xl font-bold text-emerald-600 mt-0.5"><%= coverage.linked %></p></div>
    <div class="bg-white border border-gray-200 rounded-xl p-3"><p class="text-[11px] font-semibold uppercase text-gray-400">Unlinked</p><p class="text-2xl font-bold <%= coverage.unlinked>0?'text-amber-600':'text-gray-400' %> mt-0.5"><%= coverage.unlinked %></p></div>
  </div>

  <% if (unlinkedCrew.length) { %>
    <% var autoCount = unlinkedCrew.filter(function(c){return c.suggest;}).length; %>
    <% if (autoCount) { %>
      <form method="POST" action="/crew-link/auto-link" class="mb-4">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>">
        <button class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg">Auto-link <%= autoCount %> exact name match<%= autoCount===1?'':'es' %></button>
      </form>
    <% } %>
    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs uppercase font-semibold text-gray-500"><tr><th class="px-4 py-2 text-left">Crew member</th><th class="px-4 py-2 text-left">Link to HR profile</th><th class="px-4 py-2"></th></tr></thead>
        <tbody class="divide-y divide-gray-100">
          <% unlinkedCrew.forEach(function(c){ %>
            <tr>
              <td class="px-4 py-2"><span class="font-medium text-gray-900"><%= c.full_name %></span><% if (c.code){ %> <span class="text-xs text-gray-400"><%= c.code %></span><% } %><% if (c.role){ %> <span class="text-xs text-gray-400">· <%= c.role %></span><% } %></td>
              <td class="px-4 py-2">
                <form method="POST" action="/crew-link/<%= c.id %>/link" class="flex items-center gap-2">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>">
                  <select name="employee_id" class="px-2 py-1.5 text-sm border border-gray-300 rounded bg-white min-w-[14rem]">
                    <option value="">— choose employee —</option>
                    <% freeEmployees.forEach(function(e){ %><option value="<%= e.id %>" <%= c.suggest && c.suggest.id===e.id ? 'selected' : '' %>><%= e.full_name %><%= e.employee_code?(' ('+e.employee_code+')'):'' %><%= c.suggest && c.suggest.id===e.id ? ' — match' : '' %></option><% }) %>
                  </select>
                  <button class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg">Link</button>
                </form>
              </td>
              <td class="px-4 py-2 text-right text-xs text-gray-400"><% if (c.suggest){ %>suggested match<% } else { %>no name match<% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="bg-white border border-gray-200 rounded-xl p-8 text-center text-gray-500">All active crew are linked to an HR profile. 🎉</div>
  <% } %>
</div>
