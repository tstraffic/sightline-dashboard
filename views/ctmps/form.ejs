<% locals.currentPage = 'plans' %>
<% const isEdit = !!ctmp; %>

<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/plans" class="hover:text-gray-900 transition">Traffic Plans</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <% if (parent) { %><a href="/plans/<%= parent.id %>" class="hover:text-gray-900 transition"><%= parent.plan_number %></a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg><% } %>
  <span class="text-gray-900"><%= isEdit ? 'Edit CTMP' : 'New CTMP' %></span>
</div>

<h1 class="text-2xl font-bold text-gray-900 mb-1"><%= isEdit ? 'Edit CTMP' : 'New CTMP' %></h1>
<p class="text-gray-500 text-sm mb-5">
  <% if (parent) { %>Linked to <a href="/plans/<%= parent.id %>" class="text-brand-600 hover:underline"><%= parent.plan_number %></a><%= parent.job_number ? ' · ' + parent.job_number : '' %><% } %>
</p>

<form method="POST" action="<%= isEdit ? '/ctmps/' + ctmp.id : '/ctmps' %>" enctype="multipart/form-data" class="space-y-5 max-w-2xl">
  <%- include('../partials/csrf') %>
  <% if (!isEdit && parent) { %><input type="hidden" name="plan_id" value="<%= parent.id %>"><% } %>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="sm:col-span-2">
        <label for="title" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Title</label>
        <input type="text" id="title" name="title" value="<%= isEdit && ctmp.title ? ctmp.title : '' %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="CTMP title...">
      </div>
      <div>
        <label for="designer" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Designer</label>
        <input type="text" id="designer" name="designer" value="<%= isEdit && ctmp.designer ? ctmp.designer : '' %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" placeholder="Designer...">
      </div>
      <div>
        <label for="qa_status" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">QA Status</label>
        <select id="qa_status" name="qa_status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <% ['pending','in_qa','approved'].forEach(function(s){ %>
            <option value="<%= s %>" <%= isEdit && ctmp.qa_status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
          <% }) %>
        </select>
      </div>
      <% if (isEdit) { %>
      <div>
        <label for="status" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Status</label>
        <select id="status" name="status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <% ['draft','submitted','approved','superseded'].forEach(function(s){ %>
            <option value="<%= s %>" <%= ctmp.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div class="sm:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">CTMP Document</label>
        <input type="file" name="ctmp_file" accept=".pdf,.jpg,.jpeg,.png,.webp">
        <% if (isEdit && ctmp.file_path) { %><p class="text-xs text-gray-500 mt-1">Current: <a href="/<%= ctmp.file_path %>" target="_blank" class="text-brand-600 hover:underline"><%= ctmp.file_original_name || 'Document' %></a></p><% } %>
      </div>
      <div class="sm:col-span-2">
        <label for="notes" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Notes</label>
        <textarea id="notes" name="notes" rows="2" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-y" placeholder="Notes..."><%= isEdit && ctmp.notes ? ctmp.notes : '' %></textarea>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <button type="submit" class="px-6 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition"><%= isEdit ? 'Update CTMP' : 'Create CTMP' %></button>
    <a href="<%= isEdit ? '/ctmps/' + ctmp.id : (parent ? '/plans/' + parent.id : '/plans') %>" class="px-6 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium rounded-lg transition">Cancel</a>
  </div>
</form>
