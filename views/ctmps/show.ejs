<% locals.currentPage = 'plans' %>
<%
  const qaColors = { pending: 'bg-gray-100 text-gray-600', in_qa: 'bg-amber-100 text-amber-700', approved: 'bg-emerald-100 text-emerald-700' };
  const qc = qaColors[ctmp.qa_status] || 'bg-gray-100 text-gray-600';
%>

<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/plans" class="hover:text-gray-900 transition">Traffic Plans</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <% if (ctmp.plan_id) { %><a href="/plans/<%= ctmp.plan_id %>" class="hover:text-gray-900 transition"><%= ctmp.plan_number %></a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg><% } %>
  <span class="text-gray-900"><%= ctmp.ctmp_number %></span>
</div>

<div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-5">
  <div>
    <div class="flex items-center gap-3 flex-wrap">
      <h1 class="text-2xl font-bold text-gray-900"><%= ctmp.title || ctmp.ctmp_number %></h1>
      <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 ring-1 ring-purple-600/20">CTMP</span>
      <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= qc %>"><%= ctmp.current_revision_label || 'Draft' %> · <%= (ctmp.qa_status || 'pending').replace('_',' ') %></span>
    </div>
    <p class="text-gray-500 text-sm mt-1">
      <%= ctmp.ctmp_number %>
      <% if (ctmp.plan_id) { %> · linked to <a href="/plans/<%= ctmp.plan_id %>" class="text-brand-600 hover:underline"><%= ctmp.plan_number %></a><% } %>
      <% if (ctmp.job_number) { %> · <a href="/jobs/<%= ctmp.job_id %>" class="text-brand-600 hover:underline"><%= ctmp.job_number %></a><% } %>
    </p>
  </div>
  <div class="flex items-center gap-2">
    <a href="/ctmps/<%= ctmp.id %>/edit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition">Edit</a>
    <form method="POST" action="/ctmps/<%= ctmp.id %>/delete" onsubmit="return confirm('Delete this CTMP?')"><%- include('../partials/csrf') %><button class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition">Delete</button></form>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
  <div class="lg:col-span-2 space-y-5">
    <!-- Details -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Details</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
        <div><p class="text-[10px] font-bold text-gray-400 uppercase mb-0.5">Designer</p><p class="text-gray-900"><%= ctmp.designer || '—' %></p></div>
        <div><p class="text-[10px] font-bold text-gray-400 uppercase mb-0.5">Status</p><p class="text-gray-900"><%= ctmp.status || 'draft' %></p></div>
        <div><p class="text-[10px] font-bold text-gray-400 uppercase mb-0.5">Current Revision</p><p class="text-gray-900"><%= ctmp.current_revision_label || 'Draft' %></p></div>
      </div>
      <% if (ctmp.file_path) { %><p class="text-sm mt-4"><a href="/<%= ctmp.file_path %>" target="_blank" class="text-brand-600 hover:underline">📄 <%= ctmp.file_original_name || 'Document' %></a></p><% } %>
      <% if (ctmp.notes) { %><div class="mt-4"><p class="text-[10px] font-bold text-gray-400 uppercase mb-0.5">Notes</p><p class="text-sm text-gray-700 whitespace-pre-line"><%= ctmp.notes %></p></div><% } %>
    </div>

    <!-- Quick QA -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-3">QA Status</h2>
      <form method="POST" action="/ctmps/<%= ctmp.id %>/qa" class="flex items-center gap-2">
        <%- include('../partials/csrf') %>
        <select name="qa_status" class="px-3 py-2 border border-gray-300 rounded-lg text-sm">
          <% ['pending','in_qa','approved'].forEach(function(s){ %><option value="<%= s %>" <%= ctmp.qa_status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option><% }) %>
        </select>
        <button class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Update QA</button>
      </form>
    </div>

    <!-- Revision history -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Version History</h2>
      <% if (revisions.length) { %>
        <ul class="space-y-2 mb-4">
          <% revisions.forEach(function(r){
            const rqc = qaColors[r.qa_status] || 'bg-gray-100 text-gray-600';
          %>
            <li class="flex items-center justify-between text-sm border-t border-gray-100 pt-2">
              <span class="text-gray-900"><span class="font-semibold"><%= r.revision_label %></span> <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold <%= rqc %>"><%= (r.qa_status||'pending').replace('_',' ') %></span> <% if (r.notes) { %><span class="text-gray-500">— <%= r.notes %></span><% } %></span>
              <span class="text-gray-400 text-xs"><%= r.created_by_name || '' %> · <%= formatDateShort(r.created_at) %><% if (r.file_path) { %> · <a href="/<%= r.file_path %>" target="_blank" class="text-brand-600 hover:underline">file</a><% } %></span>
            </li>
          <% }) %>
        </ul>
      <% } else { %><p class="text-sm text-gray-400 mb-4">No revisions yet.</p><% } %>
      <form method="POST" action="/ctmps/<%= ctmp.id %>/revisions" enctype="multipart/form-data" class="grid grid-cols-1 sm:grid-cols-3 gap-2 items-end border-t border-gray-100 pt-4">
        <%- include('../partials/csrf') %>
        <div><label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Notes (what changed)</label><input name="notes" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></div>
        <div><label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">QA</label><select name="qa_status" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"><% ['pending','in_qa','approved'].forEach(function(s){ %><option value="<%= s %>"><%= s.replace('_',' ') %></option><% }) %></select></div>
        <div><label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">File</label><input type="file" name="revision_file" accept=".pdf,.jpg,.jpeg,.png,.webp" class="text-xs"></div>
        <div class="sm:col-span-3"><button class="px-4 py-1.5 bg-gray-700 hover:bg-gray-600 text-white text-xs font-semibold rounded-lg">Add Revision (Draft → Rev A → B…)</button></div>
      </form>
    </div>
  </div>

  <div class="space-y-5">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Activity</h2>
      <% if (activity.length) { %>
        <ol class="space-y-3">
          <% activity.forEach(function(a){ %>
            <li class="text-sm">
              <p class="text-gray-900"><span class="font-medium"><%= a.user_name || 'System' %></span> <span class="text-gray-500"><%= a.action %></span><% if (a.details) { %> — <%= a.details %><% } %></p>
              <p class="text-[11px] text-gray-400"><%= formatDateTime(a.created_at) %></p>
            </li>
          <% }) %>
        </ol>
      <% } else { %><p class="text-sm text-gray-400">No activity yet.</p><% } %>
    </div>
  </div>
</div>
