<% locals.currentPage = 'dashboard' %>
<!-- Greeting -->
<div class="hero-banner flex items-baseline justify-between gap-4 mb-6 px-1">
  <div class="hero-greeting">
    <!-- page-title only — no vt-page-title here: the dashboard title is
         personal, not a register name, so it shouldn't morph between pages
         (and the class must stay unique per page). -->
    <h1 class="page-title"><span id="greeting">Hello</span>, <%= user.full_name.split(' ')[0] %>.</h1>
    <p class="page-eyebrow mt-1.5" id="today-date"></p>
  </div>
</div>
<script>
  (function() {
    var h = new Date().getHours();
    var g = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
    document.getElementById('greeting').textContent = g;
    document.getElementById('today-date').textContent = new Date().toLocaleDateString('en-AU', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  })();
</script>

<% if (typeof birthdaysToday !== 'undefined' && birthdaysToday && birthdaysToday.length > 0) { %>
<!-- Birthday banner — pops when at least one active crew member's DOB is today.
     The pink/amber gradient stays the same in both light + dark mode (it's the
     party background, not a theme surface), so we use scoped class names and
     !important to override the .dark-glass text-gray-X → light overrides that
     would otherwise wash out the text against the still-light gradient. -->
<style>
  .bday-banner { position: relative; overflow: hidden; }
  .bday-banner::before, .bday-banner::after {
    content: ''; position: absolute; pointer-events: none; border-radius: 9999px; filter: blur(28px);
  }
  .bday-banner::before { top: -40px; left: -30px; width: 180px; height: 180px; background: radial-gradient(closest-side, rgba(244,114,182,0.45), transparent 70%); }
  .bday-banner::after  { bottom: -50px; right: -20px; width: 220px; height: 220px; background: radial-gradient(closest-side, rgba(250,204,21,0.35), transparent 70%); }
  .bday-confetti { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .bday-confetti span {
    position: absolute; top: -10px; width: 8px; height: 12px; opacity: 0.85;
    animation: bday-fall linear infinite;
  }
  .bday-confetti span:nth-child(1)  { left:  6%; background: #F472B6; animation-duration: 6.2s; animation-delay: -0.3s; transform: rotate(15deg); }
  .bday-confetti span:nth-child(2)  { left: 18%; background: #FBBF24; animation-duration: 5.5s; animation-delay: -1.7s; transform: rotate(-22deg); }
  .bday-confetti span:nth-child(3)  { left: 31%; background: #60A5FA; animation-duration: 7.1s; animation-delay: -2.4s; transform: rotate(35deg); }
  .bday-confetti span:nth-child(4)  { left: 44%; background: #34D399; animation-duration: 4.8s; animation-delay: -0.9s; transform: rotate(-12deg); }
  .bday-confetti span:nth-child(5)  { left: 56%; background: #F472B6; animation-duration: 6.6s; animation-delay: -3.1s; transform: rotate(28deg); }
  .bday-confetti span:nth-child(6)  { left: 68%; background: #A78BFA; animation-duration: 5.2s; animation-delay: -1.4s; transform: rotate(-30deg); }
  .bday-confetti span:nth-child(7)  { left: 81%; background: #FBBF24; animation-duration: 7.3s; animation-delay: -0.7s; transform: rotate(18deg); }
  .bday-confetti span:nth-child(8)  { left: 93%; background: #34D399; animation-duration: 6.0s; animation-delay: -2.0s; transform: rotate(-25deg); }
  @keyframes bday-fall {
    0%   { transform: translateY(0) rotate(0deg);     opacity: 0; }
    10%  { opacity: 0.9; }
    100% { transform: translateY(160px) rotate(360deg); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .bday-confetti { display: none; } }

  /* Force readable text colours against the light gradient in both light AND
     dark mode. Without these, body.dark-glass .text-gray-900 rules turn the
     names into near-white-on-cream. */
  .bday-banner .bday-label { color: #BE185D !important; }
  .bday-banner .bday-name  { color: #111827 !important; }
  .bday-banner .bday-name:hover { color: #BE185D !important; }
  .bday-banner .bday-age   { color: #6B7280 !important; }
  .bday-banner .bday-sep   { color: #9CA3AF !important; }
  .bday-banner .bday-body  { color: #4B5563 !important; }
</style>
<div class="bday-banner bg-gradient-to-br from-pink-50 via-amber-50 to-rose-50 border border-pink-200 rounded-2xl p-4 sm:p-5 mb-5 shadow-sm">
  <div class="bday-confetti" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="relative z-10 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
    <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-gradient-to-br from-pink-400 to-rose-500 text-white flex items-center justify-center text-3xl shadow-md">
      🎂
    </div>
    <div class="flex-1 min-w-0">
      <p class="bday-label text-[10px] font-bold uppercase tracking-[0.15em] mb-0.5">Birthday today</p>
      <% birthdaysToday.forEach((b, i) => { %>
        <% if (i > 0) { %><span class="bday-sep mx-1">·</span><% } %>
        <a href="/crew/<%= b.crew_member_id %>" class="bday-name text-lg font-extrabold transition-colors">
          <%= b.full_name %>
        </a>
        <% if (b.turning && b.turning > 0 && b.turning < 110) { %>
          <span class="bday-age text-sm font-medium ml-1">turns <%= b.turning %></span>
        <% } %>
      <% }) %>
      <p class="bday-body text-sm mt-1">Drop them a message today — the team is wishing them on the worker portal.</p>
    </div>
  </div>
</div>
<% } %>

<% if (typeof onboarding !== 'undefined' && onboarding) { %>
<!-- Onboarding Checklist -->
<div class="bg-white border border-brand-200 rounded-2xl shadow-sm p-3 sm:p-4 mb-5 relative" id="onboarding-banner">
  <button onclick="fetch('/profile/dismiss-onboarding',{method:'POST',headers:{'Content-Type':'application/json','x-csrf-token':document.querySelector('meta[name=csrf-token]').content}}).then(()=>document.getElementById('onboarding-banner').remove())"
    class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 text-lg leading-none" title="Dismiss">&times;</button>
  <h3 class="text-sm font-bold text-gray-900 mb-0.5">Getting Started</h3>
  <p class="text-xs text-gray-500 mb-3">Complete these steps to get the most out of your dashboard.</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
    <% onboarding.forEach(item => { %>
    <a href="<%= item.link %>" class="flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors group">
      <span class="onboarding-check <%= item.done ? 'completed' : '' %>">
        <% if (item.done) { %><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg><% } %>
      </span>
      <span class="text-sm <%= item.done ? 'text-gray-400 line-through' : 'text-gray-700 group-hover:text-brand-600' %>"><%= item.label %></span>
    </a>
    <% }) %>
  </div>
  <div class="mt-3 bg-gray-100 rounded-full h-1.5 overflow-hidden">
    <% const doneCount = onboarding.filter(i => i.done).length; %>
    <div class="h-full bg-brand-500 rounded-full transition-all" style="width: <%= Math.round(doneCount / onboarding.length * 100) %>%"></div>
  </div>
  <p class="text-[10px] text-gray-400 mt-1"><%= onboarding.filter(i => i.done).length %>/<%= onboarding.length %> complete</p>
</div>
<% } %>
<!-- ============================================================
     Band 1 — Needs you now.
     Row registry lives in routes/helpers/dashboard-queries.js
     (getNeedsYouNow): permission-gated, zero-hidden, capped at 5
     with a native <details> overflow. If nothing is wrong the band
     collapses to a single all-clear line — that's the reward.
     ============================================================ -->
<div class="bg-white border border-gray-200 rounded-2xl overflow-hidden mb-5" id="needs-you-now">
  <div class="px-4 py-3 border-b border-gray-100 flex items-center gap-2">
    <svg class="w-4 h-4 <%= needs.allClear ? 'text-emerald-500' : 'text-red-500' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    <h2 class="font-display font-medium text-gray-900" style="font-size:15px;letter-spacing:-0.02em">Needs you now</h2>
    <% if (!needs.allClear) { %>
      <span class="text-[10px] font-semibold text-red-600 bg-red-50 px-1.5 py-0.5 rounded-full"><%= needs.top.length + needs.overflow.length %></span>
    <% } %>
  </div>
  <% if (needs.allClear) { %>
    <div class="flex items-center gap-2.5 px-4 py-4" data-attn="all-clear">
      <span class="w-6 h-6 rounded-full bg-emerald-50 flex items-center justify-center flex-shrink-0">
        <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      </span>
      <p class="text-sm text-gray-600">All clear — nothing needs your attention right now.</p>
    </div>
  <% } else { %>
    <%
      // tone → dot colour. critical outranks warn outranks info.
      const attnDot = { critical: 'bg-red-500', warn: 'bg-amber-500', info: 'bg-brand-500' };
      const attnRow = (r) => { %>
        <a href="<%= r.href %>" data-attn="<%= r.key %>" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition group">
          <span class="w-2 h-2 rounded-full flex-shrink-0 <%= attnDot[r.tone] || 'bg-gray-400' %>"></span>
          <span class="font-display font-semibold <%= r.tone === 'critical' ? 'text-red-600' : 'text-gray-900' %>" style="font-size:19px;letter-spacing:-0.02em;min-width:1.5rem"><%= r.count %></span>
          <span class="text-sm text-gray-700 flex-1 min-w-0 truncate">
            <%= r.label %>
            <% if (r.detail) { %><span class="text-gray-400 ml-1">· <%= r.detail %></span><% } %>
          </span>
          <svg class="w-4 h-4 text-gray-300 group-hover:text-gray-500 flex-shrink-0 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      <% };
    %>
    <div class="divide-y divide-gray-100">
      <% needs.top.forEach(r => { attnRow(r); }) %>
    </div>
    <% if (needs.overflow.length > 0) { %>
      <details class="border-t border-gray-100">
        <summary class="px-4 py-2.5 text-xs font-medium text-gray-500 hover:text-gray-700 cursor-pointer select-none">
          +<%= needs.overflow.length %> more
        </summary>
        <div class="divide-y divide-gray-100 border-t border-gray-100">
          <% needs.overflow.forEach(r => { attnRow(r); }) %>
        </div>
      </details>
    <% } %>
  <% } %>
</div>

<!-- ============================================================
     Your work — personal queues (kept as lists, not folded into
     Band 1: triage says "go there", a work queue needs per-item
     links). Hidden entirely when both lists are empty.
     ============================================================ -->
<% if ((myTasks && myTasks.length > 0) || (myPlans && myPlans.length > 0)) { %>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-5" id="your-work">
  <% if (myTasks && myTasks.length > 0) { %>
  <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        <h2 class="font-display font-medium text-gray-900" style="font-size:15px;letter-spacing:-0.02em">My Tasks</h2>
        <span class="text-[10px] font-semibold text-brand-600 bg-brand-50 px-1.5 py-0.5 rounded-full"><%= myTasks.length %></span>
      </div>
      <a href="/tasks" class="text-xs text-brand-600 hover:text-brand-700 font-medium">View all &rarr;</a>
    </div>
    <div class="divide-y divide-gray-100">
      <% myTasks.slice(0, 5).forEach(t => {
        const isOverdue = t.due_date < today; // Sydney today from the route
        const priorityTag = t.priority === 'high' ? 'task-tag-high' : t.priority === 'medium' ? 'task-tag-medium' : 'task-tag-low';
        const statusTag = t.status === 'in_progress' ? 'task-tag-progress' : t.status === 'blocked' ? 'task-tag-blocked' : 'task-tag-default';
      %>
      <a href="/tasks/<%= t.id %>/edit" class="flex items-center justify-between px-4 py-3 hover:bg-gray-50 transition">
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-gray-900 truncate"><%= t.title %></p>
          <div class="flex items-center gap-2 mt-1.5">
            <% if (t.job_number) { %><span class="job-id-chip" style="font-size:10px;padding:1px 6px"><%= t.job_number %></span><% } %>
            <span class="task-tag <%= priorityTag %>"><%= t.priority %></span>
            <span class="task-tag <%= statusTag %>"><%= t.status.replace(/_/g, ' ') %></span>
          </div>
        </div>
        <div class="ml-3 text-right flex-shrink-0">
          <span class="text-xs font-semibold <%= isOverdue ? 'text-red-600' : 'text-gray-500' %>"><%= new Date(t.due_date).toLocaleDateString('en-AU', { day: '2-digit', month: 'short' }) %></span>
          <% if (isOverdue) { %><p class="text-[10px] text-red-500 font-medium">OVERDUE</p><% } %>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <% if (myPlans && myPlans.length > 0) { %>
  <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <h2 class="font-display font-medium text-gray-900" style="font-size:15px;letter-spacing:-0.02em">My Plans & Approvals</h2>
        <span class="text-[10px] font-semibold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded-full"><%= myPlans.length %></span>
      </div>
      <a href="/compliance" class="text-xs text-emerald-600 hover:text-emerald-700 font-medium">View all &rarr;</a>
    </div>
    <div class="divide-y divide-gray-100">
      <% myPlans.slice(0, 5).forEach(p => {
        const isOverdue = p.due_date && p.due_date < today;
        const isDueSoon = !isOverdue && p.due_date && p.due_date <= new Date(new Date(today + 'T00:00:00Z').getTime() + 14 * 86400000).toISOString().split('T')[0];
        const statusColors = { not_started: 'bg-gray-100 text-gray-600', started: 'bg-purple-50 text-purple-700', submitted: 'bg-blue-50 text-blue-700', rejected: 'bg-red-50 text-red-700' };
        const sc = statusColors[p.status] || 'bg-gray-100 text-gray-600';
      %>
      <a href="/compliance/<%= p.id %>/edit" class="flex items-center justify-between px-4 py-3 hover:bg-gray-50 transition">
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-gray-900 truncate"><%= p.title %></p>
          <div class="flex items-center gap-2 mt-1.5">
            <% if (p.job_number) { %><span class="job-id-chip" style="font-size:10px;padding:1px 6px"><%= p.job_number %></span><% } %>
            <% if (p.client_name && !p.job_number) { %><span class="text-[10px] text-gray-400"><%= p.client_name %></span><% } %>
            <span class="inline-flex px-1.5 py-0.5 text-[10px] font-bold rounded-full <%= sc %>"><%= p.status.replace(/_/g, ' ') %></span>
          </div>
        </div>
        <div class="ml-3 text-right flex-shrink-0">
          <% if (p.due_date) { %>
            <span class="text-xs font-semibold <%= isOverdue ? 'text-red-600' : isDueSoon ? 'text-amber-600' : 'text-gray-500' %>"><%= new Date(p.due_date).toLocaleDateString('en-AU', { day: '2-digit', month: 'short' }) %></span>
            <% if (isOverdue) { %><p class="text-[10px] text-red-500 font-medium">OVERDUE</p><% } %>
            <% if (isDueSoon) { %><p class="text-[10px] text-amber-500 font-medium">DUE SOON</p><% } %>
          <% } else { %>
            <span class="text-xs text-gray-400">No date</span>
          <% } %>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>
<% } %>

<!-- ============================================================
     Band 2 — Today's operations. The one live-state view: crew
     coverage + today's booking list. Server-side gated (todayOps
     is null for roles without bookings/allocations access).
     ============================================================ -->
<% if (todayOps) { %>
<div class="bg-white border border-gray-200 rounded-2xl overflow-hidden mb-5" id="today-ops">
  <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h2 class="font-display font-medium text-gray-900" style="font-size:15px;letter-spacing:-0.02em">Today's operations</h2>
    </div>
    <a href="/bookings" class="text-xs text-brand-600 hover:text-brand-700 font-medium">Bookings &rarr;</a>
  </div>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 p-4">
    <div class="stat-card is-info">
      <p class="stat-card-label">Crew on today</p>
      <p class="stat-card-value"><%= todayOps.crewAssignedToday %></p>
      <p class="stat-card-sub">of <%= todayOps.totalActiveCrew %> active</p>
    </div>
    <div class="stat-card is-good">
      <p class="stat-card-label">Available</p>
      <p class="stat-card-value"><%= todayOps.availableCrew %></p>
    </div>
    <div class="stat-card is-info">
      <p class="stat-card-label">Jobs running today</p>
      <p class="stat-card-value"><%= todayOps.jobsRunningToday %></p>
    </div>
    <div class="stat-card is-muted">
      <p class="stat-card-label">Bookings next 24h</p>
      <p class="stat-card-value"><%= todayOps.bookingsNext24h %></p>
    </div>
  </div>
  <% if (todayOps.todaysBookings.length > 0) { %>
  <div class="divide-y divide-gray-100 border-t border-gray-100">
    <% todayOps.todaysBookings.forEach(b => { %>
    <a href="/bookings/<%= b.id %>" class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 transition">
      <span class="text-xs font-semibold text-gray-500 w-12 flex-shrink-0"><%= formatTime(b.start_datetime) %></span>
      <span class="text-sm font-medium text-gray-900 truncate flex-1 min-w-0">
        <%= b.booking_number || ('#' + b.id) %><% if (b.title) { %> — <%= b.title %><% } %>
      </span>
      <% if (b.job_number) { %><span class="job-id-chip flex-shrink-0" style="font-size:10px;padding:1px 6px"><%= b.job_number %></span><% } %>
      <% if (b.suburb) { %><span class="text-xs text-gray-400 flex-shrink-0 hidden sm:inline"><%= b.suburb %></span><% } %>
      <span class="text-[10px] font-semibold text-gray-500 bg-gray-100 px-1.5 py-0.5 rounded-full flex-shrink-0"><%= b.crew_count %> crew</span>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="px-4 pb-4 text-sm text-gray-400">No bookings scheduled today.</p>
  <% } %>
</div>
<% } %>

<!-- ============================================================
     Band 3 — one trend: the job pipeline. Deeper analysis lives
     in /reports; this page keeps exactly one chart.
     ============================================================ -->
<div class="bg-white border border-gray-200 rounded-2xl p-4" id="trend">
  <div class="flex items-center justify-between mb-2">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-wider">Job Pipeline</h2>
    <a href="/reports" class="text-xs text-brand-600 hover:text-brand-700 font-medium">More in Reports &rarr;</a>
  </div>
  <% if (jobStatusDist.length > 0) { %>
  <div class="relative" style="height: 200px;">
    <canvas id="jobStatusChart"></canvas>
  </div>
  <% } else { %>
  <p class="text-sm text-gray-400 text-center py-8">No jobs yet.</p>
  <% } %>
</div>

<!-- Quick Actions live in the global FAB (bottom-right, on every page). -->

<% if (jobStatusDist.length > 0) { %>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
  Chart.defaults.font.family = 'system-ui, -apple-system, sans-serif';
  Chart.defaults.font.size = 11;

  var statusData = <%- JSON.stringify(jobStatusDist) %>;
  var sLabels = { lead: 'Lead', won: 'Won', active: 'Active', on_hold: 'On Hold', completed: 'Completed', lost: 'Lost', tender: 'Tender', prestart: 'Prestart', closed: 'Closed' };
  var sColors = { lead: '#94a3b8', tender: '#94a3b8', won: '#34d399', prestart: '#a78bfa', active: '#2B7FFF', on_hold: '#fb923c', completed: '#6ee7b7', lost: '#fca5a5', closed: '#d1d5db' };
  new Chart(document.getElementById('jobStatusChart'), {
    type: 'bar',
    data: {
      labels: statusData.map(function(d) { return sLabels[d.status] || d.status; }),
      datasets: [{ data: statusData.map(function(d) { return d.count; }), backgroundColor: statusData.map(function(d) { return sColors[d.status] || '#94a3b8'; }), borderRadius: 6, barThickness: 18 }]
    },
    options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false }, ticks: { stepSize: 1 } }, y: { grid: { display: false } } } }
  });
</script>
<% } %>
