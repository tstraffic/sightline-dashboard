<%
// Meeting notebook page — five separated sections mirroring the paper
// notebook: Refresher, Discussion, To-dos (High/Low), Job updates,
// Plans & proposals. Each text section is its own form so saving one never
// clobbers a colleague's edit in another (and future autosave/AI target the
// same per-section endpoint).
function fmtTime(hhmm) {
  const m = String(hhmm || '').match(/^(\d{1,2}):(\d{2})$/);
  if (!m) return '';
  let h = parseInt(m[1], 10);
  const ap = h >= 12 ? 'pm' : 'am';
  h = h % 12 || 12;
  return h + ':' + m[2] + ' ' + ap;
}
const subtitleBits = [formatDate(meeting.meeting_date)];
if (meeting.meeting_time) subtitleBits.push(fmtTime(meeting.meeting_time));
if (meeting.attendees) subtitleBits.push(meeting.attendees);
%>

<style>
  /* Last-meeting disclosure: swap the native marker for the rotating caret. */
  [data-last-meeting] > summary { list-style: none; }
  [data-last-meeting] > summary::-webkit-details-marker { display: none; }
  [data-last-meeting] > summary .lm-caret { transition: transform .15s ease; }
  [data-last-meeting][open] > summary .lm-caret { transform: rotate(90deg); }
</style>

<%- include('../partials/page-header', {
  eyebrow: dept.label,
  title: meeting.title,
  subtitle: subtitleBits.join(' · '),
  rail: true,
  actions: [
    { label: dept.label + ' Home', href: '/departments/' + dept.key, style: 'secondary' },
    { label: 'Edit details', href: '#edit', style: 'secondary' }
  ]
}) %>

<% if (meeting.status === 'cancelled') { %>
  <div class="max-w-4xl flex items-center justify-between gap-3 bg-amber-50 border border-amber-200 rounded-xl p-4 mb-5">
    <p class="text-sm text-amber-800 font-medium">This meeting was cancelled.</p>
    <form method="POST" action="/departments/<%= dept.key %>/meetings/<%= meeting.id %>/cancel">
      <%- include('../partials/csrf') %>
      <button type="submit" class="px-3 py-1.5 bg-white border border-amber-300 hover:bg-amber-100 text-amber-800 text-xs font-semibold rounded-lg transition-colors">Restore meeting</button>
    </form>
  </div>
<% } %>

<%
// One notebook section card: numbered badge + title + optional right-side
// content, body rendered by the caller.
function sectionCard(num, id, heading, right, bodyFn) { %>
  <div id="<%= id %>" class="bg-white border border-gray-200 rounded-xl shadow-sm scroll-mt-20">
    <div class="flex items-center justify-between gap-2 px-5 pt-4 pb-3 border-b border-gray-100">
      <div class="flex items-center gap-2.5">
        <span class="w-6 h-6 rounded-full bg-brand-600 text-white text-[11px] font-bold flex items-center justify-center shrink-0"><%= num %></span>
        <p class="text-[11px] font-bold text-gray-700 uppercase tracking-widest"><%= heading %></p>
      </div>
      <% if (right) { %><div class="flex items-center gap-2 min-w-0"><%- right %></div><% } %>
    </div>
    <div class="p-5 pt-4"><% bodyFn(); %></div>
  </div>
<% }

function textSection(num, sectionKey, heading, value, placeholder, rows, right) {
  sectionCard(num, 'section-' + sectionKey, heading, right, function () { %>
    <form method="POST" action="/departments/<%= dept.key %>/meetings/<%= meeting.id %>/sections">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="section" value="<%= sectionKey %>">
      <textarea name="content" rows="<%= rows %>" placeholder="<%= placeholder %>"
        class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-brand-500"><%= value %></textarea>
      <div class="flex items-center justify-end mt-2">
        <button type="submit" class="px-4 py-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-lg transition-colors">Save</button>
      </div>
    </form>
<% });
}
%>

<div class="max-w-4xl space-y-5">

  <%
    // ① Refresher — prev-meeting chip + provenance badge (flips to "AI draft"
    // when a later AI writer fills this section).
    let recapRight = '';
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    if (prevMeeting) {
      recapRight = '<a href="/departments/' + dept.key + '/meetings/' + prevMeeting.id + '" class="text-[11px] font-medium text-brand-600 hover:text-brand-700 truncate">Previous: ' +
        esc(prevMeeting.title) + ' · ' + formatDateShort(prevMeeting.meeting_date) + ' →</a>';
    } else {
      recapRight = '<span class="text-[11px] text-gray-400">First meeting for ' + dept.label + '</span>';
    }
    recapRight += '<span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-bold ' +
      (meeting.recap_source === 'ai' ? 'bg-violet-100 text-violet-700">AI draft' : 'bg-gray-100 text-gray-500">Manual') + '</span>';

    // Last meeting's own notes, shown inline so you can look back at any
    // point while writing today's — no need to leave the page.
    const prevText = (v) => String(v || '').trim();
    const prevOpenTodos = prevTodos.filter(t => !t.done);
    const prevHasNotes = !!(prevMeeting && (prevText(prevMeeting.recap) || prevText(prevMeeting.discussion)
      || prevText(prevMeeting.job_updates) || prevText(prevMeeting.plans_proposals) || prevTodos.length));

    function prevBlock(label, text) {
      if (!prevText(text)) return;
  %>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1"><%= label %></p>
          <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap"><%= text %></p>
        </div>
  <%
    }

    sectionCard(1, 'section-recap', 'Refresher — last meeting', recapRight, function () {
  %>
      <% if (!prevMeeting) { %>
        <div class="rounded-lg border border-dashed border-gray-200 bg-gray-50/60 px-4 py-5 text-center mb-4">
          <p class="text-sm text-gray-500">No previous <%= dept.label %> meeting to look back on — this is the first one.</p>
        </div>
      <% } else { %>
        <%/* Open by default until you've written your own refresher; after
             that it stays where you last left it (remembered per browser). */%>
        <details data-last-meeting class="mb-4 rounded-lg border border-gray-200 overflow-hidden" <%= prevText(meeting.recap) ? '' : 'open' %>>
          <summary class="cursor-pointer select-none px-4 py-2.5 bg-gray-50 hover:bg-gray-100 flex items-center gap-2 transition-colors">
            <svg class="lm-caret w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            <span class="text-sm font-medium text-gray-700 shrink-0">Last meeting's notes</span>
            <span class="text-xs text-gray-400 truncate"><%= prevMeeting.title %> · <%= formatDateShort(prevMeeting.meeting_date) %></span>
          </summary>
          <div class="px-4 py-4 space-y-4 border-t border-gray-100">
            <% if (!prevHasNotes) { %>
              <p class="text-sm text-gray-400 italic">Nothing was written up in that meeting.</p>
            <% } %>
            <% prevBlock('Refresher noted then', prevMeeting.recap); %>
            <% prevBlock('Discussion notes', prevMeeting.discussion); %>
            <% if (prevTodos.length) { %>
              <div>
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5">
                  To-dos from last meeting<% if (prevOpenTodos.length) { %><span class="ml-1.5 px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-700 text-[10px] font-bold normal-case tracking-normal"><%= prevOpenTodos.length %> still open</span><% } %>
                </p>
                <ul class="space-y-1">
                  <% prevTodos.forEach(function (t) { %>
                    <li class="flex items-start gap-2">
                      <span class="mt-[7px] w-1.5 h-1.5 rounded-full shrink-0 <%= t.done ? 'bg-emerald-400' : (t.priority === 'high' ? 'bg-red-500' : 'bg-gray-300') %>"></span>
                      <span class="text-sm leading-snug <%= t.done ? 'line-through text-gray-400' : 'text-gray-700' %>"><%= t.text %></span>
                    </li>
                  <% }); %>
                </ul>
              </div>
            <% } %>
            <% prevBlock('Job updates', prevMeeting.job_updates); %>
            <% prevBlock('Plans & proposals', prevMeeting.plans_proposals); %>
            <div class="pt-1">
              <a href="/departments/<%= dept.key %>/meetings/<%= prevMeeting.id %>" class="text-[11px] font-semibold text-brand-600 hover:text-brand-700">Open that meeting in full →</a>
            </div>
          </div>
        </details>
      <% } %>

      <form method="POST" action="/departments/<%= dept.key %>/meetings/<%= meeting.id %>/sections">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="section" value="recap">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Your refresher note</p>
        <textarea name="content" rows="5" placeholder="Where we left off, carried-over items…"
          class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-brand-500"><%= meeting.recap %></textarea>
        <div class="flex items-center justify-end mt-2">
          <button type="submit" class="px-4 py-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-lg transition-colors">Save</button>
        </div>
      </form>
  <%
    });

    // ② Discussion notes
    textSection(2, 'discussion', 'Discussion notes', meeting.discussion,
      'What was discussed in this meeting…', 8, '');
  %>

  <!-- ③ To-dos -->
  <% sectionCard(3, 'section-todos', 'To-dos', '', function () {
       const high = todos.filter(t => t.priority === 'high');
       const low = todos.filter(t => t.priority !== 'high');
       function todoCol(list, priority, headingHtml) { %>
        <div>
          <%- headingHtml %>
          <div class="space-y-1 mb-3">
            <% if (!list.length) { %>
              <p class="text-xs text-gray-300 italic py-1">None yet.</p>
            <% } %>
            <% list.forEach(function (t) { %>
              <div class="flex items-start gap-2 group">
                <form method="POST" action="/departments/<%= dept.key %>/meetings/<%= meeting.id %>/todos/<%= t.id %>/toggle" class="shrink-0 pt-0.5">
                  <%- include('../partials/csrf') %>
                  <button type="submit" title="<%= t.done ? 'Reopen' : 'Mark done' %>"
                    class="w-4 h-4 rounded border flex items-center justify-center transition-colors <%= t.done ? 'bg-emerald-500 border-emerald-500' : 'border-gray-300 hover:border-brand-500 hover:bg-brand-50' %>">
                    <% if (t.done) { %><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><% } %>
                  </button>
                </form>
                <p class="flex-1 min-w-0 text-sm leading-snug <%= t.done ? 'line-through text-gray-400' : 'text-gray-800' %>"><%= t.text %></p>
                <form method="POST" action="/departments/<%= dept.key %>/meetings/<%= meeting.id %>/todos/<%= t.id %>/delete" class="shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="text-gray-300 hover:text-red-500 text-sm leading-none px-1" title="Delete">×</button>
                </form>
              </div>
            <% }); %>
          </div>
          <form method="POST" action="/departments/<%= dept.key %>/meetings/<%= meeting.id %>/todos" class="flex gap-1.5">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="priority" value="<%= priority %>">
            <input type="text" name="text" required placeholder="Add a to-do…"
              class="flex-1 min-w-0 px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
            <button type="submit" class="px-2.5 py-1.5 bg-gray-100 hover:bg-brand-50 border border-gray-200 hover:border-brand-200 text-gray-600 hover:text-brand-700 text-xs font-bold rounded-lg transition-colors">+ Add</button>
          </form>
        </div>
  <%   } %>
      <div class="grid sm:grid-cols-2 gap-5">
        <% todoCol(high, 'high', '<p class="flex items-center gap-1.5 text-[10px] font-bold text-red-500 uppercase tracking-widest mb-2"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>High priority</p>'); %>
        <% todoCol(low, 'low', '<p class="flex items-center gap-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2"><span class="w-1.5 h-1.5 rounded-full bg-gray-300"></span>Low priority</p>'); %>
      </div>
  <% }); %>

  <%
    // ④ Job updates + ⑤ Plans & proposals
    textSection(4, 'job_updates', 'Job updates', meeting.job_updates,
      'Site and job progress worth noting…', 6, '');
    textSection(5, 'plans_proposals', 'Plans & proposals', meeting.plans_proposals,
      'Ideas, proposals, next steps…', 6, '');
  %>

  <!-- Footer actions -->
  <div class="flex items-center justify-end gap-4 pb-6">
    <form method="POST" action="/departments/<%= dept.key %>/meetings/<%= meeting.id %>/cancel">
      <%- include('../partials/csrf') %>
      <button type="submit" class="text-xs font-medium text-gray-400 hover:text-gray-600"><%= meeting.status === 'cancelled' ? 'Restore meeting' : 'Cancel meeting' %></button>
    </form>
    <% if (canDelete) { %>
      <form method="POST" action="/departments/<%= dept.key %>/meetings/<%= meeting.id %>/delete" onsubmit="return confirm('Delete this meeting and all its notes and to-dos?');">
        <%- include('../partials/csrf') %>
        <button type="submit" class="text-xs font-medium text-red-400 hover:text-red-600">Delete meeting</button>
      </form>
    <% } %>
  </div>

  <!-- Edit details -->
  <details id="edit" class="bg-white border border-gray-200 rounded-xl shadow-sm scroll-mt-20">
    <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-600 hover:text-gray-900 select-none">Edit meeting details</summary>
    <form method="POST" action="/departments/<%= dept.key %>/meetings/<%= meeting.id %>" class="px-5 pb-5 pt-1 grid sm:grid-cols-2 gap-3">
      <%- include('../partials/csrf') %>
      <div class="sm:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Title</label>
        <input type="text" name="title" required value="<%= meeting.title %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Date</label>
        <input type="date" name="meeting_date" required value="<%= meeting.meeting_date %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Time</label>
        <input type="time" name="meeting_time" value="<%= meeting.meeting_time %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div class="sm:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Attendees</label>
        <input type="text" name="attendees" value="<%= meeting.attendees %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div class="sm:col-span-2">
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition-colors">Save details</button>
      </div>
    </form>
  </details>
</div>

<% if (prevMeeting) { %>
  <%/* Jump back to last meeting's notes from anywhere on the page — appears
       once the Refresher card scrolls out of view. Bottom-LEFT so it clears
       the global Quick Actions FAB and feedback pill on the right; offset
       past the 240px desktop sidebar. */%>
  <button type="button" id="lastMtgPeek" aria-label="Show last meeting's notes"
    class="hidden fixed bottom-5 left-5 lg:left-[260px] z-30 items-center gap-1.5 px-3 py-2 rounded-full bg-gray-900/90 hover:bg-gray-900 text-white text-xs font-semibold shadow-lg backdrop-blur transition-colors print:hidden">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
    Last meeting
  </button>
  <script>
    (function () {
      var card = document.getElementById('section-recap');
      var btn = document.getElementById('lastMtgPeek');
      var det = document.querySelector('[data-last-meeting]');
      if (!card || !btn) return;

      // Remember whether the panel is open, so someone who likes it open
      // keeps it open across meetings without re-clicking every time.
      var KEY = 'deptLastMeetingOpen';
      if (det) {
        try {
          var saved = localStorage.getItem(KEY);
          if (saved === '1') det.open = true;
          else if (saved === '0') det.open = false;
        } catch (e) { /* storage blocked — just use the server default */ }
        det.addEventListener('toggle', function () {
          try { localStorage.setItem(KEY, det.open ? '1' : '0'); } catch (e) {}
        });
      }

      // The admin layout scrolls inside <main class="overflow-auto">, not the
      // window — both the observer root and the scroll-back need that element
      // (scrollIntoView doesn't reliably drive this nested scroller).
      function scrollParent(el) {
        var n = el.parentElement;
        while (n && n !== document.documentElement) {
          var cs = getComputedStyle(n);
          if (/(auto|scroll)/.test(cs.overflowY) && n.scrollHeight > n.clientHeight + 4) return n;
          n = n.parentElement;
        }
        return null; // fall back to the viewport
      }

      btn.addEventListener('click', function () {
        if (det) det.open = true;
        var sp = scrollParent(card);
        if (!sp) { card.scrollIntoView({ block: 'start' }); return; }
        var target = Math.max(0, card.getBoundingClientRect().top - sp.getBoundingClientRect().top + sp.scrollTop - 12);
        try { sp.scrollTo({ top: target, behavior: 'smooth' }); } catch (e) { /* older browsers */ }
        // Smooth scrolling on a nested scroller is silently ignored in some
        // engines (and by reduce-motion settings) — land the jump regardless.
        setTimeout(function () {
          if (Math.abs(sp.scrollTop - target) > 4) sp.scrollTop = target;
        }, 350);
      });

      if (!('IntersectionObserver' in window)) return; // pill stays hidden; panel still works
      new IntersectionObserver(function (entries) {
        var visible = entries[0].isIntersecting;
        btn.classList.toggle('hidden', visible);
        btn.classList.toggle('flex', !visible);
      }, { root: scrollParent(card), threshold: 0 }).observe(card);
    })();
  </script>
<% } %>
