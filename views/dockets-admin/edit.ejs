<% locals.currentPage = 'dockets-admin' %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-5">
  <div>
    <a href="/dockets/<%= docket.id %>" class="text-sm text-brand-600 font-medium inline-flex items-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      Back to docket
    </a>
    <h1 class="mt-1 text-2xl font-bold text-gray-900 flex items-center gap-2">
      Adjust docket
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-blue-50 text-blue-700 ring-1 ring-blue-600/10">v<%= docket.version || 1 %></span>
    </h1>
    <p class="text-sm text-gray-500">
      <%= docket.job_number || '' %><% if (docket.job_client) { %> — <%= docket.job_client %><% } %>
      <% if (docket.allocation_date) { %> · <%= docket.allocation_date %><% } %>
    </p>
  </div>

  <form method="POST" action="/dockets/<%= docket.id %>" class="space-y-5">
    <%- include('../partials/csrf') %>

    <!-- Crew & hours -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <h2 class="text-sm font-semibold text-gray-900 px-5 pt-4">Crew &amp; hours</h2>
      <table class="w-full text-sm mt-2">
        <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
          <tr>
            <th class="text-left px-5 py-2">Crew member</th>
            <th class="text-left px-2 py-2">Start</th>
            <th class="text-left px-2 py-2">Finish</th>
            <th class="text-left px-2 py-2">Break</th>
            <th class="text-left px-2 py-2">Travel</th>
            <th class="text-left px-2 py-2 pr-5">Remove</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% crewLines.forEach(function (c) { var base = 'crew[cm' + c.crew_member_id + ']'; %>
            <tr>
              <td class="px-5 py-2 font-medium text-gray-900"><%= c.name %><% if (c.role) { %> <span class="text-xs text-gray-400"><%= c.role %></span><% } %></td>
              <td class="px-2 py-2"><input type="time" name="<%= base %>[start_on_site]" value="<%= c.start_on_site || '' %>" class="border border-gray-300 rounded-lg px-2 py-1.5 text-sm w-28"></td>
              <td class="px-2 py-2"><input type="time" name="<%= base %>[finish_on_site]" value="<%= c.finish_on_site || '' %>" class="border border-gray-300 rounded-lg px-2 py-1.5 text-sm w-28"></td>
              <td class="px-2 py-2"><input type="number" min="0" max="180" step="5" name="<%= base %>[break_minutes]" value="<%= c.break_minutes || 0 %>" class="border border-gray-300 rounded-lg px-2 py-1.5 text-sm w-20"></td>
              <td class="px-2 py-2"><input type="number" min="0" max="8" step="0.25" name="<%= base %>[travel_hours]" value="<%= c.travel_hours || 0 %>" class="border border-gray-300 rounded-lg px-2 py-1.5 text-sm w-20"></td>
              <td class="px-2 py-2 pr-5">
                <% if (c.dc_id) { %>
                  <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-700 cursor-pointer">
                    <input type="checkbox" name="remove" value="<%= c.dc_id %>" class="h-4 w-4 rounded border-red-300 text-red-600">
                    Drop
                  </label>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="text-xs text-gray-400 px-5 py-3">Totals recalculate on save. Ticking "Drop" removes that person from this docket.</p>
    </div>

    <% if (typeof addable !== 'undefined' && addable && addable.length) { %>
      <!-- Add crew from booking_crew not yet on this docket -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <h2 class="text-sm font-semibold text-gray-900 px-5 pt-4">Add someone to the docket</h2>
        <p class="text-xs text-gray-500 px-5 mt-1">These crew are on the booking but not yet on this docket version.</p>
        <table class="w-full text-sm mt-2">
          <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase tracking-wide">
            <tr>
              <th class="text-left px-5 py-2">Add</th>
              <th class="text-left px-2 py-2">Crew member</th>
              <th class="text-left px-2 py-2">Start</th>
              <th class="text-left px-2 py-2">Finish</th>
              <th class="text-left px-2 py-2">Break</th>
              <th class="text-left px-2 py-2 pr-5">Travel</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% addable.forEach(function (p) { var base = 'crew[add' + p.crew_member_id + ']'; %>
              <tr>
                <td class="px-5 py-2"><input type="checkbox" name="add_crew" value="<%= p.crew_member_id %>" class="h-4 w-4 rounded border-gray-300 text-brand-600"></td>
                <td class="px-2 py-2 font-medium text-gray-900"><%= p.full_name %><% if (p.role_on_site) { %> <span class="text-xs text-gray-400"><%= p.role_on_site %></span><% } %></td>
                <td class="px-2 py-2"><input type="time" name="<%= base %>[start_on_site]" value="<%= docket.start_on_site || '' %>" class="border border-gray-300 rounded-lg px-2 py-1.5 text-sm w-28"></td>
                <td class="px-2 py-2"><input type="time" name="<%= base %>[finish_on_site]" value="<%= docket.finish_on_site || '' %>" class="border border-gray-300 rounded-lg px-2 py-1.5 text-sm w-28"></td>
                <td class="px-2 py-2"><input type="number" min="0" max="180" step="5" name="<%= base %>[break_minutes]" value="<%= docket.break_minutes || 30 %>" class="border border-gray-300 rounded-lg px-2 py-1.5 text-sm w-20"></td>
                <td class="px-2 py-2 pr-5"><input type="number" min="0" max="8" step="0.25" name="<%= base %>[travel_hours]" value="0" class="border border-gray-300 rounded-lg px-2 py-1.5 text-sm w-20"></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <p class="text-xs text-gray-400 px-5 py-3">Tick the row, set their hours, and save — only ticked rows are added.</p>
      </div>
    <% } %>

    <!-- Client + notes -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-4">
      <div>
        <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wide mb-1">Client representative</label>
        <input type="text" name="client_name" value="<%= docket.client_name || '' %>" placeholder="Name of the person who signed off"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
      </div>
      <label class="inline-flex items-center gap-2 text-sm text-gray-700">
        <input type="checkbox" name="no_client_on_site" value="1" id="no-client" <%= docket.no_client_on_site ? 'checked' : '' %> class="h-4 w-4 rounded border-gray-300 text-brand-600">
        No client on site
      </label>
      <div id="no-client-reason" style="<%= docket.no_client_on_site ? '' : 'display:none;' %>">
        <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wide mb-1">Reason</label>
        <input type="text" name="no_client_reason" value="<%= docket.no_client_reason || '' %>"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
      </div>
      <div>
        <label class="block text-[11px] font-semibold text-gray-500 uppercase tracking-wide mb-1">Notes</label>
        <textarea name="notes" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500"><%= docket.notes || '' %></textarea>
      </div>
      <p class="text-xs text-gray-400">Signatures are carried over from the original docket and aren't re-captured here.</p>
    </div>

    <div class="flex items-center gap-2">
      <button type="submit" class="px-5 py-2.5 rounded-lg bg-brand-600 text-white text-sm font-semibold hover:bg-brand-700">Save changes</button>
      <a href="/dockets/<%= docket.id %>" class="px-5 py-2.5 rounded-lg bg-white border border-gray-300 text-sm font-semibold text-gray-700 hover:bg-gray-50">Cancel</a>
    </div>
  </form>
</div>

<script>
  (function () {
    var t = document.getElementById('no-client');
    var w = document.getElementById('no-client-reason');
    if (t) t.addEventListener('change', function () { w.style.display = t.checked ? '' : 'none'; });
  })();
</script>
