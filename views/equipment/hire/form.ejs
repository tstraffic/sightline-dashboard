<% locals.currentPage = 'equipment' %>
<%
  const isEdit = hire !== null && typeof hire !== 'undefined';
  const v = (k, d) => (isEdit && hire[k] != null ? hire[k] : (d || ''));
  const action = isEdit ? ('/equipment/hire/' + hire.id) : '/equipment/hire';
%>

<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/equipment/hire" class="hover:text-gray-900 transition">Hired</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900"><%= isEdit ? 'Edit hire' : 'New hire' %></span>
</div>

<div class="mb-5">
  <h1 class="text-2xl font-bold text-gray-900"><%= isEdit ? 'Edit hire' : 'New hire' %></h1>
  <p class="text-gray-500 text-sm mt-0.5">Pick a company and equipment type — the rate auto-fills from saved rates.</p>
</div>

<form method="POST" action="<%= action %>" class="space-y-5">
  <%- include('../../partials/csrf') %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Hire Company</label>
        <select name="company_id" class="hire-company w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">— Select company —</option>
          <% companies.forEach(function (c) { %><option value="<%= c.id %>" <%= String(v('company_id')) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
        <% if (isEdit && hire.company_name && !hire.company_id) { %><p class="text-[11px] text-gray-400 mt-1">Was: <%= hire.company_name %></p><% } %>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Equipment Type</label>
        <select name="equipment_type" class="hire-type w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">— Select type —</option>
          <% equipmentTypes.forEach(function (t) { %><option value="<%= t.value %>" <%= v('equipment_type') === t.value ? 'selected' : '' %>><%= t.label %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Quantity</label>
        <input type="number" name="quantity" min="1" value="<%= v('quantity', 1) %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Rate ($) <span class="hire-rate-auto text-emerald-600 normal-case font-medium hidden">· auto-filled</span></label>
        <input type="number" step="0.01" name="rate" value="<%= isEdit ? hire.rate : '' %>" placeholder="0.00" class="hire-rate w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Per</label>
        <select name="rate_unit" class="hire-unit w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <% rateUnits.forEach(function (u) { %><option value="<%= u %>" <%= v('rate_unit', 'day') === u ? 'selected' : '' %>><%= u %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Status</label>
        <select name="status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <% [['on_hire','On hire'],['off_hired','Off-hired'],['cancelled','Cancelled']].forEach(function (o) { %><option value="<%= o[0] %>" <%= v('status','on_hire') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Start Date</label>
        <input type="date" name="start_date" value="<%= v('start_date') %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">End Date <span class="text-gray-400 normal-case font-medium">(blank = ongoing)</span></label>
        <input type="date" name="end_date" value="<%= v('end_date') %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Supplier Reference</label>
        <input type="text" name="reference" value="<%= v('reference') %>" placeholder="Hire ref / PO no." class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Rego / Serial</label>
        <input type="text" name="registration" value="<%= v('registration') %>" placeholder="If applicable" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <div class="sm:col-span-2 lg:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Description</label>
        <input type="text" name="description" value="<%= v('description') %>" placeholder="e.g. 20kVA towable generator" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
    </div>
    <div class="mt-4">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Notes</label>
      <textarea name="notes" rows="2" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-y"><%= v('notes') %></textarea>
    </div>
  </div>

  <!-- Unit numbers — one input per item on hire (kept in step with Quantity).
       These are the numbers the return flow confirms one by one. -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <div class="flex items-center justify-between mb-2">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Unit Numbers</p>
        <p class="text-[11px] text-gray-500 mt-0.5">One per item (e.g. the hire company's asset numbers). Optional — but returns are confirmed against these.</p>
      </div>
      <span class="text-[11px] text-gray-400" id="hire-units-count"></span>
    </div>
    <%
      const allUnits = (typeof units !== 'undefined' && units) ? units : [];
      const returnedUnits = allUnits.filter(u => u.returned_at);
      const openUnits = allUnits.filter(u => !u.returned_at);
    %>
    <% if (returnedUnits.length) { %>
      <div class="mb-3">
        <p class="text-[10px] font-bold text-emerald-600 uppercase tracking-widest mb-1.5">Already returned (locked)</p>
        <div class="flex flex-wrap gap-1.5">
          <% returnedUnits.forEach(function (u) { %>
            <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20 text-xs font-semibold">
              <%= u.unit_number || 'Unit' %> <span class="font-normal text-emerald-600/70">· back <%= u.returned_at %></span>
            </span>
          <% }) %>
        </div>
      </div>
    <% } %>
    <div id="hire-units" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2"
         data-min="<%= returnedUnits.length %>">
      <% openUnits.forEach(function (u, i) { %>
        <input type="text" name="unit_numbers[]" value="<%= u.unit_number || '' %>" placeholder="Unit no. <%= returnedUnits.length + i + 1 %>"
               class="hire-unit-no px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      <% }) %>
    </div>
  </div>
  <div class="flex items-center justify-end gap-2">
    <a href="/equipment/hire" class="px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg">Cancel</a>
    <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg"><%= isEdit ? 'Save hire' : 'Add hire' %></button>
  </div>
</form>

<script>
(function () {
  var company = document.querySelector('.hire-company');
  var hType = document.querySelector('.hire-type');
  var rate = document.querySelector('.hire-rate');
  var unit = document.querySelector('.hire-unit');
  var autoTag = document.querySelector('.hire-rate-auto');
  var dirty = <%= isEdit && hire.rate ? 'true' : 'false' %>;
  rate.addEventListener('input', function () { dirty = true; if (autoTag) autoTag.classList.add('hidden'); });
  function lookup() {
    if (!company.value || !hType.value) return;
    if (dirty && rate.value) return;
    fetch('/equipment/hire/rate-lookup?company_id=' + encodeURIComponent(company.value) +
          '&equipment_type=' + encodeURIComponent(hType.value) +
          '&rate_unit=' + encodeURIComponent(unit.value))
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.found && d.rate != null) {
          rate.value = d.rate;
          if (d.rate_unit) unit.value = d.rate_unit;
          dirty = false;
          if (autoTag) autoTag.classList.remove('hidden');
        }
      }).catch(function () {});
  }
  [company, hType, unit].forEach(function (el) { if (el) el.addEventListener('change', lookup); });

  // ---- Unit-number inputs follow Quantity ----
  var qtyInput = document.querySelector('input[name="quantity"]');
  var unitsBox = document.getElementById('hire-units');
  var unitsCount = document.getElementById('hire-units-count');
  var lockedCount = unitsBox ? parseInt(unitsBox.getAttribute('data-min'), 10) || 0 : 0;
  function syncUnitInputs() {
    if (!unitsBox || !qtyInput) return;
    var qty = Math.max(1, Math.min(500, parseInt(qtyInput.value, 10) || 1));
    // Never below what's already been returned (those are locked history).
    if (qty < lockedCount) { qty = lockedCount; qtyInput.value = qty; }
    var want = qty - lockedCount;
    var inputs = unitsBox.querySelectorAll('input.hire-unit-no');
    for (var i = inputs.length - 1; i >= want; i--) inputs[i].remove();
    for (var j = inputs.length; j < want; j++) {
      var inp = document.createElement('input');
      inp.type = 'text';
      inp.name = 'unit_numbers[]';
      inp.placeholder = 'Unit no. ' + (lockedCount + j + 1);
      inp.className = 'hire-unit-no px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent';
      unitsBox.appendChild(inp);
    }
    if (unitsCount) unitsCount.textContent = qty + ' unit' + (qty === 1 ? '' : 's') + (lockedCount ? ' (' + lockedCount + ' already returned)' : '');
  }
  if (qtyInput) { qtyInput.addEventListener('input', syncUnitInputs); syncUnitInputs(); }
})();
</script>
