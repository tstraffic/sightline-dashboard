<% locals.currentPage = 'fleet' %>
<%
  const TONES = {
    ok:    'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20',
    warn:  'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20',
    bad:   'bg-red-50 text-red-700 ring-1 ring-red-600/20',
    muted: 'bg-gray-50 text-gray-500 ring-1 ring-gray-200',
  };
%>

<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/fleet" class="hover:text-gray-900 transition">Fleet Register</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900">Compliance Alerts</span>
</div>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Compliance Alerts</h1>
    <p class="text-gray-500 text-sm mt-0.5">Vehicles overdue or due within 30 days · one screen for the office team to action</p>
  </div>
  <a href="/fleet" class="px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg">← Back to Register</a>
</div>

<% if (flagged.length === 0) { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8 text-center">
    <div class="w-12 h-12 mx-auto mb-3 bg-emerald-50 rounded-full flex items-center justify-center">
      <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>
    <h2 class="text-lg font-semibold text-gray-900">All clear</h2>
    <p class="text-sm text-gray-500 mt-1">No vehicles are overdue or due within the next 30 days.</p>
  </div>
<% } else { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50">
        <tr class="text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">
          <th class="px-4 py-3">Vehicle</th>
          <th class="px-4 py-3 hidden sm:table-cell">Rego</th>
          <th class="px-4 py-3">Item</th>
          <th class="px-4 py-3">Due Date</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3 w-20"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% flagged.forEach(({ vehicle, b }) => {
          const items = [
            { key: 'registration', label: 'Registration',      date: vehicle.registration_expiry,      status: b.registration },
            { key: 'inspection',   label: 'Inspection',        date: vehicle.inspection_due,           status: b.inspection },
            { key: 'service',      label: 'Next Service',      date: vehicle.next_service_date,        status: b.service },
            { key: 'fireExt',      label: 'Fire Extinguisher', date: vehicle.fire_extinguisher_expiry, status: b.fireExt },
          ].filter(i => i.status.tone === 'bad' || i.status.tone === 'warn');
        %>
          <% items.forEach((i, idx) => { %>
            <tr class="hover:bg-gray-50">
              <% if (idx === 0) { %>
                <td rowspan="<%= items.length %>" class="px-4 py-3 align-top border-r border-gray-100">
                  <a href="/fleet/<%= vehicle.id %>" class="text-brand-600 hover:text-brand-700 font-semibold hover:underline"><%= vehicle.asset_id %></a>
                  <p class="text-xs text-gray-500 mt-0.5"><%= [vehicle.make, vehicle.model].filter(Boolean).join(' ') %></p>
                  <% if (vehicle.status === 'Verify') { %><span class="mt-1 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-50 text-amber-800 ring-1 ring-amber-600/20">VERIFY</span><% } %>
                </td>
                <td rowspan="<%= items.length %>" class="px-4 py-3 align-top hidden sm:table-cell text-gray-700 font-mono text-xs border-r border-gray-100"><%= vehicle.rego || '—' %></td>
              <% } %>
              <td class="px-4 py-3 text-gray-700"><%= i.label %></td>
              <td class="px-4 py-3 text-xs text-gray-600"><%= i.date ? formatDate(i.date) : '—' %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold <%= TONES[i.status.tone] %>">
                  <%= i.status.label %><% if (i.status.daysUntil !== null) { %> · <%= i.status.daysUntil < 0 ? `${Math.abs(i.status.daysUntil)}d ago` : `in ${i.status.daysUntil}d` %><% } %>
                </span>
              </td>
              <% if (idx === 0) { %>
                <td rowspan="<%= items.length %>" class="px-4 py-3 align-top text-right">
                  <a href="/fleet/<%= vehicle.id %>/edit" class="text-brand-600 hover:text-brand-700 text-xs font-medium">Update →</a>
                </td>
              <% } %>
            </tr>
          <% }) %>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-gray-400"><%= flagged.length %> vehicle<%= flagged.length !== 1 ? 's' : '' %> need attention.</p>
<% } %>
