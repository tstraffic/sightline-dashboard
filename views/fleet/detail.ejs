<% locals.currentPage = 'fleet' %>
<%
  const AUD = n => (n == null || isNaN(Number(n))) ? '-' : '$' + Number(n).toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const KM  = n => (n == null) ? '-' : Number(n).toLocaleString('en-AU') + ' km';
  const TONES = {
    ok:    'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20',
    warn:  'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20',
    bad:   'bg-red-50 text-red-700 ring-1 ring-red-600/20',
    muted: 'bg-gray-50 text-gray-500 ring-1 ring-gray-200',
  };
  const badge = (b, label) => `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ${TONES[b.tone]}">${label}: ${b.label}</span>`;
%>

<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/fleet" class="hover:text-gray-900 transition">Fleet Register</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900"><%= vehicle.asset_id %></span>
</div>

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">
      <%= vehicle.asset_id %>
      <span class="font-normal text-gray-500 text-base"><%= [vehicle.make, vehicle.model].filter(Boolean).join(' ') %><% if (vehicle.year) { %> · <%= vehicle.year %><% } %></span>
    </h1>
    <div class="flex flex-wrap gap-2 mt-2">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold
        <% if (vehicle.status === 'Active') { %>bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20
        <% } else if (vehicle.status === 'Verify') { %>bg-amber-50 text-amber-800 ring-1 ring-amber-600/20
        <% } else if (vehicle.status === 'Retired') { %>bg-gray-100 text-gray-500
        <% } else { %>bg-blue-50 text-blue-700 ring-1 ring-blue-600/20<% } %>"><%= vehicle.status %></span>
      <% if (vehicle.vehicle_type) { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600"><%= vehicle.vehicle_type %></span><% } %>
      <% if (vehicle.rego) { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono bg-blue-50 text-blue-800 ring-1 ring-blue-600/20"><%= vehicle.rego %></span><% } %>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <a href="/fleet/<%= vehicle.id %>/service/new" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">+ Service Record</a>
    <a href="/fleet/<%= vehicle.id %>/edit" class="px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors">Edit</a>
    <form method="POST" action="/fleet/<%= vehicle.id %>/delete" onsubmit="return confirm('Delete <%= vehicle.asset_id %> and all its service records? This cannot be undone.')">
      <%- include('../partials/csrf') %>
      <button type="submit" class="px-3 py-2 bg-red-50 hover:bg-red-100 text-red-600 text-sm font-medium rounded-lg border border-red-200">Delete</button>
    </form>
  </div>
</div>

<% if (vehicle.status === 'Verify' && vehicle.notes) { %>
  <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 mb-5 flex items-start gap-3">
    <svg class="w-5 h-5 text-amber-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <div>
      <p class="text-xs font-bold text-amber-800 uppercase tracking-widest">Action Required — Verify Against Rego Papers</p>
      <p class="text-sm text-amber-900 mt-1"><%= vehicle.notes %></p>
    </div>
  </div>
<% } %>

<!-- Compliance summary -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
  <% const item = (label, b, dateVal) => { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"><%= label %></p>
      <p class="text-sm font-semibold text-gray-900 mt-0.5"><%= dateVal ? formatDate(dateVal) : '—' %></p>
      <span class="mt-1 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold <%= TONES[b.tone] %>"><%= b.label %></span>
    </div>
  <% } %>
  <%- item('Registration',      badges.registration, vehicle.registration_expiry) %>
  <%- item('Next Service',      badges.service,      vehicle.next_service_date) %>
  <%- item('Inspection',        badges.inspection,   vehicle.inspection_due) %>
  <%- item('Fire Extinguisher', badges.fireExt,      vehicle.fire_extinguisher_expiry) %>
</div>

<!-- Vehicle details + key stats -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6">
  <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl shadow-sm p-4">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-3">Vehicle Details</h2>
    <dl class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm">
      <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Fleet ID</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.fleet_id || '—' %></dd></div>
      <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Rego</dt><dd class="text-gray-900 font-mono mt-0.5"><%= vehicle.rego || '—' %></dd></div>
      <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">VIN</dt><dd class="text-gray-900 font-mono text-xs mt-0.5 break-all"><%= vehicle.vin || '—' %></dd></div>
      <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Toll Tag</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.toll_tag || '—' %></dd></div>
      <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Assigned To</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.assigned_to || '—' %></dd></div>
      <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Vehicle Type</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.vehicle_type || '—' %></dd></div>
      <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">CTP Expiry</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.ctp_expiry ? formatDate(vehicle.ctp_expiry) : '—' %></dd></div>
      <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Insurance Renewal</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.insurance_renewal ? formatDate(vehicle.insurance_renewal) : '—' %></dd></div>
      <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Next Service km</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.next_service_km ? KM(vehicle.next_service_km) : '—' %></dd></div>
    </dl>
    <% if (vehicle.notes && vehicle.status !== 'Verify') { %>
      <div class="mt-4 pt-4 border-t border-gray-100">
        <dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Notes</dt>
        <dd class="text-sm text-gray-700 whitespace-pre-wrap"><%= vehicle.notes %></dd>
      </div>
    <% } %>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-3">Maintenance Stats</h2>
    <dl class="space-y-3 text-sm">
      <div class="flex items-baseline justify-between"><dt class="text-gray-500">Last service</dt><dd class="font-medium text-gray-900"><%= vehicle.last_service_date ? formatDate(vehicle.last_service_date) : '—' %></dd></div>
      <div class="flex items-baseline justify-between"><dt class="text-gray-500">Highest odometer</dt><dd class="font-mono text-gray-900"><%= KM(vehicle.highest_odo_km) %></dd></div>
      <div class="flex items-baseline justify-between"><dt class="text-gray-500">Service count</dt><dd class="font-medium text-gray-900"><%= vehicle.service_count || 0 %></dd></div>
      <div class="flex items-baseline justify-between pt-2 border-t border-gray-100"><dt class="font-semibold text-gray-800">Total spend</dt><dd class="font-bold text-brand-600"><%= AUD(vehicle.total_maint_cost) %></dd></div>
    </dl>
  </div>
</div>

<!-- Service history -->
<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
  <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Service History</h2>
    <a href="/fleet/<%= vehicle.id %>/service/new" class="text-xs font-medium text-brand-600 hover:text-brand-700">+ Add</a>
  </div>
  <% if (services.length === 0) { %>
    <div class="p-6 text-center text-sm text-gray-500">No service records yet. <a href="/fleet/<%= vehicle.id %>/service/new" class="text-brand-600 hover:underline">Add the first one</a>.</div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">
            <th class="px-3 py-2">Date</th>
            <th class="px-3 py-2 hidden sm:table-cell text-right">Odo</th>
            <th class="px-3 py-2">Type</th>
            <th class="px-3 py-2 hidden md:table-cell">Work Performed</th>
            <th class="px-3 py-2 hidden lg:table-cell">Performed By</th>
            <th class="px-3 py-2 text-right">Cost</th>
            <th class="px-3 py-2 hidden lg:table-cell">Invoice</th>
            <th class="px-3 py-2 w-16"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% services.forEach(s => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-3 py-2 text-gray-700 text-xs whitespace-nowrap"><%= s.service_date ? formatDate(s.service_date) : '—' %></td>
              <td class="px-3 py-2 hidden sm:table-cell text-right text-xs font-mono text-gray-600"><%= s.odometer_km ? Number(s.odometer_km).toLocaleString('en-AU') : '—' %></td>
              <td class="px-3 py-2 text-xs"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-blue-50 text-blue-700 ring-1 ring-blue-600/20"><%= s.service_type %></span></td>
              <td class="px-3 py-2 hidden md:table-cell text-xs text-gray-700 max-w-md">
                <%= s.work_performed || '—' %>
                <% if (s.notes) { %><div class="text-[11px] text-amber-700 mt-0.5"><%= s.notes %></div><% } %>
              </td>
              <td class="px-3 py-2 hidden lg:table-cell text-xs text-gray-600"><%= s.performed_by || '—' %></td>
              <td class="px-3 py-2 text-right text-xs font-mono <%= s.cost == null ? 'text-amber-600' : 'text-gray-800' %>"><%= s.cost == null ? '—' : AUD(s.cost) %></td>
              <td class="px-3 py-2 hidden lg:table-cell text-xs text-gray-500 font-mono"><%= s.invoice_number || '—' %></td>
              <td class="px-3 py-2 text-right">
                <a href="/fleet/<%= vehicle.id %>/service/<%= s.id %>/edit" class="text-brand-600 hover:text-brand-700 text-xs font-medium">Edit</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
