<% locals.currentPage = 'fleet' %>
<%
  const AUD = n => (n == null || isNaN(Number(n))) ? '-' : '$' + Number(n).toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const KM  = n => (n == null) ? '-' : Number(n).toLocaleString('en-AU') + ' km';
  const TONES = {
    ok:    'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20',
    warn:  'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20',
    bad:   'bg-red-50 text-red-700 ring-1 ring-red-600/20',
    muted: 'bg-gray-50 text-gray-500 ring-1 ring-gray-200',
  };
  const SEVERITY_TONES = {
    low:      'bg-gray-100 text-gray-700',
    medium:   'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20',
    high:     'bg-orange-50 text-orange-700 ring-1 ring-orange-600/20',
    critical: 'bg-red-50 text-red-700 ring-1 ring-red-600/20',
  };
  const STATUS_TONES = {
    reported:      'bg-blue-50 text-blue-700 ring-1 ring-blue-600/20',
    investigating: 'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20',
    resolved:      'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20',
    closed:        'bg-gray-100 text-gray-600',
  };
  const initialTab = typeof initialTab !== 'undefined' ? initialTab : 'overview';
  // Safely parse equipment-check JSON for previewing what the worker submitted.
  function parseFormData(raw) {
    if (!raw) return {};
    try { return JSON.parse(raw); } catch (e) { return { _raw: String(raw) }; }
  }
%>

<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/fleet" class="hover:text-gray-900 transition">Fleet Register</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900"><%= vehicle.asset_id %></span>
</div>

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">
      <%= vehicle.asset_id %>
      <span class="font-normal text-gray-500 text-base"><%= [vehicle.make, vehicle.model].filter(Boolean).join(' ') %><% if (vehicle.year) { %> · <%= vehicle.year %><% } %></span>
    </h1>
    <div class="flex flex-wrap gap-2 mt-2">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold
        <% if (vehicle.status === 'Active') { %>bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20
        <% } else if (vehicle.status === 'Verify') { %>bg-amber-50 text-amber-800 ring-1 ring-amber-600/20
        <% } else if (vehicle.status === 'Retired') { %>bg-gray-100 text-gray-500
        <% } else { %>bg-blue-50 text-blue-700 ring-1 ring-blue-600/20<% } %>"><%= vehicle.status %></span>
      <% if (vehicle.vehicle_type) { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600"><%= vehicle.vehicle_type %></span><% } %>
      <% if (vehicle.rego) { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono bg-blue-50 text-blue-800 ring-1 ring-blue-600/20"><%= vehicle.rego %></span><% } %>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <a href="/fleet/<%= vehicle.id %>/edit" class="px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors">Edit</a>
    <form method="POST" action="/fleet/<%= vehicle.id %>/delete" onsubmit="return confirm('Delete <%= vehicle.asset_id %> and all its service records? This cannot be undone.')">
      <%- include('../partials/csrf') %>
      <button type="submit" class="px-3 py-2 bg-red-50 hover:bg-red-100 text-red-600 text-sm font-medium rounded-lg border border-red-200">Delete</button>
    </form>
  </div>
</div>

<% if (vehicle.status === 'Verify' && vehicle.notes) { %>
  <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 mb-5 flex items-start gap-3">
    <svg class="w-5 h-5 text-amber-700 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <div>
      <p class="text-xs font-bold text-amber-800 uppercase tracking-widest">Action Required — Verify Against Rego Papers</p>
      <p class="text-sm text-amber-900 mt-1"><%= vehicle.notes %></p>
    </div>
  </div>
<% } %>

<!-- ============================================================
     TAB STRIP — Overview / Service / Incidents / Equipment
     ============================================================ -->
<nav class="vehicle-tabs flex items-center gap-1 border-b border-gray-200 mb-5 overflow-x-auto" aria-label="Vehicle sections" id="vehicleTabs">
  <button type="button" class="v-tab" data-v-tab="overview">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2"/></svg>
    Overview
  </button>
  <button type="button" class="v-tab" data-v-tab="service">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
    Service History
    <% if (services.length) { %><span class="v-tab-count"><%= services.length %></span><% } %>
  </button>
  <button type="button" class="v-tab" data-v-tab="incidents">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
    Incident Reports
    <% if (incidents.length) { %><span class="v-tab-count v-tab-count--red"><%= incidents.length %></span><% } %>
  </button>
  <button type="button" class="v-tab" data-v-tab="equipment">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
    Equipment Counts
    <% if (equipmentChecks.length) { %><span class="v-tab-count"><%= equipmentChecks.length %></span><% } %>
  </button>
</nav>

<!-- ============================================================
     TAB: OVERVIEW
     ============================================================ -->
<section class="v-pane" data-v-pane="overview">
  <!-- Compliance summary -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
    <% const item = (label, b, dateVal) => { %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"><%= label %></p>
        <p class="text-sm font-semibold text-gray-900 mt-0.5"><%= dateVal ? formatDate(dateVal) : '—' %></p>
        <span class="mt-1 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold <%= TONES[b.tone] %>"><%= b.label %></span>
      </div>
    <% } %>
    <%- item('Registration',      badges.registration, vehicle.registration_expiry) %>
    <%- item('Next Service',      badges.service,      vehicle.next_service_date) %>
    <%- item('Inspection',        badges.inspection,   vehicle.inspection_due) %>
    <%- item('Fire Extinguisher', badges.fireExt,      vehicle.fire_extinguisher_expiry) %>
  </div>

  <!-- Vehicle details + key stats -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <div class="lg:col-span-2 bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-3">Vehicle Details</h2>
      <dl class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm">
        <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Fleet ID</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.fleet_id || '—' %></dd></div>
        <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Rego</dt><dd class="text-gray-900 font-mono mt-0.5"><%= vehicle.rego || '—' %></dd></div>
        <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">VIN</dt><dd class="text-gray-900 font-mono text-xs mt-0.5 break-all"><%= vehicle.vin || '—' %></dd></div>
        <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Toll Tag</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.toll_tag || '—' %></dd></div>
        <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Assigned To</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.assigned_to || '—' %></dd></div>
        <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Vehicle Type</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.vehicle_type || '—' %></dd></div>
        <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">CTP Expiry</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.ctp_expiry ? formatDate(vehicle.ctp_expiry) : '—' %></dd></div>
        <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Insurance Renewal</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.insurance_renewal ? formatDate(vehicle.insurance_renewal) : '—' %></dd></div>
        <div><dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Next Service km</dt><dd class="text-gray-900 mt-0.5"><%= vehicle.next_service_km ? KM(vehicle.next_service_km) : '—' %></dd></div>
      </dl>
      <% if (vehicle.notes && vehicle.status !== 'Verify') { %>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <dt class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Notes</dt>
          <dd class="text-sm text-gray-700 whitespace-pre-wrap"><%= vehicle.notes %></dd>
        </div>
      <% } %>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-3">Maintenance Stats</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex items-baseline justify-between"><dt class="text-gray-500">Last service</dt><dd class="font-medium text-gray-900"><%= vehicle.last_service_date ? formatDate(vehicle.last_service_date) : '—' %></dd></div>
        <div class="flex items-baseline justify-between"><dt class="text-gray-500">Highest odometer</dt><dd class="font-mono text-gray-900"><%= KM(vehicle.highest_odo_km) %></dd></div>
        <div class="flex items-baseline justify-between"><dt class="text-gray-500">Service count</dt><dd class="font-medium text-gray-900"><%= vehicle.service_count || 0 %></dd></div>
        <div class="flex items-baseline justify-between pt-2 border-t border-gray-100"><dt class="font-semibold text-gray-800">Total spend</dt><dd class="font-bold text-brand-600"><%= AUD(vehicle.total_maint_cost) %></dd></div>
      </dl>
    </div>
  </div>
</section>

<!-- ============================================================
     TAB: SERVICE HISTORY  (inline add form + drag-drop invoice + table)
     ============================================================ -->
<section class="v-pane" data-v-pane="service" hidden>
  <!-- Inline Add Form with drag-drop invoice upload -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 mb-5">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-3">Add Service Record</h2>
    <form method="POST" action="/fleet/<%= vehicle.id %>/service" enctype="multipart/form-data" id="vehicleServiceForm">
      <%- include('../partials/csrf') %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Service Date</label>
          <input type="date" name="service_date" value="<%= today %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Type</label>
          <select name="service_type" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
            <% serviceTypes.forEach(function (t) { %><option value="<%= t %>"><%= t %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Odometer (km)</label>
          <input type="number" name="odometer_km" min="0" placeholder="e.g. 124800" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Cost (AUD)</label>
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
            <input type="number" name="cost" step="0.01" min="0" placeholder="0.00" class="w-full pl-7 pr-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Performed By</label>
          <input type="text" name="performed_by" placeholder="Workshop / mechanic" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Invoice #</label>
          <input type="text" name="invoice_number" placeholder="Optional reference" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
        </div>
        <div class="sm:col-span-2 lg:col-span-3">
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Work Performed</label>
          <textarea name="work_performed" rows="2" placeholder="Describe parts replaced, labour, follow-ups…" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm"></textarea>
        </div>
        <!-- Drag-drop invoice attachment -->
        <div class="sm:col-span-2 lg:col-span-3">
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Invoice attachment</label>
          <label class="invoice-drop" id="invoiceDrop">
            <input type="file" name="invoice_file" id="invoiceFile" accept=".pdf,image/*" class="invoice-drop-input">
            <div class="invoice-drop-body">
              <svg class="w-7 h-7 text-gray-400 mb-1" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5-5 5 5M12 5v12"/></svg>
              <p class="text-sm font-medium text-gray-700"><strong>Drag &amp; drop</strong> the workshop invoice — or click to choose a file</p>
              <p class="text-[11px] text-gray-500 mt-0.5">PDF or image · 15 MB max</p>
            </div>
            <div class="invoice-drop-chosen" hidden>
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="invoice-drop-name text-sm font-medium text-gray-800"></span>
              <button type="button" class="invoice-drop-clear text-xs text-red-600 hover:text-red-700 underline ml-2">Remove</button>
            </div>
          </label>
        </div>
      </div>
      <div class="flex items-center justify-end gap-2 mt-4 pt-4 border-t border-gray-100">
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg">Save Service Record</button>
      </div>
    </form>
  </div>

  <!-- Service history table -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Service History</h2>
    </div>
    <% if (services.length === 0) { %>
      <div class="p-6 text-center text-sm text-gray-500">No service records yet — add the first one above.</div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">
              <th class="px-3 py-2">Date</th>
              <th class="px-3 py-2 hidden sm:table-cell text-right">Odo</th>
              <th class="px-3 py-2">Type</th>
              <th class="px-3 py-2 hidden md:table-cell">Work Performed</th>
              <th class="px-3 py-2 hidden lg:table-cell">Performed By</th>
              <th class="px-3 py-2 text-right">Cost</th>
              <th class="px-3 py-2">Invoice</th>
              <th class="px-3 py-2 w-16"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% services.forEach(function (s) { %>
              <tr class="hover:bg-gray-50">
                <td class="px-3 py-2 text-gray-700 text-xs whitespace-nowrap"><%= s.service_date ? formatDate(s.service_date) : '—' %></td>
                <td class="px-3 py-2 hidden sm:table-cell text-right text-xs font-mono text-gray-600"><%= s.odometer_km ? Number(s.odometer_km).toLocaleString('en-AU') : '—' %></td>
                <td class="px-3 py-2 text-xs"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-blue-50 text-blue-700 ring-1 ring-blue-600/20"><%= s.service_type %></span></td>
                <td class="px-3 py-2 hidden md:table-cell text-xs text-gray-700 max-w-md">
                  <%= s.work_performed || '—' %>
                  <% if (s.notes) { %><div class="text-[11px] text-amber-700 mt-0.5"><%= s.notes %></div><% } %>
                </td>
                <td class="px-3 py-2 hidden lg:table-cell text-xs text-gray-600"><%= s.performed_by || '—' %></td>
                <td class="px-3 py-2 text-right text-xs font-mono <%= s.cost == null ? 'text-amber-600' : 'text-gray-800' %>"><%= s.cost == null ? '—' : AUD(s.cost) %></td>
                <td class="px-3 py-2 text-xs">
                  <% if (s.invoice_file_path) { %>
                    <a href="/fleet/<%= vehicle.id %>/service/<%= s.id %>/invoice" class="inline-flex items-center gap-1 text-brand-600 hover:text-brand-700 font-medium" title="<%= s.invoice_file_name || 'Invoice' %>">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                      File
                    </a>
                    <% if (s.invoice_number) { %><span class="text-gray-400 ml-1">#<%= s.invoice_number %></span><% } %>
                  <% } else if (s.invoice_number) { %>
                    <span class="text-gray-500 font-mono">#<%= s.invoice_number %></span>
                  <% } else { %>
                    <span class="text-gray-300">—</span>
                  <% } %>
                </td>
                <td class="px-3 py-2 text-right">
                  <a href="/fleet/<%= vehicle.id %>/service/<%= s.id %>/edit" class="text-brand-600 hover:text-brand-700 text-xs font-medium">Edit</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<!-- ============================================================
     TAB: INCIDENT REPORTS  (worker portal → /w/forms/incident?type=vehicle)
     ============================================================ -->
<section class="v-pane" data-v-pane="incidents" hidden>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Incident Reports</h2>
        <p class="text-[11px] text-gray-500 mt-0.5">Reports submitted from the worker portal that mention <strong><%= vehicle.rego || vehicle.asset_id %></strong>.</p>
      </div>
      <div class="flex items-center gap-2">
        <a href="/incidents" class="text-xs font-medium text-gray-600 hover:text-gray-900">All Incidents →</a>
      </div>
    </div>
    <% if (!incidents.length) { %>
      <div class="p-6 text-center text-sm text-gray-500">
        No incident reports linked to this vehicle yet.<br>
        <span class="text-[12px] text-gray-400">Crew submit these from the worker portal (Forms → On-site Incident / Vehicle Incident).</span>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">
              <th class="px-3 py-2">Date</th>
              <th class="px-3 py-2">#</th>
              <th class="px-3 py-2">Type</th>
              <th class="px-3 py-2">Severity</th>
              <th class="px-3 py-2">Title</th>
              <th class="px-3 py-2 hidden md:table-cell">Location</th>
              <th class="px-3 py-2">Status</th>
              <th class="px-3 py-2 w-16"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% incidents.forEach(function (i) { %>
              <tr class="hover:bg-gray-50">
                <td class="px-3 py-2 text-xs whitespace-nowrap text-gray-700"><%= i.incident_date ? formatDate(i.incident_date) : (i.created_at ? formatDate(i.created_at) : '—') %></td>
                <td class="px-3 py-2 text-xs font-mono text-gray-600"><%= i.incident_number %></td>
                <td class="px-3 py-2 text-xs text-gray-700"><%= (i.incident_type || '').replace(/_/g, ' ') %></td>
                <td class="px-3 py-2 text-xs"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold <%= SEVERITY_TONES[i.severity] || SEVERITY_TONES.low %>"><%= (i.severity || 'low').toUpperCase() %></span></td>
                <td class="px-3 py-2 text-xs text-gray-900 max-w-sm truncate" title="<%= i.title %>"><%= i.title %></td>
                <td class="px-3 py-2 text-xs text-gray-600 hidden md:table-cell"><%= i.location || '—' %></td>
                <td class="px-3 py-2 text-xs"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium <%= STATUS_TONES[i.investigation_status] || STATUS_TONES.reported %>"><%= (i.investigation_status || 'reported').replace(/_/g, ' ') %></span></td>
                <td class="px-3 py-2 text-right"><a href="/incidents/<%= i.id %>" class="text-brand-600 hover:text-brand-700 text-xs font-medium">View</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<!-- ============================================================
     TAB: EQUIPMENT COUNTS  (worker portal → /w/forms/equipment-count)
     ============================================================ -->
<section class="v-pane" data-v-pane="equipment" hidden>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between gap-3">
      <div>
        <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Vehicle Equipment Counts</h2>
        <p class="text-[11px] text-gray-500 mt-0.5">Equipment counts submitted from the worker portal referencing <strong><%= vehicle.rego || vehicle.asset_id %></strong>.</p>
      </div>
    </div>
    <% if (!equipmentChecks.length) { %>
      <div class="p-6 text-center text-sm text-gray-500">
        No equipment counts linked to this vehicle yet.<br>
        <span class="text-[12px] text-gray-400">Crew submit these from the worker portal (Forms → Site Vehicle Equipment Count).</span>
      </div>
    <% } else { %>
      <ul class="divide-y divide-gray-100">
        <% equipmentChecks.forEach(function (e) { var d = parseFormData(e.data); %>
          <li class="px-4 py-3 hover:bg-gray-50">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="text-sm font-semibold text-gray-900"><%= d.equipment_id ? d.equipment_id : (vehicle.rego || vehicle.asset_id) %><% if (d.equipment_type) { %> <span class="text-xs font-normal text-gray-500">· <%= d.equipment_type %></span><% } %></p>
              <p class="text-[11px] text-gray-500"><%= e.submitted_at ? formatDate(e.submitted_at) : (e.created_at ? formatDate(e.created_at) : '—') %><% if (e.submitted_by) { %> · by <strong><%= e.submitted_by %></strong><% } %></p>
            </div>
            <% var notable = Object.keys(d).filter(function (k) { return k !== 'equipment_id' && k !== 'equipment_type' && k !== '_csrf' && d[k] != null && d[k] !== ''; }); %>
            <% if (notable.length) { %>
              <div class="mt-1.5 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-1 text-[12px] text-gray-600">
                <% notable.slice(0, 12).forEach(function (k) { %>
                  <div><span class="text-gray-400"><%= k.replace(/_/g, ' ') %>:</span> <strong class="text-gray-800"><%= String(d[k]).slice(0, 80) %></strong></div>
                <% }) %>
              </div>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</section>

<style>
  .v-tab {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 14px;
    font-size: 13px; font-weight: 600; color: #6B7280;
    border-bottom: 2px solid transparent;
    background: transparent; border-radius: 6px 6px 0 0;
    cursor: pointer; transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
    white-space: nowrap;
  }
  .v-tab:hover { color: #1F2937; background: #F9FAFB; }
  .v-tab.is-active { color: #2B7FFF; border-bottom-color: #2B7FFF; }
  .v-tab svg { flex-shrink: 0; }
  .v-tab-count { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; padding: 0 5px; height: 16px; border-radius: 9999px; font-size: 10px; font-weight: 700; background: #E5E7EB; color: #374151; }
  .v-tab-count--red { background: #FEE2E2; color: #B91C1C; }
  :root[data-theme="dark"] .vehicle-tabs { border-bottom-color: rgba(255,255,255,0.08); }
  :root[data-theme="dark"] .v-tab { color: rgba(255,255,255,0.6); }
  :root[data-theme="dark"] .v-tab:hover { color: #fff; background: rgba(255,255,255,0.04); }
  :root[data-theme="dark"] .v-tab.is-active { color: #60A5FA; border-bottom-color: #60A5FA; }
  :root[data-theme="dark"] .v-tab-count { background: rgba(255,255,255,0.08); color: #E5E7EB; }
  :root[data-theme="dark"] .v-tab-count--red { background: rgba(248,113,113,0.18); color: #FCA5A5; }

  /* Drag-drop invoice box */
  .invoice-drop {
    display: block; position: relative;
    border: 2px dashed #CBD5E1; border-radius: 12px;
    padding: 18px; background: #F8FAFC;
    cursor: pointer; transition: border-color 120ms ease, background 120ms ease;
    text-align: center;
  }
  .invoice-drop:hover, .invoice-drop.is-drag { border-color: #2B7FFF; background: #EFF6FF; }
  .invoice-drop-input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .invoice-drop-body { pointer-events: none; }
  .invoice-drop-chosen { display: none; align-items: center; justify-content: center; gap: 8px; }
  .invoice-drop.is-chosen .invoice-drop-body { display: none; }
  .invoice-drop.is-chosen .invoice-drop-chosen { display: flex; }
  .invoice-drop-clear { pointer-events: auto; cursor: pointer; background: none; border: 0; padding: 0; }
</style>

<script>
(function () {
  // Tab switcher
  var tabs = Array.prototype.slice.call(document.querySelectorAll('#vehicleTabs .v-tab'));
  var panes = Array.prototype.slice.call(document.querySelectorAll('[data-v-pane]'));
  function show(name) {
    if (!name) name = 'overview';
    tabs.forEach(function (t) { t.classList.toggle('is-active', t.getAttribute('data-v-tab') === name); });
    panes.forEach(function (p) { p.hidden = (p.getAttribute('data-v-pane') !== name); });
    try {
      var url = new URL(window.location.href);
      if (name === 'overview') url.searchParams.delete('tab'); else url.searchParams.set('tab', name);
      history.replaceState(null, '', url.pathname + (url.search ? url.search : ''));
    } catch (e) {}
  }
  tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.getAttribute('data-v-tab')); }); });
  show('<%= initialTab %>');

  // Drag-drop invoice file
  var drop = document.getElementById('invoiceDrop');
  var input = document.getElementById('invoiceFile');
  if (drop && input) {
    var nameEl = drop.querySelector('.invoice-drop-name');
    var clearBtn = drop.querySelector('.invoice-drop-clear');
    function setFile(file) {
      if (!file) { drop.classList.remove('is-chosen'); input.value = ''; return; }
      if (nameEl) nameEl.textContent = file.name + ' (' + Math.round(file.size / 1024) + ' KB)';
      drop.classList.add('is-chosen');
    }
    input.addEventListener('change', function () { setFile(input.files && input.files[0]); });
    drop.addEventListener('dragover', function (e) { e.preventDefault(); drop.classList.add('is-drag'); });
    drop.addEventListener('dragleave', function () { drop.classList.remove('is-drag'); });
    drop.addEventListener('drop', function (e) {
      e.preventDefault();
      drop.classList.remove('is-drag');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
        // assign the dropped file into the input so it submits with the form
        try {
          var dt = new DataTransfer();
          dt.items.add(e.dataTransfer.files[0]);
          input.files = dt.files;
        } catch (err) { /* old browser — fall back to no-op */ }
        setFile(e.dataTransfer.files[0]);
      }
    });
    if (clearBtn) clearBtn.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); setFile(null); });
  }
})();
</script>
