<% locals.currentPage = 'fleet' %>
<%
  const AUD = n => (n == null || isNaN(Number(n))) ? '-' : '$' + Number(n).toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const KM = n => (n == null) ? '-' : Number(n).toLocaleString('en-AU') + ' km';
  const toneClass = t => ({
    ok:    'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20',
    warn:  'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20',
    bad:   'bg-red-50 text-red-700 ring-1 ring-red-600/20',
    muted: 'bg-gray-50 text-gray-400 ring-1 ring-gray-200',
  })[t] || 'bg-gray-50 text-gray-500';
%>

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Vehicles</h1>
    <p class="text-gray-500 text-sm mt-0.5">Register &middot; servicing &middot; compliance</p>
  </div>
  <div class="flex items-center gap-2 flex-wrap">
    <a href="/fleet/depots" class="inline-flex items-center justify-center px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors" title="Manage the depot list used by bookings">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21V8a2 2 0 012-2h2l2-3h6l2 3h2a2 2 0 012 2v13M3 21h18M9 21V11h6v10"/></svg>
      Depots
    </a>
    <a href="/fleet/compliance" class="inline-flex items-center justify-center px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Compliance Alerts
    </a>
    <a href="/fleet/reconcile" class="inline-flex items-center justify-center px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors" title="Link historical Equipment-vehicle rows to their Fleet counterparts">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
      Reconcile
    </a>
    <a href="/fleet/new" class="inline-flex items-center justify-center px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
      Add Vehicle
    </a>
  </div>
</div>

<!-- KPI cards -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total Vehicles</p>
    <p class="text-xl font-bold text-gray-900 mt-0.5"><%= counts.total %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Active</p>
    <p class="text-xl font-bold text-emerald-600 mt-0.5"><%= counts.active %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-amber-500 uppercase tracking-widest">To Verify</p>
    <p class="text-xl font-bold <%= counts.verify > 0 ? 'text-amber-600' : 'text-gray-300' %> mt-0.5"><%= counts.verify %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-brand-500 uppercase tracking-widest">Total Maint. Spend</p>
    <p class="text-xl font-bold text-brand-600 mt-0.5"><%= AUD(totalSpend) %></p>
  </div>
</div>

<!-- Compliance snapshot -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
  <% const tile = (label, count) => { %>
    <a href="/fleet/compliance" class="block bg-white border border-gray-200 rounded-xl shadow-sm p-3 hover:bg-gray-50 transition">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest"><%= label %></p>
      <p class="text-xl font-bold <%= count > 0 ? 'text-red-600' : 'text-emerald-600' %> mt-0.5"><%= count %></p>
      <p class="text-[10px] text-gray-400 mt-0.5">overdue or &lt;30 days</p>
    </a>
  <% } %>
  <%- tile('Registration', compliance.registration) %>
  <%- tile('Servicing',    compliance.service) %>
  <%- tile('Inspection',   compliance.inspection) %>
  <%- tile('Fire Ext.',    compliance.fireExt) %>
</div>

<!-- Filter Bar -->
<div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3 mb-5">
  <form method="GET" action="/fleet" class="flex flex-col sm:flex-row sm:flex-wrap sm:items-end gap-2 sm:gap-3">
    <div class="flex-1 min-w-0 sm:min-w-[180px]">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">Search</label>
      <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Asset ID, rego, make/model..."
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
    </div>
    <div class="flex gap-2 w-full sm:w-auto">
      <div class="flex-1 sm:flex-none sm:min-w-[130px]">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">Status</label>
        <select name="status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">All</option>
          <% vehicleStatuses.forEach(s => { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="flex-1 sm:flex-none sm:min-w-[140px]">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">Type</label>
        <select name="vehicle_type" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">All</option>
          <% vehicleTypes.forEach(t => { %>
            <option value="<%= t %>" <%= filters.vehicle_type === t ? 'selected' : '' %>><%= t %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="flex gap-2">
      <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg">Apply</button>
      <a href="/fleet" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium rounded-lg">Clear</a>
    </div>
  </form>
</div>

<!-- Vehicles Table -->
<% if (vehicles.length === 0) { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 text-center">
    <h3 class="text-gray-900 font-semibold text-base mb-1">No vehicles match these filters</h3>
    <p class="text-gray-500 text-sm">Try clearing filters or <a href="/fleet/new" class="text-brand-600 hover:underline">add a vehicle</a>.</p>
  </div>
<% } else { %>
<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-x-auto">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-gray-200 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">
        <th class="px-3 py-2.5">Asset</th>
        <th class="px-3 py-2.5 hidden sm:table-cell">Rego</th>
        <th class="px-3 py-2.5 hidden md:table-cell">Make / Model</th>
        <th class="px-3 py-2.5 hidden lg:table-cell">Assigned</th>
        <th class="px-3 py-2.5">Status</th>
        <th class="px-3 py-2.5">Class</th>
        <th class="px-3 py-2.5 hidden md:table-cell text-right">Odo</th>
        <th class="px-3 py-2.5 hidden lg:table-cell">Last Service</th>
        <th class="px-3 py-2.5 text-right">Spend</th>
        <th class="px-3 py-2.5">Compliance</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% vehicles.forEach(v => { const b = badgesFor(v, today); const isVerify = v.status === 'Verify'; %>
      <tr class="hover:bg-gray-50 <%= isVerify ? 'border-l-4 border-l-amber-400 bg-amber-50/30' : '' %> <%= v.status === 'Retired' ? 'opacity-60' : '' %>" onclick="window.location='/fleet/<%= v.id %>'" style="cursor:pointer">
        <td class="px-3 py-2.5">
          <a href="/fleet/<%= v.id %>" class="text-brand-600 hover:text-brand-700 font-semibold text-sm hover:underline"><%= v.asset_id %></a>
          <% if (v.fleet_id && v.fleet_id !== v.asset_id) { %><p class="text-gray-400 text-[10px] mt-0.5">Fleet ID: <%= v.fleet_id %></p><% } %>
          <p class="text-gray-400 text-xs sm:hidden"><%= v.rego || '-' %></p>
        </td>
        <td class="px-3 py-2.5 hidden sm:table-cell text-gray-700 font-mono text-xs"><%= v.rego || '-' %></td>
        <td class="px-3 py-2.5 hidden md:table-cell text-gray-600 text-xs">
          <%= [v.make, v.model].filter(Boolean).join(' ') || '-' %>
          <% if (v.year) { %><span class="text-gray-400"> · <%= v.year %></span><% } %>
        </td>
        <td class="px-3 py-2.5 hidden lg:table-cell text-gray-600 text-xs"><%= v.assigned_to || '-' %></td>
        <td class="px-3 py-2.5">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold
            <% if (v.status === 'Active') { %>bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20
            <% } else if (v.status === 'Verify') { %>bg-amber-50 text-amber-800 ring-1 ring-amber-600/20
            <% } else if (v.status === 'Retired') { %>bg-gray-100 text-gray-500
            <% } else { %>bg-blue-50 text-blue-700 ring-1 ring-blue-600/20<% } %>">
            <%= v.status %>
          </span>
        </td>
        <td class="px-3 py-2.5" onclick="event.stopPropagation()">
          <select data-class-vehicle="<%= v.id %>"
            onchange="setVehicleClass(this)"
            class="px-2 py-1 bg-white border border-gray-300 rounded-md text-gray-800 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
            <% (typeof trafficClasses !== 'undefined' ? trafficClasses : []).forEach(c => { %>
              <option value="<%= c.value %>" <%= (v.traffic_class || 'ute') === c.value ? 'selected' : '' %>><%= c.label %></option>
            <% }) %>
          </select>
        </td>
        <td class="px-3 py-2.5 hidden md:table-cell text-right text-xs text-gray-600 font-mono"><%= KM(v.highest_odo_km) %></td>
        <td class="px-3 py-2.5 hidden lg:table-cell text-xs text-gray-600"><%= v.last_service_date ? formatDate(v.last_service_date) : '-' %></td>
        <td class="px-3 py-2.5 text-right text-xs font-semibold text-gray-800"><%= AUD(v.total_maint_cost) %></td>
        <td class="px-3 py-2.5" onclick="event.stopPropagation()">
          <div class="flex flex-wrap gap-1">
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold <%= toneClass(b.registration.tone) %>" title="Registration: <%= b.registration.label %>">REG</span>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold <%= toneClass(b.service.tone) %>" title="Next service: <%= b.service.label %>">SVC</span>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold <%= toneClass(b.inspection.tone) %>" title="Inspection: <%= b.inspection.label %>">INS</span>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold <%= toneClass(b.fireExt.tone) %>" title="Fire ext.: <%= b.fireExt.label %>">FE</span>
          </div>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<div class="mt-2 text-xs text-gray-400"><%= vehicles.length %> vehicle<%= vehicles.length !== 1 ? 's' : '' %> · total fleet spend <%= AUD(totalSpend) %></div>
<% } %>

<!-- Spend by service type (small table) -->
<% if (spendByType && spendByType.length) { %>
<div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-5">
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Spend by Service Type</h2>
    </div>
    <table class="w-full text-sm">
      <tbody class="divide-y divide-gray-100">
        <% spendByType.forEach(row => { %>
          <tr>
            <td class="px-4 py-2 text-gray-700"><%= row.service_type %></td>
            <td class="px-4 py-2 text-right font-mono text-gray-800"><%= AUD(row.total) %></td>
          </tr>
        <% }) %>
        <tr class="bg-gray-50 font-semibold">
          <td class="px-4 py-2 text-gray-800">TOTAL</td>
          <td class="px-4 py-2 text-right font-mono text-gray-900"><%= AUD(totalSpend) %></td>
        </tr>
      </tbody>
    </table>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-4 py-3 border-b border-gray-200">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Spend by Vehicle</h2>
    </div>
    <table class="w-full text-sm">
      <tbody class="divide-y divide-gray-100">
        <% vehicles.slice().sort((a,b) => (b.total_maint_cost||0) - (a.total_maint_cost||0)).forEach(v => { %>
          <tr>
            <td class="px-4 py-2">
              <a href="/fleet/<%= v.id %>" class="text-brand-600 hover:underline font-medium"><%= v.asset_id %></a>
              <span class="text-gray-400 text-xs"><%= v.rego ? ' · ' + v.rego : '' %></span>
            </td>
            <td class="px-4 py-2 text-right font-mono text-gray-800"><%= AUD(v.total_maint_cost) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<script>
  // Inline "Class" auto-save on the vehicle list. POSTs the picked class to
  // /fleet/:id/traffic-class (JSON) so the whole fleet can be classified from
  // this one screen without opening each vehicle.
  function setVehicleClass(sel) {
    var id = sel.getAttribute('data-class-vehicle');
    var prev = sel.getAttribute('data-prev') || sel.value;
    var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
    sel.disabled = true;
    var body = new URLSearchParams(); body.append('traffic_class', sel.value); if (csrf) body.append('_csrf', csrf);
    fetch('/fleet/' + encodeURIComponent(id) + '/traffic-class', {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf },
      body: body, credentials: 'same-origin',
    }).then(function (r) { return r.json().catch(function () { return {}; }); })
      .then(function (j) {
        if (!j || j.ok !== true) { alert((j && j.error) || 'Could not save class.'); sel.value = prev; }
        else { sel.setAttribute('data-prev', sel.value); sel.classList.add('ring-2','ring-emerald-400'); setTimeout(function () { sel.classList.remove('ring-2','ring-emerald-400'); }, 700); }
      }).catch(function () { alert('Could not save class — network error.'); sel.value = prev; })
      .finally(function () { sel.disabled = false; });
  }
  document.querySelectorAll('select[data-class-vehicle]').forEach(function (s) { s.setAttribute('data-prev', s.value); });
</script>
