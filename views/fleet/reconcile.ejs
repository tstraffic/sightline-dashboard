<% locals.currentPage = 'fleet' %>

<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/fleet" class="hover:text-gray-900 transition">Fleet Register</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900">Reconcile</span>
</div>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Reconcile Equipment ↔ Fleet</h1>
    <p class="text-gray-500 text-sm mt-0.5">Walk through equipment rows that look like vehicles and point each at its Fleet counterpart. Linked rows are deactivated so they disappear from booking pickers.</p>
  </div>
  <div class="flex items-center gap-2">
    <% if (showResolved) { %>
      <a href="/fleet/reconcile" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg">Pending only</a>
    <% } else { %>
      <a href="/fleet/reconcile?show=all" class="px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg">Show all (incl. resolved)</a>
    <% } %>
    <a href="/fleet" class="px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg">← Back to Fleet</a>
  </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-3 gap-3 mb-5">
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Vehicle-shaped Equipment</p>
    <p class="text-xl font-bold text-gray-900 mt-0.5"><%= stats.total || 0 %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Linked</p>
    <p class="text-xl font-bold text-emerald-600 mt-0.5"><%= stats.linked || 0 %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-amber-500 uppercase tracking-widest">Pending</p>
    <p class="text-xl font-bold <%= (stats.pending || 0) > 0 ? 'text-amber-600' : 'text-gray-300' %> mt-0.5"><%= stats.pending || 0 %></p>
  </div>
</div>

<% if (items.length === 0) { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8 text-center">
    <div class="w-12 h-12 mx-auto mb-3 bg-emerald-50 rounded-full flex items-center justify-center">
      <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>
    <h2 class="text-lg font-semibold text-gray-900"><%= showResolved ? 'No vehicle-shaped equipment rows yet' : 'All caught up' %></h2>
    <p class="text-sm text-gray-500 mt-1">
      <% if (showResolved) { %>
        Once equipment rows that look like vehicles are added, they'll show up here for reconciliation.
      <% } else { %>
        Every equipment row that looks like a vehicle has been reconciled.
        <a href="/fleet/reconcile?show=all" class="text-brand-600 hover:underline">Show resolved</a> if you want to review past decisions.
      <% } %>
    </p>
  </div>
<% } else { %>
  <div class="space-y-3">
    <% items.forEach(eq => { %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 <%= eq.fleet_vehicle_id ? 'opacity-70' : '' %>">
        <div class="flex flex-col lg:flex-row lg:items-center gap-4">
          <!-- Equipment side -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <a href="/equipment/<%= eq.id %>" class="font-semibold text-gray-900 hover:text-brand-600 hover:underline">
                <%= eq.asset_number || '(no asset #)' %>
              </a>
              <span class="text-sm text-gray-600 truncate"><%= eq.name %></span>
              <% if (eq.category) { %><span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-gray-100 text-gray-600 uppercase tracking-widest"><%= eq.category %></span><% } %>
              <% if (eq.licence_plate) { %><span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-blue-50 text-blue-800 ring-1 ring-blue-600/20"><%= eq.licence_plate %></span><% } %>
              <% if (!eq.active) { %><span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-gray-100 text-gray-500">INACTIVE</span><% } %>
            </div>
            <% if (eq.fleet_vehicle_id) { %>
              <p class="text-xs text-gray-600 mt-1.5 flex items-center gap-2">
                <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Linked to
                <a href="/fleet/<%= eq.fleet_vehicle_id %>" class="text-brand-600 hover:underline font-semibold">Fleet · <%= eq.fleet_asset_id %></a>
                <% if (eq.fleet_rego) { %><span class="text-gray-400 font-mono">(<%= eq.fleet_rego %>)</span><% } %>
              </p>
            <% } %>
          </div>

          <!-- Action side -->
          <div class="flex-shrink-0 w-full lg:w-auto">
            <% if (eq.fleet_vehicle_id) { %>
              <form method="POST" action="/fleet/reconcile/<%= eq.id %>/unlink" onsubmit="return confirm('Unlink this equipment row and reactivate it?')" class="inline">
                <%- include('../partials/csrf') %>
                <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg">Unlink</button>
              </form>
            <% } else { %>
              <form method="POST" action="/fleet/reconcile/<%= eq.id %>/link" class="flex items-center gap-2 flex-wrap">
                <%- include('../partials/csrf') %>
                <select name="fleet_vehicle_id" required
                  class="px-3 py-1.5 bg-white border <%= eq.suggestion ? 'border-amber-300 ring-1 ring-amber-200' : 'border-gray-300' %> rounded-lg text-gray-900 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500 min-w-[220px]">
                  <option value="">— pick Fleet vehicle —</option>
                  <% fleet.forEach(fv => { %>
                    <option value="<%= fv.id %>" <%= eq.suggestion && eq.suggestion.id === fv.id ? 'selected' : '' %>>
                      <%= fv.asset_id %><% if (fv.rego) { %> · <%= fv.rego %><% } %> · <%= fv.label %><% if (fv.status !== 'Active') { %> · <%= fv.status %><% } %>
                    </option>
                  <% }) %>
                </select>
                <% if (eq.suggestion) { %>
                  <span class="text-[10px] font-bold uppercase tracking-widest <%= eq.confidence === 'exact' ? 'text-emerald-700' : 'text-amber-700' %>" title="<%= eq.confidence === 'exact' ? 'Rego matches exactly' : 'Asset number matches' %>">
                    Match: <%= eq.confidence === 'exact' ? 'rego' : 'asset' %>
                  </span>
                <% } %>
                <button type="submit" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded-lg">
                  Link &amp; deactivate
                </button>
              </form>
              <form method="POST" action="/fleet/reconcile/<%= eq.id %>/standalone" class="inline mt-1 block">
                <%- include('../partials/csrf') %>
                <button type="submit" class="text-[11px] text-gray-500 hover:text-gray-800 hover:underline">Not in Fleet → keep as standalone equipment</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
