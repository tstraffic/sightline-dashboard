<% locals.currentPage = 'fleet' %>
<% const isEdit = record !== null && typeof record !== 'undefined' %>
<% const val = k => isEdit && record[k] != null ? record[k] : '' %>

<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/fleet" class="hover:text-gray-900 transition">Fleet</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <a href="/fleet/<%= vehicle.id %>" class="hover:text-gray-900"><%= vehicle.asset_id %></a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900"><%= isEdit ? 'Edit Service Record' : 'New Service Record' %></span>
</div>

<h1 class="text-2xl font-bold text-gray-900 mb-1"><%= isEdit ? 'Edit Service Record' : 'New Service Record' %></h1>
<p class="text-gray-500 text-sm mb-5">For <span class="font-semibold text-gray-700"><%= vehicle.asset_id %></span> <% if (vehicle.rego) { %>· <%= vehicle.rego %><% } %></p>

<form method="POST" action="<%= isEdit ? `/fleet/${vehicle.id}/service/${record.id}` : `/fleet/${vehicle.id}/service` %>" class="space-y-5">
  <%- include('../partials/csrf') %>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Date of Service</label>
        <input type="date" name="service_date" value="<%= val('service_date') %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <p class="text-[10px] text-gray-400 mt-1">Leave blank if unknown</p>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Odometer (km)</label>
        <input type="number" name="odometer_km" min="0" value="<%= val('odometer_km') %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Service Type <span class="text-red-500">*</span></label>
        <select name="service_type" required class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <% serviceTypes.forEach(t => { %><option value="<%= t %>" <%= val('service_type') === t ? 'selected' : '' %>><%= t %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Performed By</label>
        <input type="text" name="performed_by" value="<%= val('performed_by') %>" placeholder="Mechanic / supplier" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Cost (AUD)</label>
        <input type="number" step="0.01" min="0" name="cost" value="<%= val('cost') %>" placeholder="0.00" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Invoice / Receipt #</label>
        <input type="text" name="invoice_number" value="<%= val('invoice_number') %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
    </div>
    <div class="mt-4">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Work Performed</label>
      <textarea name="work_performed" rows="3" placeholder="Describe the work — parts replaced, services completed..."
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-y"><%= val('work_performed') %></textarea>
    </div>
    <div class="mt-4">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Notes</label>
      <textarea name="notes" rows="2" placeholder="Data-quality flags, back-charges, follow-ups..."
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-y"><%= val('notes') %></textarea>
    </div>
  </div>

  <div class="flex items-center justify-between">
    <% if (isEdit) { %>
      <form method="POST" action="/fleet/<%= vehicle.id %>/service/<%= record.id %>/delete" onsubmit="return confirm('Delete this service record? This cannot be undone.')">
        <%- include('../partials/csrf') %>
        <button type="submit" class="px-3 py-2 bg-red-50 hover:bg-red-100 text-red-600 text-sm font-medium rounded-lg border border-red-200">Delete</button>
      </form>
    <% } else { %><div></div><% } %>
    <div class="flex items-center gap-2">
      <a href="/fleet/<%= vehicle.id %>" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium rounded-lg">Cancel</a>
      <button type="submit" class="px-5 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg"><%= isEdit ? 'Save Changes' : 'Add Record' %></button>
    </div>
  </div>
</form>
