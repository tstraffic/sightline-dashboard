<% locals.currentPage = 'fleet' %>
<% const isEdit = record !== null && typeof record !== 'undefined' %>
<% const val = k => isEdit && record[k] != null ? record[k] : '' %>
<style>
  /* Keep the file picker text legible in night mode. */
  :root[data-theme="dark"] .sf-file { color: rgba(255,255,255,0.75); }
</style>

<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/fleet" class="hover:text-gray-900 transition">Fleet</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <a href="/fleet/<%= vehicle.id %>" class="hover:text-gray-900"><%= vehicle.asset_id %></a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900"><%= isEdit ? 'Edit Service Record' : 'New Service Record' %></span>
</div>

<h1 class="text-2xl font-bold text-gray-900 mb-1"><%= isEdit ? 'Edit Service Record' : 'New Service Record' %></h1>
<p class="text-gray-500 text-sm mb-5">For <span class="font-semibold text-gray-700"><%= vehicle.asset_id %></span> <% if (vehicle.rego) { %>· <%= vehicle.rego %><% } %></p>

<form id="svcForm" method="POST" action="<%= isEdit ? `/fleet/${vehicle.id}/service/${record.id}` : `/fleet/${vehicle.id}/service` %>" enctype="multipart/form-data" class="space-y-5">
  <%- include('../partials/csrf') %>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Date of Service</label>
        <input type="date" name="service_date" value="<%= val('service_date') %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <p class="text-[10px] text-gray-400 mt-1">Leave blank if unknown</p>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Odometer (km)</label>
        <input type="number" name="odometer_km" min="0" value="<%= val('odometer_km') %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Service Type <span class="text-red-500">*</span></label>
        <select name="service_type" required class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <% serviceTypes.forEach(t => { %><option value="<%= t %>" <%= val('service_type') === t ? 'selected' : '' %>><%= t %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Performed By</label>
        <input type="text" name="performed_by" value="<%= val('performed_by') %>" placeholder="Mechanic / supplier" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Cost (AUD)</label>
        <input type="number" step="0.01" min="0" name="cost" value="<%= val('cost') %>" placeholder="0.00" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Invoice / Receipt #</label>
        <input type="text" name="invoice_number" value="<%= val('invoice_number') %>" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
    </div>
    <div class="mt-4">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Work Performed</label>
      <textarea name="work_performed" rows="3" placeholder="Describe the work — parts replaced, services completed..."
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-y"><%= val('work_performed') %></textarea>
    </div>
    <div class="mt-4">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Notes</label>
      <textarea name="notes" rows="2" placeholder="Data-quality flags, back-charges, follow-ups..."
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-y"><%= val('notes') %></textarea>
    </div>
    <div class="mt-4">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Invoice files (PDF / image, 15 MB each)</label>
      <% var invs = (isEdit && record.invoices) ? record.invoices : []; %>
      <% if (invs.length) { %>
        <div class="space-y-2 mb-2">
          <% invs.forEach(function (inv) { %>
            <div class="flex items-center justify-between gap-3 px-3 py-2 bg-emerald-50 border border-emerald-200 rounded-lg">
              <a href="/fleet/<%= vehicle.id %>/service/<%= record.id %>/invoice/<%= inv.id %>" class="inline-flex items-center gap-2 text-emerald-700 hover:text-emerald-800 text-sm font-medium min-w-0">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span class="truncate"><%= inv.file_name || 'Download invoice' %></span>
              </a>
              <!-- Targets a standalone form below (NOT nested — nesting forms
                   would close #svcForm early and break Save Changes). -->
              <button type="submit" form="rmInv-<%= inv.id %>" class="text-xs text-red-600 hover:text-red-700 underline shrink-0">Remove</button>
            </div>
          <% }) %>
        </div>
        <p class="text-[10px] text-gray-400 mb-1">Existing files are kept. Add more below.</p>
      <% } %>
      <% if (isEdit) { %>
        <!-- The picker + Add button belong to a separate form (#invForm,
             below) so files attach immediately — no need to Save the record.
             form= associates them even though they sit inside #svcForm. -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
          <input type="file" name="invoice_file" form="invForm" accept=".pdf,image/*" multiple class="sf-file block w-full text-sm text-gray-700 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
          <button type="submit" form="invForm" class="shrink-0 inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Add file<span class="hidden sm:inline">(s)</span>
          </button>
        </div>
        <p class="text-[10px] text-gray-400 mt-1">Pick file(s) and press <b>Add</b> — they attach straight away.</p>
      <% } else { %>
        <input type="file" name="invoice_file" accept=".pdf,image/*" multiple class="sf-file block w-full text-sm text-gray-700 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
        <p class="text-[10px] text-gray-400 mt-1">Attached when you save the record.</p>
      <% } %>
    </div>
  </div>

  <!-- Action row sits a little in from the right + has clearance below so it
       never hides under the floating "+ New" / Feedback buttons in the corner. -->
  <div class="flex items-center justify-between gap-3 sm:pr-28 pb-24">
    <% if (isEdit) { %>
      <button type="submit" form="delSvc" class="px-3 py-2 bg-red-50 hover:bg-red-100 text-red-600 text-sm font-medium rounded-lg border border-red-200">Delete</button>
    <% } else { %><div></div><% } %>
    <div class="flex items-center gap-2">
      <a href="/fleet/<%= vehicle.id %>" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium rounded-lg">Cancel</a>
      <button type="submit" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-bold rounded-lg shadow-sm"><%= isEdit ? 'Save changes' : 'Add Record' %></button>
    </div>
  </div>
</form>

<!-- Standalone destructive-action forms — kept OUTSIDE #svcForm so they don't
     nest (nested forms close the outer form early and orphaned the Save button).
     The Delete / Remove buttons above target these via the form= attribute. -->
<% if (isEdit) { %>
  <!-- Add-invoice form: the picker + Add button above submit to this via form=. -->
  <form id="invForm" method="POST" action="/fleet/<%= vehicle.id %>/service/<%= record.id %>/invoices/add" enctype="multipart/form-data" class="hidden">
    <%- include('../partials/csrf') %>
  </form>
  <form id="delSvc" method="POST" action="/fleet/<%= vehicle.id %>/service/<%= record.id %>/delete" onsubmit="return confirm('Delete this service record? This cannot be undone.')" class="hidden">
    <%- include('../partials/csrf') %>
  </form>
  <% invs.forEach(function (inv) { %>
    <form id="rmInv-<%= inv.id %>" method="POST" action="/fleet/<%= vehicle.id %>/service/<%= record.id %>/invoice/<%= inv.id %>/delete" onsubmit="return confirm('Remove this invoice file?')" class="hidden">
      <%- include('../partials/csrf') %>
    </form>
  <% }) %>
<% } %>
