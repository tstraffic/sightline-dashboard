<% locals.currentPage = 'hr_employees' %>

<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/hr/roster" class="hover:text-gray-900 transition">Roster</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900">Duplicates</span>
</div>

<div class="mb-5">
  <h1 class="text-2xl font-bold text-gray-900">Duplicate roster records</h1>
  <p class="text-gray-500 text-sm mt-0.5">People on the roster more than once (same phone, email, or name) — e.g. added from recruitment <em>and</em> the induction form. Keep one; the rest move to <strong>Deleted</strong> (restorable).</p>
</div>

<% if (!dupes.length) { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-12 text-center">
    <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-3">
      <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
    </div>
    <p class="text-sm font-semibold text-gray-700">No duplicates found</p>
    <p class="text-xs text-gray-500 mt-1">Everyone on the roster has a unique phone, email and name.</p>
  </div>
<% } else { %>
  <form method="POST" action="/hr/roster/duplicates/resolve" class="space-y-4">
    <%- include('../partials/csrf') %>
    <% dupes.forEach(function (g, i) { %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-4 py-2.5 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
          <span class="text-sm font-semibold text-gray-800"><%= g.members[0].full_name %></span>
          <span class="text-[11px] text-gray-500 uppercase tracking-widest">Matched by <%= g.reason %></span>
        </div>
        <% if (g.nameVaries) { %>
          <div class="px-4 py-2 bg-amber-50 border-b border-amber-200 text-[11px] text-amber-800 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
            Different names here — they only share a phone or email (e.g. a shared number). Confirm it's really one person before removing.
          </div>
        <% } %>
        <input type="hidden" name="members_<%= i %>" value="<%= g.members.map(m => m.id).join(',') %>">
        <div class="divide-y divide-gray-100">
          <% g.members.forEach(function (m) { %>
            <label class="flex items-center gap-3 px-4 py-3 cursor-pointer hover:bg-gray-50">
              <input type="radio" name="keep_<%= i %>" value="<%= m.id %>" <%= m.id === g.suggestedKeepId ? 'checked' : '' %> class="text-brand-600 focus:ring-brand-500">
              <div class="flex-1 min-w-0 grid grid-cols-2 sm:grid-cols-6 gap-x-4 gap-y-1 items-center">
                <div class="sm:col-span-2">
                  <p class="text-sm font-semibold text-gray-900 truncate"><%= m.full_name %></p>
                  <p class="text-[11px] text-gray-400 tabular-nums"><%= m.employee_code %></p>
                </div>
                <div class="text-xs text-gray-600 tabular-nums"><%= m.phone || '—' %></div>
                <div class="text-xs text-gray-600 truncate"><%= m.email || '—' %></div>
                <div class="text-xs">
                  <span class="inline-flex px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-[10px] font-semibold uppercase"><%= (m.employment_status || 'active') %></span>
                  <% if (m.payment_type) { %><span class="inline-flex px-1.5 py-0.5 rounded bg-gray-50 text-gray-500 text-[10px] font-semibold uppercase ml-1"><%= m.payment_type %></span><% } %>
                </div>
                <div class="text-[11px] text-gray-500">
                  <%= m.allocations %> alloc<%= m.allocations === 1 ? '' : 's' %><% if (m.has_pin) { %> · <span class="text-emerald-600 font-semibold">PIN</span><% } %><% if (m.inducted) { %> · <span class="text-blue-600">inducted</span><% } %>
                </div>
              </div>
            </label>
          <% }) %>
        </div>
        <div class="px-4 py-2 bg-gray-50/60 border-t border-gray-100 text-[11px] text-gray-500">
          The selected record is kept; the other<%= g.members.length > 2 ? 's' : '' %> move to Deleted. Suggested keep = most established (PIN / allocations / inducted).
        </div>
      </div>
    <% }) %>

    <div class="flex items-center justify-between gap-2 sticky bottom-0 bg-gray-50/80 backdrop-blur py-3 -mx-1 px-1 rounded-lg">
      <p class="text-xs text-gray-500"><%= dupes.length %> duplicate group<%= dupes.length === 1 ? '' : 's' %> found.</p>
      <button type="submit" onclick="return confirm('Move the non-selected duplicate records to Deleted?')" class="px-5 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Keep selected, remove the rest</button>
    </div>
  </form>
<% } %>
