<% locals.currentPage = 'hr-employees' %>
<%
  const isEdit = employee !== null && typeof employee !== 'undefined';

  const defaultEmploymentTypes = [
    { val: 'full_time', label: 'Full Time' },
    { val: 'part_time', label: 'Part Time' },
    { val: 'casual', label: 'Casual' },
    { val: 'contractor', label: 'Contractor' },
    { val: 'subcontractor', label: 'Subcontractor' },
  ];

  const employmentTypes = (settingsOptions && settingsOptions.hr_employment_types) || defaultEmploymentTypes;

  const defaultStatuses = [
    { val: 'active', label: 'Active' },
    { val: 'onboarding', label: 'Onboarding' },
    { val: 'on_leave', label: 'On Leave' },
    { val: 'suspended', label: 'Suspended' },
    { val: 'inactive', label: 'Inactive' },
    { val: 'offboarded', label: 'Offboarded' },
  ];

  function val(field) {
    if (!isEdit || !employee[field]) return '';
    return employee[field];
  }

  function checked(field) {
    if (!isEdit) return '';
    return employee[field] ? 'checked' : '';
  }

  function selected(field, value) {
    if (!isEdit) return '';
    return employee[field] === value ? 'selected' : '';
  }

  // The seven sections of the employee record. One list drives the rail, the
  // panes and the create-mode Back/Next, so a section can never again appear
  // in the nav without a matching panel — the old wizard had a step 5 with no
  // panel, which quietly rendered the Notes box under a "Payroll" heading.
  const sections = [
    { id: 'personal',    label: 'Personal' },
    { id: 'employment',  label: 'Employment' },
    { id: 'operational', label: 'Operational' },
    { id: 'licences',    label: 'Licences & Cards' },
    { id: 'emergency',   label: 'Emergency' },
    { id: 'payroll',     label: 'Payroll & Pay' },
    { id: 'notes',       label: 'Notes & Links' },
  ];
  const totalSteps = sections.length;
  // ?section= wins (the save redirect sets it), otherwise start at the top.
  const activeSection = (typeof initialSection !== 'undefined' && sections.some(s => s.id === initialSection))
    ? initialSection
    : sections[0].id;
%>

<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/hr" class="hover:text-gray-900 transition">HR</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <a href="/hr/employees" class="hover:text-gray-900 transition">Employees</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900"><%= isEdit ? employee.first_name + ' ' + employee.last_name : 'New Employee' %></span>
</div>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= isEdit ? 'Edit' : 'Add' %> Employee</h1>
    <p class="text-sm text-gray-500 mt-0.5"><%= isEdit ? 'Update employee details and employment information' : 'Complete the steps below to add a new employee' %></p>
  </div>
</div>

<form method="POST" action="<%= isEdit ? '/hr/employees/' + employee.id : '/hr/employees' %>" id="employee-wizard-form">
  <%- include('../partials/csrf') %>

  <%/* Carries the section you were on through the save so the redirect can
       drop you back here, rather than ejecting you to the read-only profile. */%>
  <input type="hidden" name="section" id="emp-section-field" value="<%= activeSection %>">

  <!-- Section rail. data-emp-sec / data-emp-pane are namespaced on purpose:
       public/js/app.js binds [data-tab] document-wide, preventDefaults the
       click and rewrites the hash, so a data-tab rail here would fight it. -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-2 mb-5">
    <nav class="flex items-center gap-1 overflow-x-auto" id="emp-section-rail" aria-label="Employee sections">
      <% sections.forEach(function (s, i) { %>
        <button type="button" data-emp-sec="<%= s.id %>"
          class="emp-sec-btn flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-all whitespace-nowrap <%= s.id === activeSection ? 'bg-brand-600 text-white shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50' %>">
          <span class="emp-sec-num flex items-center justify-center w-5 h-5 rounded-full text-[10px] font-bold shrink-0 <%= s.id === activeSection ? 'bg-white/20 text-white' : 'bg-gray-100 text-gray-500' %>"><%= i + 1 %></span>
          <span><%= s.label %></span>
        </button>
      <% }) %>
    </nav>
    <% if (!isEdit) { %>
    <div class="mt-2 px-1 flex items-center gap-2">
      <div class="flex-1 bg-gray-100 rounded-full h-1.5 overflow-hidden">
        <div id="emp-progress-bar" class="h-full bg-brand-500 rounded-full transition-all duration-300" style="width: <%= (1 / totalSteps * 100).toFixed(1) %>%"></div>
      </div>
      <span id="emp-progress-text" class="text-[10px] text-gray-400 font-medium shrink-0">Step 1 of <%= totalSteps %></span>
    </div>
    <% } %>
  </div>

  <!-- Personal -->
  <div class="emp-pane" data-emp-pane="personal">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Personal Details <span class="text-red-500">*Required</span></h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">First Name <span class="text-red-500">*</span></label>
          <input type="text" name="first_name" value="<%= val('first_name') %>" required
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <p class="text-[10px] text-gray-400 mt-0.5">Legal first name as per ID documents</p>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Middle Name</label>
          <input type="text" name="middle_name" value="<%= val('middle_name') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Last Name <span class="text-red-500">*</span></label>
          <input type="text" name="last_name" value="<%= val('last_name') %>" required
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <p class="text-[10px] text-gray-400 mt-0.5">Legal surname as per ID documents</p>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Preferred Name</label>
          <input type="text" name="preferred_name" value="<%= val('preferred_name') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <p class="text-[10px] text-gray-400 mt-0.5">Name they go by day-to-day (if different)</p>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Phone</label>
          <input type="tel" name="phone" value="<%= val('phone') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Email</label>
          <input type="email" name="email" value="<%= val('email') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <% if (canViewSensitive) { %>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Date of Birth</label>
          <input type="date" name="date_of_birth" value="<%= val('date_of_birth') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <% } %>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Address</label>
          <input type="text" name="address" value="<%= val('address') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Suburb</label>
          <input type="text" name="suburb" value="<%= val('suburb') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">State</label>
          <input type="text" name="state" value="<%= val('state') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. NSW">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Postcode</label>
          <input type="text" name="postcode" value="<%= val('postcode') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. 2000">
        </div>
      </div>
    </div>
  </div>

  <!-- Employment -->
  <div class="emp-pane hidden" data-emp-pane="employment">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Employment Details <span class="text-gray-400 font-normal normal-case text-[10px] ml-1">Optional</span></h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Employee Code</label>
          <input type="text" name="employee_code" value="<%= val('employee_code') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. EMP-001">
          <p class="text-[10px] text-gray-400 mt-0.5">Unique employee identifier for payroll/HR systems</p>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Company</label>
          <input type="text" name="company" value="<%= val('company') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. T&S Traffic Control">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Division</label>
          <input type="text" name="division" value="<%= val('division') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. Operations">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Role Title</label>
          <input type="text" name="role_title" value="<%= val('role_title') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. Traffic Controller">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Employment Type</label>
          <select name="employment_type" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <option value="">-- Select --</option>
            <% employmentTypes.forEach(t => { %>
              <%/* Two shapes reach this list: the hardcoded defaults above
                   ({ val, label }) and rows from app_settings via
                   settingsOptions ({ key, label, … }). Without `.key` the
                   settings shape fell through to the object itself, so every
                   option rendered value="[object Object]" — no option matched
                   the employee's saved type, the browser fell back to the
                   blank first option, and the route's `|| 'full_time'`
                   quietly turned every casual worker full-time on save. */%>
              <% const typeVal = t.val || t.value || t.key || t; const typeLabel = t.label || t.key || t; %>
              <option value="<%= typeVal %>" <%= selected('employment_type', typeVal) %>><%= typeLabel %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Employment Status</label>
          <select name="employment_status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <% defaultStatuses.forEach(s => { %>
              <option value="<%= s.val %>" <%= selected('employment_status', s.val) %>><%= s.label %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Payment Type</label>
          <select name="payment_type" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <option value="">-- None --</option>
            <option value="cash" <%= val('payment_type') === 'cash' ? 'selected' : '' %>>Cash</option>
            <option value="tfn" <%= val('payment_type') === 'tfn' ? 'selected' : '' %>>TFN</option>
            <option value="abn" <%= val('payment_type') === 'abn' ? 'selected' : '' %>>ABN</option>
          </select>
          <p class="text-[10px] text-gray-400 mt-0.5">How this employee is paid (TFN for PAYG, ABN for contractors)</p>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Start Date</label>
          <input type="date" name="start_date" value="<%= val('start_date') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">End Date</label>
          <input type="date" name="end_date" value="<%= val('end_date') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <p class="text-[10px] text-gray-400 mt-0.5">Leave blank for ongoing employment</p>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Probation End Date</label>
          <input type="date" name="probation_end_date" value="<%= val('probation_end_date') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Manager</label>
          <select name="manager_id" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <option value="">-- No Manager --</option>
            <% if (allEmployees) { allEmployees.forEach(e => { %>
              <% if (!isEdit || e.id !== employee.id) { %>
                <option value="<%= e.id %>" <%= isEdit && employee.manager_id == e.id ? 'selected' : '' %>><%= e.first_name %> <%= e.last_name %></option>
              <% } %>
            <% }); } %>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Operational -->
  <div class="emp-pane hidden" data-emp-pane="operational">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Operational <span class="text-gray-400 font-normal normal-case text-[10px] ml-1">Optional</span></h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Traffic Role Level</label>
          <input type="text" name="traffic_role_level" value="<%= val('traffic_role_level') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. TC1, TC2, Supervisor">
          <p class="text-[10px] text-gray-400 mt-0.5">Traffic controller classification level</p>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Ticket Classification</label>
          <input type="text" name="ticket_classification" value="<%= val('ticket_classification') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Primary Work Region</label>
          <input type="text" name="primary_work_region" value="<%= val('primary_work_region') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. Sydney Metro">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Base Location</label>
          <input type="text" name="base_location" value="<%= val('base_location') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Company Vehicle Assigned</label>
          <input type="text" name="company_vehicle_assigned" value="<%= val('company_vehicle_assigned') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. Vehicle rego or ID">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Induction Status</label>
          <select name="induction_status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <option value="">-- Select --</option>
            <option value="not_started" <%= selected('induction_status', 'not_started') %>>Not Started</option>
            <option value="in_progress" <%= selected('induction_status', 'in_progress') %>>In Progress</option>
            <option value="completed" <%= selected('induction_status', 'completed') %>>Completed</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">PPE Issued Status</label>
          <select name="ppe_issued_status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <option value="">-- Select --</option>
            <option value="not_issued" <%= selected('ppe_issued_status', 'not_issued') %>>Not Issued</option>
            <option value="partial" <%= selected('ppe_issued_status', 'partial') %>>Partial</option>
            <option value="fully_issued" <%= selected('ppe_issued_status', 'fully_issued') %>>Fully Issued</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Uniform Issued Status</label>
          <select name="uniform_issued_status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <option value="">-- Select --</option>
            <option value="not_issued" <%= selected('uniform_issued_status', 'not_issued') %>>Not Issued</option>
            <option value="partial" <%= selected('uniform_issued_status', 'partial') %>>Partial</option>
            <option value="fully_issued" <%= selected('uniform_issued_status', 'fully_issued') %>>Fully Issued</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4 pt-4 border-t border-gray-100">
        <div class="flex items-center gap-2">
          <input type="checkbox" name="allocatable" id="allocatable" value="1" <%= checked('allocatable') %>
            class="rounded border-gray-300 text-brand-600 focus:ring-brand-500">
          <label for="allocatable" class="text-sm text-gray-700">Allocatable to Jobs</label>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" name="blocked_from_allocation" id="blocked_from_allocation" value="1" <%= checked('blocked_from_allocation') %>
            class="rounded border-gray-300 text-brand-600 focus:ring-brand-500">
          <label for="blocked_from_allocation" class="text-sm text-gray-700">Blocked from Allocation</label>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" name="white_card_required" id="white_card_required" value="1" <%= checked('white_card_required') %>
            class="rounded border-gray-300 text-brand-600 focus:ring-brand-500">
          <label for="white_card_required" class="text-sm text-gray-700">White Card Required</label>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" name="medical_required" id="medical_required" value="1" <%= checked('medical_required') %>
            class="rounded border-gray-300 text-brand-600 focus:ring-brand-500">
          <label for="medical_required" class="text-sm text-gray-700">Medical Required</label>
        </div>
      </div>
      <div class="mt-4">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Block Reason</label>
        <input type="text" name="block_reason" value="<%= val('block_reason') %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          placeholder="Reason for blocking from allocation (if applicable)">
        <p class="text-[10px] text-gray-400 mt-0.5">Only required if employee is blocked from job allocation</p>
      </div>
    </div>
  </div>

  <!-- Licences & Cards -->
  <div class="emp-pane hidden" data-emp-pane="licences">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Licences & Cards</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">White Card Number</label>
          <input type="text" name="white_card_number" value="<%= val('white_card_number') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. WC-12345678">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">TC Licence Number</label>
          <input type="text" name="tc_licence_number" value="<%= val('tc_licence_number') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. TC-123456">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">TC Licence State</label>
          <select name="tc_licence_state"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <option value="">Select...</option>
            <% ['NSW','VIC','QLD','SA','WA','TAS','NT','ACT'].forEach(s => { %>
              <option value="<%= s %>" <%= val('tc_licence_state') === s ? 'selected' : '' %>><%= s %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">TC Date of Issue</label>
          <input type="date" name="tc_licence_date_of_issue" value="<%= val('tc_licence_date_of_issue') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Driver's Licence Number</label>
          <input type="text" name="drivers_licence_number" value="<%= val('drivers_licence_number') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. 12345678">
        </div>
      </div>
    </div>
  </div>

  <!-- Emergency Contact -->
  <div class="emp-pane hidden" data-emp-pane="emergency">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Emergency Contact <span class="text-gray-400 font-normal normal-case text-[10px] ml-1">Optional</span></h2>
      </div>
      <% if (canViewSensitive) { %>
      <p class="text-xs text-gray-500 mb-4">Provide at least one emergency contact for safety compliance. This information is kept confidential.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Contact Name</label>
          <input type="text" name="emergency_contact_name" value="<%= val('emergency_contact_name') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Contact Phone</label>
          <input type="tel" name="emergency_contact_phone" value="<%= val('emergency_contact_phone') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Relationship</label>
          <input type="text" name="emergency_contact_relationship" value="<%= val('emergency_contact_relationship') %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="e.g. Spouse, Parent, Sibling">
        </div>
      </div>
      <% } else { %>
      <div class="text-center py-8">
        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <p class="text-sm text-gray-500">Emergency contact details are restricted to authorised personnel.</p>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Payroll & Pay — bank/super/TFN, hourly rates and management payroll.
       Each block keeps its own permission gate; when the user holds neither,
       the section says so instead of rendering empty. -->
  <div class="emp-pane hidden" data-emp-pane="payroll">
    <% if (!canViewSensitive && !showRates) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <div class="text-center py-8">
        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <p class="text-sm text-gray-500">Payroll details and pay rates are restricted to authorised personnel.</p>
      </div>
    </div>
    <% } %>
    <% if (typeof canViewSensitive !== 'undefined' && canViewSensitive) { %>
    <!-- Payroll Details: Bank, Super, TFN (encrypted at rest) -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 mt-4">
      <div class="flex items-center gap-2 mb-1">
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <h3 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Payroll Details</h3>
      </div>
      <p class="text-xs text-gray-400 mb-4">Bank, super and TFN are encrypted at rest with AES-256-GCM. Saving here bypasses the worker-submission queue and writes a 'synced' record tagged with your user.</p>

      <!-- BANK -->
      <div class="grid grid-cols-1 sm:grid-cols-[2fr_1fr_1fr] gap-4 mb-4 pb-4 border-b border-gray-100">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Bank account name</label>
          <input type="text" name="bank_account_name" value="<%= (typeof latestBank !== 'undefined' && latestBank) ? (latestBank.account_name || '') : '' %>"
            placeholder="Name on the account"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">BSB</label>
          <input type="text" name="bank_bsb" inputmode="numeric" maxlength="7" pattern="\d{3}-?\d{3}"
            placeholder="<%= (typeof latestBank !== 'undefined' && latestBank && latestBank.bsb_last3) ? '•••-••' + latestBank.bsb_last3 + ' (current)' : '062-000' %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Account number</label>
          <input type="text" name="bank_account_number" inputmode="numeric" maxlength="10" pattern="\d{6,10}"
            placeholder="<%= (typeof latestBank !== 'undefined' && latestBank && latestBank.account_last3) ? '••••••' + latestBank.account_last3 + ' (current)' : '12345678' %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div class="sm:col-span-3">
          <p class="text-[11px] text-gray-500">
            <% if (typeof latestBank !== 'undefined' && latestBank) { %>
              On file: <span class="font-mono">BSB •••-••<%= latestBank.bsb_last3 %>, Acct ••••••<%= latestBank.account_last3 %></span>
              <% if (latestBank.status === 'synced') { %><span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] bg-emerald-50 text-emerald-700">✓ Synced</span>
              <% } else if (latestBank.status === 'pending') { %><span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] bg-amber-50 text-amber-700">⧗ Pending</span><% } %>
              <span class="text-gray-400"> — leave BSB &amp; account blank to keep.</span>
            <% } else { %>
              No bank record on file yet.
            <% } %>
          </p>
        </div>
      </div>

      <!-- SUPER -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4 pb-4 border-b border-gray-100">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Super fund</label>
          <input type="text" name="super_fund_name" value="<%= (typeof latestSuper !== 'undefined' && latestSuper) ? (latestSuper.fund_name || '') : '' %>"
            placeholder="e.g. AustralianSuper"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">USI</label>
          <input type="text" name="super_usi" value="<%= (typeof latestSuper !== 'undefined' && latestSuper) ? (latestSuper.usi || '') : '' %>"
            placeholder="AUS0100AU"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Member number</label>
          <input type="text" name="super_member_number" value="<%= (typeof latestSuper !== 'undefined' && latestSuper) ? (latestSuper.member_number || '') : '' %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Fund ABN</label>
          <input type="text" name="super_fund_abn" value="<%= (typeof latestSuper !== 'undefined' && latestSuper) ? (latestSuper.fund_abn || '') : '' %>"
            inputmode="numeric" maxlength="14" placeholder="11 digits"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
        </div>
        <% if (typeof latestSuper !== 'undefined' && latestSuper && latestSuper.status) { %>
          <div class="sm:col-span-2 lg:col-span-4">
            <p class="text-[11px] text-gray-500">Super record: <%= latestSuper.fund_name || '—' %>
              <% if (latestSuper.status === 'synced') { %><span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] bg-emerald-50 text-emerald-700">✓ Synced</span>
              <% } else if (latestSuper.status === 'pending') { %><span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] bg-amber-50 text-amber-700">⧗ Pending</span><% } %>
            </p>
          </div>
        <% } %>
      </div>

      <!-- TFN -->
      <div class="grid grid-cols-1 sm:grid-cols-[1.5fr_1fr_1fr] gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">TFN (9 digits)</label>
          <input type="text" name="tfn_number" inputmode="numeric" maxlength="11" pattern="\d{3}\s?\d{3}\s?\d{3}"
            placeholder="<%= (typeof latestTfn !== 'undefined' && latestTfn && latestTfn.tfn_last3) ? '••• ••• •••' + latestTfn.tfn_last3 + ' (current)' : '123 456 789' %>"
            autocomplete="off"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
          <p class="text-[10px] text-gray-400 mt-1">Leave blank to keep the existing TFN.</p>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Residency status</label>
          <select name="tfn_residency" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm">
            <% const curRes = (typeof latestTfn !== 'undefined' && latestTfn) ? latestTfn.residency_status : 'resident'; %>
            <option value="resident" <%= curRes === 'resident' ? 'selected' : '' %>>Australian resident</option>
            <option value="foreign" <%= curRes === 'foreign' ? 'selected' : '' %>>Foreign resident</option>
            <option value="working_holiday" <%= curRes === 'working_holiday' ? 'selected' : '' %>>Working holiday maker</option>
          </select>
        </div>
        <div class="flex items-end">
          <label class="inline-flex items-center gap-2 text-sm text-gray-700">
            <input type="checkbox" name="tfn_claim_threshold" value="1" <%= (typeof latestTfn !== 'undefined' && latestTfn && latestTfn.claim_threshold) ? 'checked' : '' %> class="w-4 h-4 rounded text-brand-600">
            Claims tax-free threshold
          </label>
        </div>
        <% if (typeof latestTfn !== 'undefined' && latestTfn && latestTfn.tfn_last3) { %>
          <div class="sm:col-span-3">
            <p class="text-[11px] text-gray-500">On file: <span class="font-mono">TFN ••• ••• •••<%= latestTfn.tfn_last3 %></span>
              <% if (latestTfn.status === 'synced') { %><span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] bg-emerald-50 text-emerald-700">✓ Synced</span>
              <% } else if (latestTfn.status === 'pending') { %><span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] bg-amber-50 text-amber-700">⧗ Pending</span><% } %>
            </p>
          </div>
        <% } %>
      </div>
    </div>
    <% } %>
    <% if (typeof showRates !== 'undefined' && showRates) { %>
    <!-- Pay Rates (Admin / Finance only) -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 mt-4">
      <h3 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-1">Pay Rates</h3>
      <p class="text-xs text-gray-400 mb-4">Only visible to Admin and Finance roles. Rates are per hour ($).</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Day Rate</label>
          <input type="number" step="0.01" min="0" name="rate_day" value="<%= val('rate_day') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">OT Rate</label>
          <input type="number" step="0.01" min="0" name="rate_ot" value="<%= val('rate_ot') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">DT Rate</label>
          <input type="number" step="0.01" min="0" name="rate_dt" value="<%= val('rate_dt') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Night Rate</label>
          <input type="number" step="0.01" min="0" name="rate_night" value="<%= val('rate_night') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Night OT</label>
          <input type="number" step="0.01" min="0" name="rate_night_ot" value="<%= val('rate_night_ot') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Night DT</label>
          <input type="number" step="0.01" min="0" name="rate_night_dt" value="<%= val('rate_night_dt') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Travel</label>
          <input type="number" step="0.01" min="0" name="rate_travel" value="<%= val('rate_travel') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Meal</label>
          <input type="number" step="0.01" min="0" name="rate_meal" value="<%= val('rate_meal') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Weekend</label>
          <input type="number" step="0.01" min="0" name="rate_weekend" value="<%= val('rate_weekend') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
      </div>
    </div>

    <!-- Management Payroll (Admin / Finance only) -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 mt-4">
      <h3 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-1">Management Payroll</h3>
      <p class="text-xs text-gray-400 mb-4">Tick to add this employee to the Management pay run roster. Salary fields drive the auto-seeded line on each new run.</p>
      <label class="inline-flex items-center gap-2 mb-4 cursor-pointer">
        <input type="checkbox" name="on_management_payroll" value="1" <%= val('on_management_payroll') == 1 ? 'checked' : '' %>
          class="w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500">
        <span class="text-sm font-semibold text-gray-700">On management payroll</span>
      </label>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Weekly Salary ($)</label>
          <input type="number" step="0.01" min="0" name="weekly_salary" value="<%= val('weekly_salary') || 0 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Super Rate <span class="font-normal normal-case text-gray-300">(0.12 = 12%)</span></label>
          <input type="number" step="0.001" min="0" max="1" name="super_rate" value="<%= val('super_rate') || 0.12 %>"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Notes & Links -->
  <div class="emp-pane hidden" data-emp-pane="notes">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Notes & Links</h2>
      <div class="space-y-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Internal Notes</label>
          <textarea name="internal_notes" rows="4"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
            placeholder="Private notes about this employee..."><%= val('internal_notes') %></textarea>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Linked Crew Member</label>
            <select name="linked_crew_member_id" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
              <option value="">-- None --</option>
              <% if (crewMembers) { crewMembers.forEach(cm => { %>
                <option value="<%= cm.id %>" <%= isEdit && employee.linked_crew_member_id == cm.id ? 'selected' : '' %>><%= cm.full_name %> (<%= cm.employee_id || 'No ID' %>)</option>
              <% }); } %>
            </select>
            <p class="text-[10px] text-gray-400 mt-0.5">Link to an existing crew roster member for scheduling</p>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Linked User Account</label>
            <select name="linked_user_id" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
              <option value="">-- None --</option>
              <% if (users) { users.forEach(u => { %>
                <option value="<%= u.id %>" <%= isEdit && employee.linked_user_id == u.id ? 'selected' : '' %>><%= u.full_name %> (<%= u.username %>)</option>
              <% }); } %>
            </select>
            <p class="text-[10px] text-gray-400 mt-0.5">Link to an admin dashboard login account</p>
          </div>
          <% if (canViewSensitive) { %>
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Payroll Reference</label>
            <input type="text" name="payroll_reference" value="<%= val('payroll_reference') %>"
              class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
              placeholder="External payroll system ID">
            <p class="text-[10px] text-gray-400 mt-0.5">Reference ID from your external payroll system (e.g. Xero, MYOB)</p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>


  <%/* Right padding clears the global FABs, which float fixed at the
       bottom-right exactly where this sticky footer puts its buttons —
       without it they sit on top of Save and swallow the click, so the
       button looks fine and simply does nothing. The old rule was sm:pr-32
       only, which left the narrow "+" FAB covering Save on mobile. */%>
  <div class="sticky bottom-0 z-20 bg-white/90 backdrop-blur-sm border-t border-gray-200 rounded-b-xl px-5 pr-20 sm:pr-32 py-3 flex items-center justify-between gap-3" id="emp-footer">
    <a href="<%= isEdit ? '/hr/employees/' + employee.id : '/hr/employees' %>" class="px-4 py-2 text-sm text-gray-500 hover:text-gray-700"><%= isEdit ? 'Back to profile' : 'Cancel' %></a>
    <div class="flex items-center gap-3">
      <% if (!isEdit) { %>
        <span id="emp-progress-text2" class="text-xs text-gray-400 hidden sm:inline">Step 1 of <%= totalSteps %></span>
        <button type="button" id="emp-prev" class="hidden px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition inline-flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Previous
        </button>
        <button type="button" id="emp-next" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition inline-flex items-center gap-2">
          Next
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      <% } %>
      <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition inline-flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <%= isEdit ? 'Save' : 'Add Employee' %>
      </button>
    </div>
  </div>

  <!-- NoScript fallback: show every section as one long form -->
  <noscript>
    <style>.emp-pane, .emp-pane.hidden { display: block !important; } #emp-section-rail, #emp-footer { display: none !important; }</style>
    <div class="flex items-center gap-3 mt-5">
      <button type="submit" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition">
        <%= isEdit ? 'Update' : 'Add' %> Employee
      </button>
      <a href="<%= isEdit ? '/hr/employees/' + employee.id : '/hr/employees' %>" class="px-5 py-2.5 text-sm text-gray-500 hover:text-gray-700">Cancel</a>
    </div>
  </noscript>

</form>

<script>
(function () {
  var IDS     = <%- JSON.stringify(sections.map(function (s) { return s.id; })) %>;
  var rail    = document.getElementById('emp-section-rail');
  var form    = document.getElementById('employee-wizard-form');
  var field   = document.getElementById('emp-section-field');
  if (!rail || !form) return;

  var panes = {}, buttons = {};
  IDS.forEach(function (id) {
    panes[id]   = document.querySelector('[data-emp-pane="' + id + '"]');
    buttons[id] = rail.querySelector('[data-emp-sec="' + id + '"]');
  });

  var prevBtn  = document.getElementById('emp-prev');
  var nextBtn  = document.getElementById('emp-next');
  var bar      = document.getElementById('emp-progress-bar');
  var progress = document.getElementById('emp-progress-text');
  var progress2 = document.getElementById('emp-progress-text2');

  var current = '<%= activeSection %>';

  function indexOf(id) { var i = IDS.indexOf(id); return i === -1 ? 0 : i; }

  function show(id, writeUrl) {
    if (!panes[id]) id = IDS[0];
    current = id;
    IDS.forEach(function (other) {
      if (panes[other])   panes[other].classList.toggle('hidden', other !== id);
      if (buttons[other]) {
        var on = other === id;
        buttons[other].classList.toggle('bg-brand-600', on);
        buttons[other].classList.toggle('text-white', on);
        buttons[other].classList.toggle('shadow-sm', on);
        buttons[other].classList.toggle('text-gray-500', !on);
        buttons[other].classList.toggle('hover:text-gray-900', !on);
        buttons[other].classList.toggle('hover:bg-gray-50', !on);
        var num = buttons[other].querySelector('.emp-sec-num');
        if (num) {
          num.classList.toggle('bg-white/20', on);
          num.classList.toggle('text-white', on);
          num.classList.toggle('bg-gray-100', !on);
          num.classList.toggle('text-gray-500', !on);
        }
      }
    });

    if (field) field.value = id;                    // so the save comes back here

    var i = indexOf(id);
    if (bar) bar.style.width = ((i + 1) / IDS.length * 100).toFixed(1) + '%';
    var label = 'Step ' + (i + 1) + ' of ' + IDS.length;
    if (progress)  progress.textContent = label;
    if (progress2) progress2.textContent = label;
    if (prevBtn) prevBtn.classList.toggle('hidden', i === 0);
    if (nextBtn) nextBtn.classList.toggle('hidden', i === IDS.length - 1);

    if (writeUrl) {
      try {
        var url = new URL(window.location.href);
        url.searchParams.set('section', id);
        history.replaceState(null, '', url.pathname + url.search);
      } catch (e) {}
    }
  }

  rail.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-emp-sec]');
    if (btn) show(btn.getAttribute('data-emp-sec'), true);
  });

  // Creating a new employee keeps the guided Back/Next and its per-step
  // required check. Editing lets you jump anywhere — every field is already
  // populated, so there is nothing to guide you through.
  if (nextBtn) {
    nextBtn.addEventListener('click', function () {
      var pane = panes[current];
      if (pane) {
        var bad = null;
        pane.querySelectorAll('[required]').forEach(function (el) { if (!bad && !el.checkValidity()) bad = el; });
        if (bad) { bad.reportValidity(); return; }
      }
      show(IDS[Math.min(indexOf(current) + 1, IDS.length - 1)], true);
    });
  }
  if (prevBtn) {
    prevBtn.addEventListener('click', function () {
      show(IDS[Math.max(indexOf(current) - 1, 0)], true);
    });
  }

  // A required field inside a display:none section makes the browser refuse
  // to submit *silently* — it can't focus a hidden control, so you get no
  // message and nothing happens. This has to hang off 'invalid', not
  // 'submit': when validation fails the submit event is never dispatched at
  // all. 'invalid' fires per control and doesn't bubble, hence capture.
  // Revealing the pane here happens before the browser picks what to focus,
  // so it can then report against a visible field.
  form.addEventListener('invalid', function (e) {
    var pane = e.target.closest && e.target.closest('[data-emp-pane]');
    if (pane && pane.classList.contains('hidden')) show(pane.getAttribute('data-emp-pane'), true);
  }, true);

  show(current, false);
})();
</script>
