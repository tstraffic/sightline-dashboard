<% locals.currentPage = 'hr-roster' %>
<%
  function fmtDate(d) {
    if (!d) return '-';
    return new Date(d).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: '2-digit', month: 'short', year: 'numeric' });
  }
  var sBadges = {
    active:      'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20',
    reserved:    'bg-blue-50 text-blue-700 ring-1 ring-blue-600/20',
    on_leave:    'bg-blue-50 text-blue-700 ring-1 ring-blue-600/20',
    deactivated: 'bg-gray-100 text-gray-500',
    inactive:    'bg-gray-100 text-gray-500',
    terminated:  'bg-red-50 text-red-700 ring-1 ring-red-600/20',
    suspended:   'bg-red-50 text-red-700 ring-1 ring-red-600/20',
    onboarding:  'bg-purple-50 text-purple-700 ring-1 ring-purple-600/20',
    offboarded:  'bg-gray-100 text-gray-500',
  };
  var rBadges = {
    ready:                'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20',
    ready_with_warnings:  'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20',
    non_compliant:        'bg-red-50 text-red-700 ring-1 ring-red-600/20',
    blocked:              'bg-red-50 text-red-700 ring-1 ring-red-600/20',
    onboarding:           'bg-purple-50 text-purple-700 ring-1 ring-purple-600/20',
    on_leave:             'bg-blue-50 text-blue-700 ring-1 ring-blue-600/20',
  };
  var rLabels = {
    ready: 'Ready', ready_with_warnings: 'Warnings', non_compliant: 'Non-Compliant',
    blocked: 'Blocked', onboarding: 'Onboarding', on_leave: 'On Leave',
  };
%>

<div class="space-y-5">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Roster<% if (locals.showDeleted) { %> <span class="text-gray-400">— Deleted</span><% } %></h1>
      <p class="text-sm text-gray-500 mt-1"><% if (locals.showDeleted) { %>Deleted employees — restore to reactivate their login<% } else { %>Full workforce list &mdash; manage, filter and bulk-action employees<% } %></p>
    </div>
    <div class="flex items-center gap-2">
      <!-- Export menu — opens a small dropdown so the user can choose
           which slice of the roster to export (matches the tab filters)
           and whether they want a names-only list or the full details
           CSV. Each option submits a GET to /hr/roster/export.csv with
           the right query params. -->
      <details class="relative" id="roster-export">
        <summary class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition cursor-pointer list-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          Export
          <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-72 bg-white border border-gray-200 rounded-xl shadow-lg z-30 overflow-hidden">
          <div class="px-3 py-2 bg-gray-50 border-b border-gray-100">
            <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Pick what to export</p>
          </div>
          <%
            // Each export row hits /hr/roster/export.csv with the
            // matching tab filter + optional format=names.
            var exportRows = [
              { label: 'All employees',  qs: '',                count: stats.totalActiveAll, accent: 'text-gray-700' },
              { label: 'Active',         qs: '?status=active',  count: stats.totalActive,    accent: 'text-emerald-700' },
              { label: 'Reserved',       qs: '?status=reserved',count: stats.totalReserved,  accent: 'text-blue-700' },
              { label: 'On Leave',       qs: '?status=on_leave',count: stats.totalOnLeave,   accent: 'text-blue-700' },
              { label: 'Deactivated',    qs: '?status=inactive',count: stats.totalDeactivated, accent: 'text-gray-600' },
              { label: 'Terminated',     qs: '?status=terminated',count: stats.totalTerminated, accent: 'text-red-700' },
              { label: 'Deleted',        qs: '?view=deleted',   count: stats.totalDeleted,   accent: 'text-gray-500' },
            ];
          %>
          <ul class="py-1 max-h-72 overflow-y-auto">
            <% exportRows.forEach(function (row) { %>
              <li class="border-b border-gray-50 last:border-b-0">
                <div class="px-3 py-2 flex items-center justify-between gap-2 hover:bg-gray-50">
                  <div class="min-w-0">
                    <p class="text-sm font-medium <%= row.accent %>"><%= row.label %></p>
                    <p class="text-[10px] text-gray-400 mt-0.5"><%= row.count %> record<%= row.count === 1 ? '' : 's' %></p>
                  </div>
                  <div class="flex items-center gap-1 flex-shrink-0">
                    <a href="/hr/roster/export.csv<%= row.qs %><%= row.qs ? '&' : '?' %>format=names"
                       class="px-2 py-1 text-[11px] font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 rounded ring-1 ring-brand-200 transition"
                       title="Just the full names, single column">Names</a>
                    <a href="/hr/roster/export.csv<%= row.qs %>"
                       class="px-2 py-1 text-[11px] font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded ring-1 ring-gray-200 transition"
                       title="Full roster export with all fields">Full</a>
                  </div>
                </div>
              </li>
            <% }); %>
          </ul>
          <%
            // Re-use whatever filters are currently active on the page —
            // status / payment_type / induction / search — so the user
            // can also export exactly what they're looking at.
            var currentQs = [];
            if (filters.status)        currentQs.push('status=' + encodeURIComponent(filters.status));
            if (filters.payment_type)  currentQs.push('payment_type=' + encodeURIComponent(filters.payment_type));
            if (filters.employment_type) currentQs.push('employment_type=' + encodeURIComponent(filters.employment_type));
            if (filters.induction)     currentQs.push('induction=' + encodeURIComponent(filters.induction));
            if (filters.search)        currentQs.push('search=' + encodeURIComponent(filters.search));
            if (locals.showDeleted)    currentQs.push('view=deleted');
            var qsCurrent = currentQs.length ? '?' + currentQs.join('&') : '';
            var hasActiveFilter = currentQs.length > 0;
          %>
          <% if (hasActiveFilter) { %>
            <div class="border-t border-gray-100 bg-amber-50/40 px-3 py-2">
              <p class="text-[10px] font-bold text-amber-700 uppercase tracking-widest mb-1">Current view</p>
              <div class="flex items-center justify-between gap-2">
                <p class="text-xs text-gray-600 truncate" title="<%= qsCurrent %>">Exports <%= employees.length %> visible record<%= employees.length === 1 ? '' : 's' %></p>
                <div class="flex items-center gap-1">
                  <a href="/hr/roster/export.csv<%= qsCurrent %>&format=names" class="px-2 py-1 text-[11px] font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 rounded ring-1 ring-brand-200 transition">Names</a>
                  <a href="/hr/roster/export.csv<%= qsCurrent %>" class="px-2 py-1 text-[11px] font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded ring-1 ring-gray-200 transition">Full</a>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </details>
      <% if (!locals.showDeleted) { %>
      <a href="/hr/employees/new" class="inline-flex items-center justify-center px-4 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
        Add Employee
      </a>
      <% } %>
    </div>
  </div>

  <script>
    // Close the export dropdown on outside-click + ESC so it behaves like
    // a real menu rather than a stuck-open <details>.
    (function () {
      var menu = document.getElementById('roster-export');
      if (!menu) return;
      document.addEventListener('click', function (e) {
        if (menu.open && !menu.contains(e.target)) menu.open = false;
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && menu.open) menu.open = false;
      });
      // Auto-close after picking an export.
      menu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { setTimeout(function () { menu.open = false; }, 150); });
      });
    })();
  </script>

  <!-- Induction quick filters -->
  <% if (!locals.showDeleted) { %>
  <div class="flex flex-wrap items-center gap-2">
    <span class="text-xs font-bold text-gray-400 uppercase tracking-widest mr-1">Induction:</span>
    <a href="/hr/roster" class="px-2.5 py-1 rounded-full text-xs font-semibold transition <%= !filters.induction ? 'bg-brand-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">All</a>
    <a href="/hr/roster?induction=inducted" class="px-2.5 py-1 rounded-full text-xs font-semibold transition <%= filters.induction === 'inducted' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">
      Inducted <span class="<%= filters.induction === 'inducted' ? 'text-emerald-100' : 'text-gray-400' %>">(<%= stats.inductedCount %>)</span>
    </a>
    <a href="/hr/roster?induction=not_inducted" class="px-2.5 py-1 rounded-full text-xs font-semibold transition <%= filters.induction === 'not_inducted' ? 'bg-amber-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">
      Not yet <span class="<%= filters.induction === 'not_inducted' ? 'text-amber-100' : 'text-gray-400' %>">(<%= stats.notInductedCount %>)</span>
    </a>
  </div>
  <% } %>

  <!-- All / Active / Reserved / On Leave / Deactivated / Terminated / Deleted tabs -->
  <%
    var tabAll = !locals.showDeleted && !filters.status;
    var tabActive = !locals.showDeleted && filters.status === 'active';
    var tabReserved = !locals.showDeleted && filters.status === 'reserved';
    var tabOnLeave = !locals.showDeleted && filters.status === 'on_leave';
    var tabInactive = !locals.showDeleted && (filters.status === 'inactive' || filters.status === 'deactivated');
    var tabTerminated = !locals.showDeleted && filters.status === 'terminated';
  %>
  <div class="flex gap-1 border-b border-gray-200 overflow-x-auto">
    <a href="/hr/roster" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold transition-all border-b-2 whitespace-nowrap <%= tabAll ? 'border-brand-600 text-brand-600' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      All <span class="text-xs font-bold <%= tabAll ? 'text-brand-600' : 'text-gray-400' %>"><%= stats.totalActiveAll %></span>
    </a>
    <a href="/hr/roster?status=active" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold transition-all border-b-2 whitespace-nowrap <%= tabActive ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      Active <span class="text-xs font-bold <%= tabActive ? 'text-emerald-600' : 'text-gray-400' %>"><%= stats.totalActive %></span>
    </a>
    <a href="/hr/roster?status=reserved" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold transition-all border-b-2 whitespace-nowrap <%= tabReserved ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      Reserved <span class="text-xs font-bold <%= tabReserved ? 'text-blue-600' : 'text-gray-400' %>"><%= stats.totalReserved %></span>
    </a>
    <a href="/hr/roster?status=on_leave" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold transition-all border-b-2 whitespace-nowrap <%= tabOnLeave ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      On Leave <span class="text-xs font-bold <%= tabOnLeave ? 'text-blue-600' : 'text-gray-400' %>"><%= stats.totalOnLeave %></span>
    </a>
    <a href="/hr/roster?status=inactive" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold transition-all border-b-2 whitespace-nowrap <%= tabInactive ? 'border-gray-600 text-gray-700' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      Deactivated <span class="text-xs font-bold <%= tabInactive ? 'text-gray-700' : 'text-gray-400' %>"><%= stats.totalDeactivated %></span>
    </a>
    <a href="/hr/roster?status=terminated" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold transition-all border-b-2 whitespace-nowrap <%= tabTerminated ? 'border-red-600 text-red-600' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      Terminated <span class="text-xs font-bold <%= tabTerminated ? 'text-red-600' : 'text-gray-400' %>"><%= stats.totalTerminated %></span>
    </a>
    <a href="/hr/roster?view=deleted" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold transition-all border-b-2 whitespace-nowrap <%= locals.showDeleted ? 'border-gray-700 text-gray-900' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      Deleted <% if (stats.totalDeleted > 0) { %><span class="text-xs font-bold bg-gray-200 text-gray-700 px-1.5 py-0.5 rounded"><%= stats.totalDeleted %></span><% } %>
    </a>
  </div>

  <!-- SOP Sign-Off Bulk Banner -->
  <% if (typeof sopUnsignedCount !== 'undefined' && sopUnsignedCount > 0 && !locals.showDeleted) { %>
  <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
    <div class="flex flex-col sm:flex-row sm:items-center gap-4">
      <div class="flex items-start sm:items-center gap-3 flex-1">
        <div class="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-bold text-amber-900"><%= sopUnsignedCount %> active worker<%= sopUnsignedCount === 1 ? '' : 's' %> haven't signed the current SOP (<code class="text-xs bg-white/60 px-1 rounded"><%= sopVersion %></code>)</p>
          <p class="text-xs text-amber-800 mt-0.5">Send each unsigned worker an email with their personal sign link. People without an email on file will be skipped.</p>
        </div>
      </div>
      <form method="POST" action="/hr/roster/sop-bulk-send" onsubmit="return confirm('Send SOP sign-link emails to all <%= sopUnsignedCount %> unsigned active workers?')" class="flex-shrink-0">
        <%- include('../partials/csrf') %>
        <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-amber-600 hover:bg-amber-500 text-white text-sm font-semibold rounded-lg transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          Send to all unsigned
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <!-- Worker Portal Preview -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
    <div class="flex flex-col sm:flex-row sm:items-center gap-4">
      <div class="flex items-start sm:items-center gap-3 flex-1">
        <div class="w-10 h-10 bg-brand-600 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <div class="min-w-0">
          <p class="text-sm font-bold text-gray-900">Worker Portal Preview</p>
          <p class="text-xs text-gray-600 mt-0.5">Test changes from a crew member's perspective.</p>
          <p class="text-[11px] text-gray-500 mt-1">Test account: <span class="font-mono font-semibold text-gray-700">EMP-TEST</span> &middot; PIN <span class="font-mono font-semibold text-gray-700">1234</span></p>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <form method="POST" action="/hr/roster/preview-worker" target="_blank">
          <%- include('../partials/csrf') %>
          <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-2 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded-lg transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/></svg>
            Preview as test user
          </button>
        </form>
        <a href="/w/login" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-lg border border-gray-300 transition">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            Open portal
        </a>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Active</p>
      <p class="text-2xl font-bold text-emerald-600 mt-1"><%= stats.totalActive %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Deactivated</p>
      <p class="text-2xl font-bold text-gray-500 mt-1"><%= stats.totalDeactivated %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <p class="text-[10px] font-bold text-blue-400 uppercase tracking-widest">On Leave</p>
      <p class="text-2xl font-bold text-blue-600 mt-1"><%= stats.totalOnLeave %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <p class="text-[10px] font-bold text-red-400 uppercase tracking-widest">Terminated</p>
      <p class="text-2xl font-bold text-red-600 mt-1"><%= stats.totalTerminated %></p>
    </div>
  </div>

  <% if (!locals.showDeleted) { %>
  <!-- Payment Tabs — pill counts are scoped to the currently-selected status
       tab (filters.status) so All / Cash / TFN / ABN always share the same
       population. Clicking a pill preserves the status filter via the
       hidden 'status' query param so you don't lose your tab on filter. -->
  <% var statusQs = filters.status ? ('&status=' + encodeURIComponent(filters.status)) : ''; %>
  <div class="flex gap-2 overflow-x-auto pb-1">
    <a href="/hr/roster?<%= statusQs.replace(/^&/, '') %>" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all <%= !filters.payment_type ? 'bg-brand-600 text-white shadow-sm' : 'bg-white border border-gray-200 text-gray-600 hover:bg-gray-50' %>">
      All <span class="text-xs font-bold opacity-70"><%= stats.totalPillAll %></span>
    </a>
    <a href="/hr/roster?payment_type=cash<%= statusQs %>" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all <%= filters.payment_type === 'cash' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white border border-gray-200 text-gray-600 hover:bg-gray-50' %>">
      Cash <span class="text-xs font-bold opacity-70"><%= stats.totalCash %></span>
    </a>
    <a href="/hr/roster?payment_type=tfn<%= statusQs %>" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all <%= filters.payment_type === 'tfn' ? 'bg-blue-600 text-white shadow-sm' : 'bg-white border border-gray-200 text-gray-600 hover:bg-gray-50' %>">
      TFN <span class="text-xs font-bold opacity-70"><%= stats.totalTfn %></span>
    </a>
    <a href="/hr/roster?payment_type=abn<%= statusQs %>" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all <%= filters.payment_type === 'abn' ? 'bg-purple-600 text-white shadow-sm' : 'bg-white border border-gray-200 text-gray-600 hover:bg-gray-50' %>">
      ABN <span class="text-xs font-bold opacity-70"><%= stats.totalAbn %></span>
    </a>
  </div>
  <% } %>

  <!-- Filters -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
    <form method="GET" action="/hr/roster" class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3">
      <% if (filters.payment_type) { %><input type="hidden" name="payment_type" value="<%= filters.payment_type %>"><% } %>
      <% if (locals.showDeleted) { %><input type="hidden" name="view" value="deleted"><% } %>
      <select name="status" class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-700 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-brand-500">
        <option value="">All Statuses</option>
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="reserved" <%= filters.status === 'reserved' ? 'selected' : '' %>>Reserved</option>
        <option value="on_leave" <%= filters.status === 'on_leave' ? 'selected' : '' %>>On Leave</option>
        <option value="deactivated" <%= filters.status === 'deactivated' ? 'selected' : '' %>>Deactivated</option>
        <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Deactivated</option>
        <option value="terminated" <%= filters.status === 'terminated' ? 'selected' : '' %>>Terminated</option>
      </select>
      <select name="level" class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-700 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-brand-500">
        <option value="">All Levels</option>
        <option value="Traffic Controller" <%= filters.level === 'Traffic Controller' ? 'selected' : '' %>>Traffic Controller</option>
        <option value="Team Leader" <%= filters.level === 'Team Leader' ? 'selected' : '' %>>Team Leader</option>
        <option value="Project Supervisor" <%= filters.level === 'Project Supervisor' ? 'selected' : '' %>>Project Supervisor</option>
      </select>
      <select name="employment_type" class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-700 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-brand-500">
        <option value="">All Types</option>
        <option value="full_time" <%= filters.employment_type === 'full_time' ? 'selected' : '' %>>Full Time</option>
        <option value="part_time" <%= filters.employment_type === 'part_time' ? 'selected' : '' %>>Part Time</option>
        <option value="casual" <%= filters.employment_type === 'casual' ? 'selected' : '' %>>Casual</option>
        <option value="contractor" <%= filters.employment_type === 'contractor' ? 'selected' : '' %>>Contractor</option>
        <option value="subcontractor" <%= filters.employment_type === 'subcontractor' ? 'selected' : '' %>>Subcontractor</option>
      </select>
      <div class="flex-1 min-w-0 sm:min-w-[200px]">
        <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Search name, code, phone..."
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <button type="submit" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg border border-gray-300 transition">Filter</button>
    </form>
  </div>

  <% if (employees && employees.length > 0) { %>

  <!-- Bulk Bar -->
  <% if (locals.showDeleted) { %>
  <div id="rosterBulk" style="display:none" class="sticky top-0 z-30 bg-emerald-50 border border-emerald-200 rounded-xl shadow-sm p-3 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      <span id="rosterBulkCount" class="text-sm font-semibold text-emerald-700">0 selected</span>
    </div>
    <button type="button" id="rosterDeleteBtn" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded-lg transition">
      Restore Selected
    </button>
  </div>
  <% } else { %>
  <div id="rosterBulk" style="display:none" class="sticky top-0 z-30 bg-white border border-brand-200 rounded-xl shadow-md p-3 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      <span id="rosterBulkCount" class="text-sm font-semibold text-gray-700">0 selected</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <!-- Bulk status change -->
      <form method="POST" action="/hr/roster/bulk-status" id="rosterBulkStatusForm" class="flex items-center gap-2">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="employee_ids" id="rosterBulkStatusIds">
        <label class="text-xs text-gray-500 font-medium">Set status:</label>
        <select name="employment_status" id="rosterBulkStatusSelect" class="px-3 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-700 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">— pick —</option>
          <option value="active">Active</option>
          <option value="reserved">Reserved</option>
          <option value="on_leave">On Leave</option>
          <option value="inactive">Deactivated</option>
          <option value="terminated">Terminated</option>
        </select>
        <button type="submit" id="rosterBulkStatusBtn" disabled class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-semibold rounded-lg transition">Apply</button>
      </form>
      <span class="text-gray-300">|</span>
      <button type="button" id="rosterMergeBtn" disabled title="Select exactly two profiles to merge" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs font-semibold rounded-lg transition">
        Merge 2
      </button>
      <span class="text-gray-300">|</span>
      <button type="button" id="rosterDeleteBtn" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg transition">
        Delete
      </button>
    </div>
  </div>
  <% } %>

  <!-- Table -->
  <form id="rosterDeleteForm" method="POST" action="<%= locals.showDeleted ? '/hr/roster/restore' : '/hr/roster/delete' %>">
    <%- include('../partials/csrf') %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200" role="grid" aria-label="Employee roster">
          <thead>
            <tr class="border-b border-gray-200">
              <th scope="col" class="px-2 sm:px-3 py-3 text-center w-10">
                <input type="checkbox" id="rosterAll" aria-label="Select all employees" class="w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500 cursor-pointer">
              </th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Name</th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden sm:table-cell">Phone</th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden md:table-cell">Level</th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden md:table-cell">Type</th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Status</th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden lg:table-cell">Readiness</th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden md:table-cell" title="In-person or online induction completed">Inducted</th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden md:table-cell" title="Has signed the current SOP version">SOP</th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden lg:table-cell">Tier</th>
              <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden xl:table-cell">Portal</th>
              <% if (locals.showDeleted) { %>
                <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden xl:table-cell">Deleted</th>
              <% } else { %>
                <th scope="col" class="px-3 sm:px-4 py-3 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden xl:table-cell">Start Date</th>
              <% } %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% employees.forEach(function(emp) { %>
            <tr class="hover:bg-gray-50 transition <%= locals.showDeleted ? 'opacity-60' : '' %>">
              <td class="px-2 sm:px-3 py-3 text-center">
                <input type="checkbox" name="ids" value="<%= emp.id %>" aria-label="Select <%= emp.full_name || emp.first_name + ' ' + emp.last_name %>" class="roster-chk w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500 cursor-pointer">
              </td>
              <td class="px-3 sm:px-4 py-3">
                <a href="/hr/employees/<%= emp.id %>" class="text-brand-600 hover:text-brand-700 font-medium text-sm"><%= emp.first_name %><% if (emp.middle_name) { %> <%= emp.middle_name %><% } %> <%= emp.last_name %></a>
                <div class="flex items-center gap-1.5 mt-0.5">
                  <% if (emp.employee_code) { %><span class="text-[10px] text-gray-400 font-mono"><%= emp.employee_code %></span><% } %>
                  <%
                    var ptVal = emp.payment_type || '';
                    var ptCls = ptVal === 'cash' ? 'bg-emerald-50 text-emerald-700 ring-emerald-600/20'
                              : ptVal === 'tfn'  ? 'bg-blue-50 text-blue-700 ring-blue-600/20'
                              : ptVal === 'abn'  ? 'bg-purple-50 text-purple-700 ring-purple-600/20'
                              : 'bg-gray-50 text-gray-400 ring-gray-300/40';
                  %>
                  <form method="POST" action="/hr/employees/<%= emp.id %>/payment-type" class="inline">
                    <%- include('../partials/csrf') %>
                    <select name="payment_type" data-inline-pill="payment_type" title="Payment type"
                      class="text-[9px] font-bold uppercase tracking-wide ring-1 rounded cursor-pointer <%= ptCls %>"
                      style="appearance:none;-webkit-appearance:none;-moz-appearance:none;background-image:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%228%22 height=%228%22 fill=%22none%22 stroke=%22currentColor%22 stroke-width=%222%22 viewBox=%220 0 24 24%22><path d=%22M6 9l6 6 6-6%22/></svg>');background-repeat:no-repeat;background-position:right 4px center;padding:2px 14px 2px 6px;">
                      <option value=""    <%= ptVal === ''    ? 'selected' : '' %>>—</option>
                      <option value="cash" <%= ptVal === 'cash' ? 'selected' : '' %>>CASH</option>
                      <option value="tfn"  <%= ptVal === 'tfn'  ? 'selected' : '' %>>TFN</option>
                      <option value="abn"  <%= ptVal === 'abn'  ? 'selected' : '' %>>ABN</option>
                    </select>
                  </form>
                  <%
                    // Management payroll pill — only visible to admin/finance/accounts.
                    var mgmtOn = emp.on_management_payroll == 1;
                    var mgmtCls = mgmtOn ? 'bg-violet-50 text-violet-700 ring-violet-600/20' : 'bg-gray-50 text-gray-400 ring-gray-300/40';
                  %>
                  <% if (typeof canAccess === 'function' && canAccess(user, 'payroll')) { %>
                    <form method="POST" action="/hr/employees/<%= emp.id %>/management-payroll" class="inline">
                      <%- include('../partials/csrf') %>
                      <select name="on_management_payroll" data-inline-pill="on_management_payroll" title="Management payroll"
                        class="text-[9px] font-bold uppercase tracking-wide ring-1 rounded cursor-pointer <%= mgmtCls %>"
                        style="appearance:none;-webkit-appearance:none;-moz-appearance:none;background-image:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%228%22 height=%228%22 fill=%22none%22 stroke=%22currentColor%22 stroke-width=%222%22 viewBox=%220 0 24 24%22><path d=%22M6 9l6 6 6-6%22/></svg>');background-repeat:no-repeat;background-position:right 4px center;padding:2px 14px 2px 6px;">
                        <option value="0" <%= mgmtOn ? '' : 'selected' %>>MGMT —</option>
                        <option value="1" <%= mgmtOn ? 'selected' : '' %>>MGMT ON</option>
                      </select>
                    </form>
                  <% } %>
                </div>
              </td>
              <td class="px-3 sm:px-4 py-3 text-gray-500 text-xs hidden sm:table-cell">
                <% if (emp.phone) { %>
                  <a href="tel:<%= emp.phone %>" class="hover:text-brand-600"><%= emp.phone %></a>
                <% } else { %>-<% } %>
              </td>
              <td class="px-3 sm:px-4 py-3 text-gray-600 text-xs hidden md:table-cell"><%= emp.traffic_role_level || emp.role_title || '-' %></td>
              <td class="px-3 sm:px-4 py-3 text-gray-500 text-xs hidden md:table-cell capitalize"><%= emp.employment_type ? emp.employment_type.replace(/_/g, ' ') : '-' %></td>
              <td class="px-3 sm:px-4 py-3">
                <% if (locals.showDeleted) { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium capitalize <%= sBadges[emp.employment_status] || sBadges.inactive %>">
                    <%= (emp.employment_status || 'unknown').replace(/_/g, ' ') %>
                  </span>
                <% } else {
                  var es = emp.employment_status || 'active';
                  var esCls = sBadges[es] || sBadges.inactive;
                %>
                  <form method="POST" action="/hr/employees/<%= emp.id %>/employment-status" class="inline">
                    <%- include('../partials/csrf') %>
                    <select name="employment_status" data-inline-pill="employment_status" title="Employment status"
                      class="text-[10px] font-bold uppercase tracking-wide rounded-full cursor-pointer <%= esCls %>"
                      style="appearance:none;-webkit-appearance:none;-moz-appearance:none;background-image:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2210%22 height=%2210%22 fill=%22none%22 stroke=%22currentColor%22 stroke-width=%222%22 viewBox=%220 0 24 24%22><path d=%22M6 9l6 6 6-6%22/></svg>');background-repeat:no-repeat;background-position:right 6px center;padding:2px 20px 2px 8px;border:0;">
                      <option value="active"     <%= es === 'active' ? 'selected' : '' %>>Active</option>
                      <option value="reserved"   <%= es === 'reserved' ? 'selected' : '' %>>Reserved</option>
                      <option value="on_leave"   <%= es === 'on_leave' ? 'selected' : '' %>>On Leave</option>
                      <option value="inactive"   <%= (es === 'inactive' || es === 'deactivated') ? 'selected' : '' %>>Deactivated</option>
                      <option value="terminated" <%= (es === 'terminated' || es === 'offboarded') ? 'selected' : '' %>>Terminated</option>
                    </select>
                  </form>
                <% } %>
              </td>
              <td class="px-3 sm:px-4 py-3 hidden lg:table-cell">
                <% if (emp.readiness) { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium <%= rBadges[emp.readiness.status] || 'bg-gray-100 text-gray-500' %>">
                    <%= rLabels[emp.readiness.status] || emp.readiness.status %>
                  </span>
                <% } else { %>
                  <span class="text-gray-300 text-xs">-</span>
                <% } %>
              </td>
              <td class="px-3 sm:px-4 py-3 hidden md:table-cell">
                <% if (emp.inducted_at) { %>
                  <span class="inline-flex items-center gap-1 text-emerald-600 text-xs font-semibold" title="Inducted <%= new Date(emp.inducted_at).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney' }) %><%= emp.inducted_method ? ' · ' + emp.inducted_method.replace(/_/g,' ') : '' %>">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    Inducted
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 text-gray-400 text-xs" title="Not inducted yet">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    Not yet
                  </span>
                <% } %>
              </td>
              <td class="px-3 sm:px-4 py-3 hidden md:table-cell">
                <% if (!emp.linked_crew_member_id) { %>
                  <span class="text-gray-300 text-xs">—</span>
                <% } else if (emp.sopSigned) { %>
                  <span class="inline-flex items-center gap-1 text-emerald-600 text-xs font-semibold" title="Signed current SOP">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    Signed
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 text-amber-600 text-xs font-semibold" title="Not signed current SOP">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
                    Not signed
                  </span>
                <% } %>
              </td>
              <!-- Tier — inline portal_role picker so the office can promote
                   a worker to Team Leader / Supervisor without leaving the
                   roster. Disabled if there's no linked crew_member yet. -->
              <td class="px-3 sm:px-4 py-3 hidden lg:table-cell">
                <% if (emp.worker_id) {
                  var pr = emp.portal_role || 'traffic_controller';
                  var pillCls = pr === 'supervisor' ? 'bg-violet-50 text-violet-700 ring-violet-600/20'
                              : pr === 'team_leader' ? 'bg-amber-50 text-amber-700 ring-amber-600/20'
                              : 'bg-gray-100 text-gray-600 ring-gray-600/15';
                %>
                  <form method="POST" action="/hr/employees/<%= emp.id %>/portal-role" class="inline-flex items-center gap-1.5">
                    <%- include('../partials/csrf') %>
                    <select name="portal_role" data-inline-pill="portal_role"
                      class="text-[10px] font-bold uppercase tracking-wide px-2 py-1 rounded-full ring-1 cursor-pointer <%= pillCls %>"
                      style="appearance:none;-webkit-appearance:none;background-image:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2210%22 height=%2210%22 fill=%22none%22 stroke=%22currentColor%22 stroke-width=%222%22 viewBox=%220 0 24 24%22><path d=%22M6 9l6 6 6-6%22/></svg>');background-repeat:no-repeat;background-position:right 6px center;padding-right:20px;">
                      <option value="traffic_controller" <%= pr === 'traffic_controller' ? 'selected' : '' %>>TC</option>
                      <option value="team_leader"        <%= pr === 'team_leader'        ? 'selected' : '' %>>Team Leader</option>
                      <option value="supervisor"         <%= pr === 'supervisor'         ? 'selected' : '' %>>Supervisor</option>
                    </select>
                  </form>
                <% } else { %>
                  <span class="text-[10px] text-gray-300">—</span>
                <% } %>
              </td>
              <td class="px-3 sm:px-4 py-3 hidden xl:table-cell">
                <% if (emp.worker_id) { %>
                  <div class="text-xs">
                    <span class="font-mono text-gray-600"><%= emp.worker_id %></span>
                    <% if (emp.worker_pin) { %>
                      <span class="font-mono text-gray-400 ml-1" data-pin="<%= emp.worker_pin %>" style="cursor:pointer;" onclick="this.textContent = this.dataset.pin; this.classList.replace('text-gray-400','text-brand-600');" title="Click to reveal PIN">****</span>
                    <% } else if (emp.has_pin) { %>
                      <span class="text-[9px] text-amber-500 ml-1">PIN set (reset to view)</span>
                    <% } else { %>
                      <span class="text-gray-300 ml-1">No PIN</span>
                    <% } %>
                  </div>
                <% } else { %>
                  <span class="text-gray-300 text-xs">—</span>
                <% } %>
              </td>
              <% if (locals.showDeleted) { %>
                <td class="px-3 sm:px-4 py-3 text-gray-500 text-xs tabular-nums hidden xl:table-cell"><%= fmtDate(emp.deleted_at) %></td>
              <% } else { %>
                <td class="px-3 sm:px-4 py-3 text-gray-500 text-xs tabular-nums hidden xl:table-cell"><%= fmtDate(emp.start_date) %></td>
              <% } %>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="px-4 py-3 border-t border-gray-200 text-xs text-gray-500">
        Showing <%= employees.length %> employee<%= employees.length !== 1 ? 's' : '' %>
      </div>
    </div>
  </form>

  <% } else { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-10 text-center">
    <div class="w-14 h-14 bg-brand-50 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    </div>
    <h3 class="text-gray-900 font-semibold text-base mb-1">No employees found</h3>
    <p class="text-gray-500 text-sm mb-4">Try adjusting your filters or add a new employee.</p>
    <a href="/hr/employees/new" class="inline-flex items-center gap-1.5 px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
      Add Employee
    </a>
  </div>
  <% } %>
</div>

<!-- Action modal (Delete or Restore) -->
<% if (locals.showDeleted) { %>
<div id="rosterModal" style="display:none" class="fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="rosterModalBg"></div>
  <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 space-y-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-gray-900">Restore Employees</h3>
        <p class="text-sm text-gray-500">Restore <span id="rosterModalN" class="font-semibold text-emerald-600">0</span> employee(s) and reactivate their login.</p>
      </div>
    </div>
    <div class="flex gap-3 pt-2">
      <button type="button" id="rosterModalCancel" class="flex-1 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition">Cancel</button>
      <button type="button" id="rosterModalConfirm" class="flex-1 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium rounded-lg transition">Restore</button>
    </div>
  </div>
</div>
<% } else { %>
<div id="rosterModal" style="display:none" class="fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="rosterModalBg"></div>
  <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 space-y-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-gray-900">Move to Deleted</h3>
        <p class="text-sm text-gray-500">Move <span id="rosterModalN" class="font-semibold text-red-600">0</span> employee(s) to the Deleted tab. Their login will be deactivated. You can restore them later.</p>
      </div>
    </div>
    <div class="flex gap-3 pt-2">
      <button type="button" id="rosterModalCancel" class="flex-1 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition">Cancel</button>
      <button type="button" id="rosterModalConfirm" class="flex-1 px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg transition">Move to Deleted</button>
    </div>
  </div>
</div>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var allBox    = document.getElementById('rosterAll');
  var checks    = function() { return document.querySelectorAll('.roster-chk'); };
  var checked   = function() { return document.querySelectorAll('.roster-chk:checked'); };
  var bar       = document.getElementById('rosterBulk');
  var countEl   = document.getElementById('rosterBulkCount');
  var delBtn    = document.getElementById('rosterDeleteBtn');
  var mergeBtn  = document.getElementById('rosterMergeBtn');
  var modal     = document.getElementById('rosterModal');
  var modalN    = document.getElementById('rosterModalN');
  var modalBg   = document.getElementById('rosterModalBg');
  var modalNo   = document.getElementById('rosterModalCancel');
  var modalYes  = document.getElementById('rosterModalConfirm');
  var form      = document.getElementById('rosterDeleteForm');

  function refresh() {
    var c = checked().length;
    var a = checks().length;
    if (bar) bar.style.display = c > 0 ? 'flex' : 'none';
    if (countEl) countEl.textContent = c + ' selected';
    if (allBox) {
      allBox.checked = a > 0 && c === a;
      allBox.indeterminate = c > 0 && c < a;
    }
    if (mergeBtn) {
      mergeBtn.disabled = c !== 2;
      mergeBtn.textContent = c === 2 ? 'Merge these 2' : 'Merge 2';
    }
  }

  if (mergeBtn) {
    mergeBtn.addEventListener('click', function() {
      var ids = Array.from(checked()).map(function(cb) { return cb.value; });
      if (ids.length !== 2) return;
      window.location.href = '/hr/merge?a=' + encodeURIComponent(ids[0]) + '&b=' + encodeURIComponent(ids[1]);
    });
  }

  if (allBox) {
    allBox.addEventListener('change', function() {
      var val = allBox.checked;
      checks().forEach(function(cb) { cb.checked = val; });
      refresh();
    });
  }

  document.addEventListener('change', function(e) {
    if (e.target && e.target.classList.contains('roster-chk')) refresh();
  });

  if (delBtn) {
    delBtn.addEventListener('click', function() {
      var n = checked().length;
      if (n === 0) return;
      if (modalN) modalN.textContent = n;
      if (modal) modal.style.display = 'flex';
    });
  }

  if (modalBg) modalBg.addEventListener('click', function() { modal.style.display = 'none'; });
  if (modalNo) modalNo.addEventListener('click', function() { modal.style.display = 'none'; });
  if (modalYes) modalYes.addEventListener('click', function() { if (form) form.submit(); });

  // Bulk status change
  var bulkStatusForm   = document.getElementById('rosterBulkStatusForm');
  var bulkStatusSelect = document.getElementById('rosterBulkStatusSelect');
  var bulkStatusBtn    = document.getElementById('rosterBulkStatusBtn');
  var bulkStatusIds    = document.getElementById('rosterBulkStatusIds');
  if (bulkStatusSelect) {
    bulkStatusSelect.addEventListener('change', function() {
      bulkStatusBtn.disabled = !bulkStatusSelect.value || checked().length === 0;
    });
  }
  // Keep Apply button gated on selection count too
  document.addEventListener('change', function(e) {
    if (e.target && e.target.classList.contains('roster-chk') && bulkStatusBtn) {
      bulkStatusBtn.disabled = !bulkStatusSelect.value || checked().length === 0;
    }
  });
  if (bulkStatusForm) {
    bulkStatusForm.addEventListener('submit', function(e) {
      var ids = Array.from(checked()).map(function(cb) { return cb.value; });
      if (!ids.length || !bulkStatusSelect.value) { e.preventDefault(); return; }
      bulkStatusIds.value = ids.join(',');
    });
  }
});

// Inline pill selects (payment-type, portal-role). Submit via fetch so
// the page never reloads — keeps the user's scroll position and stops
// the portal-role redirect from yanking them onto the employee detail
// page when they tweak a row's tier from the roster.
(function() {
  // Tailwind colour tokens to swap in after a successful save, keyed
  // by select name + value. Keep these in sync with the static EJS
  // mappings above so the live update mirrors a fresh page render.
  var COLOR_MAPS = {
    payment_type: {
      '':     'bg-gray-50 text-gray-400 ring-gray-300/40',
      cash:   'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
      tfn:    'bg-blue-50 text-blue-700 ring-blue-600/20',
      abn:    'bg-purple-50 text-purple-700 ring-purple-600/20',
    },
    portal_role: {
      traffic_controller: 'bg-gray-100 text-gray-600 ring-gray-600/15',
      team_leader:        'bg-amber-50 text-amber-700 ring-amber-600/20',
      supervisor:         'bg-violet-50 text-violet-700 ring-violet-600/20',
    },
    on_management_payroll: {
      '0': 'bg-gray-50 text-gray-400 ring-gray-300/40',
      '1': 'bg-violet-50 text-violet-700 ring-violet-600/20',
    },
    employment_status: {
      active:      'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
      reserved:    'bg-blue-50 text-blue-700 ring-blue-600/20',
      on_leave:    'bg-blue-50 text-blue-700 ring-blue-600/20',
      inactive:    'bg-gray-100 text-gray-500 ring-gray-300/40',
      deactivated: 'bg-gray-100 text-gray-500 ring-gray-300/40',
      terminated:  'bg-red-50 text-red-700 ring-red-600/20',
      offboarded:  'bg-gray-100 text-gray-500 ring-gray-300/40',
    },
  };
  function swapColors(sel) {
    var map = COLOR_MAPS[sel.dataset.inlinePill] || {};
    var newCls = map[sel.value] || '';
    // Strip every bg-/text-/ring- class then add the new ones — the
    // static layout classes (font-bold, rounded, px-2…) survive.
    var keep = sel.className.split(/\s+/).filter(function(c) {
      return c && !/^(bg|text|ring)-/.test(c);
    });
    sel.className = keep.concat(newCls.split(/\s+/)).join(' ');
  }
  document.addEventListener('change', function(e) {
    var sel = e.target;
    if (!sel || !sel.matches || !sel.matches('select[data-inline-pill]')) return;
    var form = sel.closest('form');
    if (!form) return;
    // urlencoded so Express's body parser sees the fields. FormData
    // would send multipart and the route doesn't have multer.
    var params = new URLSearchParams();
    new FormData(form).forEach(function(v, k) { params.append(k, v); });
    var prev = sel.dataset.previousValue || '';
    sel.dataset.previousValue = sel.value;
    sel.disabled = true;
    fetch(form.action, {
      method: 'POST', body: params, credentials: 'same-origin',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
      },
    }).then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    }).then(function() {
      swapColors(sel);
      // Brief flash so the user sees confirmation
      sel.style.transition = 'box-shadow 0.4s';
      sel.style.boxShadow = '0 0 0 3px rgba(16,185,129,0.35)';
      setTimeout(function() { sel.style.boxShadow = ''; }, 600);
    }).catch(function() {
      sel.value = prev;
      alert('Failed to save — please try again.');
    }).finally(function() {
      sel.disabled = false;
    });
  });
})();
</script>
