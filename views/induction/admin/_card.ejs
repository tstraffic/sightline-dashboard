<%
  // One pipeline card. Expects: a (applicant + derived flags), stageChip(),
  // cardDate(), fmtShort(). Draggable; carries all the data the drag/move
  // logic needs in data-* attributes so no extra round-trip is required.
  const _cd = cardDate(a);
  const _fwdIdx = (typeof forwardStages !== 'undefined' ? forwardStages : ['NEW','CALLED','INTERESTED','BOOKED','INDUCTED','HIRED']).indexOf((a.stage||'').toUpperCase());
  const _noteLine = (a.notes || '').split(/\r?\n/)[0];
%>
<article class="rec-card" draggable="true"
         id="card-<%= a.id %>"
         data-id="<%= a.id %>"
         data-stage="<%= (a.stage||'NEW').toUpperCase() %>"
         data-fwd-index="<%= _fwdIdx %>"
         data-name="<%= a.applicant_name %>"
         data-phone="<%= a.phone || '' %>"
         data-date-applied="<%= a.date_applied || '' %>"
         data-date-called="<%= a.date_called || '' %>"
         data-induction-date="<%= a.induction_date || '' %>"
         data-induction-time="<%= a.induction_time || '' %>">
  <div class="rec-card-top">
    <p class="rec-card-name"><%= a.applicant_name %></p>
    <span class="rec-card-actions">
      <% if (a.induction_date) { %>
      <button type="button" class="rec-card-resend" data-id="<%= a.id %>" title="Re-send induction confirmation email" aria-label="Re-send induction confirmation">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </button>
      <% } %>
      <button type="button" class="rec-card-edit" data-id="<%= a.id %>" title="Edit / move" aria-label="Edit">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
      </button>
    </span>
  </div>

  <% if (a.phone) { %>
    <p class="rec-card-phone">
      <a href="tel:<%= a.phone %>"><%= a.phone %></a>
      <button type="button" data-copy-text="<%= a.phone %>" class="copy-btn rec-card-copy" title="Copy phone" aria-label="Copy phone">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
      </button>
    </p>
  <% } %>

  <div class="rec-card-meta">
    <% if (_cd) { %>
      <span class="rec-card-date"><span class="rec-card-date-label"><%= _cd.label %></span> <%= _cd.value %></span>
    <% } %>
    <% if (a.needsScheduling) { %>
      <span class="rec-badge rec-badge--warn">Not scheduled</span>
    <% } else if (a.isOnCalendar) { %>
      <span class="rec-badge rec-badge--ok">On calendar</span>
    <% } %>
    <% if (a.induction_email_sent_at) { %>
      <span class="rec-badge rec-badge--mail" title="Confirmation email sent <%= a.induction_email_sent_at %>">Emailed</span>
    <% } %>
  </div>

  <% if (_noteLine) { %>
    <p class="rec-card-note"><%= _noteLine %></p>
  <% } %>
</article>
