<% locals.currentPage = 'induction' %>
<%
  const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const monthLabel = monthNames[month - 1] + ' ' + year;

  // Stage → pill palette. -100 bg + -700 text get the dashboard's dark-glass
  // auto-overrides, so these read cleanly in both themes.
  function stageChip(stage) {
    switch ((stage || '').toUpperCase()) {
      case 'HIRED':      return 'bg-emerald-100 text-emerald-700';
      case 'INDUCTED':   return 'bg-blue-100 text-blue-700';
      case 'BOOKED':     return 'bg-amber-100 text-amber-700';
      case 'INTERESTED': return 'bg-violet-100 text-violet-700';
      case 'CALLED':     return 'bg-teal-100 text-teal-700';
      case 'NO_SHOW':    return 'bg-red-100 text-red-700';
      case 'DECLINED':   return 'bg-gray-200 text-gray-600';
      default:           return 'bg-gray-100 text-gray-700'; // NEW
    }
  }
  // Column header accent dot.
  function stageDot(stage) {
    switch ((stage || '').toUpperCase()) {
      case 'HIRED':      return 'bg-emerald-500';
      case 'INDUCTED':   return 'bg-blue-500';
      case 'BOOKED':     return 'bg-amber-500';
      case 'INTERESTED': return 'bg-violet-500';
      case 'CALLED':     return 'bg-teal-500';
      default:           return 'bg-gray-400';
    }
  }

  function bandCard(band) {
    if (band === 'on')   return 'bg-emerald-50 ring-emerald-200 text-emerald-700';
    if (band === 'over') return 'bg-red-50 ring-red-200 text-red-700';
    return                       'bg-amber-50 ring-amber-200 text-amber-700';
  }
  function bandDot(band) {
    if (band === 'on')   return 'bg-emerald-500';
    if (band === 'over') return 'bg-red-500';
    return                       'bg-amber-500';
  }
  function bandLabel(band) {
    if (band === 'on')   return 'On target';
    if (band === 'over') return 'Over';
    return                       'Under';
  }

  function fmtShort(isoDate) {
    if (!isoDate) return '';
    return new Date(isoDate + 'T00:00:00Z').toLocaleDateString('en-AU', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  }
  function fmtTime(t) {
    if (!t) return '';
    const m = String(t).match(/^(\d{1,2}):(\d{2})/);
    if (!m) return '';
    let h = parseInt(m[1], 10); const min = m[2];
    const ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12; if (h === 0) h = 12;
    return h + ':' + min + ' ' + ampm;
  }

  // forward index for "at or beyond" client filtering.
  const FWD = forwardStages; // ['NEW',...,'HIRED']
  function fwdIndex(stage) {
    const i = FWD.indexOf((stage || '').toUpperCase());
    return i; // terminal → -1
  }

  // Summary cards double as filters. `filter` = the stage a card filters to
  // (everyone at that stage or beyond); null = no filter (Applicants = all).
  const summaryCards = [
    { k:'total',      label:'Applicants', filter:null,         icon:'users',     accent:'text-gray-700',    chip:'bg-gray-100 text-gray-700' },
    { k:'called',     label:'Called',     filter:'CALLED',     icon:'phone',     accent:'text-teal-700',    chip:'bg-teal-100 text-teal-700' },
    { k:'interested', label:'Interested', filter:'INTERESTED', icon:'thumb',     accent:'text-violet-700',  chip:'bg-violet-100 text-violet-700' },
    { k:'booked',     label:'Booked',     filter:'BOOKED',     icon:'calendar',  accent:'text-amber-700',   chip:'bg-amber-100 text-amber-700' },
    { k:'hired',      label:'Hired',      filter:'HIRED',      icon:'check',     accent:'text-emerald-700', chip:'bg-emerald-100 text-emerald-700' },
  ];

  // Per-stage "one relevant date" for the compact card.
  function cardDate(a) {
    const s = (a.stage || '').toUpperCase();
    if (s === 'NEW')                              return a.date_applied ? { label:'Applied', value: fmtShort(a.date_applied) } : null;
    if (s === 'CALLED' || s === 'INTERESTED')     return a.date_called  ? { label:'Called',  value: fmtShort(a.date_called) }  : null;
    if (s === 'BOOKED' || s === 'INDUCTED') {
      if (!a.induction_date) return null;
      const t = fmtTime(a.induction_time);
      return { label:'Induction', value: fmtShort(a.induction_date) + (t ? ' · ' + t : '') };
    }
    if (s === 'HIRED')                            return a.induction_date ? { label:'Inducted', value: fmtShort(a.induction_date) } : null;
    // terminal: show induction date for the record if present
    return a.induction_date ? { label:'Was booked', value: fmtShort(a.induction_date) } : null;
  }
%>

<div class="space-y-5" id="rec-root">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Recruitment</h1>
      <p class="text-sm text-gray-500 mt-1">Hiring pipeline · scoped to applicants who applied in <%= monthLabel %> · call target <%= targetMin %>–<%= targetMax %>/week</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <!-- Board / List toggle -->
      <div class="inline-flex rounded-lg border border-gray-300 bg-white p-0.5" role="tablist">
        <button type="button" id="view-board-btn" class="rec-viewbtn is-active" data-view="board">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 5h4v14H4zM10 5h4v14h-4zM16 5h4v9h-4z"/></svg>
          Board
        </button>
        <button type="button" id="view-list-btn" class="rec-viewbtn" data-view="list">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          List
        </button>
      </div>
      <form method="GET" action="/induction/admin/recruitment" class="flex items-center gap-2">
        <select name="year" onchange="this.form.submit()"
          class="border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <% for (let y = year - 2; y <= year + 1; y++) { %>
            <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
          <% } %>
        </select>
        <select name="month" onchange="this.form.submit()"
          class="border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
          <% for (let m = 1; m <= 12; m++) { %>
            <option value="<%= m %>" <%= m === month ? 'selected' : '' %>><%= monthNames[m - 1] %></option>
          <% } %>
        </select>
      </form>
      <a href="/induction/admin/recruitment/export.csv?year=<%= year %>&month=<%= month %>"
         class="inline-flex items-center gap-1.5 px-3 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-lg border border-emerald-200 transition">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V4"/></svg>
        Export CSV
      </a>
      <button type="button" onclick="document.getElementById('add-applicant-row').classList.toggle('hidden')"
         class="inline-flex items-center gap-1.5 px-3 py-2 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded-lg transition shadow-sm">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Add applicant
      </button>
    </div>
  </div>

  <%- include('_registry-tabs', { tabActive: 'recruitment' }) %>

  <!-- Add-applicant inline form -->
  <div id="add-applicant-row" class="hidden rec-form-panel p-4">
    <form method="POST" action="/induction/admin/recruitment?year=<%= year %>&month=<%= month %>" class="grid grid-cols-1 sm:grid-cols-4 gap-3 items-end">
      <%- include('../../partials/csrf') %>
      <div class="sm:col-span-2">
        <label class="rec-flabel">Name <span class="text-red-500">*</span></label>
        <input type="text" name="applicant_name" required placeholder="Full name" class="rec-input" />
      </div>
      <div>
        <label class="rec-flabel">Phone</label>
        <input type="text" name="phone" placeholder="04xx xxx xxx" class="rec-input" />
      </div>
      <div>
        <label class="rec-flabel">Email</label>
        <input type="email" name="email" placeholder="name@example.com" class="rec-input" />
      </div>
      <div>
        <label class="rec-flabel">Date Applied</label>
        <input type="date" name="date_applied" value="<%= today %>" class="rec-input" />
      </div>
      <div class="sm:col-span-3">
        <label class="rec-flabel">Notes</label>
        <input type="text" name="notes" placeholder="Any context (tickets, availability, etc.)" class="rec-input" />
      </div>
      <div class="sm:col-span-4 flex items-center gap-2 justify-end pt-1">
        <button type="button" onclick="document.getElementById('add-applicant-row').classList.add('hidden')"
          class="rec-btn rec-btn--ghost" style="border:1px solid var(--rec-input-border)">Cancel</button>
        <button type="submit" class="rec-btn rec-btn--primary">Save applicant</button>
      </div>
    </form>
  </div>

  <!-- Summary cards (clickable filters) -->
  <div>
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-sm font-bold text-gray-700 uppercase tracking-widest"><%= monthLabel %> · Summary</h2>
      <span class="text-[11px] text-gray-500">Tap a card to filter the pipeline · <button type="button" id="clear-filter" class="text-brand-600 font-semibold hidden">Clear filter</button></span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      <% summaryCards.forEach(s => { %>
        <button type="button" class="rec-summary text-left bg-white border border-gray-200 rounded-xl shadow-sm px-4 py-3.5 flex items-center gap-3 transition hover:border-brand-300 hover:shadow"
                data-filter="<%= s.filter || '' %>">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 <%= s.chip %>">
            <% if (s.icon === 'users') { %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <% } else if (s.icon === 'phone') { %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <% } else if (s.icon === 'thumb') { %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg>
            <% } else if (s.icon === 'calendar') { %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <% } else { %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <% } %>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] font-bold text-gray-500 uppercase tracking-widest"><%= s.label %><span class="rec-summary-active">active</span></p>
            <p class="text-2xl font-bold tabular-nums <%= s.accent %>"><%= stats[s.k] %></p>
          </div>
        </button>
      <% }) %>
    </div>
  </div>

  <!-- Weekly calls -->
  <div>
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-sm font-bold text-gray-700 uppercase tracking-widest">Weekly Calls</h2>
      <span class="text-[11px] text-gray-500">Target <%= targetMin %>–<%= targetMax %>/week · <span class="text-emerald-600 font-semibold">on</span> · <span class="text-amber-600 font-semibold">under</span> · <span class="text-red-600 font-semibold">over</span></span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-<%= weeks.length %> gap-3">
      <% weeks.forEach(w => { %>
        <div class="rounded-xl ring-1 p-3.5 <%= bandCard(w.band) %>">
          <div class="flex items-center justify-between mb-1">
            <p class="text-[10px] font-bold uppercase tracking-widest"><%= w.label %></p>
            <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider">
              <span class="w-1.5 h-1.5 rounded-full <%= bandDot(w.band) %>"></span>
              <%= bandLabel(w.band) %>
            </span>
          </div>
          <p class="text-[11px] text-gray-500"><%= w.range %></p>
          <p class="text-3xl font-bold tabular-nums mt-1"><%= w.count %></p>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- ================= BOARD VIEW ================= -->
  <div id="view-board">
    <% if (applicants.length === 0) { %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-12 text-center">
        <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-3">
          <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <p class="text-sm font-semibold text-gray-700">No applicants applied in <%= monthLabel %> yet</p>
        <p class="text-xs text-gray-500 mt-1">Hit <strong>Add applicant</strong> above to start the pipeline.</p>
      </div>
    <% } else { %>
      <div class="rec-board" id="rec-board">
        <% forwardStages.forEach(function (st) {
             const cards = byStage[st] || [];
        %>
          <section class="rec-col" data-col-stage="<%= st %>">
            <div class="rec-col-head">
              <span class="inline-flex items-center gap-2">
                <span class="rec-col-dot"></span>
                <%= stageLabels[st] %>
              </span>
              <span class="rec-col-count" data-count-for="<%= st %>"><%= cards.length %></span>
            </div>
            <div class="rec-col-body" data-drop-stage="<%= st %>">
              <% cards.forEach(function (a) { %>
                <%- include('_card', { a, stageChip, cardDate, fmtShort }) %>
              <% }) %>
              <div class="rec-col-empty" data-empty>Nothing here</div>
            </div>
          </section>
        <% }); %>

        <!-- Closed column (collapsed NO_SHOW + DECLINED), expandable -->
        <section class="rec-col rec-col--closed" data-col-stage="CLOSED">
          <button type="button" class="rec-col-head rec-col-head--btn" id="closed-toggle" aria-expanded="false">
            <span class="inline-flex items-center gap-2">
              <svg class="w-3.5 h-3.5 transition-transform" id="closed-caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              Closed
            </span>
            <span class="rec-col-count" data-count-for="CLOSED"><%= closed.length %></span>
          </button>
          <div class="rec-col-body rec-col-body--closed hidden" data-drop-stage="CLOSED" id="closed-body">
            <% closed.forEach(function (a) { %>
              <%- include('_card', { a, stageChip, cardDate, fmtShort }) %>
            <% }) %>
            <div class="rec-col-empty" data-empty>No closed candidates</div>
          </div>
        </section>
      </div>
    <% } %>
  </div>

  <!-- ================= LIST VIEW ================= -->
  <div id="view-list" class="hidden">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200 flex items-center justify-between gap-3 flex-wrap">
        <div>
          <h2 class="text-sm font-bold text-gray-800"><%= monthLabel %> · Applicants</h2>
          <p class="text-[11px] text-gray-500 mt-0.5">Change the Stage dropdown to move a candidate. Use Edit for name / phone / email / dates / notes.</p>
        </div>
        <label class="inline-flex items-center gap-2 text-xs text-gray-600">
          <input type="checkbox" id="show-closed-rows" class="rounded border-gray-300">
          Show closed
        </label>
      </div>
      <% if (applicants.length === 0) { %>
        <div class="p-10 text-center text-sm text-gray-500">No applicants for <%= monthLabel %>.</div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-[10px] font-bold uppercase tracking-widest text-gray-500">
              <tr>
                <th class="text-left px-3 py-2.5 w-8">#</th>
                <th class="text-left px-3 py-2.5">Name</th>
                <th class="text-left px-3 py-2.5">Phone</th>
                <th class="text-left px-3 py-2.5">Applied</th>
                <th class="text-left px-3 py-2.5">Called</th>
                <th class="text-left px-3 py-2.5">Induction (date · time)</th>
                <th class="text-left px-3 py-2.5">Stage</th>
                <th class="text-left px-3 py-2.5 min-w-[160px]">Notes</th>
                <th class="text-right px-3 py-2.5"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% applicants.forEach(function (a, i) {
                   const terminal = terminalStages.indexOf((a.stage||'').toUpperCase()) !== -1;
              %>
                <tr id="lrow-<%= a.id %>" class="rec-lrow hover:bg-gray-50/60 align-middle <%= terminal ? 'rec-lrow--closed hidden' : '' %>"
                    data-id="<%= a.id %>">
                  <td class="px-3 py-2.5 text-gray-400 tabular-nums"><%= i + 1 %></td>
                  <td class="px-3 py-2.5">
                    <p class="font-semibold text-gray-900 leading-tight"><%= a.applicant_name %></p>
                    <% if (a.email) { %><p class="text-[11px] text-gray-500 leading-tight"><%= a.email %></p><% } %>
                    <% if (a.needsScheduling) { %>
                      <span class="rec-badge rec-badge--warn mt-1">Not scheduled</span>
                    <% } else if (a.isOnCalendar) { %>
                      <span class="rec-badge rec-badge--ok mt-1">On calendar</span>
                    <% } %>
                    <% if (a.induction_email_sent_at) { %>
                      <span class="rec-badge rec-badge--mail mt-1" title="Confirmation email sent <%= a.induction_email_sent_at %>">Emailed</span>
                    <% } %>
                  </td>
                  <td class="px-3 py-2.5 text-gray-700 whitespace-nowrap tabular-nums">
                    <% if (a.phone) { %>
                      <span class="inline-flex items-center gap-1">
                        <span><%= a.phone %></span>
                        <button type="button" data-copy-text="<%= a.phone %>"
                                class="copy-btn inline-flex items-center justify-center w-6 h-6 rounded text-gray-400 hover:text-brand-700 hover:bg-brand-50 transition"
                                title="Copy phone number" aria-label="Copy phone number">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                        </button>
                      </span>
                    <% } else { %>—<% } %>
                  </td>
                  <td class="px-3 py-2.5 text-gray-600 whitespace-nowrap"><%= fmtShort(a.date_applied) || '—' %></td>
                  <td class="px-3 py-2.5 text-gray-600 whitespace-nowrap"><%= fmtShort(a.date_called) || '—' %></td>
                  <td class="px-3 py-2.5 text-gray-600 whitespace-nowrap">
                    <% if (a.induction_date) { %><%= fmtShort(a.induction_date) %><% if (a.induction_time) { %> · <%= fmtTime(a.induction_time) %><% } %><% } else { %>—<% } %>
                  </td>
                  <td class="px-3 py-2.5">
                    <select class="rec-stage-select status-pill rounded-full px-2.5 py-1 text-[11px] border-0 focus:ring-2 focus:ring-brand-300 <%= stageChip(a.stage) %>"
                            data-id="<%= a.id %>">
                      <% forwardStages.concat(terminalStages).forEach(function (st) { %>
                        <option value="<%= st %>" <%= (a.stage||'').toUpperCase() === st ? 'selected' : '' %>><%= stageLabels[st] %></option>
                      <% }) %>
                    </select>
                  </td>
                  <td class="px-3 py-2.5 text-gray-700"><p class="line-clamp-2 text-xs leading-snug"><%= a.notes || '—' %></p></td>
                  <td class="px-3 py-2.5 text-right whitespace-nowrap">
                    <button type="button" class="rec-edit-btn px-2 py-1 text-[11px] font-semibold text-brand-600 hover:bg-brand-50 rounded" data-id="<%= a.id %>">Edit</button>
                    <% if (a.induction_date) { %>
                      <button type="button" class="rec-resend-btn px-2 py-1 text-[11px] font-semibold text-blue-600 hover:bg-blue-50 rounded" data-id="<%= a.id %>" title="Re-send induction confirmation email">Resend</button>
                    <% } %>
                    <form method="POST" action="/induction/admin/recruitment/<%= a.id %>/delete?year=<%= year %>&month=<%= month %>" class="inline" onsubmit="return confirm('Remove this applicant?')">
                      <%- include('../../partials/csrf') %>
                      <button type="submit" class="px-2 py-1 text-[11px] font-semibold text-red-600 hover:bg-red-50 rounded">Delete</button>
                    </form>
                  </td>
                </tr>
                <tr id="ledit-<%= a.id %>" class="hidden bg-brand-50/40">
                  <td colspan="9" class="px-4 py-3">
                    <form method="POST" action="/induction/admin/recruitment/<%= a.id %>?year=<%= year %>&month=<%= month %>" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                      <%- include('../../partials/csrf') %>
                      <div>
                        <label class="rec-flabel">Name</label>
                        <input type="text" name="applicant_name" value="<%= a.applicant_name %>" required
                          class="rec-input" />
                      </div>
                      <div>
                        <label class="rec-flabel">Phone</label>
                        <input type="text" name="phone" value="<%= a.phone || '' %>"
                          class="rec-input" />
                      </div>
                      <div class="sm:col-span-2">
                        <label class="rec-flabel">Email</label>
                        <input type="email" name="email" value="<%= a.email || '' %>"
                          class="rec-input" />
                      </div>
                      <div>
                        <label class="rec-flabel">Date Applied</label>
                        <input type="date" name="date_applied" value="<%= a.date_applied || '' %>"
                          class="rec-input" />
                      </div>
                      <div>
                        <label class="rec-flabel">Date Called</label>
                        <input type="date" name="date_called" value="<%= a.date_called || '' %>"
                          class="rec-input" />
                      </div>
                      <div>
                        <label class="rec-flabel">Induction Date</label>
                        <input type="date" name="induction_date" value="<%= a.induction_date || '' %>"
                          class="rec-input" />
                      </div>
                      <div>
                        <label class="rec-flabel">Induction Time</label>
                        <input type="time" name="induction_time" value="<%= a.induction_time || '' %>"
                          class="rec-input" />
                      </div>
                      <div class="sm:col-span-4">
                        <label class="rec-flabel">Notes</label>
                        <textarea name="notes" rows="2"
                          class="rec-input"><%= a.notes || '' %></textarea>
                      </div>
                      <div class="sm:col-span-4 flex items-center gap-2 justify-end pt-1">
                        <button type="button" class="rec-edit-cancel px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-medium rounded-lg" data-id="<%= a.id %>">Cancel</button>
                        <button type="submit" class="px-4 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold rounded-lg shadow-sm">Save</button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

<!-- Booking modal: prompts for induction date + time when moving to Booked. -->
<div id="booking-modal" class="rec-modal hidden">
  <div class="rec-modal-backdrop" data-modal-close></div>
  <div class="rec-modal-card">
    <h3 class="rec-modal-title">Book induction</h3>
    <p class="rec-modal-sub" id="booking-modal-sub">A candidate can't be booked without an induction date.</p>
    <div class="grid grid-cols-2 gap-3 mt-3">
      <div>
        <label class="rec-flabel">Induction date <span class="text-red-500">*</span></label>
        <input type="date" id="booking-date" class="rec-input">
      </div>
      <div>
        <label class="rec-flabel">Time</label>
        <input type="time" id="booking-time" class="rec-input">
      </div>
    </div>
    <p id="booking-error" class="text-[11px] text-red-600 mt-2 hidden">Please pick an induction date.</p>
    <div class="flex items-center justify-end gap-2 mt-4">
      <button type="button" class="rec-btn rec-btn--ghost" data-modal-close>Cancel</button>
      <button type="button" id="booking-confirm" class="rec-btn rec-btn--primary">Confirm booking</button>
    </div>
  </div>
</div>

<!-- Closed-reason modal: pick NO_SHOW vs DECLINED when dropping into Closed. -->
<div id="closed-modal" class="rec-modal hidden">
  <div class="rec-modal-backdrop" data-modal-close></div>
  <div class="rec-modal-card">
    <h3 class="rec-modal-title">Close candidate</h3>
    <p class="rec-modal-sub">Why are they leaving the pipeline?</p>
    <div class="flex flex-col gap-2 mt-3">
      <button type="button" class="rec-btn rec-btn--outline" data-closed-reason="DECLINED">Declined / Not suitable</button>
      <button type="button" class="rec-btn rec-btn--outline" data-closed-reason="NO_SHOW">No Show</button>
    </div>
    <div class="flex items-center justify-end mt-4">
      <button type="button" class="rec-btn rec-btn--ghost" data-modal-close>Cancel</button>
    </div>
  </div>
</div>

<!-- Backward-move modal: keep or drop the induction date. -->
<div id="backward-modal" class="rec-modal hidden">
  <div class="rec-modal-backdrop" data-modal-close></div>
  <div class="rec-modal-card">
    <h3 class="rec-modal-title">Move back before Booked</h3>
    <p class="rec-modal-sub" id="backward-sub">This candidate has an induction date. Keep it or remove it from the calendar?</p>
    <div class="flex flex-col gap-2 mt-3">
      <button type="button" class="rec-btn rec-btn--outline" id="backward-remove">Remove induction date (recommended)</button>
      <button type="button" class="rec-btn rec-btn--outline" id="backward-keep">Keep the date</button>
    </div>
    <div class="flex items-center justify-end mt-4">
      <button type="button" class="rec-btn rec-btn--ghost" data-modal-close>Cancel</button>
    </div>
  </div>
</div>

<!-- Toast (transient "Saved"). -->
<div id="rec-toast" class="rec-toast" hidden></div>

</div><!-- /#rec-root -->

<%- include('_recruitment-styles') %>
<%- include('_recruitment-script', {
      year, month,
      forwardStages, terminalStages, stageLabels,
}) %>

<!-- Click-to-copy buttons next to phone numbers. -->
<script src="/js/copy-btn.js?v=1"></script>
