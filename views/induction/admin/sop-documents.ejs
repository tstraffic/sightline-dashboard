<% locals.currentPage = 'induction-presentations' %>
<%
  function fmtSize(bytes) {
    if (!bytes) return '—';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024*1024) return (bytes/1024).toFixed(0) + ' KB';
    return (bytes/(1024*1024)).toFixed(1) + ' MB';
  }
  function fmtDate(s) {
    if (!s) return '—';
    return new Date(s.replace(' ', 'T') + 'Z').toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day:'numeric', month:'short', year:'numeric' });
  }
  function iconFor(mime, name) {
    const n = (name || '').toLowerCase();
    if ((mime || '').includes('pdf') || n.endsWith('.pdf')) return 'pdf';
    if (/\.(png|jpe?g|webp|gif)$/i.test(n)) return 'img';
    if (/\.docx?$/i.test(n)) return 'doc';
    if (/\.xlsx?$/i.test(n)) return 'xls';
    return 'file';
  }
%>

<div class="p-4 md:p-6 max-w-5xl mx-auto">
  <!-- Header -->
  <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">SOP / SWMS Sections</h1>
      <p class="text-gray-500 text-sm mt-1">Each section below becomes a step in the worker acknowledgement. Add a title, optional description, and one or more PDFs — workers see all of a section's PDFs in succession, then tick to confirm. Edit a section to add or remove its PDFs. Current version: <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs"><%= sopVersion %></code></p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/induction/admin/sop-preview" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg transition">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        Preview sign page
      </a>
      <a href="/induction/admin/presentations" class="text-sm text-brand-600 hover:text-brand-700 font-medium">&larr; Back</a>
    </div>
  </div>

  <!-- Upload (= add new section) -->
  <form method="POST" action="/induction/admin/sop-documents" enctype="multipart/form-data" class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 mb-6">
    <h2 class="text-sm font-bold text-gray-800 uppercase tracking-widest mb-3">Add a section</h2>
    <div class="grid sm:grid-cols-2 gap-3">
      <div class="sm:col-span-2">
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Section title <span class="text-red-500">*</span></label>
        <input type="text" name="title" required placeholder="e.g. Preparing for a Safe Shift"
          class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
      </div>
      <div class="sm:col-span-2">
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Description (optional)</label>
        <textarea name="description" rows="4" placeholder="Plain text or HTML. Shown above the PDF on the sign page. Use <strong>, <ul>/<li>, <p> for formatting."
          class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent font-mono"></textarea>
        <p class="text-[11px] text-gray-500 mt-1">Use this for the intro / key points. HTML is allowed (<code>&lt;strong&gt;</code>, <code>&lt;ul&gt;</code>, <code>&lt;li&gt;</code>, <code>&lt;p&gt;</code>).</p>
      </div>
      <div class="sm:col-span-2">
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">PDF (recommended)</label>
        <input type="file" name="file" required accept=".pdf,.png,.jpg,.jpeg,.webp,.doc,.docx,.xls,.xlsx"
          class="w-full text-sm" />
        <p class="text-[11px] text-gray-500 mt-1">Up to 25MB. PDF preferred — every page renders inline on the sign page.</p>
      </div>
    </div>
    <div class="mt-4">
      <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Add section
      </button>
    </div>
  </form>

  <!-- List of sections -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-200 flex items-center justify-between">
      <h2 class="text-sm font-bold text-gray-800">Sections in order</h2>
      <p class="text-xs text-gray-500"><%= docs.filter(d => d.active).length %> active · <%= docs.length %> total</p>
    </div>

    <% if (docs.length === 0) { %>
      <div class="p-10 text-center text-gray-400">
        <p class="font-medium">No sections yet</p>
        <p class="text-sm mt-1">Add your first section above to get started.</p>
      </div>
    <% } else { %>
      <ul class="divide-y divide-gray-100">
        <% docs.forEach((d, idx) => { %>
          <% const files = Array.isArray(d.files) ? d.files : []; %>
          <% const fileCount = files.length; %>
          <li class="px-5 py-3 <%= !d.active ? 'bg-gray-50/60 opacity-60' : '' %>">
            <!-- Header row: section number + title + actions -->
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 text-xs font-bold <%= d.active ? 'bg-brand-100 text-brand-700' : 'bg-gray-100 text-gray-400' %>">
                <%= idx + 1 %>
              </div>

              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate"><%= d.title %></p>
                <p class="text-[11px] text-gray-500 truncate">
                  <% if (fileCount === 0) { %>
                    <span class="text-amber-600 font-medium">No files</span>
                  <% } else if (fileCount === 1) { %>
                    <%= files[0].original_name %> · <%= fmtSize(files[0].file_size) %>
                  <% } else { %>
                    <span class="font-medium text-gray-700"><%= fileCount %> files</span> · <%= files.map(f => f.original_name).slice(0, 2).join(', ') %><% if (fileCount > 2) { %>, +<%= fileCount - 2 %> more<% } %>
                  <% } %>
                  · <%= fmtDate(d.created_at) %><% if (d.uploaded_by_name) { %> · <%= d.uploaded_by_name %><% } %>
                </p>
              </div>

              <div class="flex items-center gap-0.5 flex-shrink-0">
                <button type="button" onclick="document.getElementById('edit-<%= d.id %>').classList.toggle('hidden')"
                  class="px-2.5 py-1 text-xs font-medium text-brand-600 hover:bg-brand-50 rounded">Edit</button>
                <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/move" class="inline-flex">
                  <%- include('../../partials/csrf') %>
                  <input type="hidden" name="dir" value="up">
                  <button type="submit" class="px-1.5 py-1 text-gray-400 hover:text-gray-700" title="Move up" <%= idx === 0 ? 'disabled' : '' %>>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
                  </button>
                </form>
                <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/move" class="inline-flex">
                  <%- include('../../partials/csrf') %>
                  <input type="hidden" name="dir" value="down">
                  <button type="submit" class="px-1.5 py-1 text-gray-400 hover:text-gray-700" title="Move down" <%= idx === docs.length - 1 ? 'disabled' : '' %>>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                  </button>
                </form>
                <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/toggle" class="inline-flex">
                  <%- include('../../partials/csrf') %>
                  <button type="submit" class="px-2 py-1 text-xs font-medium <%= d.active ? 'text-amber-600 hover:bg-amber-50' : 'text-emerald-600 hover:bg-emerald-50' %> rounded">
                    <%= d.active ? 'Hide' : 'Show' %>
                  </button>
                </form>
                <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/delete" class="inline-flex" onsubmit="return confirm('Delete \'<%= d.title.replace(/'/g, '\\\'') %>\' permanently? Existing acknowledgements stay on file.')">
                  <%- include('../../partials/csrf') %>
                  <button type="submit" class="px-2 py-1 text-xs font-medium text-red-600 hover:bg-red-50 rounded">Delete</button>
                </form>
              </div>
            </div>

            <!-- Inline description preview (collapsed when description present) -->
            <% if (d.description) { %>
              <div class="mt-2 pl-12 text-xs text-gray-600 max-h-16 overflow-hidden">
                <div class="line-clamp-2"><%- d.description %></div>
              </div>
            <% } %>

            <!-- Inline edit form (hidden by default) — title, description, and the file list -->
            <div id="edit-<%= d.id %>" class="hidden mt-3 pl-12 space-y-3">
              <!-- Title + description -->
              <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/update" class="bg-gray-50 border border-gray-200 rounded-lg p-3 space-y-2">
                <%- include('../../partials/csrf') %>
                <div>
                  <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">Title</label>
                  <input type="text" name="title" value="<%= d.title %>" required
                    class="w-full rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent" />
                </div>
                <div>
                  <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-1">Description (HTML allowed)</label>
                  <textarea name="description" rows="6"
                    class="w-full rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-sm font-mono focus:ring-2 focus:ring-brand-500 focus:border-transparent"><%= d.description || '' %></textarea>
                </div>
                <div class="flex items-center gap-2">
                  <button type="submit" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded">Save section</button>
                  <button type="button" onclick="document.getElementById('edit-<%= d.id %>').classList.add('hidden')" class="px-3 py-1.5 bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 text-xs font-medium rounded">Cancel</button>
                </div>
              </form>

              <!-- Files inside this section -->
              <div class="bg-white border border-gray-200 rounded-lg">
                <div class="px-3 py-2 border-b border-gray-200 flex items-center justify-between">
                  <p class="text-[11px] font-bold text-gray-700 uppercase tracking-widest">Files (<%= fileCount %>)</p>
                  <p class="text-[10px] text-gray-500">Workers see every file below the section description, in this order.</p>
                </div>
                <% if (fileCount === 0) { %>
                  <p class="px-3 py-3 text-xs text-gray-400">No files yet — upload one below.</p>
                <% } else { %>
                  <ul class="divide-y divide-gray-100">
                    <% files.forEach((f, fIdx) => { const fic = iconFor(f.mime_type, f.original_name); %>
                      <li class="px-3 py-2 flex items-center gap-2">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded text-[10px] font-bold bg-gray-100 text-gray-500"><%= fIdx + 1 %></span>
                        <div class="flex-1 min-w-0">
                          <p class="text-xs font-semibold text-gray-900 truncate"><%= f.original_name %></p>
                          <p class="text-[10px] text-gray-500 truncate"><%= fic.toUpperCase() %> · <%= fmtSize(f.file_size) %> · <%= fmtDate(f.created_at) %></p>
                        </div>
                        <div class="flex items-center gap-0.5 flex-shrink-0">
                          <a href="/induction/admin/sop-documents/<%= d.id %>/files/<%= f.id %>/file" target="_blank"
                             class="px-2 py-1 text-[10px] font-medium text-gray-600 hover:bg-gray-100 rounded">Open</a>
                          <% if (fic === 'pdf') { %>
                            <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/files/<%= f.id %>/render" class="inline-flex">
                              <%- include('../../partials/csrf') %>
                              <button type="submit"
                                class="px-2 py-1 text-[10px] font-medium <%= f.pageCount > 0 ? 'text-emerald-600 hover:bg-emerald-50' : 'text-amber-600 hover:bg-amber-50' %> rounded"
                                title="Render PDF pages to images for inline display">
                                <% if (f.pageCount > 0) { %>✓ <%= f.pageCount %>p<% } else { %>Render<% } %>
                              </button>
                            </form>
                          <% } %>
                          <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/files/<%= f.id %>/move" class="inline-flex">
                            <%- include('../../partials/csrf') %>
                            <input type="hidden" name="dir" value="up">
                            <button type="submit" class="px-1 py-1 text-gray-400 hover:text-gray-700" title="Move up" <%= fIdx === 0 ? 'disabled' : '' %>>
                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/></svg>
                            </button>
                          </form>
                          <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/files/<%= f.id %>/move" class="inline-flex">
                            <%- include('../../partials/csrf') %>
                            <input type="hidden" name="dir" value="down">
                            <button type="submit" class="px-1 py-1 text-gray-400 hover:text-gray-700" title="Move down" <%= fIdx === files.length - 1 ? 'disabled' : '' %>>
                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                            </button>
                          </form>
                          <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/files/<%= f.id %>/delete" class="inline-flex"
                                onsubmit="return confirm('Remove \'<%= f.original_name.replace(/'/g, '\\\'') %>\' from this section?')">
                            <%- include('../../partials/csrf') %>
                            <button type="submit" class="px-2 py-1 text-[10px] font-medium text-red-600 hover:bg-red-50 rounded">Remove</button>
                          </form>
                        </div>
                      </li>
                    <% }) %>
                  </ul>
                <% } %>
                <!-- Add another file -->
                <form method="POST" action="/induction/admin/sop-documents/<%= d.id %>/files" enctype="multipart/form-data"
                      class="px-3 py-3 border-t border-gray-200 bg-gray-50 flex flex-wrap items-center gap-2">
                  <%- include('../../partials/csrf') %>
                  <input type="file" name="file" required accept=".pdf,.png,.jpg,.jpeg,.webp,.doc,.docx,.xls,.xlsx"
                    class="text-xs flex-1 min-w-[180px]" />
                  <button type="submit" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold rounded inline-flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                    Add file
                  </button>
                </form>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <!-- Bump version note -->
  <div class="mt-5 bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-900">
    <p class="font-semibold mb-1">Forcing re-acknowledgement</p>
    <p class="text-amber-800/90">When you change sections substantively (not just typo fixes), bump <code class="bg-amber-100 px-1 rounded">CURRENT_VERSION</code> in <code class="bg-amber-100 px-1 rounded">lib/sop.js</code> — every active worker drops back to "Not signed" on the new version, then bulk-send a sign link to sweep them.</p>
  </div>
</div>
