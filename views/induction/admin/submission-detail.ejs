<% locals.currentPage = 'induction' %>
<%
  function formatDate(dateStr) {
    if (!dateStr) return '—';
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function maskField(value, visibleChars) {
    if (!value) return '—';
    const str = String(value);
    if (str.length <= visibleChars) return str;
    return '*'.repeat(str.length - visibleChars) + str.slice(-visibleChars);
  }

  function statusBadgeClass(status) {
    switch (status) {
      case 'submitted': return 'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20';
      case 'approved': return 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20';
      case 'rejected': return 'bg-red-50 text-red-700 ring-1 ring-red-600/20';
      case 'converted': return 'bg-blue-50 text-blue-700 ring-1 ring-blue-600/20';
      default: return 'bg-gray-100 text-gray-600';
    }
  }

  function paymentBadgeClass(type) {
    switch (type) {
      case 'tfn': return 'bg-purple-50 text-purple-700 ring-1 ring-purple-600/20';
      case 'abn': return 'bg-indigo-50 text-indigo-700 ring-1 ring-indigo-600/20';
      default: return 'bg-gray-100 text-gray-600';
    }
  }

  const s = submission;
%>

<!-- Breadcrumb -->
<div class="flex items-center gap-2 text-sm text-gray-400 mb-4">
  <a href="/induction/admin/submissions" class="hover:text-gray-900 transition">Induction Submissions</a>
  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="text-gray-900"><%= s.full_name %></span>
</div>

<!-- Header Card -->
<div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5 mb-5">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-14 h-14 rounded-full bg-brand-600 flex items-center justify-center text-white font-bold text-xl flex-shrink-0">
        <%= s.full_name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() %>
      </div>
      <div>
        <h1 class="text-xl font-bold text-gray-900"><%= s.full_name %></h1>
        <div class="flex flex-wrap items-center gap-1.5 mt-1">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium capitalize <%= statusBadgeClass(s.status) %>">
            <%= s.status %>
          </span>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium uppercase <%= paymentBadgeClass(s.payment_type) %>">
            <%= s.payment_type || 'N/A' %>
          </span>
          <span class="text-xs text-gray-400">Submitted <%= formatDate(s.submitted_at || s.created_at) %></span>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      <% if (s.status === 'submitted') { %>
        <button onclick="document.getElementById('approveModal').classList.remove('hidden')" class="inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium rounded-lg transition">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Approve
        </button>
        <button onclick="document.getElementById('rejectModal').classList.remove('hidden')" class="inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-lg transition">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          Reject
        </button>
      <% } else if (s.status === 'approved' && !s.linked_crew_member_id) { %>
        <form method="POST" action="/induction/admin/submissions/<%= s.id %>/convert" onsubmit="return confirm('Convert this submission to an employee record?')">
          <%- include('../../partials/csrf') %>
          <button type="submit" class="inline-flex items-center px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            Convert to Employee
          </button>
        </form>
      <% } else if (s.linked_crew_member_id) { %>
        <a href="<%= linkedEmployeeId ? '/hr/employees/' + linkedEmployeeId : '/hr/roster' %>" class="inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium rounded-lg transition">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          View in Roster
        </a>
      <% } %>
    </div>
  </div>
</div>

<!-- Content Cards -->
<div class="space-y-5">

  <!-- Personal Details -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Personal Details</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Full Name</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.full_name %></p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Email</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.email || '—' %></p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Phone</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5 flex items-center gap-1.5">
          <span><%= s.phone || '—' %></span>
          <% if (s.phone) { %>
            <button type="button" data-copy-text="<%= s.phone %>"
                    class="inline-flex items-center justify-center w-6 h-6 rounded text-gray-400 hover:text-brand-700 hover:bg-brand-50 transition"
                    title="Copy phone number" aria-label="Copy phone number">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
          <% } %>
        </p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Date of Birth</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.date_of_birth || '—' %></p>
      </div>
      <div class="sm:col-span-2">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Address</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5">
          <%= [s.address, s.suburb, s.state, s.postcode].filter(Boolean).join(', ') || '—' %>
        </p>
      </div>
    </div>
  </div>

  <!-- Emergency Contact -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Emergency Contact</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-3">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Name</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.emergency_contact_name || '—' %></p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Phone</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5 flex items-center gap-1.5">
          <span><%= s.emergency_contact_phone || '—' %></span>
          <% if (s.emergency_contact_phone) { %>
            <button type="button" data-copy-text="<%= s.emergency_contact_phone %>"
                    class="inline-flex items-center justify-center w-6 h-6 rounded text-gray-400 hover:text-brand-700 hover:bg-brand-50 transition"
                    title="Copy phone number" aria-label="Copy phone number">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>
          <% } %>
        </p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Relationship</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.emergency_contact_relationship ? s.emergency_contact_relationship.charAt(0).toUpperCase() + s.emergency_contact_relationship.slice(1) : '—' %></p>
      </div>
    </div>
  </div>

  <!-- Fitness & Suitability -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Fitness & Suitability</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
      <div class="flex items-center gap-2">
        <% if (s.can_drive === 'yes') { %>
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          </span>
        <% } else { %>
          <span class="w-5 h-5 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </span>
        <% } %>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Can Drive</p>
          <p class="text-sm text-gray-900 font-medium"><%= s.can_drive === 'yes' ? 'Yes' : 'No' %></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <% if (s.can_drive_truck === 'yes') { %>
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          </span>
        <% } else { %>
          <span class="w-5 h-5 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </span>
        <% } %>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Can Drive Truck</p>
          <p class="text-sm text-gray-900 font-medium"><%= s.can_drive_truck === 'yes' ? 'Yes' : 'No' %></p>
        </div>
      </div>
      <div class="flex items-start gap-2 sm:col-span-2">
        <% if (s.has_injuries === 'yes') { %>
          <span class="w-5 h-5 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          </span>
        <% } else { %>
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          </span>
        <% } %>
        <div class="flex-1">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Has Injuries / Medical Conditions</p>
          <p class="text-sm text-gray-900 font-medium"><%= s.has_injuries === 'yes' ? 'Yes' : 'No' %></p>
          <% if (s.has_injuries === 'yes' && s.injury_details) { %>
            <div class="mt-1.5 p-2.5 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 text-xs">
              <%= s.injury_details %>
            </div>
          <% } %>
        </div>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Aboriginal / Torres Strait Islander</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.is_indigenous === 'yes' ? 'Yes' : s.is_indigenous === 'prefer_not' ? 'Prefer not to say' : 'No' %></p>
      </div>
    </div>
  </div>

  <!-- Documents & Licences -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Documents & Licences</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- White Card -->
      <div class="border border-gray-100 rounded-lg p-3">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">White Card</p>
        <p class="text-sm text-gray-900 font-medium"><%= s.white_card_number || '—' %></p>
        <% if (s.white_card_photo) { %>
          <div class="mt-2">
            <img src="/induction/admin/uploads/<%= s.id %>/<%= s.white_card_photo %>" alt="White Card" class="w-full h-24 object-cover rounded border border-gray-200 cursor-zoom-in" data-doc-viewer>
            <a href="/induction/admin/uploads/<%= s.id %>/<%= s.white_card_photo %>" data-doc-viewer class="inline-flex items-center gap-1 text-xs text-brand-600 hover:text-brand-700 font-medium mt-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              View Full Size
            </a>
          </div>
        <% } else { %>
          <p class="text-xs text-gray-400 mt-2">Not uploaded</p>
        <% } %>
      </div>

      <!-- TC Licence -->
      <div class="border border-gray-100 rounded-lg p-3">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">TC Licence</p>
        <p class="text-sm text-gray-900 font-medium"><%= s.tc_licence_number || '—' %></p>
        <% if (s.tc_licence_date_of_issue || s.tc_licence_state) { %>
          <p class="text-xs text-gray-500 mt-1">Issued: <%= s.tc_licence_date_of_issue ? new Date(s.tc_licence_date_of_issue).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }) : '—' %> &bull; State: <%= s.tc_licence_state || '—' %></p>
        <% } %>
        <% if (s.tc_licence_photo) { %>
          <div class="mt-2">
            <img src="/induction/admin/uploads/<%= s.id %>/<%= s.tc_licence_photo %>" alt="TC Licence" class="w-full h-24 object-cover rounded border border-gray-200 cursor-zoom-in" data-doc-viewer>
            <a href="/induction/admin/uploads/<%= s.id %>/<%= s.tc_licence_photo %>" data-doc-viewer class="inline-flex items-center gap-1 text-xs text-brand-600 hover:text-brand-700 font-medium mt-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              View Full Size
            </a>
          </div>
        <% } else { %>
          <p class="text-xs text-gray-400 mt-2">Not uploaded</p>
        <% } %>
      </div>

      <!-- Driver's Licence -->
      <div class="border border-gray-100 rounded-lg p-3">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Driver's Licence</p>
        <p class="text-sm text-gray-900 font-medium"><%= s.drivers_licence_number || '—' %></p>
        <% if (s.drivers_licence_photo) { %>
          <div class="mt-2">
            <img src="/induction/admin/uploads/<%= s.id %>/<%= s.drivers_licence_photo %>" alt="Driver's Licence" class="w-full h-24 object-cover rounded border border-gray-200 cursor-zoom-in" data-doc-viewer>
            <a href="/induction/admin/uploads/<%= s.id %>/<%= s.drivers_licence_photo %>" data-doc-viewer class="inline-flex items-center gap-1 text-xs text-brand-600 hover:text-brand-700 font-medium mt-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              View Full Size
            </a>
          </div>
        <% } else { %>
          <p class="text-xs text-gray-400 mt-2">Not uploaded</p>
        <% } %>
        <% if (s.drivers_licence_back_photo) { %>
          <div class="mt-2">
            <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Back of Licence</p>
            <img src="/induction/admin/uploads/<%= s.id %>/<%= s.drivers_licence_back_photo %>" alt="Driver's Licence Back" class="w-full h-24 object-cover rounded border border-gray-200 cursor-zoom-in" data-doc-viewer>
            <a href="/induction/admin/uploads/<%= s.id %>/<%= s.drivers_licence_back_photo %>" data-doc-viewer class="inline-flex items-center gap-1 text-xs text-brand-600 hover:text-brand-700 font-medium mt-1">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              View Full Size
            </a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Experience -->
    <% if (s.experience_years || s.experience_description) { %>
    <div class="mt-4 border border-gray-100 rounded-lg p-3">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Experience</p>
      <p class="text-sm text-gray-900 font-medium"><%= s.experience_years === 'new' ? 'New / No experience' : s.experience_years === 'less_than_1' ? 'Less than 1 year' : s.experience_years === '1_to_2' ? '1-2 years' : s.experience_years === '2_to_5' ? '2-5 years' : s.experience_years === '5_plus' ? '5+ years' : s.experience_years || '—' %></p>
      <% if (s.experience_description) { %>
        <p class="text-sm text-gray-600 mt-1 whitespace-pre-line"><%= s.experience_description %></p>
      <% } %>
    </div>
    <% } %>
  </div>

  <!-- Banking Details -->
  <% if (s.payment_type === 'tfn' || s.payment_type === 'abn' || s.payment_type === 'cash') { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Banking Details</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
      <% if (s.payment_type === 'tfn') { %>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Tax File Number</p>
          <div class="flex items-center gap-2 mt-0.5">
            <p class="text-sm text-gray-900 font-medium sensitive-field" data-full="<%= s.tax_file_number || '' %>" data-masked="<%= maskField(s.tax_file_number, 4) %>"><%= maskField(s.tax_file_number, 4) %></p>
            <% if (s.tax_file_number) { %>
              <button type="button" onclick="toggleSensitive(this)" class="text-[10px] text-brand-600 hover:text-brand-700 font-medium toggle-btn">Show</button>
            <% } %>
          </div>
        </div>
      <% } else { %>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">ABN</p>
          <div class="flex items-center gap-2 mt-0.5">
            <p class="text-sm text-gray-900 font-medium sensitive-field" data-full="<%= s.abn_number || '' %>" data-masked="<%= maskField(s.abn_number, 4) %>"><%= maskField(s.abn_number, 4) %></p>
            <% if (s.abn_number) { %>
              <button type="button" onclick="toggleSensitive(this)" class="text-[10px] text-brand-600 hover:text-brand-700 font-medium toggle-btn">Show</button>
            <% } %>
          </div>
        </div>
      <% } %>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Bank Name</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.bank_name || '—' %></p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">BSB</p>
        <div class="flex items-center gap-2 mt-0.5">
          <p class="text-sm text-gray-900 font-medium sensitive-field" data-full="<%= s.bank_bsb || '' %>" data-masked="<%= maskField(s.bank_bsb, 4) %>"><%= maskField(s.bank_bsb, 4) %></p>
          <% if (s.bank_bsb) { %>
            <button type="button" onclick="toggleSensitive(this)" class="text-[10px] text-brand-600 hover:text-brand-700 font-medium toggle-btn">Show</button>
          <% } %>
        </div>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Account Number</p>
        <div class="flex items-center gap-2 mt-0.5">
          <p class="text-sm text-gray-900 font-medium sensitive-field" data-full="<%= s.bank_account_number || '' %>" data-masked="<%= maskField(s.bank_account_number, 4) %>"><%= maskField(s.bank_account_number, 4) %></p>
          <% if (s.bank_account_number) { %>
            <button type="button" onclick="toggleSensitive(this)" class="text-[10px] text-brand-600 hover:text-brand-700 font-medium toggle-btn">Show</button>
          <% } %>
        </div>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Account Name</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.bank_account_name || '—' %></p>
      </div>

      <% if (s.payment_type === 'abn' && typeof s.has_insurance !== 'undefined') { %>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Public Liability Insurance</p>
        <p class="text-sm font-medium mt-0.5 <%= s.has_insurance === 'yes' ? 'text-emerald-700' : 'text-red-600' %>"><%= s.has_insurance === 'yes' ? 'Yes' : s.has_insurance === 'no' ? 'No' : '—' %></p>
      </div>
      <% } %>
    </div>

    <% if (s.payment_type === 'tfn' && (s.super_fund_name || s.super_member_number)) { %>
    <div class="mt-4 pt-4 border-t border-gray-100">
      <h3 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Superannuation</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Fund Name</p>
          <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.super_fund_name || '—' %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Fund ABN</p>
          <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.super_fund_abn || '—' %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">USI</p>
          <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.super_usi || '—' %></p>
        </div>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Member Number</p>
          <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.super_member_number || '—' %></p>
        </div>
      </div>
    </div>
    <% } %>
  </div>
  <% } %>

  <!-- Acknowledgements -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Acknowledgements</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
      <div class="flex items-center gap-2">
        <% if (s.company_intro_completed) { %>
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          </span>
        <% } else { %>
          <span class="w-5 h-5 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </span>
        <% } %>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Company Intro Completed</p>
          <p class="text-sm text-gray-900 font-medium"><%= s.company_intro_completed ? 'Yes' : 'No' %></p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <% if (s.ppe_acknowledged) { %>
          <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          </span>
        <% } else { %>
          <span class="w-5 h-5 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </span>
        <% } %>
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">PPE Acknowledged</p>
          <p class="text-sm text-gray-900 font-medium"><%= s.ppe_acknowledged ? 'Yes' : 'No' %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Signature & Consent -->
  <% if (s.signature_url || s.consent_signed_at) { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3 mb-4">
      <div>
        <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest">Signature &amp; Consent</h2>
        <p class="text-xs text-gray-500 mt-0.5">Electronic signature captured at submission (Electronic Transactions Act 1999).</p>
      </div>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Signed
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-3 mb-4">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Legal name</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.consent_full_name || s.full_name %></p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Signed at</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5 tabular-nums"><%= s.consent_signed_at ? formatDate(s.consent_signed_at) : '—' %></p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Consent version</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5 font-mono text-xs"><%= s.consent_version || '—' %></p>
      </div>
      <% if (s.signed_ip) { %>
      <div class="sm:col-span-3">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Signed from IP</p>
        <p class="text-sm text-gray-700 font-mono text-xs mt-0.5"><%= s.signed_ip %></p>
      </div>
      <% } %>
    </div>

    <% if (s.signature_url) { %>
      <div class="rounded-lg border border-gray-200 bg-gray-50 overflow-hidden">
        <div class="px-3 py-2 bg-white border-b border-gray-200 flex items-center justify-between">
          <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Signature</span>
          <a href="<%= s.signature_url %>" data-doc-viewer data-doc-name="Signature" class="text-xs font-medium text-brand-600 hover:text-brand-700">Open image</a>
        </div>
        <div class="p-4 flex items-center justify-center" style="background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 23px, rgba(0,0,0,0.04) 23px, rgba(0,0,0,0.04) 24px); min-height: 140px;">
          <img src="<%= s.signature_url %>" alt="Signature of <%= s.consent_full_name || s.full_name %>" class="max-h-[120px] max-w-full object-contain mix-blend-multiply" />
        </div>
        <div class="px-3 py-2 bg-white border-t border-gray-200 text-[11px] text-gray-500">
          Signed electronically by <span class="font-semibold text-gray-700"><%= s.consent_full_name || s.full_name %></span> on <%= s.consent_signed_at ? formatDate(s.consent_signed_at) : '—' %>.
        </div>
      </div>
    <% } else { %>
      <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
        Consent was acknowledged but no signature image is stored for this submission.
      </div>
    <% } %>
  </div>
  <% } %>

  <!-- Review Details -->
  <% if (s.reviewed_at) { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
    <h2 class="text-xs font-bold text-gray-800 uppercase tracking-widest mb-4">Review Details</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Reviewed By</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= s.reviewed_by_name || '—' %></p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Reviewed At</p>
        <p class="text-sm text-gray-900 font-medium mt-0.5"><%= formatDate(s.reviewed_at) %></p>
      </div>
      <% if (s.review_notes) { %>
      <div class="sm:col-span-2">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Review Notes</p>
        <div class="mt-1.5 p-3 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700">
          <%= s.review_notes %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- Suitability — allocator-facing call set during/after the in-person
       induction. 'Not suitable' also flags them on the roster. -->
  <% var suitVal = s.suitability || ''; %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
    <h2 class="text-sm font-bold text-gray-900 mb-1">Suitability</h2>
    <p class="text-xs text-gray-500 mb-3">Your call on this person for the allocator. "Not suitable" flags them on the roster so they don't get allocated.</p>
    <form method="POST" action="/induction/admin/submissions/<%= s.id %>/suitability" class="space-y-3">
      <%- include('../../partials/csrf') %>
      <div class="flex flex-wrap gap-2">
        <% [['suitable','Suitable','emerald'],['maybe','Maybe','amber'],['unsuitable','Not suitable','red']].forEach(function (o) { var on = suitVal === o[0]; %>
          <label class="cursor-pointer">
            <input type="radio" name="suitability" value="<%= o[0] %>" class="sr-only peer" <%= on ? 'checked' : '' %>>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border <%= on ? 'bg-' + o[2] + '-50 text-' + o[2] + '-700 border-' + o[2] + '-300 ring-2 ring-' + o[2] + '-400' : 'bg-gray-50 text-gray-600 border-gray-200 hover:bg-gray-100' %>">
              <span class="w-2 h-2 rounded-full bg-<%= o[2] %>-500"></span><%= o[1] %>
            </span>
          </label>
        <% }) %>
        <label class="cursor-pointer">
          <input type="radio" name="suitability" value="" class="sr-only peer" <%= suitVal === '' ? 'checked' : '' %>>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border <%= suitVal === '' ? 'bg-gray-100 text-gray-700 border-gray-300 ring-2 ring-gray-300' : 'bg-gray-50 text-gray-500 border-gray-200 hover:bg-gray-100' %>">Unrated</span>
        </label>
      </div>
      <textarea name="suitability_note" rows="3" placeholder="Comment for the allocator…"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500"><%= s.suitability_note || '' %></textarea>
      <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition">Save suitability</button>
    </form>
  </div>

</div>

<!-- Approve Modal -->
<div id="approveModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="fixed inset-0 bg-black/50" onclick="document.getElementById('approveModal').classList.add('hidden')"></div>
  <div class="relative bg-white rounded-xl shadow-xl max-w-md w-full p-6 z-10">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Approve Submission</h3>
        <p class="text-sm text-gray-500">Approve <%= s.full_name %>'s induction submission</p>
      </div>
    </div>
    <form method="POST" action="/induction/admin/submissions/<%= s.id %>/status">
      <%- include('../../partials/csrf') %>
      <input type="hidden" name="status" value="approved">
      <div class="mb-4">
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Review Notes (optional)</label>
        <textarea name="review_notes" rows="2" placeholder="Add any notes about this approval..."
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent resize-none"></textarea>
      </div>

      <!--
        Tier + payment type — drives the rate stamp on the new employee.
        The full FY26 panel lives at /payroll/wage-tiers; here the
        approver picks one of the six tiers and the matching preset is
        stamped onto the new employee's rate_* columns automatically.
      -->
      <%
        const submittedPt = (s.payment_type || '').toLowerCase();
      %>
      <div class="mb-4 p-3 rounded-lg bg-gray-50 border border-gray-200 space-y-3">
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-bold text-gray-700 uppercase tracking-widest">Engagement</p>
          <a href="/payroll/wage-tiers" target="_blank" class="text-[10px] text-brand-600 hover:underline">View wage panel →</a>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <label class="text-[10px] text-gray-600 block">Payment type
            <select name="payment_type" id="approvePaymentType" required
              class="w-full px-2 py-1.5 mt-1 border border-gray-300 rounded text-sm bg-white">
              <option value="cash" <%= submittedPt === 'cash' ? 'selected' : '' %>>Cash</option>
              <option value="abn"  <%= submittedPt === 'abn'  ? 'selected' : '' %>>ABN</option>
              <option value="tfn"  <%= submittedPt === 'tfn'  ? 'selected' : '' %>>TFN / Award</option>
            </select>
          </label>
          <label class="text-[10px] text-gray-600 block">Tier (1–6)
            <select name="tier" id="approveTier" required
              class="w-full px-2 py-1.5 mt-1 border border-gray-300 rounded text-sm bg-white">
              <option value="">— Select tier —</option>
              <option value="1">Tier 1 · Trainee TC</option>
              <option value="2" selected>Tier 2 · Traffic Controller</option>
              <option value="3">Tier 3 · Advanced TC / TMA</option>
              <option value="4">Tier 4 · Team Leader</option>
              <option value="5">Tier 5 · Senior Team Leader</option>
              <option value="6">Tier 6 · Site Supervisor</option>
            </select>
          </label>
          <label id="approveNightPatternLabel" class="text-[10px] text-gray-600 block col-span-2">
            Night roster (TFN only)
            <select name="night_pattern" id="approveNightPattern"
              class="w-full px-2 py-1.5 mt-1 border border-gray-300 rounded text-sm bg-white">
              <option value="occasional" selected>Night &lt;5 (default — occasional / &lt;5 in a row)</option>
              <option value="permanent">Night Perm. (permanent night roster)</option>
              <option value="continuous_5plus">Night 5+ (rostered continuous 5+ in a row)</option>
            </select>
          </label>
        </div>
        <div id="approvePreview" class="rounded-md bg-white border border-gray-200 p-2.5 text-[11px] text-gray-600 space-y-1 hidden">
          <div class="flex items-center justify-between">
            <span class="font-semibold text-gray-700" id="approvePreviewRole">—</span>
            <span class="text-gray-400 font-mono" id="approvePreviewAward">—</span>
          </div>
          <div id="approvePreviewRates" class="text-gray-500 tabular-nums">—</div>
          <div id="approvePreviewQuals" class="text-[10px] text-gray-400">—</div>
        </div>
        <p class="text-[10px] text-gray-500">
          Tier 2 is the default for new workers per the panel's operational rules. Rates will be stamped from the FY26 panel onto the new employee; edit per pay run anytime.
        </p>
      </div>

      <script>
        (function () {
          const ptSel = document.getElementById('approvePaymentType');
          const tierSel = document.getElementById('approveTier');
          const npSel = document.getElementById('approveNightPattern');
          const npLabel = document.getElementById('approveNightPatternLabel');
          const box = document.getElementById('approvePreview');
          const roleEl = document.getElementById('approvePreviewRole');
          const awardEl = document.getElementById('approvePreviewAward');
          const ratesEl = document.getElementById('approvePreviewRates');
          const qualsEl = document.getElementById('approvePreviewQuals');
          if (!ptSel || !tierSel) return;
          function syncNpVisibility() {
            // The night pattern picker only matters for TFN — Cash/ABN
            // have a single night rate. Hide rather than disable so the
            // form still submits a sane default value.
            if (!npLabel) return;
            if (ptSel.value === 'tfn') npLabel.classList.remove('hidden');
            else npLabel.classList.add('hidden');
          }
          async function refresh() {
            syncNpVisibility();
            const tier = tierSel.value;
            const pt = ptSel.value;
            const np = (npSel && npSel.value) || 'occasional';
            if (!tier || !pt) { box.classList.add('hidden'); return; }
            try {
              const r = await fetch('/payroll/wage-tiers/preset.json?tier=' + encodeURIComponent(tier) + '&payment_type=' + encodeURIComponent(pt) + '&night_pattern=' + encodeURIComponent(np), { headers: { Accept: 'application/json' } });
              if (!r.ok) { box.classList.add('hidden'); return; }
              const data = await r.json();
              const p = data.preset || {};
              const rates = data.rates || {};
              const fmt = v => '$' + (parseFloat(v) || 0).toFixed(2);
              roleEl.textContent = p.role_label || (data.meta && data.meta.role_label) || '—';
              awardEl.textContent = p.award_mapping || (data.meta && data.meta.award_mapping) || '';
              qualsEl.textContent = p.qualifications || (data.meta && data.meta.qualifications) || '';
              const parts = [];
              parts.push('Day ' + fmt(rates.rate_day));
              if (rates.rate_night)  parts.push('Night ' + fmt(rates.rate_night));
              if (rates.rate_night_5plus) parts.push('Night 5+ ' + fmt(rates.rate_night_5plus));
              if (rates.rate_weekend) parts.push('Sat ' + fmt(rates.rate_weekend));
              if (rates.rate_public_holiday) parts.push('PH ' + fmt(rates.rate_public_holiday));
              if (rates.rate_fares_daily) parts.push('Travel ' + fmt(rates.rate_fares_daily));
              ratesEl.textContent = parts.join(' · ');
              box.classList.remove('hidden');
            } catch (e) {
              box.classList.add('hidden');
            }
          }
          ptSel.addEventListener('change', refresh);
          tierSel.addEventListener('change', refresh);
          if (npSel) npSel.addEventListener('change', refresh);
          refresh();
        })();
      </script>

      <div class="flex items-center gap-3 justify-end">
        <button type="button" onclick="document.getElementById('approveModal').classList.add('hidden')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium rounded-lg transition">Approve</button>
      </div>
    </form>
  </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="fixed inset-0 bg-black/50" onclick="document.getElementById('rejectModal').classList.add('hidden')"></div>
  <div class="relative bg-white rounded-xl shadow-xl max-w-md w-full p-6 z-10">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </div>
      <div>
        <h3 class="text-lg font-bold text-gray-900">Reject Submission</h3>
        <p class="text-sm text-gray-500">Reject <%= s.full_name %>'s induction submission</p>
      </div>
    </div>
    <form method="POST" action="/induction/admin/submissions/<%= s.id %>/status" onsubmit="if(!this.review_notes.value.trim()){alert('Please provide a reason for rejection.');return false;}">
      <%- include('../../partials/csrf') %>
      <input type="hidden" name="status" value="rejected">
      <div class="mb-4">
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Reason for Rejection <span class="text-red-500">*</span></label>
        <textarea name="review_notes" rows="3" required placeholder="Explain why this submission is being rejected..."
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent resize-none"></textarea>
      </div>
      <div class="flex items-center gap-3 justify-end">
        <button type="button" onclick="document.getElementById('rejectModal').classList.add('hidden')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-lg transition">Reject</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleSensitive(btn) {
    const field = btn.previousElementSibling;
    const isMasked = field.textContent === field.dataset.masked;
    field.textContent = isMasked ? field.dataset.full : field.dataset.masked;
    btn.textContent = isMasked ? 'Hide' : 'Show';
  }
</script>
<!-- In-app document viewer (modal w/ X / Esc / backdrop close).
     Anchors / images marked [data-doc-viewer] open inline instead of
     popping a new tab. -->
