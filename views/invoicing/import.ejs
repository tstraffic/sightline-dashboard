<% locals.currentPage = 'invoicing' %>
<meta name="color-scheme" content="light only">

<div class="max-w-3xl mx-auto px-4 py-6">
  <a href="/finance/invoicing/new" class="text-sm text-gray-400 hover:text-gray-600">&larr; Back to assemble</a>
  <h1 class="text-xl font-bold text-gray-900 mt-2 mb-1">Import Traffio dockets (CSV)</h1>
  <p class="text-sm text-gray-500 mb-5">
    Upload a Traffio <strong>Person Dockets</strong> export and the docket hours land here ready to invoice —
    no API sync needed. Re-uploading the same file updates the rows in place; dockets already on an
    invoice are never touched.
  </p>

  <div class="bg-white border border-gray-200 rounded-xl p-4 mb-4">
    <div class="text-xs font-bold uppercase tracking-wide text-gray-400 mb-2">How to export from Traffio</div>
    <ol class="text-sm text-gray-600 space-y-1 list-decimal list-inside">
      <li>In Traffio open <span class="font-medium">Reports → Person Dockets</span></li>
      <li>Set the date range you want to invoice</li>
      <li>Export as CSV and upload the file below</li>
    </ol>
  </div>

  <form method="POST" action="/finance/invoicing/import" enctype="multipart/form-data" class="bg-white border border-gray-200 rounded-xl p-4">
    <%- include('../partials/csrf') %>
    <div class="mb-4">
      <label class="block text-xs font-semibold text-gray-500 mb-1">CSV file</label>
      <input type="file" name="csv_file" accept=".csv,text/csv" required
        class="block w-full text-sm text-gray-600 file:mr-3 file:px-3 file:py-2 file:rounded-lg file:border-0 file:bg-gray-100 file:text-gray-700 file:text-sm file:font-medium hover:file:bg-gray-200">
    </div>
    <label class="flex items-start gap-2 mb-4 cursor-pointer">
      <input type="checkbox" name="mark_signed" value="1" checked class="mt-0.5 rounded border-gray-300 text-brand-600 focus:ring-brand-500">
      <span class="text-sm text-gray-600">
        <span class="font-medium text-gray-900">Treat all dockets as signed off</span><br>
        <span class="text-gray-500">Use when sign-off happened on paper or isn't ticked in Traffio yet — only signed dockets can be assembled into invoices. Untick to take the signed-off flag from the CSV as-is.</span>
      </span>
    </label>
    <button type="submit" class="px-4 py-2 rounded-lg text-sm font-semibold bg-brand-600 text-white hover:bg-brand-700">Import dockets</button>
  </form>
</div>
