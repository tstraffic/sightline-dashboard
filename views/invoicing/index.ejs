<% locals.currentPage = 'invoicing' %>
<meta name="color-scheme" content="light only">

<%
  function statusPill(s) {
    if (s === 'draft')    return 'bg-amber-50 text-amber-700 ring-amber-600/20';
    if (s === 'approved') return 'bg-blue-50 text-blue-700 ring-blue-600/20';
    if (s === 'pushed')   return 'bg-emerald-50 text-emerald-700 ring-emerald-600/20';
    return 'bg-gray-100 text-gray-500 ring-gray-500/15';
  }
%>

<div class="max-w-5xl mx-auto px-4 py-6">
  <%- include('../partials/page-header', { rail: true,
    eyebrow: 'Finance',
    title: 'Invoicing',
    subtitle: 'Draft invoices built from signed Traffio dockets. Review, set rates, approve — then push to QuickBooks (Phase 3).',
    actions: [{ label: '+ New invoices', href: '/finance/invoicing/new', style: 'primary' }]
  }) %>

  <div class="flex flex-wrap gap-2 mb-4">
    <% const chips = [['draft','Draft',counts.draft],['approved','Approved',counts.approved],['pushed','Pushed',counts.pushed],['void','Void',counts.void],['all','All','']]; %>
    <% chips.forEach(function(c){ %>
      <a href="/finance/invoicing?status=<%= c[0] %>"
         class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold ring-1 ring-inset <%= status === c[0] ? 'bg-brand-600 text-white ring-brand-600' : 'bg-white text-gray-600 ring-gray-200 hover:bg-gray-50' %>">
        <%= c[1] %><% if (c[2] !== '') { %><span class="<%= status === c[0] ? 'text-white/80' : 'text-gray-400' %>"><%= c[2] %></span><% } %>
      </a>
    <% }); %>
  </div>

  <% if (!invoices.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl p-10 text-center text-gray-400 text-sm">
      No invoices with this status. Use <a href="/finance/invoicing/new" class="text-brand-600 font-medium">New invoices</a> to assemble drafts from signed dockets.
    </div>
  <% } else { %>
    <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
      <% invoices.forEach(function(i){ %>
        <a href="/finance/invoicing/<%= i.id %>" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide ring-1 ring-inset <%= statusPill(i.status) %>"><%= i.status %></span>
          <div class="min-w-0 flex-1">
            <div class="text-sm font-medium text-gray-900 truncate">
              <%= i.invoice_number || 'Draft' %> · <%= i.client_company || i.client_name_snapshot || 'Unknown client' %>
            </div>
            <div class="text-xs text-gray-400"><%= i.period_start %> → <%= i.period_end %><% if (i.docket_ref) { %> · dockets <%= i.docket_ref.length > 40 ? i.docket_ref.slice(0,40) + '…' : i.docket_ref %><% } %></div>
          </div>
          <div class="text-right shrink-0">
            <div class="text-sm font-semibold text-gray-900">$<%= money(i.total_inc_gst) %></div>
            <div class="text-[11px] text-gray-400">inc GST</div>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>
