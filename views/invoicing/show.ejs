<% locals.currentPage = 'invoicing' %>
<meta name="color-scheme" content="light only">

<%
  const draft = invoice.status === 'draft';
  const flaggedCount = invoice.lines.filter(l => l.rate_flagged).length;
  function statusPill(s) {
    if (s === 'draft')    return 'bg-amber-50 text-amber-700 ring-amber-600/20';
    if (s === 'approved') return 'bg-blue-50 text-blue-700 ring-blue-600/20';
    if (s === 'pushed')   return 'bg-emerald-50 text-emerald-700 ring-emerald-600/20';
    return 'bg-gray-100 text-gray-500 ring-gray-500/15';
  }
%>

<div class="max-w-4xl mx-auto px-4 py-6">
  <a href="/finance/invoicing" class="text-sm text-gray-400 hover:text-gray-600">&larr; Back to invoices</a>
  <div class="flex items-center justify-between mt-2 mb-1">
    <h1 class="text-xl font-bold text-gray-900"><%= invoice.invoice_number || 'Draft invoice' %></h1>
    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wide ring-1 ring-inset <%= statusPill(invoice.status) %>"><%= invoice.status %></span>
  </div>
  <p class="text-sm text-gray-500 mb-1"><%= invoice.client_name_snapshot || 'Unknown client' %> · <%= invoice.period_start %> → <%= invoice.period_end %></p>
  <% if (invoice.docket_ref) { %><p class="text-xs text-gray-400 mb-4">Dockets: <%= invoice.docket_ref %></p><% } %>

  <% if (draft && flaggedCount) { %>
    <div class="mb-4 rounded-lg bg-amber-50 border border-amber-200 px-4 py-2.5 text-sm text-amber-800">
      <strong><%= flaggedCount %></strong> line<%= flaggedCount === 1 ? '' : 's' %> need a rate — set the unit price before approving. (Rate-card auto-pricing comes next.)
    </div>
  <% } %>

  <% if (draft) { %>
  <form method="POST" action="/finance/invoicing/<%= invoice.id %>/lines" class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-4">
    <%- include('../partials/csrf') %>
    <table class="w-full text-sm">
      <thead><tr class="text-left text-gray-400 text-xs uppercase tracking-wide bg-gray-50">
        <th class="px-3 py-2">Description</th>
        <th class="px-2 py-2 w-20 text-right">Qty</th>
        <th class="px-2 py-2 w-28 text-right">Unit $</th>
        <th class="px-2 py-2 w-20">Tax</th>
        <th class="px-2 py-2 w-24 text-right">Total</th>
        <th class="px-2 py-2 w-12 text-center">Del</th>
      </tr></thead>
      <tbody>
        <% invoice.lines.forEach(function(l){ %>
          <tr class="border-t border-gray-100 <%= l.rate_flagged ? 'bg-amber-50/40' : '' %>">
            <td class="px-3 py-1.5">
              <input type="hidden" name="line_id" value="<%= l.id %>">
              <input type="text" name="description" value="<%= l.description %>" class="w-full rounded border border-gray-200 px-2 py-1 text-sm">
            </td>
            <td class="px-2 py-1.5"><input type="number" step="0.01" name="qty" value="<%= l.qty %>" class="w-full rounded border border-gray-200 px-2 py-1 text-sm text-right"></td>
            <td class="px-2 py-1.5"><input type="number" step="0.01" name="unit_price" value="<%= l.unit_price %>" class="w-full rounded border <%= l.rate_flagged ? 'border-amber-400' : 'border-gray-200' %> px-2 py-1 text-sm text-right"></td>
            <td class="px-2 py-1.5">
              <select name="tax_code" class="w-full rounded border border-gray-200 px-1 py-1 text-sm">
                <option value="GST" <%= l.tax_code !== 'FRE' ? 'selected' : '' %>>GST</option>
                <option value="FRE" <%= l.tax_code === 'FRE' ? 'selected' : '' %>>FRE</option>
              </select>
            </td>
            <td class="px-2 py-1.5 text-right text-gray-600">$<%= money(l.line_total) %></td>
            <td class="px-2 py-1.5 text-center"><input type="checkbox" name="remove" value="<%= l.id %>"></td>
          </tr>
        <% }); %>
        <!-- add manual line -->
        <tr class="border-t border-gray-100 bg-gray-50/50">
          <td class="px-3 py-1.5"><input type="text" name="new_description" placeholder="+ add a line…" class="w-full rounded border border-gray-200 px-2 py-1 text-sm"></td>
          <td class="px-2 py-1.5"><input type="number" step="0.01" name="new_qty" placeholder="0" class="w-full rounded border border-gray-200 px-2 py-1 text-sm text-right"></td>
          <td class="px-2 py-1.5"><input type="number" step="0.01" name="new_unit_price" placeholder="0.00" class="w-full rounded border border-gray-200 px-2 py-1 text-sm text-right"></td>
          <td colspan="3"></td>
        </tr>
      </tbody>
    </table>
    <div class="flex items-center justify-between px-3 py-3 border-t border-gray-100 bg-gray-50">
      <div class="text-sm text-gray-600">
        Subtotal <strong>$<%= money(invoice.subtotal_ex_gst) %></strong> · GST <strong>$<%= money(invoice.gst) %></strong> · Total <strong class="text-gray-900">$<%= money(invoice.total_inc_gst) %></strong>
      </div>
      <button type="submit" class="px-4 py-2 rounded-lg text-sm font-semibold bg-gray-800 text-white hover:bg-gray-900">Save changes</button>
    </div>
  </form>

  <div class="flex items-center gap-2">
    <form method="POST" action="/finance/invoicing/<%= invoice.id %>/approve" onsubmit="return confirm('Approve this invoice? It will be assigned a number.');">
      <%- include('../partials/csrf') %>
      <button type="submit" class="px-4 py-2 rounded-lg text-sm font-semibold bg-brand-600 text-white hover:bg-brand-700">Approve</button>
    </form>
    <form method="POST" action="/finance/invoicing/<%= invoice.id %>/delete" onsubmit="return confirm('Delete this draft? Its dockets become available again.');">
      <%- include('../partials/csrf') %>
      <button type="submit" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-rose-600">Delete draft</button>
    </form>
  </div>

  <% } else { %>
  <!-- read-only -->
  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden mb-4">
    <table class="w-full text-sm">
      <thead><tr class="text-left text-gray-400 text-xs uppercase tracking-wide bg-gray-50">
        <th class="px-3 py-2">Description</th><th class="px-2 py-2 text-right">Qty</th><th class="px-2 py-2 text-right">Unit $</th><th class="px-2 py-2">Tax</th><th class="px-2 py-2 text-right">Total</th>
      </tr></thead>
      <tbody>
        <% invoice.lines.forEach(function(l){ %>
          <tr class="border-t border-gray-100">
            <td class="px-3 py-2 text-gray-900"><%= l.description %></td>
            <td class="px-2 py-2 text-right text-gray-600"><%= l.qty %></td>
            <td class="px-2 py-2 text-right text-gray-600">$<%= money(l.unit_price) %></td>
            <td class="px-2 py-2 text-gray-500"><%= l.tax_code %></td>
            <td class="px-2 py-2 text-right text-gray-700">$<%= money(l.line_total) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <div class="px-3 py-3 border-t border-gray-100 bg-gray-50 text-right text-sm text-gray-600">
      Subtotal <strong>$<%= money(invoice.subtotal_ex_gst) %></strong> · GST <strong>$<%= money(invoice.gst) %></strong> · Total <strong class="text-gray-900">$<%= money(invoice.total_inc_gst) %></strong>
    </div>
  </div>

  <% if (invoice.status === 'approved') { %>
    <div class="flex items-center gap-3">
      <span class="text-sm text-gray-500">Approved<%= invoice.approved_at ? ' · ' + invoice.approved_at : '' %>. QuickBooks push arrives in Phase 3.</span>
      <form method="POST" action="/finance/invoicing/<%= invoice.id %>/void" onsubmit="return confirm('Void this invoice? Its dockets become available again.');">
        <%- include('../partials/csrf') %>
        <button type="submit" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-rose-600">Void</button>
      </form>
    </div>
  <% } %>
  <% } %>
</div>
