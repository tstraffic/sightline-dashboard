        <select name="po_status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <% [['',''],['not_required','Not required'],['awaited','Awaited'],['received','Received']].forEach(([v,l]) => { %>
            <option value="<%= v %>" <%= isEdit && job.po_status === v ? 'selected' : '' %>><%= l || 'Unknown' %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Invoice Status</label>
        <select name="invoice_status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <% [['','Not started'],['ready_to_invoice','Ready to invoice'],['partially_invoiced','Partially invoiced'],['invoiced','Invoiced'],['paid','Paid']].forEach(([v,l]) => { %>
            <option value="<%= v %>" <%= isEdit && job.invoice_status === v ? 'selected' : '' %>><%= l %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Xero Reference</label>
        <input type="text" name="xero_reference" value="<%= isEdit ? (job.xero_reference || '') : '' %>" placeholder="Invoice # / contact"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Next Action Date</label>
        <input type="date" name="next_action_date" value="<%= isEdit ? (job.next_action_date || '') : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div class="sm:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Current Action</label>
        <input type="text" name="current_action" value="<%= isEdit ? (job.current_action || '') : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div class="sm:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Blocker</label>
        <input type="text" name="blocker" value="<%= isEdit ? (job.blocker || '') : '' %>" placeholder="What's stopping progress?"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
    </div>
  </div>

  <style>
    .bk2-month-chip {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 6px 10px; border: 1px solid #E5E7EB; border-radius: 8px;
      background: #fff; font-size: 12px; font-weight: 500; color: #374151;
      cursor: pointer; transition: background 100ms ease, border-color 100ms ease, color 100ms ease;
      user-select: none; position: relative;
    }
    .bk2-month-chip input { position: absolute; opacity: 0; pointer-events: none; }
    .bk2-month-chip:hover { background: #F9FAFB; }
    .bk2-month-chip.is-on, .bk2-month-chip:has(input:checked) {
      background: #EFF6FF; border-color: #2B7FFF; color: #1D4ED8; font-weight: 600;
    }
    .bk2-month-mode {
      display: flex; flex-direction: column; gap: 2px;
      padding: 10px 12px; border: 1.5px solid #E5E7EB; border-radius: 9px;
      background: #fff; cursor: pointer; position: relative;
      transition: border-color 100ms ease, background 100ms ease;
    }
    .bk2-month-mode input { position: absolute; opacity: 0; pointer-events: none; }
    .bk2-month-mode:hover { background: #F9FAFB; }
    .bk2-month-mode.is-on, .bk2-month-mode:has(input:checked) { border-color: #2B7FFF; background: #EFF6FF; }
    .bk2-month-mode-title { font-size: 13px; font-weight: 600; color: #111827; }
    .bk2-month-mode-sub   { font-size: 11px; color: #6B7280; }
    .bk2-month-mode-sub code { background: #F3F4F6; padding: 1px 5px; border-radius: 4px; font-family: ui-monospace, monospace; font-size: 10.5px; }

    /* Dark-mode variants — the chip surfaces use hardcoded colours
       so the global .dark-glass theme doesn't touch them. */
    body.dark-glass .bk2-month-chip {
      background: rgba(255,255,255,0.04);
      border-color: rgba(255,255,255,0.10);
      color: rgba(255,255,255,0.85);
    }
    body.dark-glass .bk2-month-chip:hover { background: rgba(255,255,255,0.08); }
    body.dark-glass .bk2-month-chip.is-on,
    body.dark-glass .bk2-month-chip:has(input:checked) {
      background: rgba(43,127,255,0.20);
      border-color: #2B7FFF;
      color: #93C5FD;
    }
    body.dark-glass .bk2-month-mode {
      background: rgba(255,255,255,0.04);
      border-color: rgba(255,255,255,0.12);
    }
    body.dark-glass .bk2-month-mode:hover { background: rgba(255,255,255,0.08); }
    body.dark-glass .bk2-month-mode.is-on,
    body.dark-glass .bk2-month-mode:has(input:checked) {
      background: rgba(43,127,255,0.18);
      border-color: #2B7FFF;
    }
    body.dark-glass .bk2-month-mode-title { color: rgba(255,255,255,0.92); }
    body.dark-glass .bk2-month-mode-sub { color: rgba(255,255,255,0.55); }
    body.dark-glass .bk2-month-mode-sub code { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.85); }
  </style>

  <script>
  (function () {
    var toggle = document.getElementById('monthly_package');
    var cfg    = document.getElementById('monthly-package-config');
    var preview = document.getElementById('monthly-preview');
    var pattern = document.getElementById('recurring_pattern_name');
    var year    = document.getElementById('monthly_year');
    var grid    = document.getElementById('monthly-months-grid');
    if (!toggle || !cfg) return;
    var FULL = ['January','February','March','April','May','June','July','August','September','October','November','December'];

    function active() {
      return Array.from(grid.querySelectorAll('input[name="monthly_months"]:checked')).map(function (i) { return i.value; });
    }
    function mode() {
      var on = document.querySelector('input[name="monthly_mode"]:checked');
      return on ? on.value : 'split';
    }
    function combinedName(months, p) {
      var sorted = months.slice().map(function (n) { return FULL.indexOf(n); }).sort(function (a, b) { return a - b; });
      if (!sorted.length) return p;
      if (sorted.length === 1) return FULL[sorted[0]] + ' - ' + p;
      var contig = sorted.every(function (n, i) { return i === 0 || n === sorted[i - 1] + 1; });
      if (contig) return FULL[sorted[0]] + '–' + FULL[sorted[sorted.length - 1]] + ' - ' + p;
      if (sorted.length <= 3) return sorted.map(function (n) { return FULL[n].slice(0, 3); }).join(', ') + ' - ' + p;
      return 'Multiple months - ' + p;
    }
    function render() {
      if (!preview) return;
      var ms = active();
      if (!ms.length) { preview.textContent = 'No months selected — tick one or more above.'; return; }
      var p = (pattern.value || 'Packages').trim();
      var y = year.value;
      if (mode() === 'combined') {
        preview.innerHTML = 'Will create 1 combined job: <code style="background:#F3F4F6;padding:1px 6px;border-radius:4px">' + combinedName(ms, p) + ' (' + y + ')</code>';
      } else {
        preview.innerHTML = 'Will create ' + ms.length + ' job(s): ' +
          ms.map(function (m) { return '<code style="background:#F3F4F6;padding:1px 6px;border-radius:4px">' + m + ' - ' + p + ' (' + y + ')</code>'; }).join(' ');
      }
    }
    function sync() { cfg.style.display = toggle.checked ? '' : 'none'; if (toggle.checked) render(); }
    toggle.addEventListener('change', sync);
    if (pattern) pattern.addEventListener('input', render);
    if (year)    year.addEventListener('change', render);
    grid.addEventListener('change', function (e) {
      if (e.target.matches('input[name="monthly_months"]')) render();
    });
    document.querySelectorAll('input[name="monthly_mode"]').forEach(function (r) {
      r.addEventListener('change', function () {
        document.querySelectorAll('.bk2-month-mode').forEach(function (m) { m.classList.toggle('is-on', m.querySelector('input').checked); });
        render();
      });
    });
    function set(filter) {
      grid.querySelectorAll('input[name="monthly_months"]').forEach(function (cb, i) { cb.checked = filter(i); });
      render();
    }
    var a = document.getElementById('monthly-pick-all');
    var r = document.getElementById('monthly-pick-rest');
    var c = document.getElementById('monthly-pick-clear');
    if (a) a.addEventListener('click', function () { set(function () { return true; }); });
    if (r) r.addEventListener('click', function () { var n = new Date().getMonth(); set(function (i) { return i >= n; }); });
    if (c) c.addEventListener('click', function () { set(function () { return false; }); });
    sync();
  })();
  </script>

  <noscript>
    <div class="sticky bottom-0 bg-gray-50/95 backdrop-blur-sm border-t border-gray-200 -mx-4 sm:-mx-6 px-4 sm:px-6 py-3 flex items-center gap-3">
      <button type="submit" class="px-6 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition-colors">
        <%= isEdit ? 'Update Job' : 'Create Job' %>
      </button>
      <a href="/projects" class="px-6 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium rounded-lg transition-colors">Cancel</a>
    </div>
  </noscript>
</form>

<script>
function toggleJobClientAdd() {
  document.getElementById('jobQuickAddClient').classList.toggle('hidden');
}

function saveJobClient() {
  var nameEl = document.getElementById('qa_job_client_name');
  var name = nameEl.value.trim();
  if (!name) { nameEl.focus(); return; }
  var btn = document.querySelector('#jobQuickAddClient button[onclick="saveJobClient()"]');
  if (btn) { btn.disabled = true; btn.textContent = 'Creating…'; }
  fetch('/clients', {
    method: 'POST',
    headers: csrfHeaders({ 'Content-Type': 'application/json', 'Accept': 'application/json' }),
    body: JSON.stringify({ company_name: name })
  }).then(function(r) {
    if (!r.ok) return r.text().then(function(t) { throw new Error('HTTP ' + r.status + ': ' + t.substring(0, 100)); });
    return r.json();
  }).then(function(data) {
    if (data.success && data.client) {
      var sel = document.getElementById('client_id');
      // If the client already existed in the list (dupe name), reuse that
      // option instead of adding a second one.
      var existing = Array.prototype.find.call(sel.options, function (o) { return String(o.value) === String(data.client.id); });
      if (!existing) {
        var opt = new Option(data.client.company_name, data.client.id, true, true);
        sel.add(opt);
      }
      sel.value = data.client.id;
      document.getElementById('client').value = data.client.company_name;
      nameEl.value = '';
      document.getElementById('jobQuickAddClient').classList.add('hidden');
      // Fire change so any client-dependent logic re-runs + so the select
      // visibly reflects the new selection.
      sel.dispatchEvent(new Event('change', { bubbles: true }));
      showJobClientCreated(data.client.company_name);
    } else {
      alert('Failed to create client: ' + JSON.stringify(data));
    }
  }).catch(function(e) {
    alert('Error creating client: ' + e.message);
  }).finally(function () {
    if (btn) { btn.disabled = false; btn.textContent = 'Create'; }
  });
}

// Brief inline confirmation under the Client field after a quick-add, with
// a green tick so the planner knows the new company was created AND applied.
function showJobClientCreated(name) {
  var anchor = document.getElementById('client_id');
  if (!anchor) return;
  var existing = document.getElementById('jobClientCreatedNote');
  if (existing) existing.remove();
  var note = document.createElement('div');
  note.id = 'jobClientCreatedNote';
  note.className = 'mt-1.5 inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg px-2 py-1';
  note.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>'
    + '<span>New client created &amp; selected: ' + name.replace(/[<>&]/g, '') + '</span>';
  anchor.parentNode.insertBefore(note, anchor.nextSibling);
  setTimeout(function () { if (note && note.parentNode) { note.style.transition = 'opacity .3s'; note.style.opacity = '0'; setTimeout(function () { note.remove(); }, 300); } }, 4000);
}

// Address autocomplete — Google Places when an API key is configured in
// Admin → Integrations (proxied via /api/address-suggest, full AU street-
// number coverage), otherwise Photon (OSM, free, street-level only). The
// Photon path keeps the street number YOU typed: "9 Epic Pl" → pick
// "Epic Place, Villawood" → fills "9 Epic Place, Villawood, NSW, 2163".
// Keyboard: ↑/↓ to highlight, Enter to select (never submits), Esc closes.
(function() {
  var input = document.getElementById('address_search');
  var results = document.getElementById('address_results');
  var spinner = document.getElementById('address_spinner');
  if (!input) return;
  var timer;
  var highlighted = -1;
  var sessionToken = null; // one Google billing session per search
  var stateAbbr = { 'New South Wales': 'NSW', 'Victoria': 'VIC', 'Queensland': 'QLD', 'South Australia': 'SA', 'Western Australia': 'WA', 'Tasmania': 'TAS', 'Northern Territory': 'NT', 'Australian Capital Territory': 'ACT' };
  // Common AU street-type abbreviations Photon doesn't expand ("st" left
  // out — too ambiguous with Saint). Google handles these natively.
  var abbrev = { pl: 'place', rd: 'road', ave: 'avenue', av: 'avenue', hwy: 'highway', cres: 'crescent', dr: 'drive', ct: 'court', pde: 'parade', blvd: 'boulevard', ln: 'lane', tce: 'terrace' };

  function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

  function newToken() {
    try { return crypto.randomUUID(); } catch (e) { return String(Date.now()) + Math.floor(Math.random() * 1e9); }
  }

  // One fill path for both providers.
  function applyAddress(a) {
    var fullAddr = [a.street, a.suburb, a.state, a.postcode].filter(Boolean).join(', ');
    document.getElementById('site_address').value = fullAddr;
    document.getElementById('suburb').value = a.suburb || '';
    document.getElementById('location_state').value = a.state || '';
    var stateSelect = document.getElementById('state');
    if (stateSelect && a.state) {
      for (var i = 0; i < stateSelect.options.length; i++) {
        if (stateSelect.options[i].value === a.state) { stateSelect.value = a.state; break; }
      }
    }
    input.value = '';
    hideResults();
    sessionToken = null; // selection ends the Google billing session
  }

  function hideResults() { results.classList.add('hidden'); results.innerHTML = ''; results._rows = null; highlighted = -1; }

  function rowHtml(i, line1, line2) {
    return '<button type="button" data-idx="' + i + '" class="addr-row" style="width:100%;text-align:left;padding:10px 14px;border-bottom:1px solid #f3f4f6;cursor:pointer;background:none;border-left:0;border-right:0;border-top:0;font-family:inherit;">' +
      '<div style="font-weight:500;color:#111;font-size:14px;">' + esc(line1) + '</div>' +
      '<div style="font-size:12px;color:#9ca3af;margin-top:2px;">' + esc(line2) + '</div>' +
      '</button>';
  }

  function paintHighlight() {
    var rows = results.querySelectorAll('button[data-idx]');
    rows.forEach(function(r, i) { r.style.background = i === highlighted ? '#eff6ff' : 'none'; });
  }

  function renderRows(rows) {
    // rows: [{ line1, line2, pick: fn }]
    if (!rows.length) {
      results.innerHTML = '<div style="padding:10px 14px;color:#9ca3af;font-size:13px;">No Australian addresses found</div>';
      results._rows = null;
      results.classList.remove('hidden');
      return;
    }
    results.innerHTML = rows.map(function(r, i) { return rowHtml(i, r.line1, r.line2); }).join('');
    results._rows = rows;
    highlighted = -1;
    results.classList.remove('hidden');
  }

  // ---- Photon (free fallback) ----
  function photonSearch(q) {
    // Preserve a typed leading street number — Photon has no AU house
    // numbers, so we re-attach it to street-level matches.
    var numMatch = q.match(/^(\d+[a-zA-Z]?(?:-\d+)?)\s+(.+)/);
    var typedNumber = numMatch ? numMatch[1] : '';
    // Expand street-type abbreviations for better matching.
    var expanded = q.replace(/\b([a-z]+)\b/gi, function(w) { return abbrev[w.toLowerCase()] || w; });
    fetch('https://photon.komoot.io/api/?q=' + encodeURIComponent(expanded) + '&lat=-33.87&lon=151.21&limit=6&lang=en&bbox=112.9,-43.8,153.7,-9.0')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        spinner.classList.add('hidden');
        var features = (data.features || []).filter(function(f) {
          return f.properties && f.properties.country === 'Australia';
        });
        renderRows(features.map(function(f) {
          var p = f.properties;
          var streetName = p.street || p.name || '';
          var number = p.housenumber || typedNumber; // keep what the user typed
          var street = (number ? number + ' ' : '') + streetName;
          var suburb = p.district || p.city || p.locality || '';
          var stCode = stateAbbr[p.state] || p.state || '';
          var postcode = p.postcode || '';
          return {
            line1: street || suburb,
            line2: [suburb, stCode, postcode].filter(Boolean).join(', '),
            pick: function() { applyAddress({ street: street, suburb: suburb, state: stCode, postcode: postcode }); },
          };
        }));
      })
      .catch(function() { spinner.classList.add('hidden'); });
  }

  // ---- Google (via server proxy, needs key in Admin → Integrations) ----
  function googlePick(s) {
    spinner.classList.remove('hidden');
    fetch('/api/address-suggest/details?place_id=' + encodeURIComponent(s.id) + '&sessiontoken=' + encodeURIComponent(sessionToken || ''))
      .then(function(r) { return r.json(); })
      .then(function(a) {
        spinner.classList.add('hidden');
        if (a && !a.error) applyAddress(a);
      })
      .catch(function() { spinner.classList.add('hidden'); });
  }

  input.addEventListener('input', function() {
    clearTimeout(timer);
    var q = input.value.trim();
    if (q.length < 3) { hideResults(); return; }
    if (!sessionToken) sessionToken = newToken();
    timer = setTimeout(function() {
      spinner.classList.remove('hidden');
      fetch('/api/address-suggest?q=' + encodeURIComponent(q) + '&sessiontoken=' + encodeURIComponent(sessionToken))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.provider === 'google') {
            spinner.classList.add('hidden');
            renderRows((data.suggestions || []).map(function(s) {
              return { line1: s.label, line2: s.sub, pick: function() { googlePick(s); } };
            }));
          } else {
            photonSearch(q); // free fallback, manages its own spinner
          }
        })
        .catch(function() { photonSearch(q); });
    }, 300);
  });

  // Keyboard: ↑/↓ highlight, Enter selects highlighted (or first), Esc closes.
  // Enter in this box must NEVER submit the form or advance the wizard.
  input.addEventListener('keydown', function(e) {
    var open = !results.classList.contains('hidden') && results._rows && results._rows.length;
    if (e.key === 'Enter') {
      e.preventDefault();
      if (open) {
        var idx = highlighted >= 0 ? highlighted : 0;
        if (results._rows[idx]) results._rows[idx].pick();
      }
      return;
    }
    if (!open) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      highlighted = (highlighted + 1) % results._rows.length;
      paintHighlight();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      highlighted = highlighted <= 0 ? results._rows.length - 1 : highlighted - 1;
      paintHighlight();
    } else if (e.key === 'Escape') {
      hideResults();
    }
  });

  results.addEventListener('click', function(e) {
    var btn = e.target.closest('button[data-idx]');
    if (!btn || !results._rows) return;
    var row = results._rows[parseInt(btn.dataset.idx)];
    if (row) row.pick();
  });
  results.addEventListener('mouseover', function(e) {
    var btn = e.target.closest('button[data-idx]');
    if (!btn) return;
    highlighted = parseInt(btn.dataset.idx);
    paintHighlight();
  });

  document.addEventListener('click', function(e) {
    if (!e.target.closest('#address_search') && !e.target.closest('#address_results')) {
      hideResults();
    }
  });
})();

// Sync hidden client name field on form submit
document.querySelector('form').addEventListener('submit', function() {
  var sel = document.getElementById('client_id');
  if (sel.selectedIndex > 0) {
    document.getElementById('client').value = sel.options[sel.selectedIndex].text;
  }
});
</script>
