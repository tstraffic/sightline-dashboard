        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Commercial Lead</label>
        <select name="commercial_lead_id" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">—</option>
          <% users.forEach(u => { %><option value="<%= u.id %>" <%= isEdit && job.commercial_lead_id == u.id ? 'selected' : '' %>><%= u.full_name %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Technical Lead</label>
        <select name="technical_lead_id" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">—</option>
          <% users.forEach(u => { %><option value="<%= u.id %>" <%= isEdit && job.technical_lead_id == u.id ? 'selected' : '' %>><%= u.full_name %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Checker</label>
        <select name="checker_id" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">—</option>
          <% users.forEach(u => { %><option value="<%= u.id %>" <%= isEdit && job.checker_id == u.id ? 'selected' : '' %>><%= u.full_name %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Internal QA Date</label>
        <input type="date" name="internal_qa_date" value="<%= isEdit ? (job.internal_qa_date || '') : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Client Deadline</label>
        <input type="date" name="client_deadline" value="<%= isEdit ? (job.client_deadline || '') : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Actual Hours</label>
        <% if (typeof jobHasTime !== 'undefined' && jobHasTime) { %>
        <input type="number" name="actual_hours" value="<%= isEdit ? (job.actual_hours || 0) : 0 %>" disabled
          class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-gray-500 text-sm tabular-nums focus:outline-none">
        <p class="text-[11px] text-gray-400 mt-1">Derived from <a href="/time?job_id=<%= job.id %>" class="text-brand-600 hover:underline">time entries</a> — log time to change it.</p>
        <% } else { %>
        <input type="number" name="actual_hours" min="0" step="0.5" value="<%= isEdit ? (job.actual_hours || 0) : 0 %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm tabular-nums focus:outline-none focus:ring-2 focus:ring-brand-500">
        <% } %>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">PO Reference</label>
        <input type="text" name="po_reference" value="<%= isEdit ? (job.po_reference || '') : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
