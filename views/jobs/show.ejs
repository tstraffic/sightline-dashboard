                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium ring-1 ring-inset <%= AUDIT_RESULT_BADGE[finding] || 'bg-gray-50 text-gray-600 ring-gray-400/20' %>"><%= a.overall_finding %></span>
                <% } else { %>
