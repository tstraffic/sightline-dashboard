              <td class="px-4 py-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium ring-1 ring-inset <%= AUDIT_STATUS_BADGE[status] || 'bg-gray-100 text-gray-600 ring-gray-300' %>"><%= a.status || 'draft' %></span>
