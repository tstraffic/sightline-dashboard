          'signed off': 'bg-emerald-50 text-emerald-700 ring-emerald-600/20',
          submitted:    'bg-blue-50 text-blue-700 ring-blue-600/20',
          draft:        'bg-gray-100 text-gray-600 ring-gray-300',
        };
        function _auditDate(s) {
          if (!s) return '—';
          // audit_datetime is TEXT — fall back to the raw value if it's not parseable as a date
          const d = new Date(s);
          if (isNaN(d.getTime())) return s;
          return d.toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: '2-digit', month: '2-digit', year: 'numeric' });
        }
