  <!-- Traffic Plans Tab -->
  <% if (showTab('plans')) { %>
  <div id="plans" class="tab-content">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-gray-900">Traffic Plans</h2>
      <div class="flex items-center gap-2">
        <button type="button" onclick="document.getElementById('link-plan-form').classList.toggle('hidden')" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition-colors">Link Existing</button>
        <a href="/compliance/new?job_id=<%= job.id %>&return_to=/projects/<%= job.id %>%23plans" class="px-3 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">+ New Plan</a>
      </div>
    </div>
    <!-- Link existing plan from register -->
    <div id="link-plan-form" class="hidden bg-white border border-gray-200 rounded-xl shadow-sm p-4 mb-4">
      <form method="POST" action="/jobs/<%= job.id %>/link-compliance">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="redirect_hash" value="plans">
        <div class="flex items-end gap-3">
          <div class="flex-1">
            <label class="block text-xs font-medium text-gray-500 mb-1">Select plan from register</label>
            <select name="compliance_id" required id="link-plan-select" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="">Choose a plan...</option>
            </select>
          </div>
          <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors whitespace-nowrap">Link to Job</button>
          <button type="button" onclick="document.getElementById('link-plan-form').classList.add('hidden')" class="px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-lg">Cancel</button>
        </div>
      </form>
    </div>
    <!-- Drag & Drop Upload Zone -->
    <div id="plan-drop-zone" class="relative border-2 border-dashed border-gray-300 rounded-xl p-6 mb-4 text-center transition-all duration-200 hover:border-brand-400 hover:bg-brand-50/30 cursor-pointer"
      ondragover="event.preventDefault(); this.classList.add('border-brand-500','bg-brand-50')"
      ondragleave="this.classList.remove('border-brand-500','bg-brand-50')"
      ondrop="handlePlanDrop(event, this)"
      onclick="document.getElementById('plan-file-input').click()">
      <input type="file" id="plan-file-input" accept=".pdf,.dwg,.dxf,.png,.jpg,.jpeg" multiple class="hidden" onchange="handlePlanFileSelect(this)">
      <div id="plan-drop-idle">
        <svg class="w-8 h-8 mx-auto mb-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
        <p class="text-sm font-medium text-gray-600">Drop TGS / TMP / CTMP files here — several at once is fine</p>
        <p class="text-xs text-gray-400 mt-0.5">or click to browse — PDF, DWG, images accepted (up to 10 files)</p>
      </div>
      <div id="plan-drop-uploading" class="hidden">
        <svg class="w-8 h-8 mx-auto mb-2 text-brand-500 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
        <p class="text-sm font-medium text-brand-600">Uploading...</p>
      </div>
    </div>
    <!-- Upload options (shown after file selected, before upload) -->
    <div id="plan-upload-confirm" class="hidden bg-white border border-gray-200 rounded-xl shadow-sm p-4 mb-4">
      <div class="flex items-start gap-3 mb-3">
        <svg class="w-8 h-8 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        <div class="flex-1 min-w-0">
          <p id="plan-upload-filename" class="text-sm font-medium text-gray-900"></p>
          <ul id="plan-upload-filelist" class="text-xs text-gray-600 mt-1 space-y-0.5"></ul>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex flex-col gap-2">
          <%# One checkbox set for the whole batch. %>
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" id="plan-client-provided" class="w-4 h-4 text-amber-600 border-gray-300 rounded focus:ring-amber-500">
            <span class="text-sm font-medium text-gray-700">Client Provided</span>
            <span class="inline-flex px-1.5 py-0.5 text-[10px] font-bold rounded bg-amber-50 text-amber-700 border border-amber-200">CLIENT</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" id="plan-mark-final" checked class="w-4 h-4 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500">
            <span class="text-sm font-medium text-gray-700">Visible to crew</span>
            <span class="text-xs text-gray-400">(publishes to Final Plans — crews on this job's bookings can open it)</span>
          </label>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="cancelPlanUpload()" class="px-3 py-1.5 bg-gray-100 text-gray-600 text-sm font-medium rounded-lg hover:bg-gray-200 transition-colors">Cancel</button>
          <button type="button" onclick="confirmPlanUpload()" class="px-4 py-1.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">Upload</button>
        </div>
      </div>
    </div>
    <script>
    (function() {
      let pendingFiles = [];
      const MAX_FILES = 10; // matches upload.array('plan_file', 10) on the server
      const jobId = '<%= job.id %>';
      const dropZone = document.getElementById('plan-drop-zone');
      const confirmBox = document.getElementById('plan-upload-confirm');
      const idleState = document.getElementById('plan-drop-idle');
      const uploadingState = document.getElementById('plan-drop-uploading');

      window.handlePlanDrop = function(e, el) {
        e.preventDefault();
        el.classList.remove('border-brand-500', 'bg-brand-50');
        if (e.dataTransfer.files.length > 0) showConfirm(e.dataTransfer.files);
      };

      window.handlePlanFileSelect = function(input) {
        if (input.files.length > 0) showConfirm(input.files);
        input.value = '';
      };

      function fmtSize(bytes) {
        const kb = bytes / 1024;
        return kb > 1024 ? (bytes / 1048576).toFixed(1) + ' MB' : kb.toFixed(0) + ' KB';
      }

      // One confirm card for the whole batch — a single set of checkboxes
      // applies to every file. "Visible to crew" defaults ON.
      function showConfirm(fileList) {
        pendingFiles = Array.from(fileList).slice(0, MAX_FILES);
        const dropped = fileList.length - pendingFiles.length;
        document.getElementById('plan-upload-filename').textContent =
          pendingFiles.length === 1 ? pendingFiles[0].name
            : pendingFiles.length + ' files' + (dropped > 0 ? ' (first ' + MAX_FILES + ' of ' + fileList.length + ')' : '');
        const list = document.getElementById('plan-upload-filelist');
        list.innerHTML = '';
        pendingFiles.forEach(function (f) {
          const li = document.createElement('li');
          li.className = 'truncate';
          li.textContent = f.name + ' · ' + fmtSize(f.size);
          list.appendChild(li);
        });
        document.getElementById('plan-mark-final').checked = true;
        confirmBox.classList.remove('hidden');
        dropZone.classList.add('hidden');
      }

      window.cancelPlanUpload = function() {
        pendingFiles = [];
        confirmBox.classList.add('hidden');
        dropZone.classList.remove('hidden');
      };

      window.confirmPlanUpload = function() {
        if (!pendingFiles.length) return;
        const markFinal = document.getElementById('plan-mark-final').checked;
        const clientProvided = document.getElementById('plan-client-provided').checked;

        // Show uploading state
        confirmBox.classList.add('hidden');
        dropZone.classList.remove('hidden');
        idleState.classList.add('hidden');
        uploadingState.classList.remove('hidden');

        // Whole batch in ONE request: plan numbers are generated server-side
        // from a MAX read, so parallel requests would race into UNIQUE
        // violations. The server accepts up to MAX_FILES under 'plan_file'.
        const formData = new FormData();
        pendingFiles.forEach(function (f) { formData.append('plan_file', f); });
        formData.append('job_id', jobId);
        formData.append('mark_final', markFinal ? '1' : '0');
        formData.append('client_provided', clientProvided ? '1' : '0');

        fetch('/plans/quick-upload', { method: 'POST', body: formData })
          .then(r => r.json())
          .then(data => {
            if (data.success) {
              const label = (data.count || 1) > 1
                ? (data.count + ' plans uploaded')
                : (data.planNumber + ' uploaded');
              const toast = document.createElement('div');
              toast.className = 'fixed bottom-4 right-4 bg-emerald-600 text-white px-4 py-3 rounded-lg shadow-lg z-50 flex items-center gap-2 text-sm font-medium';
              toast.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>' +
                label + (data.isFinal ? ' → visible to crew' : '');
              document.body.appendChild(toast);
              setTimeout(() => toast.remove(), 3000);
              // Reload to show new plans
              setTimeout(() => {
                if (data.isFinal) {
                  window.location.href = window.location.pathname + '#final-plans';
                  window.location.reload();
                } else {
                  window.location.reload();
                }
              }, 800);
            } else {
              alert('Upload failed: ' + (data.error || 'Unknown error'));
              resetDropZone();
            }
          })
          .catch(err => {
            alert('Upload failed: ' + err.message);
            resetDropZone();
          });
      };

      function resetDropZone() {
        pendingFiles = [];
        idleState.classList.remove('hidden');
        uploadingState.classList.add('hidden');
      }
    })();
    </script>
    <%
      // Combine traffic_plans + compliance items with plan-related types for this tab.
      // Top-level rows are parent Plans (parent_id IS NULL AND plan_number IS NOT NULL)
      // + any legacy flat compliance rows. Sub-plans nest under their parent in an
      // expandable row, mirroring the main Plans & Approvals register at /compliance.
      const planTypes = [
        'traffic_guidance','tmp_approval','spa','sza','rol',
        'council_permit','bus_approval','police_notification','letter_drop','other'
      ];
      const allCompliance = (typeof complianceItems !== 'undefined' ? complianceItems : []);
      const subsByParent = (typeof subPlansByParent !== 'undefined' && subPlansByParent) ? subPlansByParent : {};
      // Sub-plan ids — used to filter them out of the top-level list (they show
      // up nested under their parent instead).
      const subPlanIds = new Set();
      Object.keys(subsByParent).forEach(pid => (subsByParent[pid] || []).forEach(s => subPlanIds.add(s.id)));
      const allPlans = allCompliance.filter(function(c) {
        if (subPlanIds.has(c.id)) return false; // hide sub-plans at top level
        if (c.parent_id != null) return false;  // safety: any other child rows
        // Parent plans + legacy flat rows that have plan-type item_types
        const types = (c.item_types || c.item_type || '').split(',');
        const isParent = c.plan_number != null;
        return isParent || types.some(function(t) { return planTypes.includes(t.trim()); });
      });
      // Also include traffic_plans entries
      const tpEntries = typeof trafficPlans !== 'undefined' ? trafficPlans : [];
      const planTypeLabels = { traffic_guidance: 'TGS', tmp_approval: 'CTMP', spa: 'SPA', sza: 'SZA', rol: 'ROL', council_permit: 'Council', bus_approval: 'Bus', police_notification: 'Police', letter_drop: 'Letter', other: 'Other' };
      const planStatusColors = { not_started: 'bg-gray-100 text-gray-600', started: 'bg-purple-50 text-purple-700', submitted: 'bg-blue-50 text-blue-700', approved: 'bg-emerald-50 text-emerald-700', rejected: 'bg-red-50 text-red-700', expired: 'bg-amber-50 text-amber-700' };
    %>
    <% if (allPlans.length === 0 && tpEntries.length === 0) { %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 text-center">
        <p class="text-gray-400 text-sm">No traffic plans for this job yet.</p>
        <a href="/compliance/new?job_id=<%= job.id %>&return_to=/projects/<%= job.id %>%23plans" class="text-brand-600 text-sm hover:underline mt-2 inline-block">Create the first plan</a>
      </div>
    <% } else { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Title / Ref</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Types</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Designer</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Due</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Expiry</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% allPlans.forEach(function(item) {
            const isParentPlan = item.parent_id == null && item.plan_number != null;
            const subList = isParentPlan ? (subsByParent[item.id] || []) : [];
            // Parent's "Types" column derives from the actual sub-plan types,
            // not the placeholder item_type ('other') that parents carry.
            const subTypeCounts = {};
            subList.forEach(s => { subTypeCounts[s.item_type] = (subTypeCounts[s.item_type] || 0) + 1; });
            const parentTypes = Object.keys(subTypeCounts);
            const flatTypes = (item.item_types || item.item_type || '').split(',').filter(Boolean);
            const types = isParentPlan ? parentTypes : flatTypes;
          %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <a href="/compliance/<%= item.id %>/edit?return_to=/jobs/<%= job.id %>%23plans" class="text-brand-600 hover:text-brand-700 font-medium"><%= item.title %></a>
              <% if (isParentPlan) { %>
                <button type="button" class="job-plan-toggle inline-flex items-center gap-1 text-xs font-mono font-semibold text-brand-700 hover:text-brand-800 mt-0.5"
                  data-target="job-plan-exp-<%= item.id %>" title="Click to see <%= subList.length %> sub-plan<%= subList.length === 1 ? '' : 's' %>">
                  <svg class="w-3 h-3 chevron transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
                  #<%= item.plan_number %>
                  <span class="text-[10px] font-sans font-normal text-gray-400">(<%= subList.length %>)</span>
                </button>
              <% } else if (item.reference_number) { %>
                <div class="text-xs text-gray-400"><%= item.reference_number %></div>
              <% } %>
            </td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap gap-1">
                <% types.forEach(function(t) { %>
                  <span class="inline-flex px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-blue-50 text-blue-700"><%= planTypeLabels[t] || t %><% if (isParentPlan && subTypeCounts[t] > 1) { %> ×<%= subTypeCounts[t] %><% } %></span>
                <% }) %>
                <% if (isParentPlan && types.length === 0) { %>
                  <span class="text-[11px] text-gray-400 italic">empty plan</span>
                <% } %>
              </div>
            </td>
            <td class="px-4 py-3 text-gray-600 text-xs"><%= item.designer || item.approver_name || '-' %></td>
            <td class="px-4 py-3">
              <span class="inline-flex px-2 py-0.5 text-[10px] font-bold rounded-full <%= planStatusColors[item.status] || 'bg-gray-100 text-gray-600' %>"><%= (item.status || 'not_started').replace(/_/g, ' ') %></span>
            </td>
            <td class="px-4 py-3 text-gray-500 text-xs"><%= item.due_date ? formatDateShort(item.due_date) : '-' %></td>
            <td class="px-4 py-3 text-gray-500 text-xs"><%= item.expiry_date ? formatDateShort(item.expiry_date) : '-' %></td>
            <td class="px-4 py-3 whitespace-nowrap">
              <a href="/compliance/<%= item.id %>/edit?return_to=/jobs/<%= job.id %>%23plans" class="text-brand-600 hover:text-brand-700 text-xs font-medium mr-2">Edit</a>
              <form method="POST" action="/jobs/<%= job.id %>/unlink-compliance" class="inline" onsubmit="return confirm('Unlink this item from the job?')">
                <%- include('../partials/csrf') %>
                <input type="hidden" name="compliance_id" value="<%= item.id %>">
                <input type="hidden" name="redirect_hash" value="plans">
                <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-medium">Unlink</button>
              </form>
            </td>
          </tr>
          <% if (isParentPlan) { %>
            <tr id="job-plan-exp-<%= item.id %>" class="hidden bg-gray-50/60">
              <td colspan="7" class="px-6 py-3 border-l-2 border-l-brand-300">
                <% if (subList.length === 0) { %>
                  <div class="text-xs text-gray-500 italic">No sub-plans yet — open the Plan to add some.</div>
                <% } else { %>
                  <div class="text-[11px] uppercase tracking-wide text-gray-400 font-semibold mb-2">Sub-plans (#<%= item.plan_number %>)</div>
                  <table class="w-full text-xs">
                    <thead class="text-gray-500">
                      <tr class="text-left">
                        <th class="font-medium pb-1.5 pr-3">Reference</th>
                        <th class="font-medium pb-1.5 pr-3">Type</th>
                        <th class="font-medium pb-1.5 pr-3">Description</th>
                        <th class="font-medium pb-1.5 pr-3">Owner</th>
                        <th class="font-medium pb-1.5 pr-3">Status</th>
                        <th class="font-medium pb-1.5 pr-3">Expires</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% subList.forEach(function(s) { %>
                        <tr class="border-t border-gray-200 hover:bg-white">
                          <td class="py-1.5 pr-3 font-mono text-gray-700"><a href="/compliance/<%= s.id %>/edit?return_to=/jobs/<%= job.id %>%23plans" class="text-brand-600 hover:text-brand-700"><%= s.reference_number || '—' %></a></td>
                          <td class="py-1.5 pr-3"><span class="inline-flex px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-blue-50 text-blue-700"><%= planTypeLabels[s.item_type] || s.item_type %></span></td>
                          <td class="py-1.5 pr-3 text-gray-700"><%= s.description || s.title || '—' %></td>
                          <td class="py-1.5 pr-3 text-gray-600"><%= s.owner_name || '—' %></td>
                          <td class="py-1.5 pr-3"><span class="inline-flex px-1.5 py-0.5 text-[10px] font-bold rounded-full <%= planStatusColors[s.status] || 'bg-gray-100 text-gray-600' %>"><%= (s.status || 'not_started').replace(/_/g, ' ') %></span></td>
                          <td class="py-1.5 pr-3 text-gray-500"><%= s.expiry_date ? formatDateShort(s.expiry_date) : '—' %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                <% } %>
              </td>
            </tr>
          <% } %>
          <% }) %>
          <% tpEntries.forEach(function(tp) { %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <% if (tp.file_path) { %>
                <a href="/<%= tp.file_path %>" target="_blank" class="text-brand-600 hover:text-brand-700 font-medium"><%= tp.notes || tp.plan_number %></a>
              <% } else { %>
                <span class="text-gray-900 font-medium"><%= tp.notes || tp.plan_number %></span>
              <% } %>
              <div class="text-xs text-gray-400"><%= tp.plan_number %></div>
            </td>
            <td class="px-4 py-3">
              <div class="flex flex-wrap gap-1">
                <span class="inline-flex px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-blue-50 text-blue-700"><%= tp.plan_type %></span>
                <% if (tp.designer === 'Client Provided') { %>
                  <span class="inline-flex px-1.5 py-0.5 text-[10px] font-bold rounded bg-amber-50 text-amber-700 border border-amber-200">CLIENT</span>
                <% } %>
              </div>
            </td>
            <td class="px-4 py-3 text-gray-600 text-xs"><%= tp.designer && tp.designer !== 'Client Provided' ? tp.designer : '-' %></td>
            <td class="px-4 py-3">
              <span class="inline-flex px-2 py-0.5 text-[10px] font-bold rounded-full
                <% if (tp.is_final) { %>bg-emerald-50 text-emerald-700
                <% } else if (tp.status === 'approved') { %>bg-emerald-50 text-emerald-700
                <% } else if (tp.status === 'submitted') { %>bg-blue-50 text-blue-700
                <% } else { %>bg-gray-100 text-gray-600<% } %>"><%= tp.is_final ? 'FINAL' : (tp.status ? tp.status.replace(/_/g, ' ') : 'draft') %></span>
              <% if (tp.current_revision_label && tp.current_revision_label !== 'Rev A') { %>
                <span class="ml-1 text-[10px] text-gray-400"><%= tp.current_revision_label %></span>
              <% } %>
            </td>
            <td class="px-4 py-3 text-gray-500 text-xs"><%= tp.submitted_date ? formatDate(tp.submitted_date) : '-' %></td>
            <td class="px-4 py-3 text-gray-500 text-xs"><%= tp.expiry_date ? formatDate(tp.expiry_date) : '-' %></td>
            <td class="px-4 py-3 whitespace-nowrap">
              <% if (tp.file_path) { %>
                <a href="/<%= tp.file_path %>" target="_blank" class="text-brand-600 hover:text-brand-700 text-xs font-medium mr-2">View</a>
              <% } %>
              <a href="/plans/<%= tp.id %>/edit?return_to=/jobs/<%= job.id %>%23plans" class="text-gray-500 hover:text-brand-600 text-xs font-medium mr-2">Edit</a>
              <% if (tp.is_final) { %>
                <form method="POST" action="/plans/<%= tp.id %>/revoke-final" class="inline" onsubmit="return confirm('Revoke this plan from operations? They will no longer see it.')">
                  <%- include('../partials/csrf') %>
                  <input type="hidden" name="return_to" value="/jobs/<%= job.id %>#plans">
                  <button type="submit" class="text-amber-600 hover:text-amber-700 text-xs font-medium mr-2">Revoke Final</button>
                </form>
              <% } else { %>
                <form method="POST" action="/plans/<%= tp.id %>/mark-final" class="inline" onsubmit="return confirm('Publish this plan to operations? They will be able to view and download it.')">
                  <%- include('../partials/csrf') %>
                  <input type="hidden" name="return_to" value="/jobs/<%= job.id %>#plans">
                  <button type="submit" class="text-emerald-600 hover:text-emerald-700 text-xs font-medium mr-2">Mark Final</button>
                </form>
              <% } %>
              <form method="POST" action="/plans/<%= tp.id %>/delete" class="inline" onsubmit="return confirm('Delete this plan? This cannot be undone.')">
                <%- include('../partials/csrf') %>
                <input type="hidden" name="return_to" value="/jobs/<%= job.id %>#plans">
                <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-medium">Delete</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
    <script>
      // Expand/collapse a parent Plan's sub-plan list. Mirrors the chevron
      // toggle behaviour on the main /compliance register.
      document.querySelectorAll('.job-plan-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var row = document.getElementById(btn.dataset.target);
          if (!row) return;
          row.classList.toggle('hidden');
          var chev = btn.querySelector('.chevron');
          if (chev) chev.classList.toggle('rotate-90');
        });
      });
    </script>
  </div>
  <% } %>

