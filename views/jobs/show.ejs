              </td>
              <td class="px-4 py-3 text-xs text-gray-600 max-w-xs truncate"><%= inc.title || (inc.description ? inc.description.substring(0, 80) : '—') %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium ring-1 ring-inset <%= INCIDENT_STATUS_BADGE[st] || 'bg-gray-100 text-gray-600 ring-gray-300' %>"><%= st.replace(/_/g, ' ') %></span>
              </td>
              <td class="px-4 py-3 text-right">
