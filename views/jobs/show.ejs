                </td>
                <td class="px-4 py-2.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium
                    <% const cls = { open: 'bg-gray-100 text-gray-700', picked_up: 'bg-blue-50 text-blue-700', returned: 'bg-amber-50 text-amber-700', closed: 'bg-emerald-50 text-emerald-700' }[d.status] || 'bg-gray-100 text-gray-600'; %>
