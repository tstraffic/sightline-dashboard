                  <span class="text-sm font-semibold <%= pct >= 95 ? 'text-emerald-700' : pct >= 85 ? 'text-amber-700' : 'text-rose-700' %>"><%= pct %>%</span>
                  <% if (a.score_max) { %><span class="text-[10px] text-gray-400 ml-1">(<%= a.score_total %>/<%= a.score_max %>)</span><% } %>
                <% } else { %>
