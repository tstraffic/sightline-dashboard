  <!-- Register admin service worker -->
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/admin-sw.js?v=41', { updateViaCache: 'none' })
        .then(function(reg) {
          reg.update();
          console.log('Admin SW registered, scope:', reg.scope);
        })
        .catch(function(err) { console.log('Admin SW registration failed:', err); });
      // Auto-refresh when new SW activates — but at most twice per 2 minutes
      // per tab. During a rolling deploy the old and new containers briefly
      // serve different SW bytes; each flip registers as an "update", and an
      // unguarded reload-on-update loops the page until the old instance
      // drains. sessionStorage survives reloads (per-tab), so it can count.
      navigator.serviceWorker.addEventListener('message', function(e) {
        if (!e.data || e.data.type !== 'SW_UPDATED') return;
        try {
          var now = Date.now();
          var log = (sessionStorage.getItem('__sw_reloads') || '').split(',')
            .filter(Boolean).map(Number).filter(function (t) { return now - t < 120000; });
          if (log.length >= 2) return; // reload loop — stay on the current bundle
          log.push(now);
          sessionStorage.setItem('__sw_reloads', log.join(','));
          window.location.reload();
        } catch (err) { /* storage blocked — never risk a loop */ }
      });
    }
  </script>

  <!-- Global Quick Actions FAB — bottom-right, visible everywhere admin
       so the user can spawn the most-used flows from any page. Replaces
       the per-page dashboard Quick Actions strip. -->
  <% if (typeof user !== 'undefined' && user) { %>
  <!-- bottom: 76px so the New FAB stacks above the IT Feedback pill
       (Feedback sits at bottom: 20px right: 20px). z-40 keeps both
       above page content but below the lightbox / slide-overs. -->
  <div class="fixed right-5 z-40 print:hidden" id="globalFab" style="bottom: 76px">
    <div id="globalFabMenu" class="hidden flex-col-reverse gap-2 mb-3">
      <% if (canAccess(user, 'jobs')) { %>
      <a href="/jobs/new" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:translate-x-[-2px] transition-transform">
