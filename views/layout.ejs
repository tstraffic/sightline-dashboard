      <% } %>
    </div>
    <button type="button" id="globalFabToggle" aria-label="Quick actions" title="Quick actions"
      class="group flex items-center gap-2 h-11 px-4 text-white text-sm font-medium transition-transform"
      style="background:#22262F;border:1px solid rgba(255,255,255,0.08);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,0.35)">
      <svg id="globalFabIcon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      <span class="hidden sm:inline">New</span>
    </button>
  </div>
  <script>
  (function(){
    const btn = document.getElementById('globalFabToggle');
    const menu = document.getElementById('globalFabMenu');
    const icon = document.getElementById('globalFabIcon');
    if (!btn || !menu) return;
    function close() {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      icon.classList.remove('rotate-45');
    }
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle('hidden');
      menu.classList.toggle('flex', !open);
      icon.classList.toggle('rotate-45', !open);
    });
    // Click-outside dismiss
    document.addEventListener('click', (e) => {
      if (menu.classList.contains('hidden')) return;
      if (!e.target.closest('#globalFab')) close();
    });
    // Esc dismiss
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  })();
  </script>
  <% } %>

