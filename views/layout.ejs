<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <script>
    // Theme bootstrap — runs before render to prevent FOUC
    (function () {
      try {
        var saved = localStorage.getItem('atomis-theme');
        var t = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
    window.toggleAtomisTheme = function () {
      var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      var next = cur === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('atomis-theme', next); } catch (e) {}
      document.dispatchEvent(new CustomEvent('atomis:theme', { detail: next }));
    };
    // Delegated click handler — bulletproofs the inline onclick on
    // .theme-toggle. If the inline handler ever fails to fire (stale SW
    // cache, CSP, click swallowed by SVG child, etc.) this still catches
    // the click via bubble phase.
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.theme-toggle');
      if (!btn) return;
      e.preventDefault();
      window.toggleAtomisTheme();
    });
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>T&S Traffic Control</title>

  <!-- PWA Meta Tags -->
  <meta name="theme-color" content="#0F1115">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="T&S">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="application-name" content="T&S Traffic Control">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="manifest" href="/manifest-admin.json">
  <link rel="icon" type="image/svg+xml" href="/images/atomis-favicon-dark.svg">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/atomis-icon-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/images/atomis-icon-512.png">
  <link rel="apple-touch-icon" href="/images/atomis-apple-touch-icon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/atomis-apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="T&S">
  <meta name="theme-color" content="#10B981">

  <!-- Atomis typography: Bricolage Grotesque (display) · Geist (body/UI) · Geist Mono (technical) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Geist', 'Inter', 'system-ui', '-apple-system', 'sans-serif'],
            display: ['"Bricolage Grotesque"', 'Geist', 'system-ui', 'sans-serif'],
            mono: ['"Geist Mono"', 'JetBrains Mono', 'ui-monospace', 'monospace'],
          },
          colors: {
            brand: {
              50:  '#ECFDF5',
              100: '#D1FAE5',
              200: '#A7F3D0',
              300: '#6EE7B7',
              400: '#34D399',
              500: '#10B981',
              600: '#059669',
              700: '#047857',
              800: '#065F46',
              900: '#064E3B',
              950: '#022C22',
            },
            atomis: {
              base: '#0F1115',
              surface: '#1A1D24',
              'surface-2': '#22262F',
              text: '#F5F5F7',
              'text-mute': '#8B8E95',
              'text-faint': '#5A5D64',
              warning: '#FBBF24',
              danger: '#EF4444',
            }
          },
          boxShadow: {
            'card': '0 1px 3px rgba(0,0,0,0.04), 0 1px 2px rgba(0,0,0,0.06)',
            'card-hover': '0 10px 25px -5px rgba(0,0,0,0.08), 0 4px 10px -5px rgba(0,0,0,0.04)',
            'glow': '0 0 20px rgba(16,185,129,0.18)',
          },
          borderRadius: {
            '2xl': '1rem',
            '3xl': '1.25rem',
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/custom.css?v=atomis-1">
  <link rel="stylesheet" href="/css/chat.css?v=atomis-1">
  <style>/* Hide Tailwind CDN dev indicator */#__tailwind_indicator,div[style*="z-index: 2147483647"]{display:none!important}</style>
</head>
<body class="h-full text-gray-900 font-sans antialiased dark-glass">
  <%- include('partials/staging-badge') %>
  <div class="flex h-full">
    <%- include('partials/sidebar') %>

    <div class="flex-1 flex flex-col min-w-0 min-h-screen">
      <%- include('partials/header') %>

      <main class="flex-1 overflow-auto min-w-0">
      <div class="px-3 sm:px-4 md:px-6 lg:px-8 py-4 sm:py-6">
        <% if (typeof flash_success !== 'undefined' && flash_success.length > 0) { %>
          <% flash_success.forEach(msg => { %>
            <div class="flash-msg mb-4 p-3.5 bg-emerald-50 border border-emerald-200/80 rounded-xl text-emerald-800 text-sm flex items-center gap-3 shadow-sm">
              <div class="w-6 h-6 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="flex-1 font-medium"><%= msg %></span>
              <button onclick="this.parentElement.style.opacity='0';this.parentElement.style.transform='translateY(-8px)';setTimeout(()=>this.parentElement.remove(),200)" class="text-emerald-400 hover:text-emerald-600 flex-shrink-0 p-1 rounded-lg hover:bg-emerald-100 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
          <% }) %>
        <% } %>
        <% if (typeof flash_error !== 'undefined' && flash_error.length > 0) { %>
          <% flash_error.forEach(msg => { %>
            <div class="flash-msg mb-4 p-3.5 bg-red-50 border border-red-200/80 rounded-xl text-red-800 text-sm flex items-center gap-3 shadow-sm">
              <div class="w-6 h-6 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01"/></svg>
              </div>
              <span class="flex-1 font-medium"><%= msg %></span>
              <button onclick="this.parentElement.style.opacity='0';this.parentElement.style.transform='translateY(-8px)';setTimeout(()=>this.parentElement.remove(),200)" class="text-red-400 hover:text-red-600 flex-shrink-0 p-1 rounded-lg hover:bg-red-100 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
          <% }) %>
        <% } %>

        <%- body %>
      </div>
      <%- include('partials/footer') %>
    </main>
    </div>
  </div>

  <script src="/js/step-wizard.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/dropzone.js"></script>
  <script src="/js/chat.js?v=3"></script>
  <%- script %>

  <!-- Register admin service worker -->
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/admin-sw.js?v=28', { updateViaCache: 'none' })
        .then(function(reg) {
          reg.update();
          console.log('Admin SW registered, scope:', reg.scope);
        })
        .catch(function(err) { console.log('Admin SW registration failed:', err); });
      // Auto-refresh when new SW activates
      navigator.serviceWorker.addEventListener('message', function(e) {
        if (e.data && e.data.type === 'SW_UPDATED') window.location.reload();
      });
    }
  </script>

  <!-- Global Quick Actions FAB — bottom-right, visible everywhere admin
       so the user can spawn the most-used flows from any page. Replaces
       the per-page dashboard Quick Actions strip. -->
  <% if (typeof user !== 'undefined' && user) { %>
  <div class="fixed bottom-5 right-5 z-40 print:hidden" id="globalFab">
    <div id="globalFabMenu" class="hidden flex-col-reverse gap-2 mb-3">
      <% if (canAccess(user, 'jobs')) { %>
      <a href="/jobs/new" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:translate-x-[-2px] transition-transform">
        <span class="w-7 h-7 bg-brand-100 text-brand-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        </span>
        New Job
      </a>
      <% } %>
      <% if (canAccess(user, 'tasks')) { %>
      <a href="/tasks" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
        <span class="w-7 h-7 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"/></svg>
        </span>
        Tasks
      </a>
      <% } %>
      <% if (canAccess(user, 'incidents')) { %>
      <a href="/incidents/new" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
        <span class="w-7 h-7 bg-red-100 text-red-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
        </span>
        Report Incident
      </a>
      <% } %>
      <% if (canAccess(user, 'allocations')) { %>
      <a href="/allocations" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
        <span class="w-7 h-7 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </span>
        Allocations
      </a>
      <% } %>
      <% if (canAccess(user, 'compliance')) { %>
      <a href="/compliance" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
        <span class="w-7 h-7 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </span>
        Compliance
      </a>
      <% } %>
    </div>
    <button type="button" id="globalFabToggle" aria-label="Quick actions" title="Quick actions"
      class="group flex items-center gap-2 h-11 px-4 text-white text-sm font-medium transition-transform"
      style="background:#22262F;border:1px solid rgba(255,255,255,0.08);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,0.35)">
      <svg id="globalFabIcon" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
      <span class="hidden sm:inline">New</span>
    </button>
  </div>
  <script>
  (function(){
    const btn = document.getElementById('globalFabToggle');
    const menu = document.getElementById('globalFabMenu');
    const icon = document.getElementById('globalFabIcon');
    if (!btn || !menu) return;
    function close() {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      icon.classList.remove('rotate-45');
    }
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle('hidden');
      menu.classList.toggle('flex', !open);
      icon.classList.toggle('rotate-45', !open);
    });
    // Click-outside dismiss
    document.addEventListener('click', (e) => {
      if (menu.classList.contains('hidden')) return;
      if (!e.target.closest('#globalFab')) close();
    });
    // Esc dismiss
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  })();
  </script>
  <% } %>

  <!-- Global Lightbox overlay for images & documents -->
  <div id="lightbox-overlay" class="fixed inset-0 z-[9999] bg-black/90 hidden flex-col items-center justify-center" style="display:none;">
    <div class="absolute top-0 left-0 right-0 flex items-center justify-between px-4 py-3 bg-gradient-to-b from-black/60 to-transparent z-10">
      <span id="lightbox-title" class="text-white text-sm font-medium truncate max-w-[70%]"></span>
      <div class="flex items-center gap-3">
        <a id="lightbox-download" href="#" download class="text-white/80 hover:text-white p-2" title="Download">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        </a>
        <a id="lightbox-newtab" href="#" target="_blank" class="text-white/80 hover:text-white p-2" title="Open in new tab">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <button id="lightbox-close" class="text-white hover:text-red-400 p-2 -mr-2" title="Close">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <img id="lightbox-img" src="" alt="" class="hidden max-w-[95vw] max-h-[85vh] object-contain rounded shadow-2xl select-none" draggable="false">
    <iframe id="lightbox-iframe" src="" class="hidden rounded shadow-2xl bg-white" style="width:90vw;height:85vh;"></iframe>
  </div>
  <script>
  (function(){
    var overlay = document.getElementById('lightbox-overlay');
    var img = document.getElementById('lightbox-img');
    var iframe = document.getElementById('lightbox-iframe');
    var title = document.getElementById('lightbox-title');
    var dl = document.getElementById('lightbox-download');
    var nt = document.getElementById('lightbox-newtab');
    var closeBtn = document.getElementById('lightbox-close');
    if (!overlay) return;

    function openLightbox(href, name, isImage) {
      img.classList.add('hidden'); iframe.classList.add('hidden');
      if (isImage) { img.src = href; img.classList.remove('hidden'); }
      else { iframe.src = href; iframe.classList.remove('hidden'); }
      title.textContent = name || '';
      dl.href = href; nt.href = href;
      overlay.style.display = 'flex'; overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      overlay.style.display = 'none'; overlay.classList.add('hidden');
      img.src = ''; iframe.src = '';
      document.body.style.overflow = '';
    }

    closeBtn.addEventListener('click', closeLightbox);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeLightbox();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.style.display === 'flex') closeLightbox();
    });

    // Delegate clicks on any [data-lightbox] links
    document.addEventListener('click', function(e) {
      var link = e.target.closest('[data-lightbox]');
      if (!link) return;
      e.preventDefault();
      var href = link.getAttribute('href') || link.getAttribute('data-lightbox');
      var name = link.getAttribute('data-lightbox-name') || link.getAttribute('title') || '';
      var mime = (link.getAttribute('data-lightbox-mime') || '').toLowerCase();
      var isImage = mime.startsWith('image/') || /\.(jpg|jpeg|png|gif|webp|heic)$/i.test(href);
      openLightbox(href, name, isImage);
    });
  })();
  </script>
</body>
</html>
