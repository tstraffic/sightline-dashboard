          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        </span>
        New Job
      </a>
      <% } %>
      <% if (canAccess(user, 'tasks')) { %>
      <a href="/tasks" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
        <span class="w-7 h-7 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"/></svg>
        </span>
        Tasks
      </a>
      <% } %>
      <% if (canAccess(user, 'incidents')) { %>
      <a href="/incidents/new" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
        <span class="w-7 h-7 bg-red-100 text-red-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
        </span>
        Report Incident
      </a>
      <% } %>
      <% if (canAccess(user, 'allocations')) { %>
      <a href="/allocations" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
        <span class="w-7 h-7 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </span>
        Allocations
      </a>
      <% } %>
      <% if (canAccess(user, 'compliance')) { %>
      <a href="/compliance" class="fab-item flex items-center gap-2 bg-white shadow-lg rounded-full pl-2.5 pr-4 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
        <span class="w-7 h-7 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </span>
        Plans
