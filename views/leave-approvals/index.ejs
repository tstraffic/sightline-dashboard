<% locals.currentPage = 'leave-approvals' %>
<%
  // Everything here is composed from existing admin devices — .stat-card
  // (admin-polish §9), .panel-header (§17), the induction pill tabs and the
  // timesheets filter shell. The old version shipped 181 lines of bespoke
  // .la-* CSS plus <meta color-scheme="light only">, which opted the page
  // out of the app's dark-first theme and then patched it back by hand.

  function buildUrl(overrides) {
    const q = Object.assign({}, filters, overrides);
    const parts = Object.keys(q)
      .filter(k => q[k] !== '' && q[k] != null && !(k === 'view' && q[k] === 'list'))
      .map(k => k + '=' + encodeURIComponent(q[k]));
    return '/leave-approvals' + (parts.length ? '?' + parts.join('&') : '');
  }

  const TYPE_PILL = {
    annual:   'bg-blue-50 text-blue-700 ring-blue-600/20',
    sick:     'bg-red-50 text-red-700 ring-red-600/20',
    personal: 'bg-purple-50 text-purple-700 ring-purple-600/20',
    unpaid:   'bg-gray-100 text-gray-600 ring-gray-500/20',
    other:    'bg-amber-50 text-amber-700 ring-amber-600/20',
  };
  const STATUS_PILL = {
    pending:   { label: 'Pending',   cls: 'bg-amber-50 text-amber-700 ring-amber-600/20' },
    approved:  { label: 'Approved',  cls: 'bg-emerald-50 text-emerald-700 ring-emerald-600/20' },
    rejected:  { label: 'Rejected',  cls: 'bg-red-50 text-red-700 ring-red-600/20' },
    cancelled: { label: 'Cancelled', cls: 'bg-gray-100 text-gray-500 ring-gray-500/20' },
  };

  // start_date/end_date are bare DATE columns — formatDateShort handles them
  // without a timezone shift. created_at/approved_at are UTC datetimes and
  // go through formatDateTime, which converts properly. The old view parsed
  // those as local and THEN converted to Sydney: ~20h of double-shift.
  function span(r) {
    if (r.start_date === r.end_date) return formatDateShort(r.start_date);
    return formatDateShort(r.start_date) + ' → ' + formatDateShort(r.end_date);
  }
  function initials(name) {
    return (name || '?').split(' ').filter(Boolean).map(p => p[0]).join('').slice(0, 2).toUpperCase();
  }
%>

<div class="space-y-5">
  <%- include('../partials/page-header', { rail: true, wrapperClass: '',
    eyebrow: 'Operations',
    title: 'Leave Approvals',
    subtitle: 'One card per request · decide a whole block at once'
  }) %>

  <!-- Stat tiles double as status filters. -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
    <a href="<%= buildUrl({ status: 'pending', from: '', to: '' }) %>" class="stat-card <%= filters.status === 'pending' ? 'ring-2 ring-amber-500' : '' %>">
      <p class="stat-card-label">Needs decision</p>
      <p class="stat-card-value <%= counts.pending > 0 ? 'is-warn' : 'is-muted' %>"><%= counts.pending %></p>
    </a>
    <a href="<%= buildUrl({ status: 'pending', from: '', to: '' }) %>" class="stat-card accent-amber">
      <p class="stat-card-label">Starting ≤ 7 days</p>
      <p class="stat-card-value <%= counts.actionNow > 0 ? 'is-critical' : 'is-muted' %>"><%= counts.actionNow %></p>
    </a>
    <a href="<%= buildUrl({ status: 'approved' }) %>" class="stat-card <%= filters.status === 'approved' ? 'ring-2 ring-emerald-500' : '' %>">
      <p class="stat-card-label">Approved</p>
      <p class="stat-card-value <%= counts.approved > 0 ? 'is-good' : 'is-muted' %>"><%= counts.approved %></p>
    </a>
    <a href="<%= buildUrl({ status: 'rejected' }) %>" class="stat-card <%= filters.status === 'rejected' ? 'ring-2 ring-red-500' : '' %>">
      <p class="stat-card-label">Rejected</p>
      <p class="stat-card-value is-muted"><%= counts.rejected %></p>
    </a>
    <a href="<%= buildUrl({ status: 'cancelled' }) %>" class="stat-card <%= filters.status === 'cancelled' ? 'ring-2 ring-gray-400' : '' %>">
      <p class="stat-card-label">Cancelled</p>
      <p class="stat-card-value is-muted"><%= counts.cancelled %></p>
    </a>
  </div>

  <!-- Status tabs + list/calendar toggle -->
  <div class="flex items-center justify-between gap-3 flex-wrap">
    <div class="flex flex-wrap items-center gap-2">
      <%
        const tabs = [
          { key: 'pending',   label: 'Pending',   count: counts.pending,   dot: 'bg-amber-500',   active: 'bg-amber-50 text-amber-800 ring-1 ring-amber-300 shadow-sm' },
          { key: 'approved',  label: 'Approved',  count: counts.approved,  dot: 'bg-emerald-500', active: 'bg-emerald-50 text-emerald-800 ring-1 ring-emerald-300 shadow-sm' },
          { key: 'rejected',  label: 'Rejected',  count: counts.rejected,  dot: 'bg-red-500',     active: 'bg-red-50 text-red-800 ring-1 ring-red-300 shadow-sm' },
          { key: 'cancelled', label: 'Cancelled', count: counts.cancelled, dot: 'bg-gray-400',    active: 'bg-gray-100 text-gray-800 ring-1 ring-gray-300 shadow-sm' },
          { key: 'all',       label: 'All',       count: counts.all,       dot: 'bg-brand-500',   active: 'bg-white text-gray-900 ring-1 ring-gray-300 shadow-sm' },
        ];
      %>
      <% tabs.forEach(function (t) { const isOn = filters.status === t.key; %>
        <a href="<%= buildUrl({ status: t.key }) %>" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-sm font-semibold transition <%= isOn ? t.active : 'bg-gray-50 text-gray-600 hover:bg-gray-100 border border-gray-200' %>">
          <span class="w-2 h-2 rounded-full <%= t.dot %>"></span>
          <%= t.label %>
          <span class="inline-flex items-center justify-center px-1.5 min-w-[1.5rem] h-5 rounded-full text-[11px] font-bold <%= isOn ? 'bg-white/70 text-gray-900' : 'bg-gray-200 text-gray-600' %>"><%= t.count %></span>
        </a>
      <% }) %>
    </div>
    <div class="flex rounded-lg overflow-hidden border border-gray-200 text-sm flex-shrink-0">
      <a href="<%= buildUrl({ view: 'list' }) %>" class="px-3 py-1.5 font-medium transition <%= filters.view === 'list' ? 'bg-brand-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-50' %>">List</a>
      <a href="<%= buildUrl({ view: 'calendar' }) %>" class="px-3 py-1.5 font-medium transition border-l border-gray-200 <%= filters.view === 'calendar' ? 'bg-brand-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-50' %>">Calendar</a>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <form method="GET" action="/leave-approvals" class="flex flex-col sm:flex-row sm:flex-wrap sm:items-end gap-2 sm:gap-3">
      <input type="hidden" name="status" value="<%= filters.status %>">
      <input type="hidden" name="view" value="<%= filters.view %>">
      <div class="flex-1 min-w-0 sm:min-w-[180px]">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">Search</label>
        <input type="text" name="q" value="<%= filters.q %>" placeholder="Name, employee ID or reason"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <div class="sm:min-w-[160px]">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">Worker</label>
        <select name="crew_member_id" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">All workers</option>
          <% crew.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= String(filters.crew_member_id) === String(c.id) ? 'selected' : '' %>><%= c.full_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="sm:min-w-[130px]">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">Type</label>
        <select name="leave_type" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <option value="">All types</option>
          <% ['annual','sick','personal','unpaid','other'].forEach(function (t) { %>
            <option value="<%= t %>" <%= filters.leave_type === t ? 'selected' : '' %>><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">From</label>
        <input type="date" name="from" value="<%= filters.from %>" class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">To</label>
        <input type="date" name="to" value="<%= filters.to %>" class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div class="flex gap-2">
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">Apply</button>
        <a href="/leave-approvals" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium rounded-lg transition-colors">Clear</a>
      </div>
    </form>
  </div>

<% if (filters.view === 'calendar' && calendar) { %>
  <!-- ── Calendar ─────────────────────────────────────────────────── -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="panel-header">
      <h2 class="panel-header-title"><%= calendar.label %></h2>
      <div class="ml-auto flex items-center gap-1">
        <a href="<%= buildUrl({ view: 'calendar', month: calendar.prev }) %>" class="p-1.5 rounded hover:bg-gray-100 text-gray-500 transition" title="Previous month" aria-label="Previous month">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </a>
        <a href="<%= buildUrl({ view: 'calendar', month: '' }) %>" class="px-2 py-1 rounded text-xs font-semibold text-gray-500 hover:bg-gray-100 transition">Today</a>
        <a href="<%= buildUrl({ view: 'calendar', month: calendar.next }) %>" class="p-1.5 rounded hover:bg-gray-100 text-gray-500 transition" title="Next month" aria-label="Next month">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
    <div class="p-3 overflow-x-auto">
      <table class="w-full table-fixed" style="min-width:720px;">
        <thead>
          <tr>
            <% ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(function (d) { %>
              <th class="w-[14.28%] px-2 py-1.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest"><%= d %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% calendar.weeks.forEach(function (week) { %>
            <tr>
              <% week.forEach(function (cell) { %>
                <td class="p-1 align-top h-24 border border-gray-100">
                  <% if (cell) { %>
                    <div class="h-full rounded-lg p-1.5 <%= cell.isToday ? 'bg-brand-50 ring-1 ring-brand-300' : '' %>">
                      <div class="flex items-center justify-between mb-1">
                        <span class="text-[11px] font-semibold <%= cell.isToday ? 'text-brand-700' : 'text-gray-500' %>"><%= cell.day %></span>
                        <% if (cell.people.length) { %>
                          <span class="text-[10px] font-bold text-gray-400"><%= cell.people.length %> off</span>
                        <% } %>
                      </div>
                      <% cell.people.slice(0, 3).forEach(function (p) { %>
                        <div class="truncate text-[10px] px-1 py-0.5 mb-0.5 rounded <%= p.status === 'approved' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700 ring-1 ring-amber-200' %>"
                             title="<%= p.crew_name || 'Unknown' %> · <%= p.leave_type %> · <%= p.status %>">
                          <%= p.crew_name || 'Unknown' %>
                        </div>
                      <% }) %>
                      <% if (cell.people.length > 3) { %>
                        <div class="text-[10px] text-gray-400 px-1">+<%= cell.people.length - 3 %> more</div>
                      <% } %>
                    </div>
                  <% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="mt-2 text-[11px] text-gray-400 flex items-center gap-3">
        <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded bg-emerald-100 border border-emerald-300"></span> Approved</span>
        <span class="inline-flex items-center gap-1"><span class="w-2.5 h-2.5 rounded bg-amber-50 border border-amber-300"></span> Pending</span>
      </p>
    </div>
  </div>
<% } else { %>

  <!-- ── Pending queue ────────────────────────────────────────────── -->
  <% if (filters.status === 'pending' || filters.status === 'all') { %>
    <%
      const pendingSections = [
        { key: 'actionNow', title: 'Action now', hint: 'Starts within 7 days', rows: buckets.actionNow, critical: true },
        { key: 'thisMonth', title: 'This month', hint: '',                     rows: buckets.thisMonth, critical: false },
        { key: 'later',     title: 'Later',      hint: '',                     rows: buckets.later,     critical: false },
      ];
      const totalPending = buckets.actionNow.length + buckets.thisMonth.length + buckets.later.length;
    %>

    <% if (totalPending === 0) { %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8 text-center">
        <div class="w-10 h-10 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-3">
          <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        <h3 class="text-gray-900 font-semibold text-base mb-1">Nothing waiting on you</h3>
        <p class="text-gray-500 text-sm">Every leave request has been decided.</p>
      </div>
    <% } %>

    <form method="POST" action="/leave-approvals/bulk" id="leaveBulkForm">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="action" id="leaveBulkAction" value="approve">

      <% pendingSections.forEach(function (sec) { %>
        <% if (sec.rows.length) { %>
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden mb-4 <%= sec.critical ? 'chevron-rail-left is-warn' : '' %>">
            <div class="panel-header">
              <h2 class="panel-header-title"><%= sec.title %></h2>
              <span class="panel-header-count <%= sec.critical ? 'is-critical' : '' %>"><%= sec.rows.length %></span>
              <% if (sec.hint) { %><span class="text-[11px] text-gray-400"><%= sec.hint %></span><% } %>
            </div>
            <% sec.rows.forEach(function (r) { %>
              <div class="px-4 py-3 border-b border-gray-100 last:border-0 hover:bg-gray-50 transition flex items-start gap-3">
                <input type="checkbox" name="ids" value="<%= r.group_id %>" class="leave-chk mt-1.5 rounded border-gray-300 text-brand-600 focus:ring-brand-500 flex-shrink-0">
                <div class="w-9 h-9 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center text-xs font-bold flex-shrink-0"><%= initials(r.crew_name) %></div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <p class="text-sm font-semibold text-gray-900"><%= r.crew_name || 'Unknown worker' %></p>
                    <% if (!r.crew_name) { %><span class="text-[10px] font-bold text-red-600 uppercase">orphaned record</span><% } %>
                    <span class="text-[11px] text-gray-400"><%= r.crew_emp_id || '—' %><% if (r.crew_phone) { %> · <%= r.crew_phone %><% } %></span>
                  </div>

                  <p class="text-sm text-gray-700 mt-0.5">
                    <span class="font-medium"><%= span(r) %></span>
                    <span class="text-gray-400">· <%= r.day_count %> day<%= r.day_count === 1 ? '' : 's' %><% if (r.days && r.days !== r.day_count) { %> (<%= r.days %> counted)<% } %></span>
                  </p>

                  <div class="flex items-center gap-1.5 mt-1 flex-wrap">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ring-1 <%= TYPE_PILL[r.leave_type] || TYPE_PILL.other %>"><%= (r.leave_type || 'leave').replace('_',' ') %></span>
                    <% if (r.shift_period && r.shift_period !== 'full_day') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700 ring-1 ring-indigo-600/20"><%= r.shift_period.replace('_',' ') %></span>
                    <% } %>
                    <span class="text-[11px] text-gray-400">submitted <%= formatDateTime(r.created_at) %></span>
                  </div>

                  <% if (r.reason) { %><p class="text-[12px] text-gray-500 mt-1 italic">“<%= r.reason %>”</p><% } %>

                  <%# Decision context — the office should not have to approve blind. %>
                  <% if (r.clash_days > 0 || r.others_off > 0) { %>
                    <div class="flex items-center gap-3 mt-1.5 flex-wrap">
                      <% if (r.clash_days > 0) { %>
                        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-700 bg-amber-50 ring-1 ring-amber-600/20 rounded-full px-2 py-0.5">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
                          Already rostered on <%= r.clash_days %> shift<%= r.clash_days === 1 ? '' : 's' %> in this range
                        </span>
                      <% } %>
                      <% if (r.others_off > 0) { %>
                        <span class="text-[11px] text-gray-500"><%= r.others_off %> other<%= r.others_off === 1 ? '' : 's' %> already off these dates</span>
                      <% } %>
                    </div>
                  <% } %>
                </div>

                <div class="flex items-center gap-2 flex-shrink-0">
                  <button type="submit" formaction="/leave-approvals/<%= encodeURIComponent(r.group_id) %>/approve" formmethod="POST"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg transition">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    Approve
                  </button>
                  <button type="button"
                    onclick="leaveOpenReject('<%= encodeURIComponent(r.group_id) %>', <%= JSON.stringify(r.crew_name || 'this worker') %>, <%= JSON.stringify(span(r)) %>)"
                    class="px-3 py-1.5 text-red-700 bg-red-50 hover:bg-red-100 ring-1 ring-red-200 text-xs font-semibold rounded-lg transition">
                    Reject
                  </button>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
    </form>
  <% } %>

  <!-- ── Decided register ─────────────────────────────────────────── -->
  <% if (filters.status !== 'pending') { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="panel-header">
        <h2 class="panel-header-title">Decided</h2>
        <span class="panel-header-count"><%= buckets.decided.length %></span>
      </div>
      <% if (buckets.decided.length === 0) { %>
        <div class="py-8 text-center text-gray-400">
          <p class="text-sm">No decided requests match these filters.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Worker</th>
                <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Dates</th>
                <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden sm:table-cell">Type</th>
                <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Status</th>
                <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden md:table-cell">Decided by</th>
                <th class="px-3 py-2.5 text-right text-[10px] font-bold text-gray-400 uppercase tracking-widest"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% buckets.decided.forEach(function (r) { const sp = STATUS_PILL[r.status] || STATUS_PILL.cancelled; %>
                <tr class="hover:bg-gray-50">
                  <td class="px-3 py-2.5">
                    <p class="font-medium text-gray-900"><%= r.crew_name || 'Unknown worker' %></p>
                    <p class="text-[11px] text-gray-400"><%= r.crew_emp_id || '—' %></p>
                  </td>
                  <td class="px-3 py-2.5 text-gray-700">
                    <%= span(r) %>
                    <span class="text-gray-400 text-[11px]">· <%= r.day_count %>d</span>
                  </td>
                  <td class="px-3 py-2.5 hidden sm:table-cell">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ring-1 <%= TYPE_PILL[r.leave_type] || TYPE_PILL.other %>"><%= (r.leave_type || 'leave').replace('_',' ') %></span>
                  </td>
                  <td class="px-3 py-2.5">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold ring-1 <%= sp.cls %>"><%= sp.label %></span>
                    <% if (r.decision_note) { %>
                      <p class="text-[11px] text-gray-500 mt-0.5 italic max-w-[240px] truncate" title="<%= r.decision_note %>"><%= r.decision_note %></p>
                    <% } %>
                  </td>
                  <td class="px-3 py-2.5 text-gray-500 text-[12px] hidden md:table-cell">
                    <%= r.approver_name || '—' %>
                    <% if (r.approved_at) { %><span class="text-gray-400">· <%= formatDateTime(r.approved_at) %></span><% } %>
                  </td>
                  <td class="px-3 py-2.5 text-right">
                    <% if (r.status === 'approved') { %>
                      <form method="POST" action="/leave-approvals/<%= encodeURIComponent(r.group_id) %>/cancel" class="inline" onsubmit="return confirm('Retract this approved leave? The worker can re-submit.');">
                        <%- include('../partials/csrf') %>
                        <button type="submit" class="text-[11px] font-semibold text-gray-500 hover:text-red-600 transition">Retract</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  <% } %>
<% } %>
</div>

<!-- Bulk bar — only appears once pending requests are ticked. -->
<div id="leaveBulkBar" class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-40 bg-gray-900 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-4 text-sm">
  <span id="leaveBulkCount" class="font-semibold">0 selected</span>
  <button type="button" onclick="leaveBulkSubmit('approve')" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-500 rounded-lg font-medium transition-colors">Approve</button>
  <button type="button" onclick="leaveBulkSubmit('reject')" class="px-4 py-1.5 bg-red-600 hover:bg-red-500 rounded-lg font-medium transition-colors">Reject</button>
  <button type="button" onclick="leaveClearSelection()" class="text-gray-400 hover:text-white transition-colors" aria-label="Clear selection">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
</div>

<!-- Reject modal — the reason is required and travels to the worker. -->
<div id="leaveRejectModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="fixed inset-0 bg-black/50" onclick="leaveCloseReject()"></div>
  <div class="relative bg-white rounded-xl shadow-xl max-w-md w-full p-6 z-10">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </div>
      <div class="min-w-0">
        <h3 class="text-lg font-bold text-gray-900">Reject leave</h3>
        <p class="text-sm text-gray-500 truncate" id="leaveRejectWho"></p>
      </div>
    </div>
    <form method="POST" id="leaveRejectForm" onsubmit="if(!this.decision_note.value.trim()){alert('Give a reason — the worker sees it.');return false;}">
      <%- include('../partials/csrf') %>
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Reason <span class="text-red-500">*</span></label>
      <textarea name="decision_note" rows="3" required placeholder="e.g. Two others already off that week — can you move it?"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent resize-none"></textarea>
      <p class="text-[11px] text-gray-400 mt-1">Sent to the worker with the decision.</p>
      <div class="flex items-center gap-3 justify-end mt-4">
        <button type="button" onclick="leaveCloseReject()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg transition">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium rounded-lg transition">Reject</button>
      </div>
    </form>
  </div>
</div>

<script>
(function () {
  var form  = document.getElementById('leaveBulkForm');
  var bar   = document.getElementById('leaveBulkBar');
  var count = document.getElementById('leaveBulkCount');

  function checks() { return Array.prototype.slice.call(document.querySelectorAll('.leave-chk')); }
  function selected() { return checks().filter(function (c) { return c.checked; }); }
  function refresh() {
    var n = selected().length;
    if (count) count.textContent = n + ' selected';
    if (bar) bar.classList.toggle('hidden', n === 0);
  }
  document.addEventListener('change', function (e) {
    if (e.target && e.target.classList && e.target.classList.contains('leave-chk')) refresh();
  });

  window.leaveClearSelection = function () {
    checks().forEach(function (c) { c.checked = false; });
    refresh();
  };
  window.leaveBulkSubmit = function (action) {
    if (!form || selected().length === 0) return;
    if (action === 'reject' && !confirm('Reject ' + selected().length + ' request(s)? Workers will be notified.')) return;
    document.getElementById('leaveBulkAction').value = action;
    form.submit();
  };

  // Reject modal — points the shared form at the request being rejected.
  window.leaveOpenReject = function (groupId, who, dates) {
    var m = document.getElementById('leaveRejectModal');
    document.getElementById('leaveRejectForm').action = '/leave-approvals/' + groupId + '/reject';
    document.getElementById('leaveRejectWho').textContent = who + ' · ' + dates;
    m.classList.remove('hidden');
    setTimeout(function () { m.querySelector('textarea').focus(); }, 50);
  };
  window.leaveCloseReject = function () {
    document.getElementById('leaveRejectModal').classList.add('hidden');
  };
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') window.leaveCloseReject();
  });

  refresh();
})();
</script>
