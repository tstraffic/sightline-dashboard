<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('atomis-theme');
        var t = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
    window.toggleAtomisTheme = function () {
      var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      var next = cur === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('atomis-theme', next); } catch (e) {}
    };
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Sign in | T&S Traffic Control</title>
  <meta name="theme-color" content="#0F1115">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="icon" type="image/svg+xml" href="/images/atomis-favicon-dark.svg">
  <link rel="apple-touch-icon" href="/images/atomis-apple-touch-icon.png">
  <link rel="manifest" href="/manifest-admin.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --base: #0F1115;
      --surface: #1A1D24;
      --surface-2: #22262F;
      --emerald: #10B981;
      --text: #F5F5F7;
      --text-mute: #8B8E95;
      --text-faint: #5A5D64;
      --border: rgba(245, 245, 247, 0.06);
      --border-strong: rgba(245, 245, 247, 0.12);
      --danger: #EF4444;
      --font-display: 'Bricolage Grotesque', sans-serif;
      --font-body: 'Geist', 'Inter', system-ui, sans-serif;
      --font-mono: 'Geist Mono', monospace;
    }
    :root[data-theme="light"] {
      --base: #F7F8FA;
      --surface: #FFFFFF;
      --surface-2: #F1F3F6;
      --text: #0F1115;
      --text-mute: #555A63;
      --text-faint: #8B8E95;
      --border: rgba(15, 17, 21, 0.08);
      --border-strong: rgba(15, 17, 21, 0.16);
    }

    /* ============ Theme toggle ============ */
    .theme-toggle {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      color: var(--text-mute);
      border: 1px solid var(--border);
      cursor: pointer;
      transition: background-color 0.15s, color 0.15s, border-color 0.15s, transform 0.15s;
      z-index: 5;
    }
    .theme-toggle:hover {
      background: var(--surface-2);
      color: var(--text);
      border-color: var(--border-strong);
    }
    .theme-toggle:active { transform: scale(0.94); }
    .theme-toggle .icon-sun { display: none; }
    .theme-toggle .icon-moon { display: block; }
    :root[data-theme="light"] .theme-toggle .icon-sun { display: block; }
    :root[data-theme="light"] .theme-toggle .icon-moon { display: none; }

    /* Theme-swapped T&S logo */
    .ts-logo-dark { display: block; }
    .ts-logo-light { display: none; }
    :root[data-theme="light"] .ts-logo-dark { display: none; }
    :root[data-theme="light"] .ts-logo-light { display: block; }
    html, body { height: 100%; }
    body {
      font-family: var(--font-body);
      background: var(--base);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      line-height: 1.5;
      overflow: hidden;
    }

    /* ============ Split-screen layout ============ */
    .login-shell {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
    @media (max-width: 820px) { .login-shell { grid-template-columns: 1fr; } }

    /* ============ Left: brand pane ============ */
    .left {
      padding: 56px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      border-right: 1px solid var(--border);
    }
    .left::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 700px 500px at 50% 50%, rgba(16,185,129,0.06), transparent 65%);
      pointer-events: none;
    }
    .left-inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 40px;
    }

    .brand-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-row .wm {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 22px;
      letter-spacing: -0.04em;
    }

    .mark-stage {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .headline-wrap {
      max-width: 460px;
    }
    .headline {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(34px, 4.2vw, 48px);
      letter-spacing: -0.035em;
      line-height: 1.04;
      margin-bottom: 18px;
    }
    .headline em {
      font-style: italic;
      color: var(--emerald);
      font-weight: 400;
    }
    .sub {
      font-size: 15px;
      color: var(--text-mute);
      max-width: 380px;
      line-height: 1.55;
    }

    .footer-meta {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-faint);
      position: absolute;
      left: 56px;
      bottom: 48px;
      z-index: 1;
    }

    /* ============ Right: form pane ============ */
    .right {
      padding: 64px 56px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: var(--surface);
    }
    .right-inner { width: 100%; max-width: 360px; margin: 0 auto; }

    .right h2 {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 28px;
      letter-spacing: -0.025em;
      margin-bottom: 4px;
    }
    .right .lead {
      font-size: 13px;
      color: var(--text-mute);
      margin-bottom: 32px;
    }

    .field { margin-bottom: 18px; }
    .field label {
      display: block;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-mute);
      margin-bottom: 8px;
    }
    .field input {
      width: 100%;
      background: var(--base);
      border: 1px solid var(--border-strong);
      border-radius: 6px;
      padding: 12px 14px;
      color: var(--text);
      font-family: var(--font-body);
      font-size: 14px;
      transition: border-color 0.15s, background-color 0.15s;
    }
    .field input:focus {
      outline: none;
      border-color: var(--emerald);
      background: #14171D;
    }
    .field input::placeholder { color: var(--text-faint); }

    .btn-primary {
      width: 100%;
      background: var(--emerald);
      color: var(--base);
      border: none;
      padding: 13px;
      border-radius: 6px;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 14px;
      letter-spacing: -0.005em;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .btn-primary:hover { opacity: 0.92; }
    .btn-primary:active { transform: translateY(1px); }

    .forgot {
      text-align: center;
      margin-top: 18px;
      font-size: 12px;
      color: var(--text-mute);
    }
    .forgot a {
      color: var(--text-mute);
      text-decoration: none;
      border-bottom: 1px solid var(--border-strong);
      padding-bottom: 1px;
      transition: color 0.15s, border-color 0.15s;
    }
    .forgot a:hover {
      color: var(--emerald);
      border-color: var(--emerald);
    }

    .err {
      background: rgba(239,68,68,0.10);
      border: 1px solid rgba(239,68,68,0.22);
      color: #fca5a5;
      font-size: 13px;
      padding: 10px 14px;
      border-radius: 6px;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* ============ Mobile ============ */
    @media (max-width: 820px) {
      .login-shell { display: flex; flex-direction: column; min-height: 100vh; }
      body { overflow: auto; }
      .left {
        padding: 32px 28px 64px;
        border-right: none;
        border-bottom: 1px solid var(--border);
        min-height: 50vh;
      }
      .left-inner { gap: 28px; }
      .headline { font-size: 28px; }
      .footer-meta { left: 28px; bottom: 20px; }
      .right { padding: 36px 28px 48px; background: var(--base); }
    }

    /* Reduced motion — pause the orbit */
    @media (prefers-reduced-motion: reduce) {
      .mark-anim animateMotion, .mark-anim animate { display: none; }
    }
  </style>
</head>
<body>
  <div class="login-shell">

    <!-- LEFT PANE -->
    <div class="left">
      <div class="left-inner">
        <div class="mark-stage">
          <img class="ts-logo-dark" src="/images/ts-logo-white.png" alt="T&amp;S Traffic Control" style="max-width:340px;width:80%;height:auto">
          <img class="ts-logo-light" src="/images/logo-colour.png" alt="T&amp;S Traffic Control" style="max-width:340px;width:80%;height:auto">
        </div>

        <div class="headline-wrap">
          <h1 class="headline">Control <em>Room.</em></h1>
          <p class="sub">A Safe Way Home.</p>
        </div>
      </div>

      <p class="footer-meta">Powered by Atomis &middot; <%= new Date().getFullYear() %></p>
    </div>

    <!-- RIGHT PANE -->
    <div class="right" style="position:relative">
      <button type="button" class="theme-toggle" onclick="window.toggleAtomisTheme()" aria-label="Toggle theme" title="Toggle light/dark theme">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>
      <div class="right-inner">
        <img src="/images/atomis-mark-animated.svg" alt="Atomis" style="width:56px;height:56px;display:block;margin-bottom:22px;opacity:0.95">
        <h2>Welcome back.</h2>
        <p class="lead">Sign in to run the day.</p>

        <% if (typeof flash_error !== 'undefined' && flash_error && flash_error.length > 0) { %>
          <% flash_error.forEach(msg => { %>
            <div class="err">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M5.062 17.938h13.876c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 14.938c-.77 1.333.192 3 1.732 3z"/></svg>
              <span><%= msg %></span>
            </div>
          <% }) %>
        <% } %>

        <form method="POST" action="/login">
          <%- include('partials/csrf') %>
          <div class="field">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" required autofocus autocomplete="username" placeholder="you@tstraffic.com.au">
          </div>
          <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••••••">
          </div>
          <button type="submit" class="btn-primary">Sign in &rarr;</button>
          <div class="forgot">
            <a href="/forgot-password">Forgot your password?</a>
          </div>
        </form>
      </div>
    </div>

  </div>
</body>
</html>
