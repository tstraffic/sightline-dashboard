<%
// Company meeting page — the minutes are a list of discussion items, each
// optionally tagged to a department, each with its own to-dos. Tagged items
// and to-dos render on that department's hub straight from these rows, so a
// tick there is a tick here. Each item is its own form (same rationale as
// the dept notebook's per-section forms: saving one never clobbers a
// colleague's edit in another).
function fmtTime(hhmm) {
  const m = String(hhmm || '').match(/^(\d{1,2}):(\d{2})$/);
  if (!m) return '';
  let h = parseInt(m[1], 10);
  const ap = h >= 12 ? 'pm' : 'am';
  h = h % 12 || 12;
  return h + ':' + m[2] + ' ' + ap;
}
const subtitleBits = [formatDate(meeting.meeting_date)];
if (meeting.meeting_time) subtitleBits.push(fmtTime(meeting.meeting_time));
if (meeting.attendees) subtitleBits.push(meeting.attendees);
const deptLabel = {};
depts.forEach(function (d) { deptLabel[d.key] = d.label; });
%>

<%- include('../partials/page-header', {
  eyebrow: 'Company meeting',
  title: meeting.title,
  subtitle: subtitleBits.join(' · '),
  rail: true,
  actions: [
    { label: 'Meetings', href: '/meetings', style: 'secondary' },
    { label: 'Edit details', href: '#edit', style: 'secondary' }
  ]
}) %>

<% if (meeting.status === 'cancelled') { %>
  <div class="max-w-4xl flex items-center justify-between gap-3 bg-amber-50 border border-amber-200 rounded-xl p-4 mb-5">
    <p class="text-sm text-amber-800 font-medium">This meeting was cancelled.</p>
    <form method="POST" action="/meetings/<%= meeting.id %>/cancel">
      <%- include('../partials/csrf') %>
      <button type="submit" class="px-3 py-1.5 bg-white border border-amber-300 hover:bg-amber-100 text-amber-800 text-xs font-semibold rounded-lg transition-colors">Restore meeting</button>
    </form>
  </div>
<% } %>

<%
// One to-do row — toggle, text (struck through when done), hover delete.
// Same idiom as the dept notebook's todo rows.
function todoRow(t) { %>
  <div class="flex items-start gap-2 group">
    <form method="POST" action="/meetings/<%= meeting.id %>/todos/<%= t.id %>/toggle" class="shrink-0 pt-0.5">
      <%- include('../partials/csrf') %>
      <button type="submit" title="<%= t.done ? 'Reopen' : 'Mark done' %>"
        class="w-4 h-4 rounded border flex items-center justify-center transition-colors <%= t.done ? 'bg-emerald-500 border-emerald-500' : 'border-gray-300 hover:border-brand-500 hover:bg-brand-50' %>">
        <% if (t.done) { %><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><% } %>
      </button>
    </form>
    <p class="flex-1 min-w-0 text-sm leading-snug <%= t.done ? 'line-through text-gray-400' : 'text-gray-800' %>">
      <%= t.text %>
      <% if (t.priority === 'high') { %><span class="ml-1 inline-block px-1 py-px rounded text-[9px] font-bold bg-red-50 text-red-600 align-middle">HIGH</span><% } %>
    </p>
    <form method="POST" action="/meetings/<%= meeting.id %>/todos/<%= t.id %>/delete" class="shrink-0 opacity-0 group-hover:opacity-100 transition-opacity">
      <%- include('../partials/csrf') %>
      <button type="submit" class="text-gray-300 hover:text-red-500 text-sm leading-none px-1" title="Delete">×</button>
    </form>
  </div>
<% }

// Compact add-a-to-do form; item_id '' = a meeting-level (General) to-do.
function addTodoForm(itemId) { %>
  <form method="POST" action="/meetings/<%= meeting.id %>/todos" class="flex gap-1.5 mt-2">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="item_id" value="<%= itemId || '' %>">
    <input type="text" name="text" required placeholder="Add a to-do…"
      class="flex-1 min-w-0 px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
    <select name="priority" class="px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-600 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
      <option value="low">Low</option>
      <option value="high">High</option>
    </select>
    <button type="submit" class="px-2.5 py-1.5 bg-gray-100 hover:bg-brand-50 border border-gray-200 hover:border-brand-200 text-gray-600 hover:text-brand-700 text-xs font-bold rounded-lg transition-colors">+ Add</button>
  </form>
<% }

// Dept select shared by item forms — '' = General (no hub slice).
function deptSelect(selected) { %>
  <select name="dept_key" class="px-2 py-1.5 bg-white border border-gray-300 rounded-lg text-gray-700 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500" title="Department — tagged items appear on that department's hub">
    <option value="">General</option>
    <% depts.forEach(function (d) { %>
      <option value="<%= d.key %>" <%= selected === d.key ? 'selected' : '' %>><%= d.label %></option>
    <% }); %>
  </select>
<% } %>

<div class="max-w-4xl space-y-5">

  <% if (!items.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 text-center">
      <p class="text-gray-400 text-sm">No discussion items yet — add the first one below.</p>
    </div>
  <% } %>

  <% items.forEach(function (item, idx) {
       const itemTodos = todosByItem.get(item.id) || []; %>
    <div id="item-<%= item.id %>" class="bg-white border border-gray-200 rounded-xl shadow-sm scroll-mt-20 group/item">
      <div class="flex items-center justify-between gap-2 px-5 pt-4 pb-3 border-b border-gray-100">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="w-6 h-6 rounded-full bg-brand-600 text-white text-[11px] font-bold flex items-center justify-center shrink-0"><%= idx + 1 %></span>
          <% if (item.dept_key && deptLabel[item.dept_key]) { %>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-50 text-brand-700 uppercase tracking-wide shrink-0"><%= deptLabel[item.dept_key] %></span>
          <% } else { %>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-100 text-gray-500 uppercase tracking-wide shrink-0">General</span>
          <% } %>
        </div>
        <form method="POST" action="/meetings/<%= meeting.id %>/items/<%= item.id %>/delete" class="shrink-0 opacity-0 group-hover/item:opacity-100 transition-opacity"
              onsubmit="return confirm('Delete this discussion item? Its to-dos are kept under General to-dos.');">
          <%- include('../partials/csrf') %>
          <button type="submit" class="text-gray-300 hover:text-red-500 text-lg leading-none px-1" title="Delete item">×</button>
        </form>
      </div>
      <div class="p-5 pt-4">
        <form method="POST" action="/meetings/<%= meeting.id %>/items/<%= item.id %>">
          <%- include('../partials/csrf') %>
          <textarea name="body" rows="3" required
            class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-brand-500"><%= item.body %></textarea>
          <div class="flex items-center justify-between gap-2 mt-2">
            <% deptSelect(item.dept_key); %>
            <button type="submit" class="px-4 py-1.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-lg transition-colors">Save</button>
          </div>
        </form>

        <div class="mt-4 pt-3 border-t border-gray-50">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">To-dos</p>
          <div class="space-y-1">
            <% if (!itemTodos.length) { %><p class="text-xs text-gray-300 italic py-0.5">None yet.</p><% } %>
            <% itemTodos.forEach(function (t) { todoRow(t); }); %>
          </div>
          <% addTodoForm(item.id); %>
        </div>
      </div>
    </div>
  <% }); %>

  <!-- Add discussion item -->
  <div id="add-item" class="bg-white border border-dashed border-gray-300 rounded-xl scroll-mt-20">
    <form method="POST" action="/meetings/<%= meeting.id %>/items" class="p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Add discussion item</p>
      <%- include('../partials/csrf') %>
      <textarea name="body" rows="3" required placeholder="What was discussed? Tag it to a department and it shows up on that department's hub."
        class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
      <div class="flex items-center justify-between gap-2 mt-2">
        <% deptSelect(null); %>
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition-colors">Add item</button>
      </div>
    </form>
  </div>

  <!-- General to-dos: meeting-level adds + survivors of deleted items -->
  <div id="general-todos" class="bg-white border border-gray-200 rounded-xl shadow-sm scroll-mt-20">
    <div class="flex items-center gap-2.5 px-5 pt-4 pb-3 border-b border-gray-100">
      <p class="text-[11px] font-bold text-gray-700 uppercase tracking-widest">General to-dos</p>
      <span class="text-[11px] text-gray-400 normal-case">not tied to a discussion item</span>
    </div>
    <div class="p-5 pt-4">
      <div class="space-y-1">
        <% if (!generalTodos.length) { %><p class="text-xs text-gray-300 italic py-0.5">None yet.</p><% } %>
        <% generalTodos.forEach(function (t) { todoRow(t); }); %>
      </div>
      <% addTodoForm(null); %>
    </div>
  </div>

  <!-- Footer actions -->
  <div class="flex items-center justify-end gap-4 pb-6">
    <form method="POST" action="/meetings/<%= meeting.id %>/cancel">
      <%- include('../partials/csrf') %>
      <button type="submit" class="text-xs font-medium text-gray-400 hover:text-gray-600"><%= meeting.status === 'cancelled' ? 'Restore meeting' : 'Cancel meeting' %></button>
    </form>
    <% if (canDelete) { %>
      <form method="POST" action="/meetings/<%= meeting.id %>/delete" onsubmit="return confirm('Delete this meeting and all its items and to-dos?');">
        <%- include('../partials/csrf') %>
        <button type="submit" class="text-xs font-medium text-red-400 hover:text-red-600">Delete meeting</button>
      </form>
    <% } %>
  </div>

  <!-- Edit details -->
  <details id="edit" class="bg-white border border-gray-200 rounded-xl shadow-sm scroll-mt-20">
    <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-gray-600 hover:text-gray-900 select-none">Edit meeting details</summary>
    <form method="POST" action="/meetings/<%= meeting.id %>" class="px-5 pb-5 pt-1 grid sm:grid-cols-2 gap-3">
      <%- include('../partials/csrf') %>
      <div class="sm:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Title</label>
        <input type="text" name="title" required value="<%= meeting.title %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Date</label>
        <input type="date" name="meeting_date" required value="<%= meeting.meeting_date %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Time</label>
        <input type="time" name="meeting_time" value="<%= meeting.meeting_time %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div class="sm:col-span-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Attendees</label>
        <input type="text" name="attendees" value="<%= meeting.attendees %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div class="sm:col-span-2">
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition-colors">Save details</button>
      </div>
    </form>
  </details>
</div>
