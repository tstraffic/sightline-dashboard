<%
/* Audits domain switcher — Site vs Vehicle audits are separate registers
   (site_audits / vehicle_audits) that share one sidebar entry, so each
   index page carries this strip to reach the other. Index-level only:
   vehicle sub-pages keep _subnav as their second-level nav.
   Active state derives from currentPage ('audits' | 'vehicle-audits'). */
  var __auditTabs = [
    { key: 'audits',         href: '/audits',         label: 'Site Audits' },
    { key: 'vehicle-audits', href: '/vehicle-audits', label: 'Vehicle Audits' },
  ];
  var __auditActive = (typeof currentPage !== 'undefined') ? currentPage : '';
%>
<nav class="inline-flex items-center bg-gray-100 border border-gray-200 rounded-xl p-1 gap-0.5 mb-4" aria-label="Audit registers">
  <% __auditTabs.forEach(function (t) { var on = __auditActive === t.key; %>
    <a href="<%= t.href %>"
       class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors <%= on ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-900 hover:bg-white/60' %>">
      <%= t.label %>
    </a>
  <% }); %>
</nav>
