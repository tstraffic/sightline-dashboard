<%
  // Render the IT-Feedback widget for the current portal.
  // mode = 'admin' (full pill, bottom-right) | 'worker' (subtle +
  // icon that expands into the form on tap).
  var fbMode = locals.fbMode || 'admin';
  var fbCsrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
%>

<!-- Trigger -->
<% if (fbMode === 'admin') { %>
  <button type="button" id="fb-fab" class="fb-fab fb-fab--admin" aria-label="Send IT feedback" title="Send feedback to IT">
    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.4-4 8-9 8a9.9 9.9 0 01-4-.8L3 21l1.5-4.5C3.5 15.3 3 13.7 3 12c0-4.4 4-8 9-8s9 3.6 9 8z"/></svg>
    <span>Feedback</span>
  </button>
<% } else { %>
  <button type="button" id="fb-fab" class="fb-fab fb-fab--worker" aria-label="Send feedback to IT" title="Send feedback">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
  </button>
<% } %>

<!-- Modal — shared markup, opens for either trigger. -->
<div id="fb-backdrop" class="fb-backdrop" hidden></div>
<div id="fb-modal" class="fb-modal" role="dialog" aria-modal="true" aria-labelledby="fb-title" hidden>
  <header class="fb-modal-head">
    <h2 id="fb-title">Send feedback to IT</h2>
    <button type="button" class="fb-modal-x" id="fb-close" aria-label="Close">×</button>
  </header>
  <form id="fb-form" class="fb-modal-body">
    <label class="fb-label">
      <span>Title</span>
      <input type="text" id="fb-title-input" name="title" required maxlength="200" placeholder="e.g. 'New booking button stuck loading'">
    </label>
    <label class="fb-label">
      <span>Comment</span>
      <textarea id="fb-comment-input" name="comment" rows="5" maxlength="5000" placeholder="What happened, what you expected, any steps to reproduce…"></textarea>
    </label>
    <p class="fb-hint">Sent to IT with your name + the page you're on. No need to attach screenshots — they'll ask if needed.</p>
    <div class="fb-actions">
      <button type="button" class="fb-btn fb-btn--ghost"   id="fb-cancel">Cancel</button>
      <button type="submit" class="fb-btn fb-btn--primary" id="fb-submit">Send</button>
    </div>
    <p id="fb-status" class="fb-status" hidden></p>
  </form>
</div>

<style>
  /* ─── Trigger buttons ─── */
  .fb-fab {
    position: fixed; bottom: 20px; right: 20px;
    display: inline-flex; align-items: center; gap: 7px;
    border: 0; cursor: pointer;
    box-shadow: 0 6px 16px rgba(0,0,0,0.18);
    transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease;
    z-index: 9000;
  }
  .fb-fab:hover { transform: translateY(-1px); box-shadow: 0 10px 22px rgba(0,0,0,0.22); }
  .fb-fab:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  /* Admin: pill with label. Sits at the very bottom; the global
     "New" Quick-Actions FAB is bumped up to stack on top of it
     (see #globalFab override in views/layout.ejs). */
  .fb-fab--admin {
    padding: 9px 14px 9px 12px; border-radius: 999px;
    background: #2B7FFF; color: #fff;
    font-size: 12px; font-weight: 600;
    bottom: 20px;
  }
  .fb-fab--admin:hover { background: #1D6AE5; }
  /* Worker: tiny + icon, deliberately subtle so it doesn't eat the
     small viewport. Tap → opens the same modal. Sits above the
     worker bottom-nav (40px tall) plus the iOS safe-area inset. */
  .fb-fab--worker {
    width: 38px; height: 38px; padding: 0; border-radius: 50%;
    background: rgba(43,127,255,0.92); color: #fff;
    bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    right: 14px;
    opacity: 0.78;
  }
  .fb-fab--worker:hover, .fb-fab--worker:focus-visible { opacity: 1; }

  /* ─── Modal ─── */
  .fb-backdrop {
    position: fixed; inset: 0; z-index: 9500;
    background: rgba(0,0,0,0.45);
    opacity: 0; transition: opacity 160ms ease;
  }
  .fb-backdrop.is-open { opacity: 1; }
  .fb-modal {
    position: fixed; z-index: 9600;
    bottom: 20px; right: 20px;
    width: min(380px, calc(100vw - 24px));
    background: #fff; color: #111827;
    border: 1px solid #E5E7EB;
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.35);
    opacity: 0; transform: translateY(12px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .fb-modal.is-open { opacity: 1; transform: translateY(0); }
  @media (max-width: 480px) {
    .fb-modal {
      left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      width: auto;
    }
  }
  .fb-modal-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid #E5E7EB;
  }
  .fb-modal-head h2 { margin: 0; font-size: 14px; font-weight: 700; color: #111827; }
  .fb-modal-x {
    width: 26px; height: 26px; line-height: 24px; text-align: center;
    border: 0; background: transparent; color: #6B7280;
    font-size: 22px; cursor: pointer; border-radius: 6px;
  }
  .fb-modal-x:hover { background: #F3F4F6; color: #111827; }
  .fb-modal-body { padding: 14px; display: flex; flex-direction: column; gap: 10px; }
  .fb-label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 600; color: #6B7280; }
  .fb-label input, .fb-label textarea {
    width: 100%; padding: 8px 10px; font-size: 13px; color: #111827;
    background: #fff; border: 1px solid #D1D5DB; border-radius: 7px; outline: 0;
    transition: border-color 100ms ease, box-shadow 100ms ease;
  }
  .fb-label input:focus, .fb-label textarea:focus { border-color: #2B7FFF; box-shadow: 0 0 0 3px rgba(43,127,255,0.15); }
  .fb-label textarea { resize: vertical; min-height: 80px; }
  .fb-hint { margin: 0; font-size: 11px; color: #6B7280; }
  .fb-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }
  .fb-btn { padding: 7px 14px; border: 0; border-radius: 7px; cursor: pointer; font-size: 12px; font-weight: 600; }
  .fb-btn--ghost { background: #F3F4F6; color: #374151; }
  .fb-btn--ghost:hover { background: #E5E7EB; }
  .fb-btn--primary { background: #2B7FFF; color: #fff; }
  .fb-btn--primary:hover { background: #1D6AE5; }
  .fb-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .fb-status { margin: 4px 0 0; font-size: 12px; font-weight: 600; }
  .fb-status.is-ok { color: #047857; }
  .fb-status.is-err { color: #B91C1C; }

  /* ─── Dark-mode overrides ───
     The modal uses hardcoded colours (not Tailwind classes) so the
     global .dark-glass theme transformations don't reach it. These
     rules flip the surface to a dark glass card with light text so
     the form is legible in night mode. */
  body.dark-glass .fb-modal {
    background: #1A1D24;
    color: rgba(255,255,255,0.92);
    border-color: rgba(255,255,255,0.10);
  }
  body.dark-glass .fb-modal-head {
    border-bottom-color: rgba(255,255,255,0.08);
  }
  body.dark-glass .fb-modal-head h2 { color: rgba(255,255,255,0.92); }
  body.dark-glass .fb-modal-x { color: rgba(255,255,255,0.60); }
  body.dark-glass .fb-modal-x:hover { background: rgba(255,255,255,0.08); color: #fff; }
  body.dark-glass .fb-label { color: rgba(255,255,255,0.75); }
  body.dark-glass .fb-label input,
  body.dark-glass .fb-label textarea {
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.92);
    border-color: rgba(255,255,255,0.12);
  }
  body.dark-glass .fb-label input::placeholder,
  body.dark-glass .fb-label textarea::placeholder { color: rgba(255,255,255,0.40); }
  body.dark-glass .fb-label input:focus,
  body.dark-glass .fb-label textarea:focus { border-color: #2B7FFF; background: rgba(255,255,255,0.06); }
  body.dark-glass .fb-hint { color: rgba(255,255,255,0.55); }
  body.dark-glass .fb-btn--ghost { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.80); }
  body.dark-glass .fb-btn--ghost:hover { background: rgba(255,255,255,0.12); color: #fff; }
</style>

<script>
  (function () {
    var fab = document.getElementById('fb-fab');
    var modal = document.getElementById('fb-modal');
    var backdrop = document.getElementById('fb-backdrop');
    var closeBtn = document.getElementById('fb-close');
    var cancelBtn = document.getElementById('fb-cancel');
    var form = document.getElementById('fb-form');
    var titleEl = document.getElementById('fb-title-input');
    var commentEl = document.getElementById('fb-comment-input');
    var submitBtn = document.getElementById('fb-submit');
    var statusEl = document.getElementById('fb-status');
    if (!fab || !modal) return;

    function open() {
      modal.hidden = false; backdrop.hidden = false;
      requestAnimationFrame(function () {
        modal.classList.add('is-open');
        backdrop.classList.add('is-open');
      });
      setTimeout(function () { try { titleEl.focus(); } catch (e) {} }, 80);
    }
    function close() {
      modal.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      setTimeout(function () { modal.hidden = true; backdrop.hidden = true; }, 200);
    }
    fab.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    cancelBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) close();
    });

    function readCsrf() {
      var meta = document.querySelector('meta[name="csrf-token"]');
      if (meta && meta.content) return meta.content;
      var inp = document.querySelector('input[name="_csrf"]');
      return inp ? inp.value : '';
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var title = (titleEl.value || '').trim();
      if (!title) { titleEl.focus(); return; }
      submitBtn.disabled = true;
      statusEl.hidden = true; statusEl.className = 'fb-status';
      var csrf = readCsrf();
      fetch('/feedback/submit', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': csrf,
        },
        body: JSON.stringify({
          title: title,
          comment: (commentEl.value || '').trim(),
          page_url: location.pathname + location.search,
        }),
      }).then(function (r) { return r.json().catch(function () { return {}; }); })
        .then(function (data) {
          submitBtn.disabled = false;
          if (data && data.ok) {
            statusEl.textContent = 'Thanks — feedback sent to IT.';
            statusEl.classList.add('is-ok');
            statusEl.hidden = false;
            titleEl.value = ''; commentEl.value = '';
            setTimeout(close, 1200);
          } else {
            statusEl.textContent = (data && data.error) || 'Could not send. Try again in a moment.';
            statusEl.classList.add('is-err');
            statusEl.hidden = false;
          }
        }).catch(function () {
          submitBtn.disabled = false;
          statusEl.textContent = 'Network error — please retry.';
          statusEl.classList.add('is-err');
          statusEl.hidden = false;
        });
    });
  })();
</script>
