<%
  /*
    Reusable Leaflet map partial.

    Inputs (via locals when included):
      mapId     — unique DOM id for this map instance, default 'leaflet-map'
      lat       — latitude (number, required)
      lng       — longitude (number, required)
      zoom      — initial zoom, default 15
      height    — CSS height (px or any unit), default '320px'
      markers   — optional array of { lat, lng, label, href, color } for
                  multi-pin maps (e.g. all bookings). When omitted the
                  map renders a single pin at lat/lng.
      address   — optional address string used to build a Google/Apple
                  Maps direction link below the map.

    Loads Leaflet 1.9 from unpkg + CARTO basemaps (Positron in light,
    Dark Matter in dark) so the map stays visually quiet and matches
    the rest of the dashboard. CSS/JS are loaded once per page even if
    the partial is included multiple times.
  */
  var _mapId    = (typeof mapId    !== 'undefined' && mapId)    ? mapId    : ('leaflet-map-' + Math.random().toString(36).slice(2, 8));
  var _zoom     = (typeof zoom     !== 'undefined' && zoom)     ? zoom     : 15;
  var _height   = (typeof height   !== 'undefined' && height)   ? height   : '320px';
  var _lat      = typeof lat !== 'undefined' ? lat : null;
  var _lng      = typeof lng !== 'undefined' ? lng : null;
  var _markers  = (typeof markers  !== 'undefined' && Array.isArray(markers)) ? markers : null;
  var _address  = (typeof address  !== 'undefined' && address) ? String(address) : '';
%>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<div id="<%= _mapId %>" class="atomis-map" style="height: <%= _height %>;" role="img" aria-label="Map"></div>

<% if (_address || (_lat && _lng)) { %>
  <%
    var navTarget = _address || (_lat + ',' + _lng);
    var encoded = encodeURIComponent(navTarget);
  %>
  <div class="flex items-center gap-3 mt-2 text-xs">
    <a href="https://www.google.com/maps/dir/?api=1&destination=<%= encoded %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-brand-600 hover:text-brand-700 font-semibold">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m-6 3l6-3"/></svg>
      Open in Google Maps
    </a>
    <a href="https://maps.apple.com/?daddr=<%= encoded %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-gray-600 hover:text-gray-800 font-semibold">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      Open in Apple Maps
    </a>
  </div>
<% } %>

<style>
  /* Atomis map shell — softer rounded corners, subtle shadow, theme-
     aware border. The dashed grid + thick borders from raw Leaflet
     are replaced with a quieter container that matches the rest of
     the cards on the page. */
  .atomis-map {
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #E5E7EB;
    background: #F1F5F9;
    box-shadow: 0 1px 2px rgba(15,23,42,0.04);
    z-index: 0;
  }
  :root[data-theme="dark"] .atomis-map {
    border-color: rgba(255,255,255,0.08);
    background: #1A1D24;
    box-shadow: 0 1px 0 rgba(255,255,255,0.04);
  }
  /* Dark mode: invert + hue-rotate the colourful Voyager base so the
     canvas turns dark while the colour cues (green parks, blue water,
     warm roads) are preserved. Filter is scoped to the tile pane so
     the marker, zoom controls and popups stay un-tinted. */
  :root[data-theme="dark"] .atomis-map .leaflet-tile-pane {
    filter: invert(0.92) hue-rotate(180deg) saturate(0.78) brightness(0.95);
  }
  /* Leaflet zoom controls — tighter, rounded, softer shadow */
  .atomis-map .leaflet-control-zoom {
    border: 0 !important;
    border-radius: 10px !important;
    box-shadow: 0 2px 8px rgba(15,23,42,0.12) !important;
    overflow: hidden;
    margin: 12px !important;
  }
  .atomis-map .leaflet-control-zoom a {
    width: 30px !important;
    height: 30px !important;
    line-height: 30px !important;
    background: #fff !important;
    color: #475569 !important;
    font-weight: 600;
    border-bottom: 1px solid #F1F5F9 !important;
    transition: background 120ms ease, color 120ms ease;
  }
  .atomis-map .leaflet-control-zoom a:last-child { border-bottom: 0 !important; }
  .atomis-map .leaflet-control-zoom a:hover { background: #F8FAFC !important; color: #0F172A !important; }
  :root[data-theme="dark"] .atomis-map .leaflet-control-zoom { box-shadow: 0 2px 8px rgba(0,0,0,0.5) !important; }
  :root[data-theme="dark"] .atomis-map .leaflet-control-zoom a {
    background: #1A1D24 !important;
    color: rgba(255,255,255,0.78) !important;
    border-bottom-color: rgba(255,255,255,0.06) !important;
  }
  :root[data-theme="dark"] .atomis-map .leaflet-control-zoom a:hover {
    background: #22262F !important;
    color: #fff !important;
  }
  /* Attribution — quieter and pinned to the corner */
  .atomis-map .leaflet-control-attribution {
    background: rgba(255,255,255,0.85) !important;
    color: #64748B !important;
    font-size: 10px !important;
    padding: 1px 6px !important;
    border-radius: 6px 0 0 0;
  }
  .atomis-map .leaflet-control-attribution a { color: #2B7FFF !important; }
  :root[data-theme="dark"] .atomis-map .leaflet-control-attribution {
    background: rgba(15,17,21,0.85) !important;
    color: rgba(255,255,255,0.55) !important;
  }
  :root[data-theme="dark"] .atomis-map .leaflet-control-attribution a { color: #60A5FA !important; }
  /* Popup polish */
  .atomis-map .leaflet-popup-content-wrapper {
    border-radius: 10px !important;
    box-shadow: 0 6px 20px rgba(15,23,42,0.18) !important;
    border: 1px solid rgba(15,23,42,0.06);
  }
  .atomis-map .leaflet-popup-content { margin: 10px 14px !important; font-size: 12px; }
  :root[data-theme="dark"] .atomis-map .leaflet-popup-content-wrapper {
    background: #1A1D24 !important; color: #F5F5F7 !important;
    border-color: rgba(255,255,255,0.08);
  }
  :root[data-theme="dark"] .atomis-map .leaflet-popup-tip {
    background: #1A1D24 !important;
  }
  /* Custom dot marker — brand-colored circle with a soft halo */
  .atomis-pin {
    position: relative;
    width: 22px; height: 22px;
  }
  .atomis-pin::before {
    content: '';
    position: absolute; inset: -6px;
    border-radius: 9999px;
    background: rgba(43,127,255,0.18);
    animation: atomis-pin-pulse 2.4s ease-out infinite;
  }
  .atomis-pin::after {
    content: '';
    position: absolute; inset: 0;
    border-radius: 9999px;
    background: var(--pin-c, #2B7FFF);
    border: 3px solid #fff;
    box-shadow: 0 2px 6px rgba(15,23,42,0.25);
  }
  :root[data-theme="dark"] .atomis-pin::after { border-color: #0F1115; box-shadow: 0 2px 8px rgba(0,0,0,0.6); }
  @keyframes atomis-pin-pulse {
    0%   { transform: scale(0.7); opacity: 0.9; }
    70%  { transform: scale(1.4); opacity: 0;   }
    100% { transform: scale(1.4); opacity: 0;   }
  }
</style>

<script>
(function () {
  var INIT = function () {
    var el = document.getElementById('<%= _mapId %>');
    if (!el || el.dataset.mapInit === '1') return;
    el.dataset.mapInit = '1';

    var markers = <%- JSON.stringify(_markers || []) %>;
    var lat = <%= _lat != null ? _lat : 'null' %>;
    var lng = <%= _lng != null ? _lng : 'null' %>;
    var zoom = <%= _zoom %>;

    var center;
    if (markers.length > 0) {
      center = [markers[0].lat, markers[0].lng];
    } else if (lat != null && lng != null) {
      center = [lat, lng];
    } else {
      // Fallback: Sydney CBD so the map still renders something
      center = [-33.8688, 151.2093];
      zoom = 10;
    }

    var map = L.map(el, { scrollWheelZoom: false, zoomControl: true, attributionControl: true }).setView(center, zoom);

    // CARTO Voyager — colourful but quiet (soft green parks, pale
    // blue water, light beige roads). Same URL is used in both
    // themes; dark mode applies a CSS filter on the tile pane that
    // darkens the canvas while keeping the colour cues. Free with
    // attribution; high-DPI tiles via {r} so text stays crisp.
    var TILE_URL = 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';
    var ATTRIB = '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>';

    var tileLayer = L.tileLayer(TILE_URL, {
      maxZoom: 20,
      attribution: ATTRIB,
      subdomains: 'abcd',
      detectRetina: true,
    }).addTo(map);

    // No need to swap layers on theme toggle — the .atomis-map
    // [data-theme=dark] CSS filter handles the visual switch.

    function pinIcon(color) {
      return L.divIcon({
        className: '',
        html: '<div class="atomis-pin" style="--pin-c:' + (color || '#2B7FFF') + ';"></div>',
        iconSize: [22, 22],
        iconAnchor: [11, 11],
        popupAnchor: [0, -12],
      });
    }

    if (markers.length > 0) {
      var bounds = [];
      markers.forEach(function (m) {
        if (m.lat == null || m.lng == null) return;
        var marker = L.marker([m.lat, m.lng], { icon: pinIcon(m.color) });
        var html = '';
        if (m.label) html += '<div style="font-weight:700;">' + m.label + '</div>';
        if (m.href)  html += '<a href="' + m.href + '" style="color:#2B7FFF;font-size:12px;font-weight:600;">Open ›</a>';
        if (html) marker.bindPopup(html);
        marker.addTo(map);
        bounds.push([m.lat, m.lng]);
      });
      if (bounds.length > 1) {
        try { map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 }); } catch (e) {}
      }
    } else if (lat != null && lng != null) {
      L.marker([lat, lng], { icon: pinIcon() }).addTo(map);
    }

    // Re-flow if the container size changes (sidebar collapse, tab
    // switch, etc.) — Leaflet caches the size on init and won't
    // redraw tiles otherwise.
    setTimeout(function () { map.invalidateSize(); }, 200);
  };

  // Defer until Leaflet's script tag has loaded.
  if (window.L) INIT();
  else {
    var t = setInterval(function () { if (window.L) { clearInterval(t); INIT(); } }, 50);
  }
})();
</script>
