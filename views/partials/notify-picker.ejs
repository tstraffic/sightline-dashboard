<%
  // Reusable "notify specific people" multi-select.
  // Expects `users` (array of {id, full_name}) in scope. Optionally excludes
  // the current user (`user.id`) since tagging yourself is pointless.
  // Posts the chosen ids as repeated `notify_user_ids` fields.
  var _np_users = (typeof users !== 'undefined' && Array.isArray(users)) ? users : [];
  var _np_selfId = (typeof user !== 'undefined' && user) ? user.id : null;
  var _np_list = _np_users.filter(function (u) { return u.id != _np_selfId; });
%>
<div class="sm:col-span-2">
  <label class="block text-xs font-medium text-gray-700 mb-1">
    Notify specific people
    <span class="font-normal text-gray-400">— optional, tag people to follow up</span>
  </label>
  <details class="notify-picker group relative">
    <summary class="list-none flex items-center justify-between w-full px-2.5 py-1.5 text-xs bg-white border border-gray-300 rounded-md cursor-pointer hover:border-brand-400">
      <span class="notify-picker-label text-gray-500">No-one tagged</span>
      <svg class="w-3.5 h-3.5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
    </summary>
    <div class="absolute z-20 mt-1 w-full max-h-52 overflow-y-auto bg-white border border-gray-200 rounded-md shadow-lg p-1">
      <% if (_np_list.length === 0) { %>
        <p class="px-2 py-1.5 text-xs text-gray-400">No other users available.</p>
      <% } else { %>
        <% _np_list.forEach(function (u) { %>
          <label class="flex items-center gap-2 px-2 py-1.5 text-xs text-gray-700 rounded hover:bg-gray-50 cursor-pointer">
            <input type="checkbox" name="notify_user_ids" value="<%= u.id %>"
              class="w-3.5 h-3.5 rounded border-gray-300 text-brand-600 focus:ring-brand-500">
            <span><%= u.full_name %></span>
          </label>
        <% }); %>
      <% } %>
    </div>
  </details>
</div>
