<style>
  /* ── Custom sidebar layout: nested folders + edit mode ── */
  #sidebar .sb-folder { margin-top: 1px; }
  #sidebar .sb-folder-head {
    display: flex; align-items: center; gap: 5px; width: 100%;
    padding: 7px 10px 5px; background: none; border: 0; cursor: pointer;
    color: rgba(148,163,184,0.7); font-size: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.09em; text-align: left;
  }
  #sidebar .sb-folder-head:hover { color: rgba(226,232,240,0.95); }
  #sidebar .sb-folder-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Caret: points DOWN when the folder is open, RIGHT when collapsed. The base
     icon is a right-chevron, so open = rotate 90° (down), collapsed = 0° (right). */
  #sidebar .sb-caret { width: 12px; height: 12px; flex-shrink: 0; transform: rotate(90deg); transition: transform .18s ease; }
  #sidebar .sb-folder-ico { width: 13px; height: 13px; flex-shrink: 0; opacity: 0.7; }
  #sidebar .sb-folder.is-collapsed .sb-caret { transform: rotate(0deg); }
  #sidebar .sb-folder-items.sb-collapsed { display: none; }
  #sidebar .sb-folder-items { padding-left: 6px; margin-left: 6px; border-left: 1px solid rgba(255,255,255,0.06); }

  /* ── Edit mode ── */
  #sidebar.sb-editing .sidebar-link {
    cursor: default; background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; margin: 3px 0; padding-top: 7px; padding-bottom: 7px;
  }
  #sidebar.sb-editing .sidebar-link:hover { background: rgba(255,255,255,0.09); border-color: rgba(255,255,255,0.18); }
  #sidebar.sb-editing .sb-folder {
    background: rgba(255,255,255,0.035); border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px; padding: 3px 4px 5px; margin: 7px 0;
  }
  #sidebar.sb-editing .sb-folder-head { color: rgba(226,232,240,0.92); padding-bottom: 4px; }
  #sidebar.sb-editing .sb-folder-items { min-height: 20px; border-left-color: rgba(255,255,255,0.1); }
  /* Empty / drop-target folders get a clear, calm well. */
  #sidebar.sb-editing .sb-folder-items:empty::after {
    content: 'Drag tabs here'; display: block; padding: 7px 8px; margin: 2px 2px;
    font-size: 10px; color: rgba(255,255,255,0.35); border: 1px dashed rgba(255,255,255,0.16);
    border-radius: 7px; text-transform: none; letter-spacing: 0; text-align: center;
  }

  /* Drag handle — only in edit mode */
  #sidebar .sb-handle { display: none; flex-shrink: 0; width: 16px; margin-right: 2px; cursor: grab; color: rgba(255,255,255,0.3); }
  #sidebar.sb-editing .sb-handle { display: inline-flex; align-items: center; justify-content: center; }
  #sidebar.sb-editing .sidebar-link:hover .sb-handle, #sidebar.sb-editing .sb-folder-head:hover .sb-handle { color: rgba(255,255,255,0.6); }
  #sidebar .sb-handle:active { cursor: grabbing; }

  /* Per-row action buttons (rename / add-sub / delete) — reveal on hover in edit */
  #sidebar .sb-act { display: none; flex-shrink: 0; padding: 2px; border: 0; background: none; color: rgba(255,255,255,0.35); cursor: pointer; border-radius: 4px; line-height: 0; }
  #sidebar.sb-editing .sb-folder-head .sb-act { display: inline-flex; }
  #sidebar.sb-editing .sidebar-link .sb-act { display: none; }
  #sidebar.sb-editing .sidebar-link:hover .sb-act { display: inline-flex; }
  #sidebar .sb-act:hover { color: #fff; background: rgba(255,255,255,0.12); }
  #sidebar .sb-act--del:hover { color: #fca5a5; background: rgba(239,68,68,0.18); }
  #sidebar .sb-act svg { width: 13px; height: 13px; }

  /* Inline rename input */
  #sidebar .sb-rename-input {
    flex: 1; min-width: 0; background: rgba(0,0,0,0.35); border: 1px solid #2B7FFF; border-radius: 5px;
    color: #fff; font-size: inherit; font-weight: inherit; letter-spacing: inherit; text-transform: none;
    padding: 2px 6px; outline: none;
  }

  /* Sortable feedback */
  #sidebar .sb-ghost { opacity: 0.35; }
  #sidebar .sb-chosen { background: rgba(43,127,255,0.22) !important; border-color: rgba(43,127,255,0.5) !important; }

  /* ── Edit toolbar + instructions ── */
  #sidebar .sb-editpanel { display: none; }
  #sidebar.sb-editing .sb-editpanel {
    display: block; position: sticky; top: 0; z-index: 5;
    margin: -4px -4px 10px; padding: 12px; border-radius: 12px;
    background: linear-gradient(180deg, #1e2536, #181d2b);
    border: 1px solid rgba(96,154,255,0.3);
    box-shadow: 0 8px 22px rgba(0,0,0,0.4);
  }
  #sidebar .sb-editpanel-title { font-size: 12.5px; font-weight: 800; color: #f1f5ff; display: flex; align-items: center; gap: 7px; letter-spacing: .01em; }
  #sidebar .sb-editpanel-title svg { color: #6ea0ff; }
  #sidebar .sb-editpanel-hint { list-style: none; padding: 0; margin: 9px 0 11px; display: flex; flex-direction: column; gap: 5px; }
  #sidebar .sb-editpanel-hint li { font-size: 10.5px; line-height: 1.45; color: rgba(255,255,255,0.6); display: flex; align-items: flex-start; gap: 6px; }
  #sidebar .sb-editpanel-hint li svg { width: 12px; height: 12px; flex-shrink: 0; margin-top: 1px; color: rgba(150,185,255,0.85); }
  #sidebar .sb-editpanel-hint b { color: rgba(255,255,255,0.88); font-weight: 700; }
  #sidebar .sb-btnrow { display: flex; gap: 7px; }
  #sidebar .sb-tbtn { flex: 1 1 auto; padding: 8px 9px; font-size: 11px; font-weight: 700; border: 0; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 5px; transition: background .15s ease, color .15s ease; }
  #sidebar .sb-tbtn svg { width: 13px; height: 13px; flex-shrink: 0; }
  #sidebar .sb-tbtn--primary { background: #2B7FFF; color: #fff; box-shadow: 0 2px 8px rgba(43,127,255,0.35); }
  #sidebar .sb-tbtn--primary:hover { background: #1D6AE5; }
  #sidebar .sb-tbtn--ghost { background: rgba(255,255,255,0.08); color: #cbd5e1; }
  #sidebar .sb-tbtn--ghost:hover { background: rgba(255,255,255,0.15); color: #fff; }
  #sidebar .sb-tbtn--reset { width: 100%; margin-top: 8px; padding: 6px; font-size: 10.5px; background: none; color: rgba(252,165,165,0.65); font-weight: 600; border-radius: 7px; }
  #sidebar .sb-tbtn--reset:hover { color: #fca5a5; background: rgba(239,68,68,0.12); }
</style>

<script>
(function () {
  'use strict';
  try {
    var sidebar = document.getElementById('sidebar');
    var nav = sidebar && sidebar.querySelector('.sidebar-nav');
    if (!nav) return;
    var spacer = nav.querySelector('[data-sb-spacer]');
    var canEdit = !!window.__SIDEBAR_CAN_EDIT__;
    var layout = window.__SIDEBAR_LAYOUT__ || null;
    var MAX_DEPTH = 3; // how deep folders may nest

    // ---- helpers ----
    function linkKey(a) {
      try { return new URL(a.getAttribute('href'), location.origin).pathname.replace(/\/$/, '') || '/'; }
      catch (e) { return a.getAttribute('href') || ''; }
    }
    function labelEl(a) {
      var el = a.querySelector('.sb-label');
      if (el) return el;
      el = a.querySelector('span.flex-1');
      if (el) { el.classList.add('sb-label'); return el; }
      var span = document.createElement('span');
      span.className = 'sb-label flex-1';
      var moved = '';
      Array.prototype.slice.call(a.childNodes).forEach(function (n) {
        if (n.nodeType === 3 && n.textContent.trim()) { moved += (moved ? ' ' : '') + n.textContent.trim(); n.remove(); }
      });
      span.textContent = moved;
      a.appendChild(span);
      return span;
    }
    function collapsedStore() { try { return JSON.parse(localStorage.getItem('sbCollapsed') || '{}'); } catch (e) { return {}; } }
    function saveCollapsed(map) { try { localStorage.setItem('sbCollapsed', JSON.stringify(map)); } catch (e) {} }
    function makeFrag(html) { var d = document.createElement('div'); d.innerHTML = html; return d.firstChild; }

    function collectItems() {
      var map = {};
      Array.prototype.slice.call(nav.querySelectorAll('a.sidebar-link')).forEach(function (a) {
        labelEl(a);
        var k = linkKey(a);
        if (map[k]) { a.parentNode && a.parentNode.removeChild(a); return; }
        map[k] = a;
      });
      return map;
    }

    var ICON_CARET = '<svg class="sb-caret" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>';
    var ICON_FOLDER = '<svg class="sb-folder-ico" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>';
    var ICON_HANDLE = '<span class="sb-handle"><svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M8 6h.01M8 12h.01M8 18h.01M16 6h.01M16 12h.01M16 18h.01"/></svg></span>';
    var ICON_PENCIL = '<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>';
    var ICON_PLUS = '<svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5"/></svg>';
    var ICON_TRASH = '<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>';

    function actBtn(cls, title, svg) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'sb-act ' + cls; b.title = title; b.innerHTML = svg;
      return b;
    }

    function buildFolder(name, collapsed, edit) {
      var f = document.createElement('div');
      f.className = 'sb-folder' + (collapsed ? ' is-collapsed' : '');
      f.setAttribute('data-folder', '');
      var head = document.createElement('div');
      head.className = 'sb-folder-head';
      head.innerHTML = (edit ? ICON_HANDLE : '') + ICON_CARET + ICON_FOLDER + '<span class="sb-folder-name"></span>';
      head.querySelector('.sb-folder-name').textContent = name;
      if (edit) {
        head.appendChild(actBtn('sb-act--addsub', 'Add sub-folder', ICON_PLUS));
        head.appendChild(actBtn('sb-act--rename', 'Rename folder', ICON_PENCIL));
        head.appendChild(actBtn('sb-act--del', 'Delete folder', ICON_TRASH));
      }
      var items = document.createElement('div');
      items.className = 'sb-folder-items' + (collapsed ? ' sb-collapsed' : '');
      f.appendChild(head); f.appendChild(items);
      return f;
    }

    function decorateItem(a, edit) {
      if (edit) {
        if (!a.querySelector('.sb-handle')) a.insertBefore(makeFrag(ICON_HANDLE), a.firstChild);
        if (!a.querySelector('.sb-act--rename')) a.appendChild(actBtn('sb-act--rename', 'Rename', ICON_PENCIL));
      } else {
        var h = a.querySelector('.sb-handle'); if (h) h.remove();
        Array.prototype.slice.call(a.querySelectorAll('.sb-act')).forEach(function (n) { n.remove(); });
      }
    }

    // ---- render a tree (recursive) ----
    function render(tree, edit) {
      var pool = collectItems();
      var root = document.createElement('div');
      root.className = 'sb-root';
      var used = {};
      var col = collapsedStore();
      function placeItem(node, container) {
        var a = pool[node.key]; if (!a) return; used[node.key] = 1;
        if (node.label) { labelEl(a).textContent = node.label; a.setAttribute('data-sb-label', node.label); }
        decorateItem(a, edit);
        container.appendChild(a);
      }
      function renderChildren(children, container) {
        (children || []).forEach(function (node) {
          if (node.t === 'folder') {
            var collapsed = (col[node.name] !== undefined) ? col[node.name] : !!node.collapsed;
            if (edit) collapsed = false;
            var f = buildFolder(node.name || 'Folder', collapsed, edit);
            container.appendChild(f);
            renderChildren(node.children || [], f.querySelector(':scope > .sb-folder-items'));
          } else if (node.t === 'item') {
            placeItem(node, container);
          }
        });
      }
      renderChildren(tree, root);
      // Leftover items (new pages not in the saved layout) stay visible at the end.
      Object.keys(pool).forEach(function (k) { if (!used[k]) { decorateItem(pool[k], edit); root.appendChild(pool[k]); } });

      nav.querySelectorAll('.sidebar-section, .sb-root').forEach(function (n) { n.remove(); });
      nav.insertBefore(root, spacer);
      // Open every ancestor folder of the active item.
      root.querySelectorAll('.sb-folder').forEach(function (f) {
        if (f.querySelector('a.sidebar-link.bg-white\\/15')) {
          f.classList.remove('is-collapsed');
          var it = f.querySelector(':scope > .sb-folder-items'); if (it) it.classList.remove('sb-collapsed');
        }
      });
      return root;
    }

    // ---- seed editor from default DOM (sections → folders) ----
    // Registry-era sections: the header row may itself be a hub LINK
    // (a.sidebar-link inside the .sidebar-section div) instead of a <p>
    // label — name the folder from data-sb-name and seed the hub link as
    // its first child. Sub-labels (data-sb-sub) are decoration, not
    // folder starts.
    function seedFromDom() {
      var tree = [], folder = null;
      Array.prototype.slice.call(nav.children).forEach(function (node) {
        if (node.matches && node.matches('.sidebar-section')) {
          if (node.hasAttribute('data-sb-sub')) return;
          var p = node.querySelector('p');
          folder = {
            t: 'folder',
            name: node.getAttribute('data-sb-name') || (p ? p.textContent.trim() : 'Folder'),
            collapsed: false,
            children: [],
          };
          var hub = node.querySelector('a.sidebar-link');
          if (hub) folder.children.push({ t: 'item', key: linkKey(hub) });
          tree.push(folder);
        } else if (node.matches && node.matches('a.sidebar-link')) {
          var item = { t: 'item', key: linkKey(node) };
          if (folder) folder.children.push(item); else tree.push(item);
        }
      });
      return tree;
    }

    // ---- serialize DOM → tree (recursive) ----
    function serialize() {
      var root = nav.querySelector('.sb-root');
      function itemNode(a) { var o = { t: 'item', key: linkKey(a) }; var l = a.getAttribute('data-sb-label'); if (l) o.label = l; return o; }
      function walk(container) {
        var out = [];
        Array.prototype.slice.call(container.children).forEach(function (node) {
          if (node.matches && node.matches('.sb-folder')) {
            var nameEl = node.querySelector(':scope > .sb-folder-head .sb-folder-name');
            var itemsEl = node.querySelector(':scope > .sb-folder-items');
            out.push({
              t: 'folder', name: (nameEl ? nameEl.textContent : 'Folder').trim(),
              collapsed: node.classList.contains('is-collapsed'),
              children: itemsEl ? walk(itemsEl) : [],
            });
          } else if (node.matches && node.matches('a.sidebar-link')) {
            out.push(itemNode(node));
          }
        });
        return out;
      }
      return { v: 1, tree: root ? walk(root) : [] };
    }

    // ---- DISPLAY MODE: apply saved layout (all users) ----
    if (layout && Array.isArray(layout.tree) && layout.tree.length) render(layout.tree, false);

    // Collapse toggle (display only — folders stay open while editing).
    nav.addEventListener('click', function (e) {
      if (sidebar.classList.contains('sb-editing')) return;
      var head = e.target.closest && e.target.closest('.sb-folder-head');
      if (!head) return;
      var folder = head.closest('.sb-folder');
      var items = folder.querySelector(':scope > .sb-folder-items');
      var collapsed = folder.classList.toggle('is-collapsed');
      if (items) items.classList.toggle('sb-collapsed', collapsed);
      var name = folder.querySelector('.sb-folder-name').textContent.trim();
      var map = collapsedStore(); map[name] = collapsed; saveCollapsed(map);
    });

    // ===================== EDIT MODE (admin only) =====================
    if (!canEdit) return;
    var toggleBtn = document.getElementById('sb-edit-toggle');
    var editLabel = document.getElementById('sb-edit-label');
    var sortables = [];
    var panel = null;

    function loadSortable(cb) {
      if (window.Sortable) return cb();
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js';
      s.onload = cb;
      s.onerror = function () { alert('Could not load the drag-and-drop library (are you offline?).'); exitEdit(); };
      document.head.appendChild(s);
    }
    function folderDepth(el) { // # of folders between el and root
      var d = 0, n = el;
      while (n && !n.classList.contains('sb-root')) { if (n.classList && n.classList.contains('sb-folder')) d++; n = n.parentNode; }
      return d;
    }
    function makeSortable(el) {
      sortables.push(new window.Sortable(el, {
        group: 'sbnav', draggable: 'a.sidebar-link, .sb-folder', handle: '.sb-handle',
        ghostClass: 'sb-ghost', chosenClass: 'sb-chosen', animation: 140, fallbackOnBody: true,
        // Auto-scroll the sidebar while dragging near its top/bottom edge.
        // `scroll` must name the nav explicitly: with fallbackOnBody the
        // dragged clone lives on <body>, so Sortable's automatic scrollable-
        // ancestor detection misses the nav's overflow-y-auto. The forced
        // fallback engages Sortable's own scroller (reliable on touch too).
        scroll: nav,
        forceAutoScrollFallback: true,
        scrollSensitivity: 80,
        scrollSpeed: 14,
        bubbleScroll: true,
        onMove: function (evt) {
          if (evt.dragged.classList.contains('sb-folder')) {
            if (evt.dragged.contains(evt.to)) return false;           // not into itself
            if (folderDepth(evt.to) >= MAX_DEPTH) return false;       // depth cap
          }
          return true;
        },
      }));
    }
    function makeAllSortable() {
      makeSortable(nav.querySelector('.sb-root'));
      nav.querySelectorAll('.sb-folder-items').forEach(makeSortable);
    }

    function inlineRename(textEl, onCommit) {
      if (!textEl || textEl.dataset.renaming) return;
      var cur = textEl.textContent.trim();
      var input = document.createElement('input');
      input.type = 'text'; input.value = cur; input.className = 'sb-rename-input';
      textEl.dataset.renaming = '1';
      textEl.style.display = 'none';
      textEl.parentNode.insertBefore(input, textEl.nextSibling);
      input.focus(); input.select();
      var done = false;
      function finish(commit) {
        if (done) return; done = true;
        var v = commit ? (input.value.trim() || cur) : cur;
        textEl.textContent = v; textEl.style.display = ''; delete textEl.dataset.renaming;
        input.remove();
        if (commit) onCommit && onCommit(v);
      }
      input.addEventListener('blur', function () { finish(true); });
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); finish(true); }
        else if (e.key === 'Escape') { e.preventDefault(); finish(false); }
      });
    }

    function buildPanel() {
      panel = document.createElement('div');
      panel.className = 'sb-editpanel';
      var hSvg = function (d) { return '<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="' + d + '"/></svg>'; };
      panel.innerHTML =
        '<div class="sb-editpanel-title">' +
          '<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>' +
          'Customise menu</div>' +
        '<ul class="sb-editpanel-hint">' +
          '<li>' + hSvg('M4 8h16M4 16h16') + '<span><b>Drag</b> the handle to reorder tabs.</span></li>' +
          '<li>' + hSvg('M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z') + '<span><b>Drop onto a folder</b> to nest a tab inside it.</span></li>' +
          '<li>' + hSvg('M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z') + '<span><b>Click a name</b> to rename it.</span></li>' +
        '</ul>' +
        '<div class="sb-btnrow">' +
          '<button type="button" class="sb-tbtn sb-tbtn--ghost" data-sb="newfolder">' + ICON_PLUS + 'Folder</button>' +
          '<button type="button" class="sb-tbtn sb-tbtn--primary" data-sb="save">Save</button>' +
          '<button type="button" class="sb-tbtn sb-tbtn--ghost" data-sb="cancel">Cancel</button>' +
        '</div>' +
        '<button type="button" class="sb-tbtn sb-tbtn--reset" data-sb="reset">Reset to default for everyone</button>';
      nav.insertBefore(panel, nav.firstChild);
      panel.addEventListener('click', onPanel);
    }

    function onPanel(e) {
      var btn = e.target.closest('[data-sb]'); if (!btn) return;
      var act = btn.getAttribute('data-sb');
      if (act === 'newfolder') {
        var root = nav.querySelector('.sb-root');
        var f = buildFolder('New folder', false, true);
        root.insertBefore(f, root.firstChild);
        makeSortable(f.querySelector(':scope > .sb-folder-items'));
        inlineRename(f.querySelector('.sb-folder-name'));
      } else if (act === 'save') {
        var payload = serialize();
        var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
        btn.textContent = 'Saving…'; btn.disabled = true;
        fetch('/admin/sidebar-layout', {
          method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
          body: JSON.stringify({ layout: payload }),
        }).then(function (r) { return r.json(); }).then(function (d) {
          if (d && d.ok) location.reload();
          else { alert('Save failed: ' + ((d && d.error) || '')); btn.textContent = 'Save'; btn.disabled = false; }
        }).catch(function () { alert('Save failed.'); btn.textContent = 'Save'; btn.disabled = false; });
      } else if (act === 'cancel') {
        location.reload();
      } else if (act === 'reset') {
        if (!confirm('Reset the menu to the default for everyone?')) return;
        var csrf2 = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
        fetch('/admin/sidebar-layout/reset', { method: 'POST', headers: { 'X-CSRF-Token': csrf2 } }).then(function () { location.reload(); });
      }
    }

    // Edit-mode interactions: rename / add-sub / delete (capture phase).
    nav.addEventListener('click', function (e) {
      if (!sidebar.classList.contains('sb-editing')) return;
      if (e.target.closest('.sb-editpanel')) return;

      var addsub = e.target.closest('.sb-act--addsub');
      if (addsub) {
        e.preventDefault(); e.stopPropagation();
        var ph = addsub.closest('.sb-folder');
        if (folderDepth(ph.querySelector(':scope > .sb-folder-items')) >= MAX_DEPTH) { alert('Folders can only nest ' + MAX_DEPTH + ' levels deep.'); return; }
        var list = ph.querySelector(':scope > .sb-folder-items');
        var sub = buildFolder('New folder', false, true);
        list.insertBefore(sub, list.firstChild);
        ph.classList.remove('is-collapsed'); list.classList.remove('sb-collapsed');
        makeSortable(sub.querySelector(':scope > .sb-folder-items'));
        inlineRename(sub.querySelector('.sb-folder-name'));
        return;
      }
      var del = e.target.closest('.sb-act--del');
      if (del) {
        e.preventDefault(); e.stopPropagation();
        var folder = del.closest('.sb-folder');
        var parentList = folder.parentNode; // move children up to the parent container
        var inner = folder.querySelector(':scope > .sb-folder-items');
        Array.prototype.slice.call(inner.children).forEach(function (n) { parentList.insertBefore(n, folder); });
        folder.remove();
        return;
      }
      var ren = e.target.closest('.sb-act--rename');
      if (ren) {
        e.preventDefault(); e.stopPropagation();
        var a = ren.closest('a.sidebar-link');
        if (a) { inlineRename(a.querySelector('.sb-label'), function (v) { a.setAttribute('data-sb-label', v); }); return; }
        var fn = ren.closest('.sb-folder-head').querySelector('.sb-folder-name');
        inlineRename(fn);
        return;
      }
      // Click a name directly to rename.
      var lbl = e.target.closest('.sb-label');
      if (lbl && lbl.closest('a.sidebar-link')) {
        e.preventDefault(); e.stopPropagation();
        var link = lbl.closest('a.sidebar-link');
        inlineRename(lbl, function (v) { link.setAttribute('data-sb-label', v); });
        return;
      }
      var fname = e.target.closest('.sb-folder-name');
      if (fname) { e.preventDefault(); e.stopPropagation(); inlineRename(fname); return; }

      // Otherwise block link navigation while editing.
      var navlink = e.target.closest('a.sidebar-link');
      if (navlink) e.preventDefault();
    }, true);

    function enterEdit() {
      var current = nav.querySelector('.sb-root') ? serialize().tree : seedFromDom();
      render(current, true);
      sidebar.classList.add('sb-editing');
      if (editLabel) editLabel.textContent = 'Done';
      buildPanel();
      loadSortable(makeAllSortable);
    }
    function exitEdit() {
      sortables.forEach(function (s) { try { s.destroy(); } catch (e) {} }); sortables = [];
      if (panel) { panel.remove(); panel = null; }
      sidebar.classList.remove('sb-editing');
      if (editLabel) editLabel.textContent = 'Customise menu';
      render(serialize().tree, false);
    }
    if (toggleBtn) toggleBtn.addEventListener('click', function () {
      if (sidebar.classList.contains('sb-editing')) exitEdit(); else enterEdit();
    });
  } catch (err) {
    if (window.console) console.error('[sidebar-customise]', err);
  }
})();
</script>
