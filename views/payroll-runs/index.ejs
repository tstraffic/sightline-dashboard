<% locals.currentPage = 'pay-runs' %>
<%
  function fmtDate(s) { if (!s) return ''; return new Date(s + 'T00:00:00').toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }); }

  // Group runs by period_end (week ending) so the same week shows together
  // with a small subtotal row. Runs are already sorted by period_end DESC.
  const groups = [];
  let current = null;
  (runs || []).forEach(r => {
    const key = r.period_end || '';
    if (!current || current.key !== key) {
      current = { key, periodEnd: r.period_end, periodStart: r.period_start, runs: [],
        cash: 0, tfn: 0, abn: 0, total: 0, lines: 0 };
      groups.push(current);
    }
    current.runs.push(r);
    current.cash  += parseFloat(r.cash_total)  || 0;
    current.tfn   += parseFloat(r.tfn_total)   || 0;
    current.abn   += parseFloat(r.abn_total)   || 0;
    current.total += parseFloat(r.grand_total) || 0;
    current.lines += parseInt(r.line_count, 10) || 0;
  });
%>

<div class="space-y-5">
  <%- include('../partials/page-header', { rail: true, wrapperClass: '',
    eyebrow: 'Finance',
    title: 'Pay Runs',
    subtitle: 'Traffic Control runs import a Traffio Person Dockets CSV. Management runs are direct-entry salary periods.',
    actions: [
      { label: 'Worker rates', href: '/payroll/rates', style: 'secondary', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
      { label: 'New pay run', href: '/payroll/runs/new', style: 'primary', icon: 'M12 4v16m8-8H4' }
    ]
  }) %>

  <!-- Type tabs -->
  <%
    const typeOpts = [
      { key: '',                   label: 'All',              count: (counts.traffic_control + counts.management) },
      { key: 'traffic_control',    label: 'Traffic Control',  count: counts.traffic_control },
      { key: 'management',         label: 'Management',       count: counts.management },
    ];
  %>
  <div class="flex gap-2 border-b border-gray-200">
    <% typeOpts.forEach(o => { const active = (typeFilter || '') === o.key; %>
      <a href="<%= o.key ? ('/payroll/runs?type=' + o.key) : '/payroll/runs' %>"
        class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold transition-all border-b-2 <%= active ? 'border-brand-600 text-brand-600' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
        <%= o.label %>
        <span class="text-xs font-bold <%= active ? 'text-brand-600' : 'text-gray-400' %>"><%= o.count %></span>
      </a>
    <% }) %>
  </div>

  <!-- List -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <% if (!runs || runs.length === 0) { %>
      <div class="p-10 text-center">
        <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <p class="mt-3 text-sm text-gray-500 font-semibold">No pay runs yet</p>
        <p class="text-xs text-gray-400 mt-1">Import a Traffio Person Dockets CSV to get started.</p>
        <a href="/payroll/runs/new" class="inline-block mt-3 text-sm font-semibold text-brand-600">Import your first pay run →</a>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Period</th>
              <th class="px-4 py-3 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Workers</th>
              <th class="px-4 py-3 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest hidden sm:table-cell">Cash</th>
              <th class="px-4 py-3 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest hidden sm:table-cell">TFN</th>
              <th class="px-4 py-3 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest hidden sm:table-cell">ABN</th>
              <th class="px-4 py-3 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest">Total</th>
              <th class="px-4 py-3 text-center text-[10px] font-bold text-gray-500 uppercase tracking-widest hidden md:table-cell">Status</th>
              <th class="px-4 py-3 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest"></th>
            </tr>
          </thead>
          <% groups.forEach((g, gi) => { %>
            <tbody class="divide-y divide-gray-100 <%= gi > 0 ? 'border-t-2 border-gray-200' : '' %>">
              <% g.runs.forEach(r => { %>
                <tr class="hover:bg-gray-50 transition">
                  <td class="px-4 py-3">
                    <a href="/payroll/runs/<%= r.id %>" class="block">
                      <p class="font-semibold text-gray-900 text-sm flex items-center gap-2 flex-wrap">
                        <%= r.label || periodLabel(r.period_start, r.period_end) %>
                        <% if (r.pay_run_type === 'management') { %>
                          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-violet-50 text-violet-700 ring-1 ring-violet-600/20">MGMT</span>
                        <% } else { %>
                          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 ring-1 ring-blue-600/20">TC</span>
                        <% } %>
                      </p>
                      <p class="text-[11px] text-gray-400 tabular-nums"><%= fmtDate(r.period_start) %> → <%= fmtDate(r.period_end) %></p>
                    </a>
                  </td>
                  <td class="px-4 py-3 text-sm text-gray-700 tabular-nums">
                    <%= r.line_count %>
                    <% if (r.unclassified_count > 0) { %>
                      <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700"><%= r.unclassified_count %> unclassified</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-sm text-gray-600 text-right tabular-nums hidden sm:table-cell">$<%= fmtMoney(r.cash_total) %></td>
                  <td class="px-4 py-3 text-sm text-gray-600 text-right tabular-nums hidden sm:table-cell">$<%= fmtMoney(r.tfn_total) %></td>
                  <td class="px-4 py-3 text-sm text-gray-600 text-right tabular-nums hidden sm:table-cell">$<%= fmtMoney(r.abn_total) %></td>
                  <td class="px-4 py-3 text-sm font-bold text-gray-900 text-right tabular-nums">$<%= fmtMoney(r.grand_total) %></td>
                  <td class="px-4 py-3 text-center hidden md:table-cell">
                    <%
                      const _s = r.status || 'draft';
                      let _label = 'Draft', _cls = 'bg-gray-100 text-gray-600 ring-gray-300';
                      if (_s === 'pending_approval')   { _label = 'Pending approval'; _cls = 'bg-amber-100 text-amber-800 ring-amber-300'; }
                      else if (_s === 'approved')      { _label = 'Approved';         _cls = 'bg-blue-100 text-blue-800 ring-blue-300'; }
                      else if (_s === 'paid')          { _label = 'Paid';             _cls = 'bg-emerald-100 text-emerald-800 ring-emerald-300'; }
                      else if (_s === 'finalized')     { _label = 'Finalized';        _cls = 'bg-emerald-50 text-emerald-700 ring-emerald-600/20'; }
                    %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold ring-1 <%= _cls %>"><%= _label %></span>
                  </td>
                  <td class="px-4 py-3 text-right whitespace-nowrap">
                    <a href="/payroll/runs/<%= r.id %>" class="inline-flex items-center px-2.5 py-1.5 text-xs font-semibold text-brand-600 hover:bg-brand-50 rounded-lg">Open →</a>
                  </td>
                </tr>
              <% }) %>
              <%/* Subtotal row — only when more than one run shares this week.
                   A single-run week wouldn't add information beyond the row above. */%>
              <% if (g.runs.length > 1) { %>
                <tr class="bg-gray-50/70">
                  <td class="px-4 py-2">
                    <p class="text-[11px] font-bold text-gray-500 uppercase tracking-wider">Week ending <%= fmtDate(g.periodEnd) %> · subtotal</p>
                  </td>
                  <td class="px-4 py-2 text-xs font-semibold text-gray-600 tabular-nums"><%= g.lines %></td>
                  <td class="px-4 py-2 text-xs font-semibold text-gray-600 text-right tabular-nums hidden sm:table-cell">$<%= fmtMoney(g.cash) %></td>
                  <td class="px-4 py-2 text-xs font-semibold text-gray-600 text-right tabular-nums hidden sm:table-cell">$<%= fmtMoney(g.tfn) %></td>
                  <td class="px-4 py-2 text-xs font-semibold text-gray-600 text-right tabular-nums hidden sm:table-cell">$<%= fmtMoney(g.abn) %></td>
                  <td class="px-4 py-2 text-sm font-bold text-gray-900 text-right tabular-nums">$<%= fmtMoney(g.total) %></td>
                  <td class="px-4 py-2 hidden md:table-cell"></td>
                  <td class="px-4 py-2"></td>
                </tr>
              <% } %>
            </tbody>
          <% }) %>
        </table>
      </div>
    <% } %>
  </div>
</div>

<% if (flash_success && flash_success.length) { %>
  <div class="fixed top-20 right-4 px-4 py-2 rounded-lg bg-emerald-500 text-white text-sm font-semibold shadow-lg z-50" id="flash"><%= flash_success[0] %></div>
  <script>setTimeout(()=>document.getElementById('flash')?.remove(), 2800);</script>
<% } %>
<% if (flash_error && flash_error.length) { %>
  <div class="fixed top-20 right-4 px-4 py-2 rounded-lg bg-red-500 text-white text-sm font-semibold shadow-lg z-50" id="flasherr"><%= flash_error[0] %></div>
  <script>setTimeout(()=>document.getElementById('flasherr')?.remove(), 4000);</script>
<% } %>
