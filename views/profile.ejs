<div class="max-w-2xl mx-auto space-y-6">

  <!-- Header -->
  <div>
    <h1 class="text-2xl font-bold text-gray-900">My Profile</h1>
    <p class="text-sm text-gray-500 mt-1">Update your personal information and security settings</p>
  </div>

  <!-- Flash Messages -->
  <% if (flash_success && flash_success.length > 0) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-lg text-sm" data-auto-dismiss>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <%= flash_success[0] %>
      </div>
    </div>
  <% } %>
  <% if (flash_error && flash_error.length > 0) { %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm" data-auto-dismiss>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <%= flash_error[0] %>
      </div>
    </div>
  <% } %>

  <!-- Profile Info Card -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 bg-gray-50">
      <h2 class="text-base font-semibold text-gray-900">Personal Information</h2>
    </div>
    <form method="POST" action="/profile" class="p-5 space-y-5">
      <%- include('partials/csrf') %>
      <!-- Avatar / initials -->
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-xl font-bold flex-shrink-0">
          <%= profile.full_name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2) %>
        </div>
        <div>
          <p class="text-lg font-semibold text-gray-900"><%= profile.full_name %></p>
          <p class="text-sm text-gray-500">@<%= profile.username %> &middot;
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
              <% if (profile.role === 'admin') { %>bg-purple-50 text-purple-700 ring-1 ring-purple-600/20
              <% } else if (profile.role === 'operations') { %>bg-blue-50 text-blue-700 ring-1 ring-blue-600/20
              <% } else if (profile.role === 'planning') { %>bg-teal-50 text-teal-700 ring-1 ring-teal-600/20
              <% } else if (profile.role === 'finance') { %>bg-amber-50 text-amber-700 ring-1 ring-amber-600/20
              <% } else { %>bg-gray-50 text-gray-700 ring-1 ring-gray-600/20
              <% } %>">
              <%= profile.role.charAt(0).toUpperCase() + profile.role.slice(1) %>
            </span>
          </p>
          <p class="text-xs text-gray-400 mt-0.5">Member since <%= new Date(profile.created_at).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', month: 'long', year: 'numeric' }) %></p>
        </div>
      </div>

      <hr class="border-gray-200">

      <!-- Full Name -->
      <div>
        <label for="full_name" class="block text-sm font-medium text-gray-700 mb-1">Full Name <span class="text-red-500">*</span></label>
        <input type="text" id="full_name" name="full_name" value="<%= profile.full_name %>" required
          class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>

      <!-- Email -->
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
        <input type="email" id="email" name="email" value="<%= profile.email || '' %>" placeholder="your@email.com"
          class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        <p class="text-xs text-gray-400 mt-1">Used for notifications and password reset emails</p>
      </div>

      <!-- Username (read-only) -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
        <input type="text" value="<%= profile.username %>" disabled
          class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-gray-500 text-sm cursor-not-allowed">
        <p class="text-xs text-gray-400 mt-1">Username cannot be changed. Contact an admin if needed.</p>
      </div>

      <!-- Notification Preferences -->
      <hr class="border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900">Notification Preferences</h3>

      <div class="flex items-center gap-3">
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" name="email_notifications_enabled" class="sr-only peer" <%= profile.email_notifications_enabled ? 'checked' : '' %>>
          <div class="w-10 h-5 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-brand-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-brand-600"></div>
        </label>
        <span class="text-sm text-gray-700">Email notifications</span>
      </div>

      <div>
        <label for="notification_frequency" class="block text-sm font-medium text-gray-700 mb-1">Notification Frequency</label>
        <select id="notification_frequency" name="notification_frequency"
          class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="immediate" <%= profile.notification_frequency === 'immediate' ? 'selected' : '' %>>Immediate</option>
          <option value="hourly" <%= profile.notification_frequency === 'hourly' ? 'selected' : '' %>>Hourly digest</option>
          <option value="daily" <%= profile.notification_frequency === 'daily' ? 'selected' : '' %>>Daily digest</option>
        </select>
      </div>

      <div class="pt-2">
        <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition-colors">
          Save Changes
        </button>
      </div>
    </form>
  </div>

  <!-- Security Card -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 bg-gray-50">
      <h2 class="text-base font-semibold text-gray-900">Security</h2>
    </div>
    <div class="p-5 space-y-6">

      <!-- Change Password -->
      <div>
        <h3 class="text-sm font-semibold text-gray-900 mb-3">Change Password</h3>
        <form method="POST" action="/profile/change-password" class="space-y-4">
          <%- include('partials/csrf') %>
          <div>
            <label for="current_password" class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
            <input type="password" id="current_password" name="current_password" required autocomplete="current-password"
              class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="new_password" class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
              <input type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password"
                class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            </div>
            <div>
              <label for="confirm_password" class="block text-sm font-medium text-gray-700 mb-1">Confirm New Password</label>
              <input type="password" id="confirm_password" name="confirm_password" required minlength="8" autocomplete="new-password"
                class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            </div>
          </div>
          <p class="text-xs text-gray-400">Minimum 8 characters</p>
          <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-gray-800 hover:bg-gray-700 text-white text-sm font-semibold rounded-lg transition-colors">
            Update Password
          </button>
        </form>
      </div>

      <% if (emailEnabled && profile.email) { %>
      <hr class="border-gray-200">

      <!-- Reset via Email -->
      <div>
        <h3 class="text-sm font-semibold text-gray-900 mb-1">Forgot Your Password?</h3>
        <p class="text-sm text-gray-500 mb-3">We'll send a password reset link to <strong class="text-gray-700"><%= profile.email %></strong></p>
        <form method="POST" action="/profile/send-reset-email">
          <%- include('partials/csrf') %>
          <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-white hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg border border-gray-300 transition-colors">
            <svg class="w-4 h-4 inline -mt-0.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Send Reset Link to Email
          </button>
        </form>
      </div>
      <% } else if (!profile.email) { %>
      <hr class="border-gray-200">
      <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
        <p class="text-sm text-amber-800">
          <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          Add an email address above to enable password reset via email.
        </p>
      </div>
      <% } %>

    </div>
  </div>

  <!-- Appearance Card — gradient + accent picker for dark mode -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
      <div>
        <h2 class="text-base font-semibold text-gray-900">Appearance</h2>
        <p class="text-xs text-gray-500 mt-0.5">Customise the dashboard's night-mode look. Light mode stays the same.</p>
      </div>
      <span id="theme-current-mode" class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-600"></span>
    </div>
    <div class="p-5 space-y-6">

      <!-- Gradient -->
      <div>
        <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Background gradient</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="gradient-picker">
          <% const gradients = [
            { key:'midnight', label:'Midnight',  preview:'linear-gradient(135deg,#020817,#0F2847,#020817)' },
            { key:'aurora',   label:'Aurora',    preview:'linear-gradient(135deg,#0B0228,#1A0A47,#0A2A47)' },
            { key:'sunset',   label:'Sunset',    preview:'linear-gradient(135deg,#1B0810,#2D0E1F,#1A1438)' },
            { key:'forest',   label:'Forest',    preview:'linear-gradient(135deg,#021808,#0F4733,#021808)' },
            { key:'ocean',    label:'Ocean',     preview:'linear-gradient(135deg,#021A1F,#103D4E,#021A1F)' },
            { key:'plum',     label:'Plum',      preview:'linear-gradient(135deg,#0F0B1E,#371F4E,#0F0B1E)' },
            { key:'mono',     label:'Mono',      preview:'linear-gradient(135deg,#0A0A0A,#202020,#0A0A0A)' },
          ]; %>
          <% gradients.forEach(g => { %>
            <button type="button" data-gradient="<%= g.key %>"
              class="theme-tile group relative overflow-hidden rounded-xl border-2 border-gray-200 hover:border-brand-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200 transition text-left">
              <div class="h-16" style="background: <%= g.preview %>;"></div>
              <div class="px-3 py-2 bg-white">
                <p class="text-xs font-semibold text-gray-800"><%= g.label %></p>
              </div>
              <span class="theme-tile-check absolute top-2 right-2 hidden w-5 h-5 rounded-full bg-brand-600 text-white items-center justify-center shadow-sm">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
            </button>
          <% }) %>
        </div>
      </div>

      <!-- Accent -->
      <div>
        <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Accent colour</p>
        <div class="grid grid-cols-3 sm:grid-cols-5 gap-3" id="accent-picker">
          <% const accents = [
            { key:'blue',    label:'Brand Blue', swatch:'#2B7FFF' },
            { key:'purple',  label:'Purple',     swatch:'#8b5cf6' },
            { key:'pink',    label:'Pink',       swatch:'#ec4899' },
            { key:'emerald', label:'Emerald',    swatch:'#10b981' },
            { key:'amber',   label:'Amber',      swatch:'#f59e0b' },
            { key:'cyan',    label:'Cyan',       swatch:'#06b6d4' },
          ]; %>
          <% accents.forEach(a => { %>
            <button type="button" data-accent="<%= a.key %>"
              class="theme-tile group relative flex items-center gap-2.5 px-3 py-2.5 rounded-xl border-2 border-gray-200 hover:border-brand-400 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200 transition bg-white">
              <span class="w-6 h-6 rounded-full ring-1 ring-black/10 flex-shrink-0" style="background: <%= a.swatch %>;"></span>
              <span class="text-xs font-semibold text-gray-800 truncate"><%= a.label %></span>
              <span class="theme-tile-check absolute top-1.5 right-1.5 hidden w-4 h-4 rounded-full bg-brand-600 text-white items-center justify-center shadow-sm">
                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </span>
            </button>
          <% }) %>
        </div>
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-lg p-3 text-xs text-gray-600 flex items-start gap-2">
        <svg class="w-4 h-4 mt-0.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>Theme preferences are saved per-device (in your browser). Switch to dark mode using the moon/sun icon in the top bar to see your gradient and accent applied. Light mode stays clean and untouched.</span>
      </div>
    </div>
  </div>

  <script>
    // Theme picker — updates body classes and persists to localStorage.
    (function () {
      function modeIsDark() { return document.body.classList.contains('dark-glass'); }

      function updateModeBadge() {
        var el = document.getElementById('theme-current-mode');
        if (!el) return;
        if (modeIsDark()) {
          el.textContent = 'Night mode active';
          el.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-purple-100 text-purple-700';
        } else {
          el.textContent = 'Light mode — switch via top bar';
          el.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-700';
        }
      }

      function applyGradient(key) {
        document.body.className = document.body.className.split(/\s+/).filter(function(c){ return !/^gradient-/.test(c); }).join(' ');
        if (modeIsDark()) document.body.classList.add('gradient-' + key);
        try { localStorage.setItem('ts-theme-gradient', key); } catch(e){}
      }
      function applyAccent(key) {
        document.body.className = document.body.className.split(/\s+/).filter(function(c){ return !/^accent-/.test(c); }).join(' ');
        if (modeIsDark()) document.body.classList.add('accent-' + key);
        try { localStorage.setItem('ts-theme-accent', key); } catch(e){}
      }

      function markActive(scope, attr, key) {
        document.querySelectorAll('#' + scope + ' [data-' + attr + ']').forEach(function (btn) {
          var active = btn.getAttribute('data-' + attr) === key;
          btn.classList.toggle('border-brand-500', active);
          btn.classList.toggle('ring-2', active);
          btn.classList.toggle('ring-brand-200', active);
          btn.classList.toggle('border-gray-200', !active);
          var check = btn.querySelector('.theme-tile-check');
          if (check) check.style.display = active ? 'inline-flex' : 'none';
        });
      }

      var savedGrad = localStorage.getItem('ts-theme-gradient') || 'midnight';
      var savedAccent = localStorage.getItem('ts-theme-accent') || 'blue';

      document.querySelectorAll('#gradient-picker [data-gradient]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var k = btn.getAttribute('data-gradient');
          applyGradient(k);
          markActive('gradient-picker', 'gradient', k);
        });
      });
      document.querySelectorAll('#accent-picker [data-accent]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var k = btn.getAttribute('data-accent');
          applyAccent(k);
          markActive('accent-picker', 'accent', k);
        });
      });

      markActive('gradient-picker', 'gradient', savedGrad);
      markActive('accent-picker', 'accent', savedAccent);
      updateModeBadge();

      // If the user toggles the theme via the top bar while on this page, the
      // header's toggleTheme() wraps a body classList change — re-run the
      // badge updater on a tick so the label catches up.
      var origToggle = window.toggleTheme;
      if (typeof origToggle === 'function') {
        window.toggleTheme = function() { origToggle.apply(this, arguments); setTimeout(updateModeBadge, 30); };
      }
    })();
  </script>

  <!-- Push Notifications Card -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-200 bg-gray-50">
      <h2 class="text-base font-semibold text-gray-900">Push Notifications</h2>
    </div>
    <div class="p-5 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-900">Mobile / Desktop Notifications</p>
          <p class="text-xs text-gray-500 mt-0.5">Receive instant alerts on your device for tasks, deadlines, and updates</p>
        </div>
        <span id="push-status" class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Checking...</span>
      </div>

      <div id="push-not-supported" class="hidden bg-amber-50 border border-amber-200 rounded-lg p-3">
        <p class="text-sm text-amber-800">
          <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          Your browser does not support push notifications. Try Chrome, Edge, or Firefox on a desktop or Android device.
        </p>
      </div>

      <div id="push-denied" class="hidden bg-red-50 border border-red-200 rounded-lg p-3">
        <p class="text-sm text-red-800">
          <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          Notifications are blocked. Open your browser settings and allow notifications for this site, then refresh.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <button onclick="sendTestPush()" id="push-test-btn" class="px-4 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed" disabled>
          <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          Send Test Notification
        </button>
      </div>

      <p class="text-xs text-gray-400">Push notifications work on Chrome, Edge, Firefox (desktop & Android). iOS Safari has limited support.</p>
    </div>
  </div>

  <script>
  (function() {
    var statusEl = document.getElementById('push-status');
    var testBtn = document.getElementById('push-test-btn');

    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      statusEl.textContent = 'Not Supported';
      statusEl.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 ring-1 ring-amber-600/20';
      document.getElementById('push-not-supported').classList.remove('hidden');
      return;
    }

    if (Notification.permission === 'denied') {
      statusEl.textContent = 'Blocked';
      statusEl.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-50 text-red-700 ring-1 ring-red-600/20';
      document.getElementById('push-denied').classList.remove('hidden');
      return;
    }

    navigator.serviceWorker.ready.then(function(reg) {
      reg.pushManager.getSubscription().then(function(sub) {
        if (sub) {
          statusEl.textContent = 'Enabled';
          statusEl.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20';
          testBtn.disabled = false;
        } else {
          statusEl.textContent = 'Not Enabled';
          statusEl.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600';
        }
      });
    });
  })();
  </script>

</div>
