<% locals.currentPage = 'projects' %>
<% const isEdit = job !== null && typeof job !== 'undefined' %>

<!-- Page Header -->
<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= isEdit ? 'Edit Job: ' + job.job_number : 'Create New Job' %></h1>
  <p class="text-gray-500 text-sm mt-1"><%= isEdit ? 'Update job details below' : 'Fill in the details to create a new job' %></p>
</div>

<!-- Form -->
<form method="POST" action="<%= isEdit ? '/projects/' + job.id : '/projects' %>" class="space-y-6">
  <%- include('../partials/csrf') %>

  <!-- Job Identification -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Job Identification</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Job Number (auto-generated) -->
      <div>
        <label class="block text-sm font-medium text-gray-600 mb-1">Job Number</label>
        <% if (isEdit) { %>
          <div class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-gray-900 text-sm font-semibold"><%= job.job_number %></div>
        <% } else { %>
          <div class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-gray-400 text-sm italic">Auto-assigned on create (J-XXXX)</div>
        <% } %>
      </div>
      <!-- Client (Dropdown) -->
      <div>
        <label for="client_id" class="block text-sm font-medium text-gray-600 mb-1">Client <span class="text-red-600">*</span></label>
        <select id="client_id" name="client_id" required
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select Client --</option>
          <% (typeof clients !== 'undefined' ? clients : []).forEach(c => { %>
            <option value="<%= c.id %>" <%= isEdit && job.client_id == c.id ? 'selected' : (!isEdit && typeof preselectedClientId !== 'undefined' && preselectedClientId == c.id) ? 'selected' : '' %>><%= c.company_name %></option>
          <% }) %>
        </select>
        <p class="text-xs text-gray-400 mt-1"><a href="/clients/new" class="text-brand-600 hover:underline">+ Add new client</a></p>
        <input type="hidden" name="client" value="<%= isEdit ? job.client : '' %>">
      </div>
      <!-- Client Project Number -->
      <div>
        <label for="client_project_number" class="block text-sm font-medium text-gray-600 mb-1">Client Project Number</label>
        <input type="text" id="client_project_number" name="client_project_number"
          value="<%= isEdit && job.client_project_number ? job.client_project_number : '' %>"
          placeholder="Client project number"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <!-- Project Name -->
      <div>
        <label for="project_name" class="block text-sm font-medium text-gray-600 mb-1">Project Name</label>
        <input type="text" id="project_name" name="project_name"
          value="<%= isEdit && job.project_name ? job.project_name : '' %>"
          placeholder="Project name"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <!-- Principal Contractor -->
      <div>
        <label for="principal_contractor" class="block text-sm font-medium text-gray-600 mb-1">Principal Contractor</label>
        <input type="text" id="principal_contractor" name="principal_contractor"
          value="<%= isEdit && job.principal_contractor ? job.principal_contractor : '' %>"
          placeholder="Principal contractor"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <!-- State -->
      <div>
        <label for="state" class="block text-sm font-medium text-gray-600 mb-1">State</label>
        <select id="state" name="state"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <% (settingsOptions.state || []).forEach((opt, idx) => { %>
            <option value="<%= opt.key %>" <%= isEdit && job.state === opt.key ? 'selected' : (!isEdit && idx === 0) ? 'selected' : '' %>><%= opt.key %></option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <!-- Location -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Location</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Site Address -->
      <div>
        <label for="site_address" class="block text-sm font-medium text-gray-600 mb-1">Site Address</label>
        <input type="text" id="site_address" name="site_address"
          value="<%= isEdit && job.site_address ? job.site_address : '' %>"
          placeholder="Full site address"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <!-- Suburb -->
      <div>
        <label for="suburb" class="block text-sm font-medium text-gray-600 mb-1">Suburb</label>
        <input type="text" id="suburb" name="suburb"
          value="<%= isEdit && job.suburb ? job.suburb : '' %>"
          placeholder="Suburb"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
    </div>
  </div>

  <!-- Status & Progress -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Status & Progress</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Status -->
      <div>
        <label for="status" class="block text-sm font-medium text-gray-600 mb-1">Status</label>
        <select id="status" name="status"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <% (settingsOptions.job_status || []).forEach(opt => { %>
            <option value="<%= opt.key %>" <%= isEdit && job.status === opt.key ? 'selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
      </div>
      <!-- Stage -->
      <div>
        <label for="stage" class="block text-sm font-medium text-gray-600 mb-1">Stage</label>
        <select id="stage" name="stage"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <% (settingsOptions.job_stage || []).forEach(opt => { %>
            <option value="<%= opt.key %>" <%= isEdit && job.stage === opt.key ? 'selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
      </div>
      <!-- Health -->
      <div>
        <label for="health" class="block text-sm font-medium text-gray-600 mb-1">Health</label>
        <select id="health" name="health"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <% (settingsOptions.job_health || []).forEach(opt => { %>
            <option value="<%= opt.key %>" <%= isEdit && job.health === opt.key ? 'selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <!-- Dates & Completion -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Dates & Completion</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Start Date -->
      <div>
        <label for="start_date" class="block text-sm font-medium text-gray-600 mb-1">Start Date <span class="text-red-600">*</span></label>
        <input type="date" id="start_date" name="start_date" required
          value="<%= isEdit && job.start_date ? job.start_date : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <!-- End Date -->
      <div>
        <label for="end_date" class="block text-sm font-medium text-gray-600 mb-1">End Date</label>
        <input type="date" id="end_date" name="end_date"
          value="<%= isEdit && job.end_date ? job.end_date : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <!-- % Complete -->
      <div>
        <label for="percent_complete" class="block text-sm font-medium text-gray-600 mb-1">% Complete</label>
        <input type="number" id="percent_complete" name="percent_complete" min="0" max="100"
          value="<%= isEdit ? (job.percent_complete || 0) : 0 %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
    </div>
  </div>

  <!-- Operations Details -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Operations Details</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Contract Value -->
      <div>
        <label for="contract_value" class="block text-sm font-medium text-gray-600 mb-1">Contract Value</label>
        <input type="number" id="contract_value" name="contract_value" step="0.01" min="0"
          value="<%= isEdit && job.contract_value ? job.contract_value : '' %>"
          placeholder="0.00"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <!-- Estimated Hours -->
      <div>
        <label for="estimated_hours" class="block text-sm font-medium text-gray-600 mb-1">Estimated Hours</label>
        <input type="number" id="estimated_hours" name="estimated_hours" min="0"
          value="<%= isEdit && job.estimated_hours ? job.estimated_hours : '' %>"
          placeholder="0"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <!-- Crew Size -->
      <div>
        <label for="crew_size" class="block text-sm font-medium text-gray-600 mb-1">Crew Size</label>
        <input type="number" id="crew_size" name="crew_size" min="0"
          value="<%= isEdit && job.crew_size ? job.crew_size : '' %>"
          placeholder="0"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
      <!-- Required TC Level -->
      <div>
        <label for="required_tcp_level" class="block text-sm font-medium text-gray-600 mb-1">Required TC Level</label>
        <select id="required_tcp_level" name="required_tcp_level"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="" <%= isEdit && !job.required_tcp_level ? 'selected' : '' %>>Any</option>
          <option value="beginner" <%= isEdit && job.required_tcp_level === 'beginner' ? 'selected' : '' %>>Beginner</option>
          <option value="intermediate" <%= isEdit && job.required_tcp_level === 'intermediate' ? 'selected' : '' %>>Intermediate</option>
          <option value="team_leader" <%= isEdit && job.required_tcp_level === 'team_leader' ? 'selected' : '' %>>Team Leader</option>
          <option value="supervisor" <%= isEdit && job.required_tcp_level === 'supervisor' ? 'selected' : '' %>>Supervisor</option>
        </select>
        <p class="text-xs text-gray-400 mt-1">Minimum TC competency required for crew on this job</p>
      </div>
    </div>
    <div class="flex items-center gap-6 mt-4">
      <!-- ROL Required -->
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="rol_required" value="1" <%= isEdit && job.rol_required ? 'checked' : '' %>
          class="w-4 h-4 rounded border-gray-300 bg-white text-brand-500 focus:ring-brand-500 focus:ring-offset-0">
        <span class="text-sm font-medium text-gray-600">ROL Required</span>
      </label>
      <!-- TMP Required -->
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="tmp_required" value="1" <%= isEdit && job.tmp_required ? 'checked' : '' %>
          class="w-4 h-4 rounded border-gray-300 bg-white text-brand-500 focus:ring-brand-500 focus:ring-offset-0">
        <span class="text-sm font-medium text-gray-600">TMP Required</span>
      </label>
    </div>
  </div>

  <!-- Team Assignment -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Team Assignment</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Project Manager -->
      <div>
        <label for="project_manager_id" class="block text-sm font-medium text-gray-600 mb-1">Project Manager</label>
        <select id="project_manager_id" name="project_manager_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select --</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= isEdit && job.project_manager_id == u.id ? 'selected' : '' %>><%= u.full_name %> (<%= u.role %>)</option>
          <% }) %>
        </select>
      </div>
      <!-- Ops Supervisor -->
      <div>
        <label for="ops_supervisor_id" class="block text-sm font-medium text-gray-600 mb-1">Ops Supervisor</label>
        <select id="ops_supervisor_id" name="ops_supervisor_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select --</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= isEdit && job.ops_supervisor_id == u.id ? 'selected' : '' %>><%= u.full_name %> (<%= u.role %>)</option>
          <% }) %>
        </select>
      </div>
      <!-- Traffic Supervisor -->
      <div>
        <label for="traffic_supervisor_id" class="block text-sm font-medium text-gray-600 mb-1">Traffic Supervisor</label>
        <select id="traffic_supervisor_id" name="traffic_supervisor_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select --</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= isEdit && job.traffic_supervisor_id == u.id ? 'selected' : '' %>><%= u.full_name %> (<%= u.role %>)</option>
          <% }) %>
        </select>
      </div>
      <!-- Planning Owner -->
      <div>
        <label for="planning_owner_id" class="block text-sm font-medium text-gray-600 mb-1">Planning Owner</label>
        <select id="planning_owner_id" name="planning_owner_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select --</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= isEdit && job.planning_owner_id == u.id ? 'selected' : '' %>><%= u.full_name %> (<%= u.role %>)</option>
          <% }) %>
        </select>
      </div>
      <!-- Marketing Owner -->
      <div>
        <label for="marketing_owner_id" class="block text-sm font-medium text-gray-600 mb-1">Marketing Owner</label>
        <select id="marketing_owner_id" name="marketing_owner_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select --</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= isEdit && job.marketing_owner_id == u.id ? 'selected' : '' %>><%= u.full_name %> (<%= u.role %>)</option>
          <% }) %>
        </select>
      </div>
      <!-- Accounts Owner -->
      <div>
        <label for="accounts_owner_id" class="block text-sm font-medium text-gray-600 mb-1">Accounts Owner</label>
        <select id="accounts_owner_id" name="accounts_owner_id"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <option value="">-- Select --</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= isEdit && job.accounts_owner_id == u.id ? 'selected' : '' %>><%= u.full_name %> (<%= u.role %>)</option>
          <% }) %>
        </select>
      </div>
      <!-- Accounts Status -->
      <div>
        <label for="accounts_status" class="block text-sm font-medium text-gray-600 mb-1">Accounts Status</label>
        <select id="accounts_status" name="accounts_status"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          <% (settingsOptions.accounts_status || []).forEach(opt => { %>
            <option value="<%= opt.key %>" <%= isEdit && job.accounts_status === opt.key ? 'selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
      </div>
    </div>
  </div>

  <!-- SharePoint -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">SharePoint</h2>
    <div>
      <label for="sharepoint_url" class="block text-sm font-medium text-gray-600 mb-1">SharePoint URL</label>
      <input type="url" id="sharepoint_url" name="sharepoint_url"
        value="<%= isEdit && job.sharepoint_url ? job.sharepoint_url : '' %>"
        placeholder="https://..."
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
    </div>
  </div>

  <!-- Monthly package job — works on both create and edit:
         create: ticked months mint one job each (or a single combined
                 job, per the mode radio below).
         edit:   re-renders the toggle so an existing job can be
                 promoted to a monthly package, and any months ticked
                 in addition mint new sibling jobs (existing months
                 for the same client+pattern+year are skipped). -->
  <%
    var existingPattern = isEdit ? (job.recurring_pattern_name || 'Packages') : 'Packages';
    var existingMonthly = isEdit && job.recurring_monthly;
    // On edit, parse the start month so we can pre-tick this job's month.
    var existingMonthIdx = -1, existingYear = new Date().getFullYear();
    if (isEdit && job.start_date) {
      var d = new Date(job.start_date + (job.start_date.includes('T') ? '' : 'T00:00:00'));
      if (!isNaN(d)) { existingMonthIdx = d.getMonth(); existingYear = d.getFullYear(); }
    }
  %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6" id="monthly-package-card">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Monthly Package Job</h2>
    <label class="inline-flex items-center gap-2 cursor-pointer mb-3">
      <input type="checkbox" id="monthly_package" name="<%= isEdit ? 'recurring_monthly' : 'monthly_package' %>" value="1" <%= existingMonthly ? 'checked' : '' %> class="w-4 h-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500">
      <span class="text-sm font-medium text-gray-700">This is a monthly package job</span>
    </label>
    <p class="text-xs text-gray-500 mb-4">
      <% if (isEdit) { %>
        Tick months to add as new sibling jobs (months that already exist for this client + pattern are skipped).
        Use the mode below to decide whether each ticked month becomes its own job, or all selected months collapse into one.
      <% } else { %>
        Choose a pattern name, year, and the months you want jobs for. Each ticked month either gets its own job
        (e.g. <code class="bg-gray-100 px-1.5 py-0.5 rounded">May - Packages</code>, <code class="bg-gray-100 px-1.5 py-0.5 rounded">June - Packages</code>)
        or all months collapse into a single job (<code class="bg-gray-100 px-1.5 py-0.5 rounded">May–July - Packages</code>) depending on the mode.
      <% } %>
    </p>

    <div id="monthly-package-config" class="space-y-4" style="display:<%= existingMonthly ? 'block' : 'none' %>">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="recurring_pattern_name" class="block text-sm font-medium text-gray-600 mb-1">Pattern name</label>
          <input type="text" id="recurring_pattern_name" name="recurring_pattern_name" value="<%= existingPattern %>" placeholder="e.g. Packages"
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          <p class="text-[11px] text-gray-400 mt-1">Used as the suffix after each month name.</p>
        </div>
        <div>
          <label for="monthly_year" class="block text-sm font-medium text-gray-600 mb-1">Year</label>
          <select id="monthly_year" name="monthly_year" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <% var thisYear = new Date().getFullYear(); for (var y = thisYear - 1; y <= thisYear + 2; y++) { %>
              <option value="<%= y %>" <%= y === existingYear ? 'selected' : '' %>><%= y %></option>
            <% } %>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-600 mb-2">Naming mode</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <label class="bk2-month-mode is-on">
            <input type="radio" name="monthly_mode" value="split" checked>
            <span class="bk2-month-mode-title">One job per month</span>
            <span class="bk2-month-mode-sub">e.g. <code>May - Packages</code>, <code>June - Packages</code></span>
          </label>
          <label class="bk2-month-mode">
            <input type="radio" name="monthly_mode" value="combined">
            <span class="bk2-month-mode-title">Single combined job</span>
            <span class="bk2-month-mode-sub">e.g. <code>May–July - Packages</code> or <code>Multiple months - Packages</code></span>
          </label>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-600 mb-2">Months <%= isEdit ? 'to add' : 'to create' %></label>
        <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-2" id="monthly-months-grid">
          <%
            var MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
            var defaultTickIdx = isEdit ? -1 : new Date().getMonth();
            MONTH_NAMES.forEach(function(name, i) {
          %>
            <label class="bk2-month-chip">
              <input type="checkbox" name="monthly_months" value="<%= name %>" <%= i === defaultTickIdx ? 'checked' : '' %>>
              <span><%= name %></span>
            </label>
          <% }); %>
        </div>
        <div class="mt-2 flex gap-2 text-xs">
          <button type="button" id="monthly-pick-all"   class="text-brand-600 hover:underline">Select all</button>
          <span class="text-gray-300">·</span>
          <button type="button" id="monthly-pick-rest"  class="text-brand-600 hover:underline">Rest of year</button>
          <span class="text-gray-300">·</span>
          <button type="button" id="monthly-pick-clear" class="text-gray-500 hover:underline">Clear</button>
        </div>
      </div>
      <p id="monthly-preview" class="text-xs text-gray-500"></p>
    </div>
  </div>

  <style>
    .bk2-month-chip {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 6px 10px; border: 1px solid #E5E7EB; border-radius: 8px;
      background: #fff; font-size: 12px; font-weight: 500; color: #374151;
      cursor: pointer; transition: background 100ms ease, border-color 100ms ease, color 100ms ease;
      user-select: none;
    }
    .bk2-month-chip input { position: absolute; opacity: 0; pointer-events: none; }
    .bk2-month-chip:hover { background: #F9FAFB; }
    .bk2-month-chip.is-on, .bk2-month-chip:has(input:checked) {
      background: #EFF6FF; border-color: #2B7FFF; color: #1D4ED8; font-weight: 600;
    }
    .bk2-month-mode {
      display: flex; flex-direction: column; gap: 2px;
      padding: 10px 12px; border: 1.5px solid #E5E7EB; border-radius: 9px;
      background: #fff; cursor: pointer;
      transition: border-color 100ms ease, background 100ms ease;
    }
    .bk2-month-mode input { position: absolute; opacity: 0; pointer-events: none; }
    .bk2-month-mode:hover { background: #F9FAFB; }
    .bk2-month-mode.is-on, .bk2-month-mode:has(input:checked) {
      border-color: #2B7FFF; background: #EFF6FF;
    }
    .bk2-month-mode-title { font-size: 13px; font-weight: 600; color: #111827; }
    .bk2-month-mode-sub   { font-size: 11px; color: #6B7280; }
    .bk2-month-mode-sub code { background: #F3F4F6; padding: 1px 5px; border-radius: 4px; font-family: ui-monospace, monospace; font-size: 10.5px; }

    /* Dark-mode variants for the chip + mode surfaces. */
    body.dark-glass .bk2-month-chip {
      background: rgba(255,255,255,0.04);
      border-color: rgba(255,255,255,0.10);
      color: rgba(255,255,255,0.85);
    }
    body.dark-glass .bk2-month-chip:hover { background: rgba(255,255,255,0.08); }
    body.dark-glass .bk2-month-chip.is-on,
    body.dark-glass .bk2-month-chip:has(input:checked) {
      background: rgba(43,127,255,0.20);
      border-color: #2B7FFF;
      color: #93C5FD;
    }
    body.dark-glass .bk2-month-mode {
      background: rgba(255,255,255,0.04);
      border-color: rgba(255,255,255,0.12);
    }
    body.dark-glass .bk2-month-mode:hover { background: rgba(255,255,255,0.08); }
    body.dark-glass .bk2-month-mode.is-on,
    body.dark-glass .bk2-month-mode:has(input:checked) {
      background: rgba(43,127,255,0.18);
      border-color: #2B7FFF;
    }
    body.dark-glass .bk2-month-mode-title { color: rgba(255,255,255,0.92); }
    body.dark-glass .bk2-month-mode-sub { color: rgba(255,255,255,0.55); }
    body.dark-glass .bk2-month-mode-sub code { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.85); }
  </style>

  <script>
    (function () {
      var toggle = document.getElementById('monthly_package');
      var cfg    = document.getElementById('monthly-package-config');
      var preview = document.getElementById('monthly-preview');
      var pattern = document.getElementById('recurring_pattern_name');
      var year    = document.getElementById('monthly_year');
      var grid    = document.getElementById('monthly-months-grid');
      if (!toggle || !cfg) return;

      function activeMonths() {
        return Array.from(grid.querySelectorAll('input[name="monthly_months"]:checked')).map(function (i) { return i.value; });
      }
      function mode() {
        var on = document.querySelector('input[name="monthly_mode"]:checked');
        return on ? on.value : 'split';
      }
      // Mirror the server-side combinedMonthsJobName(): contiguous run
      // collapses to "Start–End - Pattern"; non-contiguous up to 3 shows
      // short names; more than 3 shows "Multiple months - Pattern".
      function combinedName(months, p) {
        var FULL = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        var sorted = months.slice().map(function (n) { return FULL.indexOf(n); }).sort(function (a, b) { return a - b; });
        if (!sorted.length) return p;
        if (sorted.length === 1) return FULL[sorted[0]] + ' - ' + p;
        var contiguous = sorted.every(function (n, i) { return i === 0 || n === sorted[i - 1] + 1; });
        if (contiguous) return FULL[sorted[0]] + '–' + FULL[sorted[sorted.length - 1]] + ' - ' + p;
        if (sorted.length <= 3) return sorted.map(function (n) { return FULL[n].slice(0, 3); }).join(', ') + ' - ' + p;
        return 'Multiple months - ' + p;
      }
      function renderPreview() {
        if (!preview) return;
        var months = activeMonths();
        if (!months.length) { preview.textContent = 'No months selected — tick one or more above.'; return; }
        var p = (pattern.value || 'Packages').trim();
        var y = year.value;
        if (mode() === 'combined') {
          preview.innerHTML = 'Will create 1 combined job: ' +
            '<code style="background:#F3F4F6;padding:1px 6px;border-radius:4px">' + combinedName(months, p) + ' (' + y + ')</code>';
        } else {
          preview.innerHTML = 'Will create ' + months.length + ' job(s): ' +
            months.map(function (m) { return '<code style="background:#F3F4F6;padding:1px 6px;border-radius:4px">' + m + ' - ' + p + ' (' + y + ')</code>'; }).join(' ');
        }
      }
      function sync() {
        cfg.style.display = toggle.checked ? '' : 'none';
        if (toggle.checked) renderPreview();
      }
      toggle.addEventListener('change', sync);
      if (pattern) pattern.addEventListener('input', renderPreview);
      if (year)    year.addEventListener('change', renderPreview);
      grid.addEventListener('change', function (e) {
        if (e.target.matches('input[name="monthly_months"]')) renderPreview();
      });
      document.querySelectorAll('input[name="monthly_mode"]').forEach(function (r) {
        r.addEventListener('change', function () {
          document.querySelectorAll('.bk2-month-mode').forEach(function (m) { m.classList.toggle('is-on', m.querySelector('input').checked); });
          renderPreview();
        });
      });

      var pickAll = document.getElementById('monthly-pick-all');
      var pickRest = document.getElementById('monthly-pick-rest');
      var pickClear = document.getElementById('monthly-pick-clear');
      function set(filterFn) {
        grid.querySelectorAll('input[name="monthly_months"]').forEach(function (cb, idx) {
          cb.checked = filterFn(idx);
        });
        renderPreview();
      }
      if (pickAll)   pickAll.addEventListener('click',   function () { set(function () { return true; }); });
      if (pickRest)  pickRest.addEventListener('click',  function () { var now = new Date().getMonth(); set(function (i) { return i >= now; }); });
      if (pickClear) pickClear.addEventListener('click', function () { set(function () { return false; }); });

      sync();
    })();
  </script>

  <!-- Notes -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">Notes</h2>
    <div>
      <label for="notes" class="block text-sm font-medium text-gray-600 mb-1">Notes</label>
      <textarea id="notes" name="notes" rows="4"
        placeholder="Additional notes about this job..."
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-y"><%= isEdit && job.notes ? job.notes : '' %></textarea>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex items-center gap-3">
    <button type="submit" class="px-6 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg transition-colors">
      <%= isEdit ? 'Update Job' : 'Create Job' %>
    </button>
    <a href="/projects" class="px-6 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium rounded-lg transition-colors">Cancel</a>
  </div>
</form>
