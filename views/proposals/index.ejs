<% locals.currentPage = 'proposals' %>
<%
  function money(v) { return '$' + (v || 0).toLocaleString('en-AU', { minimumFractionDigits: 0, maximumFractionDigits: 0 }); }
  const STATUS_BADGE = {
    draft: 'bg-gray-50 text-gray-600 ring-1 ring-gray-600/20',
    sent: 'bg-amber-50 text-amber-700 ring-1 ring-amber-600/20',
    accepted: 'bg-teal-50 text-teal-700 ring-1 ring-teal-600/20',
    declined: 'bg-red-50 text-red-700 ring-1 ring-red-600/20',
    superseded: 'bg-slate-50 text-slate-500 ring-1 ring-slate-600/20',
    withdrawn: 'bg-slate-50 text-slate-500 ring-1 ring-slate-600/20',
  };
%>

<%- include('../partials/page-header', {
  eyebrow: 'CRM',
  title: 'Proposals',
  subtitle: 'Controlled commercial offers — every revision retained, nothing overwritten.',
}) %>

<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-5">
  <div class="stat-card">
    <p class="stat-card-label">Proposals</p>
    <p class="stat-card-value <%= stats.total ? 'is-info' : 'is-muted' %>"><%= stats.total || 0 %></p>
  </div>
  <div class="stat-card">
    <p class="stat-card-label">Draft</p>
    <p class="stat-card-value is-muted"><%= stats.draft || 0 %></p>
  </div>
  <div class="stat-card <%= stats.sent ? 'accent-amber' : '' %>">
    <p class="stat-card-label">Awaiting Response</p>
    <p class="stat-card-value <%= stats.sent ? 'is-warn' : 'is-muted' %>"><%= stats.sent || 0 %></p>
  </div>
  <div class="stat-card">
    <p class="stat-card-label">Awaiting Value</p>
    <p class="stat-card-value <%= stats.awaiting_value ? 'is-warn' : 'is-muted' %>"><%= money(stats.awaiting_value) %></p>
  </div>
  <div class="stat-card">
    <p class="stat-card-label">Accepted</p>
    <p class="stat-card-value <%= stats.accepted ? 'is-good' : 'is-muted' %>"><%= stats.accepted || 0 %></p>
  </div>
</div>

<form method="GET" action="/proposals" class="bg-white border border-gray-200 rounded-xl shadow-sm p-3 sm:p-4 mb-5">
  <div class="flex flex-wrap items-end gap-3">
    <div class="flex-1 min-w-[180px]">
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">Search</label>
      <input type="text" name="search" value="<%= filters.search || '' %>" placeholder="Ref, opportunity, client..."
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
    </div>
    <div>
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-0.5">Status</label>
      <select name="status" class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <option value="">All</option>
        <% ['draft','sent','accepted','declined','superseded','withdrawn'].forEach(s => { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
        <% }) %>
      </select>
    </div>
    <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg transition-colors">Filter</button>
  </div>
</form>

<% if (!proposals.length) { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-10 text-center">
    <p class="text-gray-500 text-sm mb-1">No proposals yet.</p>
    <p class="text-gray-400 text-xs">Proposals are created from an opportunity — open one and choose "New Proposal".</p>
  </div>
<% } else { %>
<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead>
      <tr class="border-b border-gray-100">
        <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Ref</th>
        <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest">Opportunity</th>
        <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden md:table-cell">Client</th>
        <th class="px-3 py-2.5 text-right text-[10px] font-bold text-gray-400 uppercase tracking-widest">Fee</th>
        <th class="px-3 py-2.5 text-center text-[10px] font-bold text-gray-400 uppercase tracking-widest">Status</th>
        <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden lg:table-cell">Sent</th>
        <th class="px-3 py-2.5 text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest hidden lg:table-cell">Follow-up</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% proposals.forEach(p => { %>
      <tr class="hover:bg-gray-50">
        <td class="px-3 py-2.5">
          <a href="/proposals/<%= p.id %>" class="text-brand-600 hover:text-brand-700 font-mono text-xs font-bold hover:underline"><%= p.proposal_ref %></a>
        </td>
        <td class="px-3 py-2.5">
          <a href="/opportunities/<%= p.opportunity_id %>" class="text-gray-900 hover:text-brand-700 font-medium hover:underline truncate block max-w-[240px]"><%= p.opp_title %></a>
          <p class="text-gray-400 text-[10px] font-mono"><%= p.opportunity_number %></p>
        </td>
        <td class="px-3 py-2.5 text-gray-600 hidden md:table-cell"><%= p.client_name || '—' %></td>
        <td class="px-3 py-2.5 text-right text-gray-900 font-medium tabular-nums"><%= money(p.fee) %></td>
        <td class="px-3 py-2.5 text-center">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold <%= STATUS_BADGE[p.status] || STATUS_BADGE.draft %>"><%= p.status.toUpperCase() %></span>
        </td>
        <td class="px-3 py-2.5 text-gray-500 text-xs tabular-nums hidden lg:table-cell"><%= p.sent_date ? formatDateShort(p.sent_date) : '—' %></td>
        <td class="px-3 py-2.5 text-xs tabular-nums hidden lg:table-cell <%= p.status === 'sent' && p.follow_up_date && p.follow_up_date < new Date().toISOString().slice(0,10) ? 'text-red-600 font-semibold' : 'text-gray-500' %>">
          <%= p.follow_up_date ? formatDateShort(p.follow_up_date) : '—' %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
