<%
const statusBadgeClass = {
  draft:      'bg-gray-100 text-gray-700 ring-gray-200',
  sent:       'bg-blue-50 text-blue-700 ring-blue-200',
  accepted:   'bg-emerald-50 text-emerald-700 ring-emerald-200',
  rejected:   'bg-red-50 text-red-700 ring-red-200',
  expired:    'bg-amber-50 text-amber-700 ring-amber-200',
  superseded: 'bg-purple-50 text-purple-700 ring-purple-200',
};
function fmtMoney(n) {
  if (n === null || n === undefined) return '—';
  return '$' + Number(n).toLocaleString('en-AU', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
const disabled = isLocked ? 'disabled' : '';
%>

<div class="max-w-6xl mx-auto space-y-6">

  <!-- Header strip -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <a href="/quotes" class="inline-flex items-center gap-1 text-xs text-gray-500 hover:text-gray-700 mb-2">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Back to quotes
        </a>
        <div class="flex items-center gap-3">
          <h1 class="text-2xl font-bold text-gray-900 font-mono"><%= quote.quote_number %></h1>
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium ring-1 rounded <%= statusBadgeClass[quote.status] %>">
            <%= statusLabels[quote.status] %>
          </span>
          <% if (quote.version > 1) { %>
            <span class="text-xs text-gray-500">Version <%= quote.version %></span>
          <% } %>
        </div>
        <p class="text-base text-gray-700 mt-1"><%= quote.project_name %></p>
        <p class="text-sm text-gray-500 mt-0.5">
          <%= quote.client_name || quote.client_name_snapshot || 'No client' %>
          <% if (quote.prepared_by_name) { %>
            · Prepared by <%= quote.prepared_by_name %>
          <% } %>
          <% if (quote.rate_card_name) { %>
            · Rate card: <a href="/rate-cards/<%= quote.rate_card_id %>" class="underline hover:text-brand-700"><%= quote.rate_card_name %></a>
          <% } %>
        </p>
      </div>
      <div class="flex items-center gap-2 flex-wrap justify-end">
        <% if (!isLocked) { %>
          <form method="POST" action="/quotes/<%= quote.id %>/delete" class="inline" onsubmit="return confirm('Delete this draft quote? This cannot be undone.');">
            <%- include('../../partials/csrf') %>
            <button type="submit" class="px-3 py-1.5 text-xs font-medium text-red-700 bg-white border border-red-200 hover:bg-red-50 rounded-lg">Delete draft</button>
          </form>
        <% } %>
      </div>
    </div>

    <% if (isLocked) { %>
      <div class="mt-4 px-3 py-2 bg-amber-50 border border-amber-200 text-amber-800 text-xs rounded-lg">
        This quote is <%= statusLabels[quote.status].toLowerCase() %> and its header fields are locked. To change it, create a revision (coming in a follow-up PR).
      </div>
    <% } %>
  </div>

  <% if (flash_success && flash_success.length > 0) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-lg text-sm" data-auto-dismiss><%= flash_success[0] %></div>
  <% } %>
  <% if (flash_error && flash_error.length > 0) { %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm" data-auto-dismiss><%= flash_error[0] %></div>
  <% } %>

  <!-- Totals snapshot (placeholders until PR #5 — Site Matrix) -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <div class="bg-white border border-gray-200 rounded-xl p-4">
      <p class="text-[11px] uppercase tracking-wide text-gray-500 font-semibold">Sites</p>
      <p class="text-2xl font-bold text-gray-900 mt-1"><%= siteCount %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl p-4">
      <p class="text-[11px] uppercase tracking-wide text-gray-500 font-semibold">Columns</p>
      <p class="text-2xl font-bold text-gray-900 mt-1"><%= columnCount %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl p-4">
      <p class="text-[11px] uppercase tracking-wide text-gray-500 font-semibold">Subtotal (ex GST)</p>
      <p class="text-2xl font-bold text-gray-900 mt-1 font-mono"><%= fmtMoney(quote.subtotal_ex_gst) %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl p-4">
      <p class="text-[11px] uppercase tracking-wide text-gray-500 font-semibold">Total (inc GST)</p>
      <p class="text-2xl font-bold text-gray-900 mt-1 font-mono"><%= fmtMoney(quote.total_inc_gst) %></p>
    </div>
  </div>

  <!-- Site Matrix -->
  <%- include('_matrix') %>

  <!-- Header edit form (only fields users can edit while draft) -->
  <form method="POST" action="/quotes/<%= quote.id %>" class="space-y-6">
    <%- include('../../partials/csrf') %>

    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-base font-semibold text-gray-900">Header</h2>
      </div>
      <div class="p-5 space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Client</label>
            <select name="client_id" <%= disabled %> class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500">
              <option value="">— Use free-text name —</option>
              <% clients.forEach(c => { %>
                <option value="<%= c.id %>" <%= String(quote.client_id) === String(c.id) ? 'selected' : '' %>><%= c.company_name %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Client name (free-text)</label>
            <input type="text" name="client_name_freetext" value="<%= quote.client_name_snapshot %>" <%= disabled %>
              class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500">
          </div>
        </div>
        <div>
          <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Project name</label>
          <input type="text" name="project_name" value="<%= quote.project_name %>" required <%= disabled %>
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500">
        </div>
        <div>
          <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Project description</label>
          <textarea name="project_description" rows="3" <%= disabled %>
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500"><%= quote.project_description %></textarea>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Quote date</label>
            <input type="date" name="quote_date" value="<%= quote.quote_date || '' %>" <%= disabled %>
              class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500">
          </div>
          <div>
            <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Valid until</label>
            <input type="date" name="valid_until_date" value="<%= quote.valid_until_date || '' %>" <%= disabled %>
              class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500">
          </div>
          <div class="flex items-end pb-1.5">
            <label class="flex items-center gap-2">
              <input type="checkbox" name="within_50km" <%= quote.within_50km ? 'checked' : '' %> <%= disabled %> class="rounded border-gray-300 text-brand-600">
              <span class="text-xs text-gray-700">Within 50 km of depot</span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Inclusions / exclusions -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-base font-semibold text-gray-900">Inclusions, Exclusions &amp; Terms</h2>
        <p class="text-xs text-gray-500 mt-0.5">Shown on the client PDF. Pre-filled from your <a href="/rate-cards/settings" class="underline">Quoting Settings</a>.</p>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <label class="block text-[11px] uppercase tracking-wide text-emerald-700 font-semibold mb-1">Inclusions (one per line)</label>
          <textarea name="inclusions_text" rows="6" <%= disabled %>
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500"><%= inclusions %></textarea>
        </div>
        <div>
          <label class="block text-[11px] uppercase tracking-wide text-amber-700 font-semibold mb-1">Exclusions (one per line)</label>
          <textarea name="exclusions_text" rows="6" <%= disabled %>
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500"><%= exclusions %></textarea>
        </div>
        <div>
          <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Terms</label>
          <textarea name="terms" rows="10" <%= disabled %>
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500"><%= quote.terms || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- Internal notes -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-base font-semibold text-gray-900">Internal Notes</h2>
        <p class="text-xs text-gray-500 mt-0.5">Office-only. Never appears on the client PDF.</p>
      </div>
      <div class="p-5">
        <textarea name="internal_notes" rows="3" <%= disabled %>
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 disabled:bg-gray-50 disabled:text-gray-500"><%= quote.internal_notes || '' %></textarea>
      </div>
    </div>

    <% if (!isLocked) { %>
      <div class="flex items-center justify-end gap-2">
        <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Save changes
        </button>
      </div>
    <% } %>
  </form>

</div>
