<%
// Format a unit key (per_shift → per shift) for display
function unitLabel(u) { return u ? u.replace(/_/g, ' ') : ''; }
// Pre-built defaults so the "Add item" form doesn't repeat itself per category
const addDefaults = {
  planning_compliance:  { unit: 'per_shift',       cost_method: 'fixed',          has_hours_input: 0, crew: '' },
  tc_labour:            { unit: 'per_hour',        cost_method: 'computed_crew',  has_hours_input: 1, crew: '{"tc_count": 1, "tl_count": 1, "supervisor_count": 0}' },
  equipment_vehicles:   { unit: 'per_shift',       cost_method: 'fixed',          has_hours_input: 0, crew: '' },
  provisioning:         { unit: 'per_application', cost_method: 'fixed',          has_hours_input: 0, crew: '' },
  allowances_misc:      { unit: 'per_shift',       cost_method: 'fixed',          has_hours_input: 0, crew: '' },
};
%>

<div class="max-w-6xl mx-auto space-y-6">

  <!-- Header -->
  <div class="flex items-start justify-between gap-4">
    <div>
      <a href="/rate-cards" class="inline-flex items-center gap-1 text-xs text-gray-500 hover:text-gray-700 mb-2">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Back to rate cards
      </a>
      <h1 class="text-2xl font-bold text-gray-900"><%= card.name %></h1>
      <div class="flex items-center gap-2 mt-1">
        <% if (card.purpose === 'quoting') { %>
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 ring-1 ring-blue-200 rounded">Quoting</span>
        <% } else { %>
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium bg-purple-50 text-purple-700 ring-1 ring-purple-200 rounded">Reference</span>
        <% } %>
        <% if (card.is_default) { %>
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium bg-amber-50 text-amber-700 ring-1 ring-amber-200 rounded">Default</span>
        <% } %>
        <% if (!card.is_active) { %>
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-600 rounded">Inactive</span>
        <% } %>
      </div>
    </div>
  </div>

  <% if (flash_success && flash_success.length > 0) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-lg text-sm" data-auto-dismiss><%= flash_success[0] %></div>
  <% } %>
  <% if (flash_error && flash_error.length > 0) { %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm" data-auto-dismiss><%= flash_error[0] %></div>
  <% } %>

  <!-- Header form -->
  <details class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden group" <%= itemsByCategory && Object.values(itemsByCategory).every(arr => arr.length === 0) ? 'open' : '' %>>
    <summary class="px-5 py-4 border-b border-gray-200 bg-gray-50 cursor-pointer flex items-center justify-between">
      <span class="text-base font-semibold text-gray-900">Card Details</span>
      <svg class="w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
    </summary>
    <form method="POST" action="/rate-cards/<%= card.id %>" class="p-5 space-y-4">
      <%- include('../../partials/csrf') %>
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
        <input type="text" id="name" name="name" value="<%= card.name %>" required
          class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
      </div>
      <div>
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
        <textarea id="description" name="description" rows="2"
          class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"><%= card.description %></textarea>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label for="client_id" class="block text-sm font-medium text-gray-700 mb-1">Client</label>
          <select id="client_id" name="client_id" class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <option value="">— Not tied to a specific client —</option>
            <% clients.forEach(c => { %>
              <option value="<%= c.id %>" <%= String(card.client_id) === String(c.id) ? 'selected' : '' %>><%= c.company_name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="effective_from" class="block text-sm font-medium text-gray-700 mb-1">Effective from</label>
          <input type="date" id="effective_from" name="effective_from" value="<%= card.effective_from || '' %>"
            class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label for="effective_to" class="block text-sm font-medium text-gray-700 mb-1">Effective to</label>
          <input type="date" id="effective_to" name="effective_to" value="<%= card.effective_to || '' %>"
            class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <span class="block text-sm font-medium text-gray-700 mb-1">Purpose</span>
          <div class="flex items-center gap-2">
            <label class="flex items-center gap-1.5 text-sm"><input type="radio" name="purpose" value="quoting"   <%= card.purpose === 'quoting'   ? 'checked' : '' %>> Quoting</label>
            <label class="flex items-center gap-1.5 text-sm"><input type="radio" name="purpose" value="reference" <%= card.purpose === 'reference' ? 'checked' : '' %>> Reference</label>
          </div>
        </div>
        <div class="flex items-center gap-6">
          <label class="flex items-center gap-3">
            <input type="checkbox" name="is_default" class="sr-only peer" <%= card.is_default ? 'checked' : '' %>>
            <div class="w-10 h-5 bg-gray-200 peer-focus:ring-2 peer-focus:ring-brand-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-brand-600 relative"></div>
            <span class="text-sm text-gray-700">Default card</span>
          </label>
          <label class="flex items-center gap-3">
            <input type="checkbox" name="is_active" class="sr-only peer" <%= card.is_active ? 'checked' : '' %>>
            <div class="w-10 h-5 bg-gray-200 peer-focus:ring-2 peer-focus:ring-brand-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-brand-600 relative"></div>
            <span class="text-sm text-gray-700">Active</span>
          </label>
        </div>
      </div>
      <div class="flex justify-end">
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg">Save card details</button>
      </div>
    </form>
  </details>

  <!-- Items, grouped by category -->
  <% categories.forEach(cat => {
       const items = itemsByCategory[cat.key] || [];
       const def = addDefaults[cat.key];
  %>
    <div id="cat-<%= cat.key %>" class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900"><%= cat.label %></h2>
        <span class="text-xs text-gray-500"><%= items.length %> item<%= items.length === 1 ? '' : 's' %></span>
      </div>

      <div class="divide-y divide-gray-100">
        <% items.forEach(item => { %>
          <div id="item-<%= item.id %>" class="p-5">
            <form method="POST" action="/rate-cards/<%= card.id %>/items/<%= item.id %>" class="space-y-3">
              <%- include('../../partials/csrf') %>

              <!-- Row 1: name + code + active -->
              <div class="grid grid-cols-12 gap-3">
                <div class="col-span-12 md:col-span-7">
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Name</label>
                  <input type="text" name="name" required value="<%= item.name %>"
                    class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
                </div>
                <div class="col-span-6 md:col-span-3">
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Code</label>
                  <input type="text" name="code" value="<%= item.code || '' %>" placeholder="e.g. TGS_PREP"
                    class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
                </div>
                <div class="col-span-6 md:col-span-2 flex items-end pb-1.5">
                  <label class="flex items-center gap-2">
                    <input type="checkbox" name="is_active" <%= item.is_active ? 'checked' : '' %> class="rounded border-gray-300 text-brand-600">
                    <span class="text-xs text-gray-700">Active</span>
                  </label>
                </div>
              </div>

              <!-- Row 2: sell side -->
              <div class="grid grid-cols-12 gap-3">
                <div class="col-span-6 md:col-span-3">
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Unit</label>
                  <select name="unit" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                    <% units.forEach(u => { %><option value="<%= u %>" <%= item.unit === u ? 'selected' : '' %>><%= unitLabel(u) %></option><% }) %>
                  </select>
                </div>
                <div class="col-span-6 md:col-span-3">
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Sell rate (ex GST)</label>
                  <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
                    <input type="number" step="0.01" min="0" name="standard_rate" value="<%= item.standard_rate ?? '' %>"
                      placeholder="<%= item.pricing_status === 'poa' ? 'POA' : '0.00' %>"
                      class="w-full pl-6 pr-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  </div>
                </div>
                <div class="col-span-6 md:col-span-3 flex items-end pb-1.5">
                  <label class="flex items-center gap-2">
                    <input type="checkbox" name="has_hours_input" <%= item.has_hours_input ? 'checked' : '' %> class="rounded border-gray-300 text-brand-600">
                    <span class="text-xs text-gray-700">Qty × Hours × Rate</span>
                  </label>
                </div>
                <div class="col-span-6 md:col-span-3 flex items-end pb-1.5">
                  <label class="flex items-center gap-2">
                    <input type="checkbox" name="is_addon" <%= item.is_addon ? 'checked' : '' %> class="rounded border-gray-300 text-brand-600">
                    <span class="text-xs text-gray-700">Add-on (charges on top of a crew line)</span>
                  </label>
                </div>
              </div>

              <!-- Row 3: cost side -->
              <div class="grid grid-cols-12 gap-3 pt-2 mt-2 border-t border-gray-100">
                <div class="col-span-12 md:col-span-3">
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Cost method</label>
                  <select name="cost_method" data-cost-method-for="<%= item.id %>"
                    class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                    <option value="fixed"          <%= item.cost_method === 'fixed' ? 'selected' : '' %>>Fixed unit cost</option>
                    <option value="computed_crew"  <%= item.cost_method === 'computed_crew' ? 'selected' : '' %>>Computed from crew</option>
                  </select>
                </div>
                <div class="col-span-12 md:col-span-3" data-cost-fixed="<%= item.id %>" <%= item.cost_method === 'computed_crew' ? 'hidden' : '' %>>
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Unit cost</label>
                  <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
                    <input type="number" step="0.01" min="0" name="standard_unit_cost" value="<%= item.standard_unit_cost ?? '' %>"
                      class="w-full pl-6 pr-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  </div>
                </div>
                <div class="col-span-12 md:col-span-6" data-cost-crew="<%= item.id %>" <%= item.cost_method === 'fixed' ? 'hidden' : '' %>>
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Crew composition (JSON)</label>
                  <input type="text" name="crew_composition_json" value='<%= item.crew_composition_json || "" %>' placeholder='{"tc_count": 1, "tl_count": 1, "supervisor_count": 0}'
                    class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <p class="text-[11px] text-gray-400 mt-1">Counters editor coming in a follow-up. Use Settings defaults × these counts to resolve hourly cost at quote time.</p>
                </div>
                <div class="col-span-12 md:col-span-3" data-cost-crew-vehicle="<%= item.id %>" <%= item.cost_method === 'fixed' ? 'hidden' : '' %>>
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Vehicle cost / hr</label>
                  <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
                    <input type="number" step="0.01" min="0" name="vehicle_cost_per_hour" value="<%= item.vehicle_cost_per_hour ?? '' %>" placeholder="0.00"
                      class="w-full pl-6 pr-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  </div>
                </div>
              </div>

              <!-- Row 4: misc -->
              <div class="grid grid-cols-12 gap-3 pt-2 mt-2 border-t border-gray-100">
                <div class="col-span-6 md:col-span-2">
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Min booking (hrs)</label>
                  <input type="number" step="0.5" min="0" name="min_booking_hours" value="<%= item.min_booking_hours ?? '' %>" placeholder="—"
                    class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
                <div class="col-span-6 md:col-span-2">
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Pricing status</label>
                  <select name="pricing_status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                    <option value="priced" <%= item.pricing_status === 'priced' ? 'selected' : '' %>>Priced</option>
                    <option value="poa"    <%= item.pricing_status === 'poa'    ? 'selected' : '' %>>POA (price on application)</option>
                  </select>
                </div>
                <div class="col-span-12 md:col-span-8">
                  <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Notes</label>
                  <input type="text" name="notes" value="<%= item.notes || '' %>" placeholder="Internal note shown to office staff only"
                    class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
              </div>

              <!-- Action row -->
              <div class="flex items-center justify-end gap-2 pt-2">
                <button type="button"
                  onclick="if (confirm('Delete &quot;<%= item.name.replace(/'/g, '&#39;').replace(/"/g, '&quot;') %>&quot;? This removes the item and its variants. Quotes that already reference it will block deletion.')) document.getElementById('delete-item-<%= item.id %>').submit();"
                  class="px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-50 rounded-lg">Delete</button>
                <button type="submit" class="px-4 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg">Save</button>
              </div>
            </form>
            <!-- Sibling delete form so the delete button can submit without nesting forms -->
            <form id="delete-item-<%= item.id %>" method="POST" action="/rate-cards/<%= card.id %>/items/<%= item.id %>/delete" class="hidden">
              <%- include('../../partials/csrf') %>
            </form>
          </div>
        <% }) %>

        <!-- Add new item -->
        <details class="bg-gray-50/50">
          <summary class="px-5 py-3 cursor-pointer text-sm font-medium text-brand-700 hover:text-brand-800 flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Add item to <%= cat.label %>
          </summary>
          <form method="POST" action="/rate-cards/<%= card.id %>/items" class="p-5 space-y-3 border-t border-gray-200">
            <%- include('../../partials/csrf') %>
            <input type="hidden" name="category" value="<%= cat.key %>">
            <div class="grid grid-cols-12 gap-3">
              <div class="col-span-12 md:col-span-7">
                <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Name <span class="text-red-500">*</span></label>
                <input type="text" name="name" required placeholder="e.g. 2 TC Crew"
                  class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              </div>
              <div class="col-span-6 md:col-span-3">
                <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Code</label>
                <input type="text" name="code" placeholder="optional"
                  class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
              </div>
              <div class="col-span-6 md:col-span-2">
                <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Unit</label>
                <select name="unit" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <% units.forEach(u => { %><option value="<%= u %>" <%= def.unit === u ? 'selected' : '' %>><%= unitLabel(u) %></option><% }) %>
                </select>
              </div>
            </div>
            <div class="grid grid-cols-12 gap-3">
              <div class="col-span-6 md:col-span-3">
                <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Sell rate (ex GST)</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
                  <input type="number" step="0.01" min="0" name="standard_rate" placeholder="0.00"
                    class="w-full pl-6 pr-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
              </div>
              <div class="col-span-6 md:col-span-3">
                <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Cost method</label>
                <select name="cost_method" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                  <option value="fixed"         <%= def.cost_method === 'fixed' ? 'selected' : '' %>>Fixed</option>
                  <option value="computed_crew" <%= def.cost_method === 'computed_crew' ? 'selected' : '' %>>Computed from crew</option>
                </select>
              </div>
              <div class="col-span-6 md:col-span-3">
                <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Unit cost (if Fixed)</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
                  <input type="number" step="0.01" min="0" name="standard_unit_cost" placeholder="0.00"
                    class="w-full pl-6 pr-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
              </div>
              <div class="col-span-6 md:col-span-3 flex items-end gap-3 pb-1.5">
                <label class="flex items-center gap-2">
                  <input type="checkbox" name="has_hours_input" <%= def.has_hours_input ? 'checked' : '' %> class="rounded border-gray-300 text-brand-600">
                  <span class="text-xs text-gray-700">Qty × Hours × Rate</span>
                </label>
              </div>
            </div>
            <div class="grid grid-cols-12 gap-3">
              <div class="col-span-12 md:col-span-9">
                <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Crew composition (JSON, if Computed)</label>
                <input type="text" name="crew_composition_json" value='<%= def.crew %>' placeholder='{"tc_count": 1, "tl_count": 1, "supervisor_count": 0}'
                  class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-brand-500">
              </div>
              <div class="col-span-12 md:col-span-3">
                <label class="block text-[11px] uppercase tracking-wide text-gray-500 font-semibold mb-1">Vehicle $/hr</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
                  <input type="number" step="0.01" min="0" name="vehicle_cost_per_hour" placeholder="0.00"
                    class="w-full pl-6 pr-3 py-2 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
              </div>
            </div>
            <div class="flex justify-end">
              <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg">Add item</button>
            </div>
          </form>
        </details>
      </div>
    </div>
  <% }) %>

</div>

<script>
  // Toggle cost-method visibility for existing item rows. Re-run on every
  // change because we're not using a JS framework here.
  document.addEventListener('change', (e) => {
    if (!e.target.matches('select[data-cost-method-for]')) return;
    const id = e.target.dataset.costMethodFor;
    const fixed = document.querySelector(`[data-cost-fixed="${id}"]`);
    const crew  = document.querySelector(`[data-cost-crew="${id}"]`);
    const crewV = document.querySelector(`[data-cost-crew-vehicle="${id}"]`);
    const m = e.target.value;
    if (fixed) fixed.hidden = (m === 'computed_crew');
    if (crew)  crew.hidden  = (m === 'fixed');
    if (crewV) crewV.hidden = (m === 'fixed');
  });
</script>
