<div class="max-w-6xl mx-auto space-y-6">

  <%- include('../../partials/page-header', { rail: true, wrapperClass: '',
    eyebrow: 'Planning',
    title: 'Rate Cards',
    subtitle: 'Reusable price books used when building quotes.',
    actions: [
      { label: 'Quoting Settings', href: '/rate-cards/settings', style: 'secondary', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z' },
      { label: 'New Rate Card', href: '/rate-cards/new', style: 'primary', icon: 'M12 4v16m8-8H4' }
    ]
  }) %>

  <!-- Flash messages -->
  <% if (flash_success && flash_success.length > 0) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-lg text-sm" data-auto-dismiss>
      <%= flash_success[0] %>
    </div>
  <% } %>
  <% if (flash_error && flash_error.length > 0) { %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm" data-auto-dismiss>
      <%= flash_error[0] %>
    </div>
  <% } %>

  <!-- Filters -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm px-4 py-3 flex flex-wrap items-center gap-4">
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">Purpose</span>
      <% const purposes = [['all','All'],['quoting','Quoting'],['reference','Reference']]; %>
      <% purposes.forEach(([key, label]) => { %>
        <a href="?purpose=<%= key %>&active=<%= filter.active %>"
           class="px-2.5 py-1 text-xs font-medium rounded-md border <%= filter.purpose === key ? 'bg-brand-50 border-brand-200 text-brand-700' : 'bg-white border-gray-200 text-gray-600 hover:bg-gray-50' %>"><%= label %></a>
      <% }); %>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">Status</span>
      <% const statuses = [['active','Active'],['inactive','Inactive'],['all','All']]; %>
      <% statuses.forEach(([key, label]) => { %>
        <a href="?purpose=<%= filter.purpose %>&active=<%= key %>"
           class="px-2.5 py-1 text-xs font-medium rounded-md border <%= filter.active === key ? 'bg-brand-50 border-brand-200 text-brand-700' : 'bg-white border-gray-200 text-gray-600 hover:bg-gray-50' %>"><%= label %></a>
      <% }); %>
    </div>
  </div>

  <!-- List -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <% if (cards.length === 0) { %>
      <div class="px-6 py-16 text-center">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        <p class="text-sm text-gray-500">No rate cards yet matching these filters.</p>
        <a href="/rate-cards/new" class="inline-flex items-center gap-2 mt-4 px-3 py-2 text-sm font-medium text-brand-700 bg-brand-50 hover:bg-brand-100 rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Create the first rate card
        </a>
      </div>
    <% } else { %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
          <tr>
            <th class="px-4 py-3 text-left font-semibold">Name</th>
            <th class="px-4 py-3 text-left font-semibold">Purpose</th>
            <th class="px-4 py-3 text-left font-semibold">Client</th>
            <th class="px-4 py-3 text-left font-semibold">Effective</th>
            <th class="px-4 py-3 text-right font-semibold">Items</th>
            <th class="px-4 py-3 text-left font-semibold">Updated</th>
            <th class="px-4 py-3 text-right font-semibold">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% cards.forEach(card => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3">
                <a href="/rate-cards/<%= card.id %>" class="font-medium text-gray-900 hover:text-brand-700">
                  <%= card.name %>
                  <% if (card.is_default) { %>
                    <span class="inline-flex items-center gap-1 ml-2 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide bg-amber-50 text-amber-700 ring-1 ring-amber-200 rounded">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                      Default
                    </span>
                  <% } %>
                  <% if (!card.is_active) { %>
                    <span class="inline-flex items-center ml-2 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide bg-gray-100 text-gray-600 rounded">Inactive</span>
                  <% } %>
                </a>
                <% if (card.description) { %>
                  <p class="text-xs text-gray-500 mt-0.5"><%= card.description.length > 90 ? card.description.slice(0, 90) + '…' : card.description %></p>
                <% } %>
              </td>
              <td class="px-4 py-3">
                <% if (card.purpose === 'quoting') { %>
                  <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium bg-blue-50 text-blue-700 ring-1 ring-blue-200 rounded">Quoting</span>
                <% } else { %>
                  <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium bg-purple-50 text-purple-700 ring-1 ring-purple-200 rounded">Reference</span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-gray-700"><%= card.client_name || '—' %></td>
              <td class="px-4 py-3 text-gray-700 text-xs">
                <% if (card.effective_from || card.effective_to) { %>
                  <%= card.effective_from ? formatDateShort(card.effective_from) : '—' %>
                  →
                  <%= card.effective_to ? formatDateShort(card.effective_to) : '—' %>
                <% } else { %>
                  <span class="text-gray-400">No dates set</span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-right font-mono text-gray-700"><%= card.item_count %></td>
              <td class="px-4 py-3 text-xs text-gray-500"><%= formatDateShort(card.updated_at) %></td>
              <td class="px-4 py-3 text-right">
                <div class="inline-flex items-center gap-1">
                  <a href="/rate-cards/<%= card.id %>" class="px-2 py-1 text-xs font-medium text-brand-700 hover:bg-brand-50 rounded">Edit</a>
                  <form method="POST" action="/rate-cards/<%= card.id %>/delete" class="inline" onsubmit="return confirm('Delete rate card &quot;<%= card.name.replace(/'/g, '&#39;') %>&quot; and all its items? This cannot be undone.');">
                    <%- include('../../partials/csrf') %>
                    <button type="submit" class="px-2 py-1 text-xs font-medium text-red-700 hover:bg-red-50 rounded">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

</div>
