<div class="max-w-2xl mx-auto space-y-6">

  <!-- Header -->
  <div>
    <a href="/rate-cards" class="inline-flex items-center gap-1 text-xs text-gray-500 hover:text-gray-700 mb-2">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to rate cards
    </a>
    <h1 class="text-2xl font-bold text-gray-900">New Rate Card</h1>
    <p class="text-sm text-gray-500 mt-1">Create a new price book. You'll add rate items after the card is saved.</p>
  </div>

  <% if (flash_error && flash_error.length > 0) { %>
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm" data-auto-dismiss><%= flash_error[0] %></div>
  <% } %>

  <form method="POST" action="/rate-cards" class="space-y-6">
    <%- include('../../partials/csrf') %>

    <!-- Card details -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-base font-semibold text-gray-900">Card Details</h2>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name <span class="text-red-500">*</span></label>
          <input type="text" id="name" name="name" required value="<%= form.name %>" placeholder="e.g. TfNSW Pneumatic Tube Count Rates 2025"
            class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
        </div>
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
          <textarea id="description" name="description" rows="2" placeholder="What this rate card is for"
            class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"><%= form.description %></textarea>
        </div>
        <div>
          <label for="client_id" class="block text-sm font-medium text-gray-700 mb-1">Client (optional)</label>
          <select id="client_id" name="client_id" class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            <option value="">— Not tied to a specific client —</option>
            <% clients.forEach(c => { %>
              <option value="<%= c.id %>" <%= String(form.client_id) === String(c.id) ? 'selected' : '' %>><%= c.company_name %></option>
            <% }) %>
          </select>
          <p class="text-xs text-gray-400 mt-1">Helps filter rate cards on the quote builder.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="effective_from" class="block text-sm font-medium text-gray-700 mb-1">Effective from</label>
            <input type="date" id="effective_from" name="effective_from" value="<%= form.effective_from %>"
              class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          </div>
          <div>
            <label for="effective_to" class="block text-sm font-medium text-gray-700 mb-1">Effective to</label>
            <input type="date" id="effective_to" name="effective_to" value="<%= form.effective_to %>"
              class="w-full px-3 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent">
          </div>
        </div>
      </div>
    </div>

    <!-- Purpose & default -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-200 bg-gray-50">
        <h2 class="text-base font-semibold text-gray-900">Purpose</h2>
        <p class="text-xs text-gray-500 mt-0.5">Reference cards are import-only and not selectable when building a quote.</p>
      </div>
      <div class="p-5 space-y-3">
        <label class="flex items-start gap-3 p-3 border rounded-lg cursor-pointer hover:bg-gray-50 <%= form.purpose === 'quoting' ? 'border-brand-500 bg-brand-50/30' : 'border-gray-200' %>">
          <input type="radio" name="purpose" value="quoting" <%= form.purpose === 'quoting' ? 'checked' : '' %> class="mt-0.5 text-brand-600 focus:ring-brand-500">
          <div>
            <p class="text-sm font-medium text-gray-900">Quoting</p>
            <p class="text-xs text-gray-500 mt-0.5">Available when building new quotes. Most cards are this kind.</p>
          </div>
        </label>
        <label class="flex items-start gap-3 p-3 border rounded-lg cursor-pointer hover:bg-gray-50 <%= form.purpose === 'reference' ? 'border-brand-500 bg-brand-50/30' : 'border-gray-200' %>">
          <input type="radio" name="purpose" value="reference" <%= form.purpose === 'reference' ? 'checked' : '' %> class="mt-0.5 text-brand-600 focus:ring-brand-500">
          <div>
            <p class="text-sm font-medium text-gray-900">Reference</p>
            <p class="text-xs text-gray-500 mt-0.5">Imported competitor SoR or archived T&S card — visible for comparison but not used in quotes.</p>
          </div>
        </label>

        <div class="flex items-center gap-3 pt-2">
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="is_default" class="sr-only peer" <%= form.is_default ? 'checked' : '' %>>
            <div class="w-10 h-5 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-brand-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-brand-600"></div>
          </label>
          <div>
            <p class="text-sm text-gray-700">Set as default rate card</p>
            <p class="text-xs text-gray-400">New quotes will start with this card pre-selected. Only one card can be the default.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Action bar -->
    <div class="flex items-center justify-end gap-2">
      <a href="/rate-cards" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
      <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg transition-colors">
        Create rate card
      </button>
    </div>
  </form>
</div>
