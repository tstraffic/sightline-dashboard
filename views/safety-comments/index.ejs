<% locals.currentPage = 'safety-comments' %>
<%
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  const STATUS_BADGE = {
    submitted:    'bg-blue-50 text-blue-700 ring-blue-200',
    acknowledged: 'bg-amber-50 text-amber-700 ring-amber-200',
    under_review: 'bg-violet-50 text-violet-700 ring-violet-200',
    closed:       'bg-emerald-50 text-emerald-700 ring-emerald-200',
  };
  const CATEGORY_BADGE = {
    hazard:     'bg-rose-50 text-rose-700 ring-rose-200',
    swms_issue: 'bg-indigo-50 text-indigo-700 ring-indigo-200',
    suggestion: 'bg-blue-50 text-blue-700 ring-blue-200',
    equipment:  'bg-amber-50 text-amber-700 ring-amber-200',
    general:    'bg-gray-50 text-gray-700 ring-gray-200',
  };
%>

<div class="max-w-6xl mx-auto space-y-5">
  <%- include('../partials/page-header', { rail: true, wrapperClass: '',
    eyebrow: 'Safety',
    title: 'Safety Comments',
    subtitle: 'Hazard flags, SWMS issues, suggestions, equipment concerns — anything workers submit through the portal lands here.'
  }) %>

  <!-- Stat cards -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <% ['submitted','acknowledged','under_review','closed'].forEach(s => { %>
      <a href="/safety-comments?status=<%= s %>" class="stat-card">
        <p class="stat-card-label"><%= statusLabels[s] %></p>
        <p class="stat-card-value <%= counts[s] > 0 ? '' : 'is-muted' %>"><%= counts[s] || 0 %></p>
      </a>
    <% }) %>
  </div>

  <!-- Filters -->
  <form method="GET" action="/safety-comments" class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 flex flex-wrap items-end gap-3">
    <div>
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Status</label>
      <select name="status" class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
        <option value="" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
        <option value="submitted"    <%= filters.status === 'submitted'    ? 'selected' : '' %>>Submitted</option>
        <option value="acknowledged" <%= filters.status === 'acknowledged' ? 'selected' : '' %>>Acknowledged</option>
        <option value="under_review" <%= filters.status === 'under_review' ? 'selected' : '' %>>Under review</option>
        <option value="closed"       <%= filters.status === 'closed'       ? 'selected' : '' %>>Closed</option>
      </select>
    </div>
    <div>
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Category</label>
      <select name="category" class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
        <option value="" <%= filters.category === 'all' ? 'selected' : '' %>>All</option>
        <% categoryValues.forEach(c => { %>
          <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= categoryLabels[c] %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Anonymous</label>
      <select name="anonymous" class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
        <option value=""  <%= filters.anonymous === 'all' ? 'selected' : '' %>>All</option>
        <option value="1" <%= filters.anonymous === '1'   ? 'selected' : '' %>>Only anonymous</option>
        <option value="0" <%= filters.anonymous === '0'   ? 'selected' : '' %>>Only identified</option>
      </select>
    </div>
    <button type="submit" class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-lg">Filter</button>
    <a href="/safety-comments" class="px-3 py-2 text-gray-500 text-sm hover:text-gray-700">Clear</a>
  </form>

  <% if (!rows.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm px-5 py-10 text-center text-sm text-gray-500">
      No comments matching this filter.
    </div>
  <% } else { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">#</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Category</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Submitter</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Body</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Job</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Status</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Submitted</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% rows.forEach(r => { %>
            <tr class="hover:bg-gray-50/50">
              <td class="px-3 py-2"><a href="/safety-comments/<%= r.id %>" class="font-semibold text-gray-900 hover:text-brand-600">#<%= r.id %></a></td>
              <td class="px-2 py-2"><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= CATEGORY_BADGE[r.category] %>"><%= categoryLabels[r.category] %></span></td>
              <td class="px-2 py-2 text-xs">
                <% if (r.is_anonymous) { %>
                  <span class="inline-flex items-center gap-1 text-gray-500"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>Anonymous</span>
                <% } else { %>
                  <span class="text-gray-700"><%= r.submitter_name || '—' %></span>
                <% } %>
              </td>
              <td class="px-2 py-2 text-xs text-gray-600 max-w-md truncate"><%= r.body %></td>
              <td class="px-2 py-2 text-xs text-gray-600"><%= r.job_number || '—' %></td>
              <td class="px-2 py-2"><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= STATUS_BADGE[r.status] %>"><%= statusLabels[r.status] %></span></td>
              <td class="px-2 py-2 text-xs text-gray-500 tabular-nums"><%= fmt(r.created_at) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
