<% locals.currentPage = 'safety-comments' %>
<%
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  const STATUS_BADGE = {
    submitted:    'bg-blue-50 text-blue-700 ring-blue-200',
    acknowledged: 'bg-amber-50 text-amber-700 ring-amber-200',
    under_review: 'bg-violet-50 text-violet-700 ring-violet-200',
    closed:       'bg-emerald-50 text-emerald-700 ring-emerald-200',
  };
  const CATEGORY_BADGE = {
    hazard:     'bg-rose-50 text-rose-700 ring-rose-200',
    swms_issue: 'bg-indigo-50 text-indigo-700 ring-indigo-200',
    suggestion: 'bg-blue-50 text-blue-700 ring-blue-200',
    equipment:  'bg-amber-50 text-amber-700 ring-amber-200',
    general:    'bg-gray-50 text-gray-700 ring-gray-200',
  };
%>

<div class="max-w-4xl mx-auto space-y-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <a href="/safety-comments" class="text-sm text-brand-600 hover:underline">← Safety Comments</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1 flex items-center gap-2 flex-wrap">
        Comment #<%= comment.id %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= CATEGORY_BADGE[comment.category] %>"><%= categoryLabels[comment.category] %></span>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= STATUS_BADGE[comment.status] %>"><%= statusLabels[comment.status] %></span>
        <% if (comment.is_anonymous) { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-gray-50 text-gray-600 ring-gray-200">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Anonymous
          </span>
        <% } %>
      </h1>
    </div>
    <form method="POST" action="/safety-comments/<%= comment.id %>/delete" onsubmit="return confirm('Delete this comment? This cannot be undone.')">
      <%- include('../partials/csrf') %>
      <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-red-50 hover:border-red-300 hover:text-red-600 text-gray-700 text-sm font-semibold rounded-lg">Delete</button>
    </form>
  </div>

  <!-- Header strip -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div>
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Submitter</p>
      <p class="text-sm font-semibold text-gray-900 mt-0.5">
        <% if (comment.is_anonymous) { %>
          <span class="text-gray-500 italic">Anonymous</span>
        <% } else { %>
          <%= comment.submitter_name || '—' %>
          <% if (comment.submitter_emp_id) { %><span class="text-gray-400 text-xs"> · <%= comment.submitter_emp_id %></span><% } %>
        <% } %>
      </p>
    </div>
    <div>
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Job reference</p>
      <p class="text-sm text-gray-700 mt-0.5"><%= comment.job_number || '—' %></p>
    </div>
    <div>
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Submitted</p>
      <p class="text-sm text-gray-700 mt-0.5 tabular-nums"><%= fmt(comment.created_at) %></p>
    </div>
    <div>
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Last update</p>
      <p class="text-sm text-gray-700 mt-0.5 tabular-nums"><%= fmt(comment.updated_at) %></p>
    </div>
  </div>

  <!-- Body -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Body</p>
    <p class="text-sm text-gray-800 whitespace-pre-line leading-relaxed"><%= comment.body %></p>
    <% if (photos.length) { %>
      <div class="mt-4 grid grid-cols-3 sm:grid-cols-4 gap-2">
        <% photos.forEach(p => { %>
          <a href="/safety-comments/<%= comment.id %>/photos/<%= p.id %>" target="_blank">
            <img src="/safety-comments/<%= comment.id %>/photos/<%= p.id %>" alt="" class="w-full h-24 object-cover rounded border border-gray-200 hover:border-brand-400 transition">
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <% if (comment.status === 'closed' && comment.office_response) { %>
    <!-- Already responded -->
    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-5">
      <p class="text-[10px] font-bold text-emerald-700 uppercase tracking-widest mb-1">Office response · <%= fmt(comment.response_at) %><% if (comment.response_by_name) { %> · <%= comment.response_by_name %><% } %></p>
      <p class="text-sm text-gray-800 whitespace-pre-line leading-relaxed mt-2"><%= comment.office_response %></p>
    </div>
  <% } else { %>
    <!-- Triage form: status + assignee + internal notes -->
    <form method="POST" action="/safety-comments/<%= comment.id %>" class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-4">
      <%- include('../partials/csrf') %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Status</label>
          <select name="status" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <% statusValues.forEach(s => { %>
              <option value="<%= s %>" <%= comment.status === s ? 'selected' : '' %>><%= statusLabels[s] %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Assigned to</label>
          <select name="assigned_to_id" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="">Unassigned</option>
            <% officeUsers.forEach(u => { %>
              <option value="<%= u.id %>" <%= comment.assigned_to_id == u.id ? 'selected' : '' %>><%= u.full_name %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div>
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Internal notes (office only)</label>
        <textarea name="internal_notes" rows="3" placeholder="What's the next step? Workers never see this."
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"><%= comment.internal_notes || '' %></textarea>
      </div>
      <div class="flex justify-end">
        <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Save</button>
      </div>
    </form>

    <!-- Respond form: closes the loop -->
    <form method="POST" action="/safety-comments/<%= comment.id %>/respond" class="bg-white border border-emerald-200 rounded-xl shadow-sm p-5 space-y-4">
      <%- include('../partials/csrf') %>
      <div>
        <h3 class="text-sm font-bold text-gray-900">Respond &amp; close</h3>
        <p class="text-xs text-gray-500 mt-0.5">Workers see this message in their portal and get a push notification.<% if (comment.is_anonymous) { %> <strong>Anonymous</strong>: the response is delivered without exposing the submitter's identity to you.<% } %></p>
      </div>
      <textarea name="response" rows="5" required placeholder="Write your response to the worker…"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
      <div class="flex justify-end">
        <button type="submit" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold rounded-lg">Send response &amp; close</button>
      </div>
    </form>
  <% } %>

  <% if (comment.internal_notes) { %>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
      <p class="text-[10px] font-bold text-amber-800 uppercase tracking-widest mb-1">Internal notes</p>
      <p class="text-sm text-amber-900 whitespace-pre-line"><%= comment.internal_notes %></p>
    </div>
  <% } %>
</div>
