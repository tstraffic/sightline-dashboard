<% locals.currentPage = 'safety-quizzes' %>
<%
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
%>

<div class="max-w-5xl mx-auto space-y-5">
  <div>
    <a href="/safety-quizzes/<%= quiz.id %>" class="text-sm text-brand-600 hover:underline">← <%= quiz.title %></a>
    <h1 class="text-2xl font-bold text-gray-900 mt-1">Attempts</h1>
    <p class="text-sm text-gray-500 mt-0.5">Latest attempt per worker. Pass mark for this quiz: <%= quiz.pass_mark %>%.</p>
  </div>

  <div class="border-b border-gray-200 flex items-center gap-1">
    <a href="/safety-quizzes/<%= quiz.id %>" class="px-4 py-2 -mb-px border-b-2 border-transparent text-gray-500 hover:text-gray-700 text-sm font-semibold">Details</a>
    <span class="px-4 py-2 -mb-px border-b-2 border-brand-600 text-brand-700 text-sm font-semibold">Attempts</span>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Worker</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Employee ID</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Status</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Score</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Attempts</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Last submitted</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% rows.forEach(r => { %>
          <tr class="hover:bg-gray-50/50">
            <td class="px-3 py-2 text-sm font-medium text-gray-900"><%= r.full_name %></td>
            <td class="px-2 py-2 text-xs text-gray-500"><%= r.employee_id || '—' %></td>
            <td class="px-2 py-2">
              <% if (!r.latest_attempt_id) { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-gray-50 text-gray-600 ring-gray-200">Not started</span>
              <% } else if (r.latest_status === 'in_progress') { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-amber-50 text-amber-700 ring-amber-200">In progress</span>
              <% } else if (r.latest_passed) { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-emerald-50 text-emerald-700 ring-emerald-200">Passed</span>
              <% } else { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-rose-50 text-rose-700 ring-rose-200">Failed</span>
              <% } %>
            </td>
            <td class="px-2 py-2 text-xs text-gray-600"><%= r.latest_score != null ? (r.latest_score + '%') : '—' %></td>
            <td class="px-2 py-2 text-xs text-gray-600"><%= r.attempt_count || 0 %></td>
            <td class="px-2 py-2 text-xs text-gray-500 tabular-nums"><%= fmt(r.latest_submitted_at) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
