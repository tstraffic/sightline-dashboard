<% locals.currentPage = 'safety-quizzes' %>
<%
  const formAction = isEdit ? '/safety-quizzes/' + quiz.id : '/safety-quizzes';
  // The source dropdown encodes both type+id into one value "type:id" so the
  // route can parse a single field.
  const currentSourceValue = (isEdit && quiz.source_type) ? (quiz.source_type + ':' + quiz.source_id) : '';
  function fmtDeadline(s) {
    if (!s) return '';
    // value="" on a <input type="date">; just the date part.
    return String(s).slice(0, 10);
  }
%>

<div class="max-w-3xl mx-auto space-y-5">
  <div class="flex items-center gap-2 text-sm text-gray-500">
    <a href="/safety-quizzes" class="hover:text-brand-600">Safety Quizzes</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-900"><%= isEdit ? 'Edit' : 'New' %></span>
  </div>
  <h1 class="text-2xl font-bold text-gray-900"><%= isEdit ? 'Edit Quiz' : 'New Quiz' %></h1>

  <form method="POST" action="<%= formAction %>" class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-5">
    <%- include('../partials/csrf') %>

    <div>
      <label for="title" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Title <span class="text-rose-500">*</span></label>
      <input type="text" id="title" name="title" required value="<%= isEdit ? (quiz.title || '') : '' %>"
        placeholder="e.g. April safety knowledge check"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
    </div>

    <div>
      <label for="description" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Description / intro</label>
      <textarea id="description" name="description" rows="4" placeholder="What this quiz covers and why it matters."
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"><%= isEdit ? (quiz.description || '') : '' %></textarea>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label for="pass_mark" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Pass mark (%)</label>
        <input type="number" id="pass_mark" name="pass_mark" min="0" max="100" value="<%= isEdit ? (quiz.pass_mark || 80) : 80 %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
      </div>
      <div>
        <label for="retake_policy" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Retake policy</label>
        <select id="retake_policy" name="retake_policy" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
          <% const rp = isEdit ? quiz.retake_policy : 'unlimited'; %>
          <option value="unlimited" <%= rp === 'unlimited' ? 'selected' : '' %>>Unlimited</option>
          <option value="limited"   <%= rp === 'limited'   ? 'selected' : '' %>>Limited</option>
          <option value="none"      <%= rp === 'none'      ? 'selected' : '' %>>No retakes</option>
        </select>
      </div>
      <div>
        <label for="retake_limit" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Retake limit</label>
        <input type="number" id="retake_limit" name="retake_limit" min="1" value="<%= isEdit && quiz.retake_limit ? quiz.retake_limit : '' %>" placeholder="e.g. 3"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
        <p class="text-[10px] text-gray-400 mt-1">Only applies when policy = Limited.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="deadline_at" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Deadline (optional)</label>
        <input type="date" id="deadline_at" name="deadline_at" value="<%= isEdit ? fmtDeadline(quiz.deadline_at) : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
      </div>
      <div>
        <label for="source" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Linked source (optional)</label>
        <select id="source" name="source" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm">
          <option value="">— No link —</option>
          <% if (toolboxes && toolboxes.length) { %>
            <optgroup label="Toolbox talks">
              <% toolboxes.forEach(t => { %>
                <option value="toolbox:<%= t.id %>" <%= currentSourceValue === ('toolbox:' + t.id) ? 'selected' : '' %>><%= t.title %></option>
              <% }) %>
            </optgroup>
          <% } %>
          <% if (swmsList && swmsList.length) { %>
            <optgroup label="SWMS">
              <% swmsList.forEach(s => { %>
                <option value="swms:<%= s.id %>" <%= currentSourceValue === ('swms:' + s.id) ? 'selected' : '' %>><%= s.title %></option>
              <% }) %>
            </optgroup>
          <% } %>
          <% if (updates && updates.length) { %>
            <optgroup label="Safety updates">
              <% updates.forEach(u => { %>
                <option value="update:<%= u.id %>" <%= currentSourceValue === ('update:' + u.id) ? 'selected' : '' %>><%= u.title %></option>
              <% }) %>
            </optgroup>
          <% } %>
        </select>
        <p class="text-[10px] text-gray-400 mt-1">Linking to a toolbox auto-marks the worker as caught up when they pass.</p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <input type="checkbox" id="is_mandatory" name="is_mandatory" value="1" <%= isEdit && quiz.is_mandatory ? 'checked' : '' %> class="w-4 h-4 text-brand-600 border-gray-300 rounded focus:ring-brand-500">
      <label for="is_mandatory" class="text-sm text-gray-700">Mandatory (highlighted to workers)</label>
    </div>

    <div class="flex items-center justify-between gap-2 pt-3 border-t border-gray-100">
      <a href="/safety-quizzes<%= isEdit ? '/' + quiz.id : '' %>" class="text-sm text-gray-500 hover:text-gray-700">Cancel</a>
      <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg"><%= isEdit ? 'Save changes' : 'Continue to questions →' %></button>
    </div>
  </form>
</div>
