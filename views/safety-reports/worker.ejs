<% locals.currentPage = 'safety-reports' %>
<%
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  function fmtDate(s) {
    if (!s) return '—';
    return new Date(s).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
  }
  function pct(v) { return v == null ? '—' : v + '%'; }
  const CAT_LABELS = {
    hazard: 'Hazard', swms_issue: 'SWMS issue', suggestion: 'Suggestion',
    equipment: 'Equipment', general: 'General',
  };
%>

<div class="max-w-5xl mx-auto space-y-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <a href="/safety-reports?range=<%= rangeKey %>" class="text-sm text-brand-600 hover:underline">← Safety Reports</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1"><%= crew.full_name %></h1>
      <p class="text-sm text-gray-500 mt-0.5"><%= crew.employee_id || 'No employee ID' %> · range: <%= ranges[rangeKey].label %></p>
    </div>
    <form method="GET" class="flex items-center gap-2">
      <select name="range" onchange="this.form.submit()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
        <% Object.entries(ranges).forEach(([k, r]) => { %>
          <option value="<%= k %>" <%= rangeKey === k ? 'selected' : '' %>><%= r.label %></option>
        <% }) %>
      </select>
    </form>
  </div>

  <!-- Hero: composite + sub-rates -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Composite engagement score</p>
        <% if (!me || me.composite == null) { %>
          <p class="text-3xl font-bold text-gray-400 mt-1">—</p>
          <p class="text-xs text-gray-500 mt-1">Nothing measurable in this date range yet.</p>
        <% } else { %>
          <p class="text-4xl font-bold mt-1 <%= me.disengaged ? 'text-amber-700' : me.composite >= 80 ? 'text-emerald-700' : 'text-gray-900' %>"><%= me.composite %>%</p>
          <% if (me.disengaged) { %>
            <p class="text-xs text-amber-700 font-semibold mt-1">Below <%= disengagedThreshold %>% — supervisor follow-up recommended.</p>
          <% } %>
        <% } %>
      </div>
      <% if (me) { %>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
          <div>
            <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">SWMS</p>
            <p class="text-lg font-bold text-gray-900"><%= pct(me.swms.rate) %></p>
            <p class="text-[11px] text-gray-500"><%= me.swms.acked %>/<%= me.swms.total %></p>
          </div>
          <div>
            <p class="text-[10px] font-bold text-violet-500 uppercase tracking-widest">Quiz</p>
            <p class="text-lg font-bold text-gray-900"><%= pct(me.quizzes.rate) %></p>
            <p class="text-[11px] text-gray-500"><%= me.quizzes.passed %>/<%= me.quizzes.total %></p>
          </div>
          <div>
            <p class="text-[10px] font-bold text-blue-500 uppercase tracking-widest">Toolbox</p>
            <p class="text-lg font-bold text-gray-900"><%= pct(me.toolboxes.rate) %></p>
            <p class="text-[11px] text-gray-500"><%= me.toolboxes.covered %>/<%= me.toolboxes.total %></p>
          </div>
          <div>
            <p class="text-[10px] font-bold text-indigo-500 uppercase tracking-widest">Updates</p>
            <p class="text-lg font-bold text-gray-900"><%= pct(me.updates.rate) %></p>
            <p class="text-[11px] text-gray-500"><%= me.updates.read %>/<%= me.updates.total %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- SWMS -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-200 bg-emerald-50/40">
      <h3 class="text-sm font-bold text-emerald-900">SWMS acknowledgement</h3>
    </div>
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Title</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Status</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Acked at</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% swmsList.forEach(r => { %>
          <tr>
            <td class="px-3 py-2 text-sm"><a href="/swms/<%= r.id %>" class="text-gray-900 hover:text-brand-600"><%= r.title %></a></td>
            <td class="px-2 py-2 text-xs">
              <% if (r.acked_at) { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-emerald-50 text-emerald-700 ring-emerald-200">Acknowledged</span><% } else { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-rose-50 text-rose-700 ring-rose-200">Outstanding</span><% } %>
            </td>
            <td class="px-2 py-2 text-xs text-gray-500 tabular-nums"><%= fmt(r.acked_at) %></td>
          </tr>
        <% }) %>
        <% if (!swmsList.length) { %><tr><td colspan="3" class="px-3 py-4 text-center text-sm text-gray-500">No active SWMS.</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <!-- Quizzes -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-200 bg-violet-50/40">
      <h3 class="text-sm font-bold text-violet-900">Quizzes</h3>
    </div>
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Quiz</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Status</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Latest score</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% quizList.forEach(r => { %>
          <tr>
            <td class="px-3 py-2 text-sm"><a href="/safety-quizzes/<%= r.id %>" class="text-gray-900 hover:text-brand-600"><%= r.title %></a></td>
            <td class="px-2 py-2 text-xs">
              <% if (!r.latest_status) { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-gray-50 text-gray-600 ring-gray-200">Not started</span><% } else if (r.latest_status === 'in_progress') { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-amber-50 text-amber-700 ring-amber-200">In progress</span><% } else if (r.latest_passed) { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-emerald-50 text-emerald-700 ring-emerald-200">Passed</span><% } else { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-rose-50 text-rose-700 ring-rose-200">Failed</span><% } %>
            </td>
            <td class="px-2 py-2 text-xs text-gray-600"><%= r.latest_score == null ? '—' : r.latest_score + '%' %> <span class="text-gray-400">(pass <%= r.pass_mark %>%)</span></td>
          </tr>
        <% }) %>
        <% if (!quizList.length) { %><tr><td colspan="3" class="px-3 py-4 text-center text-sm text-gray-500">No quizzes in this range.</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <!-- Toolboxes -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-200 bg-blue-50/40">
      <h3 class="text-sm font-bold text-blue-900">Toolbox talks</h3>
    </div>
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Topic</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Held</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Status</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Recorded</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% tbList.forEach(r => { %>
          <tr>
            <td class="px-3 py-2 text-sm"><a href="/toolbox-talks/<%= r.id %>" class="text-gray-900 hover:text-brand-600"><%= r.title %></a></td>
            <td class="px-2 py-2 text-xs text-gray-500 tabular-nums"><%= fmtDate(r.held_at) %></td>
            <td class="px-2 py-2 text-xs">
              <% if (r.att_status === 'attended') { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-emerald-50 text-emerald-700 ring-emerald-200">Attended</span><% } else if (r.att_status === 'caught_up') { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-violet-50 text-violet-700 ring-violet-200">Caught up</span><% } else { %><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-amber-50 text-amber-700 ring-amber-200">Missed</span><% } %>
            </td>
            <td class="px-2 py-2 text-xs text-gray-500 tabular-nums"><%= fmt(r.att_at) %></td>
          </tr>
        <% }) %>
        <% if (!tbList.length) { %><tr><td colspan="4" class="px-3 py-4 text-center text-sm text-gray-500">No toolboxes in this range.</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <!-- Updates -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-200 bg-indigo-50/40">
      <h3 class="text-sm font-bold text-indigo-900">Safety updates</h3>
    </div>
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Title</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Published</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Read</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% updatesList.forEach(r => { %>
          <tr>
            <td class="px-3 py-2 text-sm"><a href="/safety-updates/<%= r.id %>" class="text-gray-900 hover:text-brand-600"><%= r.title %></a></td>
            <td class="px-2 py-2 text-xs text-gray-500 tabular-nums"><%= fmt(r.published_at) %></td>
            <td class="px-2 py-2 text-xs">
              <% if (r.read_at) { %><span class="text-emerald-700"><%= fmt(r.read_at) %></span><% } else { %><span class="text-rose-600">Unread</span><% } %>
            </td>
          </tr>
        <% }) %>
        <% if (!updatesList.length) { %><tr><td colspan="3" class="px-3 py-4 text-center text-sm text-gray-500">No updates in this range.</td></tr><% } %>
      </tbody>
    </table>
  </div>

  <!-- Comments (identified only) -->
  <% if (commentsList.length) { %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-3 border-b border-gray-200 bg-amber-50/40">
      <h3 class="text-sm font-bold text-amber-900">Comments &amp; flags submitted</h3>
      <p class="text-xs text-amber-700/70 mt-0.5">Anonymous submissions aren't shown here — only identified ones are tied to a worker for reporting.</p>
    </div>
    <ul class="divide-y divide-gray-100">
      <% commentsList.forEach(c => { %>
        <li class="px-5 py-3">
          <a href="/safety-comments/<%= c.id %>" class="text-sm text-gray-900 hover:text-brand-600">#<%= c.id %> · <%= CAT_LABELS[c.category] || c.category %></a>
          <p class="text-xs text-gray-500 mt-1 line-clamp-1"><%= c.body %></p>
          <p class="text-[11px] text-gray-400 mt-0.5"><%= c.status %> · <%= fmt(c.created_at) %></p>
        </li>
      <% }) %>
    </ul>
  </div>
  <% } %>
</div>
