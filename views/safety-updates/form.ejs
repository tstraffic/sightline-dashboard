<% locals.currentPage = 'safety-updates' %>
<%
  const formAction = isEdit ? '/safety-updates/' + update.id : '/safety-updates';
%>

<div class="max-w-3xl mx-auto space-y-5">
  <div class="flex items-center gap-2 text-sm text-gray-500">
    <a href="/safety-updates" class="hover:text-brand-600">Safety Updates</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-900"><%= isEdit ? 'Edit' : 'New' %></span>
  </div>
  <h1 class="text-2xl font-bold text-gray-900"><%= isEdit ? 'Edit Safety Update' : 'New Safety Update' %></h1>

  <form method="POST" action="<%= formAction %>" enctype="multipart/form-data" class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-5">
    <%- include('../partials/csrf') %>

    <div>
      <label for="title" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Title <span class="text-rose-500">*</span></label>
      <input type="text" id="title" name="title" required value="<%= isEdit ? (update.title || '') : '' %>"
        placeholder="e.g. New TfNSW high-vis requirements"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
    </div>

    <div>
      <label for="category" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Category</label>
      <select id="category" name="category" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <% categoryValues.forEach(c => { %>
          <option value="<%= c %>" <%= (isEdit && update.category === c) ? 'selected' : '' %>><%= categoryLabels[c] %></option>
        <% }) %>
      </select>
    </div>

    <div>
      <label for="body" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Body <span class="text-rose-500">*</span></label>
      <textarea id="body" name="body" rows="8" required placeholder="What does the crew need to know?"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"><%= isEdit ? (update.body || '') : '' %></textarea>
      <p class="text-xs text-gray-400 mt-1">Plain text. Line breaks are preserved on the worker side.</p>
    </div>

    <div>
      <label for="attachment" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Attachment (optional)</label>
      <% if (isEdit && update.attachment_path) { %>
        <p class="text-xs text-gray-600 mb-2">Currently attached: <a href="/safety-updates/<%= update.id %>/file" class="text-brand-600 hover:underline"><%= update.attachment_original_name %></a></p>
      <% } %>
      <input type="file" id="attachment" name="attachment" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.webp"
        class="block w-full text-sm text-gray-700 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
      <p class="text-xs text-gray-400 mt-1">PDF, image, or doc. Max 10 MB.</p>
    </div>

    <div class="flex items-center gap-2">
      <input type="checkbox" id="pinned" name="pinned" value="1" <%= isEdit && update.pinned ? 'checked' : '' %> class="w-4 h-4 text-brand-600 border-gray-300 rounded focus:ring-brand-500">
      <label for="pinned" class="text-sm text-gray-700">Pin to top of the worker feed</label>
    </div>

    <div class="flex items-center justify-between gap-2 pt-3 border-t border-gray-100">
      <a href="/safety-updates<%= isEdit ? '/' + update.id : '' %>" class="text-sm text-gray-500 hover:text-gray-700">Cancel</a>
      <div class="flex items-center gap-2">
        <% if (!isEdit) { %>
          <button type="submit" name="action" value="draft" class="px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Save draft</button>
          <button type="submit" name="action" value="publish" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Save & publish</button>
        <% } else { %>
          <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Save changes</button>
        <% } %>
      </div>
    </div>
  </form>
</div>
