<% locals.currentPage = 'safety-updates' %>
<%
  const STATUS_BADGE = {
    draft:     'bg-amber-50 text-amber-700 ring-amber-200',
    published: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
    archived:  'bg-gray-50 text-gray-600 ring-gray-200',
  };
  const CATEGORY_BADGE = {
    general:       'bg-blue-50 text-blue-700 ring-blue-200',
    alert:         'bg-rose-50 text-rose-700 ring-rose-200',
    reminder:      'bg-amber-50 text-amber-700 ring-amber-200',
    toolbox:       'bg-violet-50 text-violet-700 ring-violet-200',
    policy_change: 'bg-indigo-50 text-indigo-700 ring-indigo-200',
  };
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
%>

<div class="max-w-6xl mx-auto space-y-5">
  <%- include('../partials/page-header', { rail: true, wrapperClass: '',
    eyebrow: 'Safety',
    title: 'Safety Updates',
    subtitle: 'Bulletins, incident alerts and reminders. Published items push to every worker\'s portal.',
    actions: [{ label: 'New update', href: '/safety-updates/new', style: 'primary', icon: 'M12 6v12m6-6H6' }]
  }) %>

  <!-- Status tabs -->
  <div class="border-b border-gray-200 flex items-center gap-1">
    <% ['published','draft','archived'].forEach(s => { %>
      <a href="/safety-updates?status=<%= s %>" class="px-4 py-2 -mb-px border-b-2 text-sm font-semibold <%= status === s ? 'border-brand-600 text-brand-700' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
        <%= statusLabels[s] %>
        <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full <%= status === s ? 'bg-brand-50 text-brand-700' : 'bg-gray-100 text-gray-500' %>"><%= counts[s] || 0 %></span>
      </a>
    <% }) %>
  </div>

  <% if (!rows.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm px-5 py-10 text-center text-sm text-gray-500">
      No <%= statusLabels[status].toLowerCase() %> safety updates.
    </div>
  <% } else { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Title</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Category</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Published</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">By</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Pinned</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% rows.forEach(r => { %>
            <tr class="hover:bg-gray-50/50">
              <td class="px-3 py-2">
                <a href="/safety-updates/<%= r.id %>" class="font-semibold text-gray-900 hover:text-brand-600"><%= r.title %></a>
              </td>
              <td class="px-2 py-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= CATEGORY_BADGE[r.category] %>"><%= categoryLabels[r.category] %></span>
              </td>
              <td class="px-2 py-2 text-xs text-gray-600 tabular-nums"><%= r.published_at ? fmt(r.published_at) : '—' %></td>
              <td class="px-2 py-2 text-xs text-gray-600"><%= r.published_by_name || r.created_by_name || '—' %></td>
              <td class="px-2 py-2 text-xs">
                <% if (r.pinned) { %><span class="text-amber-600">📌</span><% } else { %><span class="text-gray-300">—</span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
