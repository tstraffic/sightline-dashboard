<% locals.currentPage = 'safety-updates' %>
<%
  const STATUS_BADGE = {
    draft:     'bg-amber-50 text-amber-700 ring-amber-200',
    published: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
    archived:  'bg-gray-50 text-gray-600 ring-gray-200',
  };
  const CATEGORY_BADGE = {
    general:       'bg-blue-50 text-blue-700 ring-blue-200',
    alert:         'bg-rose-50 text-rose-700 ring-rose-200',
    reminder:      'bg-amber-50 text-amber-700 ring-amber-200',
    toolbox:       'bg-violet-50 text-violet-700 ring-violet-200',
    policy_change: 'bg-indigo-50 text-indigo-700 ring-indigo-200',
  };
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  const total = stats.total_crew || 0;
  const read  = stats.read_count || 0;
  const pct   = total > 0 ? Math.round((read / total) * 100) : 0;
%>

<div class="max-w-4xl mx-auto space-y-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <a href="/safety-updates" class="text-sm text-brand-600 hover:underline">← Safety Updates</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1 flex items-center gap-2 flex-wrap">
        <%= update.title %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= CATEGORY_BADGE[update.category] %>"><%= categoryLabels[update.category] %></span>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= STATUS_BADGE[update.status] %>"><%= statusLabels[update.status] %></span>
        <% if (update.pinned) { %><span class="inline-flex items-center text-amber-600 text-sm">📌 Pinned</span><% } %>
      </h1>
    </div>
    <div class="flex items-center gap-2">
      <a href="/safety-updates/<%= update.id %>/edit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Edit</a>
      <% if (update.status === 'draft') { %>
        <form method="POST" action="/safety-updates/<%= update.id %>/publish" class="inline">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-3 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Publish</button>
        </form>
      <% } %>
      <% if (update.status !== 'archived') { %>
        <form method="POST" action="/safety-updates/<%= update.id %>/archive" class="inline" onsubmit="return confirm('Archive this update? It will disappear from the worker feed.')">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Archive</button>
        </form>
      <% } %>
      <form method="POST" action="/safety-updates/<%= update.id %>/delete" class="inline" onsubmit="return confirm('Delete this update? This cannot be undone.')">
        <%- include('../partials/csrf') %>
        <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-red-50 hover:border-red-300 hover:text-red-600 text-gray-700 text-sm font-semibold rounded-lg">Delete</button>
      </form>
    </div>
  </div>

  <!-- Read stats -->
  <% if (update.status === 'published') { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Read by workers</p>
      <p class="text-2xl font-bold text-gray-900"><%= read %> <span class="text-gray-400 font-normal text-base">of <%= total %> · <%= pct %>%</span></p>
      <div class="w-full h-2 bg-gray-100 rounded-full mt-2">
        <div class="h-2 bg-emerald-500 rounded-full" style="width: <%= pct %>%"></div>
      </div>
    </div>
  <% } %>

  <!-- Body -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-4">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Published</p>
        <p class="text-sm text-gray-700 mt-0.5"><%= fmt(update.published_at) %></p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">By</p>
        <p class="text-sm text-gray-700 mt-0.5"><%= update.published_by_name || update.created_by_name || '—' %></p>
      </div>
      <div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Created</p>
        <p class="text-sm text-gray-700 mt-0.5"><%= fmt(update.created_at) %></p>
      </div>
    </div>

    <div class="pt-3 border-t border-gray-100">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Body</p>
      <p class="text-sm text-gray-800 whitespace-pre-line leading-relaxed"><%= update.body %></p>
    </div>

    <% if (update.attachment_path) { %>
      <div class="pt-3 border-t border-gray-100">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Attachment</p>
        <a href="/safety-updates/<%= update.id %>/file" class="inline-flex items-center gap-2 px-3 py-2 bg-brand-50 hover:bg-brand-100 text-brand-700 text-sm font-semibold rounded-lg ring-1 ring-brand-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m-7 7h8a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v13a2 2 0 002 2z"/></svg>
          <%= update.attachment_original_name %>
        </a>
      </div>
    <% } %>
  </div>

  <% if (update.status === 'published' && readers.length) { %>
    <details class="bg-white border border-gray-200 rounded-xl shadow-sm">
      <summary class="px-5 py-3 cursor-pointer text-sm font-semibold text-gray-700">Workers who have read this (<%= readers.length %>)</summary>
      <table class="min-w-full text-sm border-t border-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Worker</th>
            <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Employee ID</th>
            <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Read at</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% readers.forEach(r => { %>
            <tr><td class="px-3 py-2 text-xs"><%= r.full_name %></td><td class="px-3 py-2 text-xs text-gray-500"><%= r.employee_id || '—' %></td><td class="px-3 py-2 text-xs text-gray-500"><%= fmt(r.read_at) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </details>
  <% } %>
</div>
