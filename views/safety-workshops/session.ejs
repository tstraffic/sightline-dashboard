<% locals.currentPage = 'safety-workshops' %>
<%
  function fmtTime(s) {
    if (!s) return '';
    return new Date(s).toLocaleTimeString('en-AU', {
      timeZone: 'Australia/Sydney', hour: 'numeric', minute: '2-digit',
    });
  }
%>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<div class="max-w-6xl mx-auto space-y-5">
  <a href="/safety-workshops/<%= session.workshop_slug %>" class="inline-flex items-center gap-1 text-xs text-gray-500 hover:text-gray-700">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to <%= session.workshop_title %>
  </a>

  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <p class="text-[10px] font-bold tracking-widest text-gray-400 uppercase">Live session · <%= session.workshop_title %></p>
      <h1 class="text-3xl font-bold text-gray-900 mt-1 font-mono tracking-wide"><%= session.session_code %></h1>
      <p class="text-sm text-gray-500 mt-1">
        Facilitator: <%= session.facilitator_name || '—' %> · Started <%= fmtTime(session.created_at) %>
      </p>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <% if (session.status === 'open') { %>
        <%# Restart — same QR code, fresh scoreboard. The dominant action. %>
        <form method="POST" action="/safety-workshops/sessions/<%= session.session_code %>/restart" onsubmit="return confirm('Restart this session? All scores and case assignments will be cleared. The QR code stays the same — tell the room to refresh their phones.');">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="px-3 py-2 bg-white border border-amber-200 hover:bg-amber-50 text-amber-700 text-sm font-medium rounded-lg inline-flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Restart round
          </button>
        </form>
        <%# Close — preserves scores, blocks new submissions. %>
        <form method="POST" action="/safety-workshops/sessions/<%= session.session_code %>/close" onsubmit="return confirm('Close this session? Scores stay on the leaderboard but no one can join or submit after this.');">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="px-3 py-2 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg">
            Close session
          </button>
        </form>
      <% } else { %>
        <span class="text-[10px] font-bold tracking-widest text-gray-500 bg-gray-100 border border-gray-200 px-3 py-1 rounded-full uppercase">Closed</span>
        <%# Reopen-by-restart: if the facilitator wants to run another round %>
        <%# on a closed session, restart wipes scores AND flips status to open. %>
        <form method="POST" action="/safety-workshops/sessions/<%= session.session_code %>/restart" onsubmit="return confirm('Reopen this session and clear all scores? The QR code stays the same.');">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="px-3 py-2 bg-white border border-amber-200 hover:bg-amber-50 text-amber-700 text-sm font-medium rounded-lg inline-flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            Reopen & restart
          </button>
        </form>
      <% } %>
      <%# Delete — destructive, both open and closed sessions. %>
      <form method="POST" action="/safety-workshops/sessions/<%= session.session_code %>/delete" onsubmit="return confirm('Delete session <%= session.session_code %> and all its scores? This cannot be undone.');">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button type="submit" class="px-3 py-2 bg-white border border-rose-200 hover:bg-rose-50 text-rose-700 text-sm font-medium rounded-lg inline-flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"/></svg>
          Delete
        </button>
      </form>
    </div>
  </div>

  <div class="grid md:grid-cols-5 gap-5">
    <!-- LEFT: QR + URL + case assignments -->
    <div class="md:col-span-2 space-y-4">
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
        <p class="text-[10px] font-bold tracking-widest text-gray-500 uppercase mb-3">Scan to join</p>
        <div id="qrBox" class="bg-white border border-gray-200 rounded-lg p-3 flex items-center justify-center min-h-[220px]"></div>
        <div class="mt-3 bg-gray-50 border border-gray-200 rounded-lg p-2.5 text-xs font-mono text-gray-700 break-all"><%= participantUrl %></div>
        <p class="text-xs text-gray-500 mt-3">Project this screen in the workshop room. Office staff scan with their phone.</p>
      </div>

      <% if (session.mode === 'group') { %>
        <%# Group mode: assignments are pre-created teams (one per case).
            Show each team's roster + claim status. %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
            <p class="text-[10px] font-bold tracking-widest text-gray-500 uppercase">Teams</p>
            <span id="assignedCount" class="text-xs font-semibold text-gray-500 tabular-nums"><%= assignments.filter(a => a.claimed_by_name).length %>/<%= assignments.length %> claimed</span>
          </div>
          <ul id="assignList" class="divide-y divide-gray-100">
            <% assignments.forEach(a => {
              // claimed_by_name falls back to the group name when the
              // participant tapped without giving theirs — show the
              // generic Claimed pill in that case, otherwise show who
              // picked it up so the office can see who's running each team.
              const claimer = a.claimed_by_name && a.claimed_by_name !== a.player_name ? a.claimed_by_name : null;
            %>
              <li class="px-4 py-3">
                <div class="flex items-center gap-2 mb-1">
                  <span class="w-6 h-6 rounded-md bg-brand-600 text-white text-[11px] font-bold flex items-center justify-center shrink-0"><%= a.case_letter %></span>
                  <span class="text-sm font-bold text-gray-900"><%= a.player_name %></span>
                  <% if (a.claimed_by_name) { %>
                    <span class="ml-auto text-right text-[11px] leading-tight">
                      <span class="block font-semibold text-emerald-700">
                        <%= claimer ? 'Picked by ' + claimer : 'Claimed' %>
                      </span>
                    </span>
                  <% } else { %>
                    <span class="ml-auto text-[10px] text-gray-400 uppercase tracking-widest">Open</span>
                  <% } %>
                </div>
                <p class="text-xs text-gray-500 break-words"><%= a.members_csv || '—' %></p>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } else { %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
            <p class="text-[10px] font-bold tracking-widest text-gray-500 uppercase">Case assignments</p>
            <span id="assignedCount" class="text-xs font-semibold text-gray-500 tabular-nums"><%= assignments.length %> joined</span>
          </div>
          <ul id="assignList" class="divide-y divide-gray-100">
            <% cases.forEach(c => {
              const who = assignments.find(a => a.case_letter === c.letter);
            %>
              <li class="px-4 py-2.5 flex items-center gap-3">
                <span class="w-6 h-6 rounded-md bg-brand-600 text-white text-[11px] font-bold flex items-center justify-center shrink-0"><%= c.letter %></span>
                <span class="text-xs text-gray-600 flex-1 min-w-0 truncate"><%= c.title %></span>
                <% if (who) { %>
                  <span class="text-xs font-semibold text-emerald-700 truncate"><%= who.player_name %></span>
                <% } else { %>
                  <span class="text-[10px] text-gray-400 uppercase tracking-widest">Free</span>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <% if (session.mode === 'group') { %>
        <p class="text-[11px] text-gray-500 px-1">
          Restart keeps the teams — only the scoreboard and claim status get cleared.
        </p>
      <% } %>

      <!-- Manual add — for workers without phones, late arrivals, or
           anyone whose phone wouldn't scan the QR. Score is optional;
           if blank the player just appears under Case assignments
           (no leaderboard row until they submit).
           Group mode skips this: teams are fixed at session creation. -->
      <% if (session.status === 'open' && session.mode !== 'group') { %>
        <details class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
          <summary class="px-4 py-3 cursor-pointer select-none flex items-center justify-between gap-2 hover:bg-gray-50">
            <span class="text-[10px] font-bold tracking-widest text-gray-500 uppercase">Add participant manually</span>
            <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <form method="POST" action="/safety-workshops/sessions/<%= session.session_code %>/add-participant" class="p-4 space-y-3 border-t border-gray-100">
            <%- include('../partials/csrf') %>
            <div>
              <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Name</label>
              <input type="text" name="name" required minlength="2" maxlength="60" placeholder="e.g. Taj Rahman"
                class="block w-full text-sm border-gray-300 rounded focus:border-brand-500 focus:ring-brand-500">
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Case</label>
                <select name="case_letter" required class="block w-full text-sm border-gray-300 rounded focus:border-brand-500 focus:ring-brand-500">
                  <option value="">Pick…</option>
                  <% cases.forEach(c => { %>
                    <option value="<%= c.letter %>">Case <%= c.letter %> · <%= c.title %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label class="block text-[10px] font-bold text-gray-500 uppercase tracking-wider mb-1">Score <span class="text-gray-400 font-normal">(optional)</span></label>
                <input type="number" name="score" min="0" step="1" placeholder="e.g. 145"
                  class="block w-full text-sm border-gray-300 rounded focus:border-brand-500 focus:ring-brand-500">
                <% if (attempts && attempts.length) { %>
                  <p class="text-[10px] text-gray-400 mt-0.5">Max: <%= attempts[0].max_score %></p>
                <% } %>
              </div>
            </div>
            <p class="text-[11px] text-gray-500">Leave score blank if they haven't completed the case yet — they'll show up under <em>Case assignments</em> only. Fill in a score to place them on the leaderboard immediately.</p>
            <label class="flex items-start gap-2 text-[11px] text-gray-700 cursor-pointer select-none">
              <input type="checkbox" name="override" value="1" class="mt-0.5 rounded border-gray-300 text-brand-600 focus:ring-brand-500">
              <span><strong>Override existing entry</strong> — replace the assignment + leaderboard row for this name. Use when a worker accidentally refreshed mid-quiz and lost their answers.</span>
            </label>
            <div class="flex items-center justify-end">
              <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white bg-brand-600 hover:bg-brand-500 rounded">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                Add / Override
              </button>
            </div>
          </form>
        </details>
      <% } %>
    </div>

    <!-- RIGHT: leaderboard -->
    <div class="md:col-span-3">
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
          <p class="text-[10px] font-bold tracking-widest text-gray-500 uppercase">Leaderboard</p>
          <span class="text-xs text-gray-400">Auto-refreshing</span>
        </div>
        <div id="leaderboard">
          <% if (!attempts.length) { %>
            <p class="px-5 py-10 text-center text-sm text-gray-500">Waiting on first submission…</p>
          <% } else { %>
            <ol class="divide-y divide-gray-100">
              <% attempts.forEach((a, i) => {
                const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : (i + 1) + '.';
                const pct = a.max_score ? Math.round((a.score / a.max_score) * 100) : 0;
                const tone = pct >= 80 ? 'text-emerald-700' : pct >= 50 ? 'text-amber-700' : 'text-gray-500';
                const debriefHref = a.id ? ('/safety-workshops/sessions/' + session.session_code + '/debrief/' + a.id) : null;
              %>
                <li>
                  <% if (debriefHref) { %>
                    <a href="<%= debriefHref %>" class="px-4 py-2.5 flex items-center gap-3 hover:bg-gray-50 transition group">
                  <% } else { %>
                    <div class="px-4 py-2.5 flex items-center gap-3">
                  <% } %>
                    <span class="w-7 text-center text-sm font-bold text-gray-700"><%= medal %></span>
                    <span class="font-semibold text-gray-900 flex-1 min-w-0 truncate"><%= a.player_name %></span>
                    <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Case <%= a.case_letter %></span>
                    <span class="font-mono font-bold tabular-nums <%= tone %>"><%= a.score %><span class="text-gray-400 font-normal">/<%= a.max_score %></span></span>
                    <% if (debriefHref) { %>
                      <span class="text-[10px] font-bold text-brand-700 uppercase tracking-widest opacity-0 group-hover:opacity-100 transition">Debrief →</span>
                    <% } %>
                  <% if (debriefHref) { %>
                    </a>
                  <% } else { %>
                    </div>
                  <% } %>
                </li>
              <% }) %>
            </ol>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var participantUrl = <%- JSON.stringify(participantUrl) %>;
  var sessionCode = <%- JSON.stringify(session.session_code) %>;
  var sessionStatus = <%- JSON.stringify(session.status) %>;
  var sessionMode = <%- JSON.stringify(session.mode || 'individual') %>;
  var caseTitles = <%- JSON.stringify(cases) %>;

  // ── Render QR code (qrcodejs from CDN) ──
  if (window.QRCode) {
    try {
      new QRCode(document.getElementById('qrBox'), {
        text: participantUrl, width: 220, height: 220,
        colorDark: '#111827', colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.M,
      });
    } catch (e) {
      document.getElementById('qrBox').textContent = 'QR render failed — use the URL below.';
    }
  } else {
    document.getElementById('qrBox').textContent = 'QR library failed to load — use the URL below.';
  }

  // ── Auto-refresh participants + leaderboard every 4s ──
  if (sessionStatus !== 'open') return; // closed sessions don't poll
  var pollUrl = '/safety-workshops/sessions/' + encodeURIComponent(sessionCode) + '/live';
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (m) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
    });
  }
  function renderAssignments(assignments) {
    var countEl = document.getElementById('assignedCount');
    var listEl = document.getElementById('assignList');
    if (!countEl || !listEl) return;
    if (sessionMode === 'group') {
      var claimed = assignments.filter(function (a) { return a.claimed_by_name; }).length;
      countEl.textContent = claimed + '/' + assignments.length + ' claimed';
      var html = assignments.map(function (a) {
        var claimer = a.claimed_by_name && a.claimed_by_name !== a.player_name ? a.claimed_by_name : null;
        var claimHtml;
        if (a.claimed_by_name) {
          claimHtml = '<span class="ml-auto text-right text-[11px] leading-tight">' +
            '<span class="block font-semibold text-emerald-700">' +
              (claimer ? 'Picked by ' + escapeHtml(claimer) : 'Claimed') +
            '</span></span>';
        } else {
          claimHtml = '<span class="ml-auto text-[10px] text-gray-400 uppercase tracking-widest">Open</span>';
        }
        return '<li class="px-4 py-3">' +
          '<div class="flex items-center gap-2 mb-1">' +
            '<span class="w-6 h-6 rounded-md bg-brand-600 text-white text-[11px] font-bold flex items-center justify-center shrink-0">' + a.case_letter + '</span>' +
            '<span class="text-sm font-bold text-gray-900">' + escapeHtml(a.player_name) + '</span>' +
            claimHtml +
          '</div>' +
          '<p class="text-xs text-gray-500 break-words">' + escapeHtml(a.members_csv || '—') + '</p>' +
        '</li>';
      }).join('');
      listEl.innerHTML = html;
      return;
    }
    countEl.textContent = assignments.length + ' joined';
    var byCase = {};
    assignments.forEach(function (a) { byCase[a.case_letter] = a; });
    var html = caseTitles.map(function (c) {
      var who = byCase[c.letter];
      return '<li class="px-4 py-2.5 flex items-center gap-3">' +
        '<span class="w-6 h-6 rounded-md bg-brand-600 text-white text-[11px] font-bold flex items-center justify-center shrink-0">' + c.letter + '</span>' +
        '<span class="text-xs text-gray-600 flex-1 min-w-0 truncate">' + escapeHtml(c.title) + '</span>' +
        (who
          ? '<span class="text-xs font-semibold text-emerald-700 truncate">' + escapeHtml(who.player_name) + '</span>'
          : '<span class="text-[10px] text-gray-400 uppercase tracking-widest">Free</span>') +
        '</li>';
    }).join('');
    listEl.innerHTML = html;
  }
  function renderLeaderboard(attempts) {
    var box = document.getElementById('leaderboard');
    if (!attempts.length) {
      box.innerHTML = '<p class="px-5 py-10 text-center text-sm text-gray-500">Waiting on first submission…</p>';
      return;
    }
    var medals = ['🥇', '🥈', '🥉'];
    var html = '<ol class="divide-y divide-gray-100">' + attempts.map(function (a, i) {
      var medal = i < 3 ? medals[i] : (i + 1) + '.';
      var pct = a.max_score ? Math.round((a.score / a.max_score) * 100) : 0;
      var tone = pct >= 80 ? 'text-emerald-700' : pct >= 50 ? 'text-amber-700' : 'text-gray-500';
      var debriefHref = a.id ? '/safety-workshops/sessions/' + encodeURIComponent(sessionCode) + '/debrief/' + a.id : null;
      var open  = debriefHref ? '<a href="' + debriefHref + '" class="px-4 py-2.5 flex items-center gap-3 hover:bg-gray-50 transition group">' : '<div class="px-4 py-2.5 flex items-center gap-3">';
      var close = debriefHref ? '</a>' : '</div>';
      var trailing = debriefHref ? '<span class="text-[10px] font-bold text-brand-700 uppercase tracking-widest opacity-0 group-hover:opacity-100 transition">Debrief →</span>' : '';
      return '<li>' + open +
        '<span class="w-7 text-center text-sm font-bold text-gray-700">' + medal + '</span>' +
        '<span class="font-semibold text-gray-900 flex-1 min-w-0 truncate">' + escapeHtml(a.player_name) + '</span>' +
        '<span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Case ' + a.case_letter + '</span>' +
        '<span class="font-mono font-bold tabular-nums ' + tone + '">' + a.score + '<span class="text-gray-400 font-normal">/' + a.max_score + '</span></span>' +
        trailing +
        close + '</li>';
    }).join('') + '</ol>';
    box.innerHTML = html;
  }
  function poll() {
    fetch(pollUrl, { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (j) {
        if (!j) return;
        renderAssignments(j.assignments || []);
        renderLeaderboard(j.attempts || []);
        if (j.status !== 'open') location.reload(); // session was closed elsewhere
      })
      .catch(function () { /* swallow transient network errors */ });
  }
  setInterval(poll, 4000);
})();
</script>
