<% locals.currentPage = 'safety-workshops' %>

<div class="max-w-md mx-auto pt-8 pb-12">
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
    <div class="text-center mb-5">
      <div class="w-12 h-12 mx-auto rounded-full bg-amber-50 border border-amber-200 flex items-center justify-center mb-3">
        <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <p class="text-[10px] font-bold tracking-widest text-gray-400 uppercase">Workshops</p>
      <h1 class="text-xl font-bold text-gray-900 mt-1">Module locked</h1>
      <p class="text-sm text-gray-500 mt-2 max-w-xs mx-auto">
        Workshops is in soft launch — enter the shared password to access it. Ask the workshops owner if you don't have it.
      </p>
    </div>

    <form method="POST" action="/safety-workshops/unlock" class="space-y-3">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <label class="block">
        <span class="sr-only">Password</span>
        <input
          type="password"
          name="password"
          autocomplete="off"
          autofocus
          required
          placeholder="Password"
          class="block w-full px-3 py-2.5 border border-gray-300 rounded-lg shadow-sm focus:ring-1 focus:ring-brand-500 focus:border-brand-500 text-sm"
        >
      </label>
      <button type="submit" class="w-full px-3 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">
        Unlock
      </button>
    </form>

    <p class="text-[11px] text-gray-400 text-center mt-4 leading-relaxed">
      Once unlocked, access lasts for the rest of your browser session.<br>
      Sign out and back in to re-lock.
    </p>
  </div>
</div>
