<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>SOP / SWMS Acknowledgement — T&S Traffic Control</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>tailwindcss.config={theme:{extend:{colors:{brand:{50:'#EBF3FF',100:'#D6E7FF',200:'#ADC9FF',300:'#85ABFF',400:'#5C8DFF',500:'#2B7FFF',600:'#1D6AE5',700:'#1554CC',800:'#0D3FB2',900:'#052A99',950:'#001A66'}}}}}</script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; -webkit-tap-highlight-color: transparent; }
    canvas { touch-action: none; }
    #sig-canvas { touch-action: none; }
    .ack-text { white-space: pre-wrap; }
    .step-panel { display: none; }
    .step-panel.active { display: block; animation: fadeIn 0.3s ease forwards; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    /* Stepper scroll-snap on mobile so all circles stay reachable when there are many sections */
    .stepper { scrollbar-width: none; -ms-overflow-style: none; }
    .stepper::-webkit-scrollbar { display: none; }
    .desc-html p { margin-bottom: 0.75rem; }
    .desc-html ul { list-style: disc; padding-left: 1.25rem; margin-bottom: 0.75rem; }
    .desc-html ol { list-style: decimal; padding-left: 1.25rem; margin-bottom: 0.75rem; }
    .desc-html strong { font-weight: 700; color: #111827; }
    .desc-html a { color: #1D6AE5; text-decoration: underline; }
    .desc-html h3 { font-weight: 700; color: #111827; margin: 0.75rem 0 0.4rem; font-size: 1rem; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">

<% if (submitted) { %>
  <!-- Success screen -->
  <div class="min-h-screen flex flex-col items-center justify-center p-6 text-center">
    <div class="w-20 h-20 rounded-full bg-emerald-500 flex items-center justify-center mb-6 shadow-lg">
      <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
    </div>
    <% if (typeof alreadyDone !== 'undefined' && alreadyDone) { %>
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Already done</h1>
      <p class="text-gray-600 mb-1"><%= signedName %>, you've already signed the current SOP version.</p>
    <% } else { %>
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Signed!</h1>
      <p class="text-gray-600 mb-1">Thanks <%= signedName %> — your SOP acknowledgement is recorded.</p>
    <% } %>
    <p class="text-sm text-gray-400">SOP version <%= sopVersion %></p>
    <p class="text-xs text-gray-400 mt-8 max-w-xs">You can close this tab. Your sign-off is now on file.</p>
  </div>
<% } else { %>

  <%
    const isPreview = (typeof previewMode !== 'undefined' && previewMode);
    const isTargetBound = (typeof targetCrew !== 'undefined' && targetCrew);
    // In preview mode admins skip the worker-pick step. Same when a session is
    // bound to a specific person via email link (targetCrew set).
    const skipWelcome = isPreview || isTargetBound;

    const sections = (typeof documents !== 'undefined' && documents) ? documents : [];

    // URL helpers — preview mode hits the admin-authed endpoint so the doc
    // actually loads. Real sessions go through the public token-gated route.
    function docUrl(secId) {
      return isPreview
        ? `/induction/admin/sop-documents/${secId}/file`
        : `/sop-sign/${session.token}/document/${secId}`;
    }
    function pageUrl(secId, pageFile) {
      // Page images aren't served by the admin endpoint, but server-side
      // page renders only fire in normal flow anyway; preview will fall back
      // to client-side PDF.js using the admin doc URL.
      return `/sop-sign/${session.token}/document/${secId}/page/${encodeURIComponent(pageFile)}`;
    }

    // Build step list. Step 1 (Welcome / Pick yourself) is conditional.
    const steps = [];
    if (!skipWelcome) steps.push({ kind: 'welcome', label: 'You' });
    sections.forEach((sec, i) => steps.push({ kind: 'section', section: sec, sectionIndex: i, label: sec.title }));
    steps.push({ kind: 'signature', label: 'Sign' });
    const totalSteps = steps.length;
  %>

  <% if (isPreview) { %>
    <div class="bg-amber-500 text-white text-center text-[11px] font-bold uppercase tracking-widest py-1.5 px-3">
      Preview · Nothing saved · <a href="/induction/admin/sop-documents" class="underline">Back to admin</a>
    </div>
  <% } %>

  <% if (isTargetBound) { %>
    <div class="bg-brand-50 border-b border-brand-100 px-5 py-2 text-center">
      <p class="text-[10px] font-bold text-brand-700 uppercase tracking-widest">Signing as</p>
      <p class="text-sm font-bold text-gray-900"><%= targetCrew.full_name %><% if (targetCrew.employee_id) { %> · <%= targetCrew.employee_id %><% } %></p>
    </div>
  <% } %>

  <!-- Header -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
    <div class="max-w-2xl mx-auto px-4 py-3 flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-brand-600 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">T&S</div>
      <div class="flex-1 min-w-0">
        <h1 class="text-sm font-bold text-gray-900 leading-tight">SOP / SWMS Acknowledgement</h1>
        <p class="text-[11px] text-gray-500 truncate"><%= session.title || 'In-person sign-off' %></p>
      </div>
      <div class="text-[11px] font-semibold text-gray-500 tabular-nums whitespace-nowrap">
        <span id="step-counter">1</span> / <%= totalSteps %>
      </div>
    </div>

    <!-- Progress Stepper (circles + labels) -->
    <div class="max-w-2xl mx-auto px-3 pb-3">
      <div id="stepper" class="stepper flex items-center overflow-x-auto">
        <% steps.forEach((step, idx) => { %>
          <div class="flex flex-col items-center step-indicator flex-shrink-0" style="min-width: 56px;" data-step="<%= idx %>">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-all duration-300
              <%= idx === 0 ? 'bg-brand-500 text-white border-brand-500' : 'bg-white text-gray-400 border-gray-300' %>"
              id="stepCircle<%= idx %>">
              <span id="stepNum<%= idx %>"><%= idx + 1 %></span>
              <svg id="stepCheck<%= idx %>" class="hidden w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <span class="text-[9px] mt-1 text-center leading-tight font-medium text-gray-400 max-w-[64px] truncate px-1" id="stepLabel<%= idx %>" title="<%= step.label %>"><%= step.label %></span>
          </div>
          <% if (idx < steps.length - 1) { %>
            <div class="flex-1 h-0.5 bg-gray-200 mx-0.5 mt-[-14px] min-w-[16px] transition-all duration-300" id="stepLine<%= idx %>"></div>
          <% } %>
        <% }) %>
      </div>
    </div>
  </header>

  <form id="signForm" method="POST" action="/sop-sign/<%= session.token %>/submit" class="max-w-2xl mx-auto px-4 py-5 pb-32">

    <% steps.forEach((step, idx) => { %>
      <div class="step-panel <%= idx === 0 ? 'active' : '' %>" data-step="<%= idx %>" data-kind="<%= step.kind %>">

        <% if (step.kind === 'welcome') { %>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-1">Who are you?</h2>
            <p class="text-gray-600 text-sm mb-5">Pick your name from the list so we can record your sign-off against your profile. You'll go through <strong><%= sections.length %></strong> section<%= sections.length === 1 ? '' : 's' %> after this, then sign.</p>

            <div class="space-y-4">
              <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Pick your name</label>
                <select id="crew-picker" name="crew_member_id" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent">
                  <option value="">— Select —</option>
                  <% attendees.forEach(a => { %>
                    <option value="<%= a.id %>" <%= a.alreadySigned ? 'disabled' : '' %>>
                      <%= a.full_name %><% if (a.employee_id) { %> · <%= a.employee_id %><% } %><% if (a.alreadySigned) { %>  (already signed)<% } %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <details class="text-sm">
                <summary class="text-brand-600 font-medium cursor-pointer">My name isn't on the list</summary>
                <div class="mt-3 space-y-3">
                  <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Full name</label>
                    <input type="text" name="full_name" id="manual-name" autocomplete="name" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="Type your full name" />
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Email (optional)</label>
                    <input type="email" name="email" autocomplete="email" class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm focus:ring-2 focus:ring-brand-500 focus:border-transparent" placeholder="you@example.com" />
                  </div>
                </div>
              </details>
            </div>

            <p id="welcome-error" class="hidden mt-3 text-red-500 text-xs font-medium">Please pick your name (or type it under "My name isn't on the list").</p>
          </div>
        <% } %>

        <% if (step.kind === 'section') { %>
          <% const sec = step.section; %>
          <% const isPdf = (sec.mime_type || '').includes('pdf') || /\.pdf$/i.test(sec.original_name || ''); %>
          <% const hasPageRenders = Array.isArray(sec.pageRenders) && sec.pageRenders.length > 0; %>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <p class="text-[10px] font-bold text-brand-600 uppercase tracking-widest mb-1">Section <%= step.sectionIndex + 1 %> of <%= sections.length %></p>
            <h2 class="text-xl font-bold text-gray-900 leading-tight mb-1"><%= sec.title %></h2>
            <% if (sec.original_name) { %>
              <p class="text-[11px] text-gray-500 mb-4"><%= sec.original_name %></p>
            <% } %>

            <% if (sec.description) { %>
              <div class="desc-html text-sm text-gray-700 leading-relaxed mb-5"><%- sec.description %></div>
            <% } %>

            <% if (isPdf && hasPageRenders && !isPreview) { %>
              <!-- Server-side rendered page images (preferred when available). -->
              <div class="space-y-3">
                <% sec.pageRenders.forEach((pageFile, pIdx) => { %>
                  <img src="<%= pageUrl(sec.id, pageFile) %>"
                       alt="Page <%= pIdx + 1 %>"
                       loading="<%= pIdx === 0 ? 'eager' : 'lazy' %>"
                       class="block w-full rounded-xl border border-gray-200 shadow-sm bg-white" />
                <% }) %>
              </div>
              <p class="mt-3 text-xs text-gray-500 text-center">
                <a href="<%= docUrl(sec.id) %>" target="_blank" rel="noopener" class="text-brand-600 hover:underline font-medium">Open as PDF</a>
              </p>
            <% } else if (isPdf) { %>
              <!-- Client-side PDF.js renders ALL pages, regardless of whether
                   server-side rendering succeeded. Avoids the iOS Safari
                   "iframe shows page 1 only" issue. -->
              <div class="pdf-render-target space-y-3"
                   data-pdf-url="<%= docUrl(sec.id) %>"
                   data-doc-id="<%= sec.id %>">
                <div class="pdf-loading text-center text-xs text-gray-500 py-8">Loading PDF…</div>
              </div>
              <p class="mt-3 text-xs text-gray-500 text-center">
                <a href="<%= docUrl(sec.id) %>" target="_blank" rel="noopener" class="text-brand-600 hover:underline font-medium">Open as PDF</a>
              </p>
            <% } else if (sec.id) { %>
              <!-- Non-PDF (image/doc/xls) — just link out. -->
              <a href="<%= docUrl(sec.id) %>" target="_blank" rel="noopener"
                 class="block bg-gray-50 border border-gray-200 rounded-xl p-4 text-center hover:bg-gray-100 transition">
                <p class="text-sm font-semibold text-brand-600">Open document</p>
                <p class="text-[11px] text-gray-500 mt-1"><%= sec.original_name %></p>
              </a>
            <% } %>

            <!-- Per-section acknowledgement -->
            <label class="mt-6 flex items-center gap-3 bg-emerald-50 border border-emerald-200 rounded-2xl p-4 cursor-pointer">
              <input type="checkbox" class="sop-ack w-5 h-5 rounded text-emerald-500 focus:ring-emerald-500" data-section-id="<%= sec.id %>" />
              <span class="text-sm text-emerald-900 font-semibold leading-snug">I have read and understood "<%= sec.title %>"</span>
            </label>
          </div>
        <% } %>

        <% if (step.kind === 'signature') { %>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-1">Sign off</h2>
            <p class="text-gray-600 text-sm mb-5">You've reviewed all <%= sections.length %> section<%= sections.length === 1 ? '' : 's' %>. Sign below to record your acknowledgement.</p>

            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-5">
              <p class="text-[10px] font-bold text-amber-800 uppercase tracking-widest mb-2">Acknowledgement (SOP version <%= sopVersion %>)</p>
              <p class="ack-text text-sm text-gray-800 leading-relaxed"><%= ackText %></p>
            </div>

            <div>
              <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Sign here</label>
              <div id="sig-pad-wrap" class="relative rounded-xl border border-gray-300 bg-white overflow-hidden" style="background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 23px, rgba(0,0,0,0.04) 23px, rgba(0,0,0,0.04) 24px);">
                <canvas id="sig-canvas" class="block w-full" style="height: 220px;"></canvas>
                <span id="sig-placeholder" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none">Sign with your finger</span>
                <div class="flex items-center justify-between px-3 py-2 bg-gray-50 border-t border-gray-200">
                  <span class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest">Signature</span>
                  <button type="button" id="sig-clear" class="text-xs font-semibold text-gray-500 hover:text-gray-700">Clear</button>
                </div>
              </div>
              <input type="hidden" name="signature_data" id="signature_data">
              <p id="errMsg" class="hidden text-red-500 text-xs font-medium mt-2"></p>
            </div>
          </div>
        <% } %>

      </div>
    <% }) %>

  </form>

  <!-- Sticky bottom nav (visible Back + Next/Submit) -->
  <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-4 py-3 z-20 shadow-lg">
    <div class="max-w-2xl mx-auto flex items-center gap-3">
      <button type="button" id="prev-btn" class="inline-flex items-center justify-center gap-1.5 px-5 py-3 bg-white border-2 border-gray-300 hover:bg-gray-100 text-gray-700 text-sm font-bold rounded-xl transition disabled:opacity-40 disabled:cursor-not-allowed" disabled>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Back
      </button>
      <button type="button" id="next-btn" class="flex-1 inline-flex items-center justify-center gap-1.5 py-3 bg-brand-600 hover:bg-brand-500 text-white text-sm font-bold rounded-xl transition shadow-md disabled:opacity-40 disabled:cursor-not-allowed">
        Next
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
      <button type="button" id="submit-btn" class="hidden flex-1 inline-flex items-center justify-center gap-1.5 py-3 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-bold rounded-xl transition shadow-md disabled:opacity-40 disabled:cursor-not-allowed">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Sign &amp; Submit
      </button>
    </div>
  </div>

  <!-- PDF.js (lazy-loaded — only initialised when a section actually needs client-side render) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script>
    // Configure PDF.js worker once on load.
    if (window.pdfjsLib) {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    const TOTAL_STEPS = <%= totalSteps %>;
    const STEP_KINDS = <%- JSON.stringify(steps.map(s => s.kind)) %>;
    const PREVIEW_MODE = <%- JSON.stringify(typeof previewMode !== 'undefined' && previewMode) %>;
    let currentStep = 0;

    const stepEls = document.querySelectorAll('.step-panel');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const submitBtn = document.getElementById('submit-btn');
    const counter = document.getElementById('step-counter');

    // Track which sections have been client-rendered to avoid re-rendering on each nav
    const renderedSectionIds = new Set();

    function showStep(n) {
      n = Math.max(0, Math.min(TOTAL_STEPS - 1, n));
      currentStep = n;
      stepEls.forEach(el => el.classList.toggle('active', parseInt(el.dataset.step, 10) === n));
      counter.textContent = (n + 1);

      // Stepper circles state
      for (let i = 0; i < TOTAL_STEPS; i++) {
        const circle = document.getElementById('stepCircle' + i);
        const numEl = document.getElementById('stepNum' + i);
        const check = document.getElementById('stepCheck' + i);
        const label = document.getElementById('stepLabel' + i);
        if (!circle) continue;
        if (i < n) {
          circle.className = 'w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-all duration-300 bg-emerald-500 text-white border-emerald-500';
          if (numEl) numEl.classList.add('hidden');
          if (check) check.classList.remove('hidden');
          if (label) { label.classList.remove('text-gray-400', 'text-brand-600'); label.classList.add('text-emerald-600'); }
        } else if (i === n) {
          circle.className = 'w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-all duration-300 bg-brand-500 text-white border-brand-500';
          if (numEl) numEl.classList.remove('hidden');
          if (check) check.classList.add('hidden');
          if (label) { label.classList.remove('text-gray-400', 'text-emerald-600'); label.classList.add('text-brand-600'); }
        } else {
          circle.className = 'w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-all duration-300 bg-white text-gray-400 border-gray-300';
          if (numEl) numEl.classList.remove('hidden');
          if (check) check.classList.add('hidden');
          if (label) { label.classList.remove('text-brand-600', 'text-emerald-600'); label.classList.add('text-gray-400'); }
        }
        if (i < TOTAL_STEPS - 1) {
          const line = document.getElementById('stepLine' + i);
          if (line) line.className = (i < n)
            ? 'flex-1 h-0.5 mx-0.5 mt-[-14px] min-w-[16px] transition-all duration-300 bg-emerald-500'
            : 'flex-1 h-0.5 mx-0.5 mt-[-14px] min-w-[16px] transition-all duration-300 bg-gray-200';
        }
      }

      // Scroll active stepper circle into view
      const activeCircle = document.getElementById('stepCircle' + n);
      if (activeCircle && activeCircle.scrollIntoView) {
        activeCircle.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }

      prevBtn.disabled = n === 0;
      const isFinal = n === TOTAL_STEPS - 1;
      nextBtn.classList.toggle('hidden', isFinal);
      submitBtn.classList.toggle('hidden', !isFinal);
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // If we just entered a section step, render its PDF (once).
      const activePanel = stepEls[n];
      if (activePanel) {
        const pdfTarget = activePanel.querySelector('.pdf-render-target');
        if (pdfTarget && !renderedSectionIds.has(pdfTarget.dataset.docId)) {
          renderedSectionIds.add(pdfTarget.dataset.docId);
          renderPdfClientSide(pdfTarget);
        }
      }
      if (isFinal) sizeSignature();
      syncNextEnabled();
    }

    function currentKind() { return STEP_KINDS[currentStep]; }

    function syncNextEnabled() {
      const kind = currentKind();
      let ok = true;
      if (kind === 'welcome') {
        const picker = document.getElementById('crew-picker');
        if (picker) {
          const manual = document.getElementById('manual-name');
          const v = picker.value || (manual && manual.value.trim());
          ok = !!v;
        }
      } else if (kind === 'section') {
        const panel = stepEls[currentStep];
        const cb = panel && panel.querySelector('.sop-ack');
        ok = !!(cb && cb.checked);
      }
      nextBtn.disabled = !ok;
      submitBtn.disabled = !(allSectionsAcked() && hasInk);
    }

    function allSectionsAcked() {
      const cbs = document.querySelectorAll('.sop-ack');
      return Array.from(cbs).every(cb => cb.checked);
    }

    nextBtn.addEventListener('click', () => {
      const kind = currentKind();
      if (kind === 'welcome') {
        const picker = document.getElementById('crew-picker');
        if (picker) {
          const manual = document.getElementById('manual-name');
          const v = picker.value || (manual && manual.value.trim());
          if (!v) { document.getElementById('welcome-error').classList.remove('hidden'); return; }
          document.getElementById('welcome-error').classList.add('hidden');
        }
      }
      showStep(currentStep + 1);
    });
    prevBtn.addEventListener('click', () => showStep(currentStep - 1));

    document.querySelectorAll('.sop-ack').forEach(cb => cb.addEventListener('change', syncNextEnabled));
    const picker = document.getElementById('crew-picker');
    if (picker) picker.addEventListener('change', syncNextEnabled);
    const manual = document.getElementById('manual-name');
    if (manual) manual.addEventListener('input', syncNextEnabled);

    // Click on a stepper circle to jump (only backwards or to current).
    document.querySelectorAll('.step-indicator').forEach(el => {
      el.addEventListener('click', () => {
        const target = parseInt(el.dataset.step, 10);
        if (target <= currentStep) showStep(target);
      });
    });

    // ── Client-side PDF rendering (renders every page as a canvas) ──
    async function renderPdfClientSide(target) {
      if (!window.pdfjsLib) {
        target.innerHTML = '<p class="text-xs text-red-600 text-center py-4">PDF viewer failed to load. <a href="' + target.dataset.pdfUrl + '" target="_blank" class="underline">Open the PDF directly.</a></p>';
        return;
      }
      const url = target.dataset.pdfUrl;
      try {
        const loadingTask = window.pdfjsLib.getDocument({ url, disableAutoFetch: false, disableStream: false });
        const pdf = await loadingTask.promise;
        target.innerHTML = ''; // clear loading message
        const containerWidth = target.clientWidth || 600;
        for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
          const page = await pdf.getPage(pageNum);
          const viewport = page.getViewport({ scale: 1 });
          const scale = Math.min(2, containerWidth / viewport.width);
          const scaled = page.getViewport({ scale });
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          const dpr = window.devicePixelRatio || 1;
          canvas.width = scaled.width * dpr;
          canvas.height = scaled.height * dpr;
          canvas.style.width = '100%';
          canvas.style.height = 'auto';
          canvas.className = 'block w-full rounded-xl border border-gray-200 shadow-sm bg-white';
          ctx.scale(dpr, dpr);
          target.appendChild(canvas);
          await page.render({ canvasContext: ctx, viewport: scaled }).promise;
        }
      } catch (err) {
        console.error('PDF render failed:', err);
        target.innerHTML = '<p class="text-xs text-red-600 text-center py-4">Could not render PDF inline. <a href="' + target.dataset.pdfUrl + '" target="_blank" class="underline">Open the PDF directly.</a></p>';
      }
    }

    // ── Signature pad ──
    const canvas = document.getElementById('sig-canvas');
    const placeholder = document.getElementById('sig-placeholder');
    const ctx = canvas && canvas.getContext('2d');
    let drawing = false;
    let last = null;
    let hasInk = false;

    function sizeSignature() {
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0) return;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);
      ctx.lineWidth = 2.2;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#0f172a';
    }
    if (canvas) {
      window.addEventListener('resize', sizeSignature);
      function getXY(e) {
        const rect = canvas.getBoundingClientRect();
        const t = e.touches ? e.touches[0] : e;
        return { x: t.clientX - rect.left, y: t.clientY - rect.top };
      }
      function start(e) { e.preventDefault(); drawing = true; last = getXY(e); placeholder.style.display = 'none'; }
      function move(e) {
        if (!drawing) return;
        e.preventDefault();
        const p = getXY(e);
        ctx.beginPath();
        ctx.moveTo(last.x, last.y);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
        last = p;
        hasInk = true;
        syncNextEnabled();
      }
      function end() { drawing = false; }
      canvas.addEventListener('mousedown', start);
      canvas.addEventListener('mousemove', move);
      canvas.addEventListener('mouseup', end);
      canvas.addEventListener('mouseleave', end);
      canvas.addEventListener('touchstart', start, { passive: false });
      canvas.addEventListener('touchmove', move, { passive: false });
      canvas.addEventListener('touchend', end);

      document.getElementById('sig-clear').addEventListener('click', () => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        hasInk = false;
        placeholder.style.display = '';
        syncNextEnabled();
      });
    }

    // ── Submit ──
    const form = document.getElementById('signForm');
    submitBtn.addEventListener('click', () => {
      const errMsg = document.getElementById('errMsg');
      if (!allSectionsAcked()) {
        errMsg.textContent = 'Please go back and tick each section.';
        errMsg.classList.remove('hidden');
        return;
      }
      if (!hasInk) {
        errMsg.textContent = 'Please draw your signature above.';
        errMsg.classList.remove('hidden');
        return;
      }
      errMsg.classList.add('hidden');
      if (PREVIEW_MODE) {
        alert('Preview mode — submission disabled.');
        return;
      }
      document.getElementById('signature_data').value = canvas.toDataURL('image/png');
      submitBtn.disabled = true;
      submitBtn.innerHTML = 'Submitting…';
      form.submit();
    });

    // Init
    showStep(0);
  </script>

<% } %>

</body>
</html>
