<% locals.currentPage = 'swms' %>
<%
  function fmtDate(s) {
    if (!s) return '—';
    return new Date(s).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
  // Days until expiry (negative = past). Used to colour the expiry cell red
  // when expired, amber when due in the next 30 days.
  function expiryClass(s) {
    if (!s) return 'text-gray-400';
    const d = Math.floor((new Date(s) - new Date(new Date().toISOString().slice(0,10))) / 86400000);
    if (d < 0) return 'text-red-700 font-semibold';
    if (d <= 30) return 'text-amber-700 font-semibold';
    return 'text-gray-700';
  }
  function expiryLabel(s) {
    if (!s) return '—';
    const d = Math.floor((new Date(s) - new Date(new Date().toISOString().slice(0,10))) / 86400000);
    const date = new Date(s).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
    if (d < 0)  return date + ' · ' + Math.abs(d) + 'd overdue';
    if (d <= 30) return date + ' · in ' + d + 'd';
    return date;
  }
  const STATUS_BADGE = {
    draft:    'bg-amber-50 text-amber-700 ring-amber-200',
    active:   'bg-emerald-50 text-emerald-700 ring-emerald-200',
    archived: 'bg-gray-50 text-gray-600 ring-gray-200',
  };
%>

<div class="max-w-6xl mx-auto space-y-5">
  <!-- Header -->
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">SWMS Register</h1>
      <p class="text-sm text-gray-500 mt-0.5">Safe Work Method Statements — templates renew every 3 months, job-linked SWMS every 6 months.</p>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <a href="/swms/new?kind=template" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg inline-flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5-5 5 5M12 5v12"/></svg>
        Import template
      </a>
      <a href="/swms/new?kind=job" class="px-3 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg inline-flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"/></svg>
        Assign new SWMS
      </a>
    </div>
  </div>

  <!-- Stat cards -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total</p>
      <p class="text-xl font-bold text-gray-900 mt-0.5"><%= counts.total || 0 %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
      <p class="text-[10px] font-bold text-blue-500 uppercase tracking-widest">Templates</p>
      <p class="text-xl font-bold text-blue-700 mt-0.5"><%= counts.templates || 0 %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
      <p class="text-[10px] font-bold text-purple-500 uppercase tracking-widest">Job-linked</p>
      <p class="text-xl font-bold text-purple-700 mt-0.5"><%= counts.job_linked || 0 %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
      <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Active</p>
      <p class="text-xl font-bold text-emerald-700 mt-0.5"><%= counts.active || 0 %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
      <p class="text-[10px] font-bold text-amber-500 uppercase tracking-widest">Expiring &lt;30d</p>
      <p class="text-xl font-bold <%= counts.expiring_soon ? 'text-amber-700' : 'text-gray-300' %> mt-0.5"><%= counts.expiring_soon || 0 %></p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
      <p class="text-[10px] font-bold text-red-500 uppercase tracking-widest">Expired</p>
      <p class="text-xl font-bold <%= counts.expired ? 'text-red-700' : 'text-gray-300' %> mt-0.5"><%= counts.expired || 0 %></p>
    </div>
  </div>

  <!-- Tabs: Active register · Access requests · Archived -->
  <div class="border-b border-gray-200 flex items-center gap-1 overflow-x-auto">
    <a href="/swms" class="px-4 py-2 -mb-px border-b-2 text-sm font-semibold whitespace-nowrap <%= view === 'active' ? 'border-brand-600 text-brand-700' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      Active register
      <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full <%= view === 'active' ? 'bg-brand-50 text-brand-700' : 'bg-gray-100 text-gray-500' %>"><%= (counts.total || 0) - (counts.archived || 0) %></span>
    </a>
    <a href="/swms?view=access-requests" class="px-4 py-2 -mb-px border-b-2 text-sm font-semibold whitespace-nowrap inline-flex items-center gap-1.5 <%= view === 'access-requests' ? 'border-brand-600 text-brand-700' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      Access requests
      <% if (pendingRequestsCount > 0) { %>
        <span class="px-1.5 py-0.5 text-[10px] rounded-full bg-amber-100 text-amber-800 font-bold"><%= pendingRequestsCount %></span>
      <% } else { %>
        <span class="px-1.5 py-0.5 text-[10px] rounded-full <%= view === 'access-requests' ? 'bg-brand-50 text-brand-700' : 'bg-gray-100 text-gray-500' %>">0</span>
      <% } %>
    </a>
    <a href="/swms?view=archived" class="px-4 py-2 -mb-px border-b-2 text-sm font-semibold whitespace-nowrap <%= view === 'archived' ? 'border-brand-600 text-brand-700' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
      Archived
      <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full <%= view === 'archived' ? 'bg-brand-50 text-brand-700' : 'bg-gray-100 text-gray-500' %>"><%= counts.archived || 0 %></span>
    </a>
  </div>

  <% if (view === 'active') { %>
  <!-- Filters (status only — kind split is implicit via the two sections below) -->
  <form method="GET" action="/swms" class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 flex flex-wrap items-end gap-3">
    <div>
      <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Status</label>
      <select name="status" class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
        <option value="" <%= filters.status === 'all' ? 'selected' : '' %>>All</option>
        <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
      </select>
    </div>
    <button type="submit" class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-lg">Filter</button>
    <a href="/swms" class="px-3 py-2 text-gray-500 text-sm hover:text-gray-700">Clear</a>
  </form>
  <% } %>

  <%
  // Render the same table for either section. Templates have no Job column
  // (always blank), so we hide it to keep the layout tight.
  function renderRows(rows, showJob) {
  %>
  <% if (!rows.length) { %>
    <div class="px-5 py-8 text-center text-sm text-gray-500">No <%= showJob ? 'job-linked SWMS' : 'templates' %> yet.</div>
  <% } else { %>
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Title</th>
          <% if (showJob) { %><th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Job</th><% } %>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Owner</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Status</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Expiry</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">File</th>
          <th class="px-2 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% rows.forEach(r => { %>
          <tr class="hover:bg-gray-50/50">
            <td class="px-3 py-2">
              <a href="/swms/<%= r.id %>" class="font-semibold text-gray-900 hover:text-brand-600"><%= r.title %></a>
              <% if (r.description) { %><p class="text-xs text-gray-500 mt-0.5 line-clamp-1"><%= r.description %></p><% } %>
            </td>
            <% if (showJob) { %>
              <td class="px-2 py-2 text-xs text-gray-600"><% if (r.job_number) { %><a href="/jobs/<%= r.job_id %>" class="hover:text-brand-600"><%= r.job_number %></a><% } else { %>—<% } %></td>
            <% } %>
            <td class="px-2 py-2 text-xs text-gray-600"><%= r.owner_name || '—' %></td>
            <td class="px-2 py-2"><span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= STATUS_BADGE[r.status] %>"><%= statusLabels[r.status] %></span></td>
            <td class="px-2 py-2 text-xs tabular-nums <%= expiryClass(r.expiry_date) %>"><%= expiryLabel(r.expiry_date) %></td>
            <td class="px-2 py-2 text-xs">
              <% if (r.file_path) { %>
                <a href="/swms/<%= r.id %>/file" class="text-brand-600 hover:underline"><%= r.file_original_name || 'Download' %></a>
              <% } else { %>
                <span class="text-gray-400">—</span>
              <% } %>
            </td>
            <td class="px-2 py-2 text-right">
              <form method="POST" action="/swms/<%= r.id %>/archive" class="inline" onsubmit="return confirm('<%= r.status === 'archived' ? 'Restore this SWMS to active?' : 'Archive this SWMS? It will stay on record but be marked as archived.' %>')">
                <%- include('../partials/csrf') %>
                <% if (r.status === 'archived') { %>
                  <button type="submit" title="Restore" class="inline-flex items-center gap-1 px-2 py-1 text-xs font-semibold text-gray-600 hover:text-emerald-700 hover:bg-emerald-50 rounded ring-1 ring-gray-200 hover:ring-emerald-200">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    Restore
                  </button>
                <% } else { %>
                  <button type="submit" title="Archive" class="inline-flex items-center gap-1 px-2 py-1 text-xs font-semibold text-gray-600 hover:text-amber-700 hover:bg-amber-50 rounded ring-1 ring-gray-200 hover:ring-amber-200">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                    Archive
                  </button>
                <% } %>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
  <% } %>

  <% if (view === 'active') { %>
    <!-- Templates section (3-month update cycle) -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200 flex items-center justify-between bg-blue-50/40">
        <div>
          <h2 class="text-sm font-bold text-blue-900">Templates <span class="text-blue-700/60 font-normal">(<%= templates.length %>)</span></h2>
          <p class="text-xs text-blue-700/70 mt-0.5">Reusable SWMS that any job can pull from. Reviewed every 3 months.</p>
        </div>
      </div>
      <%- renderRows(templates, false) %>
    </div>

    <!-- Job-linked section (6-month renewal cycle) -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200 flex items-center justify-between bg-purple-50/40">
        <div>
          <h2 class="text-sm font-bold text-purple-900">Job-linked <span class="text-purple-700/60 font-normal">(<%= jobLinked.length %>)</span></h2>
          <p class="text-xs text-purple-700/70 mt-0.5">Tied to a specific job. Renew every 6 months.</p>
        </div>
      </div>
      <%- renderRows(jobLinked, true) %>
    </div>
  <% } else if (view === 'access-requests') { %>
    <!-- Pending requests -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200 bg-amber-50/40 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-amber-900">Pending requests <span class="text-amber-700/60 font-normal">(<%= pendingRequests.length %>)</span></h2>
          <p class="text-xs text-amber-700/70 mt-0.5">Workers who have asked for access. Approve to grant access; reject to decline with a reason.</p>
        </div>
      </div>
      <% if (!pendingRequests.length) { %>
        <div class="px-5 py-8 text-center text-sm text-gray-500">No pending requests.</div>
      <% } else { %>
        <ul class="divide-y divide-gray-100">
          <% pendingRequests.forEach(r => { %>
            <li class="p-4 sm:p-5">
              <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <a href="/crew/<%= r.crew_member_id %>" class="text-sm font-semibold text-gray-900 hover:text-brand-600"><%= r.worker_name %></a>
                    <% if (r.employee_code) { %><code class="text-[10px] bg-gray-100 px-1.5 py-0.5 rounded font-mono text-gray-600"><%= r.employee_code %></code><% } %>
                    <span class="text-xs text-gray-400">requested access to</span>
                    <a href="/swms/<%= r.swms_id %>" class="text-sm font-semibold text-brand-700 hover:text-brand-800"><%= r.swms_title %></a>
                    <% if (r.job_number) { %><span class="text-[10px] text-gray-500">· <a href="/jobs/<%= r.job_id %>" class="hover:text-brand-600"><%= r.job_number %></a></span><% } %>
                  </div>
                  <p class="text-[11px] text-gray-500 mt-1">Requested <%= fmtDate(r.created_at) %></p>
                  <% if (r.inducted_with || r.induction_date || r.worker_note) { %>
                    <div class="mt-2 bg-gray-50 border border-gray-100 rounded-lg p-2.5 text-xs text-gray-700 space-y-1">
                      <% if (r.inducted_with) { %><p><span class="text-gray-400 font-medium">Inducted with:</span> <%= r.inducted_with %></p><% } %>
                      <% if (r.induction_date) { %><p><span class="text-gray-400 font-medium">Induction date:</span> <%= fmtDate(r.induction_date) %></p><% } %>
                      <% if (r.worker_note) { %><p class="whitespace-pre-line"><span class="text-gray-400 font-medium">Note:</span> <%= r.worker_note %></p><% } %>
                    </div>
                  <% } %>
                </div>
                <div class="flex flex-col sm:flex-row gap-2 lg:flex-shrink-0">
                  <form method="POST" action="/swms/access-requests/<%= r.id %>/approve" class="flex flex-col sm:flex-row gap-2">
                    <%- include('../partials/csrf') %>
                    <input type="text" name="decision_note" placeholder="Optional note" maxlength="500" class="px-2.5 py-1.5 text-xs border border-gray-300 rounded-lg w-full sm:w-44">
                    <button type="submit" class="px-3 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 rounded-lg whitespace-nowrap">Approve</button>
                  </form>
                  <form method="POST" action="/swms/access-requests/<%= r.id %>/reject" onsubmit="var n=this.querySelector('input[name=decision_note]'); var p = prompt('Reason for rejecting? (optional)', n.value || ''); if (p === null) return false; n.value = p; return true;" class="flex gap-2">
                    <%- include('../partials/csrf') %>
                    <input type="hidden" name="decision_note" value="">
                    <button type="submit" class="px-3 py-1.5 text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 ring-1 ring-red-200 rounded-lg whitespace-nowrap">Reject</button>
                  </form>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <!-- Active grants -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200 bg-emerald-50/40">
        <h2 class="text-sm font-bold text-emerald-900">Granted access <span class="text-emerald-700/60 font-normal">(<%= grants.length %>)</span></h2>
        <p class="text-xs text-emerald-700/70 mt-0.5">Workers who currently have access. Revoke to remove access immediately.</p>
      </div>
      <% if (!grants.length) { %>
        <div class="px-5 py-8 text-center text-sm text-gray-500">No grants yet.</div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Worker</th>
                <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">SWMS</th>
                <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Job</th>
                <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Granted</th>
                <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Source</th>
                <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">By</th>
                <th class="px-2 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% grants.forEach(g => { %>
                <tr class="hover:bg-gray-50/50">
                  <td class="px-3 py-2">
                    <a href="/crew/<%= g.crew_member_id %>" class="font-semibold text-gray-900 hover:text-brand-600"><%= g.worker_name %></a>
                    <% if (g.employee_code) { %><code class="ml-1 text-[10px] bg-gray-100 px-1.5 py-0.5 rounded font-mono text-gray-500"><%= g.employee_code %></code><% } %>
                  </td>
                  <td class="px-2 py-2"><a href="/swms/<%= g.swms_id %>" class="text-brand-700 hover:underline"><%= g.swms_title %></a></td>
                  <td class="px-2 py-2 text-xs text-gray-600"><% if (g.job_number) { %><a href="/jobs/<%= g.job_id %>" class="hover:text-brand-600"><%= g.job_number %></a><% } else { %>—<% } %></td>
                  <td class="px-2 py-2 text-xs text-gray-600 tabular-nums"><%= fmtDate(g.granted_at) %></td>
                  <td class="px-2 py-2">
                    <% if (g.source === 'request_approved') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-blue-50 text-blue-700 ring-blue-200">Request</span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-gray-50 text-gray-700 ring-gray-200">Manual</span>
                    <% } %>
                  </td>
                  <td class="px-2 py-2 text-xs text-gray-600"><%= g.granted_by_name || '—' %></td>
                  <td class="px-2 py-2 text-right">
                    <form method="POST" action="/swms/grants/<%= g.id %>/revoke" class="inline" onsubmit="return confirm('Revoke <%= g.worker_name.replace(/'/g, "\\'") %>\'s access to this SWMS?')">
                      <%- include('../partials/csrf') %>
                      <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs font-semibold text-red-600 hover:bg-red-50 rounded ring-1 ring-red-200">Revoke</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Recent decisions -->
    <% if (decidedRequests.length) { %>
    <details class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <summary class="px-5 py-3 border-b border-gray-200 bg-gray-50/60 cursor-pointer text-sm font-bold text-gray-800">Recent decisions <span class="text-gray-500 font-normal">(<%= decidedRequests.length %>)</span></summary>
      <ul class="divide-y divide-gray-100">
        <% decidedRequests.forEach(d => { %>
          <li class="px-5 py-3 flex flex-col sm:flex-row sm:items-center gap-2 text-xs">
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= d.status === 'approved' ? 'bg-emerald-50 text-emerald-700 ring-emerald-200' : 'bg-red-50 text-red-700 ring-red-200' %>"><%= d.status %></span>
            <span class="text-gray-700"><strong><%= d.worker_name %></strong> → <%= d.swms_title %></span>
            <span class="text-gray-400 ml-auto tabular-nums"><%= fmtDate(d.decided_at) %> by <%= d.decided_by_name || '—' %></span>
            <% if (d.decision_note) { %><p class="basis-full sm:basis-auto sm:ml-2 text-gray-500 italic">"<%= d.decision_note %>"</p><% } %>
          </li>
        <% }) %>
      </ul>
    </details>
    <% } %>
  <% } else { %>
    <!-- Archived: combined table, both kinds, no expiry / status columns -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b border-gray-200 bg-gray-50/60">
        <h2 class="text-sm font-bold text-gray-800">Archived <span class="text-gray-500 font-normal">(<%= archived.length %>)</span></h2>
        <p class="text-xs text-gray-500 mt-0.5">Off the active register, kept on record. Restore to bring back to Active.</p>
      </div>
      <% if (!archived.length) { %>
        <div class="px-5 py-8 text-center text-sm text-gray-500">Nothing archived yet.</div>
      <% } else { %>
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Title</th>
              <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Kind</th>
              <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Job</th>
              <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Owner</th>
              <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">File</th>
              <th class="px-2 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% archived.forEach(r => { %>
              <tr class="hover:bg-gray-50/50">
                <td class="px-3 py-2">
                  <a href="/swms/<%= r.id %>" class="font-semibold text-gray-900 hover:text-brand-600"><%= r.title %></a>
                  <% if (r.description) { %><p class="text-xs text-gray-500 mt-0.5 line-clamp-1"><%= r.description %></p><% } %>
                </td>
                <td class="px-2 py-2 text-xs text-gray-600"><%= kindLabels[r.kind] %></td>
                <td class="px-2 py-2 text-xs text-gray-600"><% if (r.job_number) { %><a href="/jobs/<%= r.job_id %>" class="hover:text-brand-600"><%= r.job_number %></a><% } else { %>—<% } %></td>
                <td class="px-2 py-2 text-xs text-gray-600"><%= r.owner_name || '—' %></td>
                <td class="px-2 py-2 text-xs">
                  <% if (r.file_path) { %>
                    <a href="/swms/<%= r.id %>/file" class="text-brand-600 hover:underline"><%= r.file_original_name || 'Download' %></a>
                  <% } else { %>
                    <span class="text-gray-400">—</span>
                  <% } %>
                </td>
                <td class="px-2 py-2 text-right">
                  <form method="POST" action="/swms/<%= r.id %>/archive" class="inline" onsubmit="return confirm('Restore this SWMS to the active register?')">
                    <%- include('../partials/csrf') %>
                    <button type="submit" title="Restore" class="inline-flex items-center gap-1 px-2 py-1 text-xs font-semibold text-gray-600 hover:text-emerald-700 hover:bg-emerald-50 rounded ring-1 ring-gray-200 hover:ring-emerald-200">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                      Restore
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  <% } %>
</div>
