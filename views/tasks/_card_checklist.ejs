<%
  // Inline checklist for a task card. Expects `task` with a `subtasks` array.
  // Tick-off is handled by the AJAX handler in tasks/index.ejs.
  const _subs = (task.subtasks && task.subtasks.length) ? task.subtasks : null;
  if (_subs) {
    const _done = _subs.filter(function (s) { return s.completed; }).length;
    const _total = _subs.length;
    const _pct = Math.round((_done / _total) * 100);
%>
<details class="tw-checklist mt-3 pt-3 border-t border-gray-100" data-task-id="<%= task.id %>" open>
  <summary class="flex items-center gap-2 cursor-pointer select-none">
    <svg class="tw-chev w-3 h-3 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
    <span class="text-[10px] font-semibold text-gray-500 uppercase tracking-wide flex-shrink-0">Checklist</span>
    <span class="tw-cl-count text-[10px] font-medium text-gray-400 flex-shrink-0"><%= _done %>/<%= _total %></span>
    <span class="flex-1 h-1.5 bg-gray-100 rounded-full overflow-hidden">
      <span class="tw-cl-bar block h-full bg-brand-500 rounded-full transition-all" style="width: <%= _pct %>%"></span>
    </span>
  </summary>
  <ul class="mt-2 space-y-1">
    <% _subs.forEach(function (s) { %>
      <li class="flex items-center gap-2">
        <button type="button"
          class="tw-cl-toggle w-4 h-4 rounded border flex items-center justify-center flex-shrink-0 transition-colors <%= s.completed ? 'bg-brand-600 border-brand-600 text-white' : 'border-gray-300 hover:border-brand-400 bg-white' %>"
          data-task-id="<%= task.id %>" data-sub-id="<%= s.id %>" aria-pressed="<%= s.completed ? 'true' : 'false' %>" title="Tick off">
          <svg class="w-2.5 h-2.5 <%= s.completed ? '' : 'hidden' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M5 13l4 4L19 7"/></svg>
        </button>
        <span class="tw-cl-label text-xs flex-1 min-w-0 <%= s.completed ? 'text-gray-400 line-through' : 'text-gray-600' %>"><%= s.title %></span>
      </li>
    <% }) %>
  </ul>
</details>
<% } %>
