<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Toolbox attendance</title>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Geist', 'Inter', sans-serif; background: #0A1628; color: #fff; min-height: 100dvh; display: flex; align-items: center; justify-content: center; padding: 24px; margin: 0; }
    .card { max-width: 420px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 28px; text-align: center; }
    h1 { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
    p { color: rgba(255,255,255,0.7); font-size: 14px; line-height: 1.5; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Attendance link unavailable</h1>
    <p><%= message || 'Please ask the office for a new link.' %></p>
  </div>
</body>
</html>
