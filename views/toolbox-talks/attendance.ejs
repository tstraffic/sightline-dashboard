<% locals.currentPage = 'toolbox-talks' %>
<%
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  // A person is "signed" once we have their signature on file.
  const signedCount = rows.filter(r => r.signature_data).length;
%>

<div class="max-w-5xl mx-auto space-y-5">
  <div>
    <a href="/toolbox-talks/<%= toolbox.id %>" class="text-sm text-brand-600 hover:underline">← <%= toolbox.title %></a>
    <h1 class="text-2xl font-bold text-gray-900 mt-1">Who's here &amp; sign-off</h1>
    <p class="text-sm text-gray-500 mt-0.5">Pick who's at the talk, then sign each person off — on this device, or send them the link to sign. Their signature saves against their name and flows into the record PDF.</p>
  </div>

  <!-- Tabs -->
  <div class="border-b border-gray-200 flex items-center gap-1">
    <a href="/toolbox-talks/<%= toolbox.id %>" class="px-4 py-2 -mb-px border-b-2 border-transparent text-gray-500 hover:text-gray-700 text-sm font-semibold">Details</a>
    <span class="px-4 py-2 -mb-px border-b-2 border-brand-600 text-brand-700 text-sm font-semibold">Sign-off</span>
  </div>

  <!-- Share link — QR + copy + email everyone unsigned -->
  <% if (attendanceUrl) { %>
    <div class="bg-gradient-to-br from-brand-50 to-emerald-50 border border-brand-200 rounded-xl shadow-sm p-5">
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <div class="bg-white p-3 rounded-lg shadow-sm flex-shrink-0">
          <div id="att-qr" style="width: 160px; height: 160px; display: flex; align-items: center; justify-content: center; color: #9CA3AF; font-size: 11px;">Loading QR…</div>
        </div>
        <div class="flex-1 min-w-0 space-y-2">
          <p class="text-[10px] font-bold text-brand-700 uppercase tracking-widest">Sign-off link · project the QR or share the URL</p>
          <p class="text-sm text-gray-700">Workers scan, pick their name, and sign with their finger. Their signature appears below and in the PDF.</p>
          <div class="flex items-center gap-2">
            <input id="att-url" type="text" readonly value="<%= attendanceUrl %>" onclick="this.select()"
              class="flex-1 px-3 py-2 text-xs bg-white border border-gray-200 rounded-lg text-gray-800 font-mono min-w-0">
            <button type="button" id="att-url-copy" class="inline-flex items-center gap-1 px-3 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg flex-shrink-0">Copy</button>
            <a href="<%= attendanceUrl %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1 px-3 py-2 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-lg flex-shrink-0">Preview</a>
          </div>
          <div class="flex items-center gap-2 pt-1">
            <button type="button" id="att-email-all" class="inline-flex items-center gap-1.5 px-3 py-2 bg-white border border-brand-200 hover:bg-brand-50 text-brand-700 text-xs font-semibold rounded-lg">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              Email link to everyone who hasn't signed
            </button>
            <span id="att-email-all-status" class="text-xs text-gray-500"></span>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
      (function () {
        var box = document.getElementById('att-qr');
        if (window.QRCode && box) {
          box.innerHTML = '';
          try { new QRCode(box, { text: <%- JSON.stringify(attendanceUrl) %>, width: 160, height: 160, colorDark: '#111827', colorLight: '#ffffff', correctLevel: QRCode.CorrectLevel.M }); }
          catch (e) { box.textContent = 'QR render failed — share the URL below.'; }
        } else if (box) { box.textContent = 'Share the URL below.'; }
        var copyBtn = document.getElementById('att-url-copy');
        if (copyBtn) copyBtn.addEventListener('click', function () {
          var i = document.getElementById('att-url');
          (navigator.clipboard ? navigator.clipboard.writeText(i.value) : Promise.reject())
            .then(function () { var t = copyBtn.textContent; copyBtn.textContent = 'Copied!'; setTimeout(function () { copyBtn.textContent = t; }, 1500); })
            .catch(function () { i.select(); document.execCommand('copy'); });
        });
      })();
    </script>
  <% } %>

  <!-- Roster: who's here + sign-off -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm">
    <div class="px-5 py-3 border-b border-gray-200 flex items-center justify-between gap-3 flex-wrap">
      <div class="text-sm font-semibold text-gray-700"><span data-signed-count><%= signedCount %></span> of <span data-total-count><%= rows.length %></span> signed</div>
      <div class="relative" data-add-invitee>
        <button type="button" data-add-invitee-toggle class="px-3 py-1.5 text-xs font-semibold text-brand-700 bg-brand-50 hover:bg-brand-100 rounded inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Add worker
        </button>
        <div data-add-invitee-pop class="hidden absolute right-0 top-full mt-1 w-72 bg-white border border-gray-200 rounded-lg shadow-lg z-20 p-2">
          <% if (isOpenToAll) { %>
            <p class="text-xs text-gray-600 px-2 py-1.5">This toolbox is currently <strong>open to everyone</strong> — every active crew member is listed. Use <em>Remove</em> on a row to narrow it to just who's here.</p>
          <% } else if (!selectableCrew || !selectableCrew.length) { %>
            <p class="text-xs text-gray-600 px-2 py-1.5">All active crew are already listed.</p>
          <% } else { %>
            <input type="text" data-add-invitee-search placeholder="Search by name or ID…" class="block w-full px-2 py-1.5 text-xs border-gray-300 rounded focus:border-brand-500 focus:ring-brand-500 mb-1.5">
            <div data-add-invitee-list class="max-h-56 overflow-y-auto">
              <% selectableCrew.forEach(cm => { %>
                <button type="button" data-add-invitee-crew-id="<%= cm.id %>" data-add-invitee-crew-name="<%= cm.full_name %>" data-add-invitee-crew-emp="<%= cm.employee_id || '' %>"
                        data-name="<%= (cm.full_name || '').toLowerCase() %>" data-emp="<%= (cm.employee_id || '').toLowerCase() %>"
                        class="w-full text-left px-2 py-1.5 text-xs hover:bg-gray-100 rounded flex items-center justify-between gap-2">
                  <span class="font-medium text-gray-800"><%= cm.full_name %></span>
                  <span class="text-gray-500 tabular-nums"><%= cm.employee_id || '' %></span>
                </button>
              <% }) %>
            </div>
            <p class="text-[11px] text-gray-400 mt-1.5 px-1" data-add-invitee-empty hidden>No matches.</p>
          <% } %>
        </div>
      </div>
    </div>
    <table class="min-w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Worker</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Employee ID</th>
          <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Signature</th>
          <th class="px-2 py-2 text-right text-[10px] font-bold text-gray-500 uppercase tracking-widest w-48">Sign-off</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100" id="tb-roster">
        <% rows.forEach(r => { const signed = !!r.signature_data; %>
          <tr class="tb-row hover:bg-gray-50/50 align-middle" data-crew-id="<%= r.crew_id %>">
            <td class="px-3 py-2.5 text-sm font-medium text-gray-900"><%= r.full_name %></td>
            <td class="px-2 py-2.5 text-xs text-gray-500"><%= r.employee_id || '—' %></td>
            <td class="px-2 py-2.5" data-sig-cell>
              <% if (signed) { %>
                <div class="flex items-center gap-2">
                  <img src="<%= r.signature_data %>" alt="Signature" class="h-9 max-w-[130px] object-contain bg-gray-50 border border-gray-200 rounded">
                  <span class="text-[11px] text-emerald-600 font-semibold whitespace-nowrap">Signed<% if (r.late_arrival) { %> · Late<%= r.late_arrival_time ? ' ' + r.late_arrival_time : '' %><% } %></span>
                </div>
                <% if (r.signed_off_at) { %><p class="text-[10px] text-gray-400 mt-0.5"><%= fmt(r.signed_off_at) %></p><% } %>
              <% } else { %>
                <span class="text-[11px] text-gray-400">Not signed yet</span>
              <% } %>
            </td>
            <td class="px-2 py-2.5 text-right whitespace-nowrap" data-action-cell>
              <% if (attendanceUrl && !signed) { %>
                <button type="button" class="tb-sign-here text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded px-2.5 py-1.5" data-crew-id="<%= r.crew_id %>" data-name="<%= r.full_name %>">Sign here</button>
                <button type="button" class="tb-send-link text-[11px] font-semibold text-gray-600 hover:text-gray-800 hover:underline ml-1" data-crew-id="<%= r.crew_id %>" data-name="<%= r.full_name %>"<%= r.email ? '' : ' title="No email on file" disabled' %>>Send link</button>
              <% } %>
              <button type="button" class="tb-remove-invite text-[11px] font-semibold text-rose-600 hover:text-rose-700 hover:underline ml-1" data-crew-id="<%= r.crew_id %>" data-name="<%= r.full_name %>" title="Remove — not here">Remove</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (!rows.length) { %><p class="px-5 py-8 text-center text-sm text-gray-500">No one selected yet. Use <strong>Add worker</strong> to pick who's at the talk.</p><% } %>
  </div>

  <!-- Signature modal (admin device) -->
  <div id="tb-sign-modal" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md">
      <div class="p-5 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Sign off</h2>
        <p class="text-sm text-gray-500 mt-1">Hand the device to <span id="tb-sign-name" class="font-medium text-gray-700">the worker</span> to sign.</p>
      </div>
      <div class="p-5 space-y-3">
        <div class="border-2 border-dashed border-gray-300 rounded-lg bg-gray-50 relative" style="height:170px;">
          <canvas id="tb-sign-pad" style="width:100%;height:100%;touch-action:none;display:block;filter:drop-shadow(0 0 1px rgba(34,211,238,0.6)) drop-shadow(0 0 4px rgba(34,211,238,0.42));"></canvas>
          <span id="tb-sign-ph" class="absolute inset-0 flex items-center justify-center text-sm text-gray-400 pointer-events-none">Sign with your finger</span>
        </div>
        <div class="flex items-center justify-between">
          <label class="inline-flex items-center gap-2 text-sm text-gray-700">
            <input type="checkbox" id="tb-sign-late" class="h-4 w-4 rounded border-gray-300 text-amber-600">
            Late arrival
          </label>
          <button type="button" id="tb-sign-clear" class="text-xs font-semibold text-gray-500 hover:text-gray-700">Clear</button>
        </div>
        <p id="tb-sign-err" class="hidden text-sm text-red-600"></p>
      </div>
      <div class="px-5 py-4 bg-gray-50 rounded-b-xl flex items-center justify-end gap-2">
        <button type="button" id="tb-sign-cancel" class="px-4 py-2 bg-white border border-gray-300 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">Cancel</button>
        <button type="button" id="tb-sign-save" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-lg">Save sign-off</button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var toolboxId = <%= toolbox.id %>;
      var hasSession = <%= attendanceUrl ? 'true' : 'false' %>;
      var csrfMeta = document.querySelector('meta[name="csrf-token"]');
      var csrf = csrfMeta ? csrfMeta.getAttribute('content') : ((document.querySelector('input[name="_csrf"]') || {}).value || '');

      function recount() {
        var rowsEls = document.querySelectorAll('#tb-roster tr.tb-row');
        var signed = 0;
        rowsEls.forEach(function (r) { if (r.getAttribute('data-signed') === '1' || r.querySelector('[data-sig-cell] img')) signed++; });
        var sc = document.querySelector('[data-signed-count]'); if (sc) sc.textContent = signed;
        var tc = document.querySelector('[data-total-count]'); if (tc) tc.textContent = rowsEls.length;
      }

      // ── Signature modal ──
      var modal = document.getElementById('tb-sign-modal');
      var nameEl = document.getElementById('tb-sign-name');
      var errEl = document.getElementById('tb-sign-err');
      var lateEl = document.getElementById('tb-sign-late');
      var canvas = document.getElementById('tb-sign-pad');
      var ph = document.getElementById('tb-sign-ph');
      var ctx = canvas.getContext('2d');
      var drawing = false, hasInk = false, last = null, lastMid = null, crewId = null;
      function sizePad() { var dpr = Math.min(window.devicePixelRatio || 1, 3), rect = canvas.getBoundingClientRect(); if (!rect.width) return; canvas.width = Math.round(rect.width * dpr); canvas.height = Math.round(rect.height * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = '#0f172a'; }
      function pos(e) { var r = canvas.getBoundingClientRect(); var t = e.touches ? e.touches[0] : e; return { x: t.clientX - r.left, y: t.clientY - r.top }; }
      function start(e) { drawing = true; last = pos(e); lastMid = last; if (!hasInk) { hasInk = true; ph.style.display = 'none'; } e.preventDefault(); }
      function move(e) { if (!drawing) return; var p = pos(e); var mid = { x: (last.x + p.x) / 2, y: (last.y + p.y) / 2 }; ctx.beginPath(); ctx.moveTo(lastMid.x, lastMid.y); ctx.quadraticCurveTo(last.x, last.y, mid.x, mid.y); ctx.stroke(); last = p; lastMid = mid; e.preventDefault(); }
      function stop() { drawing = false; }
      canvas.addEventListener('mousedown', start); canvas.addEventListener('mousemove', move); canvas.addEventListener('mouseup', stop); canvas.addEventListener('mouseleave', stop);
      canvas.addEventListener('touchstart', start, { passive: false }); canvas.addEventListener('touchmove', move, { passive: false }); canvas.addEventListener('touchend', stop);
      function clearPad() { ctx.clearRect(0, 0, canvas.width, canvas.height); hasInk = false; ph.style.display = ''; }
      function openModal(id, name) { crewId = id; nameEl.textContent = name || 'the worker'; errEl.classList.add('hidden'); errEl.textContent = ''; lateEl.checked = false; modal.classList.remove('hidden'); setTimeout(function () { sizePad(); clearPad(); }, 30); }
      function closeModal() { modal.classList.add('hidden'); }
      document.getElementById('tb-sign-cancel').addEventListener('click', closeModal);
      document.getElementById('tb-sign-clear').addEventListener('click', clearPad);
      modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });

      var saveBtn = document.getElementById('tb-sign-save');
      saveBtn.addEventListener('click', function () {
        if (!hasInk) { errEl.textContent = 'Draw a signature first.'; errEl.classList.remove('hidden'); return; }
        var data = canvas.toDataURL('image/png');
        saveBtn.disabled = true; saveBtn.textContent = 'Saving…';
        fetch('/toolbox-talks/' + toolboxId + '/attendance/' + crewId + '/sign-off', {
          method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf },
          credentials: 'same-origin', body: JSON.stringify({ signature_data: data, late_arrival: lateEl.checked ? '1' : '' })
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
          .then(function (res) {
            if (!res.ok || !res.body.ok) throw new Error((res.body && res.body.error) || 'Sign-off failed.');
            var row = document.querySelector('#tb-roster tr.tb-row[data-crew-id="' + crewId + '"]');
            if (row) {
              row.setAttribute('data-signed', '1');
              var sigCell = row.querySelector('[data-sig-cell]');
              if (sigCell) { sigCell.innerHTML = '<div class="flex items-center gap-2"><img src="' + data + '" alt="Signature" class="h-9 max-w-[130px] object-contain bg-gray-50 border border-gray-200 rounded"><span class="text-[11px] text-emerald-600 font-semibold whitespace-nowrap">Signed' + (lateEl.checked ? ' · Late' : '') + '</span></div><p class="text-[10px] text-gray-400 mt-0.5">just now</p>'; }
              var actCell = row.querySelector('[data-action-cell]');
              if (actCell) { var rm = actCell.querySelector('.tb-remove-invite'); actCell.innerHTML = ''; if (rm) actCell.appendChild(rm); }
            }
            recount(); closeModal();
          })
          .catch(function (e) { errEl.textContent = e.message; errEl.classList.remove('hidden'); })
          .finally(function () { saveBtn.disabled = false; saveBtn.textContent = 'Save sign-off'; });
      });

      // ── Delegated row actions: Sign here / Send link / Remove ──
      document.addEventListener('click', function (e) {
        var sign = e.target.closest('.tb-sign-here');
        if (sign) { openModal(sign.getAttribute('data-crew-id'), sign.getAttribute('data-name')); return; }
        var send = e.target.closest('.tb-send-link');
        if (send) {
          if (send.disabled) return;
          var crew = send.getAttribute('data-crew-id'); var orig = send.textContent;
          send.disabled = true; send.textContent = 'Sending…';
          fetch('/toolbox-talks/' + toolboxId + '/attendance/' + crew + '/send-link', { method: 'POST', headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrf }, credentials: 'same-origin' })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
            .then(function (res) { if (!res.ok || !res.body.ok) throw new Error((res.body && res.body.error) || 'Send failed.'); send.textContent = 'Sent ✓'; send.classList.add('text-emerald-600'); setTimeout(function () { send.textContent = orig; send.classList.remove('text-emerald-600'); send.disabled = false; }, 2500); })
            .catch(function (e) { alert('Could not send: ' + e.message); send.textContent = orig; send.disabled = false; });
          return;
        }
        var rm = e.target.closest('.tb-remove-invite');
        if (rm) {
          var rcrew = rm.getAttribute('data-crew-id'); var rname = rm.getAttribute('data-name') || 'this worker';
          if (!confirm('Remove ' + rname + " — they weren't here?")) return;
          rm.disabled = true; rm.textContent = 'Removing…';
          fetch('/toolbox-talks/' + toolboxId + '/invitees/' + rcrew + '/remove', { method: 'POST', headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrf }, credentials: 'same-origin' })
            .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, body: j }; }); })
            .then(function (res) { if (!res.ok || !res.body.ok) throw new Error((res.body && res.body.error) || 'Remove failed'); var row = rm.closest('tr'); if (row) row.remove(); recount(); })
            .catch(function (e) { alert('Could not remove: ' + e.message); rm.disabled = false; rm.textContent = 'Remove'; });
          return;
        }
      });

      // ── Email link to everyone unsigned ──
      var emailAll = document.getElementById('att-email-all');
      if (emailAll) {
        emailAll.addEventListener('click', function () {
          var statusEl = document.getElementById('att-email-all-status');
          emailAll.disabled = true; var orig = emailAll.textContent; emailAll.textContent = 'Sending…';
          fetch('/toolbox-talks/' + toolboxId + '/attendance/send-link', { method: 'POST', headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrf }, credentials: 'same-origin' })
            .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
            .then(function (res) {
              if (!res.ok || !res.body.ok) throw new Error((res.body && res.body.error) || 'Send failed.');
              var b = res.body, msg = 'Sent ' + b.sent + ' link' + (b.sent === 1 ? '' : 's') + '.';
              if (b.no_email) msg += ' ' + b.no_email + ' had no email.';
              if (b.already_signed) msg += ' ' + b.already_signed + ' already signed.';
              if (b.failed) msg += ' ' + b.failed + ' failed.';
              if (statusEl) statusEl.textContent = msg;
            })
            .catch(function (e) { if (statusEl) statusEl.textContent = e.message; })
            .finally(function () { emailAll.disabled = false; emailAll.textContent = orig; });
        });
      }

      // ── Add-worker picker (select who's here) ──
      var addRoot = document.querySelector('[data-add-invitee]');
      if (addRoot) {
        var toggle = addRoot.querySelector('[data-add-invitee-toggle]');
        var pop = addRoot.querySelector('[data-add-invitee-pop]');
        var search = addRoot.querySelector('[data-add-invitee-search]');
        var list = addRoot.querySelector('[data-add-invitee-list]');
        var empty = addRoot.querySelector('[data-add-invitee-empty]');
        toggle.addEventListener('click', function () {
          var isOpen = !pop.classList.contains('hidden');
          if (isOpen) { pop.classList.add('hidden'); return; }
          pop.classList.remove('hidden');
          if (search) { search.value = ''; search.focus(); }
          if (list) list.querySelectorAll('[data-add-invitee-crew-id]').forEach(function (b) { if (b.dataset.hidden !== '1') b.classList.remove('hidden'); });
          if (empty) empty.hidden = true;
        });
        document.addEventListener('click', function (e) { if (!addRoot.contains(e.target)) pop.classList.add('hidden'); });
        if (search) search.addEventListener('input', function () {
          var q = search.value.trim().toLowerCase(); var shown = 0;
          list.querySelectorAll('[data-add-invitee-crew-id]').forEach(function (btn) {
            if (btn.dataset.hidden === '1') { btn.classList.add('hidden'); return; }
            var match = !q || (btn.dataset.name || '').includes(q) || (btn.dataset.emp || '').includes(q);
            btn.classList.toggle('hidden', !match); if (match) shown++;
          });
          if (empty) empty.hidden = shown > 0;
        });
        if (list) list.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-add-invitee-crew-id]'); if (!btn) return;
          var crewId = btn.getAttribute('data-add-invitee-crew-id');
          var crewName = btn.getAttribute('data-add-invitee-crew-name');
          var crewEmp = btn.getAttribute('data-add-invitee-crew-emp') || '';
          btn.disabled = true;
          var body = new URLSearchParams({ crew_member_id: crewId, _csrf: csrf });
          fetch('/toolbox-talks/' + toolboxId + '/invitees/add', { method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrf }, credentials: 'same-origin', body: body })
            .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok, body: j }; }); })
            .then(function (res) {
              if (!res.ok || !res.body.ok) throw new Error((res.body && res.body.error) || 'Add failed');
              if (res.body.was_already_invited) { alert(crewName + ' is already listed.'); btn.disabled = false; return; }
              var tbody = document.getElementById('tb-roster');
              var tr = document.createElement('tr');
              tr.className = 'tb-row hover:bg-gray-50/50 align-middle'; tr.dataset.crewId = crewId;
              var actions = hasSession
                ? ('<button type="button" class="tb-sign-here text-xs font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded px-2.5 py-1.5" data-crew-id="' + crewId + '" data-name="' + crewName + '">Sign here</button>' +
                   '<button type="button" class="tb-send-link text-[11px] font-semibold text-gray-600 hover:text-gray-800 hover:underline ml-1" data-crew-id="' + crewId + '" data-name="' + crewName + '">Send link</button>')
                : '';
              tr.innerHTML =
                '<td class="px-3 py-2.5 text-sm font-medium text-gray-900">' + crewName + ' <span class="text-[10px] text-brand-600">· added</span></td>' +
                '<td class="px-2 py-2.5 text-xs text-gray-500">' + (crewEmp || '—') + '</td>' +
                '<td class="px-2 py-2.5" data-sig-cell><span class="text-[11px] text-gray-400">Not signed yet</span></td>' +
                '<td class="px-2 py-2.5 text-right whitespace-nowrap" data-action-cell>' + actions +
                  '<button type="button" class="tb-remove-invite text-[11px] font-semibold text-rose-600 hover:text-rose-700 hover:underline ml-1" data-crew-id="' + crewId + '" data-name="' + crewName + '" title="Remove — not here">Remove</button>' +
                '</td>';
              tbody.appendChild(tr);
              btn.dataset.hidden = '1'; btn.classList.add('hidden'); pop.classList.add('hidden');
              recount();
            })
            .catch(function (e) { alert('Could not add: ' + e.message); btn.disabled = false; });
        });
      }
    })();
  </script>
</div>
