<% locals.currentPage = 'toolbox-talks' %>
<%
  const formAction = isEdit ? '/toolbox-talks/' + toolbox.id : '/toolbox-talks';
%>

<div class="max-w-3xl mx-auto space-y-5">
  <div class="flex items-center gap-2 text-sm text-gray-500">
    <a href="/toolbox-talks" class="hover:text-brand-600">Toolbox Talks</a>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-900"><%= isEdit ? 'Edit' : 'New' %></span>
  </div>
  <h1 class="text-2xl font-bold text-gray-900"><%= isEdit ? 'Edit Toolbox' : 'New Toolbox Talk' %></h1>

  <form method="POST" action="<%= formAction %>" enctype="multipart/form-data" class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-5">
    <%- include('../partials/csrf') %>

    <div>
      <label for="title" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Topic / title <span class="text-rose-500">*</span></label>
      <input type="text" id="title" name="title" required value="<%= isEdit ? (toolbox.title || '') : '' %>"
        placeholder="e.g. Working near live traffic"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="held_at" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Date held <span class="text-rose-500">*</span></label>
        <input type="date" id="held_at" name="held_at" required value="<%= isEdit ? (toolbox.held_at || '') : '' %>"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
      <div>
        <label for="presenter" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Presenter</label>
        <input type="text" id="presenter" name="presenter" value="<%= isEdit ? (toolbox.presenter || '') : '' %>"
          placeholder="e.g. Sam Khalil"
          class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
      </div>
    </div>

    <div>
      <label for="key_points" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Key points</label>
      <textarea id="key_points" name="key_points" rows="8" placeholder="What was covered?"
        class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"><%= isEdit ? (toolbox.key_points || '') : '' %></textarea>
      <p class="text-xs text-gray-400 mt-1">Plain text. Line breaks preserved on the worker side.</p>
    </div>

    <%# Slides + sign-on sheet inputs were retired in favour of the
        Prep documents (read before the meeting) and Documents
        (post-attendance materials) sections further down the form —
        both support multi-file upload and have clearer audience
        semantics. Existing slides_path / signon_path data on legacy
        toolboxes still serves through the original download routes;
        admins just can't upload new ones here. %>
    <% if (isEdit && (toolbox.slides_path || toolbox.signon_path)) { %>
      <div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-xs text-gray-600 space-y-1">
        <p class="font-semibold text-gray-700">Legacy files on this toolbox</p>
        <% if (toolbox.slides_path) { %>
          <p>Slides: <a href="/toolbox-talks/<%= toolbox.id %>/slides" class="text-brand-700 hover:underline"><%= toolbox.slides_original_name %></a> <span class="text-gray-400">— use the Prep documents section for new uploads.</span></p>
        <% } %>
        <% if (toolbox.signon_path) { %>
          <p>Sign-on sheet: <a href="/toolbox-talks/<%= toolbox.id %>/signon" class="text-brand-700 hover:underline"><%= toolbox.signon_original_name %></a></p>
        <% } %>
      </div>
    <% } %>

    <%
      var _selectableCrew = (typeof selectableCrew !== 'undefined' && selectableCrew) || [];
      var _inviteeSet = {};
      (typeof inviteeIds !== 'undefined' && inviteeIds ? inviteeIds : []).forEach(function (id) { _inviteeSet[id] = true; });
      var _hasInvitees = Object.keys(_inviteeSet).length > 0;
    %>
    <div>
      <div class="flex items-center justify-between gap-3 flex-wrap mb-2">
        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest">Invite which workers? <span class="text-gray-300 normal-case font-medium tracking-normal">(leave empty to invite everyone)</span></label>
        <div class="flex items-center gap-2 text-xs">
          <input type="text" id="inv-filter" placeholder="Filter by name..." oninput="invFilter(this.value)"
                 class="px-2 py-1 border border-gray-300 rounded-md text-xs">
          <button type="button" onclick="invToggleAll(true)" class="px-2 py-1 bg-gray-100 hover:bg-gray-200 rounded-md text-xs font-semibold">Select all</button>
          <button type="button" onclick="invToggleAll(false)" class="px-2 py-1 bg-gray-100 hover:bg-gray-200 rounded-md text-xs font-semibold">Clear</button>
        </div>
      </div>
      <%# Hidden marker tells the update handler the picker was on this
          submission (vs. being absent from a non-form-supporting client),
          so an empty invitee_ids list correctly clears the list. %>
      <input type="hidden" name="invitees_submitted" value="1">
      <div id="inv-list" class="max-h-64 overflow-y-auto border border-gray-200 rounded-lg bg-gray-50 divide-y divide-gray-100">
        <% if (_selectableCrew.length === 0) { %>
          <p class="p-4 text-sm text-gray-500 text-center">No active workers found.</p>
        <% } %>
        <% _selectableCrew.forEach(function (c) { %>
          <label class="inv-row flex items-center gap-3 px-3 py-2 hover:bg-white cursor-pointer" data-name="<%= (c.full_name || '').toLowerCase() %>">
            <input type="checkbox" name="invitee_ids" value="<%= c.id %>" <%= _inviteeSet[c.id] ? 'checked' : '' %>
                   class="w-4 h-4 text-brand-600 rounded">
            <span class="text-sm font-medium text-gray-800 flex-1"><%= c.full_name %></span>
            <% if (c.employee_id) { %><span class="text-xs text-gray-400 font-mono"><%= c.employee_id %></span><% } %>
          </label>
        <% }); %>
      </div>
      <p class="text-xs text-gray-400 mt-1">
        <span id="inv-count"><%= Object.keys(_inviteeSet).length %></span> invited.
        <%= _hasInvitees ? 'Only ticked workers see this meeting on their profile / portal and on the public attendance link.' : 'Empty list = open to every active worker.' %>
      </p>
    </div>

    <script>
      function invToggleAll(checked) {
        document.querySelectorAll('#inv-list .inv-row').forEach(function (row) {
          if (row.style.display === 'none') return;
          var cb = row.querySelector('input[type="checkbox"]');
          if (cb) cb.checked = !!checked;
        });
        invUpdateCount();
      }
      function invFilter(q) {
        q = (q || '').toLowerCase().trim();
        document.querySelectorAll('#inv-list .inv-row').forEach(function (row) {
          var n = row.getAttribute('data-name') || '';
          row.style.display = (!q || n.indexOf(q) !== -1) ? '' : 'none';
        });
      }
      function invUpdateCount() {
        var n = document.querySelectorAll('#inv-list input[type="checkbox"]:checked').length;
        var el = document.getElementById('inv-count');
        if (el) el.textContent = n;
      }
      document.querySelectorAll('#inv-list input[type="checkbox"]').forEach(function (cb) {
        cb.addEventListener('change', invUpdateCount);
      });
    </script>

    <div>
      <label for="photos" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Photos (gallery)</label>
      <input type="file" id="photos" name="photos" accept="image/*" multiple
        class="block w-full text-sm text-gray-700 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
      <p class="text-xs text-gray-400 mt-1">Up to 12 at a time. Editing appends to the gallery.</p>
      <% if (isEdit && photos.length) { %>
        <div class="mt-3 grid grid-cols-3 sm:grid-cols-4 gap-2">
          <% photos.forEach(p => { %>
            <div class="relative group">
              <img src="/toolbox-talks/<%= toolbox.id %>/photos/<%= p.id %>" alt="" class="w-full h-24 object-cover rounded border border-gray-200">
              <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/photos/<%= p.id %>/delete" class="absolute top-1 right-1 opacity-0 group-hover:opacity-100 transition-opacity">
                <%- include('../partials/csrf') %>
                <button type="submit" class="w-6 h-6 rounded-full bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold flex items-center justify-center" title="Remove">×</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div>
      <label for="prep_documents" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Prep documents (read before the meeting)</label>
      <input type="file" id="prep_documents" name="prep_documents" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png" multiple
        class="block w-full text-sm text-gray-700 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100">
      <p class="text-xs text-gray-400 mt-1">Workers see these on the toolbox detail page <strong>before the meeting</strong> so they can review beforehand. PDFs, docs, slides, spreadsheets, images. Up to 12 at a time; editing appends.</p>
      <% if (isEdit && typeof prepDocuments !== 'undefined' && prepDocuments && prepDocuments.length) { %>
        <ul class="mt-3 divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
          <% prepDocuments.forEach(d => { %>
            <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
              <a href="/toolbox-talks/<%= toolbox.id %>/prep/<%= d.id %>" class="flex-1 truncate text-amber-700 hover:underline">
                📋 <%= d.file_original_name || ('Prep doc #' + d.id) %>
              </a>
              <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/prep/<%= d.id %>/delete" onsubmit="return confirm('Remove this prep document? Workers who haven\'t downloaded it won\'t be able to.');">
                <%- include('../partials/csrf') %>
                <button type="submit" class="text-[11px] font-semibold text-rose-600 hover:text-rose-700 hover:underline">Remove</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div>
      <label for="documents" class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Documents (post-attendance materials)</label>
      <input type="file" id="documents" name="documents" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png" multiple
        class="block w-full text-sm text-gray-700 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100">
      <p class="text-xs text-gray-400 mt-1">Workers can download these from the toolbox detail page <strong>only after they've signed off attendance</strong>. PDFs, docs, slides, spreadsheets, images. Up to 12 at a time; editing appends.</p>
      <% if (isEdit && documents && documents.length) { %>
        <ul class="mt-3 divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
          <% documents.forEach(d => { %>
            <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
              <a href="/toolbox-talks/<%= toolbox.id %>/documents/<%= d.id %>" class="flex-1 truncate text-brand-700 hover:underline">
                📄 <%= d.file_original_name || ('Document #' + d.id) %>
              </a>
              <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/documents/<%= d.id %>/delete" onsubmit="return confirm('Remove this document? Workers who haven\'t downloaded it yet won\'t be able to.');">
                <%- include('../partials/csrf') %>
                <button type="submit" class="text-[11px] font-semibold text-rose-600 hover:text-rose-700 hover:underline">Remove</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="flex items-center justify-between gap-2 pt-3 border-t border-gray-100">
      <a href="/toolbox-talks<%= isEdit ? '/' + toolbox.id : '' %>" class="text-sm text-gray-500 hover:text-gray-700">Cancel</a>
      <div class="flex items-center gap-2">
        <% if (!isEdit) { %>
          <button type="submit" name="action" value="draft" class="px-4 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Save draft</button>
          <button type="submit" name="action" value="publish" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Save & publish</button>
        <% } else { %>
          <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Save changes</button>
        <% } %>
      </div>
    </div>
  </form>
</div>
