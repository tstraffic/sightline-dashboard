<% locals.currentPage = 'toolbox-talks' %>
<%
  function fmtDate(s) {
    if (!s) return '—';
    return new Date(s).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
%>

<div class="max-w-6xl mx-auto space-y-5">
  <%- include('../partials/page-header', { rail: true, wrapperClass: '',
    eyebrow: 'Safety',
    title: 'Toolbox Talks',
    subtitle: 'Archive of every toolbox we\'ve run. Published talks land in every worker\'s portal.',
    actions: [{ label: 'New toolbox', href: '/toolbox-talks/new', style: 'primary', icon: 'M12 6v12m6-6H6' }]
  }) %>

  <!-- Status tabs -->
  <div class="border-b border-gray-200 flex items-center gap-1">
    <% ['published','draft','archived'].forEach(s => { %>
      <a href="/toolbox-talks?status=<%= s %>" class="px-4 py-2 -mb-px border-b-2 text-sm font-semibold <%= status === s ? 'border-brand-600 text-brand-700' : 'border-transparent text-gray-500 hover:text-gray-700' %>">
        <%= statusLabels[s] %>
        <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full <%= status === s ? 'bg-brand-50 text-brand-700' : 'bg-gray-100 text-gray-500' %>"><%= counts[s] || 0 %></span>
      </a>
    <% }) %>
  </div>

  <% if (!rows.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm px-5 py-10 text-center text-sm text-gray-500">
      No <%= statusLabels[status].toLowerCase() %> toolbox talks yet.
    </div>
  <% } else { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-3 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Topic</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Held</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Presenter</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Attendance</th>
            <th class="px-2 py-2 text-left text-[10px] font-bold text-gray-500 uppercase tracking-widest">Caught up</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% rows.forEach(r => { %>
            <tr class="hover:bg-gray-50/50">
              <td class="px-3 py-2">
                <a href="/toolbox-talks/<%= r.id %>" class="font-semibold text-gray-900 hover:text-brand-600"><%= r.title %></a>
              </td>
              <td class="px-2 py-2 text-xs text-gray-600 tabular-nums"><%= fmtDate(r.held_at) %></td>
              <td class="px-2 py-2 text-xs text-gray-600"><%= r.presenter || '—' %></td>
              <td class="px-2 py-2 text-xs text-gray-600 tabular-nums">
                <%= (r.attended_count || 0) + (r.caught_count || 0) %><%
                  if (r.invitee_count > 0) { %><span class="text-gray-400">/<%= r.invitee_count %></span><% }
                %>
              </td>
              <td class="px-2 py-2 text-xs text-gray-600"><%= r.caught_count || 0 %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
