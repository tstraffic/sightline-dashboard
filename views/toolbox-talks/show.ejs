<% locals.currentPage = 'toolbox-talks' %>
<%
  const STATUS_BADGE = {
    draft: 'bg-amber-50 text-amber-700 ring-amber-200',
    published: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
    archived: 'bg-gray-50 text-gray-600 ring-gray-200',
  };
  function fmtDate(s) {
    if (!s) return '—';
    return new Date(s).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  const total = summary.total_crew || 0;
  const attended = summary.attended || 0;
  const caughtUp = summary.caught_up || 0;
  const covered = attended + caughtUp;
  const pct = total > 0 ? Math.round((covered / total) * 100) : 0;
%>

<div class="max-w-4xl mx-auto space-y-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <a href="/toolbox-talks" class="text-sm text-brand-600 hover:underline">← Toolbox Talks</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1 flex items-center gap-2 flex-wrap">
        <%= toolbox.title %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= STATUS_BADGE[toolbox.status] %>"><%= statusLabels[toolbox.status] %></span>
      </h1>
      <p class="text-sm text-gray-500 mt-1"><%= fmtDate(toolbox.held_at) %><% if (toolbox.presenter) { %> · Presented by <%= toolbox.presenter %><% } %></p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/toolbox-talks/<%= toolbox.id %>/edit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Edit</a>
      <% if (toolbox.status === 'draft') { %>
        <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/publish" class="inline">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-3 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Publish</button>
        </form>
      <% } %>
      <% if (toolbox.status !== 'archived') { %>
        <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/archive" class="inline" onsubmit="return confirm('Archive this toolbox?')">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Archive</button>
        </form>
      <% } %>
      <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/delete" class="inline" onsubmit="return confirm('Delete this toolbox? This cannot be undone.')">
        <%- include('../partials/csrf') %>
        <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-red-50 hover:border-red-300 hover:text-red-600 text-gray-700 text-sm font-semibold rounded-lg">Delete</button>
      </form>
    </div>
  </div>

  <!-- Tabs -->
  <div class="border-b border-gray-200 flex items-center gap-1">
    <span class="px-4 py-2 -mb-px border-b-2 border-brand-600 text-brand-700 text-sm font-semibold">Details</span>
    <a href="/toolbox-talks/<%= toolbox.id %>/attendance" class="px-4 py-2 -mb-px border-b-2 border-transparent text-gray-500 hover:text-gray-700 text-sm font-semibold">
      Attendance
      <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-gray-100 text-gray-600"><%= covered %>/<%= total %></span>
    </a>
  </div>

  <!-- Attendance summary -->
  <% if (toolbox.status === 'published') { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Coverage</p>
      <p class="text-2xl font-bold text-gray-900"><%= covered %> <span class="text-gray-400 font-normal text-base">of <%= total %> · <%= pct %>%</span></p>
      <p class="text-xs text-gray-500 mt-1"><%= attended %> attended · <%= caughtUp %> caught up</p>
      <div class="w-full h-2 bg-gray-100 rounded-full mt-2">
        <div class="h-2 bg-emerald-500 rounded-full" style="width: <%= pct %>%"></div>
      </div>
    </div>
  <% } %>

  <% if (toolbox.key_points) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Key points</p>
      <p class="text-sm text-gray-800 whitespace-pre-line leading-relaxed"><%= toolbox.key_points %></p>
    </div>
  <% } %>

  <% if (toolbox.slides_path || toolbox.signon_path) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-3">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Attachments</p>
      <% if (toolbox.slides_path) { %>
        <a href="/toolbox-talks/<%= toolbox.id %>/slides" class="inline-flex items-center gap-2 px-3 py-2 bg-brand-50 hover:bg-brand-100 text-brand-700 text-sm font-semibold rounded-lg ring-1 ring-brand-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m-7 7h8a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v13a2 2 0 002 2z"/></svg>
          Slides: <%= toolbox.slides_original_name %>
        </a>
      <% } %>
      <% if (toolbox.signon_path) { %>
        <div>
          <a href="/toolbox-talks/<%= toolbox.id %>/signon" class="inline-flex items-center gap-2 px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-lg ring-1 ring-gray-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2a4 4 0 014-4h7m0 0l-3-3m3 3l-3 3M5 5l14 14"/></svg>
            Sign-on sheet (admin only): <%= toolbox.signon_original_name %>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (photos.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Photos</p>
      <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
        <% photos.forEach(p => { %>
          <a href="/toolbox-talks/<%= toolbox.id %>/photos/<%= p.id %>" target="_blank">
            <img src="/toolbox-talks/<%= toolbox.id %>/photos/<%= p.id %>" alt="" class="w-full h-24 object-cover rounded border border-gray-200 hover:border-brand-400 transition">
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>
