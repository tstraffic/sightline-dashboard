<% locals.currentPage = 'toolbox-talks' %>
<%
  const STATUS_BADGE = {
    draft: 'bg-amber-50 text-amber-700 ring-amber-200',
    published: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
    archived: 'bg-gray-50 text-gray-600 ring-gray-200',
  };
  function fmtDate(s) {
    if (!s) return '—';
    return new Date(s).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  const total = summary.total_crew || 0;
  const attended = summary.attended || 0;
  const caughtUp = summary.caught_up || 0;
  const covered = attended + caughtUp;
  const pct = total > 0 ? Math.round((covered / total) * 100) : 0;
%>

<div class="max-w-4xl mx-auto space-y-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <a href="/toolbox-talks" class="text-sm text-brand-600 hover:underline">← Toolbox Talks</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1 flex items-center gap-2 flex-wrap">
        <%= toolbox.title %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= STATUS_BADGE[toolbox.status] %>"><%= statusLabels[toolbox.status] %></span>
      </h1>
      <p class="text-sm text-gray-500 mt-1"><%= fmtDate(toolbox.held_at) %><% if (toolbox.presenter) { %> · Presented by <%= toolbox.presenter %><% } %></p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/toolbox-talks/<%= toolbox.id %>/edit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Edit</a>
      <% if (toolbox.status === 'draft') { %>
        <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/publish" class="inline">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-3 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Publish</button>
        </form>
      <% } %>
      <% if (toolbox.status !== 'archived') { %>
        <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/archive" class="inline" onsubmit="return confirm('Archive this toolbox?')">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Archive</button>
        </form>
      <% } %>
      <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/delete" class="inline" onsubmit="return confirm('Delete this toolbox? This cannot be undone.')">
        <%- include('../partials/csrf') %>
        <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-red-50 hover:border-red-300 hover:text-red-600 text-gray-700 text-sm font-semibold rounded-lg">Delete</button>
      </form>
    </div>
  </div>

  <!-- Tabs -->
  <div class="border-b border-gray-200 flex items-center gap-1">
    <span class="px-4 py-2 -mb-px border-b-2 border-brand-600 text-brand-700 text-sm font-semibold">Details</span>
    <a href="/toolbox-talks/<%= toolbox.id %>/attendance" class="px-4 py-2 -mb-px border-b-2 border-transparent text-gray-500 hover:text-gray-700 text-sm font-semibold">
      Attendance
      <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-gray-100 text-gray-600"><%= covered %>/<%= total %></span>
    </a>
  </div>

  <!-- Attendance summary -->
  <% if (toolbox.status === 'published') { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Coverage</p>
      <p class="text-2xl font-bold text-gray-900"><%= covered %> <span class="text-gray-400 font-normal text-base">of <%= total %> · <%= pct %>%</span></p>
      <p class="text-xs text-gray-500 mt-1">
        <%= attended %> attended · <%= caughtUp %> caught up
        <% if (summary.absent) { %> · <span class="text-rose-600 font-semibold"><%= summary.absent %> can't attend</span><% } %>
      </p>
      <div class="w-full h-2 bg-gray-100 rounded-full mt-2">
        <div class="h-2 bg-emerald-500 rounded-full" style="width: <%= pct %>%"></div>
      </div>
    </div>

    <%# Public attendance link — workers visit, pick name, mark
        attended/absent. Copy button + regenerate option. %>
    <% if (typeof attendanceUrl !== 'undefined' && attendanceUrl) { %>
      <div class="bg-gradient-to-br from-brand-50 to-emerald-50 border border-brand-200 rounded-xl shadow-sm p-5">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <p class="text-[10px] font-bold text-brand-700 uppercase tracking-widest mb-1">Attendance link · share with the crew</p>
            <p class="text-sm text-gray-700">Workers click, pick their name, and confirm attendance (or say why they can't). No login required.</p>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <a href="<%= attendanceUrl %>" target="_blank" class="inline-flex items-center gap-1 px-3 py-2 text-xs font-semibold text-brand-700 bg-white border border-brand-200 hover:bg-brand-50 rounded-md">Preview</a>
            <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/attendance-session/regenerate" class="inline" onsubmit="return confirm('Generate a new link? The old one will stop working.');">
              <%- include('../partials/csrf') %>
              <button type="submit" class="inline-flex items-center gap-1 px-3 py-2 text-xs font-semibold text-amber-700 bg-white border border-amber-200 hover:bg-amber-50 rounded-md">Regenerate</button>
            </form>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <input id="att-link" type="text" value="<%= attendanceUrl %>" readonly onclick="this.select()" class="flex-1 px-3 py-2 text-sm bg-white border border-gray-200 rounded-lg text-gray-800 font-mono">
          <button type="button" onclick="(function(){var i=document.getElementById('att-link');navigator.clipboard.writeText(i.value).then(function(){var b=event.target;var t=b.textContent;b.textContent='Copied!';setTimeout(function(){b.textContent=t;},1500);});})()" class="inline-flex items-center gap-1 px-3 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
            Copy
          </button>
        </div>
      </div>
    <% } %>

    <%# Invitees — surface the scope so the admin can see at a glance
        who's expected. Empty list = open to all active workers. %>
    <% if (typeof invitees !== 'undefined' && invitees.length > 0) { %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-2">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Invited (<%= invitees.length %>)</p>
          <a href="/toolbox-talks/<%= toolbox.id %>/edit" class="text-xs font-semibold text-brand-700 hover:text-brand-900">Change list</a>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <% invitees.forEach(function (i) { %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 text-[11px] font-medium border border-brand-100"><%= i.full_name %></span>
          <% }); %>
        </div>
      </div>
    <% } else if (toolbox.status === 'published') { %>
      <div class="bg-white border border-dashed border-gray-200 rounded-xl shadow-sm p-4 text-center">
        <p class="text-xs text-gray-500">Open to every active worker. <a href="/toolbox-talks/<%= toolbox.id %>/edit" class="text-brand-700 hover:text-brand-900 font-semibold">Limit to specific people</a></p>
      </div>
    <% } %>

    <%# Absences with reasons — surfaces who said they can't attend so
        the office can follow up before scheduling the catch-up session. %>
    <% if (typeof absences !== 'undefined' && absences.length > 0) { %>
      <div class="bg-white border border-rose-200 rounded-xl shadow-sm p-5">
        <p class="text-[10px] font-bold text-rose-700 uppercase tracking-widest mb-2">Couldn't attend (<%= absences.length %>)</p>
        <ul class="divide-y divide-gray-100">
          <% absences.forEach(function (a) { %>
            <li class="py-2.5 flex items-start gap-3">
              <div class="flex-1">
                <p class="text-sm font-semibold text-gray-900"><%= a.full_name %><% if (a.employee_id) { %><span class="text-gray-400 text-xs font-normal ml-1.5"><%= a.employee_id %></span><% } %></p>
                <% if (a.absence_reason) { %>
                  <p class="text-xs text-gray-600 mt-0.5"><%= a.absence_reason %></p>
                <% } %>
              </div>
              <span class="text-[11px] text-gray-400 whitespace-nowrap">
                <%= a.recorded_at ? new Date(a.recorded_at).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' }) : '' %>
              </span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>
  <% } %>

  <% if (toolbox.key_points) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Key points</p>
      <p class="text-sm text-gray-800 whitespace-pre-line leading-relaxed"><%= toolbox.key_points %></p>
    </div>
  <% } %>

  <% if (toolbox.slides_path || toolbox.signon_path) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-3">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Attachments</p>
      <% if (toolbox.slides_path) { %>
        <a href="/toolbox-talks/<%= toolbox.id %>/slides" class="inline-flex items-center gap-2 px-3 py-2 bg-brand-50 hover:bg-brand-100 text-brand-700 text-sm font-semibold rounded-lg ring-1 ring-brand-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m-7 7h8a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v13a2 2 0 002 2z"/></svg>
          Slides: <%= toolbox.slides_original_name %>
        </a>
      <% } %>
      <% if (toolbox.signon_path) { %>
        <div>
          <a href="/toolbox-talks/<%= toolbox.id %>/signon" class="inline-flex items-center gap-2 px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-lg ring-1 ring-gray-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2a4 4 0 014-4h7m0 0l-3-3m3 3l-3 3M5 5l14 14"/></svg>
            Sign-on sheet (admin only): <%= toolbox.signon_original_name %>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (photos.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Photos</p>
      <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
        <% photos.forEach(p => { %>
          <a href="/toolbox-talks/<%= toolbox.id %>/photos/<%= p.id %>" target="_blank">
            <img src="/toolbox-talks/<%= toolbox.id %>/photos/<%= p.id %>" alt="" class="w-full h-24 object-cover rounded border border-gray-200 hover:border-brand-400 transition">
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (typeof prepDocuments !== 'undefined' && prepDocuments && prepDocuments.length) { %>
    <div class="bg-white border border-amber-200 rounded-xl shadow-sm p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <p class="text-[10px] font-bold text-amber-700 uppercase tracking-widest">Prep documents</p>
          <p class="text-xs text-gray-500 mt-0.5">Workers can review these <strong>before</strong> the meeting — visible to every invited crew member regardless of sign-off.</p>
        </div>
        <a href="/toolbox-talks/<%= toolbox.id %>/edit#prep_documents" class="text-xs font-semibold text-amber-700 hover:underline">Manage ›</a>
      </div>
      <ul class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
        <% prepDocuments.forEach(d => { %>
          <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
            <a href="/toolbox-talks/<%= toolbox.id %>/prep/<%= d.id %>" class="flex-1 truncate text-amber-700 hover:underline">
              📋 <%= d.file_original_name || ('Prep doc #' + d.id) %>
            </a>
            <span class="text-[11px] text-gray-400 tabular-nums whitespace-nowrap"><%= new Date(d.uploaded_at).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short' }) %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (typeof documents !== 'undefined' && documents && documents.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Documents</p>
          <p class="text-xs text-gray-500 mt-0.5">Workers can download these once they've signed off attendance.</p>
        </div>
        <a href="/toolbox-talks/<%= toolbox.id %>/edit#documents" class="text-xs font-semibold text-brand-700 hover:underline">Manage ›</a>
      </div>
      <ul class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
        <% documents.forEach(d => { %>
          <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
            <a href="/toolbox-talks/<%= toolbox.id %>/documents/<%= d.id %>" class="flex-1 truncate text-brand-700 hover:underline">
              📄 <%= d.file_original_name || ('Document #' + d.id) %>
            </a>
            <span class="text-[11px] text-gray-400 tabular-nums whitespace-nowrap"><%= new Date(d.uploaded_at).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short' }) %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>
</div>
