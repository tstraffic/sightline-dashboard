<% locals.currentPage = 'toolbox-talks' %>
<%
  const STATUS_BADGE = {
    draft: 'bg-amber-50 text-amber-700 ring-amber-200',
    published: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
    archived: 'bg-gray-50 text-gray-600 ring-gray-200',
  };
  function fmtDate(s) {
    if (!s) return '—';
    return new Date(s).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  const total = summary.total_crew || 0;
  const attended = summary.attended || 0;
  const caughtUp = summary.caught_up || 0;
  const covered = attended + caughtUp;
  const pct = total > 0 ? Math.round((covered / total) * 100) : 0;
  const isLocked = (typeof locked !== 'undefined') ? locked : !!toolbox.presenter_signed_at;
  const ttLabels = (typeof talkTypeLabels !== 'undefined' && talkTypeLabels) || {};
  const talkTypeLabel = toolbox.talk_type
    ? (toolbox.talk_type === 'other' && toolbox.talk_type_other ? 'Other — ' + toolbox.talk_type_other : (ttLabels[toolbox.talk_type] || toolbox.talk_type))
    : '';
  const jobLabel = toolbox.job_number ? (toolbox.job_number + (toolbox.job_name ? ' — ' + toolbox.job_name : '')) : '';
%>

<div class="max-w-4xl mx-auto space-y-5">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <a href="/toolbox-talks" class="text-sm text-brand-600 hover:underline">← Toolbox Talks</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1 flex items-center gap-2 flex-wrap">
        <%= toolbox.title %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset <%= STATUS_BADGE[toolbox.status] %>"><%= statusLabels[toolbox.status] %></span>
        <% if (isLocked) { %>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold ring-1 ring-inset bg-emerald-50 text-emerald-700 ring-emerald-200">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Signed off · TBX-<%= toolbox.id %>
          </span>
        <% } %>
      </h1>
      <p class="text-sm text-gray-500 mt-1"><%= fmtDate(toolbox.held_at) %><% if (toolbox.talk_time) { %> · <%= toolbox.talk_time %><% } %><% if (toolbox.presenter) { %> · Presented by <%= toolbox.presenter %><% } %></p>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <a href="/toolbox-talks/<%= toolbox.id %>/record.pdf" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg inline-flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m-7 7h8a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v13a2 2 0 002 2z"/></svg>
        FRM-005 PDF
      </a>
      <% if (!isLocked) { %>
        <a href="/toolbox-talks/<%= toolbox.id %>/edit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Edit</a>
        <% if (toolbox.status === 'draft') { %>
          <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/publish" class="inline">
            <%- include('../partials/csrf') %>
            <button type="submit" class="px-3 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg">Publish</button>
          </form>
        <% } %>
      <% } %>
      <% if (toolbox.status !== 'archived') { %>
        <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/archive" class="inline" onsubmit="return confirm('Archive this toolbox?')">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg">Archive</button>
        </form>
      <% } %>
      <% if (!isLocked) { %>
        <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/delete" class="inline" onsubmit="return confirm('Delete this toolbox? This cannot be undone.')">
          <%- include('../partials/csrf') %>
          <button type="submit" class="px-3 py-2 bg-white border border-gray-300 hover:bg-red-50 hover:border-red-300 hover:text-red-600 text-gray-700 text-sm font-semibold rounded-lg">Delete</button>
        </form>
      <% } %>
    </div>
  </div>

  <% if (isLocked) { %>
    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex items-start gap-3">
      <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <div class="text-sm text-emerald-900">
        <p class="font-semibold">Record signed off and locked<% if (toolbox.presenter_signed_by_name) { %> by <%= toolbox.presenter_signed_by_name %><% } %> — <%= fmt(toolbox.presenter_signed_at) %></p>
        <p class="text-emerald-800 text-xs mt-0.5">Atomis Record ID <strong>TBX-<%= toolbox.id %></strong>. Per TS-SAF-WI-003 the record can no longer be edited or deleted — if information was wrong, add a supplementary note below.</p>
      </div>
    </div>
  <% } %>

  <!-- Tabs -->
  <div class="border-b border-gray-200 flex items-center gap-1">
    <span class="px-4 py-2 -mb-px border-b-2 border-brand-600 text-brand-700 text-sm font-semibold">Details</span>
    <a href="/toolbox-talks/<%= toolbox.id %>/attendance" class="px-4 py-2 -mb-px border-b-2 border-transparent text-gray-500 hover:text-gray-700 text-sm font-semibold">
      Attendance
      <span class="ml-1 px-1.5 py-0.5 text-[10px] rounded-full bg-gray-100 text-gray-600"><%= covered %>/<%= total %></span>
    </a>
  </div>

  <!-- Attendance summary -->
  <% if (toolbox.status === 'published') { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Coverage</p>
      <p class="text-2xl font-bold text-gray-900"><%= covered %> <span class="text-gray-400 font-normal text-base">of <%= total %> · <%= pct %>%</span></p>
      <p class="text-xs text-gray-500 mt-1">
        <%= attended %> attended · <%= caughtUp %> caught up
        <% if (summary.absent) { %> · <span class="text-rose-600 font-semibold"><%= summary.absent %> can't attend</span><% } %>
      </p>
      <div class="w-full h-2 bg-gray-100 rounded-full mt-2">
        <div class="h-2 bg-emerald-500 rounded-full" style="width: <%= pct %>%"></div>
      </div>
    </div>

    <%# Public attendance link — workers visit, pick name, mark
        attended/absent. Copy button + regenerate option. %>
    <% if (typeof attendanceUrl !== 'undefined' && attendanceUrl) { %>
      <div class="bg-gradient-to-br from-brand-50 to-emerald-50 border border-brand-200 rounded-xl shadow-sm p-5">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <p class="text-[10px] font-bold text-brand-700 uppercase tracking-widest mb-1">Attendance link · share with the crew</p>
            <p class="text-sm text-gray-700">Workers click, pick their name, and confirm attendance (or say why they can't). No login required.</p>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <a href="<%= attendanceUrl %>" target="_blank" class="inline-flex items-center gap-1 px-3 py-2 text-xs font-semibold text-brand-700 bg-white border border-brand-200 hover:bg-brand-50 rounded-md">Preview</a>
            <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/attendance-session/regenerate" class="inline" onsubmit="return confirm('Generate a new link? The old one will stop working.');">
              <%- include('../partials/csrf') %>
              <button type="submit" class="inline-flex items-center gap-1 px-3 py-2 text-xs font-semibold text-amber-700 bg-white border border-amber-200 hover:bg-amber-50 rounded-md">Regenerate</button>
            </form>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-2">
          <input id="att-link" type="text" value="<%= attendanceUrl %>" readonly onclick="this.select()" class="flex-1 px-3 py-2 text-sm bg-white border border-gray-200 rounded-lg text-gray-800 font-mono">
          <button type="button" onclick="(function(){var i=document.getElementById('att-link');navigator.clipboard.writeText(i.value).then(function(){var b=event.target;var t=b.textContent;b.textContent='Copied!';setTimeout(function(){b.textContent=t;},1500);});})()" class="inline-flex items-center gap-1 px-3 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
            Copy
          </button>
        </div>
      </div>
    <% } %>

    <%# Invitees — surface the scope so the admin can see at a glance
        who's expected. Empty list = open to all active workers. %>
    <% if (typeof invitees !== 'undefined' && invitees.length > 0) { %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-2">
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Invited (<%= invitees.length %>)</p>
          <a href="/toolbox-talks/<%= toolbox.id %>/edit" class="text-xs font-semibold text-brand-700 hover:text-brand-900">Change list</a>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <% invitees.forEach(function (i) { %>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 text-[11px] font-medium border border-brand-100"><%= i.full_name %></span>
          <% }); %>
        </div>
      </div>
    <% } else if (toolbox.status === 'published') { %>
      <div class="bg-white border border-dashed border-gray-200 rounded-xl shadow-sm p-4 text-center">
        <p class="text-xs text-gray-500">Open to every active worker. <a href="/toolbox-talks/<%= toolbox.id %>/edit" class="text-brand-700 hover:text-brand-900 font-semibold">Limit to specific people</a></p>
      </div>
    <% } %>

    <%# Absences with reasons — surfaces who said they can't attend so
        the office can follow up before scheduling the catch-up session. %>
    <% if (typeof absences !== 'undefined' && absences.length > 0) { %>
      <div class="bg-white border border-rose-200 rounded-xl shadow-sm p-5">
        <p class="text-[10px] font-bold text-rose-700 uppercase tracking-widest mb-2">Couldn't attend (<%= absences.length %>)</p>
        <ul class="divide-y divide-gray-100">
          <% absences.forEach(function (a) { %>
            <li class="py-2.5 flex items-start gap-3">
              <div class="flex-1">
                <p class="text-sm font-semibold text-gray-900"><%= a.full_name %><% if (a.employee_id) { %><span class="text-gray-400 text-xs font-normal ml-1.5"><%= a.employee_id %></span><% } %></p>
                <% if (a.absence_reason) { %>
                  <p class="text-xs text-gray-600 mt-0.5"><%= a.absence_reason %></p>
                <% } %>
              </div>
              <span class="text-[11px] text-gray-400 whitespace-nowrap">
                <%= a.recorded_at ? new Date(a.recorded_at).toLocaleDateString('en-AU', { day: 'numeric', month: 'short' }) : '' %>
              </span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>
  <% } %>

  <%# FRM-005 section 1 — Talk Details %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-3">Talk details</p>
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-3 text-sm">
      <div><dt class="text-xs text-gray-400">Date</dt><dd class="font-semibold text-gray-900"><%= fmtDate(toolbox.held_at) %></dd></div>
      <div><dt class="text-xs text-gray-400">Time</dt><dd class="font-semibold text-gray-900"><%= toolbox.talk_time || '—' %></dd></div>
      <div><dt class="text-xs text-gray-400">Duration</dt><dd class="font-semibold text-gray-900"><%= toolbox.duration_mins ? toolbox.duration_mins + ' mins' : '—' %></dd></div>
      <div><dt class="text-xs text-gray-400">Talk type</dt><dd class="font-semibold text-gray-900"><%= talkTypeLabel || '—' %></dd></div>
      <div class="col-span-2"><dt class="text-xs text-gray-400">Site / location</dt><dd class="font-semibold text-gray-900"><%= toolbox.site_location || '—' %></dd></div>
      <div class="col-span-2">
        <dt class="text-xs text-gray-400">Job / project</dt>
        <dd class="font-semibold text-gray-900">
          <% if (toolbox.job_id && jobLabel) { %>
            <a href="/jobs/<%= toolbox.job_id %>" class="text-brand-700 hover:underline"><%= jobLabel %></a>
          <% } else { %>—<% } %>
        </dd>
      </div>
      <div class="col-span-2"><dt class="text-xs text-gray-400">Presenter</dt><dd class="font-semibold text-gray-900"><%= toolbox.presenter || '—' %></dd></div>
      <div class="col-span-2"><dt class="text-xs text-gray-400">Topic reference (SOP / WI / incident)</dt><dd class="font-semibold text-gray-900"><%= toolbox.topic_reference || '—' %></dd></div>
    </dl>
  </div>

  <% if (toolbox.key_points) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Key points</p>
      <p class="text-sm text-gray-800 whitespace-pre-line leading-relaxed"><%= toolbox.key_points %></p>
    </div>
  <% } %>

  <%# FRM-005 section 4 — Questions / Discussion / Worker Input %>
  <% if (toolbox.discussion_notes) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Questions / discussion / worker input</p>
      <p class="text-sm text-gray-800 whitespace-pre-line leading-relaxed"><%= toolbox.discussion_notes %></p>
    </div>
  <% } %>

  <%# FRM-005 section 5 — Actions Raised %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
    <div class="flex items-center justify-between gap-3 mb-2">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Actions raised<% if (actions.length) { %> (<%= actions.length %>)<% } %></p>
    </div>
    <p class="text-xs text-gray-500 mb-3">Any hazard, near miss or change request raised during the talk — log each as its own Atomis record and track it to closure. Don't bury actions in the notes.</p>
    <% if (!actions.length) { %>
      <p class="text-sm text-gray-400 italic">No actions raised.</p>
    <% } else { %>
      <ul class="divide-y divide-gray-100">
        <% actions.forEach(function (a) { %>
          <li class="py-2.5 flex items-start gap-3">
            <span class="mt-0.5 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold <%= a.status === 'closed' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>"><%= a.status === 'closed' ? 'Closed' : 'Open' %></span>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-gray-900"><%= a.description %></p>
              <p class="text-xs text-gray-400 mt-0.5">
                <% if (a.raised_by) { %>Raised by <%= a.raised_by %> · <% } %>
                <% if (a.linked_record) { %>Logged as <%= a.linked_record %> · <% } %>
                <%= fmt(a.created_at) %><% if (a.closed_at) { %> · closed <%= fmt(a.closed_at) %><% } %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/actions/<%= a.id %>/toggle" class="inline">
                <%- include('../partials/csrf') %>
                <button type="submit" class="text-[11px] font-semibold text-brand-700 hover:underline"><%= a.status === 'open' ? 'Close' : 'Reopen' %></button>
              </form>
              <% if (!isLocked) { %>
                <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/actions/<%= a.id %>/delete" class="inline" onsubmit="return confirm('Remove this action?')">
                  <%- include('../partials/csrf') %>
                  <button type="submit" class="text-[11px] font-semibold text-rose-600 hover:underline">Remove</button>
                </form>
              <% } %>
            </div>
          </li>
        <% }); %>
      </ul>
    <% } %>
    <% if (!isLocked) { %>
      <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/actions" class="mt-3 pt-3 border-t border-gray-100 grid grid-cols-1 sm:grid-cols-[1fr_180px_180px_auto] gap-2">
        <%- include('../partials/csrf') %>
        <input type="text" name="description" required placeholder="What was raised?"
          class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <input type="text" name="raised_by" placeholder="Raised by"
          class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <input type="text" name="linked_record" placeholder="Logged as (e.g. INC-12)"
          class="px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <button type="submit" class="px-4 py-2 bg-gray-900 hover:bg-gray-700 text-white text-sm font-semibold rounded-lg">Add</button>
      </form>
    <% } %>
  </div>

  <%# FRM-005 section 6 — Attendee sign-off (each person signs; link
      sign-offs land here too via the same signature_data) %>
  <% const canSignAttendee = (!isLocked && toolbox.status === 'published');
     const signedCount = signoffRows.filter(function (a) { return a.signature_data; }).length; %>
  <% if (signoffRows.length || canSignAttendee) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5" id="attendee-signoff">
      <div class="flex items-center justify-between gap-3 mb-1">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Attendee sign-off (<span data-signed-count><%= signedCount %></span>/<%= signoffRows.length %> signed)</p>
        <a href="/toolbox-talks/<%= toolbox.id %>/attendance" class="text-xs font-semibold text-brand-700 hover:underline">Manage attendance ›</a>
      </div>
      <p class="text-xs text-gray-500 mb-3">Tap <strong>Sign here</strong> next to a name — a signature pad opens right under it. Each saves on its own. Workers signing via the attendance link drop straight in here too.</p>
      <% if (!signoffRows.length) { %>
        <p class="text-sm text-gray-400">No one's on this toolbox yet — add attendees on <a href="/toolbox-talks/<%= toolbox.id %>/attendance" class="text-brand-700 hover:underline font-semibold">Manage attendance</a>.</p>
      <% } %>
      <ul class="divide-y divide-gray-100" id="attendee-signoff-list">
        <% signoffRows.forEach(function (a) { %>
          <li class="py-2.5" data-signoff-row data-crew-id="<%= a.crew_id %>">
            <div class="flex items-center gap-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate">
                  <%= a.full_name %>
                  <% if (a.employee_id) { %><span class="text-gray-400 text-xs font-normal ml-1"><%= a.employee_id %></span><% } %>
                </p>
                <p class="text-xs mt-0.5" data-signoff-meta>
                  <% if (a.signature_data) { %>
                    <span class="text-emerald-600 font-semibold">Signed</span>
                    <% if (a.late_arrival) { %><span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 font-semibold">Late<%= a.late_arrival_time ? ' ' + a.late_arrival_time : '' %></span><% } %>
                    <% if (a.signed_off_at) { %><span class="text-gray-400"> · <%= fmt(a.signed_off_at) %></span><% } %>
                  <% } else { %>
                    <span class="text-gray-400">Not signed yet</span>
                  <% } %>
                </p>
              </div>
              <div data-signoff-action class="flex-shrink-0">
                <% if (a.signature_data) { %>
                  <img src="<%= a.signature_data %>" alt="Signature" class="h-10 max-w-[140px] object-contain bg-gray-50 border border-gray-200 rounded">
                <% } else if (canSignAttendee) { %>
                  <button type="button" class="att-sign-toggle px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg">Sign here</button>
                <% } else { %>
                  <span class="text-[11px] text-gray-400"><%= a.recorded_by_id ? 'Marked off by office' : 'No signature' %></span>
                <% } %>
              </div>
            </div>
            <% if (canSignAttendee && !a.signature_data) { %>
              <div data-signoff-pad class="hidden mt-2.5 border border-gray-200 rounded-lg bg-gray-50 p-3">
                <div class="border-2 border-dashed border-gray-300 rounded-md bg-white relative" style="height:150px;">
                  <canvas data-pad-canvas style="width:100%;height:100%;touch-action:none;display:block;filter:drop-shadow(0 0 1px rgba(34,211,238,0.6)) drop-shadow(0 0 4px rgba(34,211,238,0.42));"></canvas>
                  <span data-pad-ph class="absolute inset-0 flex items-center justify-center text-sm text-gray-400 pointer-events-none"><%= a.full_name %>, sign with your finger</span>
                </div>
                <div class="flex items-center justify-between mt-2">
                  <label class="inline-flex items-center gap-2 text-xs text-gray-600">
                    <input type="checkbox" data-pad-late class="h-4 w-4 rounded border-gray-300 text-amber-600"> Late arrival
                  </label>
                  <div class="flex items-center gap-3">
                    <button type="button" data-pad-clear class="text-xs font-semibold text-gray-500 hover:text-gray-700">Clear</button>
                    <button type="button" data-pad-save class="px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg">Save signature</button>
                  </div>
                </div>
                <p data-pad-err class="hidden text-xs text-red-600 mt-1"></p>
              </div>
            <% } %>
          </li>
        <% }); %>
      </ul>
    </div>

    <% if (canSignAttendee) { %>
    <script>
      (function () {
        var toolboxId = <%= toolbox.id %>;
        var meta = document.querySelector('meta[name="csrf-token"]');
        var csrf = meta ? meta.getAttribute('content') : ((document.querySelector('input[name="_csrf"]') || {}).value || '');

        // Lazily wire a row's inline signature pad on first open.
        function wirePad(pad) {
          if (pad._wired) return pad._state;
          pad._wired = true;
          var canvas = pad.querySelector('[data-pad-canvas]');
          var ph = pad.querySelector('[data-pad-ph]');
          var ctx = canvas.getContext('2d');
          var drawing = false, hasInk = false, last = null, lastMid = null;
          function size() { var dpr = Math.min(window.devicePixelRatio || 1, 3), r = canvas.getBoundingClientRect(); if (!r.width) return; canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = '#0f172a'; }
          function pos(e) { var r = canvas.getBoundingClientRect(); var t = e.touches ? e.touches[0] : e; return { x: t.clientX - r.left, y: t.clientY - r.top }; }
          function start(e) { drawing = true; last = pos(e); lastMid = last; if (!hasInk) { hasInk = true; ph.style.display = 'none'; } e.preventDefault(); }
          function move(e) { if (!drawing) return; var p = pos(e); var mid = { x: (last.x + p.x) / 2, y: (last.y + p.y) / 2 }; ctx.beginPath(); ctx.moveTo(lastMid.x, lastMid.y); ctx.quadraticCurveTo(last.x, last.y, mid.x, mid.y); ctx.stroke(); last = p; lastMid = mid; e.preventDefault(); }
          function stop() { drawing = false; }
          canvas.addEventListener('mousedown', start); canvas.addEventListener('mousemove', move); canvas.addEventListener('mouseup', stop); canvas.addEventListener('mouseleave', stop);
          canvas.addEventListener('touchstart', start, { passive: false }); canvas.addEventListener('touchmove', move, { passive: false }); canvas.addEventListener('touchend', stop);
          pad._state = {
            size: size,
            clear: function () { ctx.clearRect(0, 0, canvas.width, canvas.height); hasInk = false; ph.style.display = ''; },
            hasInk: function () { return hasInk; },
            data: function () { return canvas.toDataURL('image/png'); },
          };
          return pad._state;
        }

        function bumpCount() {
          var el = document.querySelector('#attendee-signoff [data-signed-count]');
          if (el) el.textContent = String((parseInt(el.textContent, 10) || 0) + 1);
        }

        document.addEventListener('click', function (e) {
          // Toggle the inline pad open/closed.
          var toggle = e.target.closest('.att-sign-toggle');
          if (toggle) {
            var row = toggle.closest('[data-signoff-row]');
            var pad = row && row.querySelector('[data-signoff-pad]');
            if (!pad) return;
            var opening = pad.classList.contains('hidden');
            pad.classList.toggle('hidden');
            toggle.textContent = opening ? 'Close' : 'Sign here';
            if (opening) { var st = wirePad(pad); setTimeout(function () { st.size(); st.clear(); }, 20); }
            return;
          }
          var clr = e.target.closest('[data-pad-clear]');
          if (clr) { var p1 = clr.closest('[data-signoff-pad]'); if (p1 && p1._state) p1._state.clear(); return; }
          var save = e.target.closest('[data-pad-save]');
          if (save) {
            var pad2 = save.closest('[data-signoff-pad]');
            var row2 = save.closest('[data-signoff-row]');
            var st2 = pad2 && pad2._state;
            var err = pad2.querySelector('[data-pad-err]');
            if (!st2 || !st2.hasInk()) { if (err) { err.textContent = 'Draw a signature first.'; err.classList.remove('hidden'); } return; }
            var crewId = row2.getAttribute('data-crew-id');
            var lateEl = pad2.querySelector('[data-pad-late]');
            var isLate = lateEl && lateEl.checked;
            var data = st2.data();
            save.disabled = true; save.textContent = 'Saving…';
            fetch('/toolbox-talks/' + toolboxId + '/attendance/' + crewId + '/sign-off', {
              method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf },
              credentials: 'same-origin', body: JSON.stringify({ signature_data: data, late_arrival: isLate ? '1' : '' })
            })
              .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
              .then(function (res) {
                if (!res.ok || !res.body.ok) throw new Error((res.body && res.body.error) || 'Sign-off failed.');
                var action = row2.querySelector('[data-signoff-action]');
                if (action) { action.innerHTML = ''; var img = document.createElement('img'); img.src = data; img.alt = 'Signature'; img.className = 'h-10 max-w-[140px] object-contain bg-gray-50 border border-gray-200 rounded'; action.appendChild(img); }
                var m = row2.querySelector('[data-signoff-meta]');
                if (m) m.innerHTML = '<span class="text-emerald-600 font-semibold">Signed</span>' + (isLate ? ' <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 font-semibold">Late</span>' : '') + '<span class="text-gray-400"> · just now</span>';
                if (pad2) pad2.remove();
                bumpCount();
              })
              .catch(function (e) { if (err) { err.textContent = e.message; err.classList.remove('hidden'); } })
              .finally(function () { save.disabled = false; save.textContent = 'Save signature'; });
            return;
          }
        });
      })();
    </script>
    <% } %>
  <% } %>

  <%# FRM-005 section 7 — Presenter Sign-off (locks the record) %>
  <% if (!isLocked && toolbox.status === 'published') { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Presenter sign-off</p>
      <p class="text-xs text-gray-500 mb-3">When the talk is done and attendance is captured, the presenter signs below with their finger. <strong>This locks the record</strong> — no further edits, attendance changes or sign-ons. You can then send the FRM-005 PDF to the client.</p>
      <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/sign-off" id="signoff-form" onsubmit="return confirm('Sign off and lock this record? It can\'t be edited afterwards.')">
        <%- include('../partials/csrf') %>
        <div class="relative border-2 border-dashed border-gray-300 rounded-xl bg-gray-50 overflow-hidden">
          <canvas id="presenter-sig-pad" style="display:block;width:100%;height:160px;touch-action:none;cursor:crosshair;filter:drop-shadow(0 0 1px rgba(34,211,238,0.6)) drop-shadow(0 0 4px rgba(34,211,238,0.42));"></canvas>
          <span id="presenter-sig-placeholder" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-sm text-gray-400 pointer-events-none">Presenter signs here with their finger</span>
          <div class="absolute bottom-1.5 right-2">
            <button type="button" id="presenter-sig-clear" class="text-xs font-semibold text-gray-500 hover:text-gray-700">Clear</button>
          </div>
        </div>
        <input type="hidden" name="signature_data" id="presenter-sig-data">
        <div class="flex items-center justify-end mt-3">
          <button type="submit" id="presenter-sig-submit" disabled class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed text-white text-sm font-semibold rounded-lg">Sign off &amp; lock record</button>
        </div>
      </form>
    </div>
    <script>
      (function () {
        var canvas = document.getElementById('presenter-sig-pad');
        var placeholder = document.getElementById('presenter-sig-placeholder');
        var clearBtn = document.getElementById('presenter-sig-clear');
        var dataInput = document.getElementById('presenter-sig-data');
        var submitBtn = document.getElementById('presenter-sig-submit');
        var ctx = canvas.getContext('2d');
        var drawing = false, last = null, lastMid = null, hasInk = false;

        function size() {
          var dpr = Math.min(window.devicePixelRatio || 1, 3);
          var rect = canvas.getBoundingClientRect();
          if (rect.width === 0) return;
          canvas.width = Math.round(rect.width * dpr);
          canvas.height = Math.round(rect.height * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
          ctx.strokeStyle = '#0f172a';
        }
        requestAnimationFrame(size);
        window.addEventListener('resize', size);

        function xy(e) {
          var r = canvas.getBoundingClientRect();
          var t = e.touches ? e.touches[0] : e;
          return { x: t.clientX - r.left, y: t.clientY - r.top };
        }
        function start(e) { e.preventDefault(); drawing = true; last = xy(e); lastMid = last; placeholder.style.display = 'none'; }
        function move(e) {
          if (!drawing) return;
          e.preventDefault();
          var p = xy(e);
          var mid = { x: (last.x + p.x) / 2, y: (last.y + p.y) / 2 };
          ctx.beginPath(); ctx.moveTo(lastMid.x, lastMid.y); ctx.quadraticCurveTo(last.x, last.y, mid.x, mid.y); ctx.stroke();
          last = p; lastMid = mid;
          if (!hasInk) { hasInk = true; submitBtn.disabled = false; }
          dataInput.value = canvas.toDataURL('image/png');
        }
        function end() {
          drawing = false;
          if (hasInk) dataInput.value = canvas.toDataURL('image/png');
        }
        canvas.addEventListener('mousedown', start);
        canvas.addEventListener('mousemove', move);
        canvas.addEventListener('mouseup', end);
        canvas.addEventListener('mouseleave', end);
        canvas.addEventListener('touchstart', start, { passive: false });
        canvas.addEventListener('touchmove', move, { passive: false });
        canvas.addEventListener('touchend', end);
        clearBtn.addEventListener('click', function () {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          hasInk = false; placeholder.style.display = ''; dataInput.value = ''; submitBtn.disabled = true;
        });
      })();
    </script>
  <% } else if (isLocked) { %>
    <div class="bg-white border border-emerald-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-emerald-700 uppercase tracking-widest mb-2">Presenter sign-off</p>
      <div class="flex items-center gap-4 flex-wrap">
        <% if (toolbox.presenter_signature_data) { %>
          <img src="<%= toolbox.presenter_signature_data %>" alt="Presenter signature" class="h-16 max-w-[220px] object-contain bg-gray-50 border border-gray-200 rounded">
        <% } %>
        <div class="text-sm">
          <p class="font-semibold text-gray-900"><%= toolbox.presenter || toolbox.presenter_signed_by_name || '—' %></p>
          <p class="text-xs text-gray-500">Signed <%= fmt(toolbox.presenter_signed_at) %> · Atomis Record ID TBX-<%= toolbox.id %></p>
        </div>
      </div>
    </div>
  <% } %>

  <%# Supplementary notes — the only post-lock addition (TS-SAF-WI-003) %>
  <% if (isLocked || suppNotes.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Supplementary notes<% if (suppNotes.length) { %> (<%= suppNotes.length %>)<% } %></p>
      <% if (!suppNotes.length) { %>
        <p class="text-sm text-gray-400 italic">None yet. If anything on the locked record was wrong or incomplete, correct it here.</p>
      <% } else { %>
        <ul class="divide-y divide-gray-100">
          <% suppNotes.forEach(function (n) { %>
            <li class="py-2.5">
              <p class="text-sm text-gray-900 whitespace-pre-line"><%= n.note %></p>
              <p class="text-xs text-gray-400 mt-0.5"><%= n.author_name || 'Office' %> · <%= fmt(n.created_at) %></p>
            </li>
          <% }); %>
        </ul>
      <% } %>
      <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/notes" class="mt-3 pt-3 border-t border-gray-100 flex items-start gap-2">
        <%- include('../partials/csrf') %>
        <textarea name="note" rows="2" required placeholder="Add a supplementary note..."
          class="flex-1 px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
        <button type="submit" class="px-4 py-2 bg-gray-900 hover:bg-gray-700 text-white text-sm font-semibold rounded-lg">Add</button>
      </form>
    </div>
  <% } %>

  <%# Send the FRM-005 PDF to the client — evidence the safety items
      were addressed. Only after sign-off so clients never get an
      unsigned record. %>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Send to client</p>
    <% if (!isLocked) { %>
      <p class="text-sm text-gray-500">Available after the presenter signs off — the client should only receive the signed record. You can <a href="/toolbox-talks/<%= toolbox.id %>/record.pdf" class="text-brand-700 hover:underline font-semibold">preview the PDF</a> in the meantime.</p>
    <% } else { %>
      <p class="text-xs text-gray-500 mb-3">Emails the signed FRM-005 PDF (with all attendance signatures) as evidence the safety items were addressed.</p>
      <form method="POST" action="/toolbox-talks/<%= toolbox.id %>/send-to-client" class="space-y-3" onsubmit="return confirm('Send the signed record to this email?')">
        <%- include('../partials/csrf') %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Client</label>
            <select name="client_id" id="send-client-select"
              onchange="var o=this.options[this.selectedIndex];var e=o.getAttribute('data-email');if(e)document.getElementById('send-recipient').value=e;"
              class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
              <option value="">— Optional —</option>
              <% clients.forEach(function (c) { %>
                <option value="<%= c.id %>" data-email="<%= c.primary_contact_email || '' %>" <%= toolbox.job_client_id === c.id ? 'selected' : '' %>><%= c.company_name %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Recipient email <span class="text-rose-500">*</span></label>
            <%
              var prefillEmail = '';
              if (toolbox.job_client_id) {
                var jc = clients.filter(function (c) { return c.id === toolbox.job_client_id; })[0];
                if (jc) prefillEmail = jc.primary_contact_email || '';
              }
            %>
            <input type="email" name="recipient_email" id="send-recipient" required value="<%= prefillEmail %>"
              placeholder="contact@client.com.au"
              class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Message <span class="text-gray-300 normal-case font-medium tracking-normal">(optional, included in the email)</span></label>
          <textarea name="message" rows="3" placeholder="e.g. Toolbox completed with the crew this morning covering the items raised in your site instruction — record attached."
            class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
        </div>
        <div class="flex items-center justify-end">
          <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-lg inline-flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Send signed record
          </button>
        </div>
      </form>
    <% } %>
    <% if (clientSends.length) { %>
      <div class="mt-4 pt-3 border-t border-gray-100">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Send history</p>
        <ul class="divide-y divide-gray-100">
          <% clientSends.forEach(function (s) { %>
            <li class="py-2 flex items-center gap-3 text-sm">
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold <%= s.status === 'sent' ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700' %>"><%= s.status === 'sent' ? 'Sent' : 'Failed' %></span>
              <div class="flex-1 min-w-0">
                <p class="text-gray-900 truncate"><%= s.recipient_email %><% if (s.company_name) { %> <span class="text-gray-400">(<%= s.company_name %>)</span><% } %></p>
                <p class="text-xs text-gray-400"><%= fmt(s.sent_at) %><% if (s.sent_by_name) { %> · by <%= s.sent_by_name %><% } %></p>
              </div>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>
  </div>

  <% if (toolbox.slides_path || toolbox.signon_path) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 space-y-3">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Attachments</p>
      <% if (toolbox.slides_path) { %>
        <a href="/toolbox-talks/<%= toolbox.id %>/slides" class="inline-flex items-center gap-2 px-3 py-2 bg-brand-50 hover:bg-brand-100 text-brand-700 text-sm font-semibold rounded-lg ring-1 ring-brand-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m-7 7h8a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v13a2 2 0 002 2z"/></svg>
          Slides: <%= toolbox.slides_original_name %>
        </a>
      <% } %>
      <% if (toolbox.signon_path) { %>
        <div>
          <a href="/toolbox-talks/<%= toolbox.id %>/signon" class="inline-flex items-center gap-2 px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-lg ring-1 ring-gray-200">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2a4 4 0 014-4h7m0 0l-3-3m3 3l-3 3M5 5l14 14"/></svg>
            Sign-on sheet (admin only): <%= toolbox.signon_original_name %>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (photos.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-2">Photos</p>
      <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
        <% photos.forEach(p => { %>
          <a href="/toolbox-talks/<%= toolbox.id %>/photos/<%= p.id %>" target="_blank">
            <img src="/toolbox-talks/<%= toolbox.id %>/photos/<%= p.id %>" alt="" class="w-full h-24 object-cover rounded border border-gray-200 hover:border-brand-400 transition">
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (typeof prepDocuments !== 'undefined' && prepDocuments && prepDocuments.length) { %>
    <div class="bg-white border border-amber-200 rounded-xl shadow-sm p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <p class="text-[10px] font-bold text-amber-700 uppercase tracking-widest">Prep documents</p>
          <p class="text-xs text-gray-500 mt-0.5">Workers can review these <strong>before</strong> the meeting — visible to every invited crew member regardless of sign-off.</p>
        </div>
        <a href="/toolbox-talks/<%= toolbox.id %>/edit#prep_documents" class="text-xs font-semibold text-amber-700 hover:underline">Manage ›</a>
      </div>
      <ul class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
        <% prepDocuments.forEach(d => { %>
          <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
            <a href="/toolbox-talks/<%= toolbox.id %>/prep/<%= d.id %>" class="flex-1 truncate text-amber-700 hover:underline">
              📋 <%= d.file_original_name || ('Prep doc #' + d.id) %>
            </a>
            <span class="text-[11px] text-gray-400 tabular-nums whitespace-nowrap"><%= new Date(d.uploaded_at).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short' }) %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (typeof documents !== 'undefined' && documents && documents.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5">
      <div class="flex items-center justify-between mb-3">
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Documents</p>
          <p class="text-xs text-gray-500 mt-0.5">Workers can download these once they've signed off attendance.</p>
        </div>
        <a href="/toolbox-talks/<%= toolbox.id %>/edit#documents" class="text-xs font-semibold text-brand-700 hover:underline">Manage ›</a>
      </div>
      <ul class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
        <% documents.forEach(d => { %>
          <li class="flex items-center justify-between gap-3 px-3 py-2 text-sm">
            <a href="/toolbox-talks/<%= toolbox.id %>/documents/<%= d.id %>" class="flex-1 truncate text-brand-700 hover:underline">
              📄 <%= d.file_original_name || ('Document #' + d.id) %>
            </a>
            <span class="text-[11px] text-gray-400 tabular-nums whitespace-nowrap"><%= new Date(d.uploaded_at).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short' }) %></span>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>
</div>
