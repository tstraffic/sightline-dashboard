<% locals.currentPage = 'traffio-imports' %>
<meta name="color-scheme" content="light only">

<%
  function fmtWhen(iso) {
    if (!iso) return '';
    const d = new Date((iso || '').replace(' ', 'T') + (String(iso).includes('T') ? '' : 'Z'));
    if (isNaN(d)) return iso;
    return d.toLocaleString('en-AU', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  }
  function fmtDay(iso) {
    if (!iso) return '';
    const d = new Date((iso || '').replace(' ', 'T') + (String(iso).includes('T') ? '' : 'Z'));
    if (isNaN(d)) return String(iso).slice(0, 10);
    return d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
  }
  function dateRange(a, b) {
    const x = fmtDay(a), y = fmtDay(b);
    if (!x && !y) return '';
    if (!x || x === y) return y || x;
    return x + ' – ' + y;
  }
  function statusPill(s) {
    if (s === 'pending')   return 'bg-amber-50 text-amber-700 ring-amber-600/20';
    if (s === 'confirmed') return 'bg-emerald-50 text-emerald-700 ring-emerald-600/20';
    return 'bg-gray-100 text-gray-500 ring-gray-500/15';
  }
  const projectGroups = locals.projectGroups || [];
  const ungrouped = locals.ungrouped || [];
  const rows = locals.rows || [];
%>

<div class="max-w-5xl mx-auto px-4 py-6">
  <div class="flex items-center justify-between mb-1">
    <h1 class="text-xl font-bold text-gray-900">Traffio Reconciliation</h1>
  </div>
  <p class="text-sm text-gray-500 mb-5">
    Traffio records that couldn't be confidently matched to a job. Pending bookings are grouped by
    Traffio project — reconcile a whole project at once and every queued shift maps to the job
    together. Once mapped, future shifts of that project auto-match.
  </p>

  <!-- status chips -->
  <div class="flex flex-wrap gap-2 mb-4">
    <% const chips = [['pending','Pending',counts.pending],['confirmed','Confirmed',counts.confirmed],['discarded','Discarded',counts.discarded],['all','All','']]; %>
    <% chips.forEach(function(c){ %>
      <a href="/traffio-imports?status=<%= c[0] %>"
         class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold ring-1 ring-inset <%= status === c[0] ? 'bg-brand-600 text-white ring-brand-600' : 'bg-white text-gray-600 ring-gray-200 hover:bg-gray-50' %>">
        <%= c[1] %><% if (c[2] !== '') { %><span class="<%= status === c[0] ? 'text-white/80' : 'text-gray-400' %>"><%= c[2] %></span><% } %>
      </a>
    <% }); %>
  </div>

  <% if (status === 'pending') { %>
    <% if (!projectGroups.length && !ungrouped.length) { %>
      <div class="bg-white border border-gray-200 rounded-xl p-10 text-center text-gray-400 text-sm">
        Nothing here. No Traffio records are waiting for reconciliation.
      </div>
    <% } %>

    <% if (projectGroups.length) { %>
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-xs font-bold uppercase tracking-wide text-gray-400">
          Projects <span class="text-gray-300">·</span> <%= locals.projectCount || projectGroups.length %>
        </h2>
        <span class="text-xs text-gray-400"><%= counts.pending %> shifts pending</span>
      </div>
      <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100 mb-6">
        <% projectGroups.forEach(function(g){
             const label = g.project_name || g.sample_title || ('Project ' + g.project_id);
        %>
          <div class="flex items-center gap-3 px-4 py-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wide bg-brand-50 text-brand-700 ring-1 ring-inset ring-brand-600/15">Project</span>
            <div class="min-w-0 flex-1">
              <div class="text-sm font-semibold text-gray-900 truncate">
                <%= label %>
                <span class="ml-1 text-xs font-medium text-gray-400">· <%= g.shift_count %> shift<%= g.shift_count == 1 ? '' : 's' %></span>
              </div>
              <div class="text-xs text-gray-400 truncate">
                <% if (g.sample_address) { %><%= g.sample_address %> · <% } %><%= dateRange(g.first_date, g.last_date) %>
              </div>
            </div>
            <a href="/traffio-imports/project/<%= encodeURIComponent(g.project_id) %>"
               class="shrink-0 inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-brand-600 text-white hover:bg-brand-700">
              Reconcile project
            </a>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (ungrouped.length) { %>
      <h2 class="text-xs font-bold uppercase tracking-wide text-gray-400 mb-2">No project · reconcile individually</h2>
      <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
        <% ungrouped.forEach(function(r){ %>
          <div class="flex items-center gap-3 px-4 py-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide ring-1 ring-inset <%= statusPill(r.status) %>"><%= r.status %></span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wide bg-gray-100 text-gray-500"><%= r.record_type %></span>
            <div class="min-w-0 flex-1">
              <div class="text-sm font-medium text-gray-900 truncate"><%= r.summary || ('Traffio ' + r.record_type + ' ' + r.traffio_external_id) %></div>
              <div class="text-xs text-gray-400"><%= fmtWhen(r.created_at) %></div>
            </div>
            <a href="/traffio-imports/<%= r.id %>" class="shrink-0 inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold bg-brand-600 text-white hover:bg-brand-700">Reconcile</a>
          </div>
        <% }); %>
      </div>
    <% } %>
  <% } else { %>
    <% if (!rows.length) { %>
      <div class="bg-white border border-gray-200 rounded-xl p-10 text-center text-gray-400 text-sm">
        Nothing here. No records with this status.
      </div>
    <% } else { %>
      <div class="bg-white border border-gray-200 rounded-xl divide-y divide-gray-100">
        <% rows.forEach(function(r){ %>
          <div class="flex items-center gap-3 px-4 py-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide ring-1 ring-inset <%= statusPill(r.status) %>"><%= r.status %></span>
            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wide bg-gray-100 text-gray-500"><%= r.record_type %></span>
            <div class="min-w-0 flex-1">
              <div class="text-sm font-medium text-gray-900 truncate"><%= r.summary || ('Traffio ' + r.record_type + ' ' + r.traffio_external_id) %></div>
              <div class="text-xs text-gray-400">
                <%= fmtWhen(r.created_at) %>
                <% if (r.status === 'confirmed') { %> · → job <%= r.matched_job_number || r.created_job_number || '?' %><% } %>
                <% if (r.reviewer_name) { %> · by <%= r.reviewer_name %><% } %>
              </div>
            </div>
            <a href="/traffio-imports/<%= r.id %>" class="shrink-0 inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-500 hover:bg-gray-50">View</a>
          </div>
        <% }); %>
      </div>
    <% } %>
  <% } %>
</div>
