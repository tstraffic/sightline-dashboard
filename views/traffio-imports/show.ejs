<% locals.currentPage = 'traffio-imports' %>
<meta name="color-scheme" content="light only">

<%
  function field(label, val) {
    if (val === undefined || val === null || val === '') return '';
    return '<div class="flex justify-between gap-4 py-1.5 text-sm border-b border-gray-50 last:border-0">'
      + '<span class="text-gray-400">' + label + '</span>'
      + '<span class="text-gray-900 font-medium text-right">' + String(val) + '</span></div>';
  }
  const ref   = payload.reference || payload.booking_number || payload.number || payload.id || '';
  const client = payload.client_name || payload.client || payload.customer_name || '';
  const site  = payload.site_address || payload.address || payload.location || '';
  const date  = payload.date || payload.start_datetime || payload.starts_at || payload.booking_date || '';
  const title = payload.title || payload.name || '';
  const pending = row.status === 'pending';
%>

<div class="max-w-3xl mx-auto px-4 py-6">
  <a href="/traffio-imports" class="text-sm text-gray-400 hover:text-gray-600">&larr; Back to queue</a>
  <h1 class="text-xl font-bold text-gray-900 mt-2 mb-1">Reconcile Traffio <%= row.record_type %></h1>
  <p class="text-sm text-gray-500 mb-5"><%= row.summary %></p>

  <% if (!pending) { %>
    <div class="mb-5 rounded-lg bg-gray-50 border border-gray-200 px-4 py-3 text-sm text-gray-600">
      This import is <strong><%= row.status %></strong><% if (row.resulting_booking_id) { %> — booking #<%= row.resulting_booking_id %><% } %>.
    </div>
  <% } %>

  <!-- Proposed Traffio data -->
  <div class="bg-white border border-gray-200 rounded-xl p-4 mb-5">
    <div class="text-xs font-bold uppercase tracking-wide text-gray-400 mb-2">From Traffio</div>
    <%- field('Reference', ref) %>
    <%- field('Title', title) %>
    <%- field('Client', client) %>
    <%- field('Site', site) %>
    <%- field('Date / time', date) %>
    <%- field('Status', payload.status || payload.state) %>
    <details class="mt-3">
      <summary class="text-xs text-gray-400 cursor-pointer hover:text-gray-600">Raw payload</summary>
      <pre class="mt-2 text-[11px] bg-gray-50 rounded-lg p-3 overflow-x-auto text-gray-600"><%= JSON.stringify(payload, null, 2) %></pre>
    </details>
  </div>

  <% if (pending) { %>
  <form method="POST" action="/traffio-imports/<%= row.id %>/confirm" class="bg-white border border-gray-200 rounded-xl p-4 mb-4">
    <%- include('../partials/csrf') %>
    <div class="text-xs font-bold uppercase tracking-wide text-gray-400 mb-3">Map to a job</div>

    <label class="flex items-start gap-2 mb-3 cursor-pointer">
      <input type="radio" name="mode" value="existing" checked class="mt-1" onchange="ti_toggle()">
      <div class="flex-1">
        <div class="text-sm font-medium text-gray-900">Existing job</div>
        <select name="job_id" id="ti_job_id" class="mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
          <option value="">— select a job —</option>
          <% jobs.forEach(function(j){ %>
            <option value="<%= j.id %>"><%= j.job_number %> — <%= j.job_name %><%= j.client ? ' (' + j.client + ')' : '' %></option>
          <% }); %>
        </select>
      </div>
    </label>

    <label class="flex items-start gap-2 mb-2 cursor-pointer">
      <input type="radio" name="mode" value="new" class="mt-1" onchange="ti_toggle()">
      <div class="flex-1">
        <div class="text-sm font-medium text-gray-900">Create a new job</div>
        <div id="ti_new" class="mt-2 space-y-2 hidden">
          <input type="text" name="job_name" placeholder="Job name" value="<%= title || site %>" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
          <input type="text" name="client" placeholder="Client" value="<%= client %>" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
          <input type="text" name="job_number" placeholder="Job number (optional — auto if blank)" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
        </div>
      </div>
    </label>

    <div class="flex items-center gap-2 mt-4 pt-3 border-t border-gray-100">
      <button type="submit" class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-semibold bg-brand-600 text-white hover:bg-brand-700">Confirm &amp; create booking</button>
    </div>
  </form>

  <form method="POST" action="/traffio-imports/<%= row.id %>/discard" onsubmit="return confirm('Discard this Traffio record? It won\'t be re-queued.');">
    <%- include('../partials/csrf') %>
    <button type="submit" class="text-sm text-gray-400 hover:text-rose-600">Discard this record</button>
  </form>
  <% } %>
</div>

<script>
  function ti_toggle() {
    var isNew = document.querySelector('input[name="mode"]:checked').value === 'new';
    document.getElementById('ti_new').classList.toggle('hidden', !isNew);
    var sel = document.getElementById('ti_job_id');
    if (sel) sel.disabled = isNew;
  }
</script>
