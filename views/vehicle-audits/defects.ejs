<% locals.currentPage = 'vehicle-audits' %>
<%
  const AUD = n => (n == null || isNaN(Number(n))) ? '$0' : '$' + Number(n).toLocaleString('en-AU', { maximumFractionDigits: 0 });
%>

<%- include('_subnav', {
  vaTab: 'defects',
  vaTitle: 'Vehicle Defects',
  vaSub: 'Failed audit items being chased to fixed &middot; allocate fault to the responsible worker',
  vaOpen: typeof vaOpen !== 'undefined' ? vaOpen : 0
}) %>

<!-- Register pulse -->
<div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-4">
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-red-500 uppercase tracking-widest">Open</p>
    <p class="text-xl font-bold <%= stats.open > 0 ? 'text-red-600' : 'text-gray-300' %> mt-0.5"><%= stats.open || 0 %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-amber-500 uppercase tracking-widest">Chasing</p>
    <p class="text-xl font-bold <%= stats.chasing > 0 ? 'text-amber-600' : 'text-gray-300' %> mt-0.5"><%= stats.chasing || 0 %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-red-500 uppercase tracking-widest">Overdue</p>
    <p class="text-xl font-bold <%= stats.overdue > 0 ? 'text-red-600' : 'text-gray-300' %> mt-0.5"><%= stats.overdue || 0 %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Fixed</p>
    <p class="text-xl font-bold <%= stats.fixed > 0 ? 'text-emerald-600' : 'text-gray-300' %> mt-0.5"><%= stats.fixed || 0 %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3 col-span-2 sm:col-span-1">
    <p class="text-[10px] font-bold text-brand-500 uppercase tracking-widest">Open Cost</p>
    <p class="text-xl font-bold text-brand-600 mt-0.5"><%= AUD(stats.openCost) %></p>
  </div>
</div>

<!-- Filters -->
<form method="GET" action="/vehicle-audits/defects" class="bg-white border border-gray-200 rounded-xl shadow-sm p-3 mb-4 grid grid-cols-2 sm:grid-cols-5 gap-2">
  <select name="vehicle" class="border border-gray-300 rounded-lg px-2.5 py-2 text-sm bg-white" onchange="this.form.submit()">
    <option value="">All vehicles</option>
    <% vehicles.forEach(v => { %><option value="<%= v.id %>" <%= String(f.vehicle) === String(v.id) ? 'selected' : '' %>><%= v.asset_id %><%= v.rego ? ' · ' + v.rego : '' %></option><% }); %>
  </select>
  <select name="worker" class="border border-gray-300 rounded-lg px-2.5 py-2 text-sm bg-white" onchange="this.form.submit()">
    <option value="">All workers</option>
    <% crew.forEach(c => { %><option value="<%= c.id %>" <%= String(f.worker) === String(c.id) ? 'selected' : '' %>><%= c.full_name %></option><% }); %>
  </select>
  <select name="status" class="border border-gray-300 rounded-lg px-2.5 py-2 text-sm bg-white" onchange="this.form.submit()">
    <option value="">Open + chasing</option>
    <option value="open" <%= f.status === 'open' ? 'selected' : '' %>>Open</option>
    <option value="chasing" <%= f.status === 'chasing' ? 'selected' : '' %>>Chasing</option>
    <option value="fixed" <%= f.status === 'fixed' ? 'selected' : '' %>>Fixed</option>
  </select>
  <select name="sort" class="border border-gray-300 rounded-lg px-2.5 py-2 text-sm bg-white" onchange="this.form.submit()">
    <option value="due" <%= f.sort === 'due' ? 'selected' : '' %>>Sort: due date</option>
    <option value="cost" <%= f.sort === 'cost' ? 'selected' : '' %>>Sort: cost (high first)</option>
  </select>
  <a href="/vehicle-audits/defects" class="inline-flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-500 hover:text-gray-800">Clear</a>
</form>

<!-- Defect rows — inline edit incl. fault allocation -->
<div class="space-y-2.5">
  <% defects.forEach(d => { %>
    <%- include('_defect_row', { d, crew, csrfToken, today, showVehicle: true }) %>
  <% }); %>
  <% if (!defects.length) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-10 text-center text-sm text-gray-400">No defects match — clean fleet.</div>
  <% } %>
</div>
