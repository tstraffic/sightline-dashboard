<% locals.currentPage = 'vehicle-audits' %>
<%
  const AUD = n => (n == null || isNaN(Number(n))) ? '$0' : '$' + Number(n).toLocaleString('en-AU', { maximumFractionDigits: 0 });
  const fmtD = s => { if (!s) return '—'; const d = new Date(s + 'T00:00:00'); return isNaN(d) ? s : d.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }); };
%>

<%- include('_subnav', {
  vaTab: 'overview',
  vaTitle: 'Vehicle Audits',
  vaSub: 'Monthly yard &amp; site roadworthiness checks &middot; sourced from the Vehicles register',
  vaOpen: vaOpen,
  vaAction: '<a href="/vehicle-audits/new" class="inline-flex items-center justify-center px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-semibold rounded-xl transition-colors whitespace-nowrap">Start Audit</a>'
}) %>

<!-- Summary cards — Off-Road & Open Defects are live filters/links -->
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-4">
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Total Vehicles</p>
    <p class="text-xl font-bold text-gray-900 mt-0.5"><%= cards.totalVehicles %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3">
    <p class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest">Audited This Month</p>
    <p class="text-xl font-bold <%= cards.auditedThisMonth > 0 ? 'text-emerald-600' : 'text-gray-300' %> mt-0.5"><%= cards.auditedThisMonth %> <span class="text-xs font-semibold text-gray-300">/ <%= cards.totalVehicles %></span></p>
  </div>
  <button type="button" data-va-card-filter="offroad" class="text-left bg-white border border-gray-200 rounded-xl shadow-sm p-3 hover:border-red-300 hover:shadow transition-all cursor-pointer">
    <p class="text-[10px] font-bold text-red-500 uppercase tracking-widest">Off-Road</p>
    <p class="text-xl font-bold <%= cards.offRoad > 0 ? 'text-red-600' : 'text-gray-300' %> mt-0.5"><%= cards.offRoad %></p>
  </button>
  <a href="/vehicle-audits/defects" class="block bg-white border border-gray-200 rounded-xl shadow-sm p-3 hover:border-amber-300 hover:shadow transition-all">
    <p class="text-[10px] font-bold text-amber-500 uppercase tracking-widest">Open Defects</p>
    <p class="text-xl font-bold <%= cards.openDefects > 0 ? 'text-amber-600' : 'text-gray-300' %> mt-0.5"><%= cards.openDefects %></p>
  </a>
  <a href="/vehicle-audits/defects?sort=cost" class="block bg-white border border-gray-200 rounded-xl shadow-sm p-3 hover:border-brand-300 hover:shadow transition-all col-span-2 sm:col-span-1">
    <p class="text-[10px] font-bold text-brand-500 uppercase tracking-widest">Open Defect Cost</p>
    <p class="text-xl font-bold text-brand-600 mt-0.5"><%= AUD(cards.openDefectCost) %></p>
  </a>
</div>

<!-- Search + quick filters -->
<div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-4">
  <div class="relative flex-1 sm:max-w-xs">
    <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
    <input type="search" id="va-search" placeholder="Search asset, rego, make…"
           class="w-full border border-gray-300 rounded-xl pl-9 pr-3 py-2 text-sm bg-white focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
  </div>
  <div class="flex items-center gap-1.5 flex-wrap" id="va-filters">
    <% const chip = (key, label) => { %>
      <button type="button" data-va-filter="<%= key %>" class="va-chip px-3 py-1.5 rounded-full text-xs font-semibold border border-gray-300 bg-white text-gray-600 hover:bg-gray-50 transition-colors"><%= label %></button>
    <% } %>
    <button type="button" data-va-filter="" class="va-chip is-on px-3 py-1.5 rounded-full text-xs font-semibold border border-gray-300 bg-white text-gray-600 hover:bg-gray-50 transition-colors">All</button>
    <%- chip('attention', 'Needs attention') %>
    <%- chip('overdue', 'Overdue') %>
    <%- chip('never', 'Never audited') %>
    <%- chip('failed', 'Failed last audit') %>
    <%- chip('offroad', 'Off-Road') %>
    <%- chip('defects', 'Has open defects') %>
  </div>
  <span id="va-count" class="text-xs text-gray-400 sm:ml-auto"></span>
</div>

<!-- Vehicle list -->
<div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-[10px] font-bold text-gray-400 uppercase tracking-widest border-b border-gray-200">
          <th class="px-4 py-3">Vehicle</th>
          <th class="px-4 py-3 hidden sm:table-cell">Type</th>
          <th class="px-4 py-3 hidden md:table-cell">Status</th>
          <th class="px-4 py-3">Last Audit</th>
          <th class="px-4 py-3">Result</th>
          <th class="px-4 py-3 hidden sm:table-cell">Days Since</th>
          <th class="px-4 py-3 hidden md:table-cell">Open Defects</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100" id="va-rows">
        <% vehicles.forEach(v => {
          const overdue = v.last_audit_date != null && v.days_since != null && v.days_since > 30;
          const never = v.last_audit_date == null;
          const attention = overdue || never || v.status === 'Off-Road' || v.last_audit_result === 'fail' || v.open_defects > 0;
        %>
        <tr class="hover:bg-gray-50"
            data-search="<%= [v.asset_id, v.rego, v.make, v.model, typeLabels[v.traffic_class] || ''].filter(Boolean).join(' ').toLowerCase() %>"
            data-flags="<%= [overdue ? 'overdue' : '', never ? 'never' : '', v.status === 'Off-Road' ? 'offroad' : '', v.last_audit_result === 'fail' ? 'failed' : '', v.open_defects > 0 ? 'defects' : '', attention ? 'attention' : ''].filter(Boolean).join(' ') %>">
          <td class="px-4 py-3">
            <a href="/fleet/<%= v.id %>?tab=audits" class="font-semibold text-gray-900 hover:text-brand-600"><%= v.asset_id %></a>
            <div class="text-[11px] text-gray-400"><%= [v.make, v.model].filter(Boolean).join(' ') %><%= v.rego ? ' · ' + v.rego : '' %></div>
          </td>
          <td class="px-4 py-3 hidden sm:table-cell">
            <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-100 text-gray-600 ring-1 ring-gray-200"><%= typeLabels[v.traffic_class] || v.traffic_class || '—' %></span>
          </td>
          <td class="px-4 py-3 hidden md:table-cell">
            <% if (v.status === 'Off-Road') { %>
              <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-50 text-red-700 ring-1 ring-red-600/20">Off-Road</span>
            <% } else { %>
              <span class="text-xs text-gray-500"><%= v.status %></span>
            <% } %>
          </td>
          <td class="px-4 py-3 text-gray-700"><%= fmtD(v.last_audit_date) %><% if (v.last_audit_type) { %> <span class="text-[10px] text-gray-400 uppercase"><%= v.last_audit_type %></span><% } %></td>
          <td class="px-4 py-3">
            <% if (!v.last_audit_result) { %>
              <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-50 text-gray-400 ring-1 ring-gray-200">Never audited</span>
            <% } else if (v.last_audit_result === 'pass') { %>
              <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20">Pass</span>
            <% } else { %>
              <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-50 text-red-700 ring-1 ring-red-600/20">Fail</span>
            <% } %>
          </td>
          <td class="px-4 py-3 hidden sm:table-cell">
            <% if (v.days_since == null) { %>
              <span class="text-gray-300">—</span>
            <% } else { %>
              <span class="<%= overdue ? 'text-red-600 font-bold' : 'text-gray-600' %>"><%= v.days_since %>d</span>
              <% if (overdue) { %><span class="ml-1 inline-flex px-1.5 py-0.5 rounded text-[9px] font-bold bg-red-50 text-red-700 ring-1 ring-red-600/20 uppercase">Overdue</span><% } %>
            <% } %>
          </td>
          <td class="px-4 py-3 hidden md:table-cell">
            <% if (v.open_defects > 0) { %>
              <a href="/vehicle-audits/defects?vehicle=<%= v.id %>" class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 ring-1 ring-amber-600/20 hover:bg-amber-100"><%= v.open_defects %> open</a>
            <% } else { %><span class="text-gray-300">0</span><% } %>
          </td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <% if (v.last_audit_id) { %>
              <a href="/vehicle-audits/<%= v.last_audit_id %>" class="text-xs font-medium text-gray-500 hover:text-gray-800 mr-3">View last</a>
            <% } %>
            <a href="/vehicle-audits/new?vehicle_id=<%= v.id %>" class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold <%= (overdue || never) ? 'bg-brand-600 text-white hover:bg-brand-500' : 'bg-white border border-gray-300 text-gray-700 hover:bg-gray-50' %> transition-colors">Start Audit</a>
          </td>
        </tr>
        <% }); %>
        <% if (!vehicles.length) { %>
        <tr><td colspan="8" class="px-4 py-10 text-center text-sm text-gray-400">No vehicles in the register yet — add them under <a href="/fleet" class="text-brand-600 font-medium">Vehicles</a>.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div id="va-empty" hidden class="px-4 py-10 text-center text-sm text-gray-400">No vehicles match that filter.</div>
</div>

<style>
  .va-chip.is-on { background: #059669; border-color: #059669; color: #fff; }
  .va-chip.is-on:hover { background: #047857; }
</style>
<script>
(function () {
  var rows = Array.prototype.slice.call(document.querySelectorAll('#va-rows tr[data-search]'));
  var search = document.getElementById('va-search');
  var chips = Array.prototype.slice.call(document.querySelectorAll('.va-chip'));
  var countEl = document.getElementById('va-count');
  var emptyEl = document.getElementById('va-empty');
  var activeFlag = '';

  function apply() {
    var q = (search.value || '').trim().toLowerCase();
    var shown = 0;
    rows.forEach(function (r) {
      var okQ = !q || r.getAttribute('data-search').indexOf(q) !== -1;
      var okF = !activeFlag || (' ' + r.getAttribute('data-flags') + ' ').indexOf(' ' + activeFlag + ' ') !== -1;
      var on = okQ && okF;
      r.hidden = !on;
      if (on) shown++;
    });
    countEl.textContent = shown === rows.length ? rows.length + ' vehicles' : shown + ' of ' + rows.length + ' vehicles';
    emptyEl.hidden = shown !== 0;
  }
  search.addEventListener('input', apply);
  function setFlag(flag) {
    activeFlag = flag;
    chips.forEach(function (c) { c.classList.toggle('is-on', c.getAttribute('data-va-filter') === flag); });
    apply();
  }
  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      var f = c.getAttribute('data-va-filter');
      setFlag(f === activeFlag ? '' : f); // tap again to clear
    });
  });
  // Off-Road summary card doubles as that filter.
  var offCard = document.querySelector('[data-va-card-filter="offroad"]');
  if (offCard) offCard.addEventListener('click', function () { setFlag(activeFlag === 'offroad' ? '' : 'offroad'); });
  apply();
})();
</script>
