<% locals.currentPage = 'voc-assessments' %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="mb-4">
    <a href="/voc-assessments" class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Back to VOCs
    </a>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden mb-6">
    <div class="bg-brand-600 text-white px-6 py-4 flex items-center gap-3">
      <%- include('../partials/ts-logo', { size: 36 }) %>
      <div>
        <div class="text-xs uppercase tracking-widest opacity-80">TSVOC-001 Rev A</div>
        <h1 class="text-xl font-bold leading-tight">Start a New VOC</h1>
      </div>
    </div>
  </div>

  <form method="POST" action="/voc-assessments" class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 space-y-5">
    <%- include('../partials/csrf') %>

    <div>
      <label class="text-xs font-semibold text-gray-500 uppercase">Worker</label>
      <select name="crew_member_id" required class="mt-1 w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <option value="">— pick a crew member —</option>
        <% workers.forEach(function(w){ %>
          <option value="<%= w.id %>"><%= w.full_name %><%= w.employee_id ? ' (' + w.employee_id + ')' : '' %></option>
        <% }) %>
      </select>
    </div>

    <div>
      <label class="text-xs font-semibold text-gray-500 uppercase">Equipment / Operation</label>
      <select name="template_id" required class="mt-1 w-full px-3 py-2 bg-white border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-brand-500">
        <option value="">— pick one —</option>
        <% templates.forEach(function(t){ %>
          <option value="<%= t.id %>"><%= t.name %> · <%= t.theory_count %> theory / <%= t.practical_count %> practical · <%= t.default_validity_months %>-mth validity</option>
        <% }) %>
      </select>
      <p class="mt-1 text-xs text-gray-500 italic">Templates with 0 theory or 0 practical items haven't been configured yet — ask an admin to populate them via VOC Templates.</p>
    </div>

    <div>
      <label class="text-xs font-semibold text-gray-500 uppercase">Assessment Type</label>
      <div class="mt-1 flex flex-wrap gap-2">
        <% ['initial', 'reassessment', 'refresher_after_incident', 'other'].forEach(function(t, i){ %>
          <label class="inline-flex items-center gap-2 px-3 py-2 border border-gray-300 rounded-md cursor-pointer text-sm hover:bg-gray-50">
            <input type="radio" name="assessment_type" value="<%= t %>" <%= i === 0 ? 'checked' : '' %> class="w-3.5 h-3.5">
            <%= t === 'initial' ? 'Initial' : t === 'reassessment' ? 'Re-assessment' : t === 'refresher_after_incident' ? 'Refresher (after incident)' : 'Other' %>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2">
      <a href="/voc-assessments" class="px-4 py-2 text-sm font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg">Cancel</a>
      <button type="submit" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium rounded-lg">Create Draft</button>
    </div>
  </form>
</div>
