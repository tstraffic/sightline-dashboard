<%
  // Per-contact icon styling. Falls back to a neutral grey chip for any
  // future contact slug the admin adds that we don't have a colour for.
  function styleFor(key) {
    switch (key) {
      case 'operations': return { bg: 'rgba(43,127,255,0.15)',  fg: '#93C5FD', bgLight: '#EFF6FF', fgLight: '#1D4ED8' };
      case 'accounts':   return { bg: 'rgba(16,185,129,0.18)',  fg: '#34D399', bgLight: '#ECFDF5', fgLight: '#047857' };
      case 'hr':         return { bg: 'rgba(167,139,250,0.18)', fg: '#A78BFA', bgLight: '#F5F3FF', fgLight: '#6D28D9' };
      default:           return { bg: 'rgba(255,255,255,0.08)', fg: '#9CA3AF', bgLight: '#F3F4F6', fgLight: '#4B5563' };
    }
  }
  function telHref(p) { return 'tel:' + (p || '').replace(/[^+0-9]/g, ''); }
%>
<style>
  .cnt-wrap   { padding: 0 16px 32px; color: #fff; }
  .cnt-back {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 999px;
    color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    text-decoration: none; margin: 8px 0 12px;
  }
  .cnt-back:active { background: rgba(255,255,255,0.14); }
  .cnt-title  { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.01em; margin-bottom: 4px; }
  .cnt-sub    { font-size: 0.78rem; color: rgba(255,255,255,0.55); margin-bottom: 14px; }
  .cnt-card {
    display: flex; flex-direction: column; gap: 8px;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; padding: 14px 16px; margin-bottom: 10px;
  }
  .cnt-row    { display: flex; align-items: center; gap: 12px; }
  .cnt-ic     { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .cnt-label  { font-size: 0.95rem; font-weight: 700; color: #fff; }
  .cnt-actions { display: flex; gap: 8px; }
  .cnt-actions a {
    display: inline-flex; align-items: center; gap: 6px;
    flex: 1; padding: 10px 12px; border-radius: 10px;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);
    color: #fff; font-size: 0.82rem; font-weight: 600; text-decoration: none;
    min-width: 0;
  }
  .cnt-actions a:active { background: rgba(255,255,255,0.10); }
  .cnt-actions a svg { flex-shrink: 0; opacity: 0.7; }
  .cnt-actions a .cnt-val { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; flex: 1; }
  .cnt-empty  { text-align: center; padding: 32px 16px; color: rgba(255,255,255,0.45); font-size: 0.85rem; }

  /* ---- Light mode ---- */
  :root[data-theme="light"] .cnt-wrap  { color: #0F1115; }
  :root[data-theme="light"] .cnt-title { color: #0F1115; }
  :root[data-theme="light"] .cnt-sub   { color: #6B7280; }
  :root[data-theme="light"] .cnt-back  {
    color: #0F1115; background: #F3F4F6; border-color: #E5E7EB;
  }
  :root[data-theme="light"] .cnt-back:active { background: #E5E7EB; }
  :root[data-theme="light"] .cnt-card  {
    background: #FFFFFF; border-color: #E5E7EB;
    box-shadow: 0 1px 2px rgba(15,17,21,0.04);
  }
  :root[data-theme="light"] .cnt-label { color: #0F1115; }
  :root[data-theme="light"] .cnt-actions a {
    background: #F9FAFB; border-color: #E5E7EB; color: #111827;
  }
  :root[data-theme="light"] .cnt-actions a:active { background: #F3F4F6; }
  :root[data-theme="light"] .cnt-actions a svg { opacity: 0.55; }
  :root[data-theme="light"] .cnt-empty { color: #6B7280; }
</style>

<div class="cnt-wrap">
  <a href="/w/more" class="cnt-back" aria-label="Back to More">
    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
  </a>
  <h1 class="cnt-title">T&amp;S Contacts</h1>
  <p class="cnt-sub">Tap a number to call. Tap an email to write.</p>

  <% if (!contacts || !contacts.length) { %>
    <div class="cnt-empty">No contacts have been added yet. Ask the office to set them up in the HR Dashboard.</div>
  <% } else { %>
    <% contacts.forEach(c => { const s = styleFor(c.key); %>
      <div class="cnt-card">
        <div class="cnt-row">
          <div class="cnt-ic" style="background: <%= s.bg %>; color: <%= s.fg %>;" data-light-bg="<%= s.bgLight %>" data-light-fg="<%= s.fgLight %>">
            <% if (c.key === 'operations') { %>
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2a4 4 0 014-4h6m-6 0V7a4 4 0 014-4h2v18H4V7a4 4 0 014-4h2v4"/></svg>
            <% } else if (c.key === 'accounts') { %>
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <% } else if (c.key === 'hr') { %>
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <% } else { %>
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <% } %>
          </div>
          <div class="cnt-label"><%= c.label %></div>
        </div>
        <div class="cnt-actions">
          <% if (c.phone) { %>
            <a href="<%= telHref(c.phone) %>" aria-label="Call <%= c.label %>">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span class="cnt-val"><%= c.phone %></span>
            </a>
          <% } %>
          <% if (c.email) { %>
            <a href="mailto:<%= c.email %>" aria-label="Email <%= c.label %>">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span class="cnt-val"><%= c.email %></span>
            </a>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>

<script>
  // Swap the icon-chip's inline background to the light-tinted variant
  // when the theme is light. The data attributes carry the light values
  // so we don't fight the existing inline style with !important.
  (function () {
    function apply() {
      var light = document.documentElement.getAttribute('data-theme') === 'light';
      document.querySelectorAll('.cnt-ic[data-light-bg]').forEach(function (el) {
        if (light) {
          el.style.background = el.getAttribute('data-light-bg');
          el.style.color = el.getAttribute('data-light-fg');
        } else {
          el.style.background = '';
          el.style.color = '';
        }
      });
    }
    apply();
    new MutationObserver(apply).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>
