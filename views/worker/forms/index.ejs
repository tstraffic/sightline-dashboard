<div class="px-4 pt-3 pb-2">
  <!-- Search -->
  <div class="relative mb-4">
    <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    <input type="text" id="formSearch" placeholder="Search" oninput="filterForms(this.value)"
      class="w-full pl-9 pr-4 py-2.5 rounded-lg text-sm" style="background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.1);color:white;">
  </div>

  <p class="text-xs text-gray-500 mb-4">The forms listed below are available anytime, and are not linked to jobs.</p>

  <!-- Available Forms Header -->
  <div class="py-2 px-1 mb-1" style="border-left:3px solid #10B981;">
    <span class="text-xs font-bold uppercase tracking-wider" style="color:#10B981;">Available</span>
  </div>
</div>

<!-- Job-Pack callout &mdash; these forms are intentionally NOT listed here because
     each one is bound to a specific shift. Workers open them from
     /w/jobs/<allocation>?tab=forms so the submission lands against the right
     allocation. Keep this block as a nudge so anyone hunting for a
     pre-start/post-shift/etc still ends up in the right place. -->
<div class="px-4 mb-4">
  <a href="/w/jobs" class="block rounded-xl px-4 py-3 transition active:opacity-80"
     style="background: linear-gradient(135deg, rgba(16,185,129,0.18), rgba(16,185,129,0.06)); border: 1px solid rgba(16,185,129,0.35);">
    <div class="flex items-start gap-3">
      <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style="background:rgba(16,185,129,0.22);">
        <svg class="w-5 h-5" style="color:#60A5FA;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.7"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-semibold text-white">Shift checklists</p>
        <p class="text-[11px] mt-0.5" style="color:rgba(255,255,255,0.65);">Vehicle Pre-Start, Risk &amp; Toolbox, TC Prestart, Team Leader, Post-Shift &mdash; open from the shift they belong to.</p>
        <p class="text-[11px] mt-1.5 font-semibold" style="color:#60A5FA;">Open my shifts &rarr;</p>
      </div>
    </div>
  </a>
</div>

<!-- Form List — admin-built templates published to workers. Each one is
     created/edited on the admin side (/checklists) and rendered from its
     latest published revision, so what workers see always matches the
     editable version in the office. -->
<div id="formList">
  <!-- Leave Request — a real HR workflow, not a form template -->
  <a href="/w/hr/leave" class="form-item flex items-center gap-3 px-4 py-3.5 transition" style="border-bottom:1px solid rgba(255,255,255,0.06);" data-name="leave request">
    <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style="background:rgba(255,255,255,0.06);">
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
    </div>
    <span class="text-sm font-medium flex-1">Leave Request</span>
    <svg class="w-4 h-4 text-gray-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </a>

  <% (formTemplates || []).forEach(function (t) { %>
  <a href="/w/forms/custom/<%= t.id %>" class="form-item flex items-center gap-3 px-4 py-3.5 transition" style="border-bottom:1px solid rgba(255,255,255,0.06);" data-name="<%= t.name.toLowerCase() %>">
    <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style="background:rgba(255,255,255,0.06);">
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
    </div>
    <div class="flex-1 min-w-0">
      <span class="text-sm font-medium block truncate"><%= t.name %></span>
      <% if (t.description) { %><span class="text-[11px] text-gray-500 block truncate"><%= t.description %></span><% } %>
    </div>
    <svg class="w-4 h-4 text-gray-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  </a>
  <% }) %>

  <% if (!formTemplates || !formTemplates.length) { %>
  <p class="px-4 py-6 text-center text-xs text-gray-500">No forms published yet — the office can add them from the admin Forms &amp; Checklists page.</p>
  <% } %>
</div>

<!-- History Link -->
<div class="px-4 pt-4 pb-2">
  <a href="/w/forms/history" class="flex items-center justify-center gap-2 text-sm font-medium py-3 rounded-lg transition" style="color:#10B981;">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    View Form History
  </a>
</div>

<script>
function filterForms(q) {
  var items = document.querySelectorAll('.form-item');
  var query = q.toLowerCase().trim();
  items.forEach(function(item) {
    var name = item.dataset.name || item.textContent.toLowerCase();
    item.style.display = (!query || name.includes(query)) ? 'flex' : 'none';
  });
}
</script>
