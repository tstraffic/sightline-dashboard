<%
  var d = (typeof draftData !== 'undefined' && draftData) ? draftData : {};
  var hasDraft = !!(typeof draft !== 'undefined' && draft);
  var teamPhotos = (typeof draftPhotos !== 'undefined' && draftPhotos) ? draftPhotos.filter(function (p) { return p.tag === 'team'; }) : [];
  var setupPhotos = (typeof draftPhotos !== 'undefined' && draftPhotos) ? draftPhotos.filter(function (p) { return p.tag === 'setup'; }) : [];
  function checked(v) { return v ? ' checked' : ''; }
  function fmtDraftAge(at) {
    if (!at) return '';
    try {
      var t = new Date(at).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
      return t;
    } catch (e) { return ''; }
  }
%>
<div class="space-y-4 pb-24">
  <a href="<%= allocation ? ('/w/jobs/' + allocation.id + '?tab=forms') : '/w/forms' %>" class="inline-flex items-center text-sm text-brand-600 font-medium">
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back
  </a>

  <div>
    <h1 class="text-xl font-bold text-gray-900">4. Team Leader Checklist</h1>
    <p class="text-xs text-gray-500 mt-1">Complete once your crew is on site and set up.</p>
  </div>

  <%# Flash renders via the layout banner (global locals). %>

  <!-- Team Leader Checklist is open to every worker on the shift &mdash; there's
       no gate. Show a brief affirming note so non-TL workers don't second-
       guess whether they're allowed to submit it. -->
  <div class="bg-blue-50 border border-blue-200 text-blue-900 rounded-xl p-3 text-xs">
    <strong>Anyone on the crew can fill this in.</strong> If your Team Leader isn't on site, you're acting as TL &mdash; just complete it as the lead.
  </div>

  <% if (hasDraft) { %>
    <div class="bg-amber-50 border border-amber-200 text-amber-900 rounded-xl p-3 text-sm flex items-start gap-2">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5h2m-2 0a2 2 0 100 4h2a2 2 0 110 4h-2m0-8v8m0 0v3m0-3h2m-2 0h-2"/></svg>
      <div class="min-w-0 flex-1">
        <p class="font-semibold">Resuming a team draft<% if (draft.draft_started_by_name) { %> started by <%= draft.draft_started_by_name %><% } %></p>
        <p class="text-xs mt-0.5 opacity-80">Your answers + photos are saved with the whole crew. Add to it and submit when ready, or delete the draft below to start fresh.</p>
        <form method="POST" action="/w/forms/draft/<%= draft.id %>/delete" class="mt-2 inline" onsubmit="return confirm('Delete this draft for the whole crew?');">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="text-xs font-semibold text-red-700 underline hover:text-red-800">Delete team draft</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (allocation) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <p class="text-sm font-bold text-gray-900"><%= allocation.client %></p>
      <p class="text-xs text-gray-500"><%= allocation.job_number %> &middot; <%= allocation.site_address || allocation.suburb || '' %></p>
    </div>
  <% } %>

  <form method="POST" action="/w/forms/team-leader" enctype="multipart/form-data" id="team-leader-form">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <% if (allocation) { %><input type="hidden" name="allocation_id" value="<%= allocation.id %>"><% } %>
    <input type="hidden" name="save_as_draft" id="save-as-draft-flag" value="">

    <div class="space-y-4">
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 space-y-3">
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Team Leader's Name</label>
          <input type="text" name="team_leader_name" required value="<%= (d.team_leader_name || '') %>" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Are all workers present and on time?</label>
          <div class="grid grid-cols-2 gap-2 text-sm font-semibold mb-2">
            <label class="cursor-pointer"><input type="radio" name="workers_present" value="yes" class="peer sr-only" required<%= checked(d.workers_present === true) %>><span class="block text-center px-3 py-2.5 rounded-lg border border-gray-300 text-gray-600 peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600">Yes</span></label>
            <label class="cursor-pointer"><input type="radio" name="workers_present" value="no" class="peer sr-only"<%= checked(d.workers_present === false && hasDraft) %>><span class="block text-center px-3 py-2.5 rounded-lg border border-gray-300 text-gray-600 peer-checked:bg-red-600 peer-checked:text-white peer-checked:border-red-600">No</span></label>
          </div>
          <textarea name="late_notes" rows="2" placeholder="If anyone was late: who, why, was supervisor notified?" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 resize-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"><%= d.late_notes || '' %></textarea>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 space-y-2">
        <label class="block text-xs font-semibold text-gray-500 uppercase">Worker photos (full PPE + radio)</label>
        <p class="text-[11px] text-gray-500">One photo per worker &mdash; show full PPE clearly. <strong>Max 8 photos · 15 MB each.</strong></p>
        <% if (teamPhotos.length) { %>
          <div class="grid grid-cols-3 gap-2 mb-2">
            <% teamPhotos.forEach(function (p) { %>
              <div class="relative">
                <img src="/w/forms/draft-photos/<%= p.id %>" alt="" class="w-full h-20 object-cover rounded border border-gray-200">
                <span class="absolute top-1 left-1 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-white/90 text-gray-700">DRAFT</span>
              </div>
            <% }) %>
          </div>
        <% } %>
        <input type="file" name="team_photos" accept="image/*" capture="environment" multiple data-wpi data-wpi-max="8" data-wpi-label="Add worker photo">
      </div>

      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 space-y-3">
        <label class="block text-xs font-semibold text-gray-500 uppercase">PPE check (every worker)</label>
        <div class="divide-y divide-gray-100">
          <% ppeItems.forEach(function (it) {
               var ppeVal = (d.ppe && (it.key in d.ppe)) ? d.ppe[it.key] : true; %>
            <div class="py-2 flex items-center justify-between gap-3">
              <span class="text-sm text-gray-800 flex-1"><%= it.label %></span>
              <div class="flex gap-1 text-xs font-semibold">
                <label class="cursor-pointer"><input type="radio" name="ppe_<%= it.key %>" value="yes" class="peer sr-only"<%= checked(ppeVal !== false) %>><span class="px-3 py-1.5 rounded-md border border-gray-300 text-gray-600 peer-checked:bg-emerald-600 peer-checked:text-white peer-checked:border-emerald-600">Yes</span></label>
                <label class="cursor-pointer"><input type="radio" name="ppe_<%= it.key %>" value="no" class="peer sr-only"<%= checked(ppeVal === false) %>><span class="px-3 py-1.5 rounded-md border border-gray-300 text-gray-600 peer-checked:bg-red-600 peer-checked:text-white peer-checked:border-red-600">No</span></label>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 space-y-2">
        <label class="block text-xs font-semibold text-gray-500 uppercase">Setup correct (TCP &amp; ROL implemented)?</label>
        <div class="grid grid-cols-2 gap-2 text-sm font-semibold">
          <label class="cursor-pointer"><input type="radio" name="setup_correct" value="yes" class="peer sr-only" required<%= checked(d.setup_correct === true) %>><span class="block text-center px-3 py-2.5 rounded-lg border border-gray-300 text-gray-600 peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600">Yes</span></label>
          <label class="cursor-pointer"><input type="radio" name="setup_correct" value="no" class="peer sr-only"<%= checked(d.setup_correct === false && hasDraft) %>><span class="block text-center px-3 py-2.5 rounded-lg border border-gray-300 text-gray-600 peer-checked:bg-red-600 peer-checked:text-white peer-checked:border-red-600">No</span></label>
        </div>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 space-y-2">
        <label class="block text-xs font-semibold text-gray-500 uppercase">Setup photos</label>
        <p class="text-[11px] text-gray-500">Minimum 5 photos showing the full setup. <strong>Max 10 photos · 15 MB each.</strong></p>
        <% if (setupPhotos.length) { %>
          <div class="grid grid-cols-3 gap-2 mb-2">
            <% setupPhotos.forEach(function (p) { %>
              <div class="relative">
                <img src="/w/forms/draft-photos/<%= p.id %>" alt="" class="w-full h-20 object-cover rounded border border-gray-200">
                <span class="absolute top-1 left-1 inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-white/90 text-gray-700">DRAFT</span>
              </div>
            <% }) %>
          </div>
        <% } %>
        <input type="file" name="setup_photos" accept="image/*" capture="environment" multiple data-wpi data-wpi-max="10" data-wpi-label="Add setup photo">
      </div>

      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
        <label class="block text-xs font-semibold text-gray-500 uppercase mb-1">Notes (optional)</label>
        <textarea name="notes" rows="2" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 resize-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"><%= d.notes || '' %></textarea>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
        <div class="flex items-center justify-between mb-2">
          <label class="text-xs font-semibold text-gray-500 uppercase">Auditor's Signature</label>
          <button type="button" onclick="clearSig()" class="text-xs text-gray-400 hover:text-gray-600 bg-gray-100 px-2 py-1 rounded">Clear</button>
        </div>
        <div id="sig-pad" class="border-2 border-dashed border-gray-300 rounded-lg bg-gray-50 relative" style="height:160px;">
          <canvas id="sig-canvas" data-neon-trail class="w-full h-full rounded-lg" style="touch-action: none;"></canvas>
        </div>
        <input type="hidden" name="signature_data" id="sig-data" value="<%= (hasDraft && draft.signature_data) ? draft.signature_data : '' %>">
        <% if (hasDraft && draft.signature_data) { %>
          <p class="text-[11px] text-gray-500 mt-1">A signature was saved with the draft — sign again to replace it, or leave it as is.</p>
        <% } %>
      </div>

      <div class="grid grid-cols-2 gap-2 sticky bottom-2">
        <button type="button" id="save-draft-btn" class="py-3.5 bg-white border border-gray-300 text-gray-700 rounded-xl font-semibold text-sm hover:bg-gray-50" style="min-height:48px;">
          <%= hasDraft ? 'Update draft' : 'Save as draft' %>
        </button>
        <button type="submit" id="submit-btn" onclick="captureSig()" class="py-3.5 bg-brand-600 text-white rounded-xl font-semibold text-sm hover:bg-brand-700" style="min-height:48px;">Submit</button>
      </div>
      <p class="text-[11px] text-gray-500 text-center">Drafts are shared with everyone on this shift — anyone can add photos or finish + submit.</p>
    </div>
  </form>
</div>

<script>
// Uses the shared WorkerSigPad helper so this pad behaves like the docket
// sign-page exactly — smooth quadratic-curve ink at dpr resolution, dark
// slate-blue stroke, neon brand-teal pen-trail glow via sig-neon-trail.
(function () {
  var canvas = document.getElementById('sig-canvas');
  var padEl = document.getElementById('sig-pad');
  var hidden = document.getElementById('sig-data');
  var pad = window.WorkerSigPad && window.WorkerSigPad.setup(canvas, padEl, {
    onChange: function () { if (hidden) hidden.value = pad ? pad.getData() : ''; },
  });
  window.clearSig = function () { if (pad) pad.clear(); };
  window.captureSig = function () { if (pad && hidden) hidden.value = pad.getData(); };
})();

// "Save as draft" reuses the same form action but flips the save_as_draft
// flag and bypasses HTML5 required attributes so partial state can save.
document.getElementById('save-draft-btn').addEventListener('click', function () {
  document.getElementById('save-as-draft-flag').value = '1';
  var form = document.getElementById('team-leader-form');
  // Drop required so partially-filled drafts can save.
  form.querySelectorAll('[required]').forEach(function (el) { el.removeAttribute('required'); el.dataset.wasRequired = '1'; });
  if (typeof window.captureSig === 'function') window.captureSig();
  form.submit();
});
</script>
<script src="/js/worker-photo-input.js?v=3"></script>
