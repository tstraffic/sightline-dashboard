  .wh-section-head { display: flex; align-items: center; justify-content: space-between; margin: 1.25rem 0 0.5rem; padding: 0 2px; }
  .wh-section-title { font-size: 0.7rem; font-weight: 700; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.08em; }
  .wh-section-link { font-size: 0.75rem; font-weight: 600; color: #60A5FA; display: inline-flex; align-items: center; gap: 2px; }

  /* Cards carousel */
  .wh-cards { display: flex; gap: 10px; overflow-x: auto; padding: 2px 2px 8px; scrollbar-width: none; scroll-snap-type: x mandatory; }
  .wh-cards::-webkit-scrollbar { display: none; }
  .wh-card {
    flex: 0 0 82%; max-width: 280px;
    position: relative; padding: 14px;
    border-radius: 14px;
    background-color: rgba(255,255,255,0.025);
    background-image: linear-gradient(180deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.005) 100%);
    border: 1px solid rgba(255,255,255,0.04);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 6px 14px rgba(0,0,0,0.25);
    scroll-snap-align: start; min-height: 110px;
    display: flex; flex-direction: column; gap: 6px;
