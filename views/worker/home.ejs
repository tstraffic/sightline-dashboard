  }
  @keyframes wh-slide-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .wh-card-top { display: flex; align-items: center; gap: 8px; }
  .wh-card-ic { width: 28px; height: 28px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .wh-card-ic.red { background: rgba(239,68,68,0.15); color: #F87171; }
  .wh-card-ic.amber { background: rgba(245,158,11,0.15); color: #F59E0B; }
  .wh-card-ic.blue { background: rgba(43,127,255,0.15); color: #60A5FA; }
  .wh-card-ic.emerald { background: rgba(16,185,129,0.15); color: #34D399; }
  .wh-card-ic.indigo { background: rgba(99,102,241,0.15); color: #818CF8; }
  .wh-card-title { font-size: 0.82rem; font-weight: 700; color: #fff; line-height: 1.2; flex: 1; min-width: 0; }
  .wh-card-body { font-size: 0.72rem; color: rgba(255,255,255,0.6); line-height: 1.3; }
  .wh-card-dismiss { position: absolute; top: 6px; right: 6px; width: 22px; height: 22px; border-radius: 999px; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.35); background: rgba(255,255,255,0.04); }
  .wh-card-dismiss:hover { color: #fff; background: rgba(255,255,255,0.1); }
  .wh-card-cta { display: inline-flex; align-items: center; gap: 3px; font-size: 0.72rem; font-weight: 700; color: #60A5FA; align-self: flex-start; margin-top: auto; padding: 4px 0; }

  /* Streaks strip */
  .wh-streaks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .wh-streak {
    background-color: rgba(255,255,255,0.025);
    background-image: linear-gradient(180deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.005) 100%);
    border: 1px solid rgba(255,255,255,0.04);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 4px 10px rgba(0,0,0,0.22);
    border-radius: 12px; padding: 10px 12px; position: relative; overflow: hidden;
  }
  .wh-streak-label { font-size: 0.625rem; font-weight: 700; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.07em; display: flex; align-items: center; gap: 6px; }
  .wh-streak-ic { width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; border-radius: 6px; position: relative; overflow: visible; transition: box-shadow 240ms ease; }
  .wh-streak-ic.emerald { background: rgba(16,185,129,0.18); color: #34D399; }
  .wh-streak-ic.blue { background: rgba(43,127,255,0.18); color: #60A5FA; }
  .wh-streak-ic.purple { background: rgba(167,139,250,0.18); color: #A78BFA; }
  .wh-streak-ic.amber { background: rgba(245,158,11,0.18); color: #F59E0B; }

  /* Shift-streak flame tier ladder. Each tier ramps colour intensity,
     animation speed, and box-shadow glow as the streak climbs. Legendary
     gets three CSS particle-flames rising from the icon (.wh-flame-particle). */
  .wh-streak-ic[data-tier="cold"]      { background: rgba(148,163,184,0.18); color: #94A3B8; }
  .wh-streak-ic[data-tier="cold"]      svg { opacity: 0.55; }
  .wh-streak-ic[data-tier="warm"]      { background: rgba(245,158,11,0.18); color: #FCD34D; }
  .wh-streak-ic[data-tier="hot"]       { background: rgba(245,158,11,0.22); color: #F59E0B; box-shadow: 0 0 8px rgba(245,158,11,0.30); }
  .wh-streak-ic[data-tier="hot"]       svg { animation: wh-flicker 1.5s ease-in-out infinite; transform-origin: center; }
  .wh-streak-ic[data-tier="blazing"]   { background: rgba(249,115,22,0.25); color: #F97316; box-shadow: 0 0 12px rgba(249,115,22,0.50); }
  .wh-streak-ic[data-tier="blazing"]   svg { animation: wh-flicker 1.0s ease-in-out infinite; transform-origin: center; }
  .wh-streak-ic[data-tier="legendary"] { background: rgba(239,68,68,0.28); color: #EF4444; box-shadow: 0 0 16px rgba(239,68,68,0.60); }
  .wh-streak-ic[data-tier="legendary"] svg { animation: wh-flicker 0.8s ease-in-out infinite; transform-origin: center; }

  .wh-flame-particle {
    position: absolute; top: -3px; left: 50%;
    width: 5px; height: 7px; border-radius: 50% 50% 40% 40%;
    background: radial-gradient(circle at 50% 70%, #FCA5A5, #EF4444 70%, transparent 100%);
    filter: blur(0.8px);
    transform: translate(-50%, 0) scale(0.6);
    opacity: 0;
    animation: wh-particle-rise 1.8s ease-out infinite;
    pointer-events: none;
  }
  .wh-flame-particle-2 { animation-delay: 0.6s; left: 32%; }
  .wh-flame-particle-3 { animation-delay: 1.2s; left: 68%; }

  @keyframes wh-flicker {
    0%, 100% { transform: scale(1.00) rotate(-1deg); }
    50%      { transform: scale(1.06) rotate( 1deg); }
  }
  @keyframes wh-particle-rise {
    0%   { transform: translate(-50%, 0)     scale(0.6); opacity: 0; }
    25%  { opacity: 1; }
    100% { transform: translate(-50%, -16px) scale(0.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wh-streak-ic[data-tier] svg,
    .wh-flame-particle { animation: none !important; }
    .wh-flame-particle { opacity: 0 !important; }
  }
  .wh-streak-value { font-family: var(--wd-font-display, 'JetBrains Mono', ui-monospace, monospace); font-size: 1.35rem; font-weight: 700; color: #fff; margin-top: 4px; letter-spacing: -0.02em; font-feature-settings: "tnum" 1, "ss01" 1; }
  .wh-streak-unit { font-size: 0.7rem; font-weight: 600; color: rgba(255,255,255,0.4); margin-left: 2px; }
  .wh-streak-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: rgba(255,255,255,0.08); overflow: hidden; }
  .wh-streak-bar-fill { height: 100%; background: currentColor; transition: width 0.8s ease-out; }

  /* Week strip */
  .wh-week { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  .wh-wday { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; padding: 8px 2px 6px; text-align: center; color: rgba(255,255,255,0.6); }
  .wh-wday.today {
    color: #F59E0B;
    background: rgba(245,158,11,0.08);
    /* Outer ring + inner glow that breathes on a 4s cycle. Drawn entirely
       via box-shadow so it never shifts layout or adjusts neighbours. */
    box-shadow:
      inset 0 0 0 1.5px #F59E0B,
      inset 0 0 0 4px rgba(245,158,11,0.10),
      0 0 0 0 rgba(245,158,11,0);
    animation: wh-today-glow 4s ease-in-out infinite;
  }
  @keyframes wh-today-glow {
    0%, 100% {
      box-shadow:
        inset 0 0 0 1.5px #F59E0B,
        inset 0 0 0 4px rgba(245,158,11,0.10),
        0 0 0 0 rgba(245,158,11,0);
    }
    50% {
      box-shadow:
        inset 0 0 0 1.5px #F59E0B,
        inset 0 0 0 4px rgba(245,158,11,0.22),
        0 0 12px 0 rgba(245,158,11,0.32);
