<style>
  .wh-wrap { padding: 0.5rem; }

  /* Hero */
  .wh-hero {
    position: relative;
    padding: 1rem 1.1rem 1.1rem;
    border-radius: 16px;
    /* The static "lit-from-above" sheen + base navy stay put; the two
       radial accents (blue top-left, teal bottom-right) drift slowly via
       background-position so the hero feels alive without distracting. */
    background-color: #0A1628;
    background-image:
      linear-gradient(180deg, rgba(255,255,255,0.045) 0%, rgba(255,255,255,0.005) 100%),
      radial-gradient(120% 80% at 0% 0%, rgba(43,127,255,0.25), transparent 60%),
      radial-gradient(120% 80% at 100% 100%, rgba(0,210,190,0.18), transparent 55%),
      linear-gradient(160deg, #0F1F3A, #0A1628);
    background-repeat: no-repeat;
    background-size: 100% 100%, 200% 200%, 200% 200%, 100% 100%;
    background-position: 0 0, 0% 0%, 100% 100%, 0 0;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.06),
      0 10px 24px rgba(0,0,0,0.32);
    overflow: hidden;
    will-change: background-position;
    animation: wh-hero-drift 24s ease-in-out infinite alternate;
  }
  @keyframes wh-hero-drift {
    0%   { background-position: 0 0, 0% 0%,   100% 100%, 0 0; }
    100% { background-position: 0 0, 20% 15%, 80% 70%,   0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wh-hero { animation: none; }
  }
  .wh-hero::before {
    content: ''; position: absolute; inset: -40% -40% 30% 30%;
    background: radial-gradient(closest-side, rgba(0,210,190,0.18), transparent);
    filter: blur(40px); pointer-events: none;
  }
  .wh-hero-sub { font-size: 0.75rem; color: rgba(255,255,255,0.55); letter-spacing: 0.02em; }
  .wh-hero-greet { font-size: 1.5rem; font-weight: 800; color: #fff; letter-spacing: -0.01em; line-height: 1.15; margin-top: 0.125rem; }
  .wh-hero-ctx { font-size: 0.85rem; color: #93C5FD; margin-top: 0.5rem; font-weight: 500; display: flex; align-items: center; gap: 0.4rem; }
  .wh-hero-ctx.shift { color: #FCD34D; }
  .wh-hero-ctx.compliance { color: #FDA4AF; }
  .wh-hero-ctx.leave { color: #A78BFA; }
  .wh-hero-ctx.payslip { color: #34D399; }
  .wh-hero-ctx.birthday, .wh-hero-ctx.anniversary { color: #F9A8D4; }
  .wh-hero-ctx .dot { width: 6px; height: 6px; border-radius: 999px; background: currentColor; opacity: 0.8; animation: wh-pulse 2.4s infinite; }
  @keyframes wh-pulse { 0%,100%{opacity:1} 50%{opacity:0.45} }

  /* Stats grid */
  .wh-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 12px; }
  .wh-stat {
    background-color: rgba(255,255,255,0.025);
    background-image: linear-gradient(180deg, rgba(255,255,255,0.035) 0%, rgba(255,255,255,0.005) 100%);
    border: 1px solid rgba(255,255,255,0.04);
