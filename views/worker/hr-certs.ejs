<div class="space-y-5">
  <a href="/w/hr" class="inline-flex items-center text-sm text-brand-600 font-medium">
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to HR
  </a>

  <h1 class="text-xl font-bold text-gray-900">My Wallet</h1>
  <p class="text-xs text-gray-500 -mt-3">Licences, certifications and documents the office has on file.</p>

  <!-- Crew Member Licence -->
  <% if (member && member.licence_type) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Traffic Control Licence</h3>
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-gray-900"><%= member.licence_type %></span>
        <% if (member.licence_expiry) { %>
          <% const exp = new Date(member.licence_expiry); const now = new Date(); const isExpired = exp < now; const isExpiring = !isExpired && exp < new Date(Date.now() + 30*24*60*60*1000); %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold
            <%= isExpired ? 'bg-red-50 text-red-700' : isExpiring ? 'bg-amber-50 text-amber-700' : 'bg-emerald-50 text-emerald-700' %>">
            <%= isExpired ? 'Expired' : isExpiring ? 'Expiring Soon' : 'Valid' %> · <%= exp.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }) %>
          </span>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Competencies -->
  <% if (certs.length === 0) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 text-center">
      <p class="text-gray-500 text-sm">No certifications on record</p>
      <p class="text-xs text-gray-400 mt-1">Contact admin to add your qualifications</p>
    </div>
  <% } else { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm divide-y divide-gray-100">
      <% certs.forEach(c => { %>
        <div class="p-4">
          <div class="flex items-center justify-between mb-1">
            <p class="text-sm font-medium text-gray-900"><%= c.competency_name || c.comp_type %></p>
            <% if (c.expiry_date) { %>
              <% const exp = new Date(c.expiry_date); const now = new Date(); const isExpired = exp < now; const isExpiring = !isExpired && exp < new Date(Date.now() + 30*24*60*60*1000); %>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold
                <%= isExpired ? 'bg-red-50 text-red-700' : isExpiring ? 'bg-amber-50 text-amber-700' : 'bg-emerald-50 text-emerald-700' %>">
                <%= isExpired ? 'Expired' : isExpiring ? 'Expiring' : 'Valid' %>
              </span>
            <% } else { %>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-gray-100 text-gray-600">No Expiry</span>
            <% } %>
          </div>
          <div class="text-xs text-gray-500 space-y-0.5">
            <% if (c.cert_number) { %><p>Cert #: <%= c.cert_number %></p><% } %>
            <% if (c.issuing_authority) { %><p>Issued by: <%= c.issuing_authority %></p><% } %>
            <% if (c.expiry_date) { %><p>Expires: <%= new Date(c.expiry_date).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }) %></p><% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- Documents — files uploaded via recruitment approval or manually by office -->
  <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
    <div>
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Documents on File</h2>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm divide-y divide-gray-100">
        <% documents.forEach(doc => { %>
          <% const ext = ((doc.original_name || doc.filename || '').split('.').pop() || '').toLowerCase(); %>
          <% const isImage = ['jpg','jpeg','png','gif','webp','bmp','svg','avif','heic','heif'].includes(ext); %>
          <% const isPdf = ext === 'pdf'; %>
          <% let badgeClass = 'bg-gray-100 text-gray-600'; let badgeText = ''; %>
          <% if (doc.expiry_date) {
               const exp = new Date(doc.expiry_date);
               const now = new Date();
               const isExpired = exp < now;
               const isExpiring = !isExpired && exp < new Date(Date.now() + 30*24*60*60*1000);
               if (isExpired) { badgeClass = 'bg-red-50 text-red-700'; badgeText = 'Expired'; }
               else if (isExpiring) { badgeClass = 'bg-amber-50 text-amber-700'; badgeText = 'Expiring'; }
               else { badgeClass = 'bg-emerald-50 text-emerald-700'; badgeText = 'Valid'; }
             } %>
          <a href="/w/hr/documents/<%= doc.id %>" target="_blank" rel="noopener" class="flex items-start gap-3 p-4 hover:bg-gray-50 active:bg-gray-100 transition">
            <div class="w-10 h-10 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center flex-shrink-0">
              <% if (isImage) { %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <% } else if (isPdf) { %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              <% } else { %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              <% } %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-2">
                <p class="text-sm font-medium text-gray-900 truncate"><%= doc.document_name || doc.original_name %></p>
                <% if (badgeText) { %>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold flex-shrink-0 <%= badgeClass %>"><%= badgeText %></span>
                <% } %>
              </div>
              <div class="text-xs text-gray-500 mt-0.5 space-y-0.5">
                <p class="capitalize"><%= (doc.document_type || 'other').replace(/_/g, ' ') %></p>
                <% if (doc.expiry_date) { %>
                  <p>Expires <%= new Date(doc.expiry_date).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
                <% } %>
                <% if (doc.verification_status === 'pending') { %>
                  <p class="text-amber-600">Pending office verification</p>
                <% } else if (doc.verification_status === 'rejected') { %>
                  <p class="text-red-600">Rejected — contact office</p>
                <% } %>
              </div>
            </div>
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- Induction -->
  <% if (member && member.induction_date) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Induction</h3>
      <p class="text-sm text-gray-700">Completed <%= new Date(member.induction_date).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
    </div>
  <% } %>
</div>
