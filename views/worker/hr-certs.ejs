<div class="space-y-5">
  <a href="/w/hr" class="inline-flex items-center text-sm text-brand-600 font-medium">
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to HR
  </a>

  <h1 class="text-xl font-bold text-gray-900">My Wallet</h1>
  <p class="text-xs text-gray-500 -mt-3">Licences, certifications and documents the office has on file.</p>

  <% if (typeof pendingSigVocs !== 'undefined' && pendingSigVocs && pendingSigVocs.length > 0) { %>
    <!-- Awaiting-signature panel — hoisted above the regular wallet     -->
    <!-- so the worker sees the CTA the moment they open the page.       -->
    <!-- Each row links to the sign canvas; once signed the row falls    -->
    <!-- out of this panel and joins the regular VOC list below.         -->
    <div class="bg-amber-50 border-2 border-amber-300 rounded-xl shadow-sm overflow-hidden" data-attention="amber">
      <div class="px-4 py-3 bg-amber-100/60 border-b border-amber-200 flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <h2 class="text-sm font-bold text-amber-900">Awaiting your signature</h2>
        <span class="ml-auto inline-flex items-center px-1.5 py-0.5 rounded-full bg-amber-200 text-amber-900 text-[10px] font-bold tracking-wider"><%= pendingSigVocs.length %></span>
      </div>
      <div class="divide-y divide-amber-200">
        <% pendingSigVocs.forEach(function(v) { %>
          <div class="p-4">
            <div class="flex items-start justify-between gap-2 mb-2">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-amber-900"><%= v.equipment_name %></p>
                <p class="text-[11px] text-amber-700 mt-0.5">
                  Issued <%= new Date(v.assessment_date).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' }) %>
                  <% if (v.voc_number) { %> · <span class="font-mono"><%= v.voc_number %></span><% } %>
                </p>
              </div>
            </div>
            <p class="text-xs text-amber-800 mb-3 leading-relaxed">Your trainer issued this VOC without your signature. Tap below to sign and acknowledge — the cert PDF will update once you do.</p>
            <a href="/w/hr/vocs/<%= v.id %>/sign"
               class="inline-flex items-center justify-center gap-1.5 w-full px-3 py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-bold rounded-lg">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
              Sign now
            </a>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Crew Member Licence -->
  <% if (member && member.licence_type) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Traffic Control Licence</h3>
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium text-gray-900"><%= member.licence_type %></span>
        <% if (member.licence_expiry) { %>
          <% const exp = new Date(member.licence_expiry); const now = new Date(); const isExpired = exp < now; const isExpiring = !isExpired && exp < new Date(Date.now() + 30*24*60*60*1000); %>
          <span <% if (isExpired) { %>data-attention="rose"<% } %> class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold
            <%= isExpired ? 'bg-red-50 text-red-700' : isExpiring ? 'bg-amber-50 text-amber-700' : 'bg-emerald-50 text-emerald-700' %>">
            <%= isExpired ? 'Expired' : isExpiring ? 'Expiring Soon' : 'Valid' %> &middot; <%= exp.toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' }) %>
          </span>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Competencies -->
  <% if (certs.length === 0) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 text-center">
      <p class="text-gray-500 text-sm">No certifications on record</p>
      <p class="text-xs text-gray-400 mt-1">Contact admin to add your qualifications</p>
    </div>
  <% } else { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm divide-y divide-gray-100">
      <% certs.forEach(c => { %>
        <div class="p-4">
          <div class="flex items-center justify-between mb-1">
            <p class="text-sm font-medium text-gray-900"><%= c.competency_name || c.comp_type %></p>
            <% if (c.expiry_date) { %>
              <% const exp = new Date(c.expiry_date); const now = new Date(); const isExpired = exp < now; const isExpiring = !isExpired && exp < new Date(Date.now() + 30*24*60*60*1000); %>
              <span <% if (isExpired) { %>data-attention="rose"<% } %> class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold
                <%= isExpired ? 'bg-red-50 text-red-700' : isExpiring ? 'bg-amber-50 text-amber-700' : 'bg-emerald-50 text-emerald-700' %>">
                <%= isExpired ? 'Expired' : isExpiring ? 'Expiring' : 'Valid' %>
              </span>
            <% } else { %>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-gray-100 text-gray-600">No Expiry</span>
            <% } %>
          </div>
          <div class="text-xs text-gray-500 space-y-0.5">
            <% if (c.cert_number) { %><p>Cert #: <%= c.cert_number %></p><% } %>
            <% if (c.issuing_authority) { %><p>Issued by: <%= c.issuing_authority %></p><% } %>
            <% if (c.expiry_date) { %><p>Expires: <%= new Date(c.expiry_date).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' }) %></p><% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <!-- Documents &mdash; files uploaded via recruitment approval or manually by office.
       Each row shows a live preview underneath (image inline, PDF rendered
       client-side via /js/worker-pdf-viewer.js) so workers can flash the
       document on site without leaving the app shell. -->
  <% if (typeof documents !== 'undefined' && documents && documents.length > 0) { %>
    <% var hasPreviewablePdf = documents.some(function (d) {
         var ext = ((d.original_name || d.filename || '').split('.').pop() || '').toLowerCase();
         return ext === 'pdf';
       }); %>
    <style>
      .wd-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px; }
      .wd-row { display: flex; align-items: flex-start; gap: 10px; }
      .wd-icon { width: 36px; height: 36px; border-radius: 8px; background: #eff6ff; color: #059669; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
      .wd-title { font-size: 0.9rem; font-weight: 600; color: #111827; word-break: break-word; }
      .wd-meta { font-size: 0.72rem; color: #6b7280; margin-top: 2px; }
      .wd-meta p { margin: 1px 0; }
      .wd-badge { display: inline-flex; align-items: center; padding: 2px 6px; border-radius: 4px; font-size: 0.65rem; font-weight: 700; flex-shrink: 0; }
      .wd-actions { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
      .wd-action {
        display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px;
        background: #f3f4f6; color: #374151; font-weight: 600; font-size: 0.72rem;
        border-radius: 8px; text-decoration: none;
      }
      .wd-action:active { background: #e5e7eb; }
      .wd-preview { margin-top: 12px; border-radius: 10px; overflow: hidden; background: #f9fafb; border: 1px solid #e5e7eb; }
      .wd-preview img { display: block; width: 100%; height: auto; }
      .wd-preview .pdf-viewer { padding: 6px; }
    </style>
    <div>
      <h2 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Documents on File</h2>
      <div class="space-y-3">
        <% documents.forEach(doc => { %>
          <% const ext = ((doc.original_name || doc.filename || '').split('.').pop() || '').toLowerCase(); %>
          <% const isImage = ['jpg','jpeg','png','gif','webp','bmp','svg','avif','heic','heif'].includes(ext); %>
          <% const isPdf = ext === 'pdf'; %>
          <% let badgeClass = 'bg-gray-100 text-gray-600'; let badgeText = ''; %>
          <% if (doc.expiry_date) {
               const exp = new Date(doc.expiry_date);
               const now = new Date();
               const isExpired = exp < now;
               const isExpiring = !isExpired && exp < new Date(Date.now() + 30*24*60*60*1000);
               if (isExpired) { badgeClass = 'bg-red-50 text-red-700'; badgeText = 'Expired'; }
               else if (isExpiring) { badgeClass = 'bg-amber-50 text-amber-700'; badgeText = 'Expiring'; }
               else { badgeClass = 'bg-emerald-50 text-emerald-700'; badgeText = 'Valid'; }
             } %>
          <div class="wd-card">
            <div class="wd-row">
              <div class="wd-icon">
                <% if (isImage) { %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <% } else if (isPdf) { %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <% } else { %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                <% } %>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2">
                  <p class="wd-title"><%= doc.document_name || doc.original_name %></p>
                  <% if (badgeText) { %>
                    <span class="wd-badge <%= badgeClass %>"><%= badgeText %></span>
                  <% } %>
                </div>
                <div class="wd-meta">
                  <p class="capitalize"><%= (doc.document_type || 'other').replace(/_/g, ' ') %></p>
                  <% if (doc.expiry_date) { %>
                    <p>Expires <%= new Date(doc.expiry_date).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' }) %></p>
                  <% } %>
                  <% if (doc.verification_status === 'pending') { %>
                    <p class="text-amber-600">Pending office verification</p>
                  <% } else if (doc.verification_status === 'rejected') { %>
                    <p class="text-red-600">Rejected &mdash; contact office</p>
                  <% } %>
                </div>
              </div>
            </div>

            <% if (isImage) { %>
              <div class="wd-preview">
                <img src="/w/hr/documents/<%= doc.id %>?inline=1" loading="lazy" decoding="async" alt="<%= doc.document_name || doc.original_name %>">
              </div>
            <% } else if (isPdf) { %>
              <div class="wd-preview">
                <div class="pdf-viewer"
                     data-pdf-src="/w/hr/documents/<%= doc.id %>?inline=1"
                     data-pdf-name="<%= (doc.original_name || doc.document_name || 'document.pdf') %>"></div>
              </div>
            <% } %>

            <div class="wd-actions">
              <a href="/w/hr/documents/<%= doc.id %>?inline=1" download="<%= doc.original_name || doc.document_name %>" class="wd-action">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m-7 7h8a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v13a2 2 0 002 2z"/></svg>
                Save
              </a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
    <% if (hasPreviewablePdf) { %>
      <script src="/js/worker-pdf-viewer.js?v=7"></script>
    <% } %>
  <% } %>

  <!-- VOCs (Verifications of Competency) -->
  <% if (typeof vocs !== 'undefined' && vocs && vocs.length > 0) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <div class="px-4 py-3 border-b border-gray-100">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Verifications of Competency</h3>
        <p class="text-[11px] text-gray-400 mt-0.5">In-house equipment / operations sign-offs from your trainer.</p>
      </div>
      <div class="divide-y divide-gray-100">
        <% vocs.forEach(function(v) {
          const exp = v.valid_until ? new Date(v.valid_until) : null;
          const now = new Date();
          const isExpired = exp && exp < now;
          const isExpiring = exp && !isExpired && (exp - now) < 30 * 24 * 60 * 60 * 1000;
          const isRevoked = v.certificate_status === 'revoked';
          const isNYC = v.outcome === 'nyc';
          const needsSig = v.outcome === 'competent' && !isRevoked && v.worker_acknowledgement_status === 'pending';
          let pillClass = 'bg-emerald-50 text-emerald-700';
          let pillLabel = 'Valid';
          if (isRevoked) { pillClass = 'bg-gray-100 text-gray-600'; pillLabel = 'Revoked'; }
          else if (isNYC) { pillClass = 'bg-orange-50 text-orange-700'; pillLabel = 'Not Yet Competent'; }
          else if (isExpired) { pillClass = 'bg-red-50 text-red-700'; pillLabel = 'Expired'; }
          else if (needsSig) { pillClass = 'bg-amber-50 text-amber-700'; pillLabel = 'Awaiting your signature'; }
          else if (isExpiring) { pillClass = 'bg-amber-50 text-amber-700'; pillLabel = 'Expiring Soon'; }
        %>
          <div class="p-4">
            <div class="flex items-start justify-between gap-2 mb-1">
              <div>
                <p class="text-sm font-medium text-gray-900"><%= v.equipment_name %></p>
                <% if (v.voc_number) { %><p class="text-[10px] text-gray-400 font-mono mt-0.5"><%= v.voc_number %></p><% } %>
              </div>
              <span <% if (isExpired || isRevoked || isNYC) { %>data-attention="rose"<% } %> class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold flex-shrink-0 <%= pillClass %>">
                <%= pillLabel %>
              </span>
            </div>
            <div class="text-xs text-gray-500 space-y-0.5">
              <% if (v.assessment_date) { %><p>Assessed: <%= new Date(v.assessment_date).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' }) %></p><% } %>
              <% if (v.valid_until && !isNYC) { %><p>Valid until: <%= new Date(v.valid_until).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' }) %></p><% } %>
              <% if (v.certificate_id) { %><p>Certificate: <span class="font-mono"><%= v.certificate_id %></span></p><% } %>
            </div>
            <% if (v.outcome === 'competent' && v.certificate_id && !isRevoked) { %>
              <div class="mt-3 flex flex-wrap gap-2">
                <a href="/w/hr/vocs/<%= v.id %>/pdf" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-50 text-brand-700 hover:bg-brand-100 text-xs font-semibold rounded-md">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                  Download Certificate
                </a>
                <a href="/voc/verify/<%= encodeURIComponent(v.certificate_id) %>" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-50 text-gray-700 hover:bg-gray-100 text-xs font-semibold rounded-md">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  Verify Page
                </a>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- Induction -->
  <% if (member && member.induction_date) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Induction</h3>
      <p class="text-sm text-gray-700">Completed <%= new Date(member.induction_date).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
    </div>
  <% } %>
</div>
