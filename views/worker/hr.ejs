<div class="space-y-5">
  <div>
    <h1 class="text-xl font-bold text-gray-900">HR & My Info</h1>
    <p class="text-sm text-gray-500 mt-0.5">Personal records & self-service</p>
  </div>

  <%
    // "Your rate" card — surfaces THIS worker's tier + stamped rates so
    // they can confirm what they should be paid without ringing the
    // office. We only ever show their own row; the wage panel itself
    // stays management-only. Rate rows shown depend on the worker's
    // payment_type so we don't display empty $0 cells.
    const pt = employee && employee.payment_type ? employee.payment_type.toLowerCase() : '';
    const fmt = (v) => v == null || isNaN(parseFloat(v)) ? '—' : '$' + (parseFloat(v) || 0).toFixed(2);
    function rateRow(label, val, sub) {
      const v = parseFloat(val);
      if (!isFinite(v) || v <= 0) return '';
      return `
        <div class="flex items-baseline justify-between py-1.5">
          <div>
            <p class="text-sm text-gray-700">${label}</p>
            ${sub ? `<p class="text-[10px] text-gray-400">${sub}</p>` : ''}
          </div>
          <p class="text-base font-semibold text-gray-900 tabular-nums">${fmt(val)}<span class="text-[10px] text-gray-400 font-normal ml-0.5">/hr</span></p>
        </div>
      `;
    }
    function allowanceRow(label, val, unit, sub) {
      const v = parseFloat(val);
      if (!isFinite(v) || v <= 0) return '';
      return `
        <div class="flex items-baseline justify-between py-1.5">
          <div>
            <p class="text-sm text-gray-700">${label}</p>
            ${sub ? `<p class="text-[10px] text-gray-400">${sub}</p>` : ''}
          </div>
          <p class="text-base font-semibold text-gray-900 tabular-nums">${fmt(val)}<span class="text-[10px] text-gray-400 font-normal ml-0.5">/${unit}</span></p>
        </div>
      `;
    }

    const PT_LABEL = { cash: 'Cash', abn: 'ABN (contractor)', tfn: 'TFN / Award (casual)' };
    const NIGHT_PATTERN_LABEL = {
      occasional: 'Night — occasional roster',
      permanent: 'Night — permanent roster',
      continuous_5plus: 'Night — continuous 5+',
    };
  %>

  <% if (employee) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 sm:p-5">
      <div class="flex items-start justify-between gap-2 mb-3">
        <div>
          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Your rate</p>
          <% if (tierMeta && employee.tier) { %>
            <p class="text-base font-bold text-gray-900 mt-0.5">Tier <%= employee.tier %> · <%= tierMeta.role_label %></p>
            <p class="text-[11px] text-gray-500 mt-0.5"><%= tierMeta.qualifications %></p>
          <% } else { %>
            <p class="text-base font-bold text-gray-900 mt-0.5">Rate on file</p>
            <p class="text-[11px] text-amber-600 mt-0.5">Tier not yet assigned — speak to your supervisor.</p>
          <% } %>
        </div>
        <% if (pt) { %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-brand-50 text-brand-700 ring-1 ring-brand-200 whitespace-nowrap"><%= PT_LABEL[pt] || pt.toUpperCase() %></span>
        <% } %>
      </div>

      <div class="divide-y divide-gray-100">
        <% if (pt === 'cash') { %>
          <%- rateRow('Day / Sat',           employee.rate_day,           'Mon–Sat ordinary') %>
          <%- rateRow('Night / Sun / PH',    employee.rate_night,         'After 6pm, Sun & PH') %>
          <%- allowanceRow('Travel allowance', employee.rate_fares_daily, 'shift', 'Per shift, flat (not paid when you have a ute)') %>
        <% } else if (pt === 'abn') { %>
          <%- rateRow('Day',                 employee.rate_day,           'Mon–Fri ordinary') %>
          <%- rateRow('Sat',                 employee.rate_weekend,       'Saturday') %>
          <%- rateRow('Night / Sun / PH',    employee.rate_night,         'After 6pm, Sun & PH') %>
          <%- allowanceRow('Travel allowance', employee.rate_fares_daily, 'shift', 'Per shift, flat (not paid when you have a ute)') %>
        <% } else if (pt === 'tfn') { %>
          <%- rateRow('Day (base)',          employee.rate_day,           'Mon–Fri ordinary — incl. industry allowance + 25% casual loading') %>
          <% if (parseFloat(employee.rate_ot) > 0) { %>
            <%- rateRow('Day OT',            employee.rate_ot,            'After 8hrs') %>
          <% } %>
          <% if (parseFloat(employee.rate_dt) > 0) { %>
            <%- rateRow('Day DT',            employee.rate_dt,            'After 10hrs') %>
          <% } %>
          <%
            const npLbl = NIGHT_PATTERN_LABEL[employee.night_pattern] || 'Night';
          %>
          <%- rateRow(npLbl, employee.rate_night, 'After 6pm') %>
          <% if (parseFloat(employee.rate_night_5plus) > 0) { %>
            <%- rateRow('Night 5+', employee.rate_night_5plus, 'When 5+ nights in a row Mon–Fri — applied automatically') %>
          <% } %>

          <%
            // "Night 5+ active this period" callout — fires when the
            // server-side detector has found a 5+ Mon–Fri night run in
            // the last 14 days of this worker's allocations.
            if (typeof nightRunActive !== 'undefined' && nightRunActive) {
              const fmtD = iso => new Date(iso + 'T00:00:00').toLocaleDateString('en-AU', { day: 'numeric', month: 'short' });
          %>
            <div class="-mx-4 sm:-mx-5 mt-2 mb-1 px-4 sm:px-5 py-3 bg-amber-50 border-y border-amber-100">
              <div class="flex items-start gap-2.5">
                <div class="w-7 h-7 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-amber-900">Night 5+ rate active this period</p>
                  <p class="text-[11px] text-amber-800 mt-0.5 leading-snug">
                    You worked <%= nightRunActive.length %> nights in a row (<%= fmtD(nightRunActive.start_date) %>–<%= fmtD(nightRunActive.end_date) %>), so those shifts are paid at the lower Night 5+ rate ($<%= (parseFloat(employee.rate_night_5plus) || 0).toFixed(2) %>/hr) instead of the regular Night rate.
                  </p>
                </div>
              </div>
            </div>
          <% } %>
          <%- rateRow('Sat ≤2h / before 12pm', employee.rate_weekend_short, 'First 2 hours of a Saturday shift') %>
          <%- rateRow('Sat >2h / after 12pm',  employee.rate_weekend,       'Sat after 2h or starting from 12pm · Sun') %>
          <%- rateRow('Public holiday',        employee.rate_public_holiday) %>
          <%- allowanceRow('Fares allowance',  employee.rate_fares_daily, 'day', 'Paid each day worked') %>
          <%- allowanceRow('Meal allowance',   employee.rate_meal,        'meal', 'For travel jobs and shifts 9.5hrs+') %>
        <% } else { %>
          <p class="text-sm text-gray-500 py-2">No payment type set yet. The office will confirm with you at engagement.</p>
        <% } %>
      </div>

      <% if (pt === 'tfn' || pt === 'abn' || pt === 'cash') { %>
        <div class="mt-3 pt-3 border-t border-gray-100">
          <p class="text-[10px] text-gray-400 leading-relaxed">
            Rates above are what you'll be paid on your next pay run. Confirm with the office if anything looks off.
          </p>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Quick Stats -->
  <div class="grid grid-cols-2 gap-3">
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 text-center">
      <p class="text-2xl font-bold <%= expiringSoon > 0 ? 'text-amber-600' : 'text-emerald-600' %>"><%= certs.length %></p>
      <p class="text-[10px] text-gray-500 uppercase mt-1">Certifications</p>
      <% if (expiringSoon > 0) { %>
        <p class="text-[10px] text-amber-600 font-medium"><%= expiringSoon %> expiring soon</p>
      <% } %>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 text-center">
      <p class="text-2xl font-bold <%= pendingLeave > 0 ? 'text-amber-600' : 'text-gray-400' %>"><%= pendingLeave %></p>
      <p class="text-[10px] text-gray-500 uppercase mt-1">Pending Leave</p>
    </div>
  </div>

  <!-- Menu Items -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm divide-y divide-gray-100">
    <a href="/w/hr/certs" class="flex items-center justify-between p-4 active:bg-gray-50 transition">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-brand-50 flex items-center justify-center">
          <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Certifications & Licences</p>
          <p class="text-xs text-gray-500"><%= certs.length %> on record</p>
        </div>
      </div>
      <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
    <a href="/w/hr/leave" class="flex items-center justify-between p-4 active:bg-gray-50 transition">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center">
          <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Leave Requests</p>
          <p class="text-xs text-gray-500"><%= pendingLeave > 0 ? pendingLeave + ' pending' : 'No pending requests' %></p>
        </div>
      </div>
      <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
    <a href="/w/hr/payslips" class="flex items-center justify-between p-4 active:bg-gray-50 transition">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center">
          <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Payslips</p>
          <p class="text-xs text-gray-500">Every pay run, YTD totals</p>
        </div>
      </div>
      <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
    <a href="/w/hr/pay-runs" class="flex items-center justify-between p-4 active:bg-gray-50 transition">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Pay breakdown</p>
          <p class="text-xs text-gray-500">Hours, rates, allowances per run</p>
        </div>
      </div>
      <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
    <a href="/w/hr/bank" class="flex items-center justify-between p-4 active:bg-gray-50 transition">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-blue-50 flex items-center justify-center">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"/></svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Bank Account</p>
          <p class="text-xs text-gray-500">Encrypted — PIN required to edit</p>
        </div>
      </div>
      <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
    <a href="/w/hr/super" class="flex items-center justify-between p-4 active:bg-gray-50 transition">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-50 flex items-center justify-center">
          <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">Superannuation</p>
          <p class="text-xs text-gray-500">Fund, USI & member number</p>
        </div>
      </div>
      <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
    <a href="/w/hr/tfn" class="flex items-center justify-between p-4 active:bg-gray-50 transition">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-purple-50 flex items-center justify-center">
          <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        <div>
          <p class="text-sm font-medium text-gray-900">TFN Declaration</p>
          <p class="text-xs text-gray-500">Digital ATO NAT 3092</p>
        </div>
      </div>
      <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Employment Info -->
  <% if (employee) { %>
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Employment Details</h3>
      <div class="space-y-2 text-sm">
        <% if (employee.employee_number) { %>
          <div class="flex justify-between"><span class="text-gray-500">Employee #</span><span class="font-medium text-gray-900"><%= employee.employee_number %></span></div>
        <% } %>
        <% if (employee.position_title) { %>
          <div class="flex justify-between"><span class="text-gray-500">Position</span><span class="font-medium text-gray-900"><%= employee.position_title %></span></div>
        <% } %>
        <% if (employee.employment_type) { %>
          <div class="flex justify-between"><span class="text-gray-500">Type</span><span class="font-medium text-gray-900"><%= employee.employment_type.replace(/_/g, ' ') %></span></div>
        <% } %>
        <% if (employee.employment_start_date) { %>
          <div class="flex justify-between"><span class="text-gray-500">Start Date</span><span class="font-medium text-gray-900"><%= new Date(employee.employment_start_date).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' }) %></span></div>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- Basic Info from crew_members -->
  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
    <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-3">Your Details</h3>
    <div class="space-y-2 text-sm">
      <div class="flex justify-between"><span class="text-gray-500">Name</span><span class="font-medium text-gray-900"><%= member.full_name %></span></div>
      <% if (member.employee_id) { %>
        <div class="flex justify-between"><span class="text-gray-500">Employee ID</span><span class="font-medium text-gray-900"><%= member.employee_id %></span></div>
      <% } %>
      <% if (member.phone) { %>
        <div class="flex justify-between"><span class="text-gray-500">Phone</span><span class="font-medium text-gray-900"><%= member.phone %></span></div>
      <% } %>
      <% if (member.email) { %>
        <div class="flex justify-between"><span class="text-gray-500">Email</span><span class="font-medium text-gray-900"><%= member.email %></span></div>
      <% } %>
      <% if (member.role) { %>
        <div class="flex justify-between"><span class="text-gray-500">Role</span><span class="font-medium text-gray-900"><%= member.role.replace(/_/g, ' ') %></span></div>
      <% } %>
    </div>
  </div>
</div>
