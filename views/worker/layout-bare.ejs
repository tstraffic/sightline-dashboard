<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Atomis Crew">
  <meta name="theme-color" content="#0F1115">
  <meta name="color-scheme" content="light only">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="manifest" href="/manifest.json">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Atomis Crew</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: { extend: { fontFamily: { sans: ['Geist','Inter','system-ui','-apple-system','sans-serif'], display: ['"Bricolage Grotesque"','Geist','system-ui','sans-serif'], mono: ['"Geist Mono"','JetBrains Mono','ui-monospace','monospace'] }, colors: { brand: { 500: '#10B981', 600: '#059669' }, ts: { cyan: '#10B981', navy: '#0F1115' }, atomis: { base: '#0F1115', surface: '#1A1D24', text: '#F5F5F7', warning: '#FBBF24', danger: '#EF4444' } } } }
    }
  </script>
  <link rel="stylesheet" href="/css/worker.css?v=atomis-1">
</head>
<body class="worker-portal h-full font-sans antialiased" style="background: #0F1115; color: rgba(255,255,255,0.92); margin: 0;">

  <%- body %>

  <script src="/js/worker.js"></script>
  <%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
