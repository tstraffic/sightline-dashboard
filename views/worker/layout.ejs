<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <script>
    // Theme bootstrap — shares the 'atomis-theme' localStorage key with the
    // admin dashboard so a worker who toggles on one side carries it across.
    // Runs before render to prevent FOUC.
    (function () {
      // Resolve a theme *id* (e.g. 'aurora') from the shared key to its base
      // mode. The worker portal only uses light/dark, not the skins.
      var MODE = { daylight:'light', 'warm-paper':'light', 'mint-glass':'light' };
      function modeOf(id) { return id === 'light' ? 'light' : id === 'dark' ? 'dark' : (MODE[id] || 'dark'); }
      try {
        var saved = localStorage.getItem('atomis-theme');
        var id = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'daylight' : 'slate');
        document.documentElement.setAttribute('data-theme', modeOf(id));
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
    window.toggleAtomisTheme = function () {
      var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      var next = cur === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('atomis-theme', next === 'light' ? 'daylight' : 'slate'); } catch (e) {}
    };
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.theme-toggle');
      if (!btn) return;
      e.preventDefault();
      window.toggleAtomisTheme();
    });
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
  <!-- Layout strategy: body is a flex column locked to 100dvh with
       overflow hidden, so the visible viewport defines the bounds. The
       header and bottom nav are in-flow shrink-0 flex children sitting
       at top + bottom; main is flex-1 overflow-y-auto and owns the
       scroll. That means:
         - header stays pinned at the top automatically (it's outside
           the scroller), no position:sticky needed,
         - nav always hugs the bottom of the visible viewport on iOS,
           including when Safari shows/hides its URL bar (dvh tracks
           the visual viewport natively — no JS measurement),
         - PTR / scroll handlers can read main.scrollTop directly
           because main IS the scroll container.
       A prior version pinned body height via JS reading
       visualViewport.height at parse time; iOS returned a transient
       small value during page load and the body locked to it,
       leaving a white gap below the nav. Pure CSS dvh avoids that
       trap. -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="T&S Crew">
  <meta name="theme-color" content="#0F1115">
  <!-- Both schemes so native controls (date/time pickers, selects) adapt
       to whichever theme the page is in (set by the bootstrap above). -->
  <meta name="color-scheme" content="dark light">
  <style>
    /* Backstop: in dark mode keep form controls forced to light scheme so
       iOS doesn't auto-invert them. Light mode lets the browser pick. */
    :root[data-theme="dark"] input[type=text], :root[data-theme="dark"] input[type=number],
    :root[data-theme="dark"] input[type=tel], :root[data-theme="dark"] input[type=email],
    :root[data-theme="dark"] input[type=password], :root[data-theme="dark"] input[type=search],
    :root[data-theme="dark"] input[type=date], :root[data-theme="dark"] input[type=time],
    :root[data-theme="dark"] input[type=datetime-local], :root[data-theme="dark"] input[type=url],
    :root[data-theme="dark"] select, :root[data-theme="dark"] textarea {
      color-scheme: light;
    }
  </style>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="manifest" href="/manifest.json">
  <!-- Worker portal uses the light ("Inverted · on light") variant for
       browser tab favicon AND the iOS / Android home-screen install icon
       so the employee app reads as Snow-on-white. -->
  <link rel="icon" type="image/svg+xml" href="/images/atomis-favicon-light.svg">
  <link rel="apple-touch-icon" href="/images/atomis-apple-touch-icon-light.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/atomis-apple-touch-icon-light.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/atomis-icon-light-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/images/atomis-icon-light-512.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="T&S Crew">
  <meta name="theme-color" content="#0F1115">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>T&S Crew</title>

  <!-- Atomis typography: Bricolage Grotesque (display) · Geist (body/UI) · Geist Mono (technical) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Geist', 'Inter', 'system-ui', '-apple-system', 'sans-serif'],
            display: ['"Bricolage Grotesque"', 'Geist', 'system-ui', 'sans-serif'],
            mono: ['"Geist Mono"', 'JetBrains Mono', 'ui-monospace', 'monospace'],
          },
          colors: {
            brand: {
              50: '#ECFDF5', 100: '#D1FAE5', 200: '#A7F3D0', 300: '#6EE7B7',
              400: '#34D399', 500: '#10B981', 600: '#059669', 700: '#047857',
              800: '#065F46', 900: '#064E3B', 950: '#022C22',
            },
            atomis: {
              base: '#0F1115',
              surface: '#1A1D24',
              'surface-2': '#22262F',
              text: '#F5F5F7',
              'text-mute': '#8B8E95',
              'text-faint': '#5A5D64',
              warning: '#FBBF24',
              danger: '#EF4444',
            },
            /* Legacy aliases — preserved so existing markup using ts-cyan /
               ts-navy resolves to the Atomis palette without a code change. */
            ts: { cyan: '#10B981', navy: '#0F1115' }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/custom.css?v=atomis-6">
  <link rel="stylesheet" href="/css/worker.css?v=atomis-14">
  <link rel="stylesheet" href="/css/worker-design.css?v=atomis-3">
  <link rel="stylesheet" href="/css/chat.css?v=atomis-1">
</head>
<body class="worker-portal font-sans antialiased flex flex-col" style="height: 100dvh; overflow: hidden;">

  <%- include('../partials/staging-badge') %>

  <!-- Ambient background — drifting blurred orbs in the brand palette.
       Replaces the prior static radial wash. See partial for details. -->
  <%- include('./partials/ambient-background') %>
  <style>
    /* Keep header + main above the ambient layer's stacking context.
       Do NOT touch nav or .wh-ptr — they already carry their own
       position: fixed (Tailwind .fixed on nav, inline on .wh-ptr) and
       forcing position: relative here broke the bottom nav's anchoring
       on real phones, causing main's reserved padding-bottom to double
       up with the now-in-flow nav. */
    body.worker-portal > header,
    body.worker-portal > main { position: relative; z-index: 1; }
    /* Custom pull-to-refresh indicator. Driven by /js/worker-pull-refresh.js
       which sets transform + opacity directly during the drag. The three
       state classes layer on top: default, .wh-ptr-armed (worker pulled
       past the threshold), and .wh-ptr-refreshing (released armed → spin
       + reload). */
    .wh-ptr {
      position: fixed; top: 0; left: 50%;
      transform: translate(-50%, 0);
      width: 34px; height: 34px;
      border-radius: 50%;
      background: #22262F;
      border: 1px solid rgba(255,255,255,0.10);
      display: flex; align-items: center; justify-content: center;
      z-index: 80;
      opacity: 0;
      pointer-events: none;
      box-shadow: 0 6px 14px rgba(0,0,0,0.4);
    }
    .wh-ptr-spinner {
      width: 14px; height: 14px;
      border-radius: 50%;
      border: 2px solid rgba(16,185,129,0.25);
      border-top-color: #10B981;
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .wh-ptr-armed { border-color: rgba(16,185,129,0.6); background: rgba(16,185,129,0.12); }
    .wh-ptr-armed .wh-ptr-spinner { transform: scale(1.15); }
    .wh-ptr-refreshing .wh-ptr-spinner { animation: wh-ptr-spin 0.8s linear infinite; }
    @keyframes wh-ptr-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      .wh-ptr-refreshing .wh-ptr-spinner { animation: none; }
    }
  </style>

  <!-- Top Header — Atomis charcoal in dark mode, white in light mode (see
       worker.css overrides for `.wh-header`). Covers the iOS safe-area-top
       zone so the notch reads as the header rather than empty body. -->
  <header class="wh-header shrink-0 safe-area-top">
    <div class="flex items-center justify-between px-3 h-11 gap-2">
      <div class="flex items-center gap-2 shrink-0">
        <% if (typeof worker !== 'undefined' && worker) { %>
          <a href="/w/profile" aria-label="Profile" class="wh-header-avatar w-7 h-7 flex items-center justify-center text-[10px] font-semibold active:scale-95 transition" style="border-radius:6px">
            <%= worker.full_name.split(' ').map(n => n[0]).join('').slice(0,2) %>
          </a>
        <% } else { %>
          <div class="w-7"></div>
        <% } %>
        <a href="/w/home" aria-label="Home" class="wh-header-brand">
          <img class="wh-header-brand-dark" src="/images/ts-logo-white.png" alt="T&amp;S">
          <img class="wh-header-brand-light" src="/images/logo-colour.png" alt="T&amp;S">
        </a>
      </div>
      <div class="text-center min-w-0 flex-1">
        <p class="wh-header-title text-sm font-medium truncate" style="font-family:'Bricolage Grotesque',Geist,sans-serif;letter-spacing:-0.015em"><%= typeof title !== 'undefined' ? title : 'Home' %></p>
        <% if (typeof worker !== 'undefined' && worker) { %>
          <p class="wh-header-sub text-[10px] truncate" style="font-family:'Geist Mono',monospace;letter-spacing:0.04em"><%= worker.full_name %></p>
        <% } %>
      </div>
      <div class="flex items-center gap-0.5 shrink-0">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="wh-header-btn w-8 h-8 flex items-center justify-center transition" aria-label="Back to office" title="Back to office dashboard">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </a>
        <% } %>
        <button type="button" class="theme-toggle wh-header-btn w-8 h-8 flex items-center justify-center transition" aria-label="Toggle theme" title="Toggle light/dark theme">
          <svg class="icon-moon w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="icon-sun w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <button onclick="location.reload()" class="wh-header-btn w-8 h-8 flex items-center justify-center transition" aria-label="Reload">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Flash Messages -->
  <% if ((typeof flash_success !== 'undefined' && flash_success && flash_success.length > 0) || (typeof flash_error !== 'undefined' && flash_error && flash_error.length > 0)) { %>
  <div class="px-4 pt-2">
    <% if (typeof flash_success !== 'undefined' && flash_success) { flash_success.forEach(msg => { %>
      <div class="mb-2 p-3 rounded-lg text-sm flex items-center justify-between" style="background: rgba(22,163,74,0.12); border: 1px solid rgba(22,163,74,0.25); color: #4ade80;">
        <span><%= msg %></span>
        <button onclick="this.parentElement.remove()" class="ml-2 opacity-60">&times;</button>
      </div>
    <% }) } %>
    <% if (typeof flash_error !== 'undefined' && flash_error) { flash_error.forEach(msg => { %>
      <div class="mb-2 p-3 rounded-lg text-sm flex items-center justify-between" style="background: rgba(220,38,38,0.12); border: 1px solid rgba(220,38,38,0.25); color: #f87171;">
        <span><%= msg %></span>
        <button onclick="this.parentElement.remove()" class="ml-2 opacity-60">&times;</button>
      </div>
    <% }) } %>
  </div>
  <% } %>

  <!-- Main Content — centred mobile-width column on desktop so the portal
       doesn't look empty on wide screens. Padding-inline picks up the
       safe-area on devices with notches / Dynamic Island so content
       doesn't get cropped against the curved edges. Main owns the scroll
       (overflow-y-auto); body is locked to 100dvh with overflow hidden,
       and header + nav are in-flow flex children. That means the header
       stays pinned at the top by virtue of being outside the scroller,
       and the nav always hugs the visible bottom even when Safari's
       URL bar appears or the device's "Show tab bar" setting changes
       the viewport — without any JS measurement. -->
  <main class="flex-1 w-full max-w-[520px] mx-auto overflow-y-auto" style="padding-left: env(safe-area-inset-left, 0px); padding-right: env(safe-area-inset-right, 0px);">
    <%- body %>
  </main>

  <!-- Bottom Tab Navigation: Home, Jobs, Forms, Feed, Safety, More.
       Traffic control crews don't use a clock in/out flow — proof of
       attendance is the pre-start toolbox checklist + the docket. So the
       centre slot is "Forms", which is the busiest field action.
       Wallet / Leave / Profile / Settings collapse into More. Six tabs
       fit at 360px+ with labels; we hide labels below that. -->
  <style>
    @media (max-width: 360px) {
      nav.wh-tabnav span.wh-tab-label { display: none; }
    }
    /* Tab bar polish: active-indicator pill that springs between tabs,
       icon scales up on the active tab. */
    .wh-tab-bar { position: relative; }
    .wh-tab-indicator {
      position: absolute;
      bottom: 4px;
      height: 2px;
      left: 0;
      background: #10B981;
      border-radius: 2px;
      pointer-events: none;
      transform: translateX(var(--wh-tab-x, 0)) translateX(-50%);
      width: var(--wh-tab-w, 24px);
      transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
                  width 320ms cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 200ms ease;
      opacity: 0;
    }
    .wh-tab-bar[data-tab-ready] .wh-tab-indicator { opacity: 1; }
    /* Active icon scale + idle micro-pulse on the active tab. Pure CSS. */
    .wh-tab-bar a svg {
      transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
                  color 180ms ease;
      transform-origin: 50% 60%;
    }
    .wh-tab-bar a.is-active svg { transform: scale(1.12); }
    .wh-tab-bar a:active svg { transform: scale(0.92); }
    @media (prefers-reduced-motion: reduce) {
      .wh-tab-indicator { transition: none; }
      .wh-tab-bar a svg { transition: none; }
    }
  </style>
  <!-- In-flow flex child (NOT position: fixed). Sits at the true visible
       bottom of the dynamic viewport — including when iOS Safari's URL
       bar shows/hides, where a fixed-positioned bar anchors to the
       layout viewport and floats above the actual screen edge.
       padding-bottom honours the iOS home-indicator safe area so the
       nav's background still reaches the screen edge while the tap
       targets sit above the indicator gesture zone. -->
  <nav class="wh-tabnav shrink-0 z-50" style="padding-left: env(safe-area-inset-left, 0px); padding-right: env(safe-area-inset-right, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);">
    <div class="flex items-end justify-around h-14 px-0.5 max-w-[520px] mx-auto wh-tab-bar" id="wh-tab-bar">
      <span class="wh-tab-indicator" aria-hidden="true"></span>
      <% const cp = typeof currentPage !== 'undefined' ? currentPage : ''; %>
      <% const moreActive = ['more','profile','hr','wallet','leave','timesheets','availability','dockets','customise','chat','clock'].includes(cp); %>

      <!-- Home -->
      <a href="/w/home" data-haptic data-tab="home" class="<%= cp === 'home' ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'home' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Home</span>
      </a>

      <!-- Jobs -->
      <a href="/w/jobs" data-haptic data-tab="jobs" class="<%= (cp === 'jobs' || cp === 'shifts') ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'jobs' || cp === 'shifts' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Jobs</span>
      </a>

      <!-- Forms (centre, replaces Clock — see comment above the nav). -->
      <a href="/w/forms" data-haptic data-tab="forms" class="<%= cp === 'forms' ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'forms' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Forms</span>
      </a>

      <!-- Feed -->
      <a href="/w/feed" data-haptic data-tab="feed" class="<%= cp === 'feed' ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'feed' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Feed</span>
      </a>

      <!-- Safety -->
      <a href="/w/safety" data-haptic data-tab="safety" class="<%= cp === 'safety' ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'safety' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Safety</span>
      </a>

      <!-- More -->
      <a href="/w/more" data-haptic data-tab="more" class="<%= moreActive ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= moreActive ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">More</span>
      </a>
    </div>
  </nav>

  <%- include('./partials/offline-queue-banner') %>
  <%- include('./partials/submit-success') %>

  <script src="/js/worker.js?v=3"></script>
  <script src="/js/worker-native.js?v=1"></script>
  <script src="/js/chat.js?v=3"></script>
  <script src="/js/worker-haptics.js?v=1"></script>
  <!-- Motion One UMD — exposes window.Motion. Loaded synchronously so
       worker-motion.js below can wire animations during DOMContentLoaded. -->
  <script src="/vendor/motion/motion.js"></script>
  <script src="/js/worker-motion.js?v=3"></script>
  <script src="/js/worker-particles.js?v=8"></script>
  <script src="/js/worker-signature.js?v=2"></script>
  <!-- Shared signature drawing + brand-teal pen glow. The pad helper
       (WorkerSigPad) mirrors the docket-sign drawing so every worker form's
       pad behaves identically; the neon trail auto-attaches to any canvas
       carrying data-neon-trail. Loading globally so individual forms don't
       have to ship the same scripts each. -->
  <script src="/js/worker-sig-pad.js?v=2"></script>
  <script src="/js/sig-neon-trail.js?v=3"></script>
  <script src="/js/worker-pull-refresh.js?v=4"></script>
  <script src="/js/worker-tabbar.js?v=1"></script>
  <script src="/js/worker-offline-queue.js?v=1"></script>
  <script src="/js/worker-submit-success.js?v=2"></script>
  <script src="/js/worker-offline-form.js?v=5"></script>
  <%- typeof script !== 'undefined' ? script : '' %>

  <!-- IT Feedback widget — subtle + icon in the bottom-right that
       expands into the same modal admins see. Only renders when a
       worker is signed in. -->
  <% if (typeof worker !== 'undefined' && worker) { %>
    <%- include('../partials/feedback-widget', { fbMode: 'worker' }) %>
  <% } %>
</body>
</html>
