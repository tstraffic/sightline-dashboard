<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Atomis Crew">
  <meta name="theme-color" content="#0F1115">
  <!-- The worker portal mixes a dark page background with intentionally
       white form cards. Tell the browser we're rendering "light" form
       controls so iOS Safari / Chrome dark mode doesn't auto-invert input
       backgrounds (which made text fields look like blank white blocks). -->
  <meta name="color-scheme" content="dark">
  <style>
    /* Backstop: any input/select/textarea inside a worker form must use a
       white bg + dark text regardless of OS dark-mode. The Tailwind classes
       on each input set this too — these rules just make the floor explicit. */
    input[type=text], input[type=number], input[type=tel], input[type=email],
    input[type=password], input[type=search], input[type=date], input[type=time],
    input[type=datetime-local], input[type=url], select, textarea {
      color-scheme: light;
    }
  </style>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="manifest" href="/manifest.json">
  <!-- Worker portal uses the light ("Inverted · on light") variant for
       browser tab favicon AND the iOS / Android home-screen install icon
       so the employee app reads as Snow-on-white. -->
  <link rel="icon" type="image/svg+xml" href="/images/atomis-favicon-light.svg">
  <link rel="apple-touch-icon" href="/images/atomis-apple-touch-icon-light.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/atomis-apple-touch-icon-light.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/atomis-icon-light-192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/images/atomis-icon-light-512.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Atomis Crew">
  <meta name="theme-color" content="#0F1115">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Atomis Crew</title>

  <!-- Atomis typography: Bricolage Grotesque (display) · Geist (body/UI) · Geist Mono (technical) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Geist', 'Inter', 'system-ui', '-apple-system', 'sans-serif'],
            display: ['"Bricolage Grotesque"', 'Geist', 'system-ui', 'sans-serif'],
            mono: ['"Geist Mono"', 'JetBrains Mono', 'ui-monospace', 'monospace'],
          },
          colors: {
            brand: {
              50: '#ECFDF5', 100: '#D1FAE5', 200: '#A7F3D0', 300: '#6EE7B7',
              400: '#34D399', 500: '#10B981', 600: '#059669', 700: '#047857',
              800: '#065F46', 900: '#064E3B', 950: '#022C22',
            },
            atomis: {
              base: '#0F1115',
              surface: '#1A1D24',
              'surface-2': '#22262F',
              text: '#F5F5F7',
              'text-mute': '#8B8E95',
              'text-faint': '#5A5D64',
              warning: '#FBBF24',
              danger: '#EF4444',
            },
            /* Legacy aliases — preserved so existing markup using ts-cyan /
               ts-navy resolves to the Atomis palette without a code change. */
            ts: { cyan: '#10B981', navy: '#0F1115' }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/custom.css?v=atomis-1">
  <link rel="stylesheet" href="/css/worker.css?v=atomis-1">
  <link rel="stylesheet" href="/css/worker-design.css?v=atomis-1">
  <link rel="stylesheet" href="/css/chat.css?v=atomis-1">
</head>
<body class="worker-portal h-full font-sans antialiased flex flex-col" style="color: rgba(255,255,255,0.92);">

  <!-- Ambient background — drifting blurred orbs in the brand palette.
       Replaces the prior static radial wash. See partial for details. -->
  <%- include('./partials/ambient-background') %>
  <style>
    /* Keep header + main above the ambient layer's stacking context.
       Do NOT touch nav or .wh-ptr — they already carry their own
       position: fixed (Tailwind .fixed on nav, inline on .wh-ptr) and
       forcing position: relative here broke the bottom nav's anchoring
       on real phones, causing main's reserved padding-bottom to double
       up with the now-in-flow nav. */
    body.worker-portal > header,
    body.worker-portal > main { position: relative; z-index: 1; }
    /* Custom pull-to-refresh indicator. Driven by /js/worker-pull-refresh.js
       which sets transform + opacity directly during the drag. The three
       state classes layer on top: default, .wh-ptr-armed (worker pulled
       past the threshold), and .wh-ptr-refreshing (released armed → spin
       + reload). */
    .wh-ptr {
      position: fixed; top: 0; left: 50%;
      transform: translate(-50%, 0);
      width: 34px; height: 34px;
      border-radius: 50%;
      background: #22262F;
      border: 1px solid rgba(255,255,255,0.10);
      display: flex; align-items: center; justify-content: center;
      z-index: 80;
      opacity: 0;
      pointer-events: none;
      box-shadow: 0 6px 14px rgba(0,0,0,0.4);
    }
    .wh-ptr-spinner {
      width: 14px; height: 14px;
      border-radius: 50%;
      border: 2px solid rgba(16,185,129,0.25);
      border-top-color: #10B981;
      transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .wh-ptr-armed { border-color: rgba(16,185,129,0.6); background: rgba(16,185,129,0.12); }
    .wh-ptr-armed .wh-ptr-spinner { transform: scale(1.15); }
    .wh-ptr-refreshing .wh-ptr-spinner { animation: wh-ptr-spin 0.8s linear infinite; }
    @keyframes wh-ptr-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      .wh-ptr-refreshing .wh-ptr-spinner { animation: none; }
    }
  </style>

  <!-- Top Header — Atomis charcoal. Covers the iOS safe-area-top zone so
       the notch reads as the header rather than empty body. -->
  <header class="shrink-0 safe-area-top" style="background: #14171D; border-bottom: 1px solid rgba(255,255,255,0.06);">
    <div class="flex items-center justify-between px-4 h-11">
      <% if (typeof worker !== 'undefined' && worker) { %>
        <a href="/w/profile" aria-label="Profile" class="w-8 h-8 flex items-center justify-center text-[11px] font-semibold shrink-0 active:scale-95 transition" style="background:#22262F;color:#F5F5F7;border:1px solid rgba(255,255,255,0.08);border-radius:6px">
          <%= worker.full_name.split(' ').map(n => n[0]).join('').slice(0,2) %>
        </a>
      <% } else { %>
        <div class="w-8"></div>
      <% } %>
      <div class="text-center">
        <p class="text-sm font-medium text-white" style="font-family:'Bricolage Grotesque',Geist,sans-serif;letter-spacing:-0.015em"><%= typeof title !== 'undefined' ? title : 'Home' %></p>
        <% if (typeof worker !== 'undefined' && worker) { %>
          <p class="text-[10px] text-gray-500 truncate max-w-[200px]" style="font-family:'Geist Mono',monospace;letter-spacing:0.04em"><%= worker.full_name %></p>
        <% } %>
      </div>
      <button onclick="location.reload()" class="w-8 h-8 flex items-center justify-center text-gray-500 hover:text-white transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      </button>
    </div>
  </header>

  <!-- Flash Messages -->
  <% if ((typeof flash_success !== 'undefined' && flash_success && flash_success.length > 0) || (typeof flash_error !== 'undefined' && flash_error && flash_error.length > 0)) { %>
  <div class="px-4 pt-2">
    <% if (typeof flash_success !== 'undefined' && flash_success) { flash_success.forEach(msg => { %>
      <div class="mb-2 p-3 rounded-lg text-sm flex items-center justify-between" style="background: rgba(22,163,74,0.12); border: 1px solid rgba(22,163,74,0.25); color: #4ade80;">
        <span><%= msg %></span>
        <button onclick="this.parentElement.remove()" class="ml-2 opacity-60">&times;</button>
      </div>
    <% }) } %>
    <% if (typeof flash_error !== 'undefined' && flash_error) { flash_error.forEach(msg => { %>
      <div class="mb-2 p-3 rounded-lg text-sm flex items-center justify-between" style="background: rgba(220,38,38,0.12); border: 1px solid rgba(220,38,38,0.25); color: #f87171;">
        <span><%= msg %></span>
        <button onclick="this.parentElement.remove()" class="ml-2 opacity-60">&times;</button>
      </div>
    <% }) } %>
  </div>
  <% } %>

  <!-- Main Content — centred mobile-width column on desktop so the portal
       doesn't look empty on wide screens -->
  <main class="flex-1 overflow-auto w-full max-w-[520px] mx-auto" style="padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));">
    <%- body %>
  </main>

  <!-- Bottom Tab Navigation: Home, Jobs, Forms, Feed, Safety, More.
       Traffic control crews don't use a clock in/out flow — proof of
       attendance is the pre-start toolbox checklist + the docket. So the
       centre slot is "Forms", which is the busiest field action.
       Wallet / Leave / Profile / Settings collapse into More. Six tabs
       fit at 360px+ with labels; we hide labels below that. -->
  <style>
    @media (max-width: 360px) {
      nav.fixed.bottom-0 span.wh-tab-label { display: none; }
    }
    /* Tab bar polish: active-indicator pill that springs between tabs,
       icon scales up on the active tab. */
    .wh-tab-bar { position: relative; }
    .wh-tab-indicator {
      position: absolute;
      bottom: 4px;
      height: 2px;
      left: 0;
      background: #10B981;
      border-radius: 2px;
      pointer-events: none;
      transform: translateX(var(--wh-tab-x, 0)) translateX(-50%);
      width: var(--wh-tab-w, 24px);
      transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
                  width 320ms cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 200ms ease;
      opacity: 0;
    }
    .wh-tab-bar[data-tab-ready] .wh-tab-indicator { opacity: 1; }
    /* Active icon scale + idle micro-pulse on the active tab. Pure CSS. */
    .wh-tab-bar a svg {
      transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
                  color 180ms ease;
      transform-origin: 50% 60%;
    }
    .wh-tab-bar a.is-active svg { transform: scale(1.12); }
    .wh-tab-bar a:active svg { transform: scale(0.92); }
    @media (prefers-reduced-motion: reduce) {
      .wh-tab-indicator { transition: none; }
      .wh-tab-bar a svg { transition: none; }
    }
  </style>
  <nav class="fixed bottom-0 left-0 right-0 z-50" style="background: #14171D; border-top: 1px solid rgba(255,255,255,0.06);">
    <div class="flex items-center justify-around h-16 px-0.5 max-w-[520px] mx-auto wh-tab-bar" id="wh-tab-bar">
      <span class="wh-tab-indicator" aria-hidden="true"></span>
      <% const cp = typeof currentPage !== 'undefined' ? currentPage : ''; %>
      <% const moreActive = ['more','profile','hr','wallet','leave','timesheets','availability','dockets','customise','chat','clock'].includes(cp); %>

      <!-- Home -->
      <a href="/w/home" data-haptic data-tab="home" class="<%= cp === 'home' ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'home' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Home</span>
      </a>

      <!-- Jobs -->
      <a href="/w/jobs" data-haptic data-tab="jobs" class="<%= (cp === 'jobs' || cp === 'shifts') ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'jobs' || cp === 'shifts' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Jobs</span>
      </a>

      <!-- Forms (centre, replaces Clock — see comment above the nav). -->
      <a href="/w/forms" data-haptic data-tab="forms" class="<%= cp === 'forms' ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'forms' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Forms</span>
      </a>

      <!-- Feed -->
      <a href="/w/feed" data-haptic data-tab="feed" class="<%= cp === 'feed' ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'feed' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Feed</span>
      </a>

      <!-- Safety -->
      <a href="/w/safety" data-haptic data-tab="safety" class="<%= cp === 'safety' ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= cp === 'safety' ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">Safety</span>
      </a>

      <!-- More -->
      <a href="/w/more" data-haptic data-tab="more" class="<%= moreActive ? 'is-active ' : '' %>flex flex-col items-center justify-center gap-0.5 flex-1 py-1.5 transition-colors <%= moreActive ? 'text-[#10B981]' : 'text-gray-500' %>">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
        </svg>
        <span class="wh-tab-label text-[10px] font-medium">More</span>
      </a>
    </div>
  </nav>

  <%- include('./partials/offline-queue-banner') %>
  <%- include('./partials/submit-success') %>

  <script src="/js/worker.js"></script>
  <script src="/js/chat.js?v=3"></script>
  <script src="/js/worker-haptics.js?v=1"></script>
  <!-- Motion One UMD — exposes window.Motion. Loaded synchronously so
       worker-motion.js below can wire animations during DOMContentLoaded. -->
  <script src="/vendor/motion/motion.js"></script>
  <script src="/js/worker-motion.js?v=3"></script>
  <script src="/js/worker-particles.js?v=7"></script>
  <script src="/js/worker-signature.js?v=1"></script>
  <script src="/js/worker-pull-refresh.js?v=4"></script>
  <script src="/js/worker-tabbar.js?v=1"></script>
  <script src="/js/worker-offline-queue.js?v=1"></script>
  <script src="/js/worker-submit-success.js?v=1"></script>
  <script src="/js/worker-offline-form.js?v=3"></script>
  <%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
