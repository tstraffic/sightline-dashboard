<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <script>
    // Theme bootstrap — shares the 'atomis-theme' localStorage key with the
    // admin dashboard + worker portal so the choice carries across.
    (function () {
      var MODE = { daylight:'light', 'warm-paper':'light', 'mint-glass':'light' }; // else dark
      function modeOf(id) { return id === 'light' ? 'light' : id === 'dark' ? 'dark' : (MODE[id] || 'dark'); }
      try {
        var saved = localStorage.getItem('atomis-theme');
        var id = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'daylight' : 'slate');
        document.documentElement.setAttribute('data-theme', modeOf(id));
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
    window.toggleAtomisTheme = function () {
      var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      var next = cur === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('atomis-theme', next === 'light' ? 'daylight' : 'slate'); } catch (e) {}
    };
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.theme-toggle');
      if (!btn) return;
      e.preventDefault();
      window.toggleAtomisTheme();
    });
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0F1115">
  <title>Sign in | T&S Crew</title>

  <link rel="icon" type="image/svg+xml" href="/images/atomis-favicon-light.svg">
  <link rel="apple-touch-icon" href="/images/atomis-apple-touch-icon-light.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/atomis-apple-touch-icon-light.png">
  <link rel="manifest" href="/manifest.json">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --base: #0F1115;
      --surface: #1A1D24;
      --surface-2: #22262F;
      --emerald: #10B981;
      --text: #F5F5F7;
      --text-mute: #8B8E95;
      --text-faint: #5A5D64;
      --border: rgba(245,245,247,0.06);
      --border-strong: rgba(245,245,247,0.12);
      --danger: #EF4444;
      --font-display: 'Bricolage Grotesque', sans-serif;
      --font-body: 'Geist', 'Inter', system-ui, sans-serif;
      --font-mono: 'Geist Mono', monospace;
    }
    :root[data-theme="light"] {
      --base: #F7F8FA;
      --surface: #FFFFFF;
      --surface-2: #F1F3F6;
      --text: #0F1115;
      --text-mute: #555A63;
      --text-faint: #8B8E95;
      --border: rgba(15, 17, 21, 0.08);
      --border-strong: rgba(15, 17, 21, 0.16);
    }

    /* Theme toggle — pinned top-right */
    .theme-toggle {
      position: absolute; top: calc(env(safe-area-inset-top, 0px) + 12px); right: 16px;
      width: 36px; height: 36px; border-radius: 10px;
      display: inline-flex; align-items: center; justify-content: center;
      background: transparent; color: var(--text-mute);
      border: 1px solid var(--border);
      cursor: pointer;
      transition: background-color 0.15s, color 0.15s, border-color 0.15s, transform 0.15s;
      z-index: 5;
    }
    .theme-toggle:hover { background: var(--surface-2); color: var(--text); border-color: var(--border-strong); }
    .theme-toggle:active { transform: scale(0.94); }
    .theme-toggle .icon-sun { display: none; }
    .theme-toggle .icon-moon { display: block; }
    :root[data-theme="light"] .theme-toggle .icon-sun { display: block; }
    :root[data-theme="light"] .theme-toggle .icon-moon { display: none; }

    /* Theme-swapped T&S logo — white-on-dark vs colour-on-light. */
    .ts-logo-dark { display: block; }
    .ts-logo-light { display: none; }
    :root[data-theme="light"] .ts-logo-dark { display: none; }
    :root[data-theme="light"] .ts-logo-light { display: block; }
    html, body { height: 100%; }
    body {
      font-family: var(--font-body);
      background: var(--base);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      line-height: 1.5;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: env(safe-area-inset-top, 0px) 24px env(safe-area-inset-bottom, 0px);
    }
    .top {
      width: 100%;
      max-width: 380px;
      padding-top: 48px;
      text-align: center;
    }
    .mark-stage {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 28px;
    }
    .wm {
      font-family: var(--font-display);
      font-weight: 500;
      font-size: 32px;
      letter-spacing: -0.04em;
      color: var(--text);
    }
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--emerald);
      margin-top: 12px;
    }
    .sub {
      font-size: 14px;
      color: var(--text-mute);
      margin-top: 8px;
    }

    .form-wrap {
      width: 100%;
      max-width: 380px;
      flex: 0 0 auto;
    }
    .field { margin-bottom: 16px; }
    .field label {
      display: block;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-mute);
      margin-bottom: 8px;
    }
    .field input {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--border-strong);
      border-radius: 6px;
      padding: 14px 14px;
      color: var(--text);
      font-family: var(--font-body);
      font-size: 16px;
      transition: border-color 0.15s, background-color 0.15s;
      color-scheme: light dark;
    }
    .field input:focus {
      outline: none;
      border-color: var(--emerald);
      background: var(--surface-2);
    }
    .field input::placeholder { color: var(--text-faint); }
    /* Autofill — mirror the admin login fix so iOS doesn't paint the
     * input dark when the user taps it in light mode. */
    .field input:-webkit-autofill,
    .field input:-webkit-autofill:hover,
    .field input:-webkit-autofill:focus,
    .field input:-webkit-autofill:active {
      -webkit-box-shadow: 0 0 0 1000px var(--surface) inset !important;
      -webkit-text-fill-color: var(--text) !important;
      caret-color: var(--text);
      transition: background-color 9999s ease-in-out 0s;
    }
    .field input.pin {
      text-align: center;
      letter-spacing: 0.5em;
      font-family: var(--font-mono);
    }
    .field input.pin::placeholder { letter-spacing: normal; }

    .btn-primary {
      width: 100%;
      background: var(--emerald);
      color: var(--base);
      border: none;
      padding: 14px;
      border-radius: 6px;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.15s;
    }
    .btn-primary:active { transform: translateY(1px); opacity: 0.92; }

    .forgot {
      text-align: center;
      margin-top: 16px;
      font-size: 12px;
    }
    .forgot a {
      color: var(--text-mute);
      text-decoration: none;
      border-bottom: 1px solid var(--border-strong);
      padding-bottom: 1px;
    }

    .err {
      background: rgba(239,68,68,0.10);
      border: 1px solid rgba(239,68,68,0.22);
      color: #fca5a5;
      font-size: 13px;
      padding: 10px 14px;
      border-radius: 6px;
      margin-bottom: 16px;
    }
    .ok {
      background: rgba(16,185,129,0.10);
      border: 1px solid rgba(16,185,129,0.22);
      color: #6ee7b7;
      font-size: 13px;
      padding: 10px 14px;
      border-radius: 6px;
      margin-bottom: 16px;
    }

    .bottom {
      width: 100%;
      max-width: 380px;
      text-align: center;
      padding: 24px 0 32px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-faint);
    }
    .bottom a {
      color: var(--text-mute);
      text-decoration: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .mark-anim animateMotion, .mark-anim animate { display: none; }
    }
  </style>
</head>
<body>
  <button type="button" class="theme-toggle" aria-label="Toggle theme" title="Toggle light/dark theme">
    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
  </button>

  <!-- TOP — T&S brand mark (logo swaps per theme: white-on-dark vs colour-on-light) -->
  <div class="top">
    <div class="mark-stage">
      <img class="ts-logo-dark" src="/images/ts-logo-white.png" alt="T&amp;S Traffic Control" style="width:220px;max-width:80vw;height:auto">
      <img class="ts-logo-light" src="/images/logo-colour.png" alt="T&amp;S Traffic Control" style="width:220px;max-width:80vw;height:auto">
    </div>
    <h1 class="wm">Field Station</h1>
    <p class="eyebrow">Sign in to start your shift</p>
  </div>

  <!-- FORM -->
  <div class="form-wrap">
    <% if (typeof flash_error !== 'undefined' && flash_error && flash_error.length > 0) { %>
      <% flash_error.forEach(msg => { %>
        <div class="err"><%= msg %></div>
      <% }) %>
    <% } %>
    <script>
      (function() {
        var params = new URLSearchParams(window.location.search);
        var err = params.get('err');
        if (err && !document.querySelector('.err')) {
          var div = document.createElement('div');
          div.className = 'err';
          div.textContent = err;
          var form = document.querySelector('form');
          form.parentNode.insertBefore(div, form);
          history.replaceState(null, '', '/w/login');
        }
      })();
    </script>
    <% if (typeof flash_success !== 'undefined' && flash_success && flash_success.length > 0) { %>
      <% flash_success.forEach(msg => { %>
        <div class="ok"><%= msg %></div>
      <% }) %>
    <% } %>

    <form method="POST" action="/w/login">
      <%- include('../partials/csrf') %>
      <div class="field">
        <label for="employee_id">Email or Employee ID</label>
        <input type="text" id="employee_id" name="employee_id" required autofocus
          inputmode="email" autocomplete="username"
          placeholder="john@email.com or EMP-001">
      </div>
      <div class="field">
        <label for="pin">PIN</label>
        <input type="password" id="pin" name="pin" required class="pin"
          inputmode="numeric" autocomplete="current-password"
          maxlength="6" pattern="[0-9]{4,6}" placeholder="••••">
      </div>
      <button type="submit" class="btn-primary">Sign in &rarr;</button>
      <div class="forgot">
        <a href="/w/forgot-pin">Forgot your PIN?</a>
        <span style="opacity:.4;margin:0 6px">·</span>
        <a href="/profile/worker-portal">Admin? Open with your office login</a>
      </div>
    </form>
  </div>

  <!-- BOTTOM -->
  <div class="bottom">
    <div style="opacity:0.7;display:inline-flex;align-items:center;gap:6px">
      <img class="ts-logo-dark" src="/images/atomis-mark.svg" alt="" style="width:12px;height:12px" aria-hidden="true">
      <img class="ts-logo-light" src="/images/atomis-mark-light-bg.svg" alt="" style="width:12px;height:12px" aria-hidden="true">
      <span>Powered by Atomis &middot; <%= new Date().getFullYear() %></span>
    </div>
  </div>
</body>
</html>
