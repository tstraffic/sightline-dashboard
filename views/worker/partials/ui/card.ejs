<%
  // Worker UI primitive: card.
  // Locals: tone ('default'|'accent'|'warning'|'success'|'danger'),
  //         className (extra classes), body (raw HTML).
  var _tone = typeof tone !== 'undefined' && tone ? tone : 'default';
  var _class = typeof className !== 'undefined' && className ? ' ' + className : '';
%>
<div class="wd-card<%= _class %>" data-tone="<%= _tone %>">
  <%- typeof body !== 'undefined' && body ? body : '' %>
</div>
