<%
  // Worker UI primitive: stat tile.
  // Locals: label, value, unit, sub, kind (default 'blue'),
  //         icon (raw SVG markup), countup (boolean — PR 2 reads data-countup).
  var _kind = typeof kind !== 'undefined' && kind ? kind : 'blue';
  var _value = (typeof value === 'undefined' || value == null) ? '' : value;
  var _countup = typeof countup !== 'undefined' && countup;
  var _numeric = String(_value).replace(/[^0-9.\-]/g, '');
%>
<div class="wd-stat-tile" data-kind="<%= _kind %>">
  <p class="wd-stat-tile-label"><%= label %></p>
  <p class="wd-stat-tile-value">
    <span<% if (_countup) { %> data-countup="<%= _numeric %>"<% } %>><%= _value %></span><% if (typeof unit !== 'undefined' && unit) { %><span class="wd-stat-tile-unit"><%= unit %></span><% } %>
  </p>
  <% if (typeof sub !== 'undefined' && sub) { %><p class="wd-stat-tile-sub"><%= sub %></p><% } %>
  <% if (typeof icon !== 'undefined' && icon) { %><span class="wd-stat-tile-icon"><%- icon %></span><% } %>
</div>
