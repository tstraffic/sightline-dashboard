<%
  // Worker UI primitive: status pill / chip.
  // Locals: label (required), kind (8 colours, default 'neutral'), dot (boolean).
  var _kind = typeof kind !== 'undefined' && kind ? kind : 'neutral';
  var _dot = typeof dot !== 'undefined' && dot;
%>
<span class="wd-status-pill" data-kind="<%= _kind %>"><% if (_dot) { %><span class="wd-status-dot"></span><% } %><%= label %></span>
