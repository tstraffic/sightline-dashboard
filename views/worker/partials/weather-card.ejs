<%
  // Minimalist weather card for /w/home.
  // Locals: weather (from services/homeContext.js getWeather()).
  //
  // Design intent: blend with the worker portal's neutral surface — white
  // in light mode, charcoal in dark — instead of the prior dark-only
  // mesh-gradient. A small animated SVG icon carries the only visual
  // motion; copy is one short row + a metadata strip.
  //
  // Live updates: the card is polled by the inline script below via
  // GET /w/weather.json every WX_POLL_MS, and on tab visibility-change
  // so the reading is fresh when a worker returns to the app. Only the
  // dynamic text + icon swap; the layout / theme stays put. Cache is
  // already 15min server-side inside getWeather() so polling more often
  // is cheap.

  var _kind = (weather && weather.kind) ? weather.kind : 'cloudy';
%>
<style>
  .wx-card {
    position: relative;
    border-radius: 14px;
    padding: 14px 14px 12px;
    display: flex;
    align-items: center;
    gap: 14px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    color: #0F1115;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  /* Dark-mode override — matches the .bg-white / .border-gray-200
     overrides elsewhere in worker.css. */
  :root[data-theme="dark"] .wx-card {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.92);
  }
  /* Brand-green accent rail down the left side — kind-tinted but
     subtle, so the card still reads as "a card on the worker page"
     rather than a coloured panel. */
  .wx-card::before {
    content: '';
    position: absolute;
    left: 0; top: 14px; bottom: 14px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--wx-accent, #10B981);
    opacity: 0.85;
  }
  .wx-card[data-kind="sunny"]         { --wx-accent: #F59E0B; }
  .wx-card[data-kind="partly-cloudy"] { --wx-accent: #60A5FA; }
  .wx-card[data-kind="cloudy"]        { --wx-accent: #94A3B8; }
  .wx-card[data-kind="rainy"]         { --wx-accent: #3B82F6; }
  .wx-card[data-kind="stormy"]        { --wx-accent: #8B5CF6; }
  .wx-card[data-kind="snow"]          { --wx-accent: #7DD3FC; }
  .wx-card[data-kind="fog"]           { --wx-accent: #94A3B8; }
  .wx-card[data-kind="night"]         { --wx-accent: #6366F1; }

  .wx-icon { width: 44px; height: 44px; flex-shrink: 0; opacity: 0.95; }
  .wx-meta { flex: 1; min-width: 0; }
  .wx-row {
    display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;
  }
  .wx-temp {
    font-family: 'Bricolage Grotesque','Geist',sans-serif;
    font-weight: 700; font-size: 1.75rem; line-height: 1; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .wx-desc {
    font-size: 0.85rem; font-weight: 500; color: #4B5563;
  }
  :root[data-theme="dark"] .wx-desc { color: rgba(255,255,255,0.7); }
  .wx-sub {
    font-size: 0.7rem; color: #6B7280; margin-top: 3px;
    font-family: 'Geist Mono',ui-monospace,monospace; letter-spacing: 0.02em;
  }
  :root[data-theme="dark"] .wx-sub { color: rgba(255,255,255,0.5); }
  .wx-sub .dot { color: #D1D5DB; margin: 0 4px; }
  :root[data-theme="dark"] .wx-sub .dot { color: rgba(255,255,255,0.2); }

  .wx-warn {
    margin-top: 8px;
    padding: 7px 10px;
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 8px;
    color: #B45309;
    font-size: 0.72rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  :root[data-theme="dark"] .wx-warn {
    background: rgba(245,158,11,0.08);
    border-color: rgba(245,158,11,0.30);
    color: #FCD34D;
  }

  /* Animated icon mechanics — same primitives as the old card, just
     scaled to the smaller 44px container. */
  .wx-sun-rays { transform-origin: 32px 32px; animation: wx-rotate 28s linear infinite; }
  @keyframes wx-rotate { to { transform: rotate(360deg); } }
  .wx-cloud { animation: wx-drift 9s ease-in-out infinite alternate; }
  .wx-cloud-2 { animation-delay: -3s; animation-duration: 11s; }
  @keyframes wx-drift {
    0%   { transform: translateX(-2px) translateY(0); }
    100% { transform: translateX(2px) translateY(-1px); }
  }
  .wx-drop { animation: wx-fall 1.4s linear infinite; opacity: 0; }
  .wx-drop-2 { animation-delay: 0.35s; }
  .wx-drop-3 { animation-delay: 0.7s; }
  .wx-drop-4 { animation-delay: 1.05s; }
  @keyframes wx-fall {
    0%   { transform: translateY(-2px); opacity: 0; }
    20%  { opacity: 1; }
    100% { transform: translateY(20px); opacity: 0; }
  }
  .wx-bolt { animation: wx-flash 2.4s ease-in-out infinite; transform-origin: 32px 36px; }
  @keyframes wx-flash {
    0%, 60%, 100% { opacity: 0.95; }
    65% { opacity: 1; filter: drop-shadow(0 0 6px #fde68a); }
    70% { opacity: 0.4; }
    75% { opacity: 1; filter: drop-shadow(0 0 6px #fde68a); }
    80% { opacity: 0.7; }
  }
  .wx-flake { animation: wx-snow 3s linear infinite; opacity: 0; }
  .wx-flake-2 { animation-delay: 0.8s; animation-duration: 3.6s; }
  .wx-flake-3 { animation-delay: 1.6s; animation-duration: 2.6s; }
  @keyframes wx-snow {
    0%   { transform: translate(0,-2px) rotate(0deg); opacity: 0; }
    15%  { opacity: 1; }
    100% { transform: translate(4px, 22px) rotate(120deg); opacity: 0; }
  }
  .wx-band { animation: wx-bandshift 8s ease-in-out infinite alternate; }
  .wx-band-2 { animation-delay: -2s; animation-duration: 10s; }
  @keyframes wx-bandshift {
    0%   { transform: translateX(-3px); }
    100% { transform: translateX(3px); }
  }
  .wx-star { animation: wx-twinkle 2.8s ease-in-out infinite; transform-origin: center; }
  .wx-star-2 { animation-delay: 0.7s; animation-duration: 3.4s; }
  .wx-star-3 { animation-delay: 1.4s; animation-duration: 2.4s; }
  @keyframes wx-twinkle {
    0%, 100% { opacity: 0.35; transform: scale(0.85); }
    50%      { opacity: 1;    transform: scale(1.1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wx-sun-rays, .wx-cloud, .wx-drop, .wx-bolt, .wx-flake, .wx-band, .wx-star { animation: none; }
  }
</style>

<div class="wx-card" id="wxCard" data-kind="<%= _kind %>">
  <div class="wx-icon-slot" id="wxIcon">
    <%- include('weather-icon', { kind: _kind }) %>
  </div>
  <div class="wx-meta">
    <div class="wx-row">
      <span class="wx-temp" id="wxTemp"><%= weather.temp %>&deg;</span>
      <span class="wx-desc" id="wxDesc"><%= weather.description %></span>
    </div>
    <p class="wx-sub" id="wxSub">
      <% if (weather.hi != null && weather.lo != null) { %>H <%= weather.hi %>&deg;<span class="dot">·</span>L <%= weather.lo %>&deg;<span class="dot">·</span><% } %>
      <%= weather.wind_kmh %> km/h<% if (weather.rain_chance) { %><span class="dot">·</span><%= weather.rain_chance %>% rain<% } %><% if (weather.uv != null) { %><span class="dot">·</span>UV <%= weather.uv %><% } %>
    </p>
  </div>
</div>

<% if (weather.rain_chance && weather.rain_chance >= 40) { %>
  <div class="wx-warn" id="wxWarn">
    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999A5.002 5.002 0 006.1 8H6a4 4 0 00-3 7zm8 2v-4m0 0v-2"/></svg>
    Wet weather PPE recommended &mdash; <%= weather.rain_chance %>% chance of rain
  </div>
<% } else { %>
  <div class="wx-warn" id="wxWarn" hidden></div>
<% } %>

<script>
(function () {
  // Live weather polling — re-fetches /w/weather.json every WX_POLL_MS
  // and on tab visibility-change so a worker returning to the PWA after
  // a few minutes sees a fresh reading without a full page reload.
  // No-op if the card isn't present (worker hid the weather section in
  // their preferences) or if some other tab already wired this up.
  if (window.__wxPolling) return;
  window.__wxPolling = true;
  var WX_POLL_MS = 5 * 60 * 1000;
  var card = document.getElementById('wxCard');
  if (!card) return;

  // Per-kind icon HTML strings — duplicated from views/worker/partials/
  // weather-icon.ejs so the polling script can swap kinds without
  // hitting the server again. The mirrored copy is small (~2KB) and
  // adding a real templating call here would mean reading EJS internals.
  var ICONS = window.__wxIcons || (window.__wxIcons = {
    'sunny': '<svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true"><g class="wx-sun-rays" stroke="#F59E0B" stroke-width="2.4" stroke-linecap="round"><line x1="32" y1="6" x2="32" y2="14"/><line x1="32" y1="50" x2="32" y2="58"/><line x1="6" y1="32" x2="14" y2="32"/><line x1="50" y1="32" x2="58" y2="32"/><line x1="13" y1="13" x2="19" y2="19"/><line x1="45" y1="45" x2="51" y2="51"/><line x1="51" y1="13" x2="45" y2="19"/><line x1="19" y1="45" x2="13" y2="51"/></g><circle cx="32" cy="32" r="11" fill="#FBBF24" stroke="#F59E0B" stroke-width="1.4"/></svg>',
    'partly-cloudy': '<svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="22" cy="22" r="9" fill="#FBBF24" stroke="#F59E0B" stroke-width="1.4"/><g class="wx-cloud"><path d="M22 42c-4 0-7-3-7-7 0-3 2-6 5-6 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H22z" fill="#CBD5E1" stroke="#94A3B8" stroke-width="1.4"/></g></svg>',
    'cloudy': '<svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true"><g class="wx-cloud-2"><path d="M15 26c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#CBD5E1" stroke="#94A3B8" stroke-width="1.4"/></g><g class="wx-cloud" style="transform: translate(8px, 6px) scale(0.7); transform-origin: 0 0;"><path d="M15 26c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="1.4" opacity="0.85"/></g></svg>',
    'rainy': '<svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M15 26c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#94A3B8" stroke="#64748B" stroke-width="1.4"/><g stroke="#3B82F6" stroke-width="2.4" stroke-linecap="round"><line class="wx-drop" x1="20" y1="42" x2="20" y2="50"/><line class="wx-drop wx-drop-2" x1="28" y1="42" x2="28" y2="50"/><line class="wx-drop wx-drop-3" x1="36" y1="42" x2="36" y2="50"/><line class="wx-drop wx-drop-4" x1="44" y1="42" x2="44" y2="50"/></g></svg>',
    'stormy': '<svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M15 24c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#475569" stroke="#334155" stroke-width="1.4"/><g class="wx-bolt"><path d="M34 32 L24 46 L31 46 L28 56 L40 40 L33 40 L36 32 Z" fill="#FACC15" stroke="#F59E0B" stroke-width="1.4"/></g></svg>',
    'snow': '<svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M15 26c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="1.4"/><g fill="#7DD3FC"><circle class="wx-flake" cx="22" cy="46" r="2.2"/><circle class="wx-flake wx-flake-2" cx="32" cy="46" r="2.2"/><circle class="wx-flake wx-flake-3" cx="42" cy="46" r="2.2"/></g></svg>',
    'fog': '<svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true"><g stroke="#94A3B8" stroke-width="3" stroke-linecap="round"><line class="wx-band" x1="14" y1="24" x2="50" y2="24"/><line class="wx-band-2" x1="10" y1="34" x2="54" y2="34"/><line class="wx-band" x1="14" y1="44" x2="50" y2="44"/></g></svg>',
    'night': '<svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M44 36a16 16 0 1 1-16-22 13 13 0 0 0 16 22z" fill="#6366F1" stroke="#4F46E5" stroke-width="1.4"/><g fill="#A5B4FC"><circle class="wx-star" cx="14" cy="16" r="1.6"/><circle class="wx-star wx-star-2" cx="50" cy="14" r="1.2"/><circle class="wx-star wx-star-3" cx="54" cy="40" r="1.4"/><circle class="wx-star wx-star-2" cx="10" cy="42" r="1.2"/></g></svg>',
  });

  function applyWeather(w) {
    if (!w) return;
    card.setAttribute('data-kind', w.kind || 'cloudy');
    var tempEl = document.getElementById('wxTemp');
    var descEl = document.getElementById('wxDesc');
    var subEl  = document.getElementById('wxSub');
    var iconEl = document.getElementById('wxIcon');
    var warnEl = document.getElementById('wxWarn');
    if (tempEl) tempEl.innerHTML = w.temp + '&deg;';
    if (descEl) descEl.textContent = w.description;
    if (subEl) {
      var parts = [];
      if (w.hi != null && w.lo != null) parts.push('H ' + w.hi + '&deg;', 'L ' + w.lo + '&deg;');
      parts.push((w.wind_kmh || 0) + ' km/h');
      if (w.rain_chance) parts.push(w.rain_chance + '% rain');
      if (w.uv != null) parts.push('UV ' + w.uv);
      subEl.innerHTML = parts.join('<span class="dot">·</span>');
    }
    if (iconEl && ICONS[w.kind || 'cloudy']) {
      iconEl.innerHTML = ICONS[w.kind || 'cloudy'];
    }
    if (warnEl) {
      if (w.rain_chance && w.rain_chance >= 40) {
        warnEl.hidden = false;
        warnEl.innerHTML = '<svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999A5.002 5.002 0 006.1 8H6a4 4 0 00-3 7zm8 2v-4m0 0v-2"/></svg> Wet weather PPE recommended &mdash; ' + w.rain_chance + '% chance of rain';
      } else {
        warnEl.hidden = true;
      }
    }
  }

  function poll() {
    fetch('/w/weather.json', { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (j) { if (j && j.ok) applyWeather(j.weather); })
      .catch(function () {});
  }
  setInterval(poll, WX_POLL_MS);
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') poll();
  });
})();
</script>
