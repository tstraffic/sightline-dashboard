<%
  // Animated weather glyph extracted from weather-card.ejs so it can be
  // both server-rendered into the initial card AND inline-cached as
  // strings the client uses when polling swaps the kind on the fly.
  // Local: kind ∈ sunny | partly-cloudy | cloudy | rainy | stormy | snow | fog | night.
%>
<% if (kind === 'sunny') { %>
  <svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <g class="wx-sun-rays" stroke="#F59E0B" stroke-width="2.4" stroke-linecap="round">
      <line x1="32" y1="6"  x2="32" y2="14"/>
      <line x1="32" y1="50" x2="32" y2="58"/>
      <line x1="6"  y1="32" x2="14" y2="32"/>
      <line x1="50" y1="32" x2="58" y2="32"/>
      <line x1="13" y1="13" x2="19" y2="19"/>
      <line x1="45" y1="45" x2="51" y2="51"/>
      <line x1="51" y1="13" x2="45" y2="19"/>
      <line x1="19" y1="45" x2="13" y2="51"/>
    </g>
    <circle cx="32" cy="32" r="11" fill="#FBBF24" stroke="#F59E0B" stroke-width="1.4"/>
  </svg>
<% } else if (kind === 'partly-cloudy') { %>
  <svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <circle cx="22" cy="22" r="9" fill="#FBBF24" stroke="#F59E0B" stroke-width="1.4"/>
    <g class="wx-cloud">
      <path d="M22 42c-4 0-7-3-7-7 0-3 2-6 5-6 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H22z" fill="#CBD5E1" stroke="#94A3B8" stroke-width="1.4"/>
    </g>
  </svg>
<% } else if (kind === 'cloudy') { %>
  <svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <g class="wx-cloud-2">
      <path d="M15 26c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#CBD5E1" stroke="#94A3B8" stroke-width="1.4"/>
    </g>
    <g class="wx-cloud" style="transform: translate(8px, 6px) scale(0.7); transform-origin: 0 0;">
      <path d="M15 26c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="1.4" opacity="0.85"/>
    </g>
  </svg>
<% } else if (kind === 'rainy') { %>
  <svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <path d="M15 26c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#94A3B8" stroke="#64748B" stroke-width="1.4"/>
    <g stroke="#3B82F6" stroke-width="2.4" stroke-linecap="round">
      <line class="wx-drop"   x1="20" y1="42" x2="20" y2="50"/>
      <line class="wx-drop wx-drop-2" x1="28" y1="42" x2="28" y2="50"/>
      <line class="wx-drop wx-drop-3" x1="36" y1="42" x2="36" y2="50"/>
      <line class="wx-drop wx-drop-4" x1="44" y1="42" x2="44" y2="50"/>
    </g>
  </svg>
<% } else if (kind === 'stormy') { %>
  <svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <path d="M15 24c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#475569" stroke="#334155" stroke-width="1.4"/>
    <g class="wx-bolt">
      <path d="M34 32 L24 46 L31 46 L28 56 L40 40 L33 40 L36 32 Z" fill="#FACC15" stroke="#F59E0B" stroke-width="1.4"/>
    </g>
  </svg>
<% } else if (kind === 'snow') { %>
  <svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <path d="M15 26c1-3 4-5 7-5 1-4 5-7 9-7 5 0 9 4 9 9h2c4 0 7 3 7 7s-3 7-7 7H15c-4 0-7-3-7-7s3-7 7-4z" fill="#E2E8F0" stroke="#CBD5E1" stroke-width="1.4"/>
    <g fill="#7DD3FC">
      <circle class="wx-flake"   cx="22" cy="46" r="2.2"/>
      <circle class="wx-flake wx-flake-2" cx="32" cy="46" r="2.2"/>
      <circle class="wx-flake wx-flake-3" cx="42" cy="46" r="2.2"/>
    </g>
  </svg>
<% } else if (kind === 'night') { %>
  <svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <path d="M44 36a16 16 0 1 1-16-22 13 13 0 0 0 16 22z" fill="#6366F1" stroke="#4F46E5" stroke-width="1.4"/>
    <g fill="#A5B4FC">
      <circle class="wx-star"   cx="14" cy="16" r="1.6"/>
      <circle class="wx-star wx-star-2" cx="50" cy="14" r="1.2"/>
      <circle class="wx-star wx-star-3" cx="54" cy="40" r="1.4"/>
      <circle class="wx-star wx-star-2" cx="10" cy="42" r="1.2"/>
    </g>
  </svg>
<% } else { /* fog */ %>
  <svg class="wx-icon" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <g stroke="#94A3B8" stroke-width="3" stroke-linecap="round">
      <line class="wx-band"   x1="14" y1="24" x2="50" y2="24"/>
      <line class="wx-band-2" x1="10" y1="34" x2="54" y2="34"/>
      <line class="wx-band"   x1="14" y1="44" x2="50" y2="44"/>
    </g>
  </svg>
<% } %>
