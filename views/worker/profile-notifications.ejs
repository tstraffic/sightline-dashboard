<style>
  .nf-wrap { padding: 12px; padding-bottom: 6rem; color: #fff; }
  .nf-back { display: inline-flex; align-items: center; gap: 4px; color: #00D2BE; font-size: 0.85rem; font-weight: 600; }
  .nf-h1 { font-size: 1.4rem; font-weight: 800; margin-top: 0.25rem; letter-spacing: -0.01em; }
  .nf-sub { font-size: 0.78rem; color: rgba(255,255,255,0.55); margin-top: 4px; }
  .nf-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 4px 14px; margin-top: 14px; }
  .nf-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.06); }
  .nf-row:first-child { border-top: 0; }
  .nf-label { flex: 1; min-width: 0; }
  .nf-label .name { font-size: 0.92rem; font-weight: 600; color: #fff; }
  .nf-label .sub { font-size: 0.72rem; color: rgba(255,255,255,0.55); margin-top: 2px; }
  .nf-switch { position: relative; width: 44px; height: 26px; flex-shrink: 0; }
  .nf-switch input { opacity: 0; width: 0; height: 0; position: absolute; }
  .nf-slider {
    position: absolute; inset: 0; cursor: pointer;
    background: rgba(255,255,255,0.12); border-radius: 999px;
    transition: background 0.15s;
  }
  .nf-slider::before {
    content: ''; position: absolute; top: 3px; left: 3px;
    width: 20px; height: 20px; background: #fff; border-radius: 50%;
    transition: transform 0.15s;
  }
  .nf-switch input:checked + .nf-slider { background: #2B7FFF; }
  .nf-switch input:checked + .nf-slider::before { transform: translateX(18px); }
  .nf-submit-bar { position: sticky; bottom: 0; padding: 16px 0 calc(16px + env(safe-area-inset-bottom, 0px)); background: linear-gradient(180deg, transparent, rgba(10,22,40,0.95) 35%); margin-top: 16px; }
  .nf-submit { width: 100%; padding: 14px; border-radius: 12px; font-size: 0.95rem; font-weight: 700; color: #fff; background: linear-gradient(135deg, #2B7FFF, #1D6AE5); border: 0; box-shadow: 0 8px 22px rgba(29,106,229,0.45); }
  .nf-master { font-size: 0.78rem; color: rgba(255,255,255,0.7); margin-top: 8px; display: flex; gap: 12px; }
  .nf-master a { color: #93C5FD; font-weight: 600; }
</style>

<div class="nf-wrap">
  <a href="/w/profile" class="nf-back">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    Profile
  </a>
  <h1 class="nf-h1">Notifications</h1>
  <p class="nf-sub">Choose what pings your phone. Everything on by default — toggle off anything you don't need.</p>

  <!-- Push status panel — none of the toggles below matter if push isn't
       actually set up on this device. This panel shows the live state and
       offers Enable / Send-test so the worker can verify the pipeline. -->
  <div id="push-status-card" class="nf-card" style="padding: 14px; margin-top: 14px;">
    <div style="display: flex; align-items: center; gap: 10px;">
      <span id="push-dot" style="display: inline-block; width: 10px; height: 10px; border-radius: 999px; background: rgba(255,255,255,0.3); flex-shrink: 0;"></span>
      <div style="flex: 1; min-width: 0;">
        <p id="push-status-title" style="font-size: 0.95rem; font-weight: 700; color: #fff; margin: 0;">Checking…</p>
        <p id="push-status-sub" style="font-size: 0.78rem; color: rgba(255,255,255,0.6); margin-top: 2px;">Working out whether push is set up on this device.</p>
      </div>
    </div>
    <div id="push-actions" style="display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap;">
      <button type="button" id="push-enable-btn" style="display: none; padding: 9px 14px; border-radius: 10px; font-size: 0.82rem; font-weight: 700; color: #fff; background: linear-gradient(135deg, #2B7FFF, #1D6AE5); border: 0;">Enable push</button>
      <button type="button" id="push-test-btn" style="display: none; padding: 9px 14px; border-radius: 10px; font-size: 0.82rem; font-weight: 700; color: #fff; background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.15);">Send test</button>
    </div>
    <p id="push-server-info" style="font-size: 0.72rem; color: rgba(255,255,255,0.45); margin-top: 10px;">Server has <strong><%= subscribedDevices %></strong> device<%= subscribedDevices === 1 ? '' : 's' %> subscribed for your account.</p>
  </div>

  <p class="nf-master" style="margin-top: 16px;">
    <a href="#" id="nf-all-on">Turn all on</a>
    <a href="#" id="nf-all-off">Turn all off</a>
  </p>

  <form method="POST" action="/w/profile/notifications" id="nf-form">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <div class="nf-card">
      <% categories.forEach(function (c) { %>
        <label class="nf-row">
          <span class="nf-label">
            <span class="name"><%= c.label %></span>
            <span class="sub"><%= c.sub %></span>
          </span>
          <span class="nf-switch">
            <input type="checkbox" name="enabled" value="<%= c.key %>" <%= c.enabled ? 'checked' : '' %>>
            <span class="nf-slider"></span>
          </span>
        </label>
      <% }) %>
    </div>

    <div class="nf-submit-bar">
      <button type="submit" class="nf-submit">Save settings</button>
    </div>
  </form>
</div>

<script>
(function () {
  function setAll(state) {
    document.querySelectorAll('#nf-form input[name="enabled"]').forEach(function (cb) {
      cb.checked = state;
    });
  }
  document.getElementById('nf-all-on').addEventListener('click', function (e) { e.preventDefault(); setAll(true); });
  document.getElementById('nf-all-off').addEventListener('click', function (e) { e.preventDefault(); setAll(false); });
})();

// CSRF helper — every state-changing POST below has to include this
// header or the global CSRF middleware silently 403s it.
function csrfToken() {
  var m = document.querySelector('meta[name="csrf-token"]');
  return m ? m.content : '';
}

// ── Push status panel ──
// Detects browser support + permission + active subscription. If any link in
// the chain is broken the worker sees exactly what's missing, and gets a one-
// tap button to fix it.
(function () {
  var dot       = document.getElementById('push-dot');
  var title     = document.getElementById('push-status-title');
  var sub       = document.getElementById('push-status-sub');
  var enableBtn = document.getElementById('push-enable-btn');
  var testBtn   = document.getElementById('push-test-btn');

  function setDot(c) { dot.style.background = c; }

  function urlBase64ToUint8Array(s) {
    var pad = '='.repeat((4 - s.length % 4) % 4);
    var b64 = (s + pad).replace(/-/g, '+').replace(/_/g, '/');
    var raw = atob(b64);
    var out = new Uint8Array(raw.length);
    for (var i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
    return out;
  }

  function render(state, message, detail, options) {
    options = options || {};
    title.textContent = message;
    sub.textContent = detail || '';
    if (state === 'ok')      setDot('#10B981');
    else if (state === 'warn') setDot('#F59E0B');
    else if (state === 'bad')  setDot('#EF4444');
    else setDot('rgba(255,255,255,0.3)');
    enableBtn.style.display = options.showEnable ? 'inline-flex' : 'none';
    testBtn.style.display   = options.showTest   ? 'inline-flex' : 'none';
  }

  // iOS only supports Web Push from an installed (standalone) PWA.
  // Mobile Safari direct returns Notification.permission='denied' forever.
  function iosNeedsInstall() {
    var ua = navigator.userAgent || '';
    var isIOS = /iPad|iPhone|iPod/.test(ua) && !window.MSStream;
    var standalone = window.navigator.standalone === true ||
                     (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches);
    return isIOS && !standalone;
  }

  async function check() {
    if (iosNeedsInstall()) {
      render('warn', 'Add to Home Screen to enable push',
             'On iPhone you have to install the portal as an app before push notifications work. Tap the Share icon → Add to Home Screen, then open the app and come back here.');
      return;
    }
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) {
      render('bad', 'Push not supported on this browser',
             'Open the worker portal in Chrome, Edge, Firefox, or Safari (iOS 16.4+ added to Home Screen).');
      return;
    }
    if (Notification.permission === 'denied') {
      render('bad', 'Notifications blocked',
             'Open your browser/site settings, allow notifications for this site, then come back and tap "Enable push".',
             { showEnable: true });
      return;
    }
    try {
      var reg = await navigator.serviceWorker.ready;
      var existing = await reg.pushManager.getSubscription();
      if (existing) {
        // Re-send to server in case the row was lost (idempotent upsert).
        fetch('/w/notifications/push/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken() },
          credentials: 'same-origin',
          body: JSON.stringify(existing),
        }).catch(function(){});
        render('ok', 'Push notifications enabled on this device',
               'You should receive safety updates, announcements, and shift reminders.',
               { showTest: true });
        return;
      }
      render('warn', 'Push not turned on yet for this device',
             'Tap "Enable push" — you\'ll get a one-time browser prompt.',
             { showEnable: true });
    } catch (e) {
      render('bad', 'Could not check push status', (e && e.message) || 'Unknown error', { showEnable: true });
    }
  }

  async function enable() {
    enableBtn.disabled = true;
    enableBtn.textContent = 'Working…';
    try {
      var perm = Notification.permission === 'granted' ? 'granted' : await Notification.requestPermission();
      if (perm !== 'granted') {
        render('bad', 'Permission was not granted',
               'You need to allow notifications for this site in your browser settings.',
               { showEnable: true });
        return;
      }
      var keyRes = await fetch('/w/notifications/push/vapid-key');
      if (!keyRes.ok) throw new Error('VAPID key not available');
      var keyData = await keyRes.json();
      if (!keyData.publicKey) throw new Error('Server has no push key configured');
      var reg = await navigator.serviceWorker.ready;
      var sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(keyData.publicKey),
      });
      var save = await fetch('/w/notifications/push/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken() },
        credentials: 'same-origin',
        body: JSON.stringify(sub),
      });
      if (!save.ok) {
        var errMsg = 'Server rejected the subscription';
        try { var j = await save.json(); if (j && j.error) errMsg = j.error; } catch (e) {}
        throw new Error(errMsg);
      }
      render('ok', 'Push notifications enabled on this device',
             'You should receive safety updates, announcements, and shift reminders.',
             { showTest: true });
    } catch (e) {
      render('bad', 'Could not enable push', (e && e.message) || 'Unknown error', { showEnable: true });
    } finally {
      enableBtn.disabled = false;
      enableBtn.textContent = 'Enable push';
    }
  }

  async function test() {
    testBtn.disabled = true;
    var orig = testBtn.textContent;
    testBtn.textContent = 'Sending…';
    try {
      var r = await fetch('/w/notifications/push/test', {
        method: 'POST',
        headers: { 'x-csrf-token': csrfToken() },
        credentials: 'same-origin',
      });
      var data = await r.json().catch(function(){ return {}; });
      if (data && data.success) {
        testBtn.textContent = 'Sent — check your phone';
      } else {
        testBtn.textContent = data && data.error ? data.error : 'Test failed';
      }
    } catch (e) {
      testBtn.textContent = 'Test failed';
    } finally {
      setTimeout(function () { testBtn.disabled = false; testBtn.textContent = orig; }, 3000);
    }
  }

  enableBtn.addEventListener('click', enable);
  testBtn.addEventListener('click', test);
  check();
})();
</script>
