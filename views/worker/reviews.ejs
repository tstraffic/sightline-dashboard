<%
  function fmtDate(s) {
    if (!s) return '';
    return new Date(s + (String(s).includes('T') ? '' : 'T00:00:00')).toLocaleDateString('en-AU', {
      timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric'
    });
  }
  function fmtStamp(s) {
    if (!s) return '';
    return new Date(s + (String(s).includes('T') ? '' : 'T00:00:00Z')).toLocaleString('en-AU', {
      timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
    });
  }
%>
<style>
  .rv-wrap { padding: 0 16px 100px; color: #fff; }
  .rv-back {
    display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 999px;
    color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    text-decoration: none; margin: 8px 0 12px;
  }
  .rv-h1 { font-size: 1.4rem; font-weight: 800; margin-bottom: 4px; letter-spacing: -0.01em; }
  .rv-sub { font-size: 0.78rem; color: rgba(255,255,255,0.55); margin-bottom: 14px; line-height: 1.4; }
  .rv-card {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px; padding: 14px 16px; margin-bottom: 12px;
  }
  .rv-card-head { display: flex; align-items: flex-start; gap: 10px; }
  .rv-kind-chip {
    flex-shrink: 0; font-size: 0.62rem; font-weight: 800; letter-spacing: 0.06em;
    text-transform: uppercase; padding: 3px 8px; border-radius: 999px;
  }
  .rv-kind-chip.note   { background: rgba(59,130,246,0.16); color: #93C5FD; border: 1px solid rgba(59,130,246,0.3); }
  .rv-kind-chip.review { background: rgba(16,185,129,0.16); color: #6EE7B7; border: 1px solid rgba(16,185,129,0.3); }
  .rv-title { font-size: 1rem; font-weight: 700; line-height: 1.25; margin-bottom: 4px; }
  .rv-meta { font-size: 0.72rem; color: rgba(255,255,255,0.55); display: flex; gap: 8px; flex-wrap: wrap; }
  .rv-meta b { color: rgba(255,255,255,0.85); font-weight: 600; }
  .rv-summary { font-size: 0.86rem; color: rgba(255,255,255,0.88); margin-top: 10px; line-height: 1.5; white-space: pre-line; }
  .rv-section { margin-top: 10px; padding-top: 10px; border-top: 1px dashed rgba(255,255,255,0.10); }
  .rv-section h4 {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    color: rgba(255,255,255,0.55); margin-bottom: 4px;
  }
  .rv-section p { font-size: 0.85rem; color: rgba(255,255,255,0.88); line-height: 1.5; white-space: pre-line; }
  .rv-peer {
    background: rgba(255,255,255,0.04); border-left: 3px solid rgba(139,92,246,0.6);
    padding: 8px 10px; border-radius: 0 8px 8px 0; margin-top: 6px;
  }
  .rv-peer .who { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: #C4B5FD; margin-bottom: 2px; }
  .rv-peer .what { font-size: 0.82rem; color: rgba(255,255,255,0.88); line-height: 1.45; white-space: pre-line; }
  .rv-empty {
    background: rgba(255,255,255,0.04); border: 1px dashed rgba(255,255,255,0.12);
    border-radius: 14px; padding: 32px 18px; text-align: center; color: rgba(255,255,255,0.65);
  }
  .rv-empty svg { width: 32px; height: 32px; margin: 0 auto 10px; color: rgba(255,255,255,0.4); }
  .rv-empty p { font-size: 0.85rem; line-height: 1.5; margin: 0; }

  /* Light-mode mirror — matches the rest of the worker safety pages.
     Cards become white-on-light-gray with soft shadow. */
  :root[data-theme="light"] .rv-wrap   { color: #0F1115; }
  :root[data-theme="light"] .rv-back   { color: #0F1115; background: #F3F4F6; border-color: #E5E7EB; }
  :root[data-theme="light"] .rv-sub    { color: #6B7280; }
  :root[data-theme="light"] .rv-card   { background: #FFFFFF; border-color: #E5E7EB; box-shadow: 0 1px 2px rgba(15,17,21,0.04); }
  :root[data-theme="light"] .rv-kind-chip.note   { background: #EFF6FF; color: #1D4ED8; border-color: #BFDBFE; }
  :root[data-theme="light"] .rv-kind-chip.review { background: #ECFDF5; color: #047857; border-color: #A7F3D0; }
  :root[data-theme="light"] .rv-meta   { color: #6B7280; }
  :root[data-theme="light"] .rv-meta b { color: #111827; }
  :root[data-theme="light"] .rv-summary,
  :root[data-theme="light"] .rv-section p   { color: #1F2937; }
  :root[data-theme="light"] .rv-section     { border-top-color: #E5E7EB; }
  :root[data-theme="light"] .rv-section h4  { color: #6B7280; }
  :root[data-theme="light"] .rv-peer        { background: #FAFAF9; border-left-color: #8B5CF6; }
  :root[data-theme="light"] .rv-peer .who   { color: #6D28D9; }
  :root[data-theme="light"] .rv-peer .what  { color: #1F2937; }
  :root[data-theme="light"] .rv-empty       { background: #FFFFFF; border-color: #E5E7EB; color: #4B5563; }
  :root[data-theme="light"] .rv-empty svg   { color: #9CA3AF; }
</style>

<div class="rv-wrap">
  <a href="/w/more" class="rv-back" aria-label="Back to More">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
  </a>
  <h1 class="rv-h1">My Reviews</h1>
  <p class="rv-sub">Feedback and performance reviews shared with you by your manager. Only items marked for you appear here.</p>

  <% if (!reviews.length) { %>
    <div class="rv-empty">
      <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      <p>No reviews shared with you yet.<br>When your manager publishes one, it'll show up here.</p>
    </div>
  <% } %>

  <% reviews.forEach(function (r) { %>
    <article class="rv-card">
      <div class="rv-card-head">
        <span class="rv-kind-chip <%= r.kind === 'review' ? 'review' : 'note' %>"><%= r.kind === 'review' ? 'Performance review' : 'Note' %></span>
        <div style="min-width:0;flex:1">
          <div class="rv-title"><%= r.title %></div>
          <div class="rv-meta">
            <% if (r.review_date) { %><span><b>Reviewed</b> <%= fmtDate(r.review_date) %></span><% } %>
            <% if (r.held_by) { %><span><b>Held by</b> <%= r.held_by %></span><% } %>
            <% if (!r.review_date && !r.held_by && r.created_by_name) { %><span><b>From</b> <%= r.created_by_name %></span><% } %>
            <% if (r.created_at) { %><span><b>Posted</b> <%= fmtStamp(r.created_at) %></span><% } %>
          </div>
        </div>
      </div>

      <% if (r.summary) { %>
        <div class="rv-summary"><%= r.summary %></div>
      <% } %>

      <% (r.sections || []).forEach(function (sec) { if (sec.heading || sec.content) { %>
        <div class="rv-section">
          <% if (sec.heading) { %><h4><%= sec.heading %></h4><% } %>
          <% if (sec.content) { %><p><%= sec.content %></p><% } %>
        </div>
      <% } }); %>

      <% if ((r.peer_comments || []).length) { %>
        <div class="rv-section">
          <h4>Feedback from others</h4>
          <% r.peer_comments.forEach(function (p) { if (p.from || p.comment) { %>
            <div class="rv-peer">
              <% if (p.from) { %><div class="who"><%= p.from %></div><% } %>
              <% if (p.comment) { %><div class="what"><%= p.comment %></div><% } %>
            </div>
          <% } }); %>
        </div>
      <% } %>
    </article>
  <% }); %>
</div>
