<%
  // Shared sub-tab strip for the Safety section. Pass subtab = 'swms',
  // 'sop-register', 'updates', 'toolboxes', 'quizzes', or 'comments'.
  // Styling lives on .saf-tab* in worker.css so the strip themes correctly
  // in both light and dark modes.
%>
<div class="saf-tabs">
  <a href="/w/safety/swms"         class="saf-tab <%= subtab === 'swms'         ? 'is-active' : '' %>">SWMS</a>
  <a href="/w/safety/sop-register" class="saf-tab <%= subtab === 'sop-register' ? 'is-active' : '' %>">SOP</a>
  <a href="/w/safety/updates"      class="saf-tab <%= subtab === 'updates'      ? 'is-active' : '' %>">Updates</a>
  <a href="/w/safety/toolboxes"    class="saf-tab <%= subtab === 'toolboxes'    ? 'is-active' : '' %>">Toolbox Meetings</a>
  <a href="/w/safety/quizzes"      class="saf-tab <%= subtab === 'quizzes'      ? 'is-active' : '' %>">Quizzes</a>
  <a href="/w/safety/training"     class="saf-tab <%= subtab === 'training'     ? 'is-active' : '' %>">Training</a>
  <a href="/w/safety/comments"     class="saf-tab <%= subtab === 'comments'     ? 'is-active' : '' %>">Flag &amp; comment</a>
</div>
