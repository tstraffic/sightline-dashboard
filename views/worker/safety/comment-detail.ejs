<%
  function fmt(s) {
    if (!s) return '&mdash;';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  const CHIP_STATUS = {
    submitted:    'background: rgba(16,185,129,0.18); color: #93C5FD; border: 1px solid rgba(16,185,129,0.3);',
    acknowledged: 'background: rgba(245,158,11,0.18); color: #fcd34d; border: 1px solid rgba(245,158,11,0.3);',
    under_review: 'background: rgba(139,92,246,0.18); color: #c4b5fd; border: 1px solid rgba(139,92,246,0.3);',
    closed:       'background: rgba(16,185,129,0.18); color: #6ee7b7; border: 1px solid rgba(16,185,129,0.3);',
  };
%>
<style>
  .cd-wrap { color: #fff; padding: 0 0 24px; }
  .cd-back { display: inline-flex; align-items: center; gap: 6px; color: rgba(255,255,255,0.55); font-size: 0.8rem; text-decoration: none; margin: 4px 0 8px; }
  .cd-h1 { font-size: 1.3rem; font-weight: 800; margin: 4px 0 10px; }
  .cd-meta { display: flex; gap: 10px; flex-wrap: wrap; font-size: 0.72rem; color: rgba(255,255,255,0.55); margin-bottom: 14px; align-items: center; }
  .cd-chip { font-size: 0.65rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; }
  .cd-body {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;
    padding: 14px 16px; font-size: 0.9rem; line-height: 1.55; white-space: pre-line; color: rgba(255,255,255,0.85);
    margin-bottom: 12px;
  }
  .cd-photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 10px; }
  .cd-photos img { width: 100%; height: 90px; object-fit: cover; border-radius: 8px; border: 1px solid rgba(255,255,255,0.08); }
  .cd-response {
    background: rgba(16,185,129,0.10); border: 1px solid rgba(16,185,129,0.3); border-radius: 12px;
    padding: 14px 16px; margin-top: 14px;
  }
  .cd-response-label { font-size: 0.65rem; font-weight: 700; color: #6ee7b7; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
  .cd-response-body { font-size: 0.92rem; line-height: 1.55; white-space: pre-line; color: rgba(255,255,255,0.95); }
  .cd-pending {
    background: rgba(16,185,129,0.10); border: 1px solid rgba(16,185,129,0.3); border-radius: 12px;
    padding: 14px 16px; font-size: 0.85rem; color: rgba(255,255,255,0.75); margin-top: 14px;
  }
</style>

<div class="cd-wrap">
  <a href="/w/safety/comments" class="cd-back">← Safety / Flag &amp; comment</a>
  <div class="cd-h1">Comment #<%= comment.id %> &middot; <%= categoryLabels[comment.category] %></div>
  <div class="cd-meta">
    <span class="cd-chip" style="<%= CHIP_STATUS[comment.status] || CHIP_STATUS.submitted %>"><%= statusLabels[comment.status] %></span>
    <span><%= fmt(comment.created_at) %></span>
    <% if (comment.job_number) { %><span>&middot; <%= comment.job_number %></span><% } %>
    <% if (comment.is_anonymous) { %><span>&middot; anonymous</span><% } %>
  </div>

  <div class="cd-body"><%= comment.body %></div>

  <% if (photos.length) { %>
    <div class="cd-photos">
      <% photos.forEach(p => { %>
        <a href="/w/safety/comments/<%= comment.id %>/photos/<%= p.id %>" target="_blank">
          <img src="/w/safety/comments/<%= comment.id %>/photos/<%= p.id %>" alt="">
        </a>
      <% }) %>
    </div>
  <% } %>

  <% if (comment.office_response) { %>
    <div class="cd-response">
      <div class="cd-response-label">Office response &middot; <%= fmt(comment.response_at) %><% if (comment.response_by_name) { %> &middot; <%= comment.response_by_name %><% } %></div>
      <div class="cd-response-body"><%= comment.office_response %></div>
    </div>
  <% } else { %>
    <div class="cd-pending">
      The safety team has been notified. You'll get a push notification when they respond.
    </div>
  <% } %>
</div>
