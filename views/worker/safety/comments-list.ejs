<%
  function fmt(s) {
    if (!s) return '';
    const d = new Date(s);
    return d.toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
  // Chip class is preferred over inline style so light-mode rules
  // can re-skin each variant.
  const CHIP_CLASS = {
    submitted:    'c-chip-submitted',
    acknowledged: 'c-chip-ack',
    under_review: 'c-chip-review',
    closed:       'c-chip-closed',
  };
%>
<style>
  .saf-wrap { padding: 0; color: #fff; }
  .saf-h1 { font-size: 1.5rem; font-weight: 800; padding: 6px 4px 8px; letter-spacing: -0.01em; }
  .c-empty { text-align: center; padding: 32px 16px; color: rgba(255,255,255,0.45); font-size: 0.85rem; }
  .c-cta {
    display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px;
    background: linear-gradient(135deg, #059669, #10B981); color: #fff; font-weight: 700; font-size: 0.9rem;
    border-radius: 12px; text-decoration: none;
    box-shadow: 0 6px 18px rgba(5,150,105,0.32);
    margin: 4px 0 14px;
  }
  .c-card {
    display: block; text-decoration: none; color: inherit; position: relative;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px;
    padding: 12px 14px; margin-bottom: 8px;
  }
  .c-card.responded { border-left: 3px solid #34D399; }
  .c-card-title { font-size: 0.92rem; font-weight: 700; padding-right: 60px; }
  .c-card-meta { font-size: 0.72rem; color: rgba(255,255,255,0.55); margin-top: 3px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .c-snip { font-size: 0.78rem; color: rgba(255,255,255,0.6); margin-top: 6px; line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .c-chip { font-size: 0.65rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; border: 1px solid transparent; }
  .c-chip-submitted { background: rgba(16,185,129,0.18); color: #93C5FD; border-color: rgba(16,185,129,0.3); }
  .c-chip-ack       { background: rgba(245,158,11,0.18); color: #fcd34d; border-color: rgba(245,158,11,0.3); }
  .c-chip-review    { background: rgba(139,92,246,0.18); color: #c4b5fd; border-color: rgba(139,92,246,0.3); }
  .c-chip-closed    { background: rgba(16,185,129,0.18); color: #6ee7b7; border-color: rgba(16,185,129,0.3); }
  .c-anon { font-size: 0.65rem; color: rgba(255,255,255,0.4); }

  /* ---- Light mode ---- */
  :root[data-theme="light"] .saf-wrap { color: #0F1115; }
  :root[data-theme="light"] .saf-h1   { color: #0F1115; }
  :root[data-theme="light"] .c-empty  { color: #6B7280; }
  :root[data-theme="light"] .c-card   {
    background: #FFFFFF; border-color: #E5E7EB;
    box-shadow: 0 1px 2px rgba(15,17,21,0.04);
  }
  :root[data-theme="light"] .c-card.responded { border-left-color: #047857; }
  :root[data-theme="light"] .c-card-title { color: #0F1115; }
  :root[data-theme="light"] .c-card-meta  { color: #6B7280; }
  :root[data-theme="light"] .c-snip       { color: #4B5563; }
  :root[data-theme="light"] .c-anon       { color: #9CA3AF; }
  :root[data-theme="light"] .c-chip-submitted { background: #EFF6FF; color: #1D4ED8; border-color: #BFDBFE; }
  :root[data-theme="light"] .c-chip-ack       { background: #FFFBEB; color: #B45309; border-color: #FDE68A; }
  :root[data-theme="light"] .c-chip-review    { background: #F5F3FF; color: #6D28D9; border-color: #DDD6FE; }
  :root[data-theme="light"] .c-chip-closed    { background: #ECFDF5; color: #047857; border-color: #A7F3D0; }
</style>

<div class="saf-wrap">
  <h1 class="saf-h1">Safety</h1>
  <%- include('./_tabs') %>

  <a href="/w/safety/comments/new" class="c-cta">
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6"/></svg>
    Flag something / share feedback
  </a>

  <% if (!rows.length) { %>
    <div class="c-empty">You haven't submitted any comments yet. Tap the button above to flag a hazard, ask about a SWMS, or share a suggestion.</div>
  <% } else { %>
    <% rows.forEach(r => { %>
      <a href="/w/safety/comments/<%= r.id %>" class="c-card <%= r.office_response ? 'responded' : '' %>">
        <div class="c-card-title">#<%= r.id %> &middot; <%= categoryLabels[r.category] %></div>
        <div class="c-card-meta">
          <span class="c-chip <%= CHIP_CLASS[r.status] || CHIP_CLASS.submitted %>"><%= statusLabels[r.status] %></span>
          <span><%= fmt(r.created_at) %></span>
          <% if (r.job_number) { %><span>&middot; <%= r.job_number %></span><% } %>
          <% if (r.is_anonymous) { %><span class="c-anon">&middot; submitted anonymously</span><% } %>
        </div>
        <div class="c-snip"><%= r.body %></div>
      </a>
    <% }) %>
  <% } %>
</div>
