<%
  function fmtDate(s) {
    if (!s) return 'â€”';
    return new Date(s).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
  const isResume = latest && latest.status === 'in_progress';
  const hasPassed = latest && latest.passed;
  const lastScore = latest && latest.score_pct;
%>
<style>
  .qi-wrap { color: #fff; padding: 0 0 24px; }
  .qi-back { display: inline-flex; align-items: center; gap: 6px; color: rgba(255,255,255,0.55); font-size: 0.8rem; text-decoration: none; margin: 4px 0 8px; }
  .qi-h1 { font-size: 1.5rem; font-weight: 800; margin: 4px 0 10px; }
  .qi-meta { display: flex; gap: 10px; flex-wrap: wrap; font-size: 0.72rem; color: rgba(255,255,255,0.55); margin-bottom: 14px; }
  .qi-desc {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;
    padding: 14px 16px; font-size: 0.9rem; line-height: 1.55; white-space: pre-line; color: rgba(255,255,255,0.85);
    margin-bottom: 12px;
  }
  .qi-stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 14px; }
  .qi-stat { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 10px 12px; }
  .qi-stat-label { font-size: 0.62rem; font-weight: 700; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 0.06em; }
  .qi-stat-value { font-size: 1.25rem; font-weight: 800; color: #fff; margin-top: 2px; }
  .qi-banner { border-radius: 12px; padding: 12px 14px; font-size: 0.85rem; margin-bottom: 12px; }
  .qi-banner.green { background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.3); color: #6ee7b7; }
  .qi-banner.amber { background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.3); color: #fcd34d; }
  .qi-banner.rose { background: rgba(244,63,94,0.15); border: 1px solid rgba(244,63,94,0.3); color: #fda4af; }
  .qi-cta {
    width: 100%; padding: 14px; border-radius: 12px; font-size: 0.95rem; font-weight: 700; border: 0;
    background: linear-gradient(135deg, #059669, #10B981); color: #fff;
    box-shadow: 0 6px 20px rgba(5,150,105,0.35); cursor: pointer;
  }
  .qi-cta:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<div class="qi-wrap">
  <a href="/w/safety/quizzes" class="qi-back">â† Safety / Quizzes</a>
  <div class="qi-h1"><% if (quiz.is_mandatory) { %><span style="color:#fca5a5; margin-right:6px;">â—</span><% } %><%= quiz.title %></div>
  <div class="qi-meta">
    <span><%= questionCount %> question<%= questionCount === 1 ? '' : 's' %></span>
    <span>Â· pass at <%= quiz.pass_mark %>%</span>
    <% if (quiz.deadline_at) { %><span>Â· due <%= fmtDate(quiz.deadline_at) %></span><% } %>
  </div>

  <% if (hasPassed) { %>
    <div class="qi-banner green">âœ“ You passed this quiz with <%= lastScore %>%.</div>
  <% } else if (latest && latest.status === 'submitted') { %>
    <div class="qi-banner rose">Last attempt: <%= lastScore %>% â€” didn't quite pass.<% if (quiz.retake_policy === 'unlimited' || (quiz.retake_policy === 'limited' && attemptCount < quiz.retake_limit)) { %> You can try again below.<% } %></div>
  <% } else if (isResume) { %>
    <div class="qi-banner amber">You have an attempt in progress. Pick up where you left off.</div>
  <% } %>

  <% if (quiz.description) { %>
    <div class="qi-desc"><%= quiz.description %></div>
  <% } %>

  <div class="qi-stat-grid">
    <div class="qi-stat">
      <div class="qi-stat-label">Attempts</div>
      <div class="qi-stat-value"><%= attemptCount %></div>
    </div>
    <div class="qi-stat">
      <div class="qi-stat-label">Retakes</div>
      <div class="qi-stat-value" style="font-size: 0.9rem;">
        <%
          if (quiz.retake_policy === 'unlimited') { %>Unlimited<% }
          else if (quiz.retake_policy === 'none') { %>None<% }
          else { %><%= quiz.retake_limit %> allowed<% }
        %>
      </div>
    </div>
  </div>

  <% if (blocked && !isResume) { %>
    <div class="qi-banner rose"><%= blocked %></div>
    <button class="qi-cta" disabled>Unavailable</button>
  <% } else { %>
    <form method="POST" action="/w/safety/quizzes/<%= quiz.id %>/start">
      <%- include('../../partials/csrf') %>
      <button type="submit" class="qi-cta">
        <% if (isResume) { %>Resume quiz<% } else if (latest) { %>Try again<% } else { %>Start quiz<% } %>
      </button>
    </form>
  <% } %>
</div>
