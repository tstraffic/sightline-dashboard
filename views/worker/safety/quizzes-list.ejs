<%
  function fmtDate(s) {
    if (!s) return '';
    return new Date(s).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
  // Chip class is preferred over an inline style so light-mode rules can
  // re-skin each variant. The inline-style version baked in dark-mode
  // hues (#93C5FD / #fcd34d / #6ee7b7 / #fda4af) which were unreachable
  // from CSS in light theme.
  function statusMeta(row) {
    if (!row.latest_status) return { label: 'Not started', cls: 'qz-chip-todo' };
    if (row.latest_status === 'in_progress') return { label: 'Resume', cls: 'qz-chip-resume' };
    if (row.latest_passed) return { label: 'Passed &middot; ' + row.latest_score + '%', cls: 'qz-chip-pass' };
    return { label: 'Failed &middot; ' + row.latest_score + '%', cls: 'qz-chip-fail' };
  }
%>
<style>
  .saf-wrap { padding: 0; color: #fff; }
  .saf-h1 { font-size: 1.5rem; font-weight: 800; padding: 6px 4px 8px; letter-spacing: -0.01em; }
  .qz-card {
    display: block; text-decoration: none; color: inherit; position: relative;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px;
    padding: 12px 14px; margin-bottom: 8px;
  }
  .qz-card.mandatory { border-left: 3px solid #f87171; }
  .qz-card-title { font-size: 0.95rem; font-weight: 700; }
  .qz-meta { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; font-size: 0.7rem; color: rgba(255,255,255,0.55); margin-top: 4px; }
  .qz-snip { font-size: 0.78rem; color: rgba(255,255,255,0.6); margin-top: 6px; line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .qz-chip { font-size: 0.65rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; border: 1px solid transparent; }
  .qz-chip-todo   { background: rgba(16,185,129,0.18); color: #93C5FD; border-color: rgba(16,185,129,0.3); }
  .qz-chip-resume { background: rgba(245,158,11,0.18); color: #fcd34d; border-color: rgba(245,158,11,0.3); }
  .qz-chip-pass   { background: rgba(16,185,129,0.18); color: #6ee7b7; border-color: rgba(16,185,129,0.3); }
  .qz-chip-fail   { background: rgba(244,63,94,0.18);  color: #fda4af; border-color: rgba(244,63,94,0.3); }
  .qz-empty { text-align: center; padding: 32px 16px; color: rgba(255,255,255,0.45); font-size: 0.85rem; }

  /* ---- Light mode ---- the dark defaults above render every row as
     white-on-white once a quiz title or row chip is filled in. Match
     the SWMS/SOP look (white cards on the light page, hairline border,
     1px shadow) and re-skin every chip variant. */
  :root[data-theme="light"] .saf-wrap { color: #0F1115; }
  :root[data-theme="light"] .saf-h1   { color: #0F1115; }
  :root[data-theme="light"] .qz-card  {
    background: #FFFFFF; border-color: #E5E7EB;
    box-shadow: 0 1px 2px rgba(15,17,21,0.04);
  }
  :root[data-theme="light"] .qz-card.mandatory { border-left-color: #B91C1C; }
  :root[data-theme="light"] .qz-card-title { color: #0F1115; }
  :root[data-theme="light"] .qz-snip       { color: #4B5563; }
  :root[data-theme="light"] .qz-meta       { color: #6B7280; }
  :root[data-theme="light"] .qz-chip-todo   { background: #EFF6FF; color: #1D4ED8; border-color: #BFDBFE; }
  :root[data-theme="light"] .qz-chip-resume { background: #FFFBEB; color: #B45309; border-color: #FDE68A; }
  :root[data-theme="light"] .qz-chip-pass   { background: #ECFDF5; color: #047857; border-color: #A7F3D0; }
  :root[data-theme="light"] .qz-chip-fail   { background: #FEF2F2; color: #B91C1C; border-color: #FECACA; }
  :root[data-theme="light"] .qz-empty { color: #6B7280; }
</style>

<div class="saf-wrap">
  <h1 class="saf-h1">Safety</h1>
  <%- include('./_tabs') %>

  <% if (!rows.length) { %>
    <div class="qz-empty">No quizzes posted yet.</div>
  <% } else { %>
    <% rows.forEach(r => {
      const sm = statusMeta(r);
    %>
      <a href="/w/safety/quizzes/<%= r.id %>" class="qz-card<%= r.is_mandatory ? ' mandatory' : '' %>">
        <div class="qz-card-title">
          <% if (r.is_mandatory) { %><span style="color:#fca5a5; margin-right:6px;">●</span><% } %><%= r.title %>
        </div>
        <% if (r.description) { %><div class="qz-snip"><%= r.description %></div><% } %>
        <div class="qz-meta">
          <span class="qz-chip <%= sm.cls %>"><%- sm.label %></span>
          <span><%= r.question_count %> question<%= r.question_count === 1 ? '' : 's' %></span>
          <% if (r.deadline_at) { %><span>&middot; due <%= fmtDate(r.deadline_at) %></span><% } %>
        </div>
      </a>
    <% }) %>
  <% } %>
</div>
