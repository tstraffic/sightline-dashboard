<%
  const isCurrent = !!currentAck;
  const showAckBar = !isCurrent;
%>
<style>
  body { background: #020817; }
  .pv-wrap { min-height: 100vh; display: flex; flex-direction: column; }
  .pv-topbar {
    position: sticky; top: 0; z-index: 10;
    padding: calc(env(safe-area-inset-top, 0px) + 4px) 12px 8px;
    background: rgba(10,22,40,0.96);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    display: flex; align-items: center; gap: 10px;
    backdrop-filter: blur(8px);
  }
  .pv-back {
    width: 36px; height: 36px; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
    text-decoration: none;
  }
  .pv-back:active { background: rgba(255,255,255,0.12); }
  .pv-title { flex: 1; min-width: 0; font-size: 0.95rem; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pv-pages { flex: 1; padding: 8px 8px <%= showAckBar ? 'calc(80px + env(safe-area-inset-bottom, 0px))' : '8px' %>; }
  .pv-actionbar { position: fixed; left: 0; right: 0; bottom: 0; padding: 12px 12px calc(12px + env(safe-area-inset-bottom, 0px)); background: rgba(10,22,40,0.96); border-top: 1px solid rgba(255,255,255,0.08); z-index: 40; }
  .pv-ack-btn { width: 100%; padding: 14px; border-radius: 12px; font-size: 0.95rem; font-weight: 700; border: 0; background: linear-gradient(135deg, #1D6AE5, #2B7FFF); color: #fff; box-shadow: 0 6px 20px rgba(29,106,229,0.35); }
  .pv-ack-btn:active { transform: translateY(1px); }
</style>

<div class="pv-wrap">
  <div class="pv-topbar">
    <a href="/w/safety/sop-register/<%= sop.id %>" class="pv-back" onclick="if(history.length>1){history.back();return false}" aria-label="Back">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <div class="pv-title"><%= sop.title %></div>
  </div>

  <div class="pv-pages">
    <% if (sop.file_path) { %>
      <div class="pdf-viewer"
           data-pdf-src="/w/safety/sop-register/<%= sop.id %>/file"
           data-pdf-name="<%= (sop.file_original_name || sop.title || 'SOP') %>"></div>
    <% } else { %>
      <div style="color: rgba(255,255,255,0.6); text-align: center; padding: 60px 16px;">No previewable document attached.</div>
    <% } %>
  </div>

  <% if (showAckBar) { %>
    <div class="pv-actionbar">
      <form method="POST" action="/w/safety/sop-register/<%= sop.id %>/acknowledge">
        <%- include('../../partials/csrf') %>
        <button type="submit" class="pv-ack-btn">I have read and understood this SOP</button>
      </form>
    </div>
  <% } %>
</div>

<% if (sop.file_path) { %>
<script src="/js/worker-pdf-viewer.js?v=3"></script>
<% } %>
