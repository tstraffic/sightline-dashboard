<%
  function fmt(s) {
    if (!s) return '&mdash;';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  function fmtDate(s) {
    if (!s) return '&mdash;';
    return new Date(s).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
  const isCurrent = !!currentAck;
  const priorOnly = !currentAck && !!lastAnyAck;
  const isLocked = !hasAccess;
%>
<style>
  .sd-wrap { color: #fff; padding: 0 0 110px; }
  .sd-back { display: inline-flex; align-items: center; gap: 6px; color: rgba(255,255,255,0.55); font-size: 0.8rem; text-decoration: none; margin: 4px 0 8px; }
  .sd-title { font-size: 1.35rem; font-weight: 800; line-height: 1.2; margin-bottom: 8px; }
  .sd-meta { display: flex; gap: 10px; flex-wrap: wrap; font-size: 0.7rem; color: rgba(255,255,255,0.55); margin-bottom: 14px; }
  .sd-banner {
    border-radius: 12px; padding: 12px 14px; font-size: 0.82rem; margin-bottom: 14px; line-height: 1.4;
  }
  .sd-banner.amber { background-image: linear-gradient(180deg, rgba(245,158,11,0.16) 0%, rgba(245,158,11,0.04) 100%); border: 1px solid rgba(245,158,11,0.30); color: #fcd34d; box-shadow: inset 0 1px 0 rgba(255,255,255,0.05); }
  .sd-banner.green { background-image: linear-gradient(180deg, rgba(16,185,129,0.16) 0%, rgba(16,185,129,0.04) 100%); border: 1px solid rgba(16,185,129,0.30); color: #6ee7b7; box-shadow: inset 0 1px 0 rgba(255,255,255,0.05); }
  .sd-banner.rose  { background-image: linear-gradient(180deg, rgba(244,63,94,0.16)  0%, rgba(244,63,94,0.04)  100%); border: 1px solid rgba(244,63,94,0.30);  color: #fda4af; box-shadow: inset 0 1px 0 rgba(255,255,255,0.05); }
  .sd-banner.slate { background-image: linear-gradient(180deg, rgba(148,163,184,0.14) 0%, rgba(148,163,184,0.04) 100%); border: 1px solid rgba(148,163,184,0.30); color: #e2e8f0; box-shadow: inset 0 1px 0 rgba(255,255,255,0.05); }
  /* Client-side PDF.js renders each page to a <canvas> inside .pdf-viewer.
     Styles for the canvases come from /js/worker-pdf-viewer.js (injected
     once on first init). The download button below is in-app &mdash; it links
     to /view (chrome-free fullscreen) and never opens a new tab. */
  .sd-fullscreen {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 14px;
    background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.3);
    border-radius: 10px; color: #93C5FD; font-weight: 600; font-size: 0.9rem;
    text-decoration: none; margin: 0 0 12px; width: 100%;
  }
  .sd-fullscreen:active { background: rgba(16,185,129,0.25); }
  .sd-actionbar {
    position: fixed; left: 0; right: 0; bottom: 64px; padding: 12px 12px calc(12px + env(safe-area-inset-bottom, 0px));
    background: rgba(10,22,40,0.96); border-top: 1px solid rgba(255,255,255,0.08); z-index: 40;
  }
  .sd-ack-btn {
    width: 100%; padding: 14px; border-radius: 12px; font-size: 0.95rem; font-weight: 700; border: 0;
    background: linear-gradient(135deg, #059669, #10B981); color: #fff;
    box-shadow: 0 6px 20px rgba(5,150,105,0.35);
    transition: opacity 0.15s;
  }
  .sd-ack-btn:active { transform: translateY(1px); }
  .sd-ack-btn:disabled { opacity: 0.45; box-shadow: none; }
  /* Signature pad &mdash; drawn ABOVE the fold (not in the action bar) so the
     keyboard / signing hand doesn't overlap the canvas. The pad uses
     touch-action: none so finger drags don't scroll the page. */
  .sd-sign-card {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.10);
    border-radius: 12px; padding: 14px; margin: 14px 0 80px;
  }
  .sd-sign-card h3 { font-size: 0.95rem; font-weight: 700; margin: 0; color: #fff; }
  .sd-sign-card p.hint { font-size: 0.78rem; color: rgba(255,255,255,0.6); margin: 4px 0 12px; line-height: 1.4; }
  .sd-sign-pad-wrap {
    position: relative; border-radius: 10px;
    background-image: repeating-linear-gradient(to bottom, rgba(255,255,255,0.03) 0, rgba(255,255,255,0.03) 23px, rgba(255,255,255,0.06) 23px, rgba(255,255,255,0.06) 24px);
    background-color: rgba(255,255,255,0.92);
    border: 1px solid rgba(255,255,255,0.12); overflow: hidden;
  }
  .sd-sign-pad { display: block; width: 100%; height: 180px; touch-action: none; cursor: crosshair; }
  .sd-sign-placeholder {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    font-size: 0.78rem; color: rgba(15,23,42,0.45); pointer-events: none; font-weight: 500;
  }
  .sd-sign-footer {
    display: flex; align-items: center; justify-content: space-between;
    padding: 6px 10px; background: rgba(0,0,0,0.25); border-top: 1px solid rgba(255,255,255,0.08);
  }
  .sd-sign-footer span { font-size: 0.65rem; color: rgba(255,255,255,0.55); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; }
  .sd-sign-clear { background: none; border: 0; color: rgba(255,255,255,0.6); font-size: 0.75rem; font-weight: 600; cursor: pointer; padding: 4px 8px; }
  .sd-sign-clear:active { color: #fff; }
  .sd-prev-sig {
    background: rgba(255,255,255,0.95); border-radius: 8px; padding: 8px;
    border: 1px solid rgba(255,255,255,0.15); margin-top: 6px;
  }
  .sd-prev-sig img { display: block; max-height: 80px; max-width: 100%; margin: 0 auto; }
  .sd-lock-card {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; padding: 16px; margin-bottom: 14px; text-align: center;
  }
  .sd-lock-icon-lg { width: 36px; height: 36px; opacity: 0.7; margin: 4px auto 8px; display: block; }
  .sd-lock-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 6px; }
  .sd-lock-card p { font-size: 0.82rem; color: rgba(255,255,255,0.65); line-height: 1.45; }
  .sd-form-card {
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; padding: 14px; margin-bottom: 14px;
  }
  .sd-form-card h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 4px; }
  .sd-form-card p.sd-form-sub { font-size: 0.78rem; color: rgba(255,255,255,0.6); margin-bottom: 12px; line-height: 1.4; }
  .sd-field { margin-bottom: 10px; }
  .sd-field label { display: block; font-size: 0.72rem; font-weight: 600; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
  .sd-field input, .sd-field textarea {
    width: 100%; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.12);
    border-radius: 8px; padding: 10px 12px; color: #fff; font-size: 0.9rem;
    font-family: inherit;
  }
  .sd-field input:focus, .sd-field textarea:focus {
    outline: none; border-color: rgba(16,185,129,0.6);
  }
  .sd-field textarea { resize: vertical; min-height: 70px; }
  .sd-req-btn {
    width: 100%; padding: 12px; border-radius: 10px; font-size: 0.9rem; font-weight: 700; border: 0;
    background: linear-gradient(135deg, #059669, #10B981); color: #fff;
  }
</style>

<div class="sd-wrap">
  <a href="/w/safety/swms" class="sd-back">â† Safety / SWMS</a>
  <div class="sd-title"><%= swms.title %></div>
  <div class="sd-meta">
    <span><%= swms.kind === 'template' ? 'Generic' : 'Job-linked' %></span>
    <% if (swms.job_number) { %><span>&middot; <%= swms.job_number %></span><% } %>
    <% if (swms.client) { %><span>&middot; <%= swms.client %></span><% } %>
    <% if (swms.version_published_at) { %><span>&middot; Version published <%= fmt(swms.version_published_at) %></span><% } %>
  </div>

  <% if (isLocked) { %>
    <div class="sd-lock-card">
      <svg class="sd-lock-icon-lg" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c-1.105 0-2 .895-2 2v3h4v-3c0-1.105-.895-2-2-2zm6 5V9a6 6 0 10-12 0v7a2 2 0 002 2h8a2 2 0 002-2z"/></svg>
      <h3>This SWMS is locked</h3>
      <p>Job-linked SWMS are only available to crew who have been inducted onto the job site. If you've completed the induction (with us or the client), request confirmation below.</p>
    </div>

    <% if (swms.description) { %>
      <p style="font-size: 0.85rem; color: rgba(255,255,255,0.65); margin-bottom: 14px; white-space: pre-line;"><%= swms.description %></p>
    <% } %>

    <% if (pendingRequest) { %>
      <div class="sd-banner amber" data-attention="amber">
        Your access request was submitted on <%= fmt(pendingRequest.created_at) %>. The office will confirm your induction and unlock this SWMS shortly.
        <% if (pendingRequest.inducted_with) { %><br><span style="opacity:0.85;">Inducted with: <%= pendingRequest.inducted_with %></span><% } %>
      </div>
    <% } else if (lastDecidedRequest && lastDecidedRequest.status === 'rejected') { %>
      <div class="sd-banner rose" data-attention="rose">
        A previous request was declined on <%= fmt(lastDecidedRequest.decided_at) %>.
        <% if (lastDecidedRequest.decision_note) { %><br><span style="opacity:0.9;">Note: <%= lastDecidedRequest.decision_note %></span><% } %>
        <br>You can submit a new request if your situation has changed.
      </div>
    <% } %>

    <% if (!pendingRequest) { %>
      <div class="sd-form-card">
        <h3>Request access</h3>
        <p class="sd-form-sub">Tell us where you completed the site induction so we can confirm and unlock this SWMS.</p>
        <form method="POST" action="/w/safety/swms/<%= swms.id %>/request-access">
          <%- include('../../partials/csrf') %>
          <div class="sd-field">
            <label for="inducted_with">Inducted with</label>
            <input type="text" id="inducted_with" name="inducted_with" placeholder="e.g. T&S, John Holland, Abergeldie" maxlength="120" required>
          </div>
          <div class="sd-field">
            <label for="induction_date">Induction date (optional)</label>
            <input type="date" id="induction_date" name="induction_date">
          </div>
          <div class="sd-field">
            <label for="worker_note">Notes for the office (optional)</label>
            <textarea id="worker_note" name="worker_note" placeholder="Anything that helps confirm your induction..." maxlength="1000"></textarea>
          </div>
          <button type="submit" class="sd-req-btn">Submit request</button>
        </form>
      </div>
    <% } %>

  <% } else { %>

    <% if (isCurrent) { %>
      <div class="sd-banner green">
        Acknowledged on <%= fmt(currentAck.signed_at) %>.
        <% if (currentAck.signature_url) { %>
          <div class="sd-prev-sig"><img src="<%= currentAck.signature_url %>" alt="Your signature"></div>
        <% } %>
      </div>
    <% } else if (priorOnly) { %>
      <div class="sd-banner amber" data-attention="amber">âš  This SWMS has been updated since you last acknowledged it (<%= fmt(lastAnyAck.signed_at) %>). Please review and re-sign below.</div>
    <% } else { %>
      <div class="sd-banner rose" data-attention="rose">You have not acknowledged this SWMS yet. Read it through, sign at the bottom, then tap acknowledge.</div>
    <% } %>

    <% if (swms.description) { %>
      <p style="font-size: 0.85rem; color: rgba(255,255,255,0.75); margin-bottom: 12px; white-space: pre-line;"><%= swms.description %></p>
    <% } %>

    <% if (swms.file_path) { %>
      <!-- Open-fullscreen sits ABOVE the inline viewer so workers can jump
           straight to the chrome-free fullscreen reader if they want &mdash; no
           scrolling past pages of inline PDF first. -->
      <a href="/w/safety/swms/<%= swms.id %>/view" class="sd-fullscreen">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5v4m0-4h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"/></svg>
        Open full screen
      </a>
      <div class="pdf-viewer"
           data-pdf-src="/w/safety/swms/<%= swms.id %>/file"
           data-pdf-name="<%= (swms.file_original_name || swms.title || 'SWMS') %>"></div>
    <% } else { %>
      <p style="color: rgba(255,255,255,0.5); font-size: 0.85rem;">No document attached.</p>
    <% } %>

    <% if (!isCurrent) { %>
      <!-- Signature pad &mdash; required before the action bar's Acknowledge
           button enables. Stays in the normal flow so the user can see
           the canvas while signing (no overlap with the fixed bottom). -->
      <div class="sd-sign-card">
        <h3>Sign to acknowledge</h3>
        <p class="hint">By signing you confirm that you've read and understood this SWMS and will work in accordance with it.</p>
        <div class="sd-sign-pad-wrap">
          <canvas id="sd-sign-pad" class="sd-sign-pad"></canvas>
          <span id="sd-sign-placeholder" class="sd-sign-placeholder">Sign with your finger</span>
          <div class="sd-sign-footer">
            <span>Signature</span>
            <button type="button" id="sd-sign-clear" class="sd-sign-clear">Clear</button>
          </div>
        </div>
      </div>
    <% } %>

  <% } %>
</div>

<% if (!isLocked && !isCurrent) { %>
  <div class="sd-actionbar">
    <form method="POST" action="/w/safety/swms/<%= swms.id %>/acknowledge" id="sd-ack-form"
          data-offline-form data-offline-scope="SWMS acknowledgement"
          data-success-url="/w/safety/swms/<%= swms.id %>">
      <%- include('../../partials/csrf') %>
      <input type="hidden" name="signature_data" id="sd-sign-data">
      <button type="submit" id="sd-ack-btn" class="sd-ack-btn" disabled>Sign &amp; acknowledge</button>
    </form>
  </div>

  <script>
    // Signature pad — minimal, works with both touch and mouse. Enables the
    // Acknowledge button as soon as the worker actually draws something so
    // empty/accidental submissions can't go through.
    (function () {
      var canvas = document.getElementById('sd-sign-pad');
      if (!canvas) return;
      var placeholder = document.getElementById('sd-sign-placeholder');
      var clearBtn    = document.getElementById('sd-sign-clear');
      var submitBtn   = document.getElementById('sd-ack-btn');
      var dataInput   = document.getElementById('sd-sign-data');
      var form        = document.getElementById('sd-ack-form');

      var ctx = canvas.getContext('2d');
      var drawing = false;
      var last = null;
      var hasInk = false;

      function size() {
        var dpr = window.devicePixelRatio || 1;
        var rect = canvas.getBoundingClientRect();
        if (rect.width === 0) return;
        canvas.width  = rect.width * dpr;
        canvas.height = rect.height * dpr;
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.scale(dpr, dpr);
        ctx.lineWidth = 2.4;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#0f172a';
      }
      size();
      window.addEventListener('resize', size);

      function xy(e) {
        var r = canvas.getBoundingClientRect();
        var t = e.touches ? e.touches[0] : e;
        return { x: t.clientX - r.left, y: t.clientY - r.top };
      }
      function start(e) {
        e.preventDefault();
        drawing = true;
        last = xy(e);
        placeholder.style.display = 'none';
      }
      function move(e) {
        if (!drawing) return;
        e.preventDefault();
        var p = xy(e);
        ctx.beginPath();
        ctx.moveTo(last.x, last.y);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
        last = p;
        if (!hasInk) {
          hasInk = true;
          submitBtn.disabled = false;
        }
      }
      function end() { drawing = false; }

      canvas.addEventListener('mousedown', start);
      canvas.addEventListener('mousemove', move);
      canvas.addEventListener('mouseup', end);
      canvas.addEventListener('mouseleave', end);
      canvas.addEventListener('touchstart', start, { passive: false });
      canvas.addEventListener('touchmove', move, { passive: false });
      canvas.addEventListener('touchend', end);

      clearBtn.addEventListener('click', function () {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        hasInk = false;
        placeholder.style.display = '';
        submitBtn.disabled = true;
      });

      form.addEventListener('submit', function (e) {
        if (!hasInk) {
          e.preventDefault();
          alert('Please draw your signature before acknowledging.');
          return;
        }
        dataInput.value = canvas.toDataURL('image/png');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting…';
      });
    })();
  </script>
<% } %>

<% if (!isLocked && swms.file_path) { %>
<script src="/js/worker-pdf-viewer.js?v=6"></script>
<% } %>
