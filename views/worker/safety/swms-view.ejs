<%
  const isCurrent = !!currentAck;
  const showAckBar = !isCurrent;
%>
<style>
  body { background: #020817; }
  .pv-wrap { min-height: 100vh; display: flex; flex-direction: column; }
  .pv-topbar {
    position: sticky; top: 0; z-index: 10;
    padding: calc(env(safe-area-inset-top, 0px) + 4px) 12px 8px;
    background: rgba(10,22,40,0.96);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    display: flex; align-items: center; gap: 10px;
    backdrop-filter: blur(8px);
  }
  .pv-back {
    width: 36px; height: 36px; border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);
    text-decoration: none;
  }
  .pv-back:active { background: rgba(255,255,255,0.12); }
  .pv-title { flex: 1; min-width: 0; font-size: 0.95rem; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pv-pages {
    flex: 1;
    padding: 8px 8px <%= showAckBar ? 'calc(80px + env(safe-area-inset-bottom, 0px))' : '8px' %>;
  }
  .pv-pages img {
    display: block; width: 100%; height: auto;
    margin: 0 auto 8px; border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.06);
    background: #fff;
  }
  .pv-prep {
    color: rgba(255,255,255,0.7); text-align: center; padding: 60px 16px; font-size: 0.9rem;
  }
  .pv-prep-dot {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%;
    background: #2B7FFF; margin: 0 2px; animation: pv-pulse 1.2s infinite ease-in-out;
  }
  .pv-prep-dot:nth-child(2) { animation-delay: 0.15s; }
  .pv-prep-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes pv-pulse { 0%,100% { opacity: 0.35; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1); } }
  .pv-actionbar {
    position: fixed; left: 0; right: 0; bottom: 0;
    padding: 12px 12px calc(12px + env(safe-area-inset-bottom, 0px));
    background: rgba(10,22,40,0.96); border-top: 1px solid rgba(255,255,255,0.08); z-index: 40;
  }
  .pv-ack-btn {
    width: 100%; padding: 14px; border-radius: 12px; font-size: 0.95rem; font-weight: 700; border: 0;
    background: linear-gradient(135deg, #1D6AE5, #2B7FFF); color: #fff;
    box-shadow: 0 6px 20px rgba(29,106,229,0.35);
  }
  .pv-ack-btn:active { transform: translateY(1px); }
</style>

<div class="pv-wrap">
  <div class="pv-topbar">
    <a href="/w/safety/swms/<%= swms.id %>" class="pv-back" onclick="if(history.length>1){history.back();return false}" aria-label="Back">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <div class="pv-title"><%= swms.title %></div>
  </div>

  <div class="pv-pages" id="pv-pages">
    <% if (pageCount > 0) { %>
      <% for (let n = 1; n <= pageCount; n++) { %>
        <img src="/w/safety/swms/<%= swms.id %>/pages/<%= n %>.png?v=<%= encodeURIComponent(cacheKey) %>" loading="<%= n === 1 ? 'eager' : 'lazy' %>" decoding="async" alt="Page <%= n %>">
      <% } %>
    <% } else if (renderablePdf) { %>
      <div class="pv-prep" id="pv-prep" data-poll-url="/w/safety/swms/<%= swms.id %>/pages">
        Preparing document<span class="pv-prep-dot"></span><span class="pv-prep-dot"></span><span class="pv-prep-dot"></span>
      </div>
    <% } else { %>
      <div class="pv-prep">No previewable document attached.</div>
    <% } %>
  </div>

  <% if (showAckBar) { %>
    <div class="pv-actionbar">
      <form method="POST" action="/w/safety/swms/<%= swms.id %>/acknowledge">
        <%- include('../../partials/csrf') %>
        <button type="submit" class="pv-ack-btn">I have read and understood this SWMS</button>
      </form>
    </div>
  <% } %>
</div>

<% if (renderablePdf && pageCount === 0) { %>
<script>
(function () {
  // Poll /pages until the render finishes, then reload so the EJS branch
  // takes over with the full image stack.
  var el = document.getElementById('pv-prep');
  if (!el) return;
  var url = el.getAttribute('data-poll-url');
  var tries = 0;
  function tick() {
    tries++;
    fetch(url, { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.ready && d.count > 0) { location.reload(); return; }
        if (tries > 60) return; // give up after ~1min
        setTimeout(tick, 1500);
      })
      .catch(function () { if (tries < 60) setTimeout(tick, 2500); });
  }
  setTimeout(tick, 1200);
})();
</script>
<% } %>
