<%
  function fmt(s) {
    if (!s) return '';
    const d = new Date(s);
    return d.toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
  function fmtStamp(s) {
    if (!s) return '';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  // "Has the toolbox been held yet?" Compared in plain UTC ms which is
  // fine for the day-grain decision we need here — held_at is stored
  // as a Sydney-local datetime but we only need past/future for the
  // status chip. Stays consistent with how the detail page treats it.
  const nowMs = Date.now();
  function chipFor(row) {
    const heldMs = row.held_at ? new Date(row.held_at).getTime() : null;
    const isPast = heldMs !== null && heldMs <= nowMs;
    const s = row.my_status;
    // Status vocabulary (matches the admin attendance page + invite link):
    //   Pending       — no row yet (invite sent, no response)
    //   Attending     — RSVP'd yes, meeting still upcoming
    //   Attended      — signed off after the meeting (timestamped)
    //   Absent        — said attending but the meeting passed without a
    //                   sign-off; also covers no-response rows on past
    //                   meetings (so they don't read as "Pending forever")
    //   Not attending — explicitly declined the invite
    //   Caught up     — self-claimed they read the materials
    if (s === 'attended')  return { cls: 'att',     label: 'Attended',      detail: row.my_recorded_at ? 'Signed off ' + fmtStamp(row.my_recorded_at) : '' };
    if (s === 'caught_up') return { cls: 'caught',  label: 'Caught up',     detail: row.my_recorded_at ? 'Caught up ' + fmtStamp(row.my_recorded_at)   : '' };
    if (s === 'absent')    return { cls: 'absent',  label: 'Not attending', detail: row.my_recorded_at ? 'You declined ' + fmtStamp(row.my_recorded_at) : '' };
    if (s === 'attending') {
      if (isPast) return { cls: 'absent', label: 'Absent', detail: row.my_recorded_at ? 'You said you would attend on ' + fmtStamp(row.my_recorded_at) + ' but never signed off' : '' };
      return { cls: 'att', label: 'Attending', detail: row.my_recorded_at ? 'You confirmed to attend on ' + fmtStamp(row.my_recorded_at) : '' };
    }
    // No record at all.
    if (isPast) return { cls: 'absent', label: 'Absent', detail: 'No response recorded before the meeting' };
    return { cls: 'pending', label: 'Pending', detail: '' };
  }
%>
<style>
  .saf-wrap { padding: 0; color: #fff; }
  .saf-h1 { font-size: 1.5rem; font-weight: 800; padding: 6px 4px 8px; letter-spacing: -0.01em; }
  .tb-card {
    display: block; text-decoration: none; color: inherit;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px;
    padding: 12px 14px; margin-bottom: 8px;
  }
  .tb-card-title { font-size: 0.95rem; font-weight: 700; }
  .tb-card-meta { font-size: 0.72rem; color: rgba(255,255,255,0.55); margin-top: 4px; }
  .tb-snip { font-size: 0.78rem; color: rgba(255,255,255,0.55); margin-top: 6px; line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tb-chip {
    display: inline-block; font-size: 0.65rem; font-weight: 700; padding: 2px 8px; border-radius: 999px;
    margin-top: 6px;
  }
  .tb-chip.att    { background: rgba(16,185,129,0.18); color: #6ee7b7; border: 1px solid rgba(16,185,129,0.3); }
  .tb-chip.caught { background: rgba(139,92,246,0.18); color: #c4b5fd; border: 1px solid rgba(139,92,246,0.3); }
  .tb-chip.absent { background: rgba(244,63,94,0.18);  color: #fca5a5; border: 1px solid rgba(244,63,94,0.3); }
  .tb-chip.pending{ background: rgba(245,158,11,0.18); color: #fcd34d; border: 1px solid rgba(245,158,11,0.3); }
  .tb-chip.miss   { background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.55); border: 1px solid rgba(255,255,255,0.10); }
  .tb-chip-detail { display: block; font-size: 0.68rem; color: rgba(255,255,255,0.55); margin-top: 4px; line-height: 1.35; }
  .tb-reason {
    margin-top: 8px; padding: 8px 10px; border-radius: 8px;
    background: rgba(244,63,94,0.10); border: 1px solid rgba(244,63,94,0.22);
    color: #fda4af; font-size: 0.72rem; line-height: 1.4;
  }
  .tb-reason b { color: #fff; font-weight: 600; }
  .saf-empty { text-align: center; padding: 32px 16px; color: rgba(255,255,255,0.45); font-size: 0.85rem; }

  /* ---- Light mode ---- the dark defaults above render white-on-white
     once a toolbox row has chips / details / "Your reason:" content
     filled in. Re-skin each surface in light tones so the page is
     actually readable. */
  :root[data-theme="light"] .saf-wrap { color: #0F1115; }
  :root[data-theme="light"] .saf-h1   { color: #0F1115; }
  :root[data-theme="light"] .tb-card  {
    background: #FFFFFF; border-color: #E5E7EB;
    box-shadow: 0 1px 2px rgba(15,17,21,0.04);
  }
  :root[data-theme="light"] .tb-card-title { color: #0F1115; }
  :root[data-theme="light"] .tb-card-meta  { color: #6B7280; }
  :root[data-theme="light"] .tb-snip       { color: #6B7280; }
  :root[data-theme="light"] .tb-chip.att    { background: #ECFDF5; color: #047857; border-color: #A7F3D0; }
  :root[data-theme="light"] .tb-chip.caught { background: #F5F3FF; color: #6D28D9; border-color: #DDD6FE; }
  :root[data-theme="light"] .tb-chip.absent { background: #FEF2F2; color: #B91C1C; border-color: #FECACA; }
  :root[data-theme="light"] .tb-chip.pending{ background: #FFFBEB; color: #B45309; border-color: #FDE68A; }
  :root[data-theme="light"] .tb-chip.miss   { background: #F3F4F6; color: #4B5563; border-color: #E5E7EB; }
  :root[data-theme="light"] .tb-chip-detail { color: #6B7280; }
  :root[data-theme="light"] .tb-reason   { background: #FEF2F2; border-color: #FECACA; color: #9F1239; }
  :root[data-theme="light"] .tb-reason b { color: #7F1D1D; }
  :root[data-theme="light"] .saf-empty   { color: #6B7280; }
</style>

<div class="saf-wrap">
  <h1 class="saf-h1">Safety</h1>
  <%- include('./_tabs') %>

  <% if (!rows.length) { %>
    <div class="saf-empty">No toolbox meetings posted yet.</div>
  <% } else { %>
    <% rows.forEach(r => {
      const chip = chipFor(r);
    %>
      <a href="/w/safety/toolboxes/<%= r.id %>" class="tb-card">
        <div class="tb-card-title"><%= r.title %></div>
        <div class="tb-card-meta"><%= fmt(r.held_at) %><% if (r.presenter) { %> · <%= r.presenter %><% } %></div>
        <% if (r.key_points) { %><div class="tb-snip"><%= r.key_points %></div><% } %>
        <span class="tb-chip <%= chip.cls %>"<% if (chip.detail) { %> title="<%= chip.detail %>"<% } %>><%= chip.label %></span>
        <% if (chip.detail) { %><span class="tb-chip-detail"><%= chip.detail %></span><% } %>
        <% if (r.my_status === 'absent' && r.my_absence_reason) { %>
          <div class="tb-reason"><b>Your reason:</b> <%= r.my_absence_reason %></div>
        <% } %>
      </a>
    <% }) %>
  <% } %>
</div>
