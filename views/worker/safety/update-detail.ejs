<%
  function fmt(s) {
    if (!s) return '—';
    return new Date(s).toLocaleString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  }
  const CHIP_STYLE = {
    general:       'background: rgba(43,127,255,0.18); color: #93C5FD; border: 1px solid rgba(43,127,255,0.3);',
    alert:         'background: rgba(244,63,94,0.18); color: #fda4af; border: 1px solid rgba(244,63,94,0.3);',
    reminder:      'background: rgba(245,158,11,0.18); color: #fcd34d; border: 1px solid rgba(245,158,11,0.3);',
    toolbox:       'background: rgba(139,92,246,0.18); color: #c4b5fd; border: 1px solid rgba(139,92,246,0.3);',
    policy_change: 'background: rgba(99,102,241,0.18); color: #c7d2fe; border: 1px solid rgba(99,102,241,0.3);',
  };
%>
<style>
  .ud-wrap { color: #fff; padding: 0 0 24px; }
  .ud-back { display: inline-flex; align-items: center; gap: 6px; color: rgba(255,255,255,0.55); font-size: 0.8rem; text-decoration: none; margin: 4px 0 8px; }
  .ud-title { font-size: 1.5rem; font-weight: 800; line-height: 1.2; margin: 4px 0 10px; }
  .ud-meta { display: flex; gap: 10px; flex-wrap: wrap; font-size: 0.72rem; color: rgba(255,255,255,0.55); margin-bottom: 16px; align-items: center; }
  .ud-chip { font-size: 0.65rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; }
  .ud-body {
    background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;
    padding: 14px 16px; font-size: 0.92rem; line-height: 1.55; white-space: pre-line;
    color: rgba(255,255,255,0.85);
  }
  .ud-attach {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px;
    background: rgba(43,127,255,0.15); border: 1px solid rgba(43,127,255,0.3);
    border-radius: 10px; color: #93C5FD; font-weight: 600; font-size: 0.85rem;
    text-decoration: none; margin-top: 12px;
  }
  .ud-pdf-pages { margin-top: 14px; }
  .ud-pdf-pages img { display: block; width: 100%; height: auto; margin: 0 auto 8px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.06); background: #fff; }
  .ud-preparing { margin-top: 14px; color: rgba(255,255,255,0.7); text-align: center; padding: 28px 14px; background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.1); border-radius: 12px; font-size: 0.85rem; }
  .ud-prep-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #2B7FFF; margin: 0 2px; animation: ud-pulse 1.2s infinite ease-in-out; }
  .ud-prep-dot:nth-child(2) { animation-delay: 0.15s; }
  .ud-prep-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes ud-pulse { 0%,100% { opacity: 0.35; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1); } }
</style>

<div class="ud-wrap">
  <a href="/w/safety/updates" class="ud-back">← Safety / Updates</a>
  <div class="ud-title"><%= update.title %></div>
  <div class="ud-meta">
    <span class="ud-chip" style="<%= CHIP_STYLE[update.category] || CHIP_STYLE.general %>"><%= categoryLabels[update.category] %></span>
    <span><%= fmt(update.published_at) %></span>
    <% if (update.published_by_name) { %><span>· <%= update.published_by_name %></span><% } %>
  </div>

  <div class="ud-body"><%= update.body %></div>

  <% if (update.attachment_path && renderablePdf && pageCount > 0) { %>
    <div class="ud-pdf-pages">
      <% for (let n = 1; n <= pageCount; n++) { %>
        <img src="/w/safety/updates/<%= update.id %>/pages/<%= n %>.png?v=<%= encodeURIComponent(cacheKey) %>" loading="<%= n === 1 ? 'eager' : 'lazy' %>" decoding="async" alt="Page <%= n %>">
      <% } %>
    </div>
  <% } else if (update.attachment_path && renderablePdf) { %>
    <div class="ud-preparing" id="ud-prep" data-poll-url="/w/safety/updates/<%= update.id %>/pages">
      Preparing attachment<span class="ud-prep-dot"></span><span class="ud-prep-dot"></span><span class="ud-prep-dot"></span>
    </div>
  <% } else if (update.attachment_path) { %>
    <a href="/w/safety/updates/<%= update.id %>/file" class="ud-attach">
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m-7 7h8a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v13a2 2 0 002 2z"/></svg>
      <%= update.attachment_original_name %>
    </a>
  <% } %>
</div>

<% if (renderablePdf && pageCount === 0) { %>
<script>
(function () {
  var el = document.getElementById('ud-prep');
  if (!el) return;
  var url = el.getAttribute('data-poll-url');
  var tries = 0;
  function tick() {
    tries++;
    fetch(url, { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.ready && d.count > 0) { location.reload(); return; }
        if (tries > 60) return;
        setTimeout(tick, 1500);
      })
      .catch(function () { if (tries < 60) setTimeout(tick, 2500); });
  }
  setTimeout(tick, 1200);
})();
</script>
<% } %>

<script>
  // Fire-and-forget mark-as-read on page open. Idempotent on the server.
  (function () {
    var csrf = document.querySelector('meta[name="csrf-token"]');
    fetch('/w/safety/updates/<%= update.id %>/read', {
      method: 'POST',
      credentials: 'same-origin',
      headers: Object.assign(
        { 'Accept': 'application/json' },
        csrf ? { 'X-CSRF-Token': csrf.getAttribute('content') } : {}
      ),
    }).catch(function () { /* ignore */ });
  })();
</script>
