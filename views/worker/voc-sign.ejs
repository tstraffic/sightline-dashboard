<%
  function fmtDate(d) {
    if (!d) return '';
    return new Date(d).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney', day: 'numeric', month: 'short', year: 'numeric' });
  }
%>
<div class="space-y-4">
  <a href="/w/hr/certs" class="inline-flex items-center text-sm text-brand-600 font-medium">
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to My Wallet
  </a>

  <h1 class="text-xl font-bold text-gray-900">Sign your VOC</h1>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
    <p class="text-xs uppercase tracking-widest text-gray-400 font-bold mb-1">Equipment</p>
    <p class="text-base font-semibold text-gray-900"><%= a.equipment_name %></p>
    <div class="grid grid-cols-2 gap-2 mt-3 text-xs text-gray-600">
      <div>
        <p class="uppercase tracking-wider text-gray-400 font-bold text-[10px]">Assessed</p>
        <p class="text-gray-800"><%= fmtDate(a.assessment_date) %></p>
      </div>
      <div>
        <p class="uppercase tracking-wider text-gray-400 font-bold text-[10px]">Valid until</p>
        <p class="text-gray-800"><%= fmtDate(a.valid_until) %></p>
      </div>
    </div>
    <% if (a.voc_number) { %>
      <p class="mt-3 text-[10px] font-mono text-gray-400"><%= a.voc_number %><% if (a.certificate_id) { %> · <%= a.certificate_id %><% } %></p>
    <% } %>
  </div>

  <% if (alreadySigned) { %>
    <!-- Worker already acknowledged — show confirmation, not the pad -->
    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4">
      <div class="flex items-start gap-2">
        <svg class="w-5 h-5 text-emerald-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <div>
          <p class="text-sm font-semibold text-emerald-900">Signed and acknowledged</p>
          <% if (a.worker_acknowledged_at) { %>
            <p class="text-xs text-emerald-700 mt-0.5">on <%= fmtDate(a.worker_acknowledged_at) %></p>
          <% } %>
        </div>
      </div>
      <a href="/w/hr/vocs/<%= a.id %>/pdf" target="_blank"
        class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-md">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
        Download cert PDF
      </a>
    </div>
  <% } else { %>
    <!-- Signature pad — the worker draws here to acknowledge -->
    <form method="POST" action="/w/hr/vocs/<%= a.id %>/sign" id="workerSignForm" class="bg-white border border-gray-200 rounded-xl shadow-sm p-4">
      <%- include('../partials/csrf') %>
      <p class="text-xs text-gray-700 leading-relaxed mb-3">
        By signing below I acknowledge that I have been assessed competent in <span class="font-semibold"><%= a.equipment_name %></span> and that I will operate this equipment only in line with the T&amp;S SOP, the relevant SWMS, and applicable NSW WHS / road regulations.
      </p>

      <label class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Your signature</label>
      <div class="mt-1 border-2 border-dashed border-gray-300 rounded-lg overflow-hidden bg-white">
        <canvas id="workerSigCanvas" class="block w-full touch-none cursor-crosshair" style="height:180px;"></canvas>
      </div>
      <div class="flex items-center justify-between gap-2 mt-1 text-[11px] text-gray-500">
        <span id="workerSigHint">Draw with your finger or stylus</span>
        <button type="button" id="workerSigClear" class="px-2 py-0.5 bg-white hover:bg-gray-100 border border-gray-300 rounded text-[10px] font-semibold text-gray-700">Clear</button>
      </div>
      <input type="hidden" name="signature_data" id="workerSigData" value="">

      <button type="submit" id="workerSigSubmit"
        class="mt-4 w-full px-4 py-3 bg-brand-600 hover:bg-brand-500 text-white text-sm font-bold rounded-lg disabled:opacity-40 disabled:cursor-not-allowed">
        Sign &amp; acknowledge
      </button>
      <p class="mt-2 text-center text-[11px] text-gray-400">The cert PDF in your wallet will update automatically once you sign.</p>
    </form>
  <% } %>
</div>

<% if (!alreadySigned) { %>
<script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
<script>
(function () {
  if (typeof SignaturePad === 'undefined') return;
  var canvas = document.getElementById('workerSigCanvas');
  var hidden = document.getElementById('workerSigData');
  var hint = document.getElementById('workerSigHint');
  var clearBtn = document.getElementById('workerSigClear');
  var submitBtn = document.getElementById('workerSigSubmit');
  var form = document.getElementById('workerSignForm');
  if (!canvas || !hidden || !form) return;

  function sizeCanvas() {
    var ratio = Math.max(window.devicePixelRatio || 1, 1);
    var w = (canvas.offsetWidth  || 0) * ratio;
    var h = (canvas.offsetHeight || 0) * ratio;
    if (w === canvas.width && h === canvas.height) return;
    canvas.width = w; canvas.height = h;
    canvas.getContext('2d').scale(ratio, ratio);
  }
  sizeCanvas();
  window.addEventListener('resize', sizeCanvas);
  if (typeof ResizeObserver !== 'undefined') new ResizeObserver(sizeCanvas).observe(canvas);

  var pad = new SignaturePad(canvas, {
    backgroundColor: 'rgba(255,255,255,0)',
    penColor: '#1f3864',
    minWidth: 1.0, maxWidth: 3.0,
  });

  // Submit-button stays disabled until there's at least one stroke —
  // prevents accidental empty submissions and reinforces "you must
  // sign to acknowledge".
  submitBtn.disabled = true;
  pad.addEventListener('beginStroke', function () {
    if (hint) hint.style.visibility = 'hidden';
    submitBtn.disabled = false;
  });
  clearBtn.addEventListener('click', function () {
    pad.clear();
    if (hint) hint.style.visibility = '';
    submitBtn.disabled = true;
  });
  form.addEventListener('submit', function (e) {
    if (pad.isEmpty()) { e.preventDefault(); return; }
    hidden.value = pad.toDataURL('image/png');
  });
})();
</script>
<% } %>
