<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= workshop.title %> — T&S</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Geist:wght@300..700&family=Geist+Mono:wght@400..500&display=swap" rel="stylesheet">
<style>
  /* Light-mode reskin matching the worker portal palette
     (brand-600 = #10B981 emerald, Geist body, Bricolage display).
     Keeps every existing class name so the JS render functions don't
     need to change — only the visual tokens are different.
     Accent variables retain their old names (--orange, --brand) so
     downstream rules keep resolving; the values are now brand-green
     so the participant page reads as Atomis-family. */
  :root{
    --bg:#F7F8FA; --panel:#FFFFFF; --panel2:#F9FAFB; --panel3:#F3F4F6;
    --line:#E5E7EB; --text:#0F1115; --dim:#6B7280; --dimmer:#9CA3AF;
    --brand:#10B981; --orange:#10B981; --yellow:#F59E0B;
    --extreme:#DC2626; --high:#F97316; --medium:#EAB308; --low:#16A34A;
    --ok:#10B981; --no:#DC2626;
    --rad:14px;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:var(--bg);color:var(--text);
    font-family:'Geist','Inter',system-ui,sans-serif;
    font-size:16px;line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:560px;margin:0 auto;min-height:100dvh;display:flex;flex-direction:column}
  header{
    display:flex;align-items:center;gap:10px;
    padding:12px 16px;border-bottom:1px solid var(--line);
    position:sticky;top:0;background:rgba(247,248,250,.94);backdrop-filter:blur(8px);z-index:10;
    min-height:54px;
  }
  .ts-mark{height:30px;display:block}
  .logo-sub{font-family:'Geist Mono',ui-monospace,monospace;font-weight:500;
    font-size:11px;letter-spacing:1.4px;color:var(--dim);text-transform:uppercase;white-space:nowrap}
  .htitle{margin-left:auto;font-family:'Geist Mono',ui-monospace,monospace;font-weight:500;
    font-size:11px;letter-spacing:1.4px;color:var(--dim);text-transform:uppercase}
  main{flex:1;padding:22px 18px 36px;display:flex;flex-direction:column}
  h1{font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:30px;
     line-height:1.05;letter-spacing:-0.015em;color:var(--text)}
  h2{font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:22px;
     line-height:1.1;letter-spacing:-0.01em;color:var(--text)}
  .kicker{font-family:'Geist Mono',ui-monospace,monospace;font-weight:500;font-size:11px;
     letter-spacing:2px;text-transform:uppercase;color:var(--brand)}
  .lead{color:var(--dim);margin-top:8px}
  .mono{font-variant-numeric:tabular-nums;font-family:'Geist Mono',ui-monospace,monospace}
  input[type=text]{
    width:100%;background:var(--panel);border:1px solid var(--line);color:var(--text);
    font-family:'Geist',sans-serif;font-size:16px;padding:13px 14px;border-radius:10px;outline:none;
    transition:border-color .12s, box-shadow .12s;
  }
  input[type=text]:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(16,185,129,0.15)}
  .btn{
    display:flex;align-items:center;justify-content:center;gap:8px;width:100%;
    background:var(--brand);color:#FFFFFF;border:none;cursor:pointer;
    font-family:'Geist',sans-serif;font-weight:600;font-size:15px;
    letter-spacing:0;padding:13px 16px;border-radius:10px;
    transition:transform .06s ease, background .15s ease, filter .15s ease;
  }
  .btn:hover{filter:brightness(1.05)}
  .btn:active{transform:translateY(1px)}
  .btn:disabled{background:#E5E7EB;color:#9CA3AF;cursor:not-allowed}
  .btn.ghost{background:transparent;color:var(--dim);border:1px solid var(--line);font-weight:500}
  .btn.ghost:hover{background:var(--panel2);color:var(--text)}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--rad);padding:16px;
    box-shadow:0 1px 2px rgba(15,17,21,0.04)}
  .stack{display:flex;flex-direction:column;gap:12px}
  .spacer{flex:1}
  .fadein{animation:fade .35s ease both}
  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .prog{display:flex;gap:6px;margin-bottom:14px}
  .prog .dot{flex:1;height:5px;border-radius:3px;background:var(--panel3)}
  .prog .dot.done{background:var(--ok)}
  .prog .dot.done.bad{background:var(--no)}
  .prog .dot.done.part{background:var(--medium)}
  .prog .dot.now{background:var(--brand)}
  .opt{
    display:flex;align-items:center;gap:12px;width:100%;text-align:left;cursor:pointer;
    background:var(--panel);border:1.5px solid var(--line);border-radius:11px;
    padding:13px 14px;color:var(--text);font-size:15px;font-family:'Geist',sans-serif;
    transition:border-color .12s,background .12s;
  }
  .opt:hover{background:var(--panel2)}
  .opt:active{background:var(--panel3)}
  .opt .mk{
    width:24px;height:24px;border-radius:6px;border:2px solid var(--line);flex:none;
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:transparent;
  }
  .opt.multi .mk{border-radius:6px}
  .opt.single .mk{border-radius:50%}
  .opt.sel{border-color:var(--brand);background:#ECFDF5}
  .opt.sel .mk{background:var(--brand);border-color:var(--brand);color:#FFFFFF}
  .opt.lock{cursor:default;pointer-events:none}
  .opt.right{border-color:var(--ok);background:#ECFDF5}
  .opt.right .mk{background:var(--ok);border-color:var(--ok);color:#FFFFFF}
  .opt.wrong{border-color:var(--no);background:#FEF2F2}
  .opt.wrong .mk{background:var(--no);border-color:var(--no);color:#FFFFFF}
  .opt.missed{border-color:var(--ok);border-style:dashed;background:transparent}
  .opt .tag{margin-left:auto;font-family:'Geist Mono',ui-monospace,monospace;font-weight:600;
    font-size:10.5px;letter-spacing:1px;text-transform:uppercase;flex:none}
  .tag.t-ok{color:var(--ok)} .tag.t-no{color:var(--no)} .tag.t-miss{color:var(--dim)}
  .matrix-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  table.mx{border-collapse:separate;border-spacing:4px;width:100%;min-width:330px}
  table.mx th,table.mx td{padding:0}
  .mx .corner{background:transparent}
  .mx .lk,.mx .im{
    font-family:'Geist Mono',ui-monospace,monospace;font-weight:600;color:var(--dim);
    font-size:10.5px;letter-spacing:.4px;text-transform:uppercase;text-align:center;line-height:1.1;
  }
  .mx .im{text-align:right;padding-right:6px !important;white-space:nowrap}
  .mx .cell{
    width:100%;min-width:50px;height:50px;border-radius:8px;cursor:pointer;border:2px solid transparent;
    font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:15px;color:#FFFFFF;
    display:flex;align-items:center;justify-content:center;transition:transform .06s;
  }
  .cell:active{transform:scale(.94)}
  .cell.x-extreme{background:var(--extreme);color:#FFFFFF}
  .cell.x-high{background:var(--high);color:#FFFFFF}
  .cell.x-medium{background:var(--medium);color:#3F2D00}
  .cell.x-low{background:var(--low);color:#FFFFFF}
  .cell.sel{border-color:#FFFFFF;box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--brand)}
  .cell.lock{pointer-events:none}
  .cell.is-right{border-color:#FFFFFF;box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--ok)}
  .cell.is-wrong{border-color:#FFFFFF;box-shadow:0 0 0 2px var(--bg),0 0 0 4px var(--no);opacity:.92}
  .legend{display:flex;flex-wrap:wrap;gap:10px 14px;margin-top:12px}
  .legend span{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--dim);
    font-weight:500;letter-spacing:.2px}
  .legend i{width:13px;height:13px;border-radius:3px;display:inline-block}
  .fb{border-radius:var(--rad);padding:14px 15px;border:1px solid;animation:fade .3s ease both}
  .fb.good{background:#ECFDF5;border-color:#A7F3D0}
  .fb.bad{background:#FEF2F2;border-color:#FECACA}
  .fb.part{background:#FFFBEB;border-color:#FDE68A}
  .fb .verdict{font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:18px;
    letter-spacing:-0.01em;display:flex;align-items:center;gap:8px}
  .fb.good .verdict{color:#047857} .fb.bad .verdict{color:#B91C1C}
  .fb.part .verdict{color:#B45309}
  .clause{
    margin-top:10px;background:#F9FAFB;border-left:3px solid var(--brand);
    border-radius:6px;padding:10px 12px;font-size:14.5px;color:var(--text);
  }
  .clause .src{font-family:'Geist Mono',ui-monospace,monospace;font-weight:500;font-size:11px;
    letter-spacing:1.2px;text-transform:uppercase;color:var(--brand);display:block;margin-bottom:3px}
  .score-ring{
    width:150px;height:150px;border-radius:50%;margin:6px auto 4px;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    background:conic-gradient(var(--ringclr) calc(var(--pct)*1%), var(--panel3) 0);
  }
  .score-ring .inner{
    width:120px;height:120px;border-radius:50%;background:var(--panel);
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    box-shadow:inset 0 1px 2px rgba(0,0,0,0.04);
  }
  .score-ring .num{font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:46px;line-height:1;color:var(--text)}
  .score-ring .den{color:var(--dim);font-size:12.5px;letter-spacing:.8px;font-weight:500}
  .brk-row{display:flex;align-items:center;gap:10px;padding:11px 13px;
    background:var(--panel);border:1px solid var(--line);border-radius:11px}
  .brk-row .n{font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:14px;
    width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex:none;color:#FFFFFF}
  .brk-row .lbl{font-family:'Geist',sans-serif;font-weight:500;color:var(--text)}
  .brk-row .pts{margin-left:auto;font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:16px;color:var(--text)}
  .lb-row{display:flex;align-items:center;gap:12px;padding:13px 14px;
    background:var(--panel);border:1px solid var(--line);border-radius:12px}
  .lb-row.me{border-color:var(--brand);background:#ECFDF5}
  .lb-rank{font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:18px;
    width:34px;text-align:center;flex:none;color:var(--dim)}
  .lb-rank.medal{font-size:20px}
  .lb-name{font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:17px;
    line-height:1.1;color:var(--text)}
  .lb-meta{font-size:11.5px;color:var(--dimmer);letter-spacing:.3px;text-transform:uppercase;font-weight:500;font-family:'Geist Mono',ui-monospace,monospace}
  .lb-score{margin-left:auto;font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:22px;color:var(--text)}
  .note{font-size:12.5px;color:var(--dimmer);text-align:center;line-height:1.45}
  .closing{font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:19px;
    line-height:1.2;text-align:center;color:var(--text);letter-spacing:-0.01em}
  .closing b{color:var(--brand);font-weight:700}
  .divider{height:1px;background:var(--line);margin:4px 0}
  .pill{display:inline-flex;align-items:center;gap:6px;background:var(--panel2);
    border:1px solid var(--line);border-radius:999px;padding:5px 11px;font-size:12px;
    font-family:'Geist',sans-serif;font-weight:500;letter-spacing:.2px;color:var(--dim)}
  .pill-adv{background:#FFFBEB;border:1px solid #FDE68A;color:#B45309;align-self:flex-start;font-weight:600}
  .casebar{background:var(--panel2);border:1px solid var(--line);border-radius:11px;overflow:hidden;margin-bottom:2px}
  .casebar-head{display:flex;align-items:center;gap:10px;width:100%;cursor:pointer;
    background:transparent;border:none;color:var(--text);padding:11px 13px;text-align:left;font-family:inherit}
  .casebar-head:hover{background:var(--panel3)}
  .casebar-head .cb-tag{font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:12px;
    background:var(--brand);color:#FFFFFF;border-radius:5px;padding:3px 7px;flex:none}
  .casebar-head .cb-lbl{font-family:'Geist Mono',ui-monospace,monospace;font-weight:500;
    font-size:11.5px;letter-spacing:.4px;color:var(--dim);text-transform:uppercase}
  .casebar-head .cb-chev{margin-left:auto;color:var(--dim);font-size:13px;transition:transform .15s}
  .casebar.open .cb-chev{transform:rotate(180deg)}
  .casebar-body{padding:0 13px 13px;font-size:14.5px;line-height:1.55;color:var(--text)}
  .spin{width:38px;height:38px;border-radius:50%;border:3px solid var(--panel3);
    border-top-color:var(--brand);animation:rot .8s linear infinite;margin:8px auto}
  @keyframes rot{to{transform:rotate(360deg)}}
  .err{color:var(--no);font-size:13px;margin-top:4px}
  .sess-code{font-family:'Geist Mono',ui-monospace,monospace;font-weight:500;letter-spacing:1.5px;color:var(--text)}

  /* ── Atomis splash → T&S header transition ──
     A full-screen splash sits over the page on first load with the
     Atomis mark centred. After ~1.4s the mark scales down + slides up
     to where the T&S logo will live in the sticky header, and the
     splash backdrop fades out. The real T&S logo fades in underneath
     during the same window so the handover reads as one continuous
     move. The splash element is removed once the animation ends so it
     doesn't trap touch events. Honours prefers-reduced-motion. */
  .splash{
    position:fixed;inset:0;z-index:100;background:#FFFFFF;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
    transition:opacity .55s ease .9s, visibility 0s linear 1.45s;
  }
  .splash-mark{
    width:96px;height:96px;display:block;
    transform-origin:center center;
    animation:splashIn .55s cubic-bezier(0.22,1,0.36,1) both;
    transition:transform .9s cubic-bezier(0.65,0,0.35,1) .55s;
  }
  .splash-word{
    font-family:'Bricolage Grotesque','Geist',sans-serif;font-weight:700;font-size:22px;
    letter-spacing:-0.01em;color:var(--text);
    animation:splashIn .55s cubic-bezier(0.22,1,0.36,1) .1s both;
    transition:opacity .35s ease .55s;
  }
  @keyframes splashIn{
    from{opacity:0;transform:scale(.78)}
    to  {opacity:1;transform:scale(1)}
  }
  body.splash-leaving .splash{opacity:0;visibility:hidden}
  body.splash-leaving .splash-word{opacity:0}
  body.splash-leaving .splash-mark{transform:scale(.32) translateY(-44vh)}
  /* T&S logo starts hidden — fades in as the splash leaves. */
  .ts-mark{opacity:0;transition:opacity .45s ease .7s}
  body.splash-leaving .ts-mark{opacity:1}
  @media (prefers-reduced-motion: reduce){
    .splash-mark, .splash-word, .ts-mark{animation:none;transition:opacity .2s ease}
    body.splash-leaving .splash-mark{transform:none}
  }
</style>
</head>
<body>
<div class="splash" id="splash" aria-hidden="true">
  <img class="splash-mark" src="/images/atomis-mark-light-bg.svg" alt="Atomis">
  <span class="splash-word">Atomis</span>
</div>
<div class="wrap">
  <header>
    <img class="ts-mark" src="/images/logo-colour.png" alt="T&amp;S Traffic Control">
    <span class="htitle">Session <span class="sess-code"><%= session.code %></span></span>
  </header>
  <main id="app"></main>
</div>
<script>
  // Kick the splash → header transition after a beat so the Atomis
  // logo gets a moment to read as the splash. The CSS handles the
  // movement; we just toggle the class. Removed entirely once the
  // transition completes so the splash overlay doesn't intercept
  // touch / clicks on subsequent screens.
  (function () {
    var splash = document.getElementById('splash');
    if (!splash) return;
    setTimeout(function () { document.body.classList.add('splash-leaving'); }, 900);
    setTimeout(function () { if (splash && splash.parentNode) splash.parentNode.removeChild(splash); }, 2200);
  })();
</script>

<%# Inject content + session data for the script below. Escape `<` to %>
<%# guard against any in-question text containing a `</script>` sequence. %>
<script id="ws-data" type="application/json"><%- JSON.stringify({
  sessionCode: session.code,
  sessionMode: session.mode || 'individual',
  groups: typeof groups !== 'undefined' ? groups : [],
  workshopTitle: workshop.title,
  CASES: workshop.cases,
  IMPACTS: workshop.IMPACTS,
  LIKE: workshop.LIKE,
  BANDS: workshop.BANDS,
  CLAUSE_DETAIL: workshop.CLAUSE_DETAIL
}).replace(/</g, '\\u003c') %></script>

<script>
"use strict";

// =====================================================================
// SWMS Workshop participant view — dashboard-integrated port of the
// standalone artifact. UI behaviour matches the artifact verbatim; the
// only changes are:
//   - cases/matrix/clause data injected from the server (no hardcoded
//     copy in this file)
//   - case assignment + score submission + leaderboard via fetch to
//     /wq/:code/* instead of window.storage
//   - facilitator screens (gate, setup, QR, status) removed — the
//     facilitator runs everything from the admin dashboard now
// =====================================================================

var WS = JSON.parse(document.getElementById("ws-data").textContent);
var SID = Math.random().toString(36).slice(2, 10);

var CASES = WS.CASES;
var IMPACTS = WS.IMPACTS;
var LIKE = WS.LIKE;
var BANDS = WS.BANDS;
var CLAUSE_DETAIL = WS.CLAUSE_DETAIL;
var SESSION_CODE = WS.sessionCode;
var SESSION_MODE = WS.sessionMode || 'individual';
var GROUPS = Array.isArray(WS.groups) ? WS.groups : [];

var S = {
  screen: "start",
  name: "",
  caseId: null,
  qi: 0,
  order: [],
  results: [],
  picked: null,
  answered: false,
  briefOpen: false,
  startErr: ""
};

var app = document.getElementById("app");

// ---- helpers ----
function el(tag, cls, html) {
  var e = document.createElement(tag);
  if (cls) e.className = cls;
  if (html != null) e.innerHTML = html;
  return e;
}
function shuffle(n) {
  var a = []; for (var i = 0; i < n; i++) a.push(i);
  for (var j = a.length - 1; j > 0; j--) {
    var k = Math.floor(Math.random() * (j + 1));
    var t = a[j]; a[j] = a[k]; a[k] = t;
  }
  return a;
}
function curCase() {
  for (var i = 0; i < CASES.length; i++) if (CASES[i].id === S.caseId) return CASES[i];
  return null;
}
function bandClass(b) { return "x-" + b; }
function cellCoords(code) {
  return {
    imp: parseInt(code.charAt(0), 10),
    lk: { E: 1, D: 2, C: 3, B: 4, A: 5 }[code.charAt(1)]
  };
}
function matrixMinDist(acc, pk) {
  if (!pk) return 99; var p = cellCoords(pk), best = 99;
  for (var i = 0; i < acc.length; i++) {
    var x = cellCoords(acc[i]);
    var d = Math.abs(x.imp - p.imp) + Math.abs(x.lk - p.lk);
    if (d < best) best = d;
  }
  return best;
}
function cellBand(code) {
  var c = cellCoords(code); return BANDS[c.imp][c.lk - 1];
}
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, function (m) {
    return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[m];
  });
}

// ---- server calls ----
function apiClaim(name) {
  return fetch("/wq/" + encodeURIComponent(SESSION_CODE) + "/start", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ name: name })
  }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); });
}
function apiSubmit(payload) {
  return fetch("/wq/" + encodeURIComponent(SESSION_CODE) + "/submit", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); });
}
function apiLeaderboard() {
  return fetch("/wq/" + encodeURIComponent(SESSION_CODE) + "/leaderboard")
    .then(function (r) { return r.json(); });
}
function apiJoinGroup(groupName, claimerName) {
  return fetch("/wq/" + encodeURIComponent(SESSION_CODE) + "/join-group", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ group_name: groupName, claimer_name: claimerName || "" })
  }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); });
}

// =====================================================================
// SCREENS
// =====================================================================

function render() {
  app.innerHTML = "";
  if (S.screen === "start")    { screenStart();    persistState(); return; }
  if (S.screen === "claiming") { screenClaiming(); persistState(); return; }
  if (S.screen === "brief")    { screenBrief();    persistState(); return; }
  if (S.screen === "quiz")     { screenQuiz();     persistState(); return; }
  if (S.screen === "score")    { screenScore();    persistState(); return; }
  if (S.screen === "board")    { clearState();     screenBoard();  return; }
}

// ---- State persistence across page refreshes ----
// Reason: if a worker accidentally refreshes mid-quiz (e.g. just before
// submitting to the leaderboard), they lose all their answers and the
// sticky case assignment means they can't re-enter their score under
// the same name. Snapshotting S to localStorage on every render lets
// the page resume exactly where they left off after a reload.
//
// Scoped per session_code + lowercase name so two workers sharing a
// device don't clobber each other. Cleared on successful submit
// (S.screen === "board") so the next worker on the same device gets a
// clean start screen.
var STATE_KEY_PREFIX = "wq:state:" + SESSION_CODE + ":";
function stateKeyFor(name) {
  return STATE_KEY_PREFIX + String(name || "").trim().toLowerCase();
}
function persistState() {
  try {
    if (!S.name || S.screen === "start" || S.screen === "claiming") return;
    var payload = {
      v: 1,
      name: S.name, caseId: S.caseId, screen: S.screen,
      qi: S.qi, order: S.order, results: S.results,
      picked: S.picked, answered: S.answered, briefOpen: S.briefOpen,
      savedAt: Date.now(),
    };
    localStorage.setItem(stateKeyFor(S.name), JSON.stringify(payload));
  } catch (e) {}
}
function clearState() {
  try {
    if (S.name) localStorage.removeItem(stateKeyFor(S.name));
  } catch (e) {}
}
function tryResume() {
  try {
    // Find ANY in-flight state for this session — there's usually only
    // one (single worker per device), but if multiple keys exist we
    // pick the most recently saved. Skip rows that already submitted
    // (screen === "board").
    var bestKey = null, bestPayload = null;
    for (var i = 0; i < localStorage.length; i++) {
      var k = localStorage.key(i);
      if (!k || k.indexOf(STATE_KEY_PREFIX) !== 0) continue;
      try {
        var p = JSON.parse(localStorage.getItem(k));
        if (!p || p.screen === "board" || !p.caseId) continue;
        // 12-hour TTL — stale games (left running for days) shouldn't
        // hijack a fresh visit.
        if (!p.savedAt || (Date.now() - p.savedAt) > 12 * 60 * 60 * 1000) {
          localStorage.removeItem(k); continue;
        }
        if (!bestPayload || p.savedAt > bestPayload.savedAt) { bestKey = k; bestPayload = p; }
      } catch (e) {}
    }
    if (!bestPayload) return false;
    S.name = bestPayload.name || "";
    S.caseId = bestPayload.caseId;
    S.screen = bestPayload.screen;
    S.qi = bestPayload.qi || 0;
    S.order = bestPayload.order || [];
    S.results = bestPayload.results || [];
    S.picked = bestPayload.picked;
    S.answered = !!bestPayload.answered;
    S.briefOpen = !!bestPayload.briefOpen;
    return true;
  } catch (e) { return false; }
}

function screenStart() {
  if (SESSION_MODE === "group") return screenStartGroup();
  var c = el("div", "stack fadein");
  c.appendChild(el("div", "kicker", "Office Crew Exercise"));
  c.appendChild(el("h1", "", escapeHtml(WS.workshopTitle).replace(" ", "<br>")));
  c.appendChild(el("p", "lead", "You'll be given one real traffic incident at random. Eight questions — six core, two advanced. Use your printed SWMS 01 v3.0; the answer is in the document."));
  var p = el("div", "panel stack");
  p.appendChild(el("label", "kicker", "Your name"));
  var inp = el("input"); inp.type = "text"; inp.placeholder = "Type your name"; inp.value = S.name;
  inp.autocomplete = "off";
  inp.addEventListener("input", function () { S.name = inp.value; go.disabled = inp.value.trim().length < 2; });
  p.appendChild(inp);
  if (S.startErr) p.appendChild(el("p", "err", escapeHtml(S.startErr)));
  c.appendChild(p);
  c.appendChild(el("div", "spacer"));
  var go = el("button", "btn", "Get my case →");
  go.disabled = S.name.trim().length < 2;
  go.addEventListener("click", function () {
    S.name = S.name.trim();
    S.startErr = "";
    S.screen = "claiming"; render();
    apiClaim(S.name).then(function (r) {
      if (!r.ok) {
        S.startErr = r.body && r.body.error === "session_closed"
          ? "This session has been closed by the facilitator."
          : "Couldn't start — please try again.";
        S.screen = "start"; render();
        return;
      }
      startCase(r.body.caseId);
    }).catch(function () {
      S.startErr = "Network error — check your signal and try again.";
      S.screen = "start"; render();
    });
  });
  c.appendChild(go);
  c.appendChild(el("p", "note", "Workshop tool · T&S Traffic Control · Session " + SESSION_CODE));
  app.appendChild(c);
}

// Group mode: pick your team from a list of pre-made groups. Each card
// shows the team's case + roster so the player can recognise their team
// even if they joined the room late. Tapping a card claims it (the team
// the player is in) and rolls straight into the brief screen with the
// case the facilitator pre-assigned at session-create time.
//
// The "Your name" field above the cards is optional — if filled, the
// facilitator dashboard shows "Picked by <name>" against the team so
// the office knows who's running each device. Without it the team
// still claims, just labelled generically.
function screenStartGroup() {
  var c = el("div", "stack fadein");
  c.appendChild(el("div", "kicker", "Office Crew Exercise · Teams"));
  c.appendChild(el("h1", "", escapeHtml(WS.workshopTitle).replace(" ", "<br>")));
  c.appendChild(el("p", "lead", "Type your name, then tap your team — your name should be in the roster."));

  if (S.startErr) c.appendChild(el("p", "err", escapeHtml(S.startErr)));

  if (!GROUPS.length) {
    c.appendChild(el("p", "lead", "No teams have been set up for this session yet. Ask the facilitator."));
    app.appendChild(c);
    return;
  }

  var namePanel = el("div", "panel stack");
  namePanel.appendChild(el("label", "kicker", "Your name"));
  var nameInp = el("input");
  nameInp.type = "text"; nameInp.placeholder = "Type your name"; nameInp.value = S.name || "";
  nameInp.autocomplete = "off";
  nameInp.addEventListener("input", function () { S.name = nameInp.value; });
  namePanel.appendChild(nameInp);
  c.appendChild(namePanel);

  var list = el("div", "stack");
  GROUPS.forEach(function (g) {
    var card = el("button");
    card.type = "button";
    card.style.cssText = [
      "background:var(--panel)",
      "border:1.5px solid var(--line)",
      "border-radius:12px",
      "padding:14px",
      "text-align:left",
      "cursor:pointer",
      "color:var(--text)",
      "font-family:inherit",
      "transition:border-color .12s, background .12s"
    ].join(";");
    card.addEventListener("mousedown", function () { card.style.background = "var(--panel2)"; });
    card.addEventListener("mouseup",   function () { card.style.background = "var(--panel)"; });

    var head = el("div");
    head.style.cssText = "display:flex;align-items:center;gap:10px;margin-bottom:8px";
    var caseBadge = el("span", "", g.case_letter);
    caseBadge.style.cssText = "width:28px;height:28px;border-radius:6px;background:var(--orange);color:#15110c;font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:14px;display:inline-flex;align-items:center;justify-content:center";
    var name = el("span", "", escapeHtml(g.name));
    name.style.cssText = "font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:20px;text-transform:uppercase;letter-spacing:.4px";
    head.appendChild(caseBadge);
    head.appendChild(name);
    if (g.claimed) {
      var tag = el("span", "", "Claimed");
      tag.style.cssText = "margin-left:auto;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--ok)";
      head.appendChild(tag);
    }
    card.appendChild(head);

    var roster = el("div");
    roster.style.cssText = "color:var(--dim);font-size:14px;line-height:1.55";
    roster.innerHTML = (g.members || []).map(function (m) {
      return escapeHtml(m);
    }).join(" · ");
    card.appendChild(roster);

    card.addEventListener("click", function () {
      var claimer = (S.name || "").trim();
      // S.name doubles as the leaderboard key, so we set it to the group
      // name once tapped (every team submits as its own row). The typed
      // claimer name is forwarded separately so the dashboard can show
      // "Picked by <person>" beside the team without polluting the
      // leaderboard rows.
      S.name = g.name;
      S.startErr = "";
      S.screen = "claiming"; render();
      apiJoinGroup(g.name, claimer).then(function (r) {
        if (!r.ok) {
          S.startErr = r.body && r.body.error === "session_closed"
            ? "This session has been closed by the facilitator."
            : "Couldn't join — please try again.";
          S.screen = "start"; render();
          return;
        }
        startCase(r.body.caseId);
      }).catch(function () {
        S.startErr = "Network error — check your signal and try again.";
        S.screen = "start"; render();
      });
    });
    list.appendChild(card);
  });
  c.appendChild(list);
  c.appendChild(el("p", "note", "Workshop tool · T&S Traffic Control · Session " + SESSION_CODE));
  app.appendChild(c);
}

function screenClaiming() {
  var c = el("div", "stack fadein");
  c.style.minHeight = "60vh";
  c.style.justifyContent = "center";
  c.style.alignItems = "center";
  c.appendChild(el("div", "spin"));
  c.appendChild(el("div", "kicker", "Assigning your case…"));
  c.appendChild(el("p", "note", "Picking a real incident for you to work through."));
  app.appendChild(c);
}

function startCase(caseId) {
  var cs = null;
  for (var i = 0; i < CASES.length; i++) if (CASES[i].id === caseId) cs = CASES[i];
  if (!cs) cs = CASES[0];
  S.caseId = cs.id; S.qi = 0; S.results = []; S.picked = null;
  S.answered = false; S.briefOpen = false;
  S.order = cs.questions.map(function (q) {
    return (q.kind === "single" || q.kind === "multi") ? shuffle(q.options.length) : null;
  });
  S.screen = "brief"; render();
}

function screenBrief() {
  var cs = curCase();
  var c = el("div", "stack fadein");
  c.appendChild(el("div", "kicker", "Case " + cs.letter + " · " + escapeHtml(cs.where)));
  c.appendChild(el("h2", "", escapeHtml(cs.title)));
  var p = el("div", "panel");
  p.appendChild(el("div", "kicker", "The Incident"));
  p.appendChild(el("p", "", '<span style="display:block;margin-top:8px;font-size:16px;line-height:1.55">' + escapeHtml(cs.brief) + "</span>"));
  c.appendChild(p);
  c.appendChild(el("p", "note", "Eight questions — six core, then two advanced. Instant feedback after each, with the SWMS clause. This is your case for the exercise."));
  c.appendChild(el("div", "spacer"));
  var b = el("button", "btn", "Start the questions →");
  b.addEventListener("click", function () { S.screen = "quiz"; render(); });
  c.appendChild(b);
  app.appendChild(c);
}

function screenQuiz() {
  app.innerHTML = "";
  var cs = curCase();
  var q = cs.questions[S.qi];
  var c = el("div", "stack");

  var prog = el("div", "prog");
  for (var i = 0; i < cs.questions.length; i++) {
    var d = el("div", "dot");
    if (i < S.results.length) {
      var r = S.results[i];
      d.className = "dot done" + (r.pts === r.max ? "" : (r.pts === 0 ? " bad" : " part"));
    } else if (i === S.qi) { d.className = "dot now"; }
    prog.appendChild(d);
  }
  c.appendChild(prog);

  var bar = el("div", "casebar" + (S.briefOpen ? " open" : ""));
  var head = el("button", "casebar-head");
  head.appendChild(el("span", "cb-tag", "CASE " + cs.letter));
  head.appendChild(el("span", "cb-lbl", S.briefOpen ? "Hide the incident" : "Re-read the incident"));
  head.appendChild(el("span", "cb-chev", "▾"));
  head.addEventListener("click", function () { S.briefOpen = !S.briefOpen; screenQuiz(); });
  bar.appendChild(head);
  if (S.briefOpen) bar.appendChild(el("div", "casebar-body", escapeHtml(cs.brief)));
  c.appendChild(bar);

  if (q.advanced) c.appendChild(el("div", "pill pill-adv", "★ ADVANCED — stretch question"));
  c.appendChild(el("div", "kicker", "Case " + cs.letter + " · Question " + (S.qi + 1) + " of " + cs.questions.length + " · " + q.short));
  c.appendChild(el("h2", "", escapeHtml(q.prompt)));

  if (q.kind === "single" || q.kind === "multi") buildOptions(c, q);
  else if (q.kind === "matrix") buildMatrix(c, q);

  var act = el("div", "stack"); act.id = "act"; act.style.marginTop = "4px";
  c.appendChild(act);
  app.appendChild(c);
  renderAction();
}

function buildOptions(container, q) {
  var multi = q.kind === "multi";
  var ord = S.order[S.qi];
  var box = el("div", "stack");
  if (multi && !S.answered) box.appendChild(el("div", "pill", "✓ Select every control that applies"));
  ord.forEach(function (idx) {
    var o = q.options[idx];
    var btn = el("div", "opt " + (multi ? "multi" : "single"));
    var mk = el("span", "mk", "");
    var txt = el("span", "", escapeHtml(o.t));
    btn.appendChild(mk); btn.appendChild(txt);
    btn.dataset.idx = idx;

    if (!S.answered) {
      var on = multi ? (S.picked && S.picked.indexOf(idx) > -1) : (S.picked === idx);
      if (on) { btn.classList.add("sel"); mk.textContent = multi ? "✓" : "●"; }
      btn.addEventListener("click", function () {
        if (multi) {
          if (!S.picked) S.picked = [];
          var p = S.picked.indexOf(idx);
          if (p > -1) S.picked.splice(p, 1); else S.picked.push(idx);
        } else { S.picked = idx; }
        screenQuiz();
      });
    } else {
      btn.classList.add("lock");
      var picked = multi ? (S.picked && S.picked.indexOf(idx) > -1) : (S.picked === idx);
      if (o.c && picked) { btn.classList.add("right"); mk.textContent = "✓"; appendTag(btn, "t-ok", "Correct"); }
      else if (o.c && !picked) { btn.classList.add("missed"); appendTag(btn, "t-miss", "Missed"); }
      else if (!o.c && picked) { btn.classList.add("wrong"); mk.textContent = "✗"; appendTag(btn, "t-no", "Wrong"); }
    }
    box.appendChild(btn);
  });
  container.appendChild(box);
}
function appendTag(btn, cls, txt) { var t = el("span", "tag " + cls, txt); btn.appendChild(t); }

function buildMatrix(container, q) {
  var wrap = el("div", "panel");
  var scroll = el("div", "matrix-scroll");
  var tbl = el("table", "mx");
  var hr = el("tr");
  hr.appendChild(el("th", "corner"));
  LIKE.forEach(function (l) {
    hr.appendChild(el("th", "lk", l.c + "<br>" + l.label.replace(" ", "<br>")));
  });
  tbl.appendChild(hr);
  IMPACTS.forEach(function (im) {
    var tr = el("tr");
    tr.appendChild(el("td", "im", im.n + ". " + im.label));
    LIKE.forEach(function (l, ci) {
      var code = im.n + l.c;
      var band = BANDS[im.n][ci];
      var td = el("td");
      var cell = el("div", "cell " + bandClass(band), code);
      cell.dataset.code = code;
      if (!S.answered) {
        if (S.picked === code) cell.classList.add("sel");
        cell.addEventListener("click", function () { S.picked = code; screenQuiz(); });
      } else {
        cell.classList.add("lock");
        var isAccept = q.accept.indexOf(code) > -1;
        if (isAccept) cell.classList.add("is-right");
        if (S.picked === code && !isAccept) cell.classList.add("is-wrong");
      }
      td.appendChild(cell);
      tr.appendChild(td);
    });
    tbl.appendChild(tr);
  });
  scroll.appendChild(tbl);
  wrap.appendChild(scroll);
  var lg = el("div", "legend");
  [["extreme", "Extreme"], ["high", "High"], ["medium", "Medium"], ["low", "Low"]].forEach(function (p) {
    var s = el("span", "");
    var i = el("i", ""); i.style.background = "var(--" + p[0] + ")";
    s.appendChild(i); s.appendChild(document.createTextNode(p[1]));
    lg.appendChild(s);
  });
  wrap.appendChild(lg);
  container.appendChild(wrap);
}

function renderAction() {
  var act = document.getElementById("act");
  if (!act) return;
  act.innerHTML = "";
  var cs = curCase(), q = cs.questions[S.qi];

  if (!S.answered) {
    var ready = q.kind === "multi" ? (S.picked && S.picked.length > 0) : (S.picked !== null && S.picked !== undefined);
    var sub = el("button", "btn", "Lock in answer");
    sub.disabled = !ready;
    sub.addEventListener("click", function () { submitAnswer(); });
    act.appendChild(sub);
  } else {
    var r = S.results[S.qi];
    var cls = r.pts === r.max ? "good" : (r.pts === 0 ? "bad" : "part");
    var verdict = r.pts === r.max ? "Spot on" : (r.pts === 0 ? "Not quite" : "Partly right");
    var icon = r.pts === r.max ? "✓" : (r.pts === 0 ? "✗" : "◑");
    var fb = el("div", "fb " + cls);
    var v = el("div", "verdict", '<span>' + icon + '</span> ' + verdict +
      ' <span style="margin-left:auto;font-size:15px;color:var(--dim)">+' + r.pts + " / " + r.max + "</span>");
    fb.appendChild(v);
    var fbText = q.fb;
    if (q.kind === "matrix" && S.picked) {
      var corr = q.accept[0], md = matrixMinDist(q.accept, S.picked);
      var bn = { extreme: "Extreme", high: "High", medium: "Medium", low: "Low" };
      if (md === 1) fbText = "You tapped " + S.picked + " (" + bn[cellBand(S.picked)] + ") — one band off, so part marks. The SWMS rates it " + corr + " (" + bn[cellBand(corr)] + "). " + q.fb;
      else if (md > 1) fbText = "You tapped " + S.picked + " (" + bn[cellBand(S.picked)] + "), but the SWMS rates it " + corr + " (" + bn[cellBand(corr)] + "). " + q.fb;
    }
    fb.appendChild(el("p", "", '<span style="display:block;margin-top:6px;font-size:14.5px;line-height:1.5">' + escapeHtml(fbText) + "</span>"));
    var cl = el("div", "clause");
    cl.appendChild(el("span", "src", escapeHtml(q.src)));
    cl.appendChild(document.createTextNode(clauseDetail(cs.id, S.qi)));
    fb.appendChild(cl);
    act.appendChild(fb);

    var last = S.qi === cs.questions.length - 1;
    var nx = el("button", "btn", last ? "See my scorecard →" : "Next question →");
    nx.addEventListener("click", function () {
      if (last) { S.screen = "score"; render(); }
      else { S.qi++; S.picked = null; S.answered = false; screenQuiz(); }
    });
    act.appendChild(nx);
  }
}

function clauseDetail(caseId, qi) {
  var K = CLAUSE_DETAIL[caseId] || [];
  return " " + (K[qi] || "");
}

function submitAnswer() {
  var cs = curCase(), q = cs.questions[S.qi];
  var MAX = 20, pts = 0;
  if (q.kind === "single") {
    pts = q.options[S.picked].c ? MAX : 0;
  } else if (q.kind === "matrix") {
    var md = matrixMinDist(q.accept, S.picked);
    pts = md === 0 ? MAX : (md === 1 ? 12 : 0);
  } else {
    var totalC = 0, pc = 0, pw = 0;
    q.options.forEach(function (o, i) {
      if (o.c) totalC++;
      var picked = S.picked.indexOf(i) > -1;
      if (picked && o.c) pc++;
      if (picked && !o.c) pw++;
    });
    var ratio = (pc - pw) / totalC;
    if (ratio < 0) ratio = 0; if (ratio > 1) ratio = 1;
    pts = Math.round(ratio * MAX);
  }
  S.results[S.qi] = { pts: pts, max: MAX, kind: q.kind, short: q.short, advanced: !!q.advanced, picked: S.picked };
  S.answered = true;
  screenQuiz();
  setTimeout(function () { window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" }); }, 60);
}

function scoreCard(kick, sub, t, m) {
  var pc = m ? Math.round(t / m * 100) : 0;
  var clr = pc >= 80 ? "var(--ok)" : (pc >= 50 ? "var(--medium)" : "var(--no)");
  var card = el("div", "scard"); card.style.flex = "1";
  card.style.background = "var(--panel)"; card.style.border = "1px solid var(--line)";
  card.style.borderRadius = "11px"; card.style.padding = "11px 12px"; card.style.textAlign = "center";
  var k = el("div", ""); k.textContent = kick;
  k.style.cssText = "font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:var(--dim)";
  card.appendChild(k);
  var v = el("div", "", t + "/" + m); v.style.cssText = "font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:26px;line-height:1.15"; v.style.color = clr;
  card.appendChild(v);
  var s = el("div", ""); s.textContent = sub + " · " + pc + "%";
  s.style.cssText = "font-size:11px;color:var(--dimmer);letter-spacing:.3px";
  card.appendChild(s);
  return card;
}

function screenScore() {
  var cs = curCase();
  var total = 0, max = 0;
  S.results.forEach(function (r) { total += r.pts; max += r.max; });
  var pct = Math.round(total / max * 100);
  var ringclr = pct >= 80 ? "var(--ok)" : (pct >= 50 ? "var(--medium)" : "var(--no)");
  var verdict = pct >= 80 ? "Strong — you can find it in the SWMS."
              : pct >= 50 ? "Solid start. Know where to look next time."
                          : "Worth another look at the document.";
  var c = el("div", "stack fadein");
  c.appendChild(el("div", "kicker", "Case " + cs.letter + " · " + escapeHtml(S.name)));
  c.appendChild(el("h2", "", "Your scorecard"));

  var ring = el("div", "score-ring");
  ring.style.setProperty("--pct", pct);
  ring.style.setProperty("--ringclr", ringclr);
  var inner = el("div", "inner");
  inner.appendChild(el("div", "num", total));
  inner.appendChild(el("div", "den", "OUT OF " + max));
  ring.appendChild(inner);
  c.appendChild(ring);
  c.appendChild(el("p", "lead", '<span style="display:block;text-align:center">' + verdict + "</span>"));

  var coreT = 0, coreM = 0, advT = 0, advM = 0;
  S.results.forEach(function (r) {
    if (r.advanced) { advT += r.pts; advM += r.max; } else { coreT += r.pts; coreM += r.max; }
  });
  var split = el("div", ""); split.style.cssText = "display:flex;gap:10px";
  split.appendChild(scoreCard("Core skills", "Q1–6", coreT, coreM));
  if (advM > 0) split.appendChild(scoreCard("Advanced", "Stretch", advT, advM));
  c.appendChild(split);

  c.appendChild(el("div", "divider"));
  c.appendChild(el("div", "kicker", "Question breakdown"));
  S.results.forEach(function (r, i) {
    var row = el("div", "brk-row");
    var n = el("div", "n", (i + 1));
    var clr = r.pts === r.max ? "var(--ok)" : (r.pts === 0 ? "var(--no)" : "var(--medium)");
    n.style.background = clr; n.style.color = "#10141b";
    row.appendChild(n);
    row.appendChild(el("div", "lbl", escapeHtml(r.short)));
    var pts = el("div", "pts", "+" + r.pts); pts.style.color = clr;
    row.appendChild(pts);
    c.appendChild(row);
  });

  c.appendChild(el("div", "spacer"));
  var b = el("button", "btn", "Submit to leaderboard →");
  b.addEventListener("click", function () {
    b.disabled = true; b.textContent = "Submitting…";
    apiSubmit({
      name: S.name,
      caseId: cs.id,
      score: total,
      maxScore: max,
      answers: S.results.map(function (r) { return { short: r.short, pts: r.pts, max: r.max, picked: r.picked }; })
    }).then(function (r) {
      if (r.ok) { S.screen = "board"; render(); }
      else {
        b.disabled = false; b.textContent = "Try again — submit";
        var err = el("p", "err", "Couldn't save your score. " + (r.body && r.body.error ? "(" + r.body.error + ")" : ""));
        c.insertBefore(err, b);
      }
    }).catch(function () {
      b.disabled = false; b.textContent = "Try again — submit";
      var err = el("p", "err", "Network error — try again."); c.insertBefore(err, b);
    });
  });
  c.appendChild(b);
  app.appendChild(c);
}

function screenBoard() {
  var c = el("div", "stack fadein");
  c.appendChild(el("div", "kicker", WS.workshopTitle));
  c.appendChild(el("h2", "", "Leaderboard"));
  var listBox = el("div", "stack"); listBox.id = "lbList";
  listBox.appendChild(el("p", "lead", "Loading scores…"));
  c.appendChild(listBox);

  c.appendChild(el("div", "divider"));
  c.appendChild(el("div", "closing", 'Know the right thing.<br>Do the right thing.<br><b>Call out the wrong thing.</b>'));
  c.appendChild(el("p", "note", "Scores are shared live with everyone in this session."));

  var ref = el("button", "btn ghost", "↻ Refresh leaderboard");
  ref.addEventListener("click", function () { loadAndRender(); });
  c.appendChild(ref);
  app.appendChild(c);

  function loadAndRender() {
    apiLeaderboard().then(function (j) {
      listBox.innerHTML = "";
      var list = (j && j.attempts) || [];
      if (!list.length) { listBox.appendChild(el("p", "lead", "No scores yet — be the first.")); return; }
      var medals = ["\u{1F947}", "\u{1F948}", "\u{1F949}"];
      list.forEach(function (e, i) {
        var isMe = (e.player_name || "").trim().toLowerCase() === (S.name || "").trim().toLowerCase();
        var row = el("div", "lb-row" + (isMe ? " me" : ""));
        var rk = el("div", "lb-rank" + (i < 3 ? " medal" : ""), i < 3 ? medals[i] : (i + 1));
        row.appendChild(rk);
        var mid = el("div", "");
        mid.appendChild(el("div", "lb-name", escapeHtml(e.player_name) + (isMe ? '  <span style="font-size:11px;color:var(--orange)">(you)</span>' : "")));
        mid.appendChild(el("div", "lb-meta", "Case " + e.case_letter));
        row.appendChild(mid);
        var sc = el("div", "lb-score", e.score);
        var _p = e.max_score ? (e.score / e.max_score * 100) : 0;
        sc.style.color = _p >= 80 ? "var(--ok)" : (_p >= 50 ? "var(--yellow)" : "var(--dim)");
        row.appendChild(sc);
        listBox.appendChild(row);
      });
    }).catch(function () {
      listBox.innerHTML = "";
      listBox.appendChild(el("p", "err", "Couldn't load leaderboard."));
    });
  }
  loadAndRender();
  // Auto-refresh every 6s while on this screen
  var poll = setInterval(function () {
    if (S.screen !== "board") { clearInterval(poll); return; }
    loadAndRender();
  }, 6000);
}

// boot — try to resume a saved in-flight game first (refresh recovery).
tryResume();
render();
</script>
</body>
</html>
